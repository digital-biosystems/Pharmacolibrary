within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01E_ProteinKinaseInhibitors.L01EB07_Dacomitinib;
model Dacomitinib "Dacomitinib — default model: Dacomitinib_RuizGarcia2020_estimate_rse"
  extends Dacomitinib_RuizGarcia2020_estimate_rse;
  annotation (Documentation(info = "<html><body><p>The default model of dacomitinib: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01E_ProteinKinaseInhibitors.L01EB07_Dacomitinib.Dacomitinib_RuizGarcia2020_estimate_rse\">Dacomitinib_RuizGarcia2020_estimate_rse</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of dacomitinib in this package:</p><ul><li><code>Dacomitinib_RuizGarcia2020_estimate_rse</code></li></ul><h4>About dacomitinib</h4><p>Dacomitinib is an EGFR tyrosine kinase inhibitor used to treat non-small-cell lung cancer. It is authorised in the European Union for this indication.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q17130597\">Wikidata Q17130597</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Dacomitinib\">Dacomitinib</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 518400, Tolerance = 1e-9, Interval = 1));
end Dacomitinib;
