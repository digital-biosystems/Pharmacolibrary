within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01E_ProteinKinaseInhibitors.L01EN02_Pemigatinib;
model Pemigatinib_Gong2023_reference
  parameter Real Cl_ref = 7.5e-07 "Cl [m3/s]";
  parameter Real cov_sex_0 = 0 "sex covariate";
  parameter Real Vd_ref = 0.0034 "Vd [m3]";
  extends Pharmacolibrary.Pharmacokinetic.Models.PK_2C_enteral(
    weight = 70.0,
    F = 1,
    Cl = Cl_ref*(1 + (18.5)*cov_sex_0),
    Vd = Vd_ref,
    adminDuration = 600,
    adminCount = 1,
    MM = Pharmacolibrary.Drugs.Substances.Pemigatinib.M,
    adminMass = 6e-06,
    ka = 0.0033888888888888888,
    Tlag = 0.0,
    k12 = 0.0006290849673202615,
    k21 = 0.000712962962962963
  );

  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>pemigatinib</td></tr><tr><td>ATC code:</td><td>L01EN02</td></tr><tr><td>model:</td><td>two compartments, oral dosing <small>(PK_2C_enteral)</small></td></tr><tr><td>source:</td><td>Gong X et al. 2023</td></tr><tr><td>population:</td><td>healthy participants and patients with CCA, other solid tumors, or MLN FGFR1</td></tr><tr><td>measured compound:</td><td>pemigatinib</td></tr><tr><td>review:</td><td>accepted with caveats</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_pemigatinib/Pemigatinib_Gong2023_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>CL/F, L/h</td><td>2.7</td><td>L/h</td><td><small>CL/F</small></td></tr><tr><td>V c/F, L</td><td>3.4</td><td>L</td><td><small>V1/F</small></td></tr><tr><td>V p/F, L</td><td>3.0</td><td>L</td><td><small>V2/F</small></td></tr><tr><td>Q/F, L/h</td><td>7.7</td><td>L/h</td><td><small>Q/F</small></td></tr><tr><td>K a, 1/h</td><td>12.2</td><td>1/h</td><td><small>kabs</small></td></tr><tr><td>D1, h</td><td>3.0</td><td>h</td><td><small>D1</small></td></tr><tr><td>male_sex_on_cl_f</td><td>18.5</td><td></td><td><small>equation variable</small></td></tr><tr><td>theta_kabs_sex</td><td>11.1</td><td></td><td><small>equation variable</small></td></tr><tr><td>theta_q76_body_weight</td><td>14.3</td><td></td><td><small>equation variable</small></td></tr><tr><td>theta_v2_f_body_weight_power</td><td>13.0</td><td></td><td><small>equation variable</small></td></tr></table><h4>About pemigatinib</h4><p>Pemigatinib is a protein kinase inhibitor used to treat cholangiocarcinoma. It is an approved cancer medicine and is authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q96398739\">Wikidata Q96398739</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Pemigatinib\">Pemigatinib</a>.</p><h4>References</h4><ol><li><p>Gong X et al. (2023). Population pharmacokinetic and exposure-response analyses of pemigatinib in patients with advanced solid tumors including cholangiocarcinoma. <i>CPT: pharmacometrics &amp; systems pharmacology 12(11):1784–1794</i>. DOI:<a href=\"https://doi.org/10.1002/psp4.13064\">10.1002/psp4.13064</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/37969064\">37969064</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Gong_2023: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: accepted with caveats</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Pemigatinib_Gong2023_reference;
