within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01E_ProteinKinaseInhibitors.L01EN02_Pemigatinib;
model Pemigatinib "Pemigatinib — default model: Pemigatinib_Gong2023_reference"
  extends Pemigatinib_Gong2023_reference;
  annotation (Documentation(info = "<html><body><p>The default model of pemigatinib: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01E_ProteinKinaseInhibitors.L01EN02_Pemigatinib.Pemigatinib_Gong2023_reference\">Pemigatinib_Gong2023_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of pemigatinib in this package:</p><ul><li><code>Pemigatinib_Gong2023_reference</code></li></ul><h4>About pemigatinib</h4><p>Pemigatinib is a protein kinase inhibitor used to treat cholangiocarcinoma. It is an approved cancer medicine and is authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q96398739\">Wikidata Q96398739</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Pemigatinib\">Pemigatinib</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Pemigatinib;
