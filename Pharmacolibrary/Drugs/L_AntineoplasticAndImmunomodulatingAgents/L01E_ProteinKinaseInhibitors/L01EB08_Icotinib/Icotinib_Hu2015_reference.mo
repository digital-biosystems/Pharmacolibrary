  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>icotinib</td></tr><tr><td>ATC code:</td><td>L01EB08</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Hu P et al. 2015</td></tr><tr><td>population:</td><td>healthy Chinese volunteers</td></tr><tr><td>measured compound:</td><td>icotinib</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_icotinib/Icotinib_Hu2015_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>clearance</td><td>29.5</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>distribution clearance</td><td>24.9</td><td>L/h</td><td><small>Q</small></td></tr><tr><td>central volume of distribution</td><td>18.5</td><td>L</td><td><small>V</small></td></tr></table><h4>About icotinib</h4><p>Icotinib is an EGFR tyrosine kinase inhibitor investigated for treating non-small-cell lung cancer. It is considered investigational and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q16868421\">Wikidata Q16868421</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Icotinib\">Icotinib</a>.</p><h4>References</h4><ol><li><p>Hu P et al. (2015). Development of population pharmacokinetics model of icotinib with non-linear absorption characters in healthy Chinese volunteers to assess the CYP2C19 polymorphism and food-intake effect. <i>European journal of clinical pharmacology 71(7):843–850</i>. DOI:<a href=\"https://doi.org/10.1007/s00228-015-1864-5\">10.1007/s00228-015-1864-5</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/25995169\">25995169</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Hu_2015: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
