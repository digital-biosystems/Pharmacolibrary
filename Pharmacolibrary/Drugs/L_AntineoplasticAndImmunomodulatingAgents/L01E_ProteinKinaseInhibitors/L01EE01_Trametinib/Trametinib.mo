within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01E_ProteinKinaseInhibitors.L01EE01_Trametinib;
model Trametinib "Trametinib — default model: Trametinib_Ravix2024_reference"
  extends Trametinib_Ravix2024_reference;
  annotation (Documentation(info = "<html><body><p>The default model of trametinib: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01E_ProteinKinaseInhibitors.L01EE01_Trametinib.Trametinib_Ravix2024_reference\">Trametinib_Ravix2024_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of trametinib in this package:</p><ul><li><code>Trametinib_Ravix2024_reference</code></li></ul><h4>About trametinib</h4><p>Trametinib is a MEK inhibitor anticancer drug used to treat melanoma, including metastatic melanoma, and also studied for other cancers such as non-small-cell lung carcinoma and low-grade serous carcinoma. It is authorised in the European Union, where it is used for melanoma and glioma.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7833138\">Wikidata Q7833138</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Trametinib\">Trametinib</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 345600, Tolerance = 1e-9, Interval = 1));
end Trametinib;
