  );

  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>cabozantinib</td></tr><tr><td>ATC code:</td><td>L01EX07</td></tr><tr><td>model:</td><td>one compartment, oral dosing <small>(PK_1C_enteral)</small></td></tr><tr><td>source:</td><td>Ly NS et al. 2023</td></tr><tr><td>population:</td><td>patients with various cancer types and healthy volunteers</td></tr><tr><td>measured compound:</td><td>cabozantinib</td></tr><tr><td>review:</td><td>accepted with caveats</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_cabozantinib/Cabozantinib_Ly2023_ase\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>CL/F</td><td>0.0323</td><td>L/h</td><td><small>CL/F</small></td></tr><tr><td>Vc/F</td><td>7.69</td><td>L</td><td><small>V1/F</small></td></tr><tr><td>Ka</td><td>0.175</td><td>1/h</td><td><small>kabs</small></td></tr><tr><td>V3/F</td><td>4.32</td><td>L</td><td><small>V3/F</small></td></tr><tr><td>Q/F</td><td>0.976</td><td>L/h</td><td><small>Q/F</small></td></tr><tr><td>F1</td><td>0.017</td><td></td><td><small>Fab</small></td></tr><tr><td>ALAG4</td><td>0.0404</td><td>h</td><td><small>tlag</small></td></tr><tr><td>theta_q319_weight</td><td>0.0614</td><td></td><td><small>equation variable</small></td></tr><tr><td>theta_v1_f_weight</td><td>0.270</td><td></td><td><small>equation variable</small></td></tr></table><h4>About cabozantinib</h4><p>Cabozantinib is a protein kinase inhibitor used to treat cancers such as renal cell carcinoma and medullary thyroid cancer. It is authorised in the European Union for thyroid, kidney, and liver cancers and is used in cancer care.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q795057\">Wikidata Q795057</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Cabozantinib\">Cabozantinib</a>.</p><h4>References</h4><ol><li><p>Ly NS et al. (2023). Population Pharmacokinetics and Exposure-Response Analysis for the Phase 3 COSMIC-311 Trial of Cabozantinib for Radioiodine-Refractory Differentiated Thyroid Cancer. <i>Clinical pharmacokinetics 62(4):587–598</i>. DOI:<a href=\"https://doi.org/10.1007/s40262-023-01210-0\">10.1007/s40262-023-01210-0</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/36869986\">36869986</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Ly_2023: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: accepted with caveats</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 3628800, Tolerance = 1e-9, Interval = 1));
end Cabozantinib_Ly2023_ase;
