within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01E_ProteinKinaseInhibitors.L01EX07_Cabozantinib;
model Cabozantinib_Ly2023_ase
  parameter Real Cl_ref = 8.972222222222224e-09 "Cl [m3/s]";
  parameter Real Vd_ref = 0.007690000000000001 "Vd [m3]";
  parameter Real cov_weight_0 = 0 "weight covariate";
