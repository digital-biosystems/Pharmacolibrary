within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01E_ProteinKinaseInhibitors.L01EX07_Cabozantinib;
model Cabozantinib "Cabozantinib — default model: Cabozantinib_Nguyen2019_reference"
  extends Cabozantinib_Nguyen2019_reference;
  annotation (Documentation(info = "<html><body><p>The default model of cabozantinib: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01E_ProteinKinaseInhibitors.L01EX07_Cabozantinib.Cabozantinib_Nguyen2019_reference\">Cabozantinib_Nguyen2019_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of cabozantinib in this package:</p><ul><li><code>Cabozantinib_Ly2023_ase</code></li><li><code>Cabozantinib_Ly2023_estimate</code></li><li><code>Cabozantinib_Miles2016v2_reference</code></li><li><code>Cabozantinib_Nguyen2019_reference</code></li></ul><h4>About cabozantinib</h4><p>Cabozantinib is a protein kinase inhibitor used to treat cancers such as renal cell carcinoma and medullary thyroid cancer. It is authorised in the European Union for thyroid, kidney, and liver cancers and is used in cancer care.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q795057\">Wikidata Q795057</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Cabozantinib\">Cabozantinib</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 1123200, Tolerance = 1e-9, Interval = 1));
end Cabozantinib;
