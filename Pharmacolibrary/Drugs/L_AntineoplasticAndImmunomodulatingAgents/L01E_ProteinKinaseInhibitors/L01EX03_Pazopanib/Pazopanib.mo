within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01E_ProteinKinaseInhibitors.L01EX03_Pazopanib;
model Pazopanib "Pazopanib — default model: Pazopanib_Bins2019_base"
  extends Pazopanib_Bins2019_base;
  annotation (Documentation(info = "<html><body><p>The default model of pazopanib: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01E_ProteinKinaseInhibitors.L01EX03_Pazopanib.Pazopanib_Bins2019_base\">Pazopanib_Bins2019_base</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of pazopanib in this package:</p><ul><li><code>Pazopanib_Bins2019_base</code></li><li><code>Pazopanib_Bins2019_final</code></li></ul><h4>About pazopanib</h4><p>Pazopanib is a protein kinase inhibitor used to treat kidney cancer, especially renal cell carcinoma, and other tumours such as gastrointestinal stromal tumours and soft-tissue sarcomas. It is an approved anticancer medicine authorised in the European Union for renal cell carcinoma.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7157043\">Wikidata Q7157043</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Pazopanib\">Pazopanib</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 140400, Tolerance = 1e-9, Interval = 1));
end Pazopanib;
