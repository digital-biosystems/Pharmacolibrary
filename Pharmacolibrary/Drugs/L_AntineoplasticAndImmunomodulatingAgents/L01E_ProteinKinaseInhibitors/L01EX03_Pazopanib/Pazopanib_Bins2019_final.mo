within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01E_ProteinKinaseInhibitors.L01EX03_Pazopanib;
model Pazopanib_Bins2019_final
  parameter Real Cl_ref = 7.777777777777778e-08 "Cl [m3/s]";
  parameter Real cov_cyp3a4_0 = 0 "cyp3a4 covariate";
  parameter Real Vd_ref = 0.0024 "Vd [m3]";
  extends Pharmacolibrary.Pharmacokinetic.Models.PK_2C_enteral(
    weight = 70.0,
    F = 466.0,
    Cl = Cl_ref*(1 + (0.18)*cov_cyp3a4_0),
    Vd = Vd_ref,
    adminDuration = 600,
    adminCount = 1,
    MM = Pharmacolibrary.Drugs.Substances.Pazopanib.M,
    adminMass = 0.0002,
    ka = 0.00010833333333333334,
    Tlag = 3492.0,
    k12 = 0.00011226851851851852,
    k21 = 1.1088248742569729e-05
  );

  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>pazopanib</td></tr><tr><td>ATC code:</td><td>L01EX03</td></tr><tr><td>model:</td><td>two compartments, oral dosing <small>(PK_2C_enteral)</small></td></tr><tr><td>source:</td><td>Bins S et al. 2019</td></tr><tr><td>population:</td><td>cancer patients</td></tr><tr><td>measured compound:</td><td>pazopanib</td></tr><tr><td>review:</td><td>accepted with caveats</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_pazopanib/Pazopanib_Bins2019_final\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>Fast absorption rate constant</td><td>0.39</td><td>1/h</td><td><small>kabs</small></td></tr><tr><td>Fraction of fast absorption</td><td>36</td><td></td><td><small>Fab</small></td></tr><tr><td>Lag time between fast and slow absorption</td><td>0.97</td><td>h</td><td><small>tlag</small></td></tr><tr><td>Clearance</td><td>0.28</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>Volume of distribution of central compartment</td><td>2.4</td><td>L</td><td><small>V1</small></td></tr><tr><td>Inter-compartment clearance</td><td>0.97</td><td>L/h</td><td><small>Q</small></td></tr><tr><td>Volume of distribution of peripheral compartment</td><td>24.3</td><td>L</td><td><small>V2</small></td></tr><tr><td>Magnitude of decrease in relative bioavailability in time</td><td>51</td><td></td><td><small>Frel</small></td></tr><tr><td>First-order decay constant</td><td>0.16</td><td>1/h</td><td><small>kel</small></td></tr><tr><td>theta_cl_cyp3a4</td><td>0.18</td><td></td><td><small>equation variable</small></td></tr></table><h4>About pazopanib</h4><p>Pazopanib is a protein kinase inhibitor used to treat kidney cancer, especially renal cell carcinoma, and other tumours such as gastrointestinal stromal tumours and soft-tissue sarcomas. It is an approved anticancer medicine authorised in the European Union for renal cell carcinoma.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7157043\">Wikidata Q7157043</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Pazopanib\">Pazopanib</a>.</p><h4>References</h4><ol><li><p>Bins S et al. (2019). Impact of CYP3A4*22 on Pazopanib Pharmacokinetics in Cancer Patients. <i>Clinical pharmacokinetics 58(5):651–658</i>. DOI:<a href=\"https://doi.org/10.1007/s40262-018-0719-5\">10.1007/s40262-018-0719-5</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/30367352\">30367352</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Bins_2019: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: accepted with caveats</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 136800, Tolerance = 1e-9, Interval = 1));
end Pazopanib_Bins2019_final;
