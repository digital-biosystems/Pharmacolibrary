  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>axitinib</td></tr><tr><td>ATC code:</td><td>L01EK01</td></tr><tr><td>model:</td><td>one compartment, oral dosing <small>(PK_1C_enteral)</small></td></tr><tr><td>source:</td><td>Tortorici MA et al. 2014</td></tr><tr><td>population:</td><td>patients with NSCLC, thyroid cancer, or melanoma and healthy volunteers</td></tr><tr><td>measured compound:</td><td>axitinib</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_axitinib/Axitinib_Tortorici2014_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>systemic clearance</td><td>20.1</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>central volume of distribution</td><td>56.2</td><td>L</td><td><small>V</small></td></tr><tr><td>absorption rate constant</td><td>1.26</td><td>1/h</td><td><small>kabs</small></td></tr><tr><td>absolute bioavailability</td><td>0.663</td><td></td><td><small>Fab</small></td></tr><tr><td>lag time</td><td>0.448</td><td>h</td><td><small>tlag</small></td></tr></table><h4>About axitinib</h4><p>Axitinib is a protein kinase inhibitor used to treat kidney cancer, especially renal cell carcinoma. It is an approved medicine and is authorised in the European Union for renal cell carcinoma.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4830631\">Wikidata Q4830631</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Axitinib\">Axitinib</a>.</p><h4>References</h4><ol><li><p>Tortorici MA et al. (2014). Pharmacokinetics of single-agent axitinib across multiple solid tumor types. <i>Cancer chemotherapy and pharmacology 74(6):1279–1289</i>. DOI:<a href=\"https://doi.org/10.1007/s00280-014-2606-6\">10.1007/s00280-014-2606-6</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/25336084\">25336084</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Tortorici_2014: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
