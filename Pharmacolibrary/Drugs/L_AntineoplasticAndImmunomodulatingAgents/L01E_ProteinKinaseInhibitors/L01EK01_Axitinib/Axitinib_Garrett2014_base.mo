  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>axitinib</td></tr><tr><td>ATC code:</td><td>L01EK01</td></tr><tr><td>model:</td><td>two compartments, oral dosing <small>(PK_2C_enteral)</small></td></tr><tr><td>source:</td><td>Garrett M et al. 2014</td></tr><tr><td>population:</td><td>healthy volunteers</td></tr><tr><td>measured compound:</td><td>axitinib</td></tr><tr><td>review:</td><td>accepted with caveats</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_axitinib/Axitinib_Garrett2014_base\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>CL (l h -1 )</td><td>17.1</td><td>l h -1</td><td><small>CL</small></td></tr><tr><td>Vc (l)</td><td>46.6</td><td>l</td><td><small>V1</small></td></tr><tr><td>Q (l h -1 )</td><td>1.73</td><td>l h -1</td><td><small>Q</small></td></tr><tr><td>Vp (l)</td><td>44.7</td><td>l</td><td><small>V2</small></td></tr><tr><td>Fasting</td><td>2.10</td><td></td><td><small>Frel</small></td></tr><tr><td>tlag (h) ‡</td><td>0.457</td><td>h</td><td><small>tlag</small></td></tr><tr><td>theta_q319_weight</td><td>14</td><td></td><td><small>equation variable</small></td></tr><tr><td>theta_q49_fed_ka_h_1_form_iv</td><td>0.530</td><td></td><td><small>equation variable</small></td></tr><tr><td>k a</td><td>78.7</td><td>per day</td><td><small>kabs</small></td></tr></table><h4>About axitinib</h4><p>Axitinib is a protein kinase inhibitor used to treat kidney cancer, especially renal cell carcinoma. It is an approved medicine and is authorised in the European Union for renal cell carcinoma.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4830631\">Wikidata Q4830631</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Axitinib\">Axitinib</a>.</p><h4>References</h4><ol><li><p>Garrett M et al. (2014). Population pharmacokinetic analysis of axitinib in healthy volunteers. <i>British journal of clinical pharmacology 77(3):480–492</i>. DOI:<a href=\"https://doi.org/10.1111/bcp.12206\">10.1111/bcp.12206</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/23834452\">23834452</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Garrett_2014: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: accepted with caveats</li></ul></body></html>"),
