within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01C_PlantAlkaloidsAndOtherNaturalProducts.L01CE01_Topotecan;
model Topotecan "Topotecan — default model: Topotecan_Lger2004_reference"
  extends Topotecan_Lger2004_reference;
  annotation (Documentation(info = "<html><body><p>The default model of topotecan: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01C_PlantAlkaloidsAndOtherNaturalProducts.L01CE01_Topotecan.Topotecan_Lger2004_reference\">Topotecan_Lger2004_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of topotecan in this package:</p><ul><li><code>Topotecan_Lger2004_reference</code></li></ul><h4>About topotecan</h4><p>Topotecan is a topoisomerase I inhibitor used to treat cancers such as ovarian cancer, small cell lung cancer, and cervical cancer. It remains authorised in the European Union for several cancer indications and is used in oncology care, though some EU marketing applications have been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q419953\">Wikidata Q419953</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Topotecan\">Topotecan</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Topotecan;
