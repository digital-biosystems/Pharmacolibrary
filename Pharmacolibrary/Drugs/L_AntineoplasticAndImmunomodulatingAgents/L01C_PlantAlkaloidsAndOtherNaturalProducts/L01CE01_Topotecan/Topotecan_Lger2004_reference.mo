within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01C_PlantAlkaloidsAndOtherNaturalProducts.L01CE01_Topotecan;
model Topotecan_Lger2004_reference
  parameter Real Cl_ref = 1.7222222222222224e-05 "Cl [m3/s]";
  parameter Real cov_crcl_0 = 0 "crcl covariate";
  parameter Real Vd_ref = 0.027 "Vd [m3]";
  extends Pharmacolibrary.Pharmacokinetic.Models.PK_1C(
    weight = 70.0,
    F = 1,
    Cl = Cl_ref*(1 + (20.0)*cov_crcl_0),
    Vd = Vd_ref,
    adminDuration = 600,
    adminCount = 1,
    MM = Pharmacolibrary.Drugs.Substances.Topotecan.M,
    adminMass = 1e-05
  );

  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>topotecan</td></tr><tr><td>ATC code:</td><td>L01CE01</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Léger F et al. 2004</td></tr><tr><td>population:</td><td>patients</td></tr><tr><td>measured compound:</td><td>topotecan</td></tr><tr><td>review:</td><td>accepted with caveats</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_topotecan/Topotecan_Lger2004_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>CL=θ1</td><td>+62</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>V1=θ4</td><td>+27</td><td>L</td><td><small>V</small></td></tr><tr><td>theta_cl_crcl_cl_1_2</td><td>+20</td><td></td><td><small>equation variable</small></td></tr></table><h4>About topotecan</h4><p>Topotecan is a topoisomerase I inhibitor used to treat cancers such as ovarian cancer, small cell lung cancer, and cervical cancer. It remains authorised in the European Union for several cancer indications and is used in oncology care, though some EU marketing applications have been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q419953\">Wikidata Q419953</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Topotecan\">Topotecan</a>.</p><h4>References</h4><ol><li><p>Léger F et al. (2004). Factors affecting pharmacokinetic variability of oral topotecan: a population analysis. <i>British journal of cancer 90(2):343–347</i>. DOI:<a href=\"https://doi.org/10.1038/sj.bjc.6601469\">10.1038/sj.bjc.6601469</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/14735174\">14735174</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Léger_2004: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: accepted with caveats</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Topotecan_Lger2004_reference;
