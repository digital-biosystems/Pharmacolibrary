within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01C_PlantAlkaloidsAndOtherNaturalProducts.L01CA01_Vinblastine;
model Vinblastine "Vinblastine — default model: Vinblastine_Zhou1990_estimated_parameters_cls_l_kg"
  extends Vinblastine_Zhou1990_estimated_parameters_cls_l_kg;
  annotation (Documentation(info = "<html><body><p>The default model of vinblastine: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01C_PlantAlkaloidsAndOtherNaturalProducts.L01CA01_Vinblastine.Vinblastine_Zhou1990_estimated_parameters_cls_l_kg\">Vinblastine_Zhou1990_estimated_parameters_cls_l_kg</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of vinblastine in this package:</p><ul><li><code>Vinblastine_Zhou1990_estimated_parameters_cls_l_kg</code></li><li><code>Vinblastine_Zhou1990_estimated_parameters_vc_l_h_kg</code></li><li><code>Vinblastine_Zhou1990_estimated_parameters_vt_l_kg</code></li></ul><h4>About vinblastine</h4><p>Vinblastine, a Vinca alkaloid, is a cancer medicine used against tumours such as Hodgkin's lymphoma, breast, testicular and kidney cancer, Kaposi's sarcoma, and also certain blood and immune disorders. It remains an approved medicine and is included on the WHO list of essential medicines, so it is widely used in cancer treatment worldwide.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q282629\">Wikidata Q282629</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Vinblastine\">Vinblastine</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Vinblastine;
