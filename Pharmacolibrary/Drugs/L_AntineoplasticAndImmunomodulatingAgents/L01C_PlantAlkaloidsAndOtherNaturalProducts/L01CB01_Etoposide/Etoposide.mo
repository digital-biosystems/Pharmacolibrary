within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01C_PlantAlkaloidsAndOtherNaturalProducts.L01CB01_Etoposide;
model Etoposide "Etoposide — default model: Etoposide_Toffoli2001_mean"
  extends Etoposide_Toffoli2001_mean;
  annotation (Documentation(info = "<html><body><p>The default model of etoposide: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01C_PlantAlkaloidsAndOtherNaturalProducts.L01CB01_Etoposide.Etoposide_Toffoli2001_mean\">Etoposide_Toffoli2001_mean</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of etoposide in this package:</p><ul><li><code>Etoposide_Toffoli2001_mean</code></li><li><code>Etoposide_Toffoli2001_mean_with_covariables</code></li></ul><h4>About etoposide</h4><p>Etoposide is a chemotherapy drug used to treat many cancers, including testicular cancer, lung small cell carcinoma, lymphomas, leukemias, and several other tumors. It is an approved medicine and appears on the WHO essential medicines list, so it is widely used in cancer care, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q418817\">Wikidata Q418817</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Etoposide\">Etoposide</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Etoposide;
