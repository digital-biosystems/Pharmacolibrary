  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>etoposide</td></tr><tr><td>ATC code:</td><td>L01CB01</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Toffoli G et al. 2001</td></tr><tr><td>population:</td><td>adult patients with solid tumours</td></tr><tr><td>measured compound:</td><td>etoposide</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_etoposide/Etoposide_Toffoli2001_mean\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>CL (l h x1 )</td><td>1.14</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>V (l)</td><td>6.0</td><td>l</td><td><small>V</small></td></tr><tr><td>k 12 (h x1 )</td><td>0.14</td><td>1/h</td><td><small>k12</small></td></tr><tr><td>k 21 (h x1 )</td><td>0.06</td><td>1/h</td><td><small>k21</small></td></tr><tr><td>F</td><td>0.44</td><td></td><td><small>Fab</small></td></tr></table><h4>About etoposide</h4><p>Etoposide is a chemotherapy drug used to treat many cancers, including testicular cancer, lung small cell carcinoma, lymphomas, leukemias, and several other tumors. It is an approved medicine and appears on the WHO essential medicines list, so it is widely used in cancer care, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q418817\">Wikidata Q418817</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Etoposide\">Etoposide</a>.</p><h4>References</h4><ol><li><p>Toffoli G et al. (2001). Population pharmacokinetics and pharmacodynamics of oral etoposide. <i>British journal of clinical pharmacology 52(5):511–519</i>. DOI:<a href=\"https://doi.org/10.1046/j.0306-5251.2001.01468.x\">10.1046/j.0306-5251.2001.01468.x</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/11736859\">11736859</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Toffoli_2001: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
