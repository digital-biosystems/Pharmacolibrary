  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>docetaxel</td></tr><tr><td>ATC code:</td><td>L01CD02</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Clarke SJ et al. 1999</td></tr><tr><td>population:</td><td>adults and children with cancer</td></tr><tr><td>measured compound:</td><td>docetaxel</td></tr><tr><td>review:</td><td>accepted with caveats</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_docetaxel/Docetaxel_Clarke1999_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>alpha half-life</td><td>4.5</td><td>minutes</td><td><small>t1/2α</small></td></tr><tr><td>beta half-life</td><td>38.3</td><td>minutes</td><td><small>t1/2β</small></td></tr><tr><td>gamma half-life</td><td>12.2</td><td>hours</td><td><small>t1/2γ</small></td></tr><tr><td>mean volume of distribution</td><td>74</td><td>L</td><td><small>V</small></td></tr><tr><td>mean total body clearance</td><td>22</td><td>L/h</td><td><small>CL</small></td></tr></table><h4>About docetaxel</h4><p>Docetaxel is a taxane chemotherapy drug used to treat several cancers, including breast, ovarian, lung, stomach, pancreatic, head and neck cancers and melanoma. It is widely used worldwide, is included on the WHO essential medicines list, and remains authorised in the European Union for several cancer types.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q420436\">Wikidata Q420436</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Docetaxel\">Docetaxel</a>.</p><h4>References</h4><ol><li><p>Clarke SJ et al. (1999). Clinical pharmacokinetics of docetaxel. <i>Clinical pharmacokinetics 36(2):99–114</i>. DOI:<a href=\"https://doi.org/10.2165/00003088-199936020-00002\">10.2165/00003088-199936020-00002</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/10092957\">10092957</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Clarke_1999: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: accepted with caveats</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Docetaxel_Clarke1999_reference;
