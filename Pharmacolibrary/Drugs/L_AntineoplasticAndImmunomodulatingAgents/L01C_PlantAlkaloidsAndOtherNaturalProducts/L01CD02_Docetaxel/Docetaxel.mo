within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01C_PlantAlkaloidsAndOtherNaturalProducts.L01CD02_Docetaxel;
model Docetaxel "Docetaxel — default model: Docetaxel_Clarke1999_reference"
  extends Docetaxel_Clarke1999_reference;
  annotation (Documentation(info = "<html><body><p>The default model of docetaxel: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01C_PlantAlkaloidsAndOtherNaturalProducts.L01CD02_Docetaxel.Docetaxel_Clarke1999_reference\">Docetaxel_Clarke1999_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of docetaxel in this package:</p><ul><li><code>Docetaxel_Clarke1999_reference</code></li></ul><h4>About docetaxel</h4><p>Docetaxel is a taxane chemotherapy drug used to treat several cancers, including breast, ovarian, lung, stomach, pancreatic, head and neck cancers and melanoma. It is widely used worldwide, is included on the WHO essential medicines list, and remains authorised in the European Union for several cancer types.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q420436\">Wikidata Q420436</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Docetaxel\">Docetaxel</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Docetaxel;
