within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L04A_Immunosuppressants.L04AX02_Thalidomide;
model Thalidomide "Thalidomide — default model: Thalidomide_Noormohamed1999_reference"
  extends Thalidomide_Noormohamed1999_reference;
  annotation (Documentation(info = "<html><body><p>The default model of thalidomide: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L04A_Immunosuppressants.L04AX02_Thalidomide.Thalidomide_Noormohamed1999_reference\">Thalidomide_Noormohamed1999_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of thalidomide in this package:</p><ul><li><code>Thalidomide_Chen1989_reference</code></li><li><code>Thalidomide_Noormohamed1999_reference</code></li></ul><h4>About thalidomide</h4><p>Thalidomide is an immunomodulatory drug used for conditions such as multiple myeloma and leprosy, among several other immune and blood disorders. It remains authorised in the European Union for multiple myeloma, but its use is tightly controlled because it causes severe birth defects, and it was famously withdrawn from use as a sedative for this reason.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q203174\">Wikidata Q203174</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Thalidomide\">Thalidomide</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 111600, Tolerance = 1e-9, Interval = 1));
end Thalidomide;
