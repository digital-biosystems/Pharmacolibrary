  );

  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>thalidomide</td></tr><tr><td>ATC code:</td><td>L04AX02</td></tr><tr><td>model:</td><td>one compartment, oral dosing <small>(PK_1C_enteral)</small></td></tr><tr><td>source:</td><td>Noormohamed FH et al. 1999</td></tr><tr><td>population:</td><td>asymptomatic HIV-infected subjects</td></tr><tr><td>measured compound:</td><td>thalidomide</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_thalidomide/Thalidomide_Noormohamed1999_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>mean absorption half-life</td><td>0.95</td><td>hr</td><td><small>t1/2ka </small></td></tr><tr><td>mean Cmax</td><td>1.15</td><td>microg/ml</td><td><small>Cmax</small></td></tr><tr><td>Tmax</td><td>2.5</td><td>h</td><td><small>tmax</small></td></tr><tr><td>Vdss/F</td><td>69.9</td><td>liters</td><td><small>V/F</small></td></tr><tr><td>Cl/F</td><td>10.4</td><td>liters/hr</td><td><small>CL/F</small></td></tr><tr><td>K a (1/h)</td><td>0.4</td><td>1/h</td><td><small>kabs</small></td></tr><tr><td>T lag (h)</td><td>0.73</td><td>h</td><td><small>tlag</small></td></tr></table><h4>About thalidomide</h4><p>Thalidomide is an immunomodulatory drug used for conditions such as multiple myeloma and leprosy, among several other immune and blood disorders. It remains authorised in the European Union for multiple myeloma, but its use is tightly controlled because it causes severe birth defects, and it was famously withdrawn from use as a sedative for this reason.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q203174\">Wikidata Q203174</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Thalidomide\">Thalidomide</a>.</p><h4>References</h4><ol><li><p>Noormohamed FH et al. (1999). Pharmacokinetics and hemodynamic effects of single oral doses of thalidomide in asymptomatic human immunodeficiency virus-infected subjects. <i>AIDS research and human retroviruses 15(12):1047–1052</i>. DOI:<a href=\"https://doi.org/10.1089/088922299310331\">10.1089/088922299310331</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/10461824\">10461824</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Noormohamed_1999: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 111600, Tolerance = 1e-9, Interval = 1));
end Thalidomide_Noormohamed1999_reference;
