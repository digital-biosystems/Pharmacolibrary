within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L04A_Immunosuppressants.L04AB02_Infliximab;
model Infliximab "Infliximab — default model: Infliximab_Eser2021_reference"
  extends Infliximab_Eser2021_reference;
  annotation (Documentation(info = "<html><body><p>The default model of infliximab: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L04A_Immunosuppressants.L04AB02_Infliximab.Infliximab_Eser2021_reference\">Infliximab_Eser2021_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of infliximab in this package:</p><ul><li><code>Infliximab_Eser2021_reference</code></li></ul><h4>About infliximab</h4><p>Infliximab is a monoclonal antibody that blocks tumour necrosis factor alpha and is used to treat inflammatory conditions such as rheumatoid and psoriatic arthritis, Crohn's disease, ulcerative colitis, psoriasis, and ankylosing spondylitis. It is approved and widely used, with several products authorised in the European Union, and is also being studied for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q415264\">Wikidata Q415264</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Infliximab\">Infliximab</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 3628800, Tolerance = 1e-9, Interval = 1));
end Infliximab;
