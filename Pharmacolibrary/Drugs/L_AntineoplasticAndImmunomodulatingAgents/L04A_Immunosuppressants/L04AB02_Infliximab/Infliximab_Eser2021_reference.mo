within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L04A_Immunosuppressants.L04AB02_Infliximab;
model Infliximab_Eser2021_reference
  parameter Real Cl_ref = 3.0787037037037037e-09 "Cl [m3/s]";
  parameter Real cov_weight_0 = 0 "weight covariate";
  parameter Real cov_albumin_1 = 0 "albumin covariate";
  parameter Real cov_sex_2 = 0 "sex covariate";
  parameter Real cov_ada_3 = 0 "ada covariate";
  parameter Real Vd_ref = 0.00279 "Vd [m3]";
  extends Pharmacolibrary.Pharmacokinetic.Models.PK_2C(
    weight = 70.0,
    F = 1,
    Cl = Cl_ref*(1 + (0.729)*cov_weight_0)*(1 + (-0.32)*cov_albumin_1)*(1 + (-0.0728)*cov_sex_2)*(1 + (0.307)*cov_ada_3),
    Vd = Vd_ref*(1 + (1.0)*cov_weight_0),
    adminDuration = 600,
    adminCount = 1,
    adminMass = 0.00021,
    k12 = 2.3106664011681935e-07,
    k21 = 7.179019219665099e-07
  );

  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>infliximab</td></tr><tr><td>ATC code:</td><td>L04AB02</td></tr><tr><td>model:</td><td>two compartments, IV dosing <small>(PK_2C)</small></td></tr><tr><td>source:</td><td>Eser A et al. 2021</td></tr><tr><td>population:</td><td>adults with rheumatoid arthritis and ankylosing spondylitis</td></tr><tr><td>measured compound:</td><td>infliximab</td></tr><tr><td>review:</td><td>accepted with caveats</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_infliximab/Infliximab_Eser2021_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>Baseline CL, L/day</td><td>0.266</td><td>L/day</td><td><small>CL</small></td></tr><tr><td>Vc, L</td><td>2.79</td><td>L</td><td><small>V1</small></td></tr><tr><td>Q, L/day</td><td>0.0557</td><td>L/day</td><td><small>Q</small></td></tr><tr><td>Vp, L</td><td>0.898</td><td>L</td><td><small>V2</small></td></tr><tr><td>effect_of_weight_on_baseline_cl</td><td>0.729</td><td></td><td><small>equation variable</small></td></tr><tr><td>effect_of_albumin_on_baseline_cl</td><td>-0.32</td><td></td><td><small>equation variable</small></td></tr><tr><td>effect_of_patient_sex_on_baseline_cl</td><td>-0.0728</td><td></td><td><small>equation variable</small></td></tr><tr><td>theta_v1_weight</td><td>1</td><td></td><td><small>equation variable</small></td></tr><tr><td>theta_q_weight</td><td>0.75</td><td></td><td><small>equation variable</small></td></tr><tr><td>theta_v2_weight</td><td>1</td><td></td><td><small>equation variable</small></td></tr><tr><td>theta_cl_ada</td><td>0.307</td><td></td><td><small>equation variable</small></td></tr></table><h4>About infliximab</h4><p>Infliximab is a monoclonal antibody that blocks tumour necrosis factor alpha and is used to treat inflammatory conditions such as rheumatoid and psoriatic arthritis, Crohn's disease, ulcerative colitis, psoriasis, and ankylosing spondylitis. It is approved and widely used, with several products authorised in the European Union, and is also being studied for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q415264\">Wikidata Q415264</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Infliximab\">Infliximab</a>.</p><h4>References</h4><ol><li><p>Eser A et al. (2021). Increased Induction Infliximab Clearance Predicts Early Antidrug Antibody Detection. <i>Journal of clinical pharmacology 61(2):224–233</i>. DOI:<a href=\"https://doi.org/10.1002/jcph.1732\">10.1002/jcph.1732</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/32905628\">32905628</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Eser_2021: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: accepted with caveats</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 3628800, Tolerance = 1e-9, Interval = 1));
end Infliximab_Eser2021_reference;
