  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>tofacitinib</td></tr><tr><td>ATC code:</td><td>L04AF01</td></tr><tr><td>model:</td><td>one compartment, oral dosing <small>(PK_1C_enteral)</small></td></tr><tr><td>source:</td><td>Xie R et al. 2019</td></tr><tr><td>population:</td><td>adult patients with psoriatic arthritis</td></tr><tr><td>measured compound:</td><td>tofacitinib</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_tofacitinib/Tofacitinib_Xie2019_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>CL/F, L/h</td><td>20.4</td><td>L/h</td><td><small>CL/F</small></td></tr><tr><td>V/F, L</td><td>110</td><td>L</td><td><small>V/F</small></td></tr><tr><td>Ka, /h</td><td>13.8</td><td>/h</td><td><small>kabs</small></td></tr><tr><td>Lag time, h</td><td>0.3</td><td>h</td><td><small>tlag</small></td></tr></table><h4>About tofacitinib</h4><p>Tofacitinib is a JAK inhibitor immunosuppressant used to treat rheumatoid arthritis and ulcerative colitis, and has also been studied for conditions such as alopecia areata. It is an approved medicine, authorised in the European Union for rheumatoid arthritis, and carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3530324\">Wikidata Q3530324</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Tofacitinib\">Tofacitinib</a>.</p><h4>References</h4><ol><li><p>Xie R et al. (2019). Population pharmacokinetics of tofacitinib in patients with psoriatic arthritis. <i>International journal of clinical pharmacology and therapeutics 57(9):464–473</i>. DOI:<a href=\"https://doi.org/10.5414/CP203516\">10.5414/CP203516</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/31319908\">31319908</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Xie_2019: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
