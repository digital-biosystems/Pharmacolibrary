  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>sirolimus</td></tr><tr><td>ATC code:</td><td>L04AH01</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>de Tonnerre DJ et al. 2023</td></tr><tr><td>population:</td><td>healthy adult horses</td></tr><tr><td>measured compound:</td><td>sirolimus</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_sirolimus/Sirolimus_de2023_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>Volume of distribution</td><td>371.2</td><td>mL/kg</td><td><small>V</small></td></tr><tr><td>clearance</td><td>0.36</td><td>mL/kg/min</td><td><small>CL</small></td></tr></table><h4>About sirolimus</h4><p>Sirolimus is an immunosuppressive medicine used to prevent rejection of transplanted organs, and is also used in conditions such as renal cell carcinoma, graft-versus-host disease, lymphangioleiomyomatosis, and tuberous sclerosis-related angiofibroma. It is widely used and authorised in the European Union, with products approved for graft rejection, kidney transplantation, angiofibroma, tuberous sclerosis, and uveitis.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q32089\">Wikidata Q32089</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Sirolimus\">Sirolimus</a>.</p><h4>References</h4><ol><li><p>de Tonnerre DJ et al. (2023). Effect of sirolimus on insulin dynamics in horses. <i>Journal of veterinary internal medicine 37(2):703–712</i>. DOI:<a href=\"https://doi.org/10.1111/jvim.16650\">10.1111/jvim.16650</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/36840433\">36840433</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from de_2023: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 259200, Tolerance = 1e-9, Interval = 1));
