within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L04A_Immunosuppressants.L04AG06_Alemtuzumab;
model Alemtuzumab "Alemtuzumab — default model: Alemtuzumab_Dong2022_reference"
  extends Alemtuzumab_Dong2022_reference;
  annotation (Documentation(info = "<html><body><p>The default model of alemtuzumab: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L04A_Immunosuppressants.L04AG06_Alemtuzumab.Alemtuzumab_Dong2022_reference\">Alemtuzumab_Dong2022_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of alemtuzumab in this package:</p><ul><li><code>Alemtuzumab_Dong2022_reference</code></li></ul><h4>About alemtuzumab</h4><p>Alemtuzumab is a monoclonal antibody used to treat multiple sclerosis and certain leukemias, including chronic lymphocytic leukemia and T-cell prolymphocytic leukemia. It remains authorised in the European Union, though one EU product has been withdrawn, and it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q420164\">Wikidata Q420164</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Alemtuzumab\">Alemtuzumab</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 3024000, Tolerance = 1e-9, Interval = 1));
end Alemtuzumab;
