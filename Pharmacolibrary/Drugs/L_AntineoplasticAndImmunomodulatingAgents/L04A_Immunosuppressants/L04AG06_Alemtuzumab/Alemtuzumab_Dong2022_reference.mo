  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>alemtuzumab</td></tr><tr><td>ATC code:</td><td>L04AG06</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Dong M et al. 2022</td></tr><tr><td>population:</td><td>paediatric and young adult patients undergoing allogeneic haematopoietic cell transplantation</td></tr><tr><td>measured compound:</td><td>alemtuzumab</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_alemtuzumab/Alemtuzumab_Dong2022_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>clearance</td><td>0.08</td><td>L/h/70 kg</td><td><small>CL</small></td></tr><tr><td>volume of distribution</td><td>17.4</td><td>L/70 kg</td><td><small>V</small></td></tr></table><h4>About alemtuzumab</h4><p>Alemtuzumab is a monoclonal antibody used to treat multiple sclerosis and certain leukemias, including chronic lymphocytic leukemia and T-cell prolymphocytic leukemia. It remains authorised in the European Union, though one EU product has been withdrawn, and it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q420164\">Wikidata Q420164</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Alemtuzumab\">Alemtuzumab</a>.</p><h4>References</h4><ol><li><p>Dong M et al. (2022). Model-informed precision dosing for alemtuzumab in paediatric and young adult patients undergoing allogeneic haematopoietic cell transplantation. <i>British journal of clinical pharmacology 88(1):248–259</i>. DOI:<a href=\"https://doi.org/10.1111/bcp.14955\">10.1111/bcp.14955</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/34182590\">34182590</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Dong_2022: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 3024000, Tolerance = 1e-9, Interval = 1));
end Alemtuzumab_Dong2022_reference;
