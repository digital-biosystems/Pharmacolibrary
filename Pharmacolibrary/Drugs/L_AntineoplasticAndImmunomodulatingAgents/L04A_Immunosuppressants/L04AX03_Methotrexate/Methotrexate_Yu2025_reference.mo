within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L04A_Immunosuppressants.L04AX03_Methotrexate;
model Methotrexate_Yu2025_reference
  parameter Real Cl_ref = 1.175e-06 "Cl [m3/s]";
  parameter Real Vd_ref = 0.01384 "Vd [m3]";
  extends Pharmacolibrary.Pharmacokinetic.Models.PK_2C_enteral(
    weight = 70.0,
    F = 0.9,
