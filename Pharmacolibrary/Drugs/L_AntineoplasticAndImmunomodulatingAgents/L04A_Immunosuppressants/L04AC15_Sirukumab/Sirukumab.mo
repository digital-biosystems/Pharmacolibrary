within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L04A_Immunosuppressants.L04AC15_Sirukumab;
model Sirukumab "Sirukumab — default model: Sirukumab_Zhuang2013_reference"
  extends Sirukumab_Zhuang2013_reference;
  annotation (Documentation(info = "<html><body><p>The default model of sirukumab: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L04A_Immunosuppressants.L04AC15_Sirukumab.Sirukumab_Zhuang2013_reference\">Sirukumab_Zhuang2013_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of sirukumab in this package:</p><ul><li><code>Sirukumab_Zhuang2013_reference</code></li></ul><h4>About sirukumab</h4><p>Sirukumab, a monoclonal antibody interleukin inhibitor, was investigated for treating rheumatoid arthritis. It was never approved; its marketing application in the European Union was withdrawn, so it remains investigational.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7530673\">Wikidata Q7530673</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Sirukumab\">Sirukumab</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 7257600, Tolerance = 1e-9, Interval = 1));
end Sirukumab;
