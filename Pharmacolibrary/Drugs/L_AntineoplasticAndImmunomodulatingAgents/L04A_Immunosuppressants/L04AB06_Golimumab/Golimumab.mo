within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L04A_Immunosuppressants.L04AB06_Golimumab;
model Golimumab "Golimumab — default model: Golimumab_Lee2023_reference"
  extends Golimumab_Lee2023_reference;
  annotation (Documentation(info = "<html><body><p>The default model of golimumab: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L04A_Immunosuppressants.L04AB06_Golimumab.Golimumab_Lee2023_reference\">Golimumab_Lee2023_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of golimumab in this package:</p><ul><li><code>Golimumab_Lee2023_reference</code></li></ul><h4>About golimumab</h4><p>Golimumab is a monoclonal antibody that blocks tumour necrosis factor alpha and is used to treat inflammatory conditions such as rheumatoid and psoriatic arthritis, ankylosing spondylitis, and ulcerative colitis. It is an approved medicine, authorised in the European Union, and is widely used for these immune-mediated diseases.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q413879\">Wikidata Q413879</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Golimumab\">Golimumab</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 6048000, Tolerance = 1e-9, Interval = 1));
end Golimumab;
