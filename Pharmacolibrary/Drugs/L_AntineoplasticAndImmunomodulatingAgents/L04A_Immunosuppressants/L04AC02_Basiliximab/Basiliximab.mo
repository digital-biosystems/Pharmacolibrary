within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L04A_Immunosuppressants.L04AC02_Basiliximab;
model Basiliximab "Basiliximab — default model: Basiliximab_Kovarik2001_reference"
  extends Basiliximab_Kovarik2001_reference;
  annotation (Documentation(info = "<html><body><p>The default model of basiliximab: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L04A_Immunosuppressants.L04AC02_Basiliximab.Basiliximab_Kovarik2001_reference\">Basiliximab_Kovarik2001_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of basiliximab in this package:</p><ul><li><code>Basiliximab_Kovarik1999_reference</code></li><li><code>Basiliximab_Kovarik1999v2_reference</code></li><li><code>Basiliximab_Kovarik2001_reference</code></li></ul><h4>About basiliximab</h4><p>Basiliximab is an immunosuppressive monoclonal antibody used to prevent graft rejection in kidney transplantation. It is authorised in the European Union and used in transplant medicine, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q418702\">Wikidata Q418702</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Basiliximab\">Basiliximab</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 4233600, Tolerance = 1e-9, Interval = 1));
end Basiliximab;
