  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>basiliximab</td></tr><tr><td>ATC code:</td><td>L04AC02</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Kovarik JM et al. 1999</td></tr><tr><td>population:</td><td>renal transplant patients</td></tr><tr><td>measured compound:</td><td>basiliximab</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_basiliximab/Basiliximab_Kovarik1999v2_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>The basiliximab distribution volume was</td><td>7.5</td><td>L</td><td><small>V</small></td></tr><tr><td>the half-life</td><td>7.5</td><td>d</td><td><small>t1/2z</small></td></tr><tr><td>and the clearance</td><td>33</td><td>mL/h</td><td><small>CL</small></td></tr></table><h4>About basiliximab</h4><p>Basiliximab is an immunosuppressive monoclonal antibody used to prevent graft rejection in kidney transplantation. It is authorised in the European Union and used in transplant medicine, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q418702\">Wikidata Q418702</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Basiliximab\">Basiliximab</a>.</p><h4>References</h4><ol><li><p>Kovarik JM et al. (1999). Screening for basiliximab exposure-response relationships in renal allotransplantation. <i>Clinical transplantation 13(1 Pt 1):32–38</i>. DOI:<a href=\"https://doi.org/10.1034/j.1399-0012.1999.t01-2-130105.x\">10.1034/j.1399-0012.1999.t01-2-130105.x</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/10081632\">10081632</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Kovarik_1999_2: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
