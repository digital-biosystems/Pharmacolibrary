  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>basiliximab</td></tr><tr><td>ATC code:</td><td>L04AC02</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Kovarik JM et al. 2001</td></tr><tr><td>population:</td><td>de novo liver allograft recipients</td></tr><tr><td>measured compound:</td><td>basiliximab</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_basiliximab/Basiliximab_Kovarik2001_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>Basiliximab clearance</td><td>55</td><td>mL/h</td><td><small>CL</small></td></tr><tr><td>distribution volume</td><td>9.7</td><td>L</td><td><small>V</small></td></tr><tr><td>half-life</td><td>8.7</td><td>days</td><td><small>t1/2z</small></td></tr></table><h4>About basiliximab</h4><p>Basiliximab is an immunosuppressive monoclonal antibody used to prevent graft rejection in kidney transplantation. It is authorised in the European Union and used in transplant medicine, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q418702\">Wikidata Q418702</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Basiliximab\">Basiliximab</a>.</p><h4>References</h4><ol><li><p>Kovarik JM et al. (2001). A population pharmacokinetic screen to identify demographic-clinical covariates of basiliximab in liver transplantation. <i>Clinical pharmacology and therapeutics 69(4):201–209</i>. DOI:<a href=\"https://doi.org/10.1067/mcp.2001.114887\">10.1067/mcp.2001.114887</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/11309548\">11309548</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Kovarik_2001: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
