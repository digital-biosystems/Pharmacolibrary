within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L04A_Immunosuppressants.L04AD02_Tacrolimus;
model Tacrolimus "Tacrolimus — default model: Tacrolimus_Chen2023_base"
  extends Tacrolimus_Chen2023_base;
  annotation (Documentation(info = "<html><body><p>The default model of tacrolimus: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L04A_Immunosuppressants.L04AD02_Tacrolimus.Tacrolimus_Chen2023_base\">Tacrolimus_Chen2023_base</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of tacrolimus in this package:</p><ul><li><code>Tacrolimus_Chen2023_base</code></li><li><code>Tacrolimus_Xiang2025_PD_fpg</code></li><li><code>Tacrolimus_Xiang2025_PD_egfr</code></li></ul><h4>About tacrolimus</h4><p>Tacrolimus is an immunosuppressive drug used to prevent organ transplant rejection and to treat conditions such as atopic dermatitis, ulcerative colitis, and graft-versus-host disease. It is widely used and authorised in the European Union, available as an approved medicine for transplant and dermatological indications.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q411648\">Wikidata Q411648</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Tacrolimus\">Tacrolimus</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 1036800, Tolerance = 1e-9, Interval = 1));
end Tacrolimus;
