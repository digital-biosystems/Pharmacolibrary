within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L04A_Immunosuppressants.L04AX06_Pomalidomide;
model Pomalidomide "Pomalidomide — default model: Pomalidomide_Ogasawara2021_reference"
  extends Pomalidomide_Ogasawara2021_reference;
  annotation (Documentation(info = "<html><body><p>The default model of pomalidomide: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L04A_Immunosuppressants.L04AX06_Pomalidomide.Pomalidomide_Ogasawara2021_reference\">Pomalidomide_Ogasawara2021_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of pomalidomide in this package:</p><ul><li><code>Pomalidomide_Ogasawara2021_reference</code></li><li><code>Pomalidomide_Koiwai2021_PD_m_protein</code></li></ul><h4>About pomalidomide</h4><p>Pomalidomide is an immunomodulating and anti-angiogenic medicine used to treat multiple myeloma, and has also been studied for conditions such as amyloidosis, myelofibrosis, and plasma cell leukemia. It is approved and authorised in the European Union, where several pomalidomide products are on the market.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7227206\">Wikidata Q7227206</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Pomalidomide\">Pomalidomide</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 151200, Tolerance = 1e-9, Interval = 1));
end Pomalidomide;
