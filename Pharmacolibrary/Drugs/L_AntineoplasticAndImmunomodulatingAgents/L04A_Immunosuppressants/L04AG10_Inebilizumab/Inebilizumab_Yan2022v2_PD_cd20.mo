within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L04A_Immunosuppressants.L04AG10_Inebilizumab;
model Inebilizumab_Yan2022v2_PD_cd20
  "linear exposure-response sweep — Yan_2022_2 :: CD20+ (CD20+ B-cell count)"
  extends Pharmacolibrary.Interfaces.PartialExposureResponseSweep(
    E0 = 135,      // [cells μL−1]
    Emax = 0, EC50 = 1,      // unused by a line
    exposure_per_s = 1);
  parameter Real slope = 0.014   "[1]";
equation
  response = E0 + slope*exposure;
  // family_inferred: the record's model family is transduction; read from the parameters: a slope and no Emax — linear
  annotation(experiment(StartTime = 0, StopTime = 1000, Interval = 2),
    Documentation(info = "<html><body><h4>Inebilizumab_Yan2022v2_PD_cd20</h4><p>The steady-state exposure-response curve of Yan L et al., <i>British journal of clinical pharmacology 88(8):3803–3812</i> 2022 (<a href=\"https://doi.org/10.1111/bcp.15332\">doi:10.1111/bcp.15332</a>) — CD20+ B-cell count [cells μL−1] against inebilizumab — obtained by sweeping the driver instead of simulating a dose. Model family: linear.</p><h4>The parameters, in the paper's terms</h4><pre>  E0    =        135 cells μL−1 drug-free response (baseline) (Baseline CD20, Q324)
  slope =      0.014          change in response per unit of exposure (Slope, Q335)</pre><p>The algebra is <code>response = E0 + slope*exposure</code>; this model only supplies the numbers. The x axis is one  of inebilizumab per second of simulated time: there is no state, no dose and no kinetics — plot <code>response</code> against <code>exposure</code> (or <code>time</code>).</p><h4>What it reproduces</h4><pre>  exposure = 0         response 135   (drug-free)</pre></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Yan_2022_2: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"));
end Inebilizumab_Yan2022v2_PD_cd20;
