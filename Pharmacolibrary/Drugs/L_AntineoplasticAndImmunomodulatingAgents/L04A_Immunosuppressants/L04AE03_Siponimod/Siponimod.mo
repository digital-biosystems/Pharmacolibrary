  extends Siponimod_Chaoyang2022v2_estimates_rse;
  annotation (Documentation(info = "<html><body><p>The default model of siponimod: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L04A_Immunosuppressants.L04AE03_Siponimod.Siponimod_Chaoyang2022v2_estimates_rse\">Siponimod_Chaoyang2022v2_estimates_rse</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of siponimod in this package:</p><ul><li><code>Siponimod_Chaoyang2022v2_estimates_rse</code></li></ul><h4>About siponimod</h4><p>Siponimod is an immunosuppressant used to treat relapsing-remitting multiple sclerosis. It is an approved medicine authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q25100876\">Wikidata Q25100876</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Siponimod\">Siponimod</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 518400, Tolerance = 1e-9, Interval = 1));
end Siponimod;
