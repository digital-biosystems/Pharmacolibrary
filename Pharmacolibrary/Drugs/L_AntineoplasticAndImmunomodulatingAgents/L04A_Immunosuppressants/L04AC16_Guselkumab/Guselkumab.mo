within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L04A_Immunosuppressants.L04AC16_Guselkumab;
model Guselkumab "Guselkumab — default model: Guselkumab_Yao2018_reference"
  extends Guselkumab_Yao2018_reference;
  annotation (Documentation(info = "<html><body><p>The default model of guselkumab: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L04A_Immunosuppressants.L04AC16_Guselkumab.Guselkumab_Yao2018_reference\">Guselkumab_Yao2018_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of guselkumab in this package:</p><ul><li><code>Guselkumab_Yao2018_reference</code></li></ul><h4>About guselkumab</h4><p>Guselkumab is a monoclonal antibody that acts as an interleukin inhibitor, belonging to the immunosuppressant class of medicines. It is an approved medicine and has also been investigated for further uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q15708315\">Wikidata Q15708315</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Guselkumab\">Guselkumab</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 8467200, Tolerance = 1e-9, Interval = 1));
end Guselkumab;
