within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01A_AlkylatingAgents.L01AD01_Carmustine;
model Carmustine "Carmustine — default model: Carmustine_Russo1981_reference"
  extends Carmustine_Russo1981_reference;
  annotation (Documentation(info = "<html><body><p>The default model of carmustine: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01A_AlkylatingAgents.L01AD01_Carmustine.Carmustine_Russo1981_reference\">Carmustine_Russo1981_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of carmustine in this package:</p><ul><li><code>Carmustine_Russo1981_reference</code></li></ul><h4>About carmustine</h4><p>Carmustine is an alkylating anticancer drug used to treat cancers such as Hodgkin disease and non-Hodgkin lymphoma. It remains an approved medicine, with an authorised product in the European Union, and carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q415869\">Wikidata Q415869</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Carmustine\">Carmustine</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Carmustine;
