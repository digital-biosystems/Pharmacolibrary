within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01A_AlkylatingAgents.L01AA03_Melphalan;
model Melphalan "Melphalan — default model: Melphalan_Li2022_reference"
  extends Melphalan_Li2022_reference;
  annotation (Documentation(info = "<html><body><p>The default model of melphalan: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01A_AlkylatingAgents.L01AA03_Melphalan.Melphalan_Li2022_reference\">Melphalan_Li2022_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of melphalan in this package:</p><ul><li><code>Melphalan_Li2022_reference</code></li></ul><h4>About melphalan</h4><p>Melphalan is an alkylating anticancer drug used mainly to treat multiple myeloma, and also other cancers such as ovarian and breast cancer and childhood tumours like neuroblastoma. It is an approved medicine, authorised in the European Union, and is also used in conditioning before stem cell transplantation.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2298283\">Wikidata Q2298283</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Melphalan\">Melphalan</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Melphalan;
