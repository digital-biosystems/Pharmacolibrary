  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>melphalan</td></tr><tr><td>ATC code:</td><td>L01AA03</td></tr><tr><td>model:</td><td>two compartments, IV dosing <small>(PK_2C)</small></td></tr><tr><td>source:</td><td>Li S et al. 2022</td></tr><tr><td>population:</td><td>pediatric patients undergoing hematopoietic cell transplantation</td></tr><tr><td>measured compound:</td><td>melphalan</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_melphalan/Melphalan_Li2022_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>clearance</td><td>19.1</td><td>L/h/25 kg</td><td><small>CL</small></td></tr><tr><td>volume of the central compartment</td><td>8.5</td><td>L/25 kg</td><td><small>V1</small></td></tr><tr><td>volume of the peripheral compartment</td><td>5.8</td><td>L/25 kg</td><td><small>V2</small></td></tr><tr><td>intercompartmental clearance</td><td>12.4</td><td>L/h/25 kg</td><td><small>Q</small></td></tr></table><h4>About melphalan</h4><p>Melphalan is an alkylating anticancer drug used mainly to treat multiple myeloma, and also other cancers such as ovarian and breast cancer and childhood tumours like neuroblastoma. It is an approved medicine, authorised in the European Union, and is also used in conditioning before stem cell transplantation.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2298283\">Wikidata Q2298283</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Melphalan\">Melphalan</a>.</p><h4>References</h4><ol><li><p>Li S et al. (2022). Population Pharmacokinetics of Melphalan for Pediatric Patients Undergoing Hematopoietic Cell Transplantation. <i>Journal of clinical pharmacology 62(7):873–882</i>. DOI:<a href=\"https://doi.org/10.1002/jcph.2030\">10.1002/jcph.2030</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/35048362\">35048362</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Li_2022: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
