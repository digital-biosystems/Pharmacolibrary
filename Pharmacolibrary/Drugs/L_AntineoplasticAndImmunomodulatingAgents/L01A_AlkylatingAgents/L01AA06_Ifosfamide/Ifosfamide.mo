within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01A_AlkylatingAgents.L01AA06_Ifosfamide;
model Ifosfamide "Ifosfamide — default model: Ifosfamide_Kerbusch2001v4_reference"
  extends Ifosfamide_Kerbusch2001v4_reference;
  annotation (Documentation(info = "<html><body><p>The default model of ifosfamide: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01A_AlkylatingAgents.L01AA06_Ifosfamide.Ifosfamide_Kerbusch2001v4_reference\">Ifosfamide_Kerbusch2001v4_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of ifosfamide in this package:</p><ul><li><code>Ifosfamide_Kerbusch2001v4_reference</code></li><li><code>Ifosfamide_Brain2008_PD_anc</code></li></ul><h4>About ifosfamide</h4><p>Ifosfamide is an alkylating anticancer drug used to treat various cancers, including sarcomas, lymphomas, and cancers of the breast, ovary, stomach, pancreas, and testis. It is an approved medicine and is included on the WHO list of essential medicines, so it is used widely in cancer care.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q418560\">Wikidata Q418560</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Ifosfamide\">Ifosfamide</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 259200, Tolerance = 1e-9, Interval = 1));
end Ifosfamide;
