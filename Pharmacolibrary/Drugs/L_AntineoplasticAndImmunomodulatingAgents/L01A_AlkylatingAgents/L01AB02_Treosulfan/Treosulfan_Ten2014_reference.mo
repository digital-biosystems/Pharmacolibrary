  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>treosulfan</td></tr><tr><td>ATC code:</td><td>L01AB02</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Ten Brink MH et al. 2014</td></tr><tr><td>population:</td><td>pediatric patients</td></tr><tr><td>measured compound:</td><td>treosulfan</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_treosulfan/Treosulfan_Ten2014_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>clearance (CL)</td><td>6.85</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>volume of distribution</td><td>13.2</td><td>L</td><td><small>V</small></td></tr></table><h4>About treosulfan</h4><p>Treosulfan is an alkylating anticancer drug used as conditioning treatment before hematopoietic stem cell transplantation. It is authorised in the European Union and is also being investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7838652\">Wikidata Q7838652</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Treosulfan\">Treosulfan</a>.</p><h4>References</h4><ol><li><p>Ten Brink MH et al. (2014). Pharmacokinetics of treosulfan in pediatric patients undergoing hematopoietic stem cell transplantation. <i>Therapeutic drug monitoring 36(4):465–472</i>. DOI:<a href=\"https://doi.org/10.1097/FTD.0000000000000047\">10.1097/FTD.0000000000000047</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/24487253\">24487253</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Ten_2014: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
