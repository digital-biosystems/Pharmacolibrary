  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>treosulfan</td></tr><tr><td>ATC code:</td><td>L01AB02</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Rosser SPA et al. 2023</td></tr><tr><td>population:</td><td>paediatric patients undergoing haematopoietic stem cell transplantation</td></tr><tr><td>measured compound:</td><td>treosulfan</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_treosulfan/Treosulfan_Rosser2023_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>clearance (CL)</td><td>16.3</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>volume of distribution (V)</td><td>41.9</td><td>L</td><td><small>V</small></td></tr></table><h4>About treosulfan</h4><p>Treosulfan is an alkylating anticancer drug used as conditioning treatment before hematopoietic stem cell transplantation. It is authorised in the European Union and is also being investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7838652\">Wikidata Q7838652</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Treosulfan\">Treosulfan</a>.</p><h4>References</h4><ol><li><p>Rosser SPA et al. (2023). Evaluation of treosulfan cumulative exposure in paediatric patients through population pharmacokinetics and dosing simulations. <i>British journal of clinical pharmacology 89(4):1413–1424</i>. DOI:<a href=\"https://doi.org/10.1111/bcp.15599\">10.1111/bcp.15599</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/36369677\">36369677</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Rosser_2023: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
