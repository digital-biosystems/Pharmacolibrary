within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01B_Antimetabolites.L01BC05_Gemcitabine;
model Gemcitabine "Gemcitabine — default model: Gemcitabine_Serdjebi2017_reference"
  extends Gemcitabine_Serdjebi2017_reference;
  annotation (Documentation(info = "<html><body><p>The default model of gemcitabine: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01B_Antimetabolites.L01BC05_Gemcitabine.Gemcitabine_Serdjebi2017_reference\">Gemcitabine_Serdjebi2017_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of gemcitabine in this package:</p><ul><li><code>Gemcitabine_Serdjebi2017_reference</code></li><li><code>Gemcitabine_Yao2023_PD_nbw</code></li></ul><h4>About gemcitabine</h4><p>Gemcitabine is an antimetabolite anticancer drug used to treat various cancers, including pancreatic, lung, bladder, and breast-related carcinomas as well as several lymphomas. It is an approved medicine and is included on the WHO list of essential medicines, so it is widely used in cancer treatment worldwide.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q414143\">Wikidata Q414143</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Gemcitabine\">Gemcitabine</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Gemcitabine;
