  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>pemetrexed</td></tr><tr><td>ATC code:</td><td>L01BA04</td></tr><tr><td>model:</td><td>two compartments, IV dosing <small>(PK_2C)</small></td></tr><tr><td>source:</td><td>Srinivasan M et al. 2019</td></tr><tr><td>population:</td><td>adult patients with non-small cell lung cancer</td></tr><tr><td>measured compound:</td><td>pemetrexed</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_pemetrexed/Pemetrexed_Srinivasan2019_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>clearance (CL)</td><td>3.3</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>central volume of distribution (V1)</td><td>5.2</td><td>L</td><td><small>V1</small></td></tr><tr><td>peripheral volume of distribution (V2)</td><td>5.9</td><td>L</td><td><small>V2</small></td></tr><tr><td>intercompartmental clearance (Q)</td><td>6.8</td><td>L/h</td><td><small>Q</small></td></tr></table><h4>About pemetrexed</h4><p>Pemetrexed is an anticancer drug used to treat non-small-cell lung cancer and mesothelioma. It is an approved antifolate chemotherapy, with several products authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q415220\">Wikidata Q415220</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Pemetrexed\">Pemetrexed</a>.</p><h4>References</h4><ol><li><p>Srinivasan M et al. (2019). Population Pharmacokinetics of Pemetrexed in Adult Non-Small Cell Lung Cancer in Indian Patients. <i>Journal of clinical pharmacology 59(9):1216–1224</i>. DOI:<a href=\"https://doi.org/10.1002/jcph.1417\">10.1002/jcph.1417</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/30973978\">30973978</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Srinivasan_2019: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
