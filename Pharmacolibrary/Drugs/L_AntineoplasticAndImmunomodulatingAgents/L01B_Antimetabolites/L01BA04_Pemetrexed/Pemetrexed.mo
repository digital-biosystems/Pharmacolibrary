within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01B_Antimetabolites.L01BA04_Pemetrexed;
model Pemetrexed "Pemetrexed — default model: Pemetrexed_Cao2022_reference"
  extends Pemetrexed_Cao2022_reference;
  annotation (Documentation(info = "<html><body><p>The default model of pemetrexed: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01B_Antimetabolites.L01BA04_Pemetrexed.Pemetrexed_Cao2022_reference\">Pemetrexed_Cao2022_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of pemetrexed in this package:</p><ul><li><code>Pemetrexed_Boosman2023_reference</code></li><li><code>Pemetrexed_Cao2022_reference</code></li></ul><h4>About pemetrexed</h4><p>Pemetrexed is an anticancer drug used to treat non-small-cell lung cancer and mesothelioma. It is an approved antifolate chemotherapy, with several products authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q415220\">Wikidata Q415220</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Pemetrexed\">Pemetrexed</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Pemetrexed;
