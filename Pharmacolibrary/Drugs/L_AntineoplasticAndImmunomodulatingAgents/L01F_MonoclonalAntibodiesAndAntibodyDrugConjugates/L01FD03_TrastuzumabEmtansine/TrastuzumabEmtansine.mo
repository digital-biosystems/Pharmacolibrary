  extends TrastuzumabEmtansine_Chen2017_reference;
  annotation (Documentation(info = "<html><body><p>The default model of trastuzumab emtansine: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01F_MonoclonalAntibodiesAndAntibodyDrugConjugates.L01FD03_TrastuzumabEmtansine.TrastuzumabEmtansine_Chen2017_reference\">TrastuzumabEmtansine_Chen2017_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of trastuzumab emtansine in this package:</p><ul><li><code>TrastuzumabEmtansine_Chen2017_reference</code></li><li><code>TrastuzumabEmtansine_Gupta2012_reference</code></li></ul><h4>About trastuzumab emtansine</h4><p>Ado-trastuzumab emtansine is an antibody-drug conjugate used to treat breast cancer. It is authorised in the European Union and is used in cancer care, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3997863\">Wikidata Q3997863</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.TrastuzumabEmtansine\">TrastuzumabEmtansine</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 1728000, Tolerance = 1e-9, Interval = 1));
end TrastuzumabEmtansine;
