within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01F_MonoclonalAntibodiesAndAntibodyDrugConjugates.L01FG02_Ramucirumab;
model Ramucirumab_OBrien2017_reference
  parameter Real Cl_ref = 4.111111111111111e-09 "Cl [m3/s]";
  parameter Real Vd_ref = 0.00326 "Vd [m3]";
  parameter Real cov_body_weight_0 = 0 "body weight covariate";
  extends Pharmacolibrary.Pharmacokinetic.Models.PK_2C(
    weight = 70.0,
    F = 1,
    Cl = Cl_ref,
    Vd = Vd_ref*(1 + (0.556)*cov_body_weight_0),
    adminDuration = 600,
    adminCount = 1,
    adminMass = 0.00056,
    k12 = 8.691206543967281e-07,
    k21 = 1.388888888888889e-06
  );

  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>ramucirumab</td></tr><tr><td>ATC code:</td><td>L01FG02</td></tr><tr><td>model:</td><td>two compartments, IV dosing <small>(PK_2C)</small></td></tr><tr><td>source:</td><td>O'Brien L et al. 2017</td></tr><tr><td>population:</td><td>cancer patients</td></tr><tr><td>measured compound:</td><td>ramucirumab</td></tr><tr><td>review:</td><td>accepted with caveats</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_ramucirumab/Ramucirumab_OBrien2017_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>Clearance (CL), l h −1</td><td>0.0148</td><td>l h −1</td><td><small>CL</small></td></tr><tr><td>Central volume of distribution (V 1 ), l</td><td>3.26</td><td>l</td><td><small>V1</small></td></tr><tr><td>Intercompartmental clearance (Q), l h −1</td><td>0.0102</td><td>l h −1</td><td><small>Q</small></td></tr><tr><td>Peripheral volume of distribution (V 2 ), l</td><td>2.04</td><td>l</td><td><small>V2</small></td></tr><tr><td>theta_q23_body_weight</td><td>0.499</td><td></td><td><small>equation variable</small></td></tr><tr><td>theta_v1_body_weight</td><td>0.556</td><td></td><td><small>equation variable</small></td></tr></table><h4>About ramucirumab</h4><p>Ramucirumab is a monoclonal antibody used as an anticancer treatment for tumours such as gastric, lung, and colon cancer. It is an approved medicine, with products authorised in the European Union, and is used in cancer care.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7290345\">Wikidata Q7290345</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Ramucirumab\">Ramucirumab</a>.</p><h4>References</h4><ol><li><p>O'Brien L et al. (2017). Population pharmacokinetic meta-analysis of ramucirumab in cancer patients. <i>British journal of clinical pharmacology 83(12):2741–2751</i>. DOI:<a href=\"https://doi.org/10.1111/bcp.13403\">10.1111/bcp.13403</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/28833321\">28833321</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from OBrien_2017: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: accepted with caveats</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 3024000, Tolerance = 1e-9, Interval = 1));
end Ramucirumab_OBrien2017_reference;
