within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01F_MonoclonalAntibodiesAndAntibodyDrugConjugates.L01FF05_Atezolizumab;
model Atezolizumab "Atezolizumab — default model: Atezolizumab_Stroh2017_reference"
  extends Atezolizumab_Stroh2017_reference;
  annotation (Documentation(info = "<html><body><p>The default model of atezolizumab: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01F_MonoclonalAntibodiesAndAntibodyDrugConjugates.L01FF05_Atezolizumab.Atezolizumab_Stroh2017_reference\">Atezolizumab_Stroh2017_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of atezolizumab in this package:</p><ul><li><code>Atezolizumab_Stroh2017_reference</code></li></ul><h4>About atezolizumab</h4><p>Atezolizumab is a monoclonal antibody that blocks PD-L1 and is used to treat several cancers, including bladder, lung, breast, and colorectal cancers. It is approved and authorised in the European Union, where it is used in cancer care.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q20707748\">Wikidata Q20707748</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Atezolizumab\">Atezolizumab</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 12096000, Tolerance = 1e-9, Interval = 1));
end Atezolizumab;
