  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>atezolizumab</td></tr><tr><td>ATC code:</td><td>L01FF05</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Stroh M et al. 2017</td></tr><tr><td>population:</td><td>patients with metastatic urothelial carcinoma</td></tr><tr><td>measured compound:</td><td>atezolizumab</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_atezolizumab/Atezolizumab_Stroh2017_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>clearance</td><td>0.200</td><td>L/day</td><td><small>CL</small></td></tr><tr><td>volume of distribution</td><td>6.91</td><td>L</td><td><small>V</small></td></tr><tr><td>terminal half-life</td><td>27</td><td>days</td><td><small>t1/2z</small></td></tr></table><h4>About atezolizumab</h4><p>Atezolizumab is a monoclonal antibody that blocks PD-L1 and is used to treat several cancers, including bladder, lung, breast, and colorectal cancers. It is approved and authorised in the European Union, where it is used in cancer care.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q20707748\">Wikidata Q20707748</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Atezolizumab\">Atezolizumab</a>.</p><h4>References</h4><ol><li><p>Stroh M et al. (2017). Clinical Pharmacokinetics and Pharmacodynamics of Atezolizumab in Metastatic Urothelial Carcinoma. <i>Clinical pharmacology and therapeutics 102(2):305–312</i>. DOI:<a href=\"https://doi.org/10.1002/cpt.587\">10.1002/cpt.587</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/27981577\">27981577</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Stroh_2017: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 12096000, Tolerance = 1e-9, Interval = 1));
