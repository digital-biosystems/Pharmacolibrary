  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>isatuximab</td></tr><tr><td>ATC code:</td><td>L01FC02</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Fau JB et al. 2020</td></tr><tr><td>population:</td><td>patients with relapsed/refractory multiple myeloma</td></tr><tr><td>measured compound:</td><td>isatuximab</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_isatuximab/Isatuximab_Fau2020_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>typical linear CL at steady-state</td><td>0.00955</td><td>L/hour</td><td><small>CL</small></td></tr><tr><td>typical volume of distribution of the central compartment</td><td>5.13</td><td>L</td><td><small>V</small></td></tr></table><h4>About isatuximab</h4><p>Isatuximab is a monoclonal antibody that inhibits CD38 and is used to treat multiple myeloma. It is authorised in the European Union and is used in cancer treatment.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q20707906\">Wikidata Q20707906</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Isatuximab\">Isatuximab</a>.</p><h4>References</h4><ol><li><p>Fau JB et al. (2020). Drug-Disease Interaction and Time-Dependent Population Pharmacokinetics of Isatuximab in Relapsed/Refractory Multiple Myeloma Patients. <i>CPT: pharmacometrics &amp; systems pharmacology 9(11):649–658</i>. DOI:<a href=\"https://doi.org/10.1002/psp4.12561\">10.1002/psp4.12561</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/33021075\">33021075</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Fau_2020: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
