within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01F_MonoclonalAntibodiesAndAntibodyDrugConjugates.L01FF03_Durvalumab;
model Durvalumab_Zhao2026_reference
  parameter Real Cl_ref = 3.298611111111111e-09 "Cl [m3/s]";
  parameter Real cov_albumin_0 = 0 "albumin covariate";
  parameter Real cov_sex_1 = 0 "sex covariate";
  parameter Real cov_creatinine_2 = 0 "creatinine covariate";
  parameter Real cov_sex_3 = 0 "sex covariate";
  parameter Real Vd_ref = 0.00342 "Vd [m3]";
  extends Pharmacolibrary.Pharmacokinetic.Models.PK_2C(
    weight = 70.0,
    F = 1,
    Cl = Cl_ref*(1 + (-0.537)*cov_albumin_0)*(1 + (-0.143)*cov_sex_1)*(1 + (0.111)*cov_creatinine_2)*(1 + (-0.165)*cov_sex_3),
    Vd = Vd_ref,
    adminDuration = 600,
    adminCount = 1,
    adminMass = 0.0015,
    k12 = 3.0945419103313844e-05,
    k21 = 4.601449275362319e-05
  );

  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>durvalumab</td></tr><tr><td>ATC code:</td><td>L01FF03</td></tr><tr><td>model:</td><td>two compartments, IV dosing <small>(PK_2C)</small></td></tr><tr><td>source:</td><td>Zhao X et al. 2026</td></tr><tr><td>population:</td><td>Patients with urothelial carcinoma, NSCLC, SCLC and other solid tumours in the pooled PopPK dataset, including patients with resectable NSCLC</td></tr><tr><td>measured compound:</td><td>durvalumab</td></tr><tr><td>review:</td><td>accepted with caveats</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_durvalumab/Durvalumab_Zhao2026_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>CL</td><td>0.285</td><td>L/day</td><td><small>CL</small></td></tr><tr><td>V1</td><td>3.42</td><td>L</td><td><small>V1</small></td></tr><tr><td>V2</td><td>2.30</td><td>L</td><td><small>V2</small></td></tr><tr><td>Qintercompartmental</td><td>0.381</td><td>L/h</td><td><small>Q</small></td></tr><tr><td>albumin_on_cl</td><td>-0.537</td><td></td><td><small>equation variable</small></td></tr><tr><td>sex_on_v1</td><td>-0.143</td><td></td><td><small>equation variable</small></td></tr><tr><td>theta_cl_creatinine</td><td>0.111</td><td></td><td><small>equation variable</small></td></tr><tr><td>theta_cl_sex</td><td>-0.165</td><td></td><td><small>equation variable</small></td></tr><tr><td>theta_q319_bodyweight</td><td>0.382</td><td></td><td><small>equation variable</small></td></tr><tr><td>theta_q319_bodyweight</td><td>0.502</td><td></td><td><small>equation variable</small></td></tr></table><h4>About durvalumab</h4><p>Durvalumab is a monoclonal antibody that blocks the PD-L1 protein and is used to treat non-small-cell lung cancer. It is approved and authorised in the European Union, and is also being studied for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q19904005\">Wikidata Q19904005</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Durvalumab\">Durvalumab</a>.</p><h4>References</h4><ol><li><p>Zhao X et al. (2026). Population pharmacokinetics and exposure-response analysis of durvalumab in patients with resectable stage II to IIIB (N2) NSCLC in the phase III AEGEAN study. <i>British journal of clinical pharmacology 92(3):980–996</i>. DOI:<a href=\"https://doi.org/10.1002/bcp.70287\">10.1002/bcp.70287</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/41222125\">41222125</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Zhao_2026: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: accepted with caveats</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 3628800, Tolerance = 1e-9, Interval = 1));
end Durvalumab_Zhao2026_reference;
