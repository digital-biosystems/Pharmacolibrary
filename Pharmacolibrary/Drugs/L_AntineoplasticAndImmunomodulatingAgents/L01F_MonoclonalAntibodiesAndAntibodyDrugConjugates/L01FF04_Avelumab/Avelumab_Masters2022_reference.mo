within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01F_MonoclonalAntibodiesAndAntibodyDrugConjugates.L01FF04_Avelumab;
model Avelumab_Masters2022_reference
  parameter Real Cl_ref = 7.472222222222222e-09 "Cl [m3/s]";
  parameter Real cov_weight_0 = 0 "weight covariate";
  parameter Real Vd_ref = 0.003196 "Vd [m3]";
  extends Pharmacolibrary.Pharmacokinetic.Models.PK_2C(
    weight = 70.0,
    F = 1,
    Cl = Cl_ref*(1 + (0.5826)*cov_weight_0),
    Vd = Vd_ref,
    adminDuration = 600,
    adminCount = 1,
    adminMass = 0.0007,
    k12 = 2.9133639271311363e-05,
    k21 = 0.00012793502488473636
  );

  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>avelumab</td></tr><tr><td>ATC code:</td><td>L01FF04</td></tr><tr><td>model:</td><td>two compartments, IV dosing <small>(PK_2C)</small></td></tr><tr><td>source:</td><td>Masters JC et al. 2022</td></tr><tr><td>population:</td><td>patients with advanced renal cell carcinoma receiving avelumab plus axitinib</td></tr><tr><td>measured compound:</td><td>avelumab</td></tr><tr><td>review:</td><td>accepted with caveats</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_avelumab/Avelumab_Masters2022_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>θ CL, L/h</td><td>0.0269</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>θ V1, L</td><td>3.196</td><td>L</td><td><small>V1</small></td></tr><tr><td>θ V2, L</td><td>0.7278</td><td>L</td><td><small>V2</small></td></tr><tr><td>θ Q, L/h</td><td>0.3352</td><td>L/h</td><td><small>Q</small></td></tr><tr><td>θT50, days</td><td>99.24</td><td>days</td><td><small>equation variable</small></td></tr><tr><td>weight_on_v2</td><td>0.5826</td><td>days</td><td><small>equation variable</small></td></tr><tr><td>theta_q319_weight</td><td>0.4714</td><td></td><td><small>equation variable</small></td></tr><tr><td>theta_q319_weight</td><td>0.4694</td><td></td><td><small>equation variable</small></td></tr></table><h4>About avelumab</h4><p>Avelumab is a fully human anti-PD-L1 monoclonal antibody used as cancer immunotherapy, studied for tumours including Merkel cell carcinoma, bladder, ovarian, stomach, kidney, head and neck, and lung cancers, and mesothelioma. It is an approved anticancer medicine, with additional uses still under investigation.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q21083261\">Wikidata Q21083261</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Avelumab\">Avelumab</a>.</p><h4>References</h4><ol><li><p>Masters JC et al. (2022). Model-informed drug development supporting the approval of the avelumab flat-dose regimen in patients with advanced renal cell carcinoma. <i>CPT: pharmacometrics &amp; systems pharmacology 11(4):458–468</i>. DOI:<a href=\"https://doi.org/10.1002/psp4.12771\">10.1002/psp4.12771</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/35166465\">35166465</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Masters_2022: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: accepted with caveats</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 1555200, Tolerance = 1e-9, Interval = 1));
end Avelumab_Masters2022_reference;
