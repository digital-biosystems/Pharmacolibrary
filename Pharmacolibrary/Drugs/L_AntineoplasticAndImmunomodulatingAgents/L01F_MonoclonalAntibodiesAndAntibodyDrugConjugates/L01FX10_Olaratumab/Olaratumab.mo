  extends Olaratumab_Mo2018_base;
  annotation (Documentation(info = "<html><body><p>The default model of olaratumab: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01F_MonoclonalAntibodiesAndAntibodyDrugConjugates.L01FX10_Olaratumab.Olaratumab_Mo2018_base\">Olaratumab_Mo2018_base</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of olaratumab in this package:</p><ul><li><code>Olaratumab_Mo2018_base</code></li><li><code>Olaratumab_Mo2018_final</code></li></ul><h4>About olaratumab</h4><p>Olaratumab is a monoclonal antibody anticancer drug that was used to treat soft-tissue sarcoma.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7083108\">Wikidata Q7083108</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Olaratumab\">Olaratumab</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 2419200, Tolerance = 1e-9, Interval = 1));
end Olaratumab;
