  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>cetuximab</td></tr><tr><td>ATC code:</td><td>L01FE01</td></tr><tr><td>model:</td><td>two compartments, IV dosing <small>(PK_2C)</small></td></tr><tr><td>source:</td><td>Pointreau Y et al. 2016</td></tr><tr><td>population:</td><td>patients with head and neck squamous cell carcinoma</td></tr><tr><td>measured compound:</td><td>cetuximab</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_cetuximab/Cetuximab_Pointreau2016_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>V₁, L</td><td>3</td><td>L</td><td><small>V1</small></td></tr><tr><td>CL, L/d</td><td>12</td><td>L/d</td><td><small>CL</small></td></tr><tr><td>V₂, L</td><td>15</td><td>L</td><td><small>V2</small></td></tr><tr><td>Q, L/d</td><td>15</td><td>L/d</td><td><small>Q</small></td></tr><tr><td>k₀, mg/d</td><td>56</td><td>mg/d</td><td><small>R1</small></td></tr><tr><td>βV₁(BSA)</td><td>21</td><td>BSA</td><td><small>allometric_exponent</small></td></tr><tr><td>βk₀(TTT)</td><td>49</td><td>TTT</td><td><small>equation variable</small></td></tr></table><h4>About cetuximab</h4><p>Cetuximab is a monoclonal antibody used to treat several cancers, mainly head and neck cancers and colorectal cancers. It is approved and authorised in the European Union, and is also being investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q420296\">Wikidata Q420296</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Cetuximab\">Cetuximab</a>.</p><h4>References</h4><ol><li><p>Pointreau Y et al. (2016). Cetuximab Pharmacokinetics Influences Overall Survival in Patients With Head and Neck Cancer. <i>Therapeutic drug monitoring 38(5):567–572</i>. DOI:<a href=\"https://doi.org/10.1097/FTD.0000000000000321\">10.1097/FTD.0000000000000321</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/27631463\">27631463</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Pointreau_2016: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Cetuximab_Pointreau2016_reference;
