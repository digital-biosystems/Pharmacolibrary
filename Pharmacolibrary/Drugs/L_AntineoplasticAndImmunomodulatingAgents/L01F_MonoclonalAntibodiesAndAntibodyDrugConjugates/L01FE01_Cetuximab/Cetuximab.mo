within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01F_MonoclonalAntibodiesAndAntibodyDrugConjugates.L01FE01_Cetuximab;
model Cetuximab "Cetuximab — default model: Cetuximab_Pointreau2016_reference"
  extends Cetuximab_Pointreau2016_reference;
  annotation (Documentation(info = "<html><body><p>The default model of cetuximab: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01F_MonoclonalAntibodiesAndAntibodyDrugConjugates.L01FE01_Cetuximab.Cetuximab_Pointreau2016_reference\">Cetuximab_Pointreau2016_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of cetuximab in this package:</p><ul><li><code>Cetuximab_Azzopardi2011_reference</code></li><li><code>Cetuximab_Grisic2020_tvarcl</code></li><li><code>Cetuximab_Pointreau2016_reference</code></li></ul><h4>About cetuximab</h4><p>Cetuximab is a monoclonal antibody used to treat several cancers, mainly head and neck cancers and colorectal cancers. It is approved and authorised in the European Union, and is also being investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q420296\">Wikidata Q420296</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Cetuximab\">Cetuximab</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Cetuximab;
