within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01F_MonoclonalAntibodiesAndAntibodyDrugConjugates.L01FX20_Tremelimumab;
model Tremelimumab "Tremelimumab — default model: Tremelimumab_Wang2014_reference"
  extends Tremelimumab_Wang2014_reference;
  annotation (Documentation(info = "<html><body><p>The default model of tremelimumab: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01F_MonoclonalAntibodiesAndAntibodyDrugConjugates.L01FX20_Tremelimumab.Tremelimumab_Wang2014_reference\">Tremelimumab_Wang2014_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of tremelimumab in this package:</p><ul><li><code>Tremelimumab_Wang2014_reference</code></li></ul><h4>About tremelimumab</h4><p>Tremelimumab is a monoclonal antibody used as an anticancer medicine, notably for liver cancer and non-small-cell lung cancer. It is authorised in the European Union and is also being studied for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7838098\">Wikidata Q7838098</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Tremelimumab\">Tremelimumab</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 4838400, Tolerance = 1e-9, Interval = 1));
end Tremelimumab;
