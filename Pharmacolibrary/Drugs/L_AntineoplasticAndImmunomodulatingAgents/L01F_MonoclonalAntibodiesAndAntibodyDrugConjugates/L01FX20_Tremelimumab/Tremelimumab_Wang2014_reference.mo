    adminMass = 1e-05
  );

  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>tremelimumab</td></tr><tr><td>ATC code:</td><td>L01FX20</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Wang E et al. 2014</td></tr><tr><td>population:</td><td>patients with metastatic melanoma</td></tr><tr><td>measured compound:</td><td>tremelimumab</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_tremelimumab/Tremelimumab_Wang2014_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>clearance (CL)</td><td>0.26</td><td>L/day</td><td><small>CL</small></td></tr><tr><td>central volume of distribution</td><td>3.97</td><td>L</td><td><small>V</small></td></tr></table><h4>About tremelimumab</h4><p>Tremelimumab is a monoclonal antibody used as an anticancer medicine, notably for liver cancer and non-small-cell lung cancer. It is authorised in the European Union and is also being studied for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7838098\">Wikidata Q7838098</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Tremelimumab\">Tremelimumab</a>.</p><h4>References</h4><ol><li><p>Wang E et al. (2014). Population pharmacokinetic and pharmacodynamic analysis of tremelimumab in patients with metastatic melanoma. <i>Journal of clinical pharmacology 54(10):1108–1116</i>. DOI:<a href=\"https://doi.org/10.1002/jcph.309\">10.1002/jcph.309</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/24737343\">24737343</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Wang_2014: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 4838400, Tolerance = 1e-9, Interval = 1));
end Tremelimumab_Wang2014_reference;
