within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01F_MonoclonalAntibodiesAndAntibodyDrugConjugates.L01FG01_Bevacizumab;
model Bevacizumab "Bevacizumab — default model: Bevacizumab_Caulet2016_estimate"
  extends Bevacizumab_Caulet2016_estimate;
  annotation (Documentation(info = "<html><body><p>The default model of bevacizumab: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01F_MonoclonalAntibodiesAndAntibodyDrugConjugates.L01FG01_Bevacizumab.Bevacizumab_Caulet2016_estimate\">Bevacizumab_Caulet2016_estimate</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of bevacizumab in this package:</p><ul><li><code>Bevacizumab_Caulet2016_estimate</code></li></ul><h4>About bevacizumab</h4><p>Bevacizumab is a monoclonal antibody that blocks tumour blood vessel growth and is used to treat many cancers, including colorectal, breast, lung, kidney, cervical and ovarian cancers, as well as certain eye conditions such as wet macular degeneration. It is widely used and authorised in the European Union, appears on the WHO list of essential medicines, and is also used off-label in ophthalmology.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q413299\">Wikidata Q413299</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Bevacizumab\">Bevacizumab</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 6652800, Tolerance = 1e-9, Interval = 1));
end Bevacizumab;
