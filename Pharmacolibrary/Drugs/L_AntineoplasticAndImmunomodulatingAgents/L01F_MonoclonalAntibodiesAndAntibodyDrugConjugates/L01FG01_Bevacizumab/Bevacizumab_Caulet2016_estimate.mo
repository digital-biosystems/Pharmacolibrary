within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01F_MonoclonalAntibodiesAndAntibodyDrugConjugates.L01FG01_Bevacizumab;
model Bevacizumab_Caulet2016_estimate
  parameter Real Cl_ref = 2.1990740740740743e-09 "Cl [m3/s]";
  parameter Real Vd_ref = 0.004200000000000001 "Vd [m3]";
  parameter Real cov_height_0 = 0 "height covariate";
  extends Pharmacolibrary.Pharmacokinetic.Models.PK_2C(
    weight = 70.0,
    F = 1,
    Cl = Cl_ref,
    Vd = Vd_ref*(1 + (3.2)*cov_height_0),
    adminDuration = 600,
    adminCount = 1,
    adminMass = 1e-05,
    k12 = 1.901455026455026e-06,
    k21 = 1.037157287157287e-06
  );

  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>bevacizumab</td></tr><tr><td>ATC code:</td><td>L01FG01</td></tr><tr><td>model:</td><td>two compartments, IV dosing <small>(PK_2C)</small></td></tr><tr><td>source:</td><td>Caulet M et al. 2016</td></tr><tr><td>population:</td><td>patients with metastatic colorectal cancer</td></tr><tr><td>measured compound:</td><td>bevacizumab</td></tr><tr><td>review:</td><td>accepted with caveats</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_bevacizumab/Bevacizumab_Caulet2016_estimate\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>V C (L)</td><td>4.2</td><td>L</td><td><small>V1</small></td></tr><tr><td>k 10 (/day)</td><td>0.045</td><td>/day</td><td><small>kel</small></td></tr><tr><td>k 12 (/day)</td><td>0.16</td><td>/day</td><td><small>k12</small></td></tr><tr><td>k 21 (/day)</td><td>0.1</td><td>/day</td><td><small>k21</small></td></tr><tr><td>CL (L/day)</td><td>0.19</td><td>L/day</td><td><small>CL</small></td></tr><tr><td>V P (L)</td><td>7.7</td><td>L</td><td><small>V2</small></td></tr><tr><td>Q (L/day)</td><td>0.69</td><td>L/day</td><td><small>Q</small></td></tr><tr><td>theta_v1_height</td><td>3.2</td><td></td><td><small>equation variable</small></td></tr></table><h4>About bevacizumab</h4><p>Bevacizumab is a monoclonal antibody that blocks tumour blood vessel growth and is used to treat many cancers, including colorectal, breast, lung, kidney, cervical and ovarian cancers, as well as certain eye conditions such as wet macular degeneration. It is widely used and authorised in the European Union, appears on the WHO list of essential medicines, and is also used off-label in ophthalmology.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q413299\">Wikidata Q413299</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Bevacizumab\">Bevacizumab</a>.</p><h4>References</h4><ol><li><p>Caulet M et al. (2016). Bevacizumab Pharmacokinetics Influence Overall and Progression-Free Survival in Metastatic Colorectal Cancer Patients. <i>Clinical pharmacokinetics 55(11):1381–1394</i>. DOI:<a href=\"https://doi.org/10.1007/s40262-016-0406-3\">10.1007/s40262-016-0406-3</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/27312193\">27312193</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Caulet_2016: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: accepted with caveats</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 6652800, Tolerance = 1e-9, Interval = 1));
end Bevacizumab_Caulet2016_estimate;
