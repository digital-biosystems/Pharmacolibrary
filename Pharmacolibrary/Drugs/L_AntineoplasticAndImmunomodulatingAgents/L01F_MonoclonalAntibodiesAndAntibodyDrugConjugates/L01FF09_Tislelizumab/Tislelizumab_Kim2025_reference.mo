within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01F_MonoclonalAntibodiesAndAntibodyDrugConjugates.L01FF09_Tislelizumab;
model Tislelizumab_Kim2025_reference
  parameter Real Cl_ref = 1.7708333333333335e-09 "Cl [m3/s]";
  parameter Real Vd_ref = 0.00642 "Vd [m3]";
  extends Pharmacolibrary.Pharmacokinetic.Models.PK_1C(
    weight = 70.0,
    F = 1,
    Cl = Cl_ref,
