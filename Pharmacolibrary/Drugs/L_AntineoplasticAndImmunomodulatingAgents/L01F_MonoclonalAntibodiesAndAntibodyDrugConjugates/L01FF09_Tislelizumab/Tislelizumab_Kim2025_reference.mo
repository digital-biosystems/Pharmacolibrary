  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>tislelizumab</td></tr><tr><td>ATC code:</td><td>L01FF09</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Kim TM 2025</td></tr><tr><td>population:</td><td>patients with non-small cell lung cancer</td></tr><tr><td>measured compound:</td><td>tislelizumab</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_tislelizumab/Tislelizumab_Kim2025_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>steady-state volume of distribution</td><td>6.42</td><td>L</td><td><small>V</small></td></tr><tr><td>mean clearance</td><td>0.153</td><td>L/day</td><td><small>CL</small></td></tr></table><h4>About tislelizumab</h4><p>Tislelizumab is a monoclonal antibody that blocks PD-1 and is used to treat several cancers, including esophageal, lung, nasopharyngeal, and stomach cancers. It is an approved medicine, with one product currently authorised in the European Union, though another EU product has been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q28209583\">Wikidata Q28209583</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Tislelizumab\">Tislelizumab</a>.</p><h4>References</h4><ol><li><p>Kim TM (2025). Decoding the EPAR scientific assessment for clinical practice: a tutorial using tislelizumab in NSCLC. <i>Translational and clinical pharmacology 33(3):111–128</i>. DOI:<a href=\"https://doi.org/10.12793/tcp.2025.33.e17\">10.12793/tcp.2025.33.e17</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/41098176\">41098176</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Kim_2025: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 12700800, Tolerance = 1e-9, Interval = 1));
end Tislelizumab_Kim2025_reference;
