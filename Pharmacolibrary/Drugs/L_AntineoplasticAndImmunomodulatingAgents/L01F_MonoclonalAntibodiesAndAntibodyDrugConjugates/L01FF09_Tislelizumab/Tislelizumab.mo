within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01F_MonoclonalAntibodiesAndAntibodyDrugConjugates.L01FF09_Tislelizumab;
model Tislelizumab "Tislelizumab — default model: Tislelizumab_Kim2025_reference"
  extends Tislelizumab_Kim2025_reference;
  annotation (Documentation(info = "<html><body><p>The default model of tislelizumab: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01F_MonoclonalAntibodiesAndAntibodyDrugConjugates.L01FF09_Tislelizumab.Tislelizumab_Kim2025_reference\">Tislelizumab_Kim2025_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of tislelizumab in this package:</p><ul><li><code>Tislelizumab_Kim2025_reference</code></li></ul><h4>About tislelizumab</h4><p>Tislelizumab is a monoclonal antibody that blocks PD-1 and is used to treat several cancers, including esophageal, lung, nasopharyngeal, and stomach cancers. It is an approved medicine, with one product currently authorised in the European Union, though another EU product has been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q28209583\">Wikidata Q28209583</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Tislelizumab\">Tislelizumab</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 12700800, Tolerance = 1e-9, Interval = 1));
end Tislelizumab;
