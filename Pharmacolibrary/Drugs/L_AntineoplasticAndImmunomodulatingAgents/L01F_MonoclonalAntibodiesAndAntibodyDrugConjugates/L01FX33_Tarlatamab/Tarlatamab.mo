model Tarlatamab "Tarlatamab — default model: Tarlatamab_Kong2025_reference"
  extends Tarlatamab_Kong2025_reference;
  annotation (Documentation(info = "<html><body><p>The default model of tarlatamab: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01F_MonoclonalAntibodiesAndAntibodyDrugConjugates.L01FX33_Tarlatamab.Tarlatamab_Kong2025_reference\">Tarlatamab_Kong2025_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of tarlatamab in this package:</p><ul><li><code>Tarlatamab_Kong2025_reference</code></li></ul><h4>About tarlatamab</h4><p>Tarlatamab is a bispecific monoclonal antibody used to treat small cell lung cancer. It is an approved anticancer medicine and is authorised in the European Union, with further uses still under investigation.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Tarlatamab\">Tarlatamab</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 4838400, Tolerance = 1e-9, Interval = 1));
end Tarlatamab;
