within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01F_MonoclonalAntibodiesAndAntibodyDrugConjugates.L01FF07_Dostarlimab;
model Dostarlimab "Dostarlimab — default model: Dostarlimab_Melhem2022_mean"
  extends Dostarlimab_Melhem2022_mean;
  annotation (Documentation(info = "<html><body><p>The default model of dostarlimab: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01F_MonoclonalAntibodiesAndAntibodyDrugConjugates.L01FF07_Dostarlimab.Dostarlimab_Melhem2022_mean\">Dostarlimab_Melhem2022_mean</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of dostarlimab in this package:</p><ul><li><code>Dostarlimab_Melhem2022_mean</code></li></ul><h4>About dostarlimab</h4><p>Dostarlimab is a monoclonal antibody drug used to treat endometrial cancer. It is an approved PD-1 inhibitor and is authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q85757472\">Wikidata Q85757472</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Dostarlimab\">Dostarlimab</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 9072000, Tolerance = 1e-9, Interval = 1));
end Dostarlimab;
