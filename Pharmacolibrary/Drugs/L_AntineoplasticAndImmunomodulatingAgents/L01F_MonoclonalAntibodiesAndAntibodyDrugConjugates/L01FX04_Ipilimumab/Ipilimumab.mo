within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01F_MonoclonalAntibodiesAndAntibodyDrugConjugates.L01FX04_Ipilimumab;
model Ipilimumab "Ipilimumab — default model: Ipilimumab_Hu2024_reference"
  extends Ipilimumab_Hu2024_reference;
  annotation (Documentation(info = "<html><body><p>The default model of ipilimumab: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01F_MonoclonalAntibodiesAndAntibodyDrugConjugates.L01FX04_Ipilimumab.Ipilimumab_Hu2024_reference\">Ipilimumab_Hu2024_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of ipilimumab in this package:</p><ul><li><code>Ipilimumab_Hu2024_reference</code></li></ul><h4>About ipilimumab</h4><p>Ipilimumab is a monoclonal antibody used to treat several cancers, including melanoma, renal cell carcinoma, non-small-cell lung cancer, mesothelioma, and colorectal cancer. It is approved and authorised in the European Union, where it is used in the treatment of these cancers.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2459042\">Wikidata Q2459042</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Ipilimumab\">Ipilimumab</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 15552000, Tolerance = 1e-9, Interval = 1));
end Ipilimumab;
