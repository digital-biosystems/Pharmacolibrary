within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01F_MonoclonalAntibodiesAndAntibodyDrugConjugates.L01FX04_Ipilimumab;
model Ipilimumab_Hu2024_reference
  parameter Real Cl_ref = 3.75e-09 "Cl [m3/s]";
  parameter Real cov_sex_0 = 0 "sex covariate";
  parameter Real cov_sex_1 = 0 "sex covariate";
  parameter Real cov_egfr = 1.0 "egfr covariate (reference 1.0)";
  parameter Real Vd_ref = 0.00401 "Vd [m3]";
  extends Pharmacolibrary.Pharmacokinetic.Models.PK_2C(
    weight = 70.0,
    F = 1,
    Cl = Cl_ref*(1 + (-0.0998)*cov_sex_0)*(1 + (0.0195)*cov_sex_1)*(cov_egfr/1.0)^(0.0982),
    Vd = Vd_ref,
    adminDuration = 600,
    adminCount = 1,
    adminMass = 7e-06,
    k12 = 2.486838459407038e-06,
    k21 = 3.600080224628961e-06
  );

  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>ipilimumab</td></tr><tr><td>ATC code:</td><td>L01FX04</td></tr><tr><td>model:</td><td>two compartments, IV dosing <small>(PK_2C)</small></td></tr><tr><td>source:</td><td>Hu Z et al. 2024</td></tr><tr><td>population:</td><td>pediatric and adult oncology patients</td></tr><tr><td>measured compound:</td><td>ipilimumab</td></tr><tr><td>review:</td><td>accepted with caveats</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_ipilimumab/Ipilimumab_Hu2024_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>CL REF (mL/h)</td><td>13.5</td><td>mL/h</td><td><small>CL</small></td></tr><tr><td>VC REF (L)</td><td>4.01</td><td>L</td><td><small>V1</small></td></tr><tr><td>Q REF (mL/h)</td><td>35.9</td><td>mL/h</td><td><small>Q</small></td></tr><tr><td>VP REF (L)</td><td>2.77</td><td>L</td><td><small>V2</small></td></tr><tr><td>cl_sex</td><td>-0.0998</td><td></td><td><small>equation variable</small></td></tr><tr><td>vc_sex</td><td>0.0195</td><td></td><td><small>equation variable</small></td></tr><tr><td>T50 (h)</td><td>2670</td><td>h</td><td><small>t1/2z</small></td></tr><tr><td>theta_cl_egfr_power</td><td>0.0982</td><td></td><td><small>equation variable</small></td></tr></table><h4>About ipilimumab</h4><p>Ipilimumab is a monoclonal antibody used to treat several cancers, including melanoma, renal cell carcinoma, non-small-cell lung cancer, mesothelioma, and colorectal cancer. It is approved and authorised in the European Union, where it is used in the treatment of these cancers.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2459042\">Wikidata Q2459042</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Ipilimumab\">Ipilimumab</a>.</p><h4>References</h4><ol><li><p>Hu Z et al. (2024). Nivolumab and ipilimumab population pharmacokinetics in support of pediatric dose recommendations-Going beyond the body-size effect. <i>CPT: pharmacometrics &amp; systems pharmacology 13(3):476–493</i>. DOI:<a href=\"https://doi.org/10.1002/psp4.13098\">10.1002/psp4.13098</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/38115545\">38115545</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Hu_2024: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: accepted with caveats</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 15552000, Tolerance = 1e-9, Interval = 1));
end Ipilimumab_Hu2024_reference;
