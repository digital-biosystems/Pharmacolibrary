within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L02B_HormoneAntagonistsAndRelatedAgents.L02BB04_Enzalutamide;
model Enzalutamide "Enzalutamide — default model: Enzalutamide_Hadigol2026_reference"
  extends Enzalutamide_Hadigol2026_reference;
  annotation (Documentation(info = "<html><body><p>The default model of enzalutamide: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L02B_HormoneAntagonistsAndRelatedAgents.L02BB04_Enzalutamide.Enzalutamide_Hadigol2026_reference\">Enzalutamide_Hadigol2026_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of enzalutamide in this package:</p><ul><li><code>Enzalutamide_Hadigol2026_reference</code></li></ul><h4>About enzalutamide</h4><p>Enzalutamide is an anti-androgen medicine used to treat prostate cancer. It is an approved drug and is authorised in the European Union for prostate tumours.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1996756\">Wikidata Q1996756</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Enzalutamide\">Enzalutamide</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 777600, Tolerance = 1e-9, Interval = 1));
end Enzalutamide;
