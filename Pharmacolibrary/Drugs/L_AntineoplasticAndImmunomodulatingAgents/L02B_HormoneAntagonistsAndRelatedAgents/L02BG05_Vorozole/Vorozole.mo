within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L02B_HormoneAntagonistsAndRelatedAgents.L02BG05_Vorozole;
model Vorozole "Vorozole — default model: Vorozole_Piotrovsky1998_reference"
  extends Vorozole_Piotrovsky1998_reference;
  annotation (Documentation(info = "<html><body><p>The default model of vorozole: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L02B_HormoneAntagonistsAndRelatedAgents.L02BG05_Vorozole.Vorozole_Piotrovsky1998_reference\">Vorozole_Piotrovsky1998_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of vorozole in this package:</p><ul><li><code>Vorozole_Piotrovsky1998_reference</code></li></ul><h4>About vorozole</h4><p>Vorozole is an aromatase inhibitor studied as an anticancer (antineoplastic) agent. It remains experimental and does not appear to be an approved medicine on the market.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7941876\">Wikidata Q7941876</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Vorozole\">Vorozole</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Vorozole;
