  );

  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>cisplatin</td></tr><tr><td>ATC code:</td><td>L01XA01</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Morita-Ogawa T et al. 2020</td></tr><tr><td>population:</td><td>cancer patients with moderate renal dysfunction</td></tr><tr><td>measured compound:</td><td>unchanged cisplatin</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_cisplatin/Cisplatin_MoritaOgawa2020_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>CLtot</td><td>19.1</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>Vd</td><td>13.8</td><td>L</td><td><small>V</small></td></tr></table><h4>About cisplatin</h4><p>Cisplatin is a platinum-based anticancer drug used to treat many cancers, including testicular, ovarian, bladder, lung, stomach, and head and neck cancers. It is an approved medicine and appears on the WHO list of essential medicines, so it is widely used in cancer care worldwide.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q412415\">Wikidata Q412415</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Cisplatin\">Cisplatin</a>.</p><h4>References</h4><ol><li><p>Morita-Ogawa T et al. (2020). Population pharmacokinetics and renal toxicity of cisplatin in cancer patients with renal dysfunction. <i>Cancer chemotherapy and pharmacology 86(4):559–566</i>. DOI:<a href=\"https://doi.org/10.1007/s00280-020-04147-4\">10.1007/s00280-020-04147-4</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/32949266\">32949266</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Morita-Ogawa_2020: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
