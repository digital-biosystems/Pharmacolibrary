within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01X_OtherAntineoplasticAgents.L01XX02_Asparaginase;
model Asparaginase "Asparaginase — default model: Asparaginase_Borghorst2012_reference"
  extends Asparaginase_Borghorst2012_reference;
  annotation (Documentation(info = "<html><body><p>The default model of asparaginase: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01X_OtherAntineoplasticAgents.L01XX02_Asparaginase.Asparaginase_Borghorst2012_reference\">Asparaginase_Borghorst2012_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of asparaginase in this package:</p><ul><li><code>Asparaginase_Borghorst2012_reference</code></li><li><code>Asparaginase_Hoeben2026_PD_tv</code></li></ul><h4>About asparaginase</h4><p>Asparaginase is an enzyme medication used as an anticancer drug to treat lymphoma and lymphoid leukemia. It is an approved medicine, included on the WHO list of essential medicines, and is authorised in the European Union for precursor cell lymphoblastic leukemia-lymphoma.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q105296036\">Wikidata Q105296036</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Asparaginase\">Asparaginase</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 432000, Tolerance = 1e-9, Interval = 1));
end Asparaginase;
