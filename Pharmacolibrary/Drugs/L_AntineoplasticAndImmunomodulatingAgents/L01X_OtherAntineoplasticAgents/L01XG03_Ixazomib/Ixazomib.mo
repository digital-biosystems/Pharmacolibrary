within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01X_OtherAntineoplasticAgents.L01XG03_Ixazomib;
model Ixazomib "Ixazomib — default model: Ixazomib_Gupta2017_reference"
  extends Ixazomib_Gupta2017_reference;
  annotation (Documentation(info = "<html><body><p>The default model of ixazomib: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01X_OtherAntineoplasticAgents.L01XG03_Ixazomib.Ixazomib_Gupta2017_reference\">Ixazomib_Gupta2017_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of ixazomib in this package:</p><ul><li><code>Ixazomib_Gupta2017_reference</code></li><li><code>Ixazomib_Srimani2022_PD_platelet_count</code></li></ul><h4>About ixazomib</h4><p>Ixazomib is a proteasome inhibitor used to treat multiple myeloma and amyloidosis. It is an approved anticancer medicine authorised in the European Union for multiple myeloma.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q20948663\">Wikidata Q20948663</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Ixazomib\">Ixazomib</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Ixazomib;
