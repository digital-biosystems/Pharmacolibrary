  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>ixazomib</td></tr><tr><td>ATC code:</td><td>L01XG03</td></tr><tr><td>model:</td><td>two compartments, oral dosing <small>(PK_2C_enteral)</small></td></tr><tr><td>source:</td><td>Gupta N et al. 2017</td></tr><tr><td>population:</td><td>adults with multiple myeloma</td></tr><tr><td>measured compound:</td><td>ixazomib</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_ixazomib/Ixazomib_Gupta2017_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>Absorption rate constant (log K a)</td><td>-1.09</td><td>1/h</td><td><small>kabs</small></td></tr><tr><td>Systemic clearance (log CL)</td><td>0.62</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>Central volume of distribution (log V 2)</td><td>2.62</td><td>L</td><td><small>V1</small></td></tr><tr><td>Absolute bioavailability (log F)</td><td>-0.55</td><td>log F</td><td><small>Fab</small></td></tr><tr><td>First inter-compartmental clearance (log Q3)</td><td>1.65</td><td>L/h</td><td><small>Q3</small></td></tr><tr><td>Volume of the first peripheral compartment (log V 3)</td><td>5.73</td><td>L</td><td><small>V2</small></td></tr><tr><td>Second inter-compartmental clearance (log Q4)</td><td>3.26</td><td>L/h</td><td><small>Q</small></td></tr><tr><td>Volume of the second peripheral compartment (log V 4)</td><td>5.32</td><td>L</td><td><small>V3</small></td></tr><tr><td>Absorption lag time (log T LAG)</td><td>-1.52</td><td>h</td><td><small>tlag</small></td></tr></table><h4>About ixazomib</h4><p>Ixazomib is a proteasome inhibitor used to treat multiple myeloma and amyloidosis. It is an approved anticancer medicine authorised in the European Union for multiple myeloma.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q20948663\">Wikidata Q20948663</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Ixazomib\">Ixazomib</a>.</p><h4>References</h4><ol><li><p>Gupta N et al. (2017). Population Pharmacokinetic Analysis of Ixazomib, an Oral Proteasome Inhibitor, Including Data from the Phase III TOURMALINE-MM1 Study to Inform Labelling. <i>Clinical pharmacokinetics 56(11):1355–1368</i>. DOI:<a href=\"https://doi.org/10.1007/s40262-017-0526-4\">10.1007/s40262-017-0526-4</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/28290121\">28290121</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Gupta_2017: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Ixazomib_Gupta2017_reference;
