within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01X_OtherAntineoplasticAgents.L01XX52_Venetoclax;
model Venetoclax "Venetoclax — default model: Venetoclax_Liu2026_reference"
  extends Venetoclax_Liu2026_reference;
  annotation (Documentation(info = "<html><body><p>The default model of venetoclax: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01X_OtherAntineoplasticAgents.L01XX52_Venetoclax.Venetoclax_Liu2026_reference\">Venetoclax_Liu2026_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of venetoclax in this package:</p><ul><li><code>Venetoclax_Liu2026_reference</code></li></ul><h4>About venetoclax</h4><p>Venetoclax is an anticancer medicine used to treat blood cancers such as chronic lymphocytic leukemia, acute myeloid leukemia, and certain B-cell lymphomas. It is an approved medicine and is authorised in the European Union for chronic lymphocytic leukemia.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q23671272\">Wikidata Q23671272</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Venetoclax\">Venetoclax</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 432000, Tolerance = 1e-9, Interval = 1));
end Venetoclax;
