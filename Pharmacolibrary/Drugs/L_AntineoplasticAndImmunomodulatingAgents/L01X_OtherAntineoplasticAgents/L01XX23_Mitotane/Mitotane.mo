within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01X_OtherAntineoplasticAgents.L01XX23_Mitotane;
model Mitotane "Mitotane — default model: Mitotane_Cazaubon2019_reference"
  extends Mitotane_Cazaubon2019_reference;
  annotation (Documentation(info = "<html><body><p>The default model of mitotane: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01X_OtherAntineoplasticAgents.L01XX23_Mitotane.Mitotane_Cazaubon2019_reference\">Mitotane_Cazaubon2019_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of mitotane in this package:</p><ul><li><code>Mitotane_Cazaubon2019_reference</code></li></ul><h4>About mitotane</h4><p>Mitotane is an antineoplastic drug used to treat adrenal cortex cancer and Cushing's syndrome. It is authorised in the European Union for adrenal cortex tumours and remains in clinical use, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q417465\">Wikidata Q417465</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Mitotane\">Mitotane</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 15552000, Tolerance = 1e-9, Interval = 1));
end Mitotane;
