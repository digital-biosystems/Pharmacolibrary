  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>mitotane</td></tr><tr><td>ATC code:</td><td>L01XX23</td></tr><tr><td>model:</td><td>one compartment, oral dosing <small>(PK_1C_enteral)</small></td></tr><tr><td>source:</td><td>Cazaubon Y et al. 2019</td></tr><tr><td>population:</td><td>adults with adrenocortical carcinoma</td></tr><tr><td>measured compound:</td><td>mitotane</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_mitotane/Mitotane_Cazaubon2019_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>Ka (day−1)</td><td>24</td><td>day−1</td><td><small>kabs</small></td></tr><tr><td>F (%)</td><td>35</td><td></td><td><small>Fab</small></td></tr><tr><td>V (L)</td><td>8900</td><td>L</td><td><small>V</small></td></tr><tr><td>Cl (L·day−1)</td><td>70</td><td>L·day−1</td><td><small>CL</small></td></tr><tr><td>βlcat2 *</td><td>1.12</td><td></td><td><small>equation variable</small></td></tr></table><h4>About mitotane</h4><p>Mitotane is an antineoplastic drug used to treat adrenal cortex cancer and Cushing's syndrome. It is authorised in the European Union for adrenal cortex tumours and remains in clinical use, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q417465\">Wikidata Q417465</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Mitotane\">Mitotane</a>.</p><h4>References</h4><ol><li><p>Cazaubon Y et al. (2019). Population Pharmacokinetics Modelling and Simulation of Mitotane in Patients with Adrenocortical Carcinoma: An Individualized Dose Regimen to Target All Patients at Three Months?. <i>Pharmaceutics 11(11)</i>. DOI:<a href=\"https://doi.org/10.3390/pharmaceutics11110566\">10.3390/pharmaceutics11110566</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/31683663\">31683663</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Cazaubon_2019: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
