within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01X_OtherAntineoplasticAgents.L01XX44_Aflibercept;
model Aflibercept_Thai2013_reference
  parameter Real Cl_ref = 1.0185185185185186e-08 "Cl [m3/s]";
  parameter Real Vd_ref = 0.004 "Vd [m3]";
  extends Pharmacolibrary.Pharmacokinetic.Models.PK_1C(
    weight = 70.0,
    F = 1,
    Cl = Cl_ref,
    Vd = Vd_ref,
    adminDuration = 600,
    adminCount = 1,
    adminMass = 2e-05
  );

  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>aflibercept</td></tr><tr><td>ATC code:</td><td>L01XX44</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Thai HT et al. 2013</td></tr><tr><td>population:</td><td>patients with advanced solid tumors</td></tr><tr><td>measured compound:</td><td>aflibercept</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_aflibercept/Aflibercept_Thai2013_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>CL(f)</td><td>0.88</td><td>L/day</td><td><small>CL</small></td></tr><tr><td>V(p)</td><td>4</td><td>L</td><td><small>V</small></td></tr></table><h4>About aflibercept</h4><p>Aflibercept is used to treat several eye conditions involving abnormal blood vessel growth or swelling in the retina, such as wet macular degeneration, diabetic retinopathy, macular edema and retinal vein occlusion, and is also used for colorectal cancer. It is an approved medicine, authorised in the European Union for multiple eye and cancer indications, and is widely used in ophthalmology.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4689286\">Wikidata Q4689286</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Aflibercept\">Aflibercept</a>.</p><h4>References</h4><ol><li><p>Thai HT et al. (2013). Population pharmacokinetic analysis of free and bound aflibercept in patients with advanced solid tumors. <i>Cancer chemotherapy and pharmacology 72(1):167–180</i>. DOI:<a href=\"https://doi.org/10.1007/s00280-013-2182-1\">10.1007/s00280-013-2182-1</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/23673444\">23673444</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Thai_2013: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 1382400, Tolerance = 1e-9, Interval = 1));
end Aflibercept_Thai2013_reference;
