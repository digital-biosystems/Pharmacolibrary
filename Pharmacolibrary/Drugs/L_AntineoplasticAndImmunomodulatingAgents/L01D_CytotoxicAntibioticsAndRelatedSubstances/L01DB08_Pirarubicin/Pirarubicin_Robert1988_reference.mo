  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>pirarubicin</td></tr><tr><td>ATC code:</td><td>L01DB08</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Robert J et al. 1988</td></tr><tr><td>population:</td><td>patients with advanced cancer</td></tr><tr><td>measured compound:</td><td>pirarubicin</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_pirarubicin/Pirarubicin_Robert1988_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>Total plasma clearance of the drug</td><td>90</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>total volume of distribution</td><td>1380</td><td>L</td><td><small>V</small></td></tr></table><h4>About pirarubicin</h4><p>Pirarubicin is an anthracycline cytotoxic antibiotic investigated as an anticancer drug. It is not an approved medicine and remains investigational, with no authorisation in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q76416926\">Wikidata Q76416926</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Pirarubicin\">Pirarubicin</a>.</p><h4>References</h4><ol><li><p>Robert J et al. (1988). Pharmacokinetics and metabolism of pirarubicin in advanced cancer patients. <i>European journal of cancer &amp; clinical oncology 24(8):1289–1294</i>. DOI:<a href=\"https://doi.org/10.1016/0277-5379(88)90217-9\">10.1016/0277-5379(88)90217-9</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/3181250\">3181250</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Robert_1988: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 259200, Tolerance = 1e-9, Interval = 1));
end Pirarubicin_Robert1988_reference;
