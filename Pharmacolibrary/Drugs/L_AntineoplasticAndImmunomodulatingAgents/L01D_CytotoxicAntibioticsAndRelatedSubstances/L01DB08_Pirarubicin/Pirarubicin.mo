within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01D_CytotoxicAntibioticsAndRelatedSubstances.L01DB08_Pirarubicin;
model Pirarubicin "Pirarubicin — default model: Pirarubicin_Robert1988_reference"
  extends Pirarubicin_Robert1988_reference;
  annotation (Documentation(info = "<html><body><p>The default model of pirarubicin: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01D_CytotoxicAntibioticsAndRelatedSubstances.L01DB08_Pirarubicin.Pirarubicin_Robert1988_reference\">Pirarubicin_Robert1988_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of pirarubicin in this package:</p><ul><li><code>Pirarubicin_Robert1988_reference</code></li></ul><h4>About pirarubicin</h4><p>Pirarubicin is an anthracycline cytotoxic antibiotic investigated as an anticancer drug. It is not an approved medicine and remains investigational, with no authorisation in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q76416926\">Wikidata Q76416926</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Pirarubicin\">Pirarubicin</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 259200, Tolerance = 1e-9, Interval = 1));
end Pirarubicin;
