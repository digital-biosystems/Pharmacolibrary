  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>mitoxantrone</td></tr><tr><td>ATC code:</td><td>L01DB07</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Launay MC et al. 1989</td></tr><tr><td>population:</td><td>patients with breast cancer or acute nonlymphocytic leukemia</td></tr><tr><td>measured compound:</td><td>mitoxantrone</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_mitoxantrone/Mitoxantrone_Launay1989_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>clearance</td><td>23.4</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>terminal half-life</td><td>46.87</td><td>h</td><td><small>t1/2z</small></td></tr><tr><td>total volume of distribution</td><td>385.49</td><td>L</td><td><small>V</small></td></tr></table><h4>About mitoxantrone</h4><p>Mitoxantrone is a cytotoxic drug used to treat several cancers, including breast cancer, prostate cancer, lymphoma and acute myeloid leukemia, and is also used in multiple sclerosis. It is an approved medicine, but carries a boxed warning, so its use is restricted to specialist care.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q239426\">Wikidata Q239426</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Mitoxantrone\">Mitoxantrone</a>.</p><h4>References</h4><ol><li><p>Launay MC et al. (1989). Population pharmacokinetics of mitoxantrone performed by a NONMEM method. <i>Journal of pharmaceutical sciences 78(10):877–880</i>. DOI:<a href=\"https://doi.org/10.1002/jps.2600781020\">10.1002/jps.2600781020</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/2600798\">2600798</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Launay_1989: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 864000, Tolerance = 1e-9, Interval = 1));
