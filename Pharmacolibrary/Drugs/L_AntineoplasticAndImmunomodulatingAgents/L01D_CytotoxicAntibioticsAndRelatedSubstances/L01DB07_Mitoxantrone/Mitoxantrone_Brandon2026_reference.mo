within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L01D_CytotoxicAntibioticsAndRelatedSubstances.L01DB07_Mitoxantrone;
model Mitoxantrone_Brandon2026_reference
  parameter Real Cl_ref = 1.0861111111111112e-05 "Cl [m3/s]";
  parameter Real cov_wt_0 = 0 "wt covariate";
  parameter Real cov_wt_1 = 0 "wt covariate";
  parameter Real Vd_ref = 0.0232 "Vd [m3]";
  extends Pharmacolibrary.Pharmacokinetic.Models.PK_2C(
    weight = 70.0,
    F = 1,
    Cl = Cl_ref*(1 + (1.0)*cov_wt_0)*(1 + (0.75)*cov_wt_1),
    Vd = Vd_ref,
    adminDuration = 600,
    adminCount = 1,
    MM = Pharmacolibrary.Drugs.Substances.Mitoxantrone.M,
    adminMass = 1e-05,
    k12 = 0.0003304597701149426,
    k21 = 8.925106713232442e-05
  );

  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>mitoxantrone</td></tr><tr><td>ATC code:</td><td>L01DB07</td></tr><tr><td>model:</td><td>two compartments, IV dosing <small>(PK_2C)</small></td></tr><tr><td>source:</td><td>Brandon AM et al. 2026</td></tr><tr><td>population:</td><td>children with acute myeloid leukaemia</td></tr><tr><td>measured compound:</td><td>mitoxantrone</td></tr><tr><td>review:</td><td>accepted with caveats</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_mitoxantrone/Mitoxantrone_Brandon2026_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>CL (L/h)</td><td>39.1</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>V1 (L)</td><td>23.2</td><td>L</td><td><small>V1</small></td></tr><tr><td>Q (L/h)</td><td>27.6</td><td>L/h</td><td><small>Q</small></td></tr><tr><td>V2 (L)</td><td>85.9</td><td>L</td><td><small>V2</small></td></tr><tr><td>wt_effect_on_v1_v2</td><td>1</td><td></td><td><small>equation variable</small></td></tr><tr><td>theta_cl_wt</td><td>0.75</td><td></td><td><small>equation variable</small></td></tr></table><h4>About mitoxantrone</h4><p>Mitoxantrone is a cytotoxic drug used to treat several cancers, including breast cancer, prostate cancer, lymphoma and acute myeloid leukemia, and is also used in multiple sclerosis. It is an approved medicine, but carries a boxed warning, so its use is restricted to specialist care.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q239426\">Wikidata Q239426</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Mitoxantrone\">Mitoxantrone</a>.</p><h4>References</h4><ol><li><p>Brandon AM et al. (2026). Population pharmacokinetics and dose-response relationships of mitoxantrone in children with acute myeloid leukaemia. <i>British journal of clinical pharmacology 92(6):1760–1770</i>. DOI:<a href=\"https://doi.org/10.1002/bcp.70436\">10.1002/bcp.70436</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/41536035\">41536035</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Brandon_2026: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: accepted with caveats</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Mitoxantrone_Brandon2026_reference;
