within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L03A_Immunostimulants.L03AA13_Pegfilgrastim;
model Pegfilgrastim_Brekkan2018_PD_anc
  "indirect_response_iii exposure-response sweep — Brekkan_2018 :: ANC (absolute neutrophil count)"
  extends Pharmacolibrary.Interfaces.PartialExposureResponseSweep(
    E0 = 2.7,      // [10 9 cells/L]
    Emax = 102,  // type III effect term
    EC50 = 9.24e-06,  // [kg/m3; ng/mL × 1e-06]
    gamma = 1,
    exposure_per_s = 1e-06);   // 1 ng/mL per second
equation
  response = E0*(1 + Emax*frac);   // steady state, indirect response type III
  // defaulted: gamma
  annotation(experiment(StartTime = 0, StopTime = 93, Interval = 0.186),
    Documentation(info = "<html><body><h4>Pegfilgrastim_Brekkan2018_PD_anc</h4><p>The steady-state exposure-response curve of Brekkan A et al., <i>The AAPS journal 20(5):91</i> 2018 (<a href=\"https://doi.org/10.1208/s12248-018-0249-y\">doi:10.1208/s12248-018-0249-y</a>) — absolute neutrophil count [10^9 cells/L] against pegfilgrastim ng/mL — obtained by sweeping the driver instead of simulating a dose. Model family: indirect_response_iii.</p><h4>The parameters, in the paper's terms</h4><pre>  E0    =        2.7 10 9 cells/L drug-free response (baseline) (Base neutrophil count, Q324)
  Emax  =        102          maximal effect term (Maximum effect of PG on ANC maturation rate, Q320)
  EC50  =       9.24 ng/mL    exposure at half of the maximal effect term (Concentration eliciting half of the maximum effect, Q321)
  gamma = (library default) Hill coefficient</pre><p>The algebra is <code>response = E0*(1 + Emax*frac)</code>; this model only supplies the numbers. The x axis is one ng/mL of pegfilgrastim per second of simulated time (exposure is in kg/m3): there is no state, no dose and no kinetics — plot <code>response</code> against <code>exposure</code> (or <code>time</code>).</p><h4>What it reproduces</h4><pre>  exposure = 0         response 2.7   (drug-free)
  exposure = EC50 (9.24 ng/mL)  response 140.4
  exposure -> infinity  response 278.1</pre></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Brekkan_2018: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: accepted with caveats</li></ul></body></html>"));
end Pegfilgrastim_Brekkan2018_PD_anc;
