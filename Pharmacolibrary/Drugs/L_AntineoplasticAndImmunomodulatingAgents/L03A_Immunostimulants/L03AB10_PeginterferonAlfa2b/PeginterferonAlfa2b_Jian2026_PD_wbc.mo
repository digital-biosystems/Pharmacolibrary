within Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L03A_Immunostimulants.L03AB10_PeginterferonAlfa2b;
model PeginterferonAlfa2b_Jian2026_PD_wbc
  "indirect_response_i exposure-response sweep — Jian_2026 :: WBC (White blood cell)"
  extends Pharmacolibrary.Interfaces.PartialExposureResponseSweep(
    E0 = 5.25,      // [×10 9 /L]
    Emax = 0.0952,  // type I effect term
    EC50 = 1.94e-06,  // [kg/m3; pg/mL × 1e-09]
    gamma = 1,
    exposure_per_s = 1e-09);   // 1 pg/mL per second
equation
  response = E0*(1 - Emax*frac);   // steady state, indirect response type I
  // defaulted: gamma
  annotation(experiment(StartTime = 0, StopTime = 20000, Interval = 40),
    Documentation(info = "<html><body><h4>PeginterferonAlfa2b_Jian2026_PD_wbc</h4><p>The steady-state exposure-response curve of Jian W et al., <i>Clinical pharmacology and therapeutics 119(1):219–227</i> 2026 (<a href=\"https://doi.org/10.1002/cpt.70079\">doi:10.1002/cpt.70079</a>) — White blood cell [×10 9 /L] against peginterferon_alfa_2b pg/mL — obtained by sweeping the driver instead of simulating a dose. Model family: indirect_response_i.</p><h4>The parameters, in the paper's terms</h4><pre>  E0    =       5.25 ×10 9 /L drug-free response (baseline) (WBC 0, Q324)
  Emax  =     0.0952          maximal effect term (E max, Q323)
  EC50  =       1940 pg/mL    exposure at half of the maximal effect term (EC 50, Q322)
  gamma = (library default) Hill coefficient</pre><p>The algebra is <code>response = E0*(1 - Emax*frac)</code>; this model only supplies the numbers. The x axis is one pg/mL of peginterferon_alfa_2b per second of simulated time (exposure is in kg/m3): there is no state, no dose and no kinetics — plot <code>response</code> against <code>exposure</code> (or <code>time</code>).</p><h4>What it reproduces</h4><pre>  exposure = 0         response 5.25   (drug-free)
  exposure = EC50 (1940 pg/mL)  response 5
  exposure -> infinity  response 4.75</pre></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Jian_2026: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: accepted with caveats</li></ul></body></html>"));
end PeginterferonAlfa2b_Jian2026_PD_wbc;
