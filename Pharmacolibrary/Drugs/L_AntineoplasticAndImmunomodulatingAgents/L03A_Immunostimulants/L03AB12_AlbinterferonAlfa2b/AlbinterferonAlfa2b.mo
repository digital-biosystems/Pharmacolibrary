  annotation (Documentation(info = "<html><body><p>The default model of albinterferon alfa-2b: <a href=\"modelica://Pharmacolibrary.Drugs.L_AntineoplasticAndImmunomodulatingAgents.L03A_Immunostimulants.L03AB12_AlbinterferonAlfa2b.AlbinterferonAlfa2b_Riggs2012_reference\">AlbinterferonAlfa2b_Riggs2012_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of albinterferon alfa-2b in this package:</p><ul><li><code>AlbinterferonAlfa2b_Riggs2012_reference</code></li></ul><h4>About albinterferon alfa-2b</h4><p>It was never approved and remains an investigational compound, so it is not in routine clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4712444\">Wikidata Q4712444</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.AlbinterferonAlfa2b\">AlbinterferonAlfa2b</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 4838400, Tolerance = 1e-9, Interval = 1));
