  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>pipecuronium_bromide</td></tr><tr><td>ATC code:</td><td>M03AC06</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Yajima C et al. 1990</td></tr><tr><td>population:</td><td>male patients</td></tr><tr><td>measured compound:</td><td>pipecuronium_bromide</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_pipecuronium_bromide/PipecuroniumBromide_Yajima1990_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>distribution half-life; T1/2 alpha</td><td>3.9</td><td>min</td><td><small>t1/2α</small></td></tr><tr><td>elimination half-life; T1/2 beta</td><td>102</td><td>min</td><td><small>t1/2β</small></td></tr><tr><td>volume of the central compartment; V1</td><td>95</td><td>ml.kg-1</td><td><small>V</small></td></tr><tr><td>volume of distribution at steady state; Vdss</td><td>264</td><td>ml.kg-1</td><td><small>Vss</small></td></tr><tr><td>clearance; Cl</td><td>1.8</td><td>ml.min-1.kg-1</td><td><small>CL</small></td></tr></table><h4>About pipecuronium_bromide</h4><p>Pipecuronium bromide is a non-depolarising neuromuscular blocking agent, a muscle relaxant used to relax muscles during surgery. It is no longer in use, having been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q20817188\">Wikidata Q20817188</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Pipecuronium\">Pipecuronium</a>.</p><h4>References</h4><ol><li><p>Yajima C et al. (1990). [Comparative pharmacokinetics of pipecuronium bromide, pancuronium bromide and vecuronium bromide in anesthetized man]. <i>Masui. The Japanese journal of anesthesiology 39(7):882–889</i>. PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/1976829\">1976829</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Yajima_1990: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
