within Pharmacolibrary.Drugs.M_MusculoSkeletalSystem.M03A_MuscleRelaxantsPeripherallyActingAgents.M03AC06_PipecuroniumBromide;
model PipecuroniumBromide "PipecuroniumBromide — default model: PipecuroniumBromide_Yajima1990_reference"
  extends PipecuroniumBromide_Yajima1990_reference;
  annotation (Documentation(info = "<html><body><p>The default model of pipecuronium bromide: <a href=\"modelica://Pharmacolibrary.Drugs.M_MusculoSkeletalSystem.M03A_MuscleRelaxantsPeripherallyActingAgents.M03AC06_PipecuroniumBromide.PipecuroniumBromide_Yajima1990_reference\">PipecuroniumBromide_Yajima1990_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of pipecuronium bromide in this package:</p><ul><li><code>PipecuroniumBromide_Yajima1990_reference</code></li></ul><h4>About pipecuronium bromide</h4><p>Pipecuronium bromide is a non-depolarising neuromuscular blocking agent, a muscle relaxant used to relax muscles during surgery. It is no longer in use, having been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q20817188\">Wikidata Q20817188</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Pipecuronium\">Pipecuronium</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end PipecuroniumBromide;
