  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>rocuronium</td></tr><tr><td>ATC code:</td><td>M03AC09</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Szenohradszky J et al. 1992</td></tr><tr><td>population:</td><td>patients undergoing cadaver renal transplantation and healthy controls</td></tr><tr><td>measured compound:</td><td>rocuronium</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_rocuronium/Rocuronium_Szenohradszky1992_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>Total plasma clearance</td><td>2.89</td><td>ml.kg-1.min-1</td><td><small>CL</small></td></tr><tr><td>volume of the central compartment</td><td>76.9</td><td>ml/kg</td><td><small>V</small></td></tr><tr><td>volume of distribution at steady state</td><td>264</td><td>ml/kg</td><td><small>Vss</small></td></tr><tr><td>elimination half life</td><td>97.2</td><td>min</td><td><small>t1/2z</small></td></tr></table><h4>About rocuronium</h4><p>Rocuronium is a non-depolarising neuromuscular blocking agent used to relax muscles, for example during surgery. It is an approved medicine and is widely used in anaesthesia, mainly in hospital settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q185331\">Wikidata Q185331</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Rocuronium\">Rocuronium</a>.</p><h4>References</h4><ol><li><p>Szenohradszky J et al. (1992). Pharmacokinetics of rocuronium bromide (ORG 9426) in patients with normal renal function or patients undergoing cadaver renal transplantation. <i>Anesthesiology 77(5):899–904</i>. DOI:<a href=\"https://doi.org/10.1097/00000542-199211000-00010\">10.1097/00000542-199211000-00010</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/1443743\">1443743</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Szenohradszky_1992: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
