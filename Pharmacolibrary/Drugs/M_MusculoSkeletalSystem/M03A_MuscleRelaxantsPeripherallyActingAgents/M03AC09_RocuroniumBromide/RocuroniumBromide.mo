within Pharmacolibrary.Drugs.M_MusculoSkeletalSystem.M03A_MuscleRelaxantsPeripherallyActingAgents.M03AC09_RocuroniumBromide;
model RocuroniumBromide "RocuroniumBromide — default model: Rocuronium_Szenohradszky1992_reference"
  extends Rocuronium_Szenohradszky1992_reference;
  annotation (Documentation(info = "<html><body><p>The default model of Rocuronium: <a href=\"modelica://Pharmacolibrary.Drugs.M_MusculoSkeletalSystem.M03A_MuscleRelaxantsPeripherallyActingAgents.M03AC09_RocuroniumBromide.Rocuronium_Szenohradszky1992_reference\">Rocuronium_Szenohradszky1992_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of Rocuronium in this package:</p><ul><li><code>Rocuronium_Szenohradszky1992_reference</code></li></ul><h4>About Rocuronium</h4><p>Rocuronium is a non-depolarising neuromuscular blocking agent used to relax muscles, for example during surgery. It is an approved medicine and is widely used in anaesthesia, mainly in hospital settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q185331\">Wikidata Q185331</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Rocuronium\">Rocuronium</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end RocuroniumBromide;
