within Pharmacolibrary.Drugs.M_MusculoSkeletalSystem.M03A_MuscleRelaxantsPeripherallyActingAgents.M03AC04_Atracurium;
model Atracurium "Atracurium — default model: Atracurium_Fisher1990_reference"
  extends Atracurium_Fisher1990_reference;
  annotation (Documentation(info = "<html><body><p>The default model of atracurium: <a href=\"modelica://Pharmacolibrary.Drugs.M_MusculoSkeletalSystem.M03A_MuscleRelaxantsPeripherallyActingAgents.M03AC04_Atracurium.Atracurium_Fisher1990_reference\">Atracurium_Fisher1990_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of atracurium in this package:</p><ul><li><code>Atracurium_Fisher1990_reference</code></li></ul><h4>About atracurium</h4><p>Atracurium is a muscle relaxant used to relax muscles during surgery and to help with insertion of a breathing tube under anaesthesia. It is widely used in anaesthetic practice and appears on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q165660\">Wikidata Q165660</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Atracurium\">Atracurium</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Atracurium;
