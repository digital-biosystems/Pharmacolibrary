  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>denosumab</td></tr><tr><td>ATC code:</td><td>M05BX04</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Sutjandra L et al. 2011</td></tr><tr><td>population:</td><td>healthy subjects and postmenopausal women with osteopenia or osteoporosis</td></tr><tr><td>measured compound:</td><td>denosumab</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_denosumab/Denosumab_Sutjandra2011_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>subcutaneous bioavailability of denosumab</td><td>64</td><td>%</td><td><small>Fab</small></td></tr><tr><td>k(a)</td><td>0.00883</td><td>h-1</td><td><small>kel</small></td></tr><tr><td>central volume of distribution</td><td>2.49</td><td>L/66 kg</td><td><small>V</small></td></tr><tr><td>linear clearance</td><td>3.06</td><td>mL/h/66 kg</td><td><small>CLnorm</small></td></tr></table><h4>About denosumab</h4><p>Denosumab is a monoclonal antibody used to treat bone diseases, especially postmenopausal osteoporosis and bone loss linked to cancer. It is widely used and authorised in the European Union, with products covering osteoporosis, bone resorption, bone tumours, and giant cell tumour of bone.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q408283\">Wikidata Q408283</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Denosumab\">Denosumab</a>.</p><h4>References</h4><ol><li><p>Sutjandra L et al. (2011). Population pharmacokinetic meta-analysis of denosumab in healthy subjects and postmenopausal women with osteopenia or osteoporosis. <i>Clinical pharmacokinetics 50(12):793–807</i>. DOI:<a href=\"https://doi.org/10.2165/11594240-000000000-00000\">10.2165/11594240-000000000-00000</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/22087866\">22087866</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Sutjandra_2011: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
