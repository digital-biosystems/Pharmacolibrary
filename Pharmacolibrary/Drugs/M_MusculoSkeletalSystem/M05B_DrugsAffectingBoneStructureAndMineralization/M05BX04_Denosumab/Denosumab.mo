within Pharmacolibrary.Drugs.M_MusculoSkeletalSystem.M05B_DrugsAffectingBoneStructureAndMineralization.M05BX04_Denosumab;
model Denosumab "Denosumab — default model: Denosumab_Sutjandra2011_reference"
  extends Denosumab_Sutjandra2011_reference;
  annotation (Documentation(info = "<html><body><p>The default model of denosumab: <a href=\"modelica://Pharmacolibrary.Drugs.M_MusculoSkeletalSystem.M05B_DrugsAffectingBoneStructureAndMineralization.M05BX04_Denosumab.Denosumab_Sutjandra2011_reference\">Denosumab_Sutjandra2011_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of denosumab in this package:</p><ul><li><code>Denosumab_Sutjandra2011_reference</code></li></ul><h4>About denosumab</h4><p>Denosumab is a monoclonal antibody used to treat bone diseases, especially postmenopausal osteoporosis and bone loss linked to cancer. It is widely used and authorised in the European Union, with products covering osteoporosis, bone resorption, bone tumours, and giant cell tumour of bone.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q408283\">Wikidata Q408283</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Denosumab\">Denosumab</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 1468800, Tolerance = 1e-9, Interval = 1));
end Denosumab;
