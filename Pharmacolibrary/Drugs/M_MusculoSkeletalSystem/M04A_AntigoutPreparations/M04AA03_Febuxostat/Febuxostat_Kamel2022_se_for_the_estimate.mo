within Pharmacolibrary.Drugs.M_MusculoSkeletalSystem.M04A_AntigoutPreparations.M04AA03_Febuxostat;
model Febuxostat_Kamel2022_se_for_the_estimate
  parameter Real Cl_ref = 1.6666666666666667e-06 "Cl [m3/s]";
  parameter Real cov_food_0 = 0 "food covariate";
  parameter Real Vd_ref = 0.01 "Vd [m3]";
  extends Pharmacolibrary.Pharmacokinetic.Models.PK_2C_enteral(
    weight = 70.0,
    F = 1,
    Cl = Cl_ref*(1 + (7.5)*cov_food_0),
    Vd = Vd_ref,
    adminDuration = 600,
    adminCount = 1,
    MM = Pharmacolibrary.Drugs.Substances.Febuxostat.M,
    adminMass = 4e-05,
    ka = 0.008138888888888888,
    Tlag = 0.0,
    k12 = 0.00038611111111111116,
    k21 = 0.00032446311858076564
  );

  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>febuxostat</td></tr><tr><td>ATC code:</td><td>M04AA03</td></tr><tr><td>model:</td><td>two compartments, oral dosing <small>(PK_2C_enteral)</small></td></tr><tr><td>source:</td><td>Kamel B et al. 2022</td></tr><tr><td>population:</td><td>healthy subjects and people with gout</td></tr><tr><td>measured compound:</td><td>febuxostat</td></tr><tr><td>review:</td><td>accepted with caveats</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_febuxostat/Febuxostat_Kamel2022_se_for_the_estimate\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>CL/F (ϴ 1)</td><td>6.0</td><td>L/h</td><td><small>CL/F</small></td></tr><tr><td>Vc/F (ϴ 2)</td><td>10.0</td><td>L</td><td><small>V1/F</small></td></tr><tr><td>Q (ϴ 3)</td><td>13.9</td><td>L/h</td><td><small>Q</small></td></tr><tr><td>Vp/F (ϴ 4)</td><td>11.9</td><td>L</td><td><small>V2/F</small></td></tr><tr><td>ka (ϴ 5)</td><td>29.3</td><td>1/h</td><td><small>kabs</small></td></tr><tr><td>covariate_food_on_oral_availability</td><td>7.5</td><td></td><td><small>equation variable</small></td></tr><tr><td>theta_kabs_food</td><td>5.7</td><td></td><td><small>equation variable</small></td></tr></table><h4>About febuxostat</h4><p>Febuxostat is a xanthine oxidase inhibitor used to treat hyperuricemia and gout. It is authorised in the European Union and widely used as an antigout medicine, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q417296\">Wikidata Q417296</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Febuxostat\">Febuxostat</a>.</p><h4>References</h4><ol><li><p>Kamel B et al. (2022). Population pharmacokinetic modelling of febuxostat in healthy subjects and people with gout. <i>British journal of clinical pharmacology 88(12):5359–5368</i>. DOI:<a href=\"https://doi.org/10.1111/bcp.15462\">10.1111/bcp.15462</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/35849446\">35849446</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Kamel_2022: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: accepted with caveats</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Febuxostat_Kamel2022_se_for_the_estimate;
