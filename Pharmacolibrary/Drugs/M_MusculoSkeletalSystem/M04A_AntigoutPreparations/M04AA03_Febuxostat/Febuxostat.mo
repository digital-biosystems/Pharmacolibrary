within Pharmacolibrary.Drugs.M_MusculoSkeletalSystem.M04A_AntigoutPreparations.M04AA03_Febuxostat;
model Febuxostat "Febuxostat — default model: Febuxostat_Kamel2022_se_for_the_estimate"
  extends Febuxostat_Kamel2022_se_for_the_estimate;
  annotation (Documentation(info = "<html><body><p>The default model of febuxostat: <a href=\"modelica://Pharmacolibrary.Drugs.M_MusculoSkeletalSystem.M04A_AntigoutPreparations.M04AA03_Febuxostat.Febuxostat_Kamel2022_se_for_the_estimate\">Febuxostat_Kamel2022_se_for_the_estimate</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of febuxostat in this package:</p><ul><li><code>Febuxostat_Kamel2022_se_for_the_estimate</code></li></ul><h4>About febuxostat</h4><p>Febuxostat is a xanthine oxidase inhibitor used to treat hyperuricemia and gout. It is authorised in the European Union and widely used as an antigout medicine, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q417296\">Wikidata Q417296</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Febuxostat\">Febuxostat</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Febuxostat;
