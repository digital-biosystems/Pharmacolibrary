within Pharmacolibrary.Drugs.M_MusculoSkeletalSystem.M01A_AntiinflammatoryAndAntirheumaticProductsNonStero.M01AC06_Meloxicam;
model Meloxicam "Meloxicam — default model: Meloxicam_Lehr2010_reference"
  extends Meloxicam_Lehr2010_reference;
  annotation (Documentation(info = "<html><body><p>The default model of meloxicam: <a href=\"modelica://Pharmacolibrary.Drugs.M_MusculoSkeletalSystem.M01A_AntiinflammatoryAndAntirheumaticProductsNonStero.M01AC06_Meloxicam.Meloxicam_Lehr2010_reference\">Meloxicam_Lehr2010_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of meloxicam in this package:</p><ul><li><code>Meloxicam_Lehr2010_reference</code></li><li><code>Meloxicam_Giraudel2005_PD_lameness_score</code></li><li><code>Meloxicam_Giraudel2005_PD_overall_locomotion_variable</code></li><li><code>Meloxicam_Giraudel2005_PD_pain_score</code></li><li><code>Meloxicam_Giraudel2005_PD_skin_temperature_difference</code></li></ul><h4>About meloxicam</h4><p>Meloxicam is a nonsteroidal anti-inflammatory drug used to treat osteoarthritis and other forms of arthritis. It is an approved medicine, also approved for veterinary use, and is widely used for inflammatory joint disease.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q414028\">Wikidata Q414028</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Meloxicam\">Meloxicam</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 518400, Tolerance = 1e-9, Interval = 1));
end Meloxicam;
