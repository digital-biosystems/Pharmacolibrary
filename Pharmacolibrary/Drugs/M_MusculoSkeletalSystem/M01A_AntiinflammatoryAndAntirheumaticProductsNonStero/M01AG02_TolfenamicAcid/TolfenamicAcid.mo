within Pharmacolibrary.Drugs.M_MusculoSkeletalSystem.M01A_AntiinflammatoryAndAntirheumaticProductsNonStero.M01AG02_TolfenamicAcid;
model TolfenamicAcid "TolfenamicAcid — default model: TolfenamicAcid_Landoni1996_reference"
  extends TolfenamicAcid_Landoni1996_reference;
  annotation (Documentation(info = "<html><body><p>The default model of tolfenamic acid: <a href=\"modelica://Pharmacolibrary.Drugs.M_MusculoSkeletalSystem.M01A_AntiinflammatoryAndAntirheumaticProductsNonStero.M01AG02_TolfenamicAcid.TolfenamicAcid_Landoni1996_reference\">TolfenamicAcid_Landoni1996_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of tolfenamic acid in this package:</p><ul><li><code>TolfenamicAcid_Landoni1996_reference</code></li></ul><h4>About tolfenamic acid</h4><p>Tolfenamic acid is a non-steroidal anti-inflammatory drug (a fenamate) used as an analgesic and anti-inflammatory, for example for pain and rheumatic conditions. It is an approved medicine, though not authorised by the European Medicines Agency, and is used only in some countries rather than worldwide.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q59412\">Wikidata Q59412</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.TolfenamicAcid\">TolfenamicAcid</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end TolfenamicAcid;
