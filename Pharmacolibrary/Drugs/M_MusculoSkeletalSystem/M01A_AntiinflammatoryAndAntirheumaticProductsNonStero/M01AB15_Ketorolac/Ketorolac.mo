  extends Ketorolac_Drover2012_reference;
  annotation (Documentation(info = "<html><body><p>The default model of ketorolac: <a href=\"modelica://Pharmacolibrary.Drugs.M_MusculoSkeletalSystem.M01A_AntiinflammatoryAndAntirheumaticProductsNonStero.M01AB15_Ketorolac.Ketorolac_Drover2012_reference\">Ketorolac_Drover2012_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of ketorolac in this package:</p><ul><li><code>Ketorolac_Cohen2011_reference</code></li><li><code>Ketorolac_Drover2012_reference</code></li><li><code>Ketorolac_Villa2015_reference</code></li></ul><h4>About ketorolac</h4><p>It is an approved medicine, available in formulations for systemic and ophthalmic (eye) use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2014797\">Wikidata Q2014797</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Ketorolac\">Ketorolac</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 93600, Tolerance = 1e-9, Interval = 1));
end Ketorolac;
