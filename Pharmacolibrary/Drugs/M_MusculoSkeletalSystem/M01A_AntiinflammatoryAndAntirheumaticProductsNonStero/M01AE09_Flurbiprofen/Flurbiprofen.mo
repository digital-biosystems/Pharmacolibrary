within Pharmacolibrary.Drugs.M_MusculoSkeletalSystem.M01A_AntiinflammatoryAndAntirheumaticProductsNonStero.M01AE09_Flurbiprofen;
model Flurbiprofen "Flurbiprofen — default model: Flurbiprofen_Aarons1991_reference"
  extends Flurbiprofen_Aarons1991_reference;
  annotation (Documentation(info = "<html><body><p>The default model of flurbiprofen: <a href=\"modelica://Pharmacolibrary.Drugs.M_MusculoSkeletalSystem.M01A_AntiinflammatoryAndAntirheumaticProductsNonStero.M01AE09_Flurbiprofen.Flurbiprofen_Aarons1991_reference\">Flurbiprofen_Aarons1991_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of flurbiprofen in this package:</p><ul><li><code>Flurbiprofen_Aarons1991_reference</code></li></ul><h4>About flurbiprofen</h4><p>Flurbiprofen is a non-steroidal anti-inflammatory drug used to treat pain and inflammation in conditions such as osteoarthritis and rheumatoid arthritis, and is also applied topically for joint, muscular, throat, and eye problems. It is an approved medicine used in several forms, including tablets, topical preparations, throat lozenges, and eye drops, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q419890\">Wikidata Q419890</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Flurbiprofen\">Flurbiprofen</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Flurbiprofen;
