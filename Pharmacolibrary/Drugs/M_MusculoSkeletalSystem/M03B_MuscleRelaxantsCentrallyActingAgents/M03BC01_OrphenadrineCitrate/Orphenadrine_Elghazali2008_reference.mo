within Pharmacolibrary.Drugs.M_MusculoSkeletalSystem.M03B_MuscleRelaxantsCentrallyActingAgents.M03BC01_OrphenadrineCitrate;
model Orphenadrine_Elghazali2008_reference
  parameter Real Cl_ref = 1.1666666666666666e-05 "Cl [m3/s]";
  parameter Real Vd_ref = 0.0609 "Vd [m3]";
  extends Pharmacolibrary.Pharmacokinetic.Models.PK_1C(
    weight = 70.0,
    F = 1,
    Cl = Cl_ref,
    Vd = Vd_ref,
    adminDuration = 600,
    adminCount = 1,
    MM = Pharmacolibrary.Drugs.Substances.OrphenadrineChloride.M,
    adminMass = 1e-05
  );

  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>orphenadrine</td></tr><tr><td>ATC code:</td><td>M03BC01</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Elghazali M et al. 2008</td></tr><tr><td>population:</td><td>camels</td></tr><tr><td>measured compound:</td><td>orphenadrine</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_orphenadrine/Orphenadrine_Elghazali2008_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>distribution half-life (t(1/2)(alpha))</td><td>0.5</td><td>h</td><td><small>t1/2α</small></td></tr><tr><td>elimination half-life (t(1/2)(beta))</td><td>3.57</td><td>h</td><td><small>t1/2β</small></td></tr><tr><td>area under the time concentration curve (AUC)</td><td>1.03</td><td>mg*h/L</td><td><small>AUC</small></td></tr><tr><td>volume of distribution at steady state (Vd(ss))</td><td>1.92</td><td>lkg(-1)</td><td><small>Vss</small></td></tr><tr><td>volume of the central compartment of the two compartment pharmacokinetic model (V(c))</td><td>0.87</td><td>lkg(-1)</td><td><small>V</small></td></tr><tr><td>total body clearance (Cl(T))</td><td>0.6</td><td>l/hkg(-1)</td><td><small>CL</small></td></tr></table><h4>About orphenadrine</h4><p>Orphenadrine is a centrally acting muscle relaxant and anticholinergic drug used for painful muscle spasms, cramps, and spastic conditions, and also as an antiparkinson agent. It remains an approved medicine, used mainly for musculoskeletal and neurological indications, though not authorised centrally in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3292273\">Wikidata Q3292273</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.OrphenadrineChloride\">OrphenadrineChloride</a>.</p><h4>References</h4><ol><li><p>Elghazali M et al. (2008). Pharmacokinetic, metabolism and withdrawal time of orphenadrine in camels (Camelus dromedarius) after intravenous administration. <i>Research in veterinary science 85(3):563–569</i>. DOI:<a href=\"https://doi.org/10.1016/j.rvsc.2008.01.006\">10.1016/j.rvsc.2008.01.006</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/18321539\">18321539</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Elghazali_2008: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Orphenadrine_Elghazali2008_reference;
