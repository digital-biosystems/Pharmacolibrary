within Pharmacolibrary.Drugs.M_MusculoSkeletalSystem.M03B_MuscleRelaxantsCentrallyActingAgents.M03BC01_OrphenadrineCitrate;
model OrphenadrineCitrate "OrphenadrineCitrate — default model: Orphenadrine_Elghazali2008_reference"
  extends Orphenadrine_Elghazali2008_reference;
  annotation (Documentation(info = "<html><body><p>The default model of Orphenadrine: <a href=\"modelica://Pharmacolibrary.Drugs.M_MusculoSkeletalSystem.M03B_MuscleRelaxantsCentrallyActingAgents.M03BC01_OrphenadrineCitrate.Orphenadrine_Elghazali2008_reference\">Orphenadrine_Elghazali2008_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of Orphenadrine in this package:</p><ul><li><code>Orphenadrine_Elghazali2008_reference</code></li></ul><h4>About Orphenadrine</h4><p>Orphenadrine is a centrally acting muscle relaxant and anticholinergic drug used for painful muscle spasms, cramps, and spastic conditions, and also as an antiparkinson agent. It remains an approved medicine, used mainly for musculoskeletal and neurological indications, though not authorised centrally in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3292273\">Wikidata Q3292273</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.OrphenadrineChloride\">OrphenadrineChloride</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end OrphenadrineCitrate;
