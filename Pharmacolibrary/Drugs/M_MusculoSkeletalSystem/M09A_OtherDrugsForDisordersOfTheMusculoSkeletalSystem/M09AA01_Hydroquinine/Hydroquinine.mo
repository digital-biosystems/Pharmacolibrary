within Pharmacolibrary.Drugs.M_MusculoSkeletalSystem.M09A_OtherDrugsForDisordersOfTheMusculoSkeletalSystem.M09AA01_Hydroquinine;
model Hydroquinine "Hydroquinine — default model: Hydroquinine_van2000_reference"
  extends Hydroquinine_van2000_reference;
  annotation (Documentation(info = "<html><body><p>The default model of hydroquinine: <a href=\"modelica://Pharmacolibrary.Drugs.M_MusculoSkeletalSystem.M09A_OtherDrugsForDisordersOfTheMusculoSkeletalSystem.M09AA01_Hydroquinine.Hydroquinine_van2000_reference\">Hydroquinine_van2000_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of hydroquinine in this package:</p><ul><li><code>Hydroquinine_van2000_reference</code></li></ul><h4>About hydroquinine</h4><p>Hydroquinine, a quinine derivative, is classified among drugs for disorders of the musculo-skeletal system. It is not an established marketed medicine; it is listed only as an experimental compound, so its current clinical use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5276450\">Wikidata Q5276450</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Hydroquinine\">Hydroquinine</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 259200, Tolerance = 1e-9, Interval = 1));
end Hydroquinine;
