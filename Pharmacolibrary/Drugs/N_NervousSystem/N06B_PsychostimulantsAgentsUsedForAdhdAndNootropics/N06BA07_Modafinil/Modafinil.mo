within Pharmacolibrary.Drugs.N_NervousSystem.N06B_PsychostimulantsAgentsUsedForAdhdAndNootropics.N06BA07_Modafinil;
model Modafinil "Modafinil — default model: Modafinil_Tao2010_reference"
  extends Modafinil_Tao2010_reference;
  annotation (Documentation(info = "<html><body><p>The default model of modafinil: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N06B_PsychostimulantsAgentsUsedForAdhdAndNootropics.N06BA07_Modafinil.Modafinil_Tao2010_reference\">Modafinil_Tao2010_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of modafinil in this package:</p><ul><li><code>Modafinil_Tao2010_reference</code></li></ul><h4>About modafinil</h4><p>Modafinil is a wakefulness-promoting stimulant used for sleep disorders such as narcolepsy and hypersomnia, and studied for fatigue, ADHD and multiple sclerosis-related tiredness. It is an approved medicine, widely used for narcolepsy, though it carries a boxed warning and is also investigated for other conditions.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q410441\">Wikidata Q410441</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Modafinil\">Modafinil</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Modafinil;
