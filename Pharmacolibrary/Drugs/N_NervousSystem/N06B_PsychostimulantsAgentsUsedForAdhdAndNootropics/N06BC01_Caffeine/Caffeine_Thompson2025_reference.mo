within Pharmacolibrary.Drugs.N_NervousSystem.N06B_PsychostimulantsAgentsUsedForAdhdAndNootropics.N06BC01_Caffeine;
model Caffeine_Thompson2025_reference
  parameter Real Cl_ref = 1.2361111111111112e-07 "Cl [m3/s]";
  parameter Real Vd_ref = 0.0871 "Vd [m3]";
  extends Pharmacolibrary.Pharmacokinetic.Models.PK_1C(
