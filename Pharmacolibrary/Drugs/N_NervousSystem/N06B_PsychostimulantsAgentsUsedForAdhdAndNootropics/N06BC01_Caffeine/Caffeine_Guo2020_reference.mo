  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>caffeine</td></tr><tr><td>ATC code:</td><td>N06BC01</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Guo A et al. 2020</td></tr><tr><td>population:</td><td>Chinese premature infants with apnea</td></tr><tr><td>measured compound:</td><td>caffeine</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_caffeine/Caffeine_Guo2020_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>clearance</td><td>0.268</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>volume of distribution (V)</td><td>109</td><td>L</td><td><small>V</small></td></tr></table><h4>About caffeine</h4><p>Caffeine is a stimulant used to treat breathing problems such as apnea in newborns, and is also used in dermatological and diagnostic preparations. It is widely used and authorised in the European Union, mainly for apnea of prematurity.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q60235\">Wikidata Q60235</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Caffeine\">Caffeine</a>.</p><h4>References</h4><ol><li><p>Guo A et al. (2020). Population pharmacokinetic study of caffeine citrate in Chinese premature infants with apnea. <i>Journal of clinical pharmacy and therapeutics 45(6):1414–1421</i>. DOI:<a href=\"https://doi.org/10.1111/jcpt.13240\">10.1111/jcpt.13240</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/32737938\">32737938</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Guo_2020: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 5443200, Tolerance = 1e-9, Interval = 1));
end Caffeine_Guo2020_reference;
