within Pharmacolibrary.Drugs.N_NervousSystem.N01A_AnestheticsGeneral.N01AH03_Sufentanil;
model Sufentanil "Sufentanil — default model: Sufentanil_Khaowroongrueng2024_reference"
  extends Sufentanil_Khaowroongrueng2024_reference;
  annotation (Documentation(info = "<html><body><p>The default model of sufentanil: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N01A_AnestheticsGeneral.N01AH03_Sufentanil.Sufentanil_Khaowroongrueng2024_reference\">Sufentanil_Khaowroongrueng2024_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of sufentanil in this package:</p><ul><li><code>Sufentanil_Hahn2019_final</code></li><li><code>Sufentanil_Khaowroongrueng2024_reference</code></li><li><code>Sufentanil_Pokorn2021_reference</code></li><li><code>Sufentanil_Pypendop2014_reference</code></li></ul><h4>About sufentanil</h4><p>Sufentanil is a strong opioid used to treat pain, especially as an anesthetic adjunct and for postoperative pain relief. It remains in use, with an authorised product in the European Union, though it carries a boxed warning and is mainly used in controlled hospital settings such as anesthesia.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q417915\">Wikidata Q417915</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Sufentanil\">Sufentanil</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Sufentanil;
