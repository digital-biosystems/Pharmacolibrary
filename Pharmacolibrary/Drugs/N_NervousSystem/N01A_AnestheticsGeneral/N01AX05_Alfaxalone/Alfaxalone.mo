within Pharmacolibrary.Drugs.N_NervousSystem.N01A_AnestheticsGeneral.N01AX05_Alfaxalone;
model Alfaxalone "Alfaxalone — default model: Alfaxalone_White2022_adjusted_typical_values"
  extends Alfaxalone_White2022_adjusted_typical_values;
  annotation (Documentation(info = "<html><body><p>The default model of alfaxalone: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N01A_AnestheticsGeneral.N01AX05_Alfaxalone.Alfaxalone_White2022_adjusted_typical_values\">Alfaxalone_White2022_adjusted_typical_values</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of alfaxalone in this package:</p><ul><li><code>Alfaxalone_Goodchild2020_reference</code></li><li><code>Alfaxalone_White2022_adjusted_typical_values</code></li><li><code>Alfaxalone_White2022_adjusted_typical_values_a</code></li></ul><h4>About alfaxalone</h4><p>Alfaxalone is a steroid-based general anesthetic used to induce and maintain anesthesia. It is approved for veterinary use, where it is widely used as an anesthetic in animals, while in humans it is considered experimental.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3611058\">Wikidata Q3611058</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Alfaxalone\">Alfaxalone</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Alfaxalone;
