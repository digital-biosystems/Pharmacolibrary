  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>propofol</td></tr><tr><td>ATC code:</td><td>N01AX10</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Jones RD et al. 1990</td></tr><tr><td>population:</td><td>healthy children</td></tr><tr><td>measured compound:</td><td>propofol</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_propofol/Propofol_Jones1990_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>mean (SEM) elimination half-life</td><td>209</td><td>min</td><td><small>t1/2z</small></td></tr><tr><td>total body clearance</td><td>40.4</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>mean (SEM) apparent volume of distribution at steady state</td><td>5.0</td><td>litre kg-1</td><td><small>Vss</small></td></tr><tr><td>volume of the central compartment</td><td>0.6</td><td>litre kg-1</td><td><small>V</small></td></tr></table><h4>About propofol</h4><p>Propofol is an intravenous medication used to induce and maintain general anaesthesia, and also for sedation and to treat status epilepticus. It is widely used in human medicine and is also an approved veterinary medicine; it appears on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q422740\">Wikidata Q422740</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Propofol\">Propofol</a>.</p><h4>References</h4><ol><li><p>Jones RD et al. (1990). Pharmacokinetics of propofol in children. <i>British journal of anaesthesia 65(5):661–667</i>. DOI:<a href=\"https://doi.org/10.1093/bja/65.5.661\">10.1093/bja/65.5.661</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/2248844\">2248844</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Jones_1990: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
