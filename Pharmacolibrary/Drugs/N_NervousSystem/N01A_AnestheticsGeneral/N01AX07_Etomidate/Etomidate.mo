within Pharmacolibrary.Drugs.N_NervousSystem.N01A_AnestheticsGeneral.N01AX07_Etomidate;
model Etomidate "Etomidate — default model: Etomidate_Shen2016_reference"
  extends Etomidate_Shen2016_reference;
  annotation (Documentation(info = "<html><body><p>The default model of etomidate: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N01A_AnestheticsGeneral.N01AX07_Etomidate.Etomidate_Shen2016_reference\">Etomidate_Shen2016_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of etomidate in this package:</p><ul><li><code>Etomidate_Kaneda2011_reference</code></li><li><code>Etomidate_Lin2012_reference</code></li><li><code>Etomidate_Shen2016_reference</code></li><li><code>Etomidate_van1983_reference</code></li></ul><h4>About etomidate</h4><p>Etomidate is an intravenous general anesthetic and sedative-hypnotic, used to induce anesthesia and studied for conditions such as status epilepticus and brain ischemia. It is an approved medicine, used mainly in hospital settings for anesthesia induction.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q418445\">Wikidata Q418445</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Etomidate\">Etomidate</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Etomidate;
