within Pharmacolibrary.Drugs.N_NervousSystem.N01A_AnestheticsGeneral.N01AX07_Etomidate;
model Etomidate_Lin2012_reference
  parameter Real Cl_ref = 2.5e-05 "Cl [m3/s]";
  parameter Real Vd_ref = 0.00951 "Vd [m3]";
  extends Pharmacolibrary.Pharmacokinetic.Models.PK_1C(
    weight = 70.0,
    F = 1,
    Cl = Cl_ref,
    Vd = Vd_ref,
    adminDuration = 600,
    adminCount = 1,
    MM = Pharmacolibrary.Drugs.Substances.Etomidate.M,
    adminMass = 1e-05
  );

  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>etomidate</td></tr><tr><td>ATC code:</td><td>N01AX07</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Lin L et al. 2012</td></tr><tr><td>population:</td><td>children over 6 months of age</td></tr><tr><td>measured compound:</td><td>etomidate</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_etomidate/Etomidate_Lin2012_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>Cl(1)</td><td>1.5</td><td>l·min(-1)</td><td><small>CL</small></td></tr><tr><td>V(1)</td><td>9.51</td><td>l</td><td><small>V</small></td></tr></table><h4>About etomidate</h4><p>Etomidate is an intravenous general anesthetic and sedative-hypnotic, used to induce anesthesia and studied for conditions such as status epilepticus and brain ischemia. It is an approved medicine, used mainly in hospital settings for anesthesia induction.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q418445\">Wikidata Q418445</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Etomidate\">Etomidate</a>.</p><h4>References</h4><ol><li><p>Lin L et al. (2012). Population pharmacokinetics of intravenous bolus etomidate in children over 6 months of age. <i>Paediatric anaesthesia 22(4):318–326</i>. DOI:<a href=\"https://doi.org/10.1111/j.1460-9592.2011.03696.x\">10.1111/j.1460-9592.2011.03696.x</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/21917057\">21917057</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Lin_2012: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Etomidate_Lin2012_reference;
