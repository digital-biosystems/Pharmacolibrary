within Pharmacolibrary.Drugs.N_NervousSystem.N01A_AnestheticsGeneral.N01AH02_Alfentanil;
model Alfentanil "Alfentanil — default model: Alfentanil_Helmers1984_reference"
  extends Alfentanil_Helmers1984_reference;
  annotation (Documentation(info = "<html><body><p>The default model of alfentanil: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N01A_AnestheticsGeneral.N01AH02_Alfentanil.Alfentanil_Helmers1984_reference\">Alfentanil_Helmers1984_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of alfentanil in this package:</p><ul><li><code>Alfentanil_Bouillon1999_reference</code></li><li><code>Alfentanil_Helmers1984_reference</code></li></ul><h4>About alfentanil</h4><p>Alfentanil is an opioid used as an intravenous anesthetic for general anesthesia and pain control. It is an approved medicine used mainly in hospital settings for anesthesia, though it is also a controlled drug with illicit misuse potential.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q176533\">Wikidata Q176533</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Alfentanil\">Alfentanil</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Alfentanil;
