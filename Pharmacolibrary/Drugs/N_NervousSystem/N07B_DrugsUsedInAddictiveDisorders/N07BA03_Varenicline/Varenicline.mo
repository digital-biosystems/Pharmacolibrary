within Pharmacolibrary.Drugs.N_NervousSystem.N07B_DrugsUsedInAddictiveDisorders.N07BA03_Varenicline;
model Varenicline "Varenicline — default model: Varenicline_Fediuk2021_reference"
  extends Varenicline_Fediuk2021_reference;
  annotation (Documentation(info = "<html><body><p>The default model of varenicline: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N07B_DrugsUsedInAddictiveDisorders.N07BA03_Varenicline.Varenicline_Fediuk2021_reference\">Varenicline_Fediuk2021_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of varenicline in this package:</p><ul><li><code>Varenicline_Fediuk2021_reference</code></li></ul><h4>About varenicline</h4><p>Varenicline is a medicine used to help people stop smoking (tobacco use cessation). It is an approved drug and is authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q411330\">Wikidata Q411330</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Varenicline\">Varenicline</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 259200, Tolerance = 1e-9, Interval = 1));
end Varenicline;
