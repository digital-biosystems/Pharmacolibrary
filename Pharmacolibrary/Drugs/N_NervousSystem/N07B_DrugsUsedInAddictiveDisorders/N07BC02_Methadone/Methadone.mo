within Pharmacolibrary.Drugs.N_NervousSystem.N07B_DrugsUsedInAddictiveDisorders.N07BC02_Methadone;
model Methadone "Methadone — default model: Methadone_Shin2024_reference"
  extends Methadone_Shin2024_reference;
  annotation (Documentation(info = "<html><body><p>The default model of methadone: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N07B_DrugsUsedInAddictiveDisorders.N07BC02_Methadone.Methadone_Shin2024_reference\">Methadone_Shin2024_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of methadone in this package:</p><ul><li><code>Methadone_Shin2024_reference</code></li></ul><h4>About methadone</h4><p>Methadone is an opioid used to treat opiate dependence and is also used for pain relief. It is an approved medicine, listed as a WHO essential medicine, and is widely used, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q179996\">Wikidata Q179996</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Methadone\">Methadone</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Methadone;
