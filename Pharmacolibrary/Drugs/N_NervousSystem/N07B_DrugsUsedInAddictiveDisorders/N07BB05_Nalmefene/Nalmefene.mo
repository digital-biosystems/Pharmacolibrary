within Pharmacolibrary.Drugs.N_NervousSystem.N07B_DrugsUsedInAddictiveDisorders.N07BB05_Nalmefene;
model Nalmefene "Nalmefene — default model: Nalmefene_Kyhl2016_reference"
  extends Nalmefene_Kyhl2016_reference;
  annotation (Documentation(info = "<html><body><p>The default model of nalmefene: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N07B_DrugsUsedInAddictiveDisorders.N07BB05_Nalmefene.Nalmefene_Kyhl2016_reference\">Nalmefene_Kyhl2016_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of nalmefene in this package:</p><ul><li><code>Nalmefene_Kyhl2016_reference</code></li></ul><h4>About nalmefene</h4><p>Nalmefene is an opioid antagonist used to treat alcohol dependence and has been studied for opiate dependence. It is authorised in the European Union as a medicine for alcohol-related disorders.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4353252\">Wikidata Q4353252</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Nalmefene\">Nalmefene</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Nalmefene;
