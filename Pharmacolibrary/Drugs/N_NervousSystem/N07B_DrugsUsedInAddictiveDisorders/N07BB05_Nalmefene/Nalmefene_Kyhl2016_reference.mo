  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>nalmefene</td></tr><tr><td>ATC code:</td><td>N07BB05</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Kyhl LE et al. 2016</td></tr><tr><td>population:</td><td>healthy subjects</td></tr><tr><td>measured compound:</td><td>nalmefene</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_nalmefene/Nalmefene_Kyhl2016_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>systemic clearance</td><td>60.4</td><td>l h(-1)</td><td><small>CL</small></td></tr><tr><td>central volume of distribution</td><td>266</td><td>l</td><td><small>V</small></td></tr><tr><td>Absolute oral bioavailability without food intake</td><td>41</td><td>%</td><td><small>Fab</small></td></tr></table><h4>About nalmefene</h4><p>Nalmefene is an opioid antagonist used to treat alcohol dependence and has been studied for opiate dependence. It is authorised in the European Union as a medicine for alcohol-related disorders.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4353252\">Wikidata Q4353252</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Nalmefene\">Nalmefene</a>.</p><h4>References</h4><ol><li><p>Kyhl LE et al. (2016). Population pharmacokinetics of nalmefene in healthy subjects and its relation to μ-opioid receptor occupancy. <i>British journal of clinical pharmacology 81(2):290–300</i>. DOI:<a href=\"https://doi.org/10.1111/bcp.12805\">10.1111/bcp.12805</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/26483076\">26483076</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Kyhl_2016: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
