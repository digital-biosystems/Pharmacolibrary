  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>levomethadone</td></tr><tr><td>ATC code:</td><td>N07BC05</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Gittel C et al. 2021</td></tr><tr><td>population:</td><td>isoflurane-anaesthetized healthy adult ponies</td></tr><tr><td>measured compound:</td><td>l-methadone</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_levomethadone/Levomethadone_Gittel2021v2_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>terminal half-life</td><td>44.3</td><td>minutes</td><td><small>t1/2z</small></td></tr><tr><td>volume of distribution</td><td>0.43</td><td>L kg-1</td><td><small>V</small></td></tr><tr><td>plasma clearance</td><td>7.77</td><td>L/h</td><td><small>CL</small></td></tr></table><h4>About levomethadone</h4><p>Levomethadone, the active isomer of methadone, is classified as a drug used in opioid dependence. It is currently considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6535776\">Wikidata Q6535776</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Levomethadone\">Levomethadone</a>.</p><h4>References</h4><ol><li><p>Gittel C et al. (2021). Pharmacokinetics and pharmacodynamics of l-methadone in isoflurane-anaesthetized and mechanically ventilated ponies. <i>Veterinary anaesthesia and analgesia 48(2):213–222</i>. DOI:<a href=\"https://doi.org/10.1016/j.vaa.2020.04.018\">10.1016/j.vaa.2020.04.018</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/33423953\">33423953</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Gittel_2021_2: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
