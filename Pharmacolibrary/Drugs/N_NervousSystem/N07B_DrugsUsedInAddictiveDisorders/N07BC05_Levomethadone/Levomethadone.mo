model Levomethadone "Levomethadone — default model: Levomethadone_Gittel2021v2_reference"
  extends Levomethadone_Gittel2021v2_reference;
  annotation (Documentation(info = "<html><body><p>The default model of levomethadone: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N07B_DrugsUsedInAddictiveDisorders.N07BC05_Levomethadone.Levomethadone_Gittel2021v2_reference\">Levomethadone_Gittel2021v2_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of levomethadone in this package:</p><ul><li><code>Levomethadone_Gittel2021v2_reference</code></li></ul><h4>About levomethadone</h4><p>Levomethadone, the active isomer of methadone, is classified as a drug used in opioid dependence. It is currently considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6535776\">Wikidata Q6535776</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Levomethadone\">Levomethadone</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Levomethadone;
