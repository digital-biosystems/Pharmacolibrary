within Pharmacolibrary.Drugs.N_NervousSystem.N02C_AntimigrainePreparations.N02CD06_Rimegepant;
model Rimegepant "Rimegepant — default model: Rimegepant_Comisar2025v2_reference"
  extends Rimegepant_Comisar2025v2_reference;
  annotation (Documentation(info = "<html><body><p>The default model of rimegepant: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N02C_AntimigrainePreparations.N02CD06_Rimegepant.Rimegepant_Comisar2025v2_reference\">Rimegepant_Comisar2025v2_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of rimegepant in this package:</p><ul><li><code>Rimegepant_Comisar2025_reference</code></li><li><code>Rimegepant_Comisar2025v2_reference</code></li></ul><h4>About rimegepant</h4><p>Rimegepant is a calcitonin gene-related peptide receptor antagonist used to treat acute migraine attacks in adults. It is an approved medicine and is authorised in the European Union for migraine.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27272184\">Wikidata Q27272184</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Rimegepant\">Rimegepant</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Rimegepant;
