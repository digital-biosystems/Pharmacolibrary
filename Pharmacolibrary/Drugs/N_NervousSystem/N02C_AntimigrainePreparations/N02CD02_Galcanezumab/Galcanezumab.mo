within Pharmacolibrary.Drugs.N_NervousSystem.N02C_AntimigrainePreparations.N02CD02_Galcanezumab;
model Galcanezumab "Galcanezumab — default model: Galcanezumab_FiedlerKelly2021_reference"
  extends Galcanezumab_FiedlerKelly2021_reference;
  annotation (Documentation(info = "<html><body><p>The default model of galcanezumab: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N02C_AntimigrainePreparations.N02CD02_Galcanezumab.Galcanezumab_FiedlerKelly2021_reference\">Galcanezumab_FiedlerKelly2021_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of galcanezumab in this package:</p><ul><li><code>Galcanezumab_FiedlerKelly2021_reference</code></li></ul><h4>About galcanezumab</h4><p>Galcanezumab is a humanized monoclonal antibody used to prevent migraine attacks. It is an approved medicine, authorised in the European Union for migraine, and is also under investigation for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q25326707\">Wikidata Q25326707</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Galcanezumab\">Galcanezumab</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Galcanezumab;
