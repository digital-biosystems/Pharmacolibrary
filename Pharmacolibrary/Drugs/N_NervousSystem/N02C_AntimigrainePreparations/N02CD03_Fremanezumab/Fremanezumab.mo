within Pharmacolibrary.Drugs.N_NervousSystem.N02C_AntimigrainePreparations.N02CD03_Fremanezumab;
model Fremanezumab "Fremanezumab — default model: Fremanezumab_FiedlerKelly2019_reference"
  extends Fremanezumab_FiedlerKelly2019_reference;
  annotation (Documentation(info = "<html><body><p>The default model of fremanezumab: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N02C_AntimigrainePreparations.N02CD03_Fremanezumab.Fremanezumab_FiedlerKelly2019_reference\">Fremanezumab_FiedlerKelly2019_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of fremanezumab in this package:</p><ul><li><code>Fremanezumab_FiedlerKelly2019_reference</code></li></ul><h4>About fremanezumab</h4><p>Fremanezumab is a monoclonal antibody used to prevent migraine, including migraine with and without aura. It is an approved CGRP-antagonist medicine authorised in the European Union for migraine prevention.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q39048381\">Wikidata Q39048381</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Fremanezumab\">Fremanezumab</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 6652800, Tolerance = 1e-9, Interval = 1));
end Fremanezumab;
