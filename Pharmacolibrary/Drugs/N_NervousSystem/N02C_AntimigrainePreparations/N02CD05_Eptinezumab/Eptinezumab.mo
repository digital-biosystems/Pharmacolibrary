within Pharmacolibrary.Drugs.N_NervousSystem.N02C_AntimigrainePreparations.N02CD05_Eptinezumab;
model Eptinezumab "Eptinezumab — default model: Eptinezumab_Baker2020_reference"
  extends Eptinezumab_Baker2020_reference;
  annotation (Documentation(info = "<html><body><p>The default model of eptinezumab: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N02C_AntimigrainePreparations.N02CD05_Eptinezumab.Eptinezumab_Baker2020_reference\">Eptinezumab_Baker2020_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of eptinezumab in this package:</p><ul><li><code>Eptinezumab_Baker2020_reference</code></li></ul><h4>About eptinezumab</h4><p>Eptinezumab is a monoclonal antibody used to prevent migraine attacks. It is an authorised medicine in the European Union and is also approved elsewhere, given as an infusion by healthcare professionals.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q28208949\">Wikidata Q28208949</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Eptinezumab\">Eptinezumab</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 7862400, Tolerance = 1e-9, Interval = 1));
end Eptinezumab;
