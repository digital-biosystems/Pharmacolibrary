  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>eptinezumab</td></tr><tr><td>ATC code:</td><td>N02CD05</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Baker B et al. 2020</td></tr><tr><td>population:</td><td>patients with episodic or chronic migraine</td></tr><tr><td>measured compound:</td><td>eptinezumab</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_eptinezumab/Eptinezumab_Baker2020_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>AUC0‐12wk, mean (CV%), h·μg mL−1</td><td>158</td><td>h·μg mL−1</td><td><small>AUCt</small></td></tr><tr><td>C max, mean (CV%), μg mL−1</td><td>0.279</td><td>μg mL−1</td><td><small>Cmax</small></td></tr><tr><td>C avg, mean (CV%), μg mL−1</td><td>0.0785</td><td>μg mL−1</td><td><small>Cavg</small></td></tr><tr><td>C trough, mean (CV%), μg mL−1</td><td>0.0232</td><td>μg mL−1</td><td><small>Ctrough</small></td></tr><tr><td>Css,avg, mean (CV%), μg mL−1</td><td>0.0910</td><td>μg mL−1</td><td><small>Css</small></td></tr><tr><td>CL</td><td>0.0062</td><td>L h−1</td><td><small>CL</small></td></tr><tr><td>the central volume of distribution (Vc)</td><td>3.64</td><td>L</td><td><small>V</small></td></tr></table><h4>About eptinezumab</h4><p>Eptinezumab is a monoclonal antibody used to prevent migraine attacks. It is an authorised medicine in the European Union and is also approved elsewhere, given as an infusion by healthcare professionals.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q28208949\">Wikidata Q28208949</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Eptinezumab\">Eptinezumab</a>.</p><h4>References</h4><ol><li><p>Baker B et al. (2020). Population pharmacokinetic and exposure-response analysis of eptinezumab in the treatment of episodic and chronic migraine. <i>Pharmacology research &amp; perspectives 8(2):e00567</i>. DOI:<a href=\"https://doi.org/10.1002/prp2.567\">10.1002/prp2.567</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/32155317\">32155317</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Baker_2020: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
