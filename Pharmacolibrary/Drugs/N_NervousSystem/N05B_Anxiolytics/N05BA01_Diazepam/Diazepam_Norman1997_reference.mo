  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>diazepam</td></tr><tr><td>ATC code:</td><td>N05BA01</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Norman WM et al. 1997</td></tr><tr><td>population:</td><td>foals aged 4 to 84 days</td></tr><tr><td>measured compound:</td><td>diazepam</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_diazepam/Diazepam_Norman1997_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>Clearance</td><td>5.06</td><td>ml/kg/min</td><td><small>CL</small></td></tr><tr><td>free fraction</td><td>51</td><td>ml/kg/min</td><td><small>fu</small></td></tr><tr><td>Volume of distribution</td><td>1.57</td><td>L/kg</td><td><small>V</small></td></tr></table><h4>About diazepam</h4><p>Diazepam is a benzodiazepine sedative used for conditions such as anxiety, insomnia, epilepsy including status epilepticus, muscle spasticity, and alcohol withdrawal. It is widely used, appears on the WHO essential medicines list, and is also approved for veterinary use, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q210402\">Wikidata Q210402</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Diazepam\">Diazepam</a>.</p><h4>References</h4><ol><li><p>Norman WM et al. (1997). Age-related changes in the pharmacokinetic disposition of diazepam in foals. <i>American journal of veterinary research 58(8):878–880</i>. PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/9256974\">9256974</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Norman_1997: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Diazepam_Norman1997_reference;
