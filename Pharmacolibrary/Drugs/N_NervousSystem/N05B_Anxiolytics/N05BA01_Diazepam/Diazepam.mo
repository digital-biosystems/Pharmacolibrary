within Pharmacolibrary.Drugs.N_NervousSystem.N05B_Anxiolytics.N05BA01_Diazepam;
model Diazepam "Diazepam — default model: Diazepam_Klotz1976_reference"
  extends Diazepam_Klotz1976_reference;
  annotation (Documentation(info = "<html><body><p>The default model of diazepam: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N05B_Anxiolytics.N05BA01_Diazepam.Diazepam_Klotz1976_reference\">Diazepam_Klotz1976_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of diazepam in this package:</p><ul><li><code>Diazepam_Klotz1975_reference</code></li><li><code>Diazepam_Klotz1976_reference</code></li></ul><h4>About diazepam</h4><p>Diazepam is a benzodiazepine sedative used for conditions such as anxiety, insomnia, epilepsy including status epilepticus, muscle spasticity, and alcohol withdrawal. It is widely used, appears on the WHO essential medicines list, and is also approved for veterinary use, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q210402\">Wikidata Q210402</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Diazepam\">Diazepam</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Diazepam;
