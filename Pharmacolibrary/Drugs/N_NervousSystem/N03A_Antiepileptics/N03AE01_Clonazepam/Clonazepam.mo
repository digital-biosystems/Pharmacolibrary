within Pharmacolibrary.Drugs.N_NervousSystem.N03A_Antiepileptics.N03AE01_Clonazepam;
model Clonazepam "Clonazepam — default model: Clonazepam_Kruizinga2022_reference"
  extends Clonazepam_Kruizinga2022_reference;
  annotation (Documentation(info = "<html><body><p>The default model of clonazepam: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N03A_Antiepileptics.N03AE01_Clonazepam.Clonazepam_Kruizinga2022_reference\">Clonazepam_Kruizinga2022_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of clonazepam in this package:</p><ul><li><code>Clonazepam_Kruizinga2022_reference</code></li></ul><h4>About clonazepam</h4><p>Clonazepam is a benzodiazepine anticonvulsant used to treat epilepsy, including myoclonic and childhood absence epilepsy, as well as panic disorder, anxiety, insomnia, and restless legs syndrome. It is an approved medicine used widely in clinical practice, though it carries a boxed warning and also has investigational and illicit uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q407988\">Wikidata Q407988</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Clonazepam\">Clonazepam</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 950400, Tolerance = 1e-9, Interval = 1));
end Clonazepam;
