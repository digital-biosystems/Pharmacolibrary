within Pharmacolibrary.Drugs.N_NervousSystem.N03A_Antiepileptics.N03AF01_Carbamazepine;
model Carbamazepine "Carbamazepine — default model: Carbamazepine_Djordjevic2016_reference"
  extends Carbamazepine_Djordjevic2016_reference;
  annotation (Documentation(info = "<html><body><p>The default model of carbamazepine: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N03A_Antiepileptics.N03AF01_Carbamazepine.Carbamazepine_Djordjevic2016_reference\">Carbamazepine_Djordjevic2016_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of carbamazepine in this package:</p><ul><li><code>Carbamazepine_Djordjevic2016_reference</code></li><li><code>Carbamazepine_Djordjevic2025_reference</code></li><li><code>Carbamazepine_Milovanovic2016_reference</code></li><li><code>Carbamazepine_Punyawudho2012_reference</code></li><li><code>Carbamazepine_Yip2021_reference</code></li></ul><h4>About carbamazepine</h4><p>Carbamazepine is an anticonvulsant used for epilepsy and seizures, trigeminal neuralgia, and bipolar disorder, and has also been used for other mood and psychiatric conditions. It remains widely used and is included on the WHO essential medicines list, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q410412\">Wikidata Q410412</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Carbamazepine\">Carbamazepine</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 15552000, Tolerance = 1e-9, Interval = 1));
end Carbamazepine;
