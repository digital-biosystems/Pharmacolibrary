within Pharmacolibrary.Drugs.N_NervousSystem.N03A_Antiepileptics.N03AX24_Cannabidiol;
model Cannabidiol "Cannabidiol — default model: Cannabidiol_Snchez2023_reference"
  extends Cannabidiol_Snchez2023_reference;
  annotation (Documentation(info = "<html><body><p>The default model of cannabidiol: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N03A_Antiepileptics.N03AX24_Cannabidiol.Cannabidiol_Snchez2023_reference\">Cannabidiol_Snchez2023_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of cannabidiol in this package:</p><ul><li><code>Cannabidiol_Snchez2023_reference</code></li></ul><h4>About cannabidiol</h4><p>Cannabidiol is an antiepileptic medicine used to treat certain epilepsy syndromes, including Lennox–Gastaut syndrome and myoclonic epilepsies. It is an approved medicine with an authorised product in the European Union, and is also being studied for other investigational uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q422917\">Wikidata Q422917</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Cannabidiol\">Cannabidiol</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 345600, Tolerance = 1e-9, Interval = 1));
end Cannabidiol;
