  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>levetiracetam</td></tr><tr><td>ATC code:</td><td>N03AX14</td></tr><tr><td>model:</td><td>one compartment, oral dosing <small>(PK_1C_enteral)</small></td></tr><tr><td>source:</td><td>Schoemaker R et al. 2018</td></tr><tr><td>population:</td><td>adults and children with focal seizures</td></tr><tr><td>measured compound:</td><td>levetiracetam</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://digital-biosystems.github.io/pharmacolibrary-docs/#/drugs/drug_levetiracetam/Levetiracetam_Schoemaker2018_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td></td><td>1.1</td><td></td><td><small></small></td></tr><tr><td></td><td>0.16</td><td></td><td><small></small></td></tr><tr><td></td><td>3.1</td><td></td><td><small></small></td></tr><tr><td></td><td>3.5</td><td></td><td><small></small></td></tr><tr><td></td><td>2.2</td><td></td><td><small></small></td></tr><tr><td></td><td>0.44</td><td></td><td><small></small></td></tr><tr><td></td><td>0.4</td><td></td><td><small></small></td></tr><tr><td></td><td>-1.09E+00</td><td></td><td><small></small></td></tr><tr><td></td><td>2.75E+00</td><td></td><td><small></small></td></tr><tr><td></td><td>1.28E+00</td><td></td><td><small></small></td></tr><tr><td></td><td>-1.60E-01</td><td></td><td><small></small></td></tr><tr><td></td><td>-3.13E+00</td><td></td><td><small></small></td></tr><tr><td></td><td>3.45E+00</td><td></td><td><small></small></td></tr><tr><td></td><td>-2.24E+00</td><td></td><td><small></small></td></tr><tr><td></td><td>4.42E-01</td><td></td><td><small></small></td></tr><tr><td></td><td>3.35E-01</td><td></td><td><small></small></td></tr><tr><td></td><td>4.20E-01</td><td></td><td><small></small></td></tr><tr><td>CL/F (L/h/kg) a</td><td>0.36</td><td>L/h/kg</td><td><small>CL/F</small></td></tr><tr><td>Vd/F (L/kg) a</td><td>1.33</td><td>L/kg</td><td><small>V/F</small></td></tr><tr><td>K a, 1/h</td><td>2.98</td><td>1/h</td><td><small>kabs</small></td></tr></table><h4>About levetiracetam</h4><p>Levetiracetam is an antiepileptic medicine used to treat epilepsy and various types of seizures, including focal, temporal lobe, frontal lobe, and tonic–clonic seizures. It is an approved drug widely used, with several products authorised in the European Union for epilepsy.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q417227\">Wikidata Q417227</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Levetiracetam\">Levetiracetam</a>.</p><h4>References</h4><ol><li><p>Schoemaker R et al. (2018). Extrapolation of a Brivaracetam Exposure-Response Model from Adults to Children with Focal Seizures. <i>Clinical pharmacokinetics 57(7):843–854</i>. DOI:<a href=\"https://doi.org/10.1007/s40262-017-0597-2\">10.1007/s40262-017-0597-2</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/28884437\">28884437</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Schoemaker_2018: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
