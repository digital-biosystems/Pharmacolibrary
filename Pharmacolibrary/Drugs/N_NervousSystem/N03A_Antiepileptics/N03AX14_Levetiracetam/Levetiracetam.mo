within Pharmacolibrary.Drugs.N_NervousSystem.N03A_Antiepileptics.N03AX14_Levetiracetam;
model Levetiracetam "Levetiracetam — default model: Levetiracetam_Schoemaker2018_reference"
  extends Levetiracetam_Schoemaker2018_reference;
  annotation (Documentation(info = "<html><body><p>The default model of levetiracetam: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N03A_Antiepileptics.N03AX14_Levetiracetam.Levetiracetam_Schoemaker2018_reference\">Levetiracetam_Schoemaker2018_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of levetiracetam in this package:</p><ul><li><code>Levetiracetam_Schoemaker2018_reference</code></li></ul><h4>About levetiracetam</h4><p>Levetiracetam is an antiepileptic medicine used to treat epilepsy and various types of seizures, including focal, temporal lobe, frontal lobe, and tonic–clonic seizures. It is an approved drug widely used, with several products authorised in the European Union for epilepsy.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q417227\">Wikidata Q417227</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Levetiracetam\">Levetiracetam</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Levetiracetam;
