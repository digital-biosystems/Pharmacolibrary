within Pharmacolibrary.Drugs.N_NervousSystem.N03A_Antiepileptics.N03AX22_Perampanel;
model Perampanel "Perampanel — default model: Perampanel_Silva2023_base"
  extends Perampanel_Silva2023_base;
  annotation (Documentation(info = "<html><body><p>The default model of perampanel: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N03A_Antiepileptics.N03AX22_Perampanel.Perampanel_Silva2023_base\">Perampanel_Silva2023_base</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of perampanel in this package:</p><ul><li><code>Perampanel_Silva2023_base</code></li><li><code>Perampanel_Silva2023_final</code></li></ul><h4>About perampanel</h4><p>Perampanel is an antiepileptic medicine used to treat epilepsy, including partial seizures and tonic–clonic seizures. It is authorised in the European Union and is an approved drug, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q868658\">Wikidata Q868658</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Perampanel\">Perampanel</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 691200, Tolerance = 1e-9, Interval = 1));
end Perampanel;
