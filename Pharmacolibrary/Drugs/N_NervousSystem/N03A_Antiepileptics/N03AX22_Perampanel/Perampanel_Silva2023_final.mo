  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>perampanel</td></tr><tr><td>ATC code:</td><td>N03AX22</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Silva R et al. 2023</td></tr><tr><td>population:</td><td>adults with refractory epilepsy</td></tr><tr><td>measured compound:</td><td>perampanel</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_perampanel/Perampanel_Silva2023_final\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>TVCL (L/h)</td><td>0.419</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>TVV (L)</td><td>29.50</td><td>L</td><td><small>V</small></td></tr></table><h4>About perampanel</h4><p>Perampanel is an antiepileptic medicine used to treat epilepsy, including partial seizures and tonic–clonic seizures. It is authorised in the European Union and is an approved drug, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q868658\">Wikidata Q868658</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Perampanel\">Perampanel</a>.</p><h4>References</h4><ol><li><p>Silva R et al. (2023). Population Pharmacokinetic Analysis of Perampanel in Portuguese Patients Diagnosed with Refractory Epilepsy. <i>Pharmaceutics 15(6)</i>. DOI:<a href=\"https://doi.org/10.3390/pharmaceutics15061704\">10.3390/pharmaceutics15061704</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/37376153\">37376153</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Silva_2023: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
