within Pharmacolibrary.Drugs.N_NervousSystem.N03A_Antiepileptics.N03AG05_Progabide;
model Progabide "Progabide — default model: Progabide_Johno1982_reference"
  extends Progabide_Johno1982_reference;
  annotation (Documentation(info = "<html><body><p>The default model of progabide: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N03A_Antiepileptics.N03AG05_Progabide.Progabide_Johno1982_reference\">Progabide_Johno1982_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of progabide in this package:</p><ul><li><code>Progabide_Johno1982_reference</code></li></ul><h4>About progabide</h4><p>Progabide is an anticonvulsant drug developed for the treatment of epilepsy, with additional antidepressant and antiparkinsonian properties. It is classed as an experimental agent and is not an established, widely marketed medicine today.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q426524\">Wikidata Q426524</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Progabide\">Progabide</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Progabide;
