within Pharmacolibrary.Drugs.N_NervousSystem.N03A_Antiepileptics.N03AA02_Phenobarbital;
model Phenobarbital "Phenobarbital — default model: Phenobarbital_Stoschus2025_reference"
  extends Phenobarbital_Stoschus2025_reference;
  annotation (Documentation(info = "<html><body><p>The default model of phenobarbital: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N03A_Antiepileptics.N03AA02_Phenobarbital.Phenobarbital_Stoschus2025_reference\">Phenobarbital_Stoschus2025_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of phenobarbital in this package:</p><ul><li><code>Phenobarbital_Stoschus2025_reference</code></li></ul><h4>About phenobarbital</h4><p>Phenobarbital is a barbiturate anticonvulsant used to treat epilepsy and seizures, including status epilepticus and neonatal seizures, and has also been used for sleep problems and anxiety. It remains in use, is listed as an essential medicine by the WHO, and is approved, though today it is used relatively sparingly for epilepsy.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q407241\">Wikidata Q407241</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Phenobarbital\">Phenobarbital</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Phenobarbital;
