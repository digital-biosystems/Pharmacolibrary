within Pharmacolibrary.Drugs.N_NervousSystem.N01B_AnestheticsLocal.N01BB01_Bupivacaine;
model Bupivacaine "Bupivacaine — default model: Bupivacaine_Araneda2025_reference"
  extends Bupivacaine_Araneda2025_reference;
  annotation (Documentation(info = "<html><body><p>The default model of bupivacaine: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N01B_AnestheticsLocal.N01BB01_Bupivacaine.Bupivacaine_Araneda2025_reference\">Bupivacaine_Araneda2025_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of bupivacaine in this package:</p><ul><li><code>Bupivacaine_Araneda2025_reference</code></li><li><code>Bupivacaine_Storgaard2024_PD_wdt</code></li></ul><h4>About bupivacaine</h4><p>Bupivacaine is a local anesthetic used to relieve pain, especially acute pain. It is widely used, is on the WHO list of essential medicines, and has an authorised product in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q422806\">Wikidata Q422806</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Bupivacaine\">Bupivacaine</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Bupivacaine;
