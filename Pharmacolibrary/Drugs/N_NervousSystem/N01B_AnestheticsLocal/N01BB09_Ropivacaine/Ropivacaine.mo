  annotation (Documentation(info = "<html><body><p>The default model of ropivacaine: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N01B_AnestheticsLocal.N01BB09_Ropivacaine.Ropivacaine_Matsota2024_arterial\">Ropivacaine_Matsota2024_arterial</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of ropivacaine in this package:</p><ul><li><code>Ropivacaine_Matsota2024_arterial</code></li></ul><h4>About ropivacaine</h4><p>Ropivacaine is a local anesthetic of the amide type used to numb an area of the body during procedures. It is an approved medicine and is widely used in clinical practice for regional anesthesia.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q279504\">Wikidata Q279504</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Ropivacaine\">Ropivacaine</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 259200, Tolerance = 1e-9, Interval = 1));
end Ropivacaine;
