  extends Levobupivacaine_Araneda2025_reference;
  annotation (Documentation(info = "<html><body><p>The default model of levobupivacaine: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N01B_AnestheticsLocal.N01BB10_Levobupivacaine.Levobupivacaine_Araneda2025_reference\">Levobupivacaine_Araneda2025_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of levobupivacaine in this package:</p><ul><li><code>Levobupivacaine_Araneda2025_reference</code></li><li><code>Levobupivacaine_Storgaard2024_PD_wdt</code></li></ul><h4>About levobupivacaine</h4><p>Levobupivacaine is a local anesthetic used to relieve pain. It is an approved amide-type local anesthetic, though some uses remain investigational.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3272027\">Wikidata Q3272027</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Levobupivacaine\">Levobupivacaine</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Levobupivacaine;
