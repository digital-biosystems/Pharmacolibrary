within Pharmacolibrary.Drugs.N_NervousSystem.N02B_OtherAnalgesicsAndAntipyretics.N02BE01_Paracetamol;
model Paracetamol "Paracetamol — default model: Paracetamol_Fritz1984_reference"
  extends Paracetamol_Fritz1984_reference;
  annotation (Documentation(info = "<html><body><p>The default model of paracetamol: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N02B_OtherAnalgesicsAndAntipyretics.N02BE01_Paracetamol.Paracetamol_Fritz1984_reference\">Paracetamol_Fritz1984_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of paracetamol in this package:</p><ul><li><code>Paracetamol_Fritz1984_reference</code></li></ul><h4>About paracetamol</h4><p>Paracetamol is a pain-relieving and fever-lowering medicine used to treat pain, fever, and related conditions such as colds and flu. It is very widely used worldwide, appears on the WHO essential medicines list, and is available over the counter in the UK and approved by the FDA.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q57055\">Wikidata Q57055</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Paracetamol\">Paracetamol</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Paracetamol;
