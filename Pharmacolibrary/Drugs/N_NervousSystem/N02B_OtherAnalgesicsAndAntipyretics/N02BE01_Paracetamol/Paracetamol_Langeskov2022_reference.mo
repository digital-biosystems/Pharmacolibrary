  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>paracetamol</td></tr><tr><td>ATC code:</td><td>N02BE01</td></tr><tr><td>model:</td><td>two compartments, oral dosing <small>(PK_2C_enteral)</small></td></tr><tr><td>source:</td><td>Langeskov EK et al. 2022</td></tr><tr><td>population:</td><td>healthy obese adults</td></tr><tr><td>measured compound:</td><td>paracetamol</td></tr><tr><td>review:</td><td>accepted with caveats</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_paracetamol/Paracetamol_Langeskov2022_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>ka (h−1) (Placebo)</td><td>5.72</td><td>h−1</td><td><small>kabs</small></td></tr><tr><td>V1/F (L)</td><td>48.5</td><td>L</td><td><small>V1/F</small></td></tr><tr><td>Cl/F (L/h)</td><td>25.9</td><td>L/h</td><td><small>CL/F</small></td></tr><tr><td>V2/F (L)</td><td>55.4</td><td>L</td><td><small>V2/F</small></td></tr><tr><td>Cl2/F (L/h)</td><td>199</td><td>L/h</td><td><small>Q/F</small></td></tr><tr><td>Tlag (h)</td><td>0.16</td><td>h</td><td><small>tlag</small></td></tr><tr><td>ktr (h−1) (Placebo)</td><td>7.28</td><td>h−1</td><td><small>ktr</small></td></tr><tr><td>Cl2/F (L/h) a</td><td>873</td><td>L/h</td><td><small>Q2/F</small></td></tr><tr><td>Θkacovariate</td><td>0.829</td><td></td><td><small>equation variable</small></td></tr><tr><td>Θktrcovariate</td><td>0.791</td><td></td><td><small>equation variable</small></td></tr></table><h4>About paracetamol</h4><p>Paracetamol is a pain-relieving and fever-lowering medicine used to treat pain, fever, and related conditions such as colds and flu. It is very widely used worldwide, appears on the WHO essential medicines list, and is available over the counter in the UK and approved by the FDA.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q57055\">Wikidata Q57055</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Paracetamol\">Paracetamol</a>.</p><h4>References</h4><ol><li><p>Langeskov EK et al. (2022). Population pharmacokinetic of paracetamol and atorvastatin with co-administration of semaglutide. <i>Pharmacology research &amp; perspectives 10(4):e00962</i>. DOI:<a href=\"https://doi.org/10.1002/prp2.962\">10.1002/prp2.962</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/35799471\">35799471</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Langeskov_2022: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: accepted with caveats</li></ul></body></html>"),
