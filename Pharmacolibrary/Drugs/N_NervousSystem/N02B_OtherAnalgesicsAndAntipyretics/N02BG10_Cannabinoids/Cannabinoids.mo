within Pharmacolibrary.Drugs.N_NervousSystem.N02B_OtherAnalgesicsAndAntipyretics.N02BG10_Cannabinoids;
model Cannabinoids "Cannabinoids — default model: Cannabinoids_chov2025_s_hhc_population_pk_model"
  extends Cannabinoids_chov2025_s_hhc_population_pk_model;
  annotation (Documentation(info = "<html><body><p>The default model of cannabinoids: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N02B_OtherAnalgesicsAndAntipyretics.N02BG10_Cannabinoids.Cannabinoids_chov2025_s_hhc_population_pk_model\">Cannabinoids_chov2025_s_hhc_population_pk_model</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of cannabinoids in this package:</p><ul><li><code>Cannabinoids_chov2025_s_hhc_population_pk_model</code></li></ul><h4>About cannabinoids</h4><p>JWH-018 is a synthetic cannabinoid that was used recreationally as an ingredient in herbal smoking mixtures sold as legal alternatives to cannabis. It is no longer used because it was found to be harmful and was made a controlled substance in many countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q419020\">Wikidata Q419020</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Cannabinoids\">Cannabinoids</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Cannabinoids;
