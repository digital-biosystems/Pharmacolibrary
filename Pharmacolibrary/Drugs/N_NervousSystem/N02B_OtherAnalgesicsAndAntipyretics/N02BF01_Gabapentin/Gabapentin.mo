within Pharmacolibrary.Drugs.N_NervousSystem.N02B_OtherAnalgesicsAndAntipyretics.N02BF01_Gabapentin;
model Gabapentin "Gabapentin — default model: Gabapentin_AlZubaydi2024_reference"
  extends Gabapentin_AlZubaydi2024_reference;
  annotation (Documentation(info = "<html><body><p>The default model of gabapentin: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N02B_OtherAnalgesicsAndAntipyretics.N02BF01_Gabapentin.Gabapentin_AlZubaydi2024_reference\">Gabapentin_AlZubaydi2024_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of gabapentin in this package:</p><ul><li><code>Gabapentin_AlZubaydi2024_reference</code></li><li><code>Gabapentin_Siao2010_reference</code></li></ul><h4>About gabapentin</h4><p>Gabapentin is an anticonvulsant and pain-relieving medicine used for epilepsy and various types of pain and neurological conditions, such as neuropathy, restless legs syndrome, and fibromyalgia. It is an approved medicine in widespread clinical use, and has also been studied for other conditions.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q410352\">Wikidata Q410352</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Gabapentin\">Gabapentin</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 111600, Tolerance = 1e-9, Interval = 1));
end Gabapentin;
