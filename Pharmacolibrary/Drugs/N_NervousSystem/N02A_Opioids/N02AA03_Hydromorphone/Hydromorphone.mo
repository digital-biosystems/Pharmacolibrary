within Pharmacolibrary.Drugs.N_NervousSystem.N02A_Opioids.N02AA03_Hydromorphone;
model Hydromorphone "Hydromorphone — default model: Hydromorphone_Balyan2020_reference"
  extends Hydromorphone_Balyan2020_reference;
  annotation (Documentation(info = "<html><body><p>The default model of hydromorphone: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N02A_Opioids.N02AA03_Hydromorphone.Hydromorphone_Balyan2020_reference\">Hydromorphone_Balyan2020_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of hydromorphone in this package:</p><ul><li><code>Hydromorphone_Balyan2020_reference</code></li></ul><h4>About hydromorphone</h4><p>Hydromorphone is an opioid painkiller used to relieve pain, and has also been used for cough. It is an approved medicine used widely for pain relief, though as a controlled opioid its availability is restricted.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q303646\">Wikidata Q303646</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Hydromorphone\">Hydromorphone</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Hydromorphone;
