model Pethidine "Pethidine — default model: Pethidine_Chmelar1975_reference"
  extends Pethidine_Chmelar1975_reference;
  annotation (Documentation(info = "<html><body><p>The default model of pethidine: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N02A_Opioids.N02AB02_Pethidine.Pethidine_Chmelar1975_reference\">Pethidine_Chmelar1975_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of pethidine in this package:</p><ul><li><code>Pethidine_Chmelar1975_reference</code></li><li><code>Pethidine_Qiao1993_reference</code></li></ul><h4>About pethidine</h4><p>Pethidine is an opioid painkiller used to treat moderate to severe pain. It is an approved medicine, though as a narcotic opioid its use is controlled and often limited to hospital settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q55434\">Wikidata Q55434</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Pethidine\">Pethidine</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 7257600, Tolerance = 1e-9, Interval = 1));
end Pethidine;
