within Pharmacolibrary.Drugs.N_NervousSystem.N02A_Opioids.N02AF01_Butorphanol;
model Butorphanol "Butorphanol — default model: Butorphanol_Pypendop2021_reference"
  extends Butorphanol_Pypendop2021_reference;
  annotation (Documentation(info = "<html><body><p>The default model of butorphanol: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N02A_Opioids.N02AF01_Butorphanol.Butorphanol_Pypendop2021_reference\">Butorphanol_Pypendop2021_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of butorphanol in this package:</p><ul><li><code>Butorphanol_Pypendop2021_reference</code></li></ul><h4>About butorphanol</h4><p>Butorphanol is an opioid painkiller used to treat pain, including migraine, and can also act as a cough suppressant. It is an approved medicine in human and veterinary use, though not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1185089\">Wikidata Q1185089</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Butorphanol\">Butorphanol</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Butorphanol;
