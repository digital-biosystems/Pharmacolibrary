within Pharmacolibrary.Drugs.N_NervousSystem.N02A_Opioids.N02AA01_Morphine;
model Morphine "Morphine — default model: Morphine_Ihmsen2021_reference"
  extends Morphine_Ihmsen2021_reference;
  annotation (Documentation(info = "<html><body><p>The default model of morphine: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N02A_Opioids.N02AA01_Morphine.Morphine_Ihmsen2021_reference\">Morphine_Ihmsen2021_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of morphine in this package:</p><ul><li><code>Morphine_Bragg1995_reference</code></li><li><code>Morphine_Ihmsen2021_reference</code></li></ul><h4>About morphine</h4><p>Morphine is an opioid painkiller used to treat pain, and also dyspnea and fibromyalgia. It is widely used and appears on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q81225\">Wikidata Q81225</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Morphine\">Morphine</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Morphine;
