  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>morphine</td></tr><tr><td>ATC code:</td><td>N02AA01</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Bragg P et al. 1995</td></tr><tr><td>population:</td><td>neonatal dogs</td></tr><tr><td>measured compound:</td><td>morphine</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_morphine/Morphine_Bragg1995_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>Cl, ml·kg-1·min-1</td><td>80.4</td><td>ml·kg-1·min-1</td><td><small>CL</small></td></tr><tr><td>V1, ml/kg</td><td>243</td><td>ml/kg</td><td><small>V1</small></td></tr></table><h4>About morphine</h4><p>Morphine is an opioid painkiller used to treat pain, and also dyspnea and fibromyalgia. It is widely used and appears on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q81225\">Wikidata Q81225</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Morphine\">Morphine</a>.</p><h4>References</h4><ol><li><p>Bragg P et al. (1995). Opioid pharmacodynamics in neonatal dogs: differences between morphine and fentanyl. <i>Journal of applied physiology (Bethesda, Md. : 1985) 79(5):1519–1524</i>. DOI:<a href=\"https://doi.org/10.1152/jappl.1995.79.5.1519\">10.1152/jappl.1995.79.5.1519</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/8594008\">8594008</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Bragg_1995: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
