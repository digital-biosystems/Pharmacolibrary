  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>morphine</td></tr><tr><td>ATC code:</td><td>N02AA01</td></tr><tr><td>model:</td><td>parent and metabolites, formed from the central compartment <small>(PK_3M_9C)</small></td></tr><tr><td>source:</td><td>Ihmsen H et al. 2021</td></tr><tr><td>population:</td><td>adults undergoing cardiac surgery</td></tr><tr><td>measured compound:</td><td>morphine</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_morphine/Morphine_Ihmsen2021_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>CL (L/min)</td><td>1.35</td><td>L/min</td><td><small>CL</small></td></tr><tr><td>Q₂ (L/min)</td><td>1.16</td><td>L/min</td><td><small>Q</small></td></tr><tr><td>Q₃ (L/min)</td><td>1.71</td><td>L/min</td><td><small>Q3</small></td></tr><tr><td>V₁ (L)</td><td>8.1</td><td>L</td><td><small>V1</small></td></tr><tr><td>V₂ (L)</td><td>18.4</td><td>L</td><td><small>V2</small></td></tr><tr><td>V₃ (L)</td><td>165</td><td>L</td><td><small>V3</small></td></tr><tr><td>F_M <small>(morphine-6-glucuronide)</small></td><td>0.1</td><td></td><td><small>fm</small></td></tr><tr><td>K_M (1/min) <small>(morphine-6-glucuronide)</small></td><td>0.037</td><td>1/min</td><td><small>kfm</small></td></tr><tr><td>CL_M (L/min) <small>(morphine-6-glucuronide)</small></td><td>0.098</td><td>L/min</td><td><small>CL</small></td></tr><tr><td>Q_2M (L/min) <small>(morphine-6-glucuronide)</small></td><td>0.068</td><td>L/min</td><td><small>Q</small></td></tr><tr><td>V_1M (L) <small>(morphine-6-glucuronide)</small></td><td>5.5</td><td>L</td><td><small>V1</small></td></tr><tr><td>V_2M (L) <small>(morphine-6-glucuronide)</small></td><td>10.3</td><td>L</td><td><small>V2</small></td></tr></table><h4>About morphine</h4><p>Morphine is an opioid painkiller used to treat pain, and also dyspnea and fibromyalgia. It is widely used and appears on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q81225\">Wikidata Q81225</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Morphine\">Morphine</a>.</p><h4>References</h4><ol><li><p>Ihmsen H et al. (2021). Pharmacokinetics of Morphine and Morphine-6-Glucuronide During Postoperative Pain Therapy in Cardiac Surgery Patients. <i>European journal of drug metabolism and pharmacokinetics 46(2):249–263</i>. DOI:<a href=\"https://doi.org/10.1007/s13318-020-00663-z\">10.1007/s13318-020-00663-z</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/33547559\">33547559</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Ihmsen_2021: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
