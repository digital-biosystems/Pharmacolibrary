  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>piritramide</td></tr><tr><td>ATC code:</td><td>N02AC03</td></tr><tr><td>model:</td><td>two compartments, IV dosing <small>(PK_2C)</small></td></tr><tr><td>source:</td><td>Bouillon T et al. 2004</td></tr><tr><td>population:</td><td>intensive care patients</td></tr><tr><td>measured compound:</td><td>piritramide</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_piritramide/Piritramide_Bouillon2004_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>volumes of distribution V1</td><td>47.9</td><td>L</td><td><small>V1</small></td></tr><tr><td>V2</td><td>402</td><td>L</td><td><small>V2</small></td></tr><tr><td>V3</td><td>332</td><td>L</td><td><small>V3</small></td></tr><tr><td>clearances Cl1</td><td>66.5</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>Cl2</td><td>215</td><td>L/h</td><td><small>Q</small></td></tr><tr><td>steady-state volume of distribution</td><td>782</td><td>L</td><td><small>Vss</small></td></tr><tr><td>terminal elimination half-life</td><td>17.4</td><td>h</td><td><small>t1/2z</small></td></tr></table><h4>About piritramide</h4><p>Piritramide is a strong opioid painkiller used to treat moderate to severe pain, such as pain after surgery. It is not approved everywhere and has been withdrawn in some countries, but it remains in clinical use in parts of Europe, mainly in hospital settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q416439\">Wikidata Q416439</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Piritramide\">Piritramide</a>.</p><h4>References</h4><ol><li><p>Bouillon T et al. (2004). The pharmacokinetics of piritramide after prolonged administration to intensive care patients. <i>European journal of anaesthesiology 21(9):673–678</i>. DOI:<a href=\"https://doi.org/10.1017/s0265021504009019\">10.1017/s0265021504009019</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/15595577\">15595577</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Bouillon_2004: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
