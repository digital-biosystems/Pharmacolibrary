within Pharmacolibrary.Drugs.N_NervousSystem.N02A_Opioids.N02AC03_Piritramide;
model Piritramide "Piritramide — default model: Piritramide_Mller2006_reference"
  extends Piritramide_Mller2006_reference;
  annotation (Documentation(info = "<html><body><p>The default model of piritramide: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N02A_Opioids.N02AC03_Piritramide.Piritramide_Mller2006_reference\">Piritramide_Mller2006_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of piritramide in this package:</p><ul><li><code>Piritramide_Kietzmann1996_reference</code></li><li><code>Piritramide_Mller2006_reference</code></li></ul><h4>About piritramide</h4><p>Piritramide is a strong opioid painkiller used to treat moderate to severe pain, such as pain after surgery. It is not approved everywhere and has been withdrawn in some countries, but it remains in clinical use in parts of Europe, mainly in hospital settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q416439\">Wikidata Q416439</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Piritramide\">Piritramide</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 259200, Tolerance = 1e-9, Interval = 1));
end Piritramide;
