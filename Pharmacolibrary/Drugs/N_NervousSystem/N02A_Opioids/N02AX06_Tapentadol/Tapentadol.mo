within Pharmacolibrary.Drugs.N_NervousSystem.N02A_Opioids.N02AX06_Tapentadol;
model Tapentadol "Tapentadol — default model: Tapentadol_Watson2019_reference"
  extends Tapentadol_Watson2019_reference;
  annotation (Documentation(info = "<html><body><p>The default model of tapentadol: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N02A_Opioids.N02AX06_Tapentadol.Tapentadol_Watson2019_reference\">Tapentadol_Watson2019_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of tapentadol in this package:</p><ul><li><code>Tapentadol_Watson2019_reference</code></li></ul><h4>About tapentadol</h4><p>Tapentadol is an opioid painkiller used to treat moderate to severe pain, including pain associated with fibromyalgia. It is an approved medicine and is widely used as an analgesic, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q414463\">Wikidata Q414463</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Tapentadol\">Tapentadol</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Tapentadol;
