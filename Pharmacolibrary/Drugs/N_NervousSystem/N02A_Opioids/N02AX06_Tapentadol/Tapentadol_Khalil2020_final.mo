  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>tapentadol</td></tr><tr><td>ATC code:</td><td>N02AX06</td></tr><tr><td>model:</td><td>one compartment, oral dosing <small>(PK_1C_enteral)</small></td></tr><tr><td>source:</td><td>Khalil F et al. 2020</td></tr><tr><td>population:</td><td>children from birth to &lt;18 years old with acute pain</td></tr><tr><td>measured compound:</td><td>tapentadol</td></tr><tr><td>review:</td><td>accepted with caveats</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_tapentadol/Tapentadol_Khalil2020_final\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>CL (L/h)</td><td>45.9</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>V (L)</td><td>188</td><td>L</td><td><small>V</small></td></tr><tr><td>Ka (h−1)</td><td>1.64</td><td>h−1</td><td><small>kabs</small></td></tr><tr><td>F</td><td>0.195</td><td></td><td><small>Fab</small></td></tr><tr><td>TLAG (h)</td><td>0.257</td><td>h</td><td><small>tlag</small></td></tr><tr><td>k (wks −1)</td><td>0.013</td><td>1/week</td><td><small>kel</small></td></tr><tr><td>theta_q325_weight_power</td><td>1</td><td></td><td><small>equation variable</small></td></tr><tr><td>theta_q319_wt_power</td><td>0.42</td><td></td><td><small>equation variable</small></td></tr><tr><td>theta_q319_wt_power</td><td>0.68</td><td></td><td><small>equation variable</small></td></tr></table><h4>About tapentadol</h4><p>Tapentadol is an opioid painkiller used to treat moderate to severe pain, including pain associated with fibromyalgia. It is an approved medicine and is widely used as an analgesic, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q414463\">Wikidata Q414463</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Tapentadol\">Tapentadol</a>.</p><h4>References</h4><ol><li><p>Khalil F et al. (2020). Population Pharmacokinetics of Tapentadol in Children from Birth to &lt;18 Years Old. <i>Journal of pain research 13:3107–3123</i>. DOI:<a href=\"https://doi.org/10.2147/JPR.S269549\">10.2147/JPR.S269549</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/33262645\">33262645</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Khalil_2020: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: accepted with caveats</li></ul></body></html>"),
