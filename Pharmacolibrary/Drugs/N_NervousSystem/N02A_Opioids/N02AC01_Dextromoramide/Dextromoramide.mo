within Pharmacolibrary.Drugs.N_NervousSystem.N02A_Opioids.N02AC01_Dextromoramide;
model Dextromoramide "Dextromoramide — default model: Dextromoramide_Lanon1989_reference"
  extends Dextromoramide_Lanon1989_reference;
  annotation (Documentation(info = "<html><body><p>The default model of dextromoramide: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N02A_Opioids.N02AC01_Dextromoramide.Dextromoramide_Lanon1989_reference\">Dextromoramide_Lanon1989_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of dextromoramide in this package:</p><ul><li><code>Dextromoramide_Lanon1989_reference</code></li></ul><h4>About dextromoramide</h4><p>Dextromoramide is a narcotic opioid analgesic, classified among diphenylpropylamine derivatives, that has been used as a painkiller. It is not an approved medicine today; databases list it as experimental and illicit, so it appears to have no current authorised medical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q408446\">Wikidata Q408446</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Dextromoramide\">Dextromoramide</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Dextromoramide;
