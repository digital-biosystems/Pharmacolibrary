  extends Escitalopram_Friberg2006_reference;
  annotation (Documentation(info = "<html><body><p>The default model of escitalopram: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N06A_Antidepressants.N06AB10_Escitalopram.Escitalopram_Friberg2006_reference\">Escitalopram_Friberg2006_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of escitalopram in this package:</p><ul><li><code>Escitalopram_Friberg2006_reference</code></li></ul><h4>About escitalopram</h4><p>Escitalopram is an antidepressant of the SSRI class used for depression and anxiety-related conditions such as generalized anxiety disorder, obsessive-compulsive disorder, and post-traumatic stress disorder. It is an approved medicine, widely used in clinical practice, and carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q423757\">Wikidata Q423757</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Escitalopram\">Escitalopram</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 777600, Tolerance = 1e-9, Interval = 1));
end Escitalopram;
