within Pharmacolibrary.Drugs.N_NervousSystem.N06A_Antidepressants.N06AB08_Fluvoxamine;
model Fluvoxamine "Fluvoxamine — default model: Fluvoxamine_Strauss1999_reference"
  extends Fluvoxamine_Strauss1999_reference;
  annotation (Documentation(info = "<html><body><p>The default model of fluvoxamine: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N06A_Antidepressants.N06AB08_Fluvoxamine.Fluvoxamine_Strauss1999_reference\">Fluvoxamine_Strauss1999_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of fluvoxamine in this package:</p><ul><li><code>Fluvoxamine_Strauss1999_reference</code></li></ul><h4>About fluvoxamine</h4><p>Fluvoxamine is a selective serotonin reuptake inhibitor antidepressant used for depression, obsessive-compulsive disorder, anxiety disorders and panic disorder. It is an approved medicine used worldwide in everyday clinical practice, mainly for obsessive-compulsive disorder and depression.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q409236\">Wikidata Q409236</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Fluvoxamine\">Fluvoxamine</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 1036800, Tolerance = 1e-9, Interval = 1));
end Fluvoxamine;
