within Pharmacolibrary.Drugs.N_NervousSystem.N06A_Antidepressants.N06AG03_Toloxatone;
model Toloxatone "Toloxatone — default model: Toloxatone_Vistelle1992_reference"
  extends Toloxatone_Vistelle1992_reference;
  annotation (Documentation(info = "<html><body><p>The default model of toloxatone: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N06A_Antidepressants.N06AG03_Toloxatone.Toloxatone_Vistelle1992_reference\">Toloxatone_Vistelle1992_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of toloxatone in this package:</p><ul><li><code>Toloxatone_Vistelle1992_reference</code></li></ul><h4>About toloxatone</h4><p>Toloxatone is a monoamine oxidase A inhibitor that has been used as an antidepressant. It is currently listed only as an experimental drug, suggesting it is not an established marketed medicine today.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3530618\">Wikidata Q3530618</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Toloxatone\">Toloxatone</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Toloxatone;
