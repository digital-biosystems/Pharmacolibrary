within Pharmacolibrary.Drugs.N_NervousSystem.N06A_Antidepressants.N06AX05_Trazodone;
model Trazodone "Trazodone — default model: Trazodone_Knych2017_reference"
  extends Trazodone_Knych2017_reference;
  annotation (Documentation(info = "<html><body><p>The default model of trazodone: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N06A_Antidepressants.N06AX05_Trazodone.Trazodone_Knych2017_reference\">Trazodone_Knych2017_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of trazodone in this package:</p><ul><li><code>Trazodone_Knych2017_reference</code></li></ul><h4>About trazodone</h4><p>Trazodone is an antidepressant used for depression, and also for conditions such as anxiety, insomnia, sleep-wake disorders, delirium and neurotic disorders. It is an approved medicine in widespread clinical use, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q411457\">Wikidata Q411457</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Trazodone\">Trazodone</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 154800, Tolerance = 1e-9, Interval = 1));
end Trazodone;
