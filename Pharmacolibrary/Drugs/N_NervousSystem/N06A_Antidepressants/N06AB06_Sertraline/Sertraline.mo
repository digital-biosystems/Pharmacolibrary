within Pharmacolibrary.Drugs.N_NervousSystem.N06A_Antidepressants.N06AB06_Sertraline;
model Sertraline "Sertraline — default model: Sertraline_Xia2025_reference"
  extends Sertraline_Xia2025_reference;
  annotation (Documentation(info = "<html><body><p>The default model of sertraline: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N06A_Antidepressants.N06AB06_Sertraline.Sertraline_Xia2025_reference\">Sertraline_Xia2025_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of sertraline in this package:</p><ul><li><code>Sertraline_Castillo2024_reference</code></li><li><code>Sertraline_Xia2025_reference</code></li></ul><h4>About sertraline</h4><p>Sertraline is an antidepressant used for depression and several anxiety-related conditions, including obsessive-compulsive disorder, panic disorder, and post-traumatic stress disorder. It is an approved, widely used selective serotonin reuptake inhibitor.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q407617\">Wikidata Q407617</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Sertraline\">Sertraline</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 345600, Tolerance = 1e-9, Interval = 1));
end Sertraline;
