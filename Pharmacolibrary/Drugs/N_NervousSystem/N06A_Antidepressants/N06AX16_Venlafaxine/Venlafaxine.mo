within Pharmacolibrary.Drugs.N_NervousSystem.N06A_Antidepressants.N06AX16_Venlafaxine;
model Venlafaxine "Venlafaxine — default model: Venlafaxine_Wang2022_reference"
  extends Venlafaxine_Wang2022_reference;
  annotation (Documentation(info = "<html><body><p>The default model of venlafaxine: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N06A_Antidepressants.N06AX16_Venlafaxine.Venlafaxine_Wang2022_reference\">Venlafaxine_Wang2022_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of venlafaxine in this package:</p><ul><li><code>Venlafaxine_Wang2022_reference</code></li></ul><h4>About venlafaxine</h4><p>Venlafaxine is an antidepressant (a serotonin–norepinephrine reuptake inhibitor) used for depression and anxiety-related conditions such as generalized anxiety disorder, social anxiety disorder, and panic-type anxiety disorders. It is an approved prescription medicine that is widely used, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q898407\">Wikidata Q898407</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Venlafaxine\">Venlafaxine</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 154800, Tolerance = 1e-9, Interval = 1));
end Venlafaxine;
