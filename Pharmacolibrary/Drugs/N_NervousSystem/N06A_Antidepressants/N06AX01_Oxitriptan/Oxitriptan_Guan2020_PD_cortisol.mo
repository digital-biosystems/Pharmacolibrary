within Pharmacolibrary.Drugs.N_NervousSystem.N06A_Antidepressants.N06AX01_Oxitriptan;
model Oxitriptan_Guan2020_PD_cortisol
  "linear exposure-response sweep — Guan_2020 :: cortisol (serum cortisol)"
  extends Pharmacolibrary.Interfaces.PartialExposureResponseSweep(
    E0 = 8.86e-05,      // [kg/m3; ng/mL × 1e-06]
    Emax = 0, EC50 = 1,      // unused by a line
    exposure_per_s = 1);
  parameter Real slope = 0.072   "[1]";
equation
  response = E0 + slope*exposure;
  annotation(experiment(StartTime = 0, StopTime = 1000, Interval = 2),
    Documentation(info = "<html><body><h4>Oxitriptan_Guan2020_PD_cortisol</h4><p>The steady-state exposure-response curve of Guan Z et al., <i>Pharmacology research &amp; perspectives 8(2):e00574</i> 2020 (<a href=\"https://doi.org/10.1002/prp2.574\">doi:10.1002/prp2.574</a>) — serum cortisol [ng/mL] against 5-HTP — obtained by sweeping the driver instead of simulating a dose. Model family: linear.</p><h4>The parameters, in the paper's terms</h4><pre>  E0    =       88.6 ng/mL    drug-free response (baseline) (Baseline, Q324)
  slope =      0.072          change in response per unit of exposure (S 0, Q335)</pre><p>The algebra is <code>response = E0 + slope*exposure</code>; this model only supplies the numbers. The x axis is one  of 5-HTP per second of simulated time: there is no state, no dose and no kinetics — plot <code>response</code> against <code>exposure</code> (or <code>time</code>).</p><h4>What it reproduces</h4><pre>  exposure = 0         response 8.86e-05   (drug-free)</pre></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Guan_2020: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"));
end Oxitriptan_Guan2020_PD_cortisol;
