within Pharmacolibrary.Drugs.N_NervousSystem.N06A_Antidepressants.N06AX26_Vortioxetine;
model Vortioxetine_Wilson2015_PD_s1
  "linear exposure-response sweep — Wilson_2015 :: S1 (Sleep stage 1)"
  extends Pharmacolibrary.Interfaces.PartialExposureResponseSweep(
    E0 = 2520,      // [s; min × 60]
    Emax = 0, EC50 = 1,      // unused by a line
    exposure_per_s = 1e-06);
  parameter Real slope = 43200000   "[meter ** 3 * second / kilogram; min/ng/mL × 6e+07]";
equation
  response = E0 + slope*exposure;
  annotation(experiment(StartTime = 0, StopTime = 1000, Interval = 2),
    Documentation(info = "<html><body><h4>Vortioxetine_Wilson2015_PD_s1</h4><p>The steady-state exposure-response curve of Wilson S et al., <i>Journal of psychopharmacology (Oxford, England) 29(10):1085–1091</i> 2015 (<a href=\"https://doi.org/10.1177/0269881115599387\">doi:10.1177/0269881115599387</a>) — Sleep stage 1 [min] against vortioxetine ng/mL — obtained by sweeping the driver instead of simulating a dose. Model family: linear.</p><h4>The parameters, in the paper's terms</h4><pre>  E0    =         42 min      drug-free response (baseline) (E0, Q324)
  slope =       0.72 min/ng/mL change in response per unit of exposure (k, Q335)</pre><p>The algebra is <code>response = E0 + slope*exposure</code>; this model only supplies the numbers. The x axis is one ng/mL of vortioxetine per second of simulated time (exposure is in kg/m3): there is no state, no dose and no kinetics — plot <code>response</code> against <code>exposure</code> (or <code>time</code>).</p><h4>What it reproduces</h4><pre>  exposure = 0         response 2520   (drug-free)</pre></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Wilson_2015: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"));
end Vortioxetine_Wilson2015_PD_s1;
