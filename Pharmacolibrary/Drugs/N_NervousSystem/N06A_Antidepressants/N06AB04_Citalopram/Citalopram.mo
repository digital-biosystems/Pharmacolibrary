within Pharmacolibrary.Drugs.N_NervousSystem.N06A_Antidepressants.N06AB04_Citalopram;
model Citalopram "Citalopram — default model: Citalopram_Friberg2006_reference"
  extends Citalopram_Friberg2006_reference;
  annotation (Documentation(info = "<html><body><p>The default model of citalopram: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N06A_Antidepressants.N06AB04_Citalopram.Citalopram_Friberg2006_reference\">Citalopram_Friberg2006_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of citalopram in this package:</p><ul><li><code>Citalopram_Friberg2006_reference</code></li></ul><h4>About citalopram</h4><p>Citalopram is an antidepressant of the selective serotonin reuptake inhibitor class used to treat depression and related mental and mood disorders, as well as anxiety conditions such as generalized anxiety disorder and obsessive-compulsive disorder. It is an approved medicine in widespread clinical use, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q409672\">Wikidata Q409672</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Citalopram\">Citalopram</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 777600, Tolerance = 1e-9, Interval = 1));
end Citalopram;
