within Pharmacolibrary.Drugs.N_NervousSystem.N06A_Antidepressants.N06AX03_Mianserin;
model Mianserin "Mianserin — default model: Mianserin_Timmer1985_reference"
  extends Mianserin_Timmer1985_reference;
  annotation (Documentation(info = "<html><body><p>The default model of mianserin: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N06A_Antidepressants.N06AX03_Mianserin.Mianserin_Timmer1985_reference\">Mianserin_Timmer1985_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of mianserin in this package:</p><ul><li><code>Mianserin_Timmer1985_reference</code></li></ul><h4>About mianserin</h4><p>Mianserin is an antidepressant used to treat depression. It has been withdrawn in some markets but remains approved and used in others.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q416701\">Wikidata Q416701</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Mianserin\">Mianserin</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 604800, Tolerance = 1e-9, Interval = 1));
end Mianserin;
