within Pharmacolibrary.Drugs.N_NervousSystem.N05C_HypnoticsAndSedatives.N05CM18_Dexmedetomidine;
model Dexmedetomidine "Dexmedetomidine — default model: Dexmedetomidine_James2022_reference"
  extends Dexmedetomidine_James2022_reference;
  annotation (Documentation(info = "<html><body><p>The default model of dexmedetomidine: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N05C_HypnoticsAndSedatives.N05CM18_Dexmedetomidine.Dexmedetomidine_James2022_reference\">Dexmedetomidine_James2022_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of dexmedetomidine in this package:</p><ul><li><code>Dexmedetomidine_Ber2020_reference</code></li><li><code>Dexmedetomidine_James2022_reference</code></li></ul><h4>About dexmedetomidine</h4><p>Dexmedetomidine is a sedative drug used for conscious sedation, and has also been studied for pain and agitation in dementia. It is authorised in the European Union and also approved for veterinary use, with some investigational uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q412133\">Wikidata Q412133</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Dexmedetomidine\">Dexmedetomidine</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Dexmedetomidine;
