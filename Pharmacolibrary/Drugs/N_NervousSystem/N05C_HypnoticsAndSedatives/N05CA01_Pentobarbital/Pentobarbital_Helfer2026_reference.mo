  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>pentobarbital</td></tr><tr><td>ATC code:</td><td>N05CA01</td></tr><tr><td>model:</td><td>two compartments, IV dosing <small>(PK_2C)</small></td></tr><tr><td>source:</td><td>Helfer VE et al. 2026</td></tr><tr><td>population:</td><td>pediatric patients (birth to 21 years)</td></tr><tr><td>measured compound:</td><td>pentobarbital</td></tr><tr><td>review:</td><td>accepted with caveats</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_pentobarbital/Pentobarbital_Helfer2026_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>CL (L/h/70 kg)</td><td>5.13</td><td>L/h/70 kg</td><td><small>CL</small></td></tr><tr><td>V1 (L/70 kg)</td><td>35.43</td><td>L/70 kg</td><td><small>V1</small></td></tr><tr><td>Q (L/h/70 kg)</td><td>17.81</td><td>L/h/70 kg</td><td><small>Q</small></td></tr><tr><td>V2 (L/70 kg)</td><td>62.71</td><td>L/70 kg</td><td><small>V2</small></td></tr></table><h4>About pentobarbital</h4><p>Pentobarbital is a barbiturate sedative-hypnotic used as a hypnotic and sedative, and to treat status epilepticus. It remains an approved medicine and is also approved for veterinary use, though it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q409632\">Wikidata Q409632</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Pentobarbital\">Pentobarbital</a>.</p><h4>References</h4><ol><li><p>Helfer VE et al. (2026). Population Pharmacokinetics and Dosing Simulations of Pentobarbital in the Pediatric Population. <i>Journal of clinical pharmacology 66(5):e70204</i>. DOI:<a href=\"https://doi.org/10.1002/jcph.70204\">10.1002/jcph.70204</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/42087498\">42087498</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Helfer_2026: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: accepted with caveats</li></ul></body></html>"),
