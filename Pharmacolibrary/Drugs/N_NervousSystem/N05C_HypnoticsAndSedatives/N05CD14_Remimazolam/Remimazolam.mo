within Pharmacolibrary.Drugs.N_NervousSystem.N05C_HypnoticsAndSedatives.N05CD14_Remimazolam;
model Remimazolam "Remimazolam — default model: Remimazolam_Chen2025_base_model"
  extends Remimazolam_Chen2025_base_model;
  annotation (Documentation(info = "<html><body><p>The default model of remimazolam: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N05C_HypnoticsAndSedatives.N05CD14_Remimazolam.Remimazolam_Chen2025_base_model\">Remimazolam_Chen2025_base_model</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of remimazolam in this package:</p><ul><li><code>Remimazolam_Chen2025_base_model</code></li><li><code>Remimazolam_Chen2025_median_by_1_000_bootstraps</code></li><li><code>Remimazolam_Chen2024_PD_bis</code></li><li><code>Remimazolam_Chen2025v2_PD_bis</code></li></ul><h4>About remimazolam</h4><p>Remimazolam is a benzodiazepine sedative used to produce conscious sedation during medical procedures. It is approved and authorised in the European Union, though it remains a relatively new agent rather than a widely established one.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7311799\">Wikidata Q7311799</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Remimazolam\">Remimazolam</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Remimazolam;
