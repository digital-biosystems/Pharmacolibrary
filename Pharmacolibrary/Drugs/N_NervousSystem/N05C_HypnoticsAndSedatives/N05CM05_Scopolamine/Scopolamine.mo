within Pharmacolibrary.Drugs.N_NervousSystem.N05C_HypnoticsAndSedatives.N05CM05_Scopolamine;
model Scopolamine "Scopolamine — default model: Scopolamine_AlvarezJimenez2016_reference"
  extends Scopolamine_AlvarezJimenez2016_reference;
  annotation (Documentation(info = "<html><body><p>The default model of scopolamine: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N05C_HypnoticsAndSedatives.N05CM05_Scopolamine.Scopolamine_AlvarezJimenez2016_reference\">Scopolamine_AlvarezJimenez2016_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of scopolamine in this package:</p><ul><li><code>Scopolamine_AlvarezJimenez2016_reference</code></li><li><code>Scopolamine_Ebert2001_PD_eeg_alpha_power</code></li><li><code>Scopolamine_LiemMoolenaar2011_PD_adaptive_tracking</code></li><li><code>Scopolamine_LiemMoolenaar2011_PD_body_sway</code></li><li><code>Scopolamine_LiemMoolenaar2011_PD_finger_tapping</code></li><li><code>Scopolamine_LiemMoolenaar2011_PD_heart_rate</code></li><li><code>Scopolamine_LiemMoolenaar2011_PD_spv</code></li><li><code>Scopolamine_LiemMoolenaar2011_PD_smooth_pursuit</code></li><li><code>Scopolamine_LiemMoolenaar2011_PD_vas_alertness</code></li><li><code>Scopolamine_LiemMoolenaar2011_PD_vas_external_perception</code></li><li><code>Scopolamine_LiemMoolenaar2011_PD_vas_feeling_high</code></li><li><code>Scopolamine_LiemMoolenaar2011_PD_vas_internal_perception</code></li></ul><h4>About scopolamine</h4><p>Scopolamine is an anticholinergic used for conditions such as motion sickness, iridocyclitis, and other disorders listed in its treatment records. It remains an approved medicine and is included on the WHO essential medicines list, used in ophthalmic, antiemetic, and sedative roles.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q337188\">Wikidata Q337188</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Scopolamine\">Scopolamine</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Scopolamine;
