  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>melatonin</td></tr><tr><td>ATC code:</td><td>N05CH01</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Merchant NM et al. 2013</td></tr><tr><td>population:</td><td>preterm infants</td></tr><tr><td>measured compound:</td><td>melatonin</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_melatonin/Melatonin_Merchant2013_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>median half-life</td><td>15.82</td><td>h</td><td><small>t1/2z</small></td></tr><tr><td>median maximum plasma concentration</td><td>203.3</td><td>pg ml(-1)</td><td><small>Cmax</small></td></tr><tr><td>clearance</td><td>0.045</td><td>l h(-1)</td><td><small>CL</small></td></tr><tr><td>volume of distribution</td><td>1.098</td><td>l</td><td><small>V</small></td></tr></table><h4>About melatonin</h4><p>Melatonin, a hormone made by the pineal gland, is used as a hypnotic for sleep problems such as jet lag, and in the EU also for sleep disorders in autism. It is widely used, with authorised products in the European Union, and is also available as a supplement and approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q180912\">Wikidata Q180912</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Melatonin\">Melatonin</a>.</p><h4>References</h4><ol><li><p>Merchant NM et al. (2013). Pharmacokinetics of melatonin in preterm infants. <i>British journal of clinical pharmacology 76(5):725–733</i>. DOI:<a href=\"https://doi.org/10.1111/bcp.12092\">10.1111/bcp.12092</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/23432339\">23432339</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Merchant_2013: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 345600, Tolerance = 1e-9, Interval = 1));
end Melatonin_Merchant2013_reference;
