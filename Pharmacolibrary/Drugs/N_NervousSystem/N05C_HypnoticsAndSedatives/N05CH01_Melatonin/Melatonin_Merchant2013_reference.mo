within Pharmacolibrary.Drugs.N_NervousSystem.N05C_HypnoticsAndSedatives.N05CH01_Melatonin;
model Melatonin_Merchant2013_reference
  parameter Real Cl_ref = 1.25e-08 "Cl [m3/s]";
  parameter Real Vd_ref = 0.001098 "Vd [m3]";
  extends Pharmacolibrary.Pharmacokinetic.Models.PK_1C(
