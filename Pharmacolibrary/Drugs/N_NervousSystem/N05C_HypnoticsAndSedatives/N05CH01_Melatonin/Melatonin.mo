within Pharmacolibrary.Drugs.N_NervousSystem.N05C_HypnoticsAndSedatives.N05CH01_Melatonin;
model Melatonin "Melatonin — default model: Melatonin_Merchant2013_reference"
  extends Melatonin_Merchant2013_reference;
  annotation (Documentation(info = "<html><body><p>The default model of melatonin: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N05C_HypnoticsAndSedatives.N05CH01_Melatonin.Melatonin_Merchant2013_reference\">Melatonin_Merchant2013_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of melatonin in this package:</p><ul><li><code>Melatonin_Merchant2013_reference</code></li></ul><h4>About melatonin</h4><p>Melatonin, a hormone made by the pineal gland, is used as a hypnotic for sleep problems such as jet lag, and in the EU also for sleep disorders in autism. It is widely used, with authorised products in the European Union, and is also available as a supplement and approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q180912\">Wikidata Q180912</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Melatonin\">Melatonin</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 345600, Tolerance = 1e-9, Interval = 1));
end Melatonin;
