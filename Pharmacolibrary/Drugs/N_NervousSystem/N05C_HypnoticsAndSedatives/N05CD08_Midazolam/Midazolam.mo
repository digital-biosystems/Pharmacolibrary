within Pharmacolibrary.Drugs.N_NervousSystem.N05C_HypnoticsAndSedatives.N05CD08_Midazolam;
model Midazolam "Midazolam — default model: Midazolam_McCann2025_reference"
  extends Midazolam_McCann2025_reference;
  annotation (Documentation(info = "<html><body><p>The default model of midazolam: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N05C_HypnoticsAndSedatives.N05CD08_Midazolam.Midazolam_McCann2025_reference\">Midazolam_McCann2025_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of midazolam in this package:</p><ul><li><code>Midazolam_Burtin1994_mean_estimate_se_index_data_set</code></li><li><code>Midazolam_Maitre1991_reference</code></li><li><code>Midazolam_McCann2025_reference</code></li><li><code>Midazolam_Bardol2025_PD_comfort_b</code></li><li><code>Midazolam_Breimer1991_PD_tnw_12_30</code></li><li><code>Midazolam_HoyoVadillo1995_PD_eeg_effect</code></li><li><code>Midazolam_Lu1994_PD_tnw12_30</code></li></ul><h4>About midazolam</h4><p>Midazolam is a benzodiazepine sedative used for conscious sedation, anesthesia, and to treat severe seizures such as status epilepticus. It is an authorised medicine in the European Union and is included on the WHO essential medicines list, so it is widely used.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q423071\">Wikidata Q423071</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Midazolam\">Midazolam</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Midazolam;
