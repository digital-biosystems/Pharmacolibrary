  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>sulpiride</td></tr><tr><td>ATC code:</td><td>N05AL01</td></tr><tr><td>model:</td><td>one compartment, oral dosing <small>(PK_1C_enteral)</small></td></tr><tr><td>source:</td><td>Bressolle F et al. 1984</td></tr><tr><td>population:</td><td>healthy male subjects</td></tr><tr><td>measured compound:</td><td>sulpiride</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_sulpiride/Sulpiride_Bressolle1984_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>initial volume of distribution</td><td>0.145</td><td>L/kg</td><td><small>V</small></td></tr><tr><td>steady-state volume of distribution</td><td>0.639</td><td>L/kg</td><td><small>Vss</small></td></tr><tr><td>total clearance</td><td>89.8</td><td>mL/min</td><td><small>CL</small></td></tr><tr><td>renal clearance</td><td>83.0</td><td>mL/min</td><td><small>CLR</small></td></tr><tr><td>f</td><td>0.15</td><td></td><td><small>Fab</small></td></tr><tr><td>administered dose recovered unchanged in urine</td><td>93.1</td><td>%</td><td><small>fe</small></td></tr><tr><td>Ka1,sul</td><td>1.66</td><td>h−1</td><td><small>kabs</small></td></tr><tr><td>Tlag</td><td>1.5</td><td>h</td><td><small>tlag</small></td></tr></table><h4>About sulpiride</h4><p>Sulpiride is an antipsychotic medicine used to treat psychotic disorders such as schizophrenia. It is approved in some countries and used mainly in Europe and Asia, but it is not available everywhere, as some markets have withdrawn it.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q422418\">Wikidata Q422418</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Sulpiride\">Sulpiride</a>.</p><h4>References</h4><ol><li><p>Bressolle F et al. (1984). Sulpiride pharmacokinetics in humans after intramuscular administration at three dose levels. <i>Journal of pharmaceutical sciences 73(8):1128–1136</i>. DOI:<a href=\"https://doi.org/10.1002/jps.2600730826\">10.1002/jps.2600730826</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/6491918\">6491918</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Bressolle_1984: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
