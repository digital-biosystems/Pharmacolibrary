within Pharmacolibrary.Drugs.N_NervousSystem.N05A_Antipsychotics.N05AL01_Sulpiride;
model Sulpiride "Sulpiride — default model: Sulpiride_Bressolle1984_reference"
  extends Sulpiride_Bressolle1984_reference;
  annotation (Documentation(info = "<html><body><p>The default model of sulpiride: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N05A_Antipsychotics.N05AL01_Sulpiride.Sulpiride_Bressolle1984_reference\">Sulpiride_Bressolle1984_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of sulpiride in this package:</p><ul><li><code>Sulpiride_Bressolle1984_reference</code></li></ul><h4>About sulpiride</h4><p>Sulpiride is an antipsychotic medicine used to treat psychotic disorders such as schizophrenia. It is approved in some countries and used mainly in Europe and Asia, but it is not available everywhere, as some markets have withdrawn it.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q422418\">Wikidata Q422418</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Sulpiride\">Sulpiride</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Sulpiride;
