  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>haloperidol</td></tr><tr><td>ATC code:</td><td>N05AD01</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Franken LG et al. 2017</td></tr><tr><td>population:</td><td>terminally ill adult patients</td></tr><tr><td>measured compound:</td><td>haloperidol</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_haloperidol/Haloperidol_Franken2017_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>F</td><td>0.861</td><td></td><td><small>Fab</small></td></tr><tr><td>CL (L/h)</td><td>29.3</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>Vd (L)</td><td>1260</td><td>L</td><td><small>V</small></td></tr></table><h4>About haloperidol</h4><p>Haloperidol is an antipsychotic used to treat conditions such as schizophrenia, psychosis, delirium, Tourette syndrome, and vomiting. It is widely used and appears on the WHO list of essential medicines, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q251347\">Wikidata Q251347</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Haloperidol\">Haloperidol</a>.</p><h4>References</h4><ol><li><p>Franken LG et al. (2017). Population pharmacokinetics of haloperidol in terminally ill adult patients. <i>European journal of clinical pharmacology 73(10):1271–1277</i>. DOI:<a href=\"https://doi.org/10.1007/s00228-017-2283-6\">10.1007/s00228-017-2283-6</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/28681176\">28681176</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Franken_2017: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
