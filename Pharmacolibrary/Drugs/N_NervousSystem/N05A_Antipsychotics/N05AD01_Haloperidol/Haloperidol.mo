within Pharmacolibrary.Drugs.N_NervousSystem.N05A_Antipsychotics.N05AD01_Haloperidol;
model Haloperidol "Haloperidol — default model: Haloperidol_Li2022_reference"
  extends Haloperidol_Li2022_reference;
  annotation (Documentation(info = "<html><body><p>The default model of haloperidol: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N05A_Antipsychotics.N05AD01_Haloperidol.Haloperidol_Li2022_reference\">Haloperidol_Li2022_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of haloperidol in this package:</p><ul><li><code>Haloperidol_Li2022_reference</code></li></ul><h4>About haloperidol</h4><p>Haloperidol is an antipsychotic used to treat conditions such as schizophrenia, psychosis, delirium, Tourette syndrome, and vomiting. It is widely used and appears on the WHO list of essential medicines, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q251347\">Wikidata Q251347</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Haloperidol\">Haloperidol</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 518400, Tolerance = 1e-9, Interval = 1));
end Haloperidol;
