within Pharmacolibrary.Drugs.N_NervousSystem.N05A_Antipsychotics.N05AH03_Olanzapine;
model Olanzapine "Olanzapine — default model: Olanzapine_Zhang2024_reference"
  extends Olanzapine_Zhang2024_reference;
  annotation (Documentation(info = "<html><body><p>The default model of olanzapine: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N05A_Antipsychotics.N05AH03_Olanzapine.Olanzapine_Zhang2024_reference\">Olanzapine_Zhang2024_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of olanzapine in this package:</p><ul><li><code>Olanzapine_Zhang2024_reference</code></li><li><code>Olanzapine_Zang2024_reference</code></li></ul><h4>About olanzapine</h4><p>Olanzapine is an atypical antipsychotic used to treat schizophrenia, bipolar disorder including acute mania, and other psychotic disorders in adults. It is widely used and authorised in the European Union, where several products remain on the market.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q201872\">Wikidata Q201872</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Olanzapine\">Olanzapine</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 432000, Tolerance = 1e-9, Interval = 1));
end Olanzapine;
