  annotation (Documentation(info = "<html><body><p>The default model of amisulpride: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N05A_Antipsychotics.N05AL05_Amisulpride.Amisulpride_Liu2023_reference\">Amisulpride_Liu2023_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of amisulpride in this package:</p><ul><li><code>Amisulpride_Liu2023_reference</code></li><li><code>Amisulpride_Glatard2020_PD_prl</code></li></ul><h4>About amisulpride</h4><p>Amisulpride is an antipsychotic medicine used to treat schizophrenia. It is an approved drug and remains in clinical use, mainly in Europe.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q418785\">Wikidata Q418785</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Amisulpride\">Amisulpride</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 162000, Tolerance = 1e-9, Interval = 1));
