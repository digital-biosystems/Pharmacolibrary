within Pharmacolibrary.Drugs.N_NervousSystem.N05A_Antipsychotics.N05AH02_Clozapine;
model Clozapine "Clozapine — default model: Clozapine_Geers2022_reference"
  extends Clozapine_Geers2022_reference;
  annotation (Documentation(info = "<html><body><p>The default model of clozapine: <a href=\"modelica://Pharmacolibrary.Drugs.N_NervousSystem.N05A_Antipsychotics.N05AH02_Clozapine.Clozapine_Geers2022_reference\">Clozapine_Geers2022_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of clozapine in this package:</p><ul><li><code>Clozapine_Geers2022_reference</code></li><li><code>Clozapine_Parker2001_PD_beta_amplitude</code></li><li><code>Clozapine_Parker2001_PD_theta_amplitude</code></li></ul><h4>About clozapine</h4><p>Clozapine is an atypical antipsychotic used mainly for schizophrenia, and also for other psychotic and mood disorders such as bipolar disorder and psychosis in Parkinson's disease. It is an approved medicine on the WHO essential medicines list, but carries a boxed warning, so its use is restricted and requires careful monitoring.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q221361\">Wikidata Q221361</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Clozapine\">Clozapine</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 140400, Tolerance = 1e-9, Interval = 1));
end Clozapine;
