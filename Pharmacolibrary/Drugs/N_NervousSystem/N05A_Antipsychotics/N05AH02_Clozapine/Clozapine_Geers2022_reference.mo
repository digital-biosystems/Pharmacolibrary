  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>clozapine</td></tr><tr><td>ATC code:</td><td>N05AH02</td></tr><tr><td>model:</td><td>one compartment, oral dosing <small>(PK_1C_enteral)</small></td></tr><tr><td>source:</td><td>Geers LM et al. 2022</td></tr><tr><td>population:</td><td>schizophrenia patients on clozapine</td></tr><tr><td>measured compound:</td><td>clozapine</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_clozapine/Clozapine_Geers2022_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>Kelm (h–1)</td><td>0.095</td><td>h–1</td><td><small>kel</small></td></tr><tr><td>Vd/F (L/kgLBMc)</td><td>9.6</td><td>L/kg</td><td><small>V/F</small></td></tr><tr><td>K a (h–1)</td><td>1.37</td><td>h–1</td><td><small>kabs</small></td></tr><tr><td>Tlag (h)</td><td>0</td><td>h</td><td><small>tlag</small></td></tr></table><h4>About clozapine</h4><p>Clozapine is an atypical antipsychotic used mainly for schizophrenia, and also for other psychotic and mood disorders such as bipolar disorder and psychosis in Parkinson's disease. It is an approved medicine on the WHO essential medicines list, but carries a boxed warning, so its use is restricted and requires careful monitoring.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q221361\">Wikidata Q221361</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Clozapine\">Clozapine</a>.</p><h4>References</h4><ol><li><p>Geers LM et al. (2022). Population pharmacokinetic model and limited sampling strategy for clozapine using plasma and dried blood spot samples. <i>Therapeutic advances in psychopharmacology 12:20451253211065857</i>. DOI:<a href=\"https://doi.org/10.1177/20451253211065857\">10.1177/20451253211065857</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/35518123\">35518123</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Geers_2022: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
