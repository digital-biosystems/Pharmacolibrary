within Pharmacolibrary.Drugs.H_SystemicHormonalPreparationsExclSexHormonesAndInsulins.H01B_PosteriorPituitaryLobeHormones.H01BB02_Oxytocin;
model Oxytocin "Oxytocin — default model: Oxytocin_De1995_reference"
  extends Oxytocin_De1995_reference;
  annotation (Documentation(info = "<html><body><p>The default model of oxytocin: <a href=\"modelica://Pharmacolibrary.Drugs.H_SystemicHormonalPreparationsExclSexHormonesAndInsulins.H01B_PosteriorPituitaryLobeHormones.H01BB02_Oxytocin.Oxytocin_De1995_reference\">Oxytocin_De1995_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of oxytocin in this package:</p><ul><li><code>Oxytocin_De1995_reference</code></li><li><code>Oxytocin_Monks2023_reference</code></li></ul><h4>About oxytocin</h4><p>Oxytocin is a peptide hormone used as a uterotonic drug to induce or support labour and manage bleeding after childbirth. It is widely used in human medicine, appears on the WHO essential medicines list, and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q169960\">Wikidata Q169960</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Oxytocin\">Oxytocin</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Oxytocin;
