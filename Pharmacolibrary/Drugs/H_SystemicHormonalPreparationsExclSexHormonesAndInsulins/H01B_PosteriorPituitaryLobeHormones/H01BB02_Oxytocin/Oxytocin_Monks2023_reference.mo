  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>oxytocin</td></tr><tr><td>ATC code:</td><td>H01BB02</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Monks DT et al. 2023</td></tr><tr><td>population:</td><td>women undergoing elective caesarean delivery</td></tr><tr><td>measured compound:</td><td>oxytocin</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_oxytocin/Oxytocin_Monks2023_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>volume of distribution</td><td>156.1</td><td>l</td><td><small>V</small></td></tr><tr><td>clearance</td><td>83</td><td>ml.s-1</td><td><small>CL</small></td></tr></table><h4>About oxytocin</h4><p>Oxytocin is a peptide hormone used as a uterotonic drug to induce or support labour and manage bleeding after childbirth. It is widely used in human medicine, appears on the WHO essential medicines list, and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q169960\">Wikidata Q169960</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Oxytocin\">Oxytocin</a>.</p><h4>References</h4><ol><li><p>Monks DT et al. (2023). A study of the pharmacokinetics and pharmacodynamics of oxytocin at elective caesarean delivery. <i>Anaesthesia 78(11):1347–1353</i>. DOI:<a href=\"https://doi.org/10.1111/anae.16109\">10.1111/anae.16109</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/37594215\">37594215</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Monks_2023: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Oxytocin_Monks2023_reference;
