within Pharmacolibrary.Drugs.H_SystemicHormonalPreparationsExclSexHormonesAndInsulins.H02A_CorticosteroidsForSystemicUsePlain.H02AB07_Prednisone;
model Prednisone "Prednisone — default model: Prednisone_Bouazza2025_reference"
  extends Prednisone_Bouazza2025_reference;
  annotation (Documentation(info = "<html><body><p>The default model of prednisone: <a href=\"modelica://Pharmacolibrary.Drugs.H_SystemicHormonalPreparationsExclSexHormonesAndInsulins.H02A_CorticosteroidsForSystemicUsePlain.H02AB07_Prednisone.Prednisone_Bouazza2025_reference\">Prednisone_Bouazza2025_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of prednisone in this package:</p><ul><li><code>Prednisone_Bouazza2025_reference</code></li></ul><h4>About prednisone</h4><p>Prednisone is a glucocorticoid used to treat many inflammatory, autoimmune, and allergic conditions, such as arthritis, ulcerative colitis, asthma-related inflammation, and certain cancers and blood disorders. It is widely used in human medicine and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q424972\">Wikidata Q424972</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Prednisone\">Prednisone</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Prednisone;
