within Pharmacolibrary.Drugs.H_SystemicHormonalPreparationsExclSexHormonesAndInsulins.H02A_CorticosteroidsForSystemicUsePlain.H02AB06_Prednisolone;
model Prednisolone "Prednisolone — default model: Prednisolone_Bouazza2025_reference"
  extends Prednisolone_Bouazza2025_reference;
  annotation (Documentation(info = "<html><body><p>The default model of prednisolone: <a href=\"modelica://Pharmacolibrary.Drugs.H_SystemicHormonalPreparationsExclSexHormonesAndInsulins.H02A_CorticosteroidsForSystemicUsePlain.H02AB06_Prednisolone.Prednisolone_Bouazza2025_reference\">Prednisolone_Bouazza2025_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of prednisolone in this package:</p><ul><li><code>Prednisolone_Bouazza2025_reference</code></li></ul><h4>About prednisolone</h4><p>Prednisolone is a glucocorticoid steroid used to treat inflammatory and autoimmune conditions such as ulcerative colitis, myasthenia gravis, nephrotic syndrome, and various eye, skin, and blood disorders. It is widely used in human medicine, appears on the WHO essential medicines list, and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q11426176\">Wikidata Q11426176</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Prednisolone\">Prednisolone</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Prednisolone;
