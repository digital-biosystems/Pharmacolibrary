  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>salbutamol</td></tr><tr><td>ATC code:</td><td>R03AC02</td></tr><tr><td>model:</td><td>one compartment, oral dosing <small>(PK_1C_enteral)</small></td></tr><tr><td>source:</td><td>Marques L et al. 2024</td></tr><tr><td>population:</td><td>virtual patients</td></tr><tr><td>measured compound:</td><td>salbutamol</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_salbutamol/Salbutamol_Marques2024_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>Fa (%)</td><td>87.7</td><td></td><td><small>Fab</small></td></tr><tr><td>Cmax (μg/mL)</td><td>0.00919</td><td>μg/mL</td><td><small>Cmax</small></td></tr><tr><td>Tmax (h)</td><td>1.28</td><td>h</td><td><small>tmax</small></td></tr><tr><td>AUCinf (ng·h/mL)</td><td>0.0553</td><td>ng·h/mL</td><td><small>AUC∞</small></td></tr><tr><td>Cl</td><td>43.8</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>Vd</td><td>195.75</td><td>L</td><td><small>V</small></td></tr><tr><td>Absorption constant gut (h −1 )</td><td>0.5</td><td>h −1</td><td><small>kabs</small></td></tr><tr><td>Absorption lag gut (h)</td><td>1.5</td><td>h</td><td><small>tlag</small></td></tr></table><h4>About salbutamol</h4><p>Salbutamol is a bronchodilator used to treat asthma, bronchospasm and other obstructive lung diseases. It is widely used worldwide, appears on the WHO list of essential medicines, and is available on prescription.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q410358\">Wikidata Q410358</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Salbutamol\">Salbutamol</a>.</p><h4>References</h4><ol><li><p>Marques L et al. (2024). Improving Individualized Salbutamol Treatment: A Population Pharmacokinetic Model for Oral Salbutamol in Virtual Patients. <i>Pharmaceutics 17(1)</i>. DOI:<a href=\"https://doi.org/10.3390/pharmaceutics17010039\">10.3390/pharmaceutics17010039</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/39861686\">39861686</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Marques_2024: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
