within Pharmacolibrary.Drugs.R_RespiratorySystem.R05D_CoughSuppressantsExclCombinationsWithExpectorant.R05DA03_Hydrocodone;
model Hydrocodone "Hydrocodone — default model: Hydrocodone_Melhem2013_reference"
  extends Hydrocodone_Melhem2013_reference;
  annotation (Documentation(info = "<html><body><p>The default model of hydrocodone: <a href=\"modelica://Pharmacolibrary.Drugs.R_RespiratorySystem.R05D_CoughSuppressantsExclCombinationsWithExpectorant.R05DA03_Hydrocodone.Hydrocodone_Melhem2013_reference\">Hydrocodone_Melhem2013_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of hydrocodone in this package:</p><ul><li><code>Hydrocodone_Melhem2013_reference</code></li></ul><h4>About hydrocodone</h4><p>Hydrocodone is an opioid used to treat pain and to suppress cough. It is an approved medicine, typically given in combination with non-opioid painkillers, and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q411441\">Wikidata Q411441</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Hydrocodone\">Hydrocodone</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 144000, Tolerance = 1e-9, Interval = 1));
end Hydrocodone;
