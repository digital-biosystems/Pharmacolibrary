  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>diphenhydramine</td></tr><tr><td>ATC code:</td><td>R06AA02</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Wasfi IA et al. 2003</td></tr><tr><td>population:</td><td>camels and horses</td></tr><tr><td>measured compound:</td><td>diphenhydramine</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_diphenhydramine/Diphenhydramine_Wasfi2003_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>terminal elimination half lives in camels</td><td>1.58</td><td>h</td><td><small>t1/2z</small></td></tr><tr><td>total body clearances in camels</td><td>1.42</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>total body clearances in horses</td><td>0.79</td><td>L/h</td><td><small>CLnorm</small></td></tr><tr><td>volumes of distribution at steady state in camels</td><td>2.38</td><td>L/kg</td><td><small>Vss</small></td></tr><tr><td>volumes of the central compartment in camels</td><td>1.58</td><td>L</td><td><small>V</small></td></tr></table><h4>About diphenhydramine</h4><p>Diphenhydramine is an antihistamine used for conditions such as urticaria, motion sickness, insomnia and anxiety, and also acts as a sedative, antiemetic and topical antipruritic. It is an approved medicine in widespread use, available both as a systemic antihistamine and in topical preparations for itching.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q413486\">Wikidata Q413486</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Diphenhydramine\">Diphenhydramine</a>.</p><h4>References</h4><ol><li><p>Wasfi IA et al. (2003). Comparative pharmacokinetics of diphenhydramine in camels and horses after intravenous administration. <i>Veterinary research communications 27(6):463–473</i>. DOI:<a href=\"https://doi.org/10.1023/a:1025789607863\">10.1023/a:1025789607863</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/14582745\">14582745</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Wasfi_2003: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
