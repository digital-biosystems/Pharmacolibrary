within Pharmacolibrary.Drugs.R_RespiratorySystem.R06A_AntihistaminesForSystemicUse.R06AA02_Diphenhydramine;
model Diphenhydramine "Diphenhydramine — default model: Diphenhydramine_Wasfi2003_reference"
  extends Diphenhydramine_Wasfi2003_reference;
  annotation (Documentation(info = "<html><body><p>The default model of diphenhydramine: <a href=\"modelica://Pharmacolibrary.Drugs.R_RespiratorySystem.R06A_AntihistaminesForSystemicUse.R06AA02_Diphenhydramine.Diphenhydramine_Wasfi2003_reference\">Diphenhydramine_Wasfi2003_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of diphenhydramine in this package:</p><ul><li><code>Diphenhydramine_Wasfi2003_reference</code></li></ul><h4>About diphenhydramine</h4><p>Diphenhydramine is an antihistamine used for conditions such as urticaria, motion sickness, insomnia and anxiety, and also acts as a sedative, antiemetic and topical antipruritic. It is an approved medicine in widespread use, available both as a systemic antihistamine and in topical preparations for itching.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q413486\">Wikidata Q413486</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Diphenhydramine\">Diphenhydramine</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Diphenhydramine;
