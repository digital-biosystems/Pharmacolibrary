  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>tripelennamine</td></tr><tr><td>ATC code:</td><td>R06AC04</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Wasfi IA et al. 2000</td></tr><tr><td>population:</td><td>horses and camels</td></tr><tr><td>measured compound:</td><td>tripelennamine</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_tripelennamine/Tripelennamine_Wasfi2000_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>terminal elimination half-lives (camels)</td><td>2.39</td><td>h</td><td><small>t1/2z</small></td></tr><tr><td>total body clearances (camels)</td><td>0.97</td><td>L/h/kg</td><td><small>CL</small></td></tr><tr><td>total body clearances (horses)</td><td>0.84</td><td>L/h/kg</td><td><small>CLb</small></td></tr><tr><td>volumes of distribution at steady state (camels)</td><td>2.87</td><td>L/kg</td><td><small>Vss</small></td></tr><tr><td>volumes of the central compartment of the two compartment pharmacokinetic model (camels)</td><td>1.75</td><td>L/kg</td><td><small>V</small></td></tr></table><h4>About tripelennamine</h4><p>Tripelennamine is an antihistamine used to treat allergic conditions such as urticaria. It is an approved drug, used both systemically for allergies and topically on the skin to relieve itching, and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q415203\">Wikidata Q415203</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Tripelennamine\">Tripelennamine</a>.</p><h4>References</h4><ol><li><p>Wasfi IA et al. (2000). Comparative disposition of tripelennamine in horses and camels after intravenous administration. <i>Journal of veterinary pharmacology and therapeutics 23(3):145–152</i>. DOI:<a href=\"https://doi.org/10.1046/j.1365-2885.2000.00261.x\">10.1046/j.1365-2885.2000.00261.x</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/11110101\">11110101</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Wasfi_2000: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
