within Pharmacolibrary.Drugs.R_RespiratorySystem.R06A_AntihistaminesForSystemicUse.R06AX28_Rupatadine;
model Rupatadine "Rupatadine — default model: Rupatadine_Santamara2017_base"
  extends Rupatadine_Santamara2017_base;
  annotation (Documentation(info = "<html><body><p>The default model of rupatadine: <a href=\"modelica://Pharmacolibrary.Drugs.R_RespiratorySystem.R06A_AntihistaminesForSystemicUse.R06AX28_Rupatadine.Rupatadine_Santamara2017_base\">Rupatadine_Santamara2017_base</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of rupatadine in this package:</p><ul><li><code>Rupatadine_Santamara2017_base</code></li></ul><h4>About rupatadine</h4><p>Rupatadine is an antihistamine used to relieve symptoms of allergic conditions such as allergic rhinitis and urticaria. It is approved and used in several countries, though it is not authorised by the European Medicines Agency.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q423450\">Wikidata Q423450</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Rupatadine\">Rupatadine</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Rupatadine;
