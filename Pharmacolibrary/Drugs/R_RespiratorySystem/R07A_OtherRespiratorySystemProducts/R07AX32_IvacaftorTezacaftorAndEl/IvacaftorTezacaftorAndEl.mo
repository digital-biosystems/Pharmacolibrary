  extends Elexacaftor_Truong2025_reference;
  annotation (Documentation(info = "<html><body><p>The default model of Elexacaftor: <a href=\"modelica://Pharmacolibrary.Drugs.R_RespiratorySystem.R07A_OtherRespiratorySystemProducts.R07AX32_IvacaftorTezacaftorAndEl.Elexacaftor_Truong2025_reference\">Elexacaftor_Truong2025_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of Elexacaftor in this package:</p><ul><li><code>Elexacaftor_Truong2025_reference</code></li></ul><h4>About Elexacaftor</h4><p>Elexacaftor is a respiratory medicine, classified under other respiratory system products. It is an approved medicine, though detailed information on where and how widely it is used is not available here.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q72184089\">Wikidata Q72184089</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Elexacaftor\">Elexacaftor</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 259200, Tolerance = 1e-9, Interval = 1));
end IvacaftorTezacaftorAndEl;
