within Pharmacolibrary.Drugs.R_RespiratorySystem.R03D_OtherSystemicDrugsForObstructiveAirwayDiseases.R03DA05_Aminophylline;
model Aminophylline "Aminophylline — default model: Aminophylline_Jameson1990_reference"
  extends Aminophylline_Jameson1990_reference;
  annotation (Documentation(info = "<html><body><p>The default model of aminophylline: <a href=\"modelica://Pharmacolibrary.Drugs.R_RespiratorySystem.R03D_OtherSystemicDrugsForObstructiveAirwayDiseases.R03DA05_Aminophylline.Aminophylline_Jameson1990_reference\">Aminophylline_Jameson1990_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of aminophylline in this package:</p><ul><li><code>Aminophylline_Jameson1990_reference</code></li></ul><h4>About aminophylline</h4><p>Aminophylline is a bronchodilator used to treat breathing problems such as asthma, pulmonary emphysema, and acute bronchitis, and it has also been used for bradycardia. It is an approved medicine, though not authorised in the European Union, and is now used less often than newer inhaled treatments, mainly in hospital settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q471763\">Wikidata Q471763</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Aminophylline\">Aminophylline</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 259200, Tolerance = 1e-9, Interval = 1));
end Aminophylline;
