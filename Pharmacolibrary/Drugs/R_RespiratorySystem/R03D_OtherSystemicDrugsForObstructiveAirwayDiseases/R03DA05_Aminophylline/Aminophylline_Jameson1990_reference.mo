  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>aminophylline</td></tr><tr><td>ATC code:</td><td>R03DA05</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Jameson JP et al. 1990</td></tr><tr><td>population:</td><td>healthy black Zimbabwean male adults</td></tr><tr><td>measured compound:</td><td>theophylline</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_aminophylline/Aminophylline_Jameson1990_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>mean half-life</td><td>10.1</td><td>h</td><td><small>t1/2z</small></td></tr><tr><td>volume of distribution</td><td>0.55</td><td>L/kg</td><td><small>V</small></td></tr><tr><td>mean clearance</td><td>0.62</td><td>ml/kg/min</td><td><small>CL</small></td></tr></table><h4>About aminophylline</h4><p>Aminophylline is a bronchodilator used to treat breathing problems such as asthma, pulmonary emphysema, and acute bronchitis, and it has also been used for bradycardia. It is an approved medicine, though not authorised in the European Union, and is now used less often than newer inhaled treatments, mainly in hospital settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q471763\">Wikidata Q471763</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Aminophylline\">Aminophylline</a>.</p><h4>References</h4><ol><li><p>Jameson JP et al. (1990). Theophylline pharmacokinetics in black Zimbabwean males. <i>Therapeutic drug monitoring 12(1):54–58</i>. DOI:<a href=\"https://doi.org/10.1097/00007691-199001000-00010\">10.1097/00007691-199001000-00010</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/2305422\">2305422</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Jameson_1990: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 259200, Tolerance = 1e-9, Interval = 1));
