  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>boric_acid</td></tr><tr><td>ATC code:</td><td>S02AA03</td></tr><tr><td>model:</td><td>two compartments, IV dosing <small>(PK_2C)</small></td></tr><tr><td>source:</td><td>Jansen JA et al. 1984</td></tr><tr><td>population:</td><td>healthy adult male volunteers</td></tr><tr><td>measured compound:</td><td>boric acid</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_boric_acid/BoricAcid_Jansen1984_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>120 h urinary excretion</td><td>98.7</td><td>% of dose</td><td><small>fe</small></td></tr><tr><td>Cltot</td><td>54.6</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>t1/2 beta</td><td>21.0</td><td>h</td><td><small>t1/2β</small></td></tr><tr><td>V1</td><td>0.251</td><td>l/kg</td><td><small>V1</small></td></tr><tr><td>V2</td><td>0.456</td><td>l/kg</td><td><small>V2</small></td></tr><tr><td>V3</td><td>0.34</td><td>l/kg</td><td><small>V3</small></td></tr><tr><td>Q 2 (mL/min)</td><td>66.6</td><td>mL/min</td><td><small>Q</small></td></tr></table><h4>About boric_acid</h4><p>Boric acid is an antiseptic used against infections, including ear infections. It remains in use as an approved medicine, mainly in ear-drop preparations for the ear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q72451064\">Wikidata Q72451064</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.BoricAcid\">BoricAcid</a>.</p><h4>References</h4><ol><li><p>Jansen JA et al. (1984). Boric acid single dose pharmacokinetics after intravenous administration to man. <i>Archives of toxicology 55(1):64–67</i>. DOI:<a href=\"https://doi.org/10.1007/BF00316588\">10.1007/BF00316588</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/6732506\">6732506</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Jansen_1984: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
