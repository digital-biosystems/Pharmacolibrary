within Pharmacolibrary.Drugs.S_SensoryOrgans.S02A_Antiinfectives.S02AA03_BoricAcid;
model BoricAcid "BoricAcid — default model: BoricAcid_Jansen1984_reference"
  extends BoricAcid_Jansen1984_reference;
  annotation (Documentation(info = "<html><body><p>The default model of boric acid: <a href=\"modelica://Pharmacolibrary.Drugs.S_SensoryOrgans.S02A_Antiinfectives.S02AA03_BoricAcid.BoricAcid_Jansen1984_reference\">BoricAcid_Jansen1984_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of boric acid in this package:</p><ul><li><code>BoricAcid_Jansen1984_reference</code></li></ul><h4>About boric acid</h4><p>Boric acid is an antiseptic used against infections, including ear infections. It remains in use as an approved medicine, mainly in ear-drop preparations for the ear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q72451064\">Wikidata Q72451064</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.BoricAcid\">BoricAcid</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 432000, Tolerance = 1e-9, Interval = 1));
end BoricAcid;
