  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>magnesium_sulfate</td></tr><tr><td>ATC code:</td><td>A06AD04</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Chuan FS et al. 2001</td></tr><tr><td>population:</td><td>patients with preeclampsia</td></tr><tr><td>measured compound:</td><td>magnesium</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_magnesium_sulfate/MagnesiumSulfate_Chuan2001_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>systemic clearance</td><td>4.28</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>volume of distribution</td><td>32.3</td><td>L</td><td><small>V</small></td></tr><tr><td>average half-life</td><td>5.2</td><td>hours</td><td><small>t1/2z</small></td></tr></table><h4>About magnesium_sulfate</h4><p>Magnesium sulfate is used as a laxative for constipation, as a magnesium supplement, and in electrolyte solutions; it also acts as an anticonvulsant, antiarrhythmic, analgesic, anesthetic, and tocolytic agent. It is widely used in human medicine and is also an approved veterinary drug, with some investigational uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q288266\">Wikidata Q288266</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.MagnesiumSulfate\">MagnesiumSulfate</a>.</p><h4>References</h4><ol><li><p>Chuan FS et al. (2001). Population pharmacokinetics of magnesium in preeclampsia. <i>American journal of obstetrics and gynecology 185(3):593–599</i>. DOI:<a href=\"https://doi.org/10.1067/mob.2001.116726\">10.1067/mob.2001.116726</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/11568783\">11568783</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Chuan_2001: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 93600, Tolerance = 1e-9, Interval = 1));
