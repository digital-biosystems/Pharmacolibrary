within Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A06A_DrugsForConstipation.A06AD04_MagnesiumSulfate;
model MagnesiumSulfate "MagnesiumSulfate — default model: MagnesiumSulfate_da2020_reference"
  extends MagnesiumSulfate_da2020_reference;
  annotation (Documentation(info = "<html><body><p>The default model of magnesium sulfate: <a href=\"modelica://Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A06A_DrugsForConstipation.A06AD04_MagnesiumSulfate.MagnesiumSulfate_da2020_reference\">MagnesiumSulfate_da2020_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of magnesium sulfate in this package:</p><ul><li><code>MagnesiumSulfate_da2020_reference</code></li></ul><h4>About magnesium sulfate</h4><p>Magnesium sulfate is used as a laxative for constipation, as a magnesium supplement, and in electrolyte solutions; it also acts as an anticonvulsant, antiarrhythmic, analgesic, anesthetic, and tocolytic agent. It is widely used in human medicine and is also an approved veterinary drug, with some investigational uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q288266\">Wikidata Q288266</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.MagnesiumSulfate\">MagnesiumSulfate</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 122400, Tolerance = 1e-9, Interval = 1));
end MagnesiumSulfate;
