  extends Linerixibat_ZamekGliszczynski2021_reference;
  annotation (Documentation(info = "<html><body><p>The default model of linerixibat: <a href=\"modelica://Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A05A_BileTherapy.A05AX08_Linerixibat.Linerixibat_ZamekGliszczynski2021_reference\">Linerixibat_ZamekGliszczynski2021_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of linerixibat in this package:</p><ul><li><code>Linerixibat_ZamekGliszczynski2021_reference</code></li><li><code>Linerixibat_Carreo2025_PD_c4</code></li></ul><h4>About linerixibat</h4><p>Linerixibat is an investigational bile acid inhibitor being studied for cholestatic itching associated with liver disease. It is not yet approved and remains under clinical investigation.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27256749\">Wikidata Q27256749</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Linerixibat\">Linerixibat</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Linerixibat;
