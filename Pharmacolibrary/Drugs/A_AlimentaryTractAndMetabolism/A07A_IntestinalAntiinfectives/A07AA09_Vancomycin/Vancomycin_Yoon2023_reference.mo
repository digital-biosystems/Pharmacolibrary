    k12 = 2.828151986183074e-05,
    k21 = 1.6342315369261478e-05
  );

  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>vancomycin</td></tr><tr><td>ATC code:</td><td>A07AA09</td></tr><tr><td>model:</td><td>two compartments, IV dosing <small>(PK_2C)</small></td></tr><tr><td>source:</td><td>Yoon S et al. 2023</td></tr><tr><td>population:</td><td>patients with infections (including children)</td></tr><tr><td>measured compound:</td><td>vancomycin</td></tr><tr><td>review:</td><td>accepted with caveats</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_vancomycin/Vancomycin_Yoon2023_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>θ CL (L/h)</td><td>4.32</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>θ V (L)</td><td>38.6</td><td>L</td><td><small>V</small></td></tr><tr><td>θ Q (L/h)</td><td>3.93</td><td>L/h</td><td><small>Q</small></td></tr><tr><td>θ V2 (L)</td><td>66.8</td><td>L</td><td><small>V2</small></td></tr><tr><td>λ</td><td>0.655</td><td>1/h</td><td><small>kel</small></td></tr><tr><td>θREN</td><td>-0.237</td><td></td><td><small>equation variable</small></td></tr><tr><td>θFEM</td><td>-0.199</td><td></td><td><small>equation variable</small></td></tr><tr><td>θDM</td><td>-0.151</td><td></td><td><small>equation variable</small></td></tr></table><h4>About vancomycin</h4><p>Vancomycin is a glycopeptide antibiotic used to treat serious bacterial infections, including staphylococcal infections, pneumonia, infective endocarditis, and pseudomembranous colitis. It is an approved medicine and appears on the WHO list of essential medicines, so it is widely used, typically in hospital settings for severe infections.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q424027\">Wikidata Q424027</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Vancomycin\">Vancomycin</a>.</p><h4>References</h4><ol><li><p>Yoon S et al. (2023). Model-informed precision dosing in vancomycin treatment. <i>Frontiers in pharmacology 14:1252757</i>. DOI:<a href=\"https://doi.org/10.3389/fphar.2023.1252757\">10.3389/fphar.2023.1252757</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/37876732\">37876732</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Yoon_2023: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: accepted with caveats</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 111600, Tolerance = 1e-9, Interval = 1));
end Vancomycin_Yoon2023_reference;
