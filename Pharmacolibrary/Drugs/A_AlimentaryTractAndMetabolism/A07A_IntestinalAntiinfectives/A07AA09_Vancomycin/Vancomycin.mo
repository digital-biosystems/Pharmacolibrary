within Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A07A_IntestinalAntiinfectives.A07AA09_Vancomycin;
model Vancomycin "Vancomycin — default model: Vancomycin_Goyal2022_population_typical_value"
  extends Vancomycin_Goyal2022_population_typical_value;
  annotation (Documentation(info = "<html><body><p>The default model of vancomycin: <a href=\"modelica://Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A07A_IntestinalAntiinfectives.A07AA09_Vancomycin.Vancomycin_Goyal2022_population_typical_value\">Vancomycin_Goyal2022_population_typical_value</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of vancomycin in this package:</p><ul><li><code>Vancomycin_Goyal2022_final_pk_model</code></li><li><code>Vancomycin_Goyal2022_population_typical_value</code></li></ul><h4>About vancomycin</h4><p>Vancomycin is a glycopeptide antibiotic used to treat serious bacterial infections, including staphylococcal infections, pneumonia, infective endocarditis, and pseudomembranous colitis. It is an approved medicine and appears on the WHO list of essential medicines, so it is widely used, typically in hospital settings for severe infections.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q424027\">Wikidata Q424027</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Vancomycin\">Vancomycin</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Vancomycin;
