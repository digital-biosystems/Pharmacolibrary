within Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A07A_IntestinalAntiinfectives.A07AA05_PolymyxinB;
model PolymyxinB_Li2023_reference
  parameter Real Cl_ref = 6.750000000000001e-07 "Cl [m3/s]";
  parameter Real Vd_ref = 0.02311 "Vd [m3]";
  extends Pharmacolibrary.Pharmacokinetic.Models.PK_1C(
