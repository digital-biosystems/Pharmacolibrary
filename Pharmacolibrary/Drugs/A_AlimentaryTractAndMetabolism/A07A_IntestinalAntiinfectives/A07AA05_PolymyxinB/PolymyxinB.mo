within Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A07A_IntestinalAntiinfectives.A07AA05_PolymyxinB;
model PolymyxinB "PolymyxinB — default model: PolymyxinB_Li2023_reference"
  extends PolymyxinB_Li2023_reference;
  annotation (Documentation(info = "<html><body><p>The default model of polymyxin B: <a href=\"modelica://Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A07A_IntestinalAntiinfectives.A07AA05_PolymyxinB.PolymyxinB_Li2023_reference\">PolymyxinB_Li2023_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of polymyxin B in this package:</p><ul><li><code>PolymyxinB_Li2023_reference</code></li><li><code>PolymyxinB_Manchandani2018_reference</code></li></ul><h4>About polymyxin B</h4><p>Polymyxin B is an antibiotic used to treat infections caused by susceptible bacteria such as Escherichia coli and Bacteroides, and is also applied as an intestinal antiinfective and in eye and ear preparations. It remains in use, with approved and veterinary-approved status, though it is not an EU-authorised product according to the available data.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1088175\">Wikidata Q1088175</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.PolymyxinB\">PolymyxinB</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 118800, Tolerance = 1e-9, Interval = 1));
end PolymyxinB;
