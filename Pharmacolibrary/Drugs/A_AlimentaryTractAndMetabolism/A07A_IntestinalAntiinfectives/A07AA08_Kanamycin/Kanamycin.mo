within Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A07A_IntestinalAntiinfectives.A07AA08_Kanamycin;
model Kanamycin "Kanamycin — default model: Kanamycin_Strydom2019v2_reference"
  extends Kanamycin_Strydom2019v2_reference;
  annotation (Documentation(info = "<html><body><p>The default model of kanamycin: <a href=\"modelica://Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A07A_IntestinalAntiinfectives.A07AA08_Kanamycin.Kanamycin_Strydom2019v2_reference\">Kanamycin_Strydom2019v2_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of kanamycin in this package:</p><ul><li><code>Kanamycin_Strydom2019v2_reference</code></li><li><code>Kanamycin_Chang2017v2_reference</code></li></ul><h4>About kanamycin</h4><p>Kanamycin is an antibiotic used to treat bacterial infections, including gram-negative infections, upper respiratory tract infections, hepatic coma, and tuberculosis. It remains in use, with approved and veterinary-approved status, and is also being investigated for additional uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q421951\">Wikidata Q421951</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Kanamycin\">Kanamycin</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Kanamycin;
