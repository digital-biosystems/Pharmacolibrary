within Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A12C_OtherMineralSupplements.A12CC30_MagnesiumDifferentSaltsI;
model MagnesiumDifferentSaltsI "MagnesiumDifferentSaltsI — default model: MagnesiumDifferentSaltsInCombination_Chuan2001_reference"
  extends MagnesiumDifferentSaltsInCombination_Chuan2001_reference;
  annotation (Documentation(info = "<html><body><p>The default model of magnesium (different salts in combination): <a href=\"modelica://Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A12C_OtherMineralSupplements.A12CC30_MagnesiumDifferentSaltsI.MagnesiumDifferentSaltsInCombination_Chuan2001_reference\">MagnesiumDifferentSaltsInCombination_Chuan2001_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of magnesium (different salts in combination) in this package:</p><ul><li><code>MagnesiumDifferentSaltsInCombination_Chuan2001_reference</code></li></ul><h4>About magnesium (different salts in combination)</h4><p>Magnesium salts in combination are used as mineral supplements to correct or prevent magnesium deficiency. They are classified under mineral supplements in the ATC system and are generally available as supplements.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 93600, Tolerance = 1e-9, Interval = 1));
end MagnesiumDifferentSaltsI;
