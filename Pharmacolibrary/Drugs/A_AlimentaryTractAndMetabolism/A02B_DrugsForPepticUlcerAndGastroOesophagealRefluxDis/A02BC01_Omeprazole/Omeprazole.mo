within Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A02B_DrugsForPepticUlcerAndGastroOesophagealRefluxDis.A02BC01_Omeprazole;
model Omeprazole "Omeprazole — default model: Omeprazole_Zhao2018_reference"
  extends Omeprazole_Zhao2018_reference;
  annotation (Documentation(info = "<html><body><p>The default model of omeprazole: <a href=\"modelica://Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A02B_DrugsForPepticUlcerAndGastroOesophagealRefluxDis.A02BC01_Omeprazole.Omeprazole_Zhao2018_reference\">Omeprazole_Zhao2018_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of omeprazole in this package:</p><ul><li><code>Omeprazole_Zhao2018_reference</code></li><li><code>Omeprazole_Kirchheiner2009_PD_ph</code></li><li><code>Omeprazole_Kirchheiner2009v2_PD_ph</code></li><li><code>Omeprazole_Zhao2018_reference_PGx_CYP2C19</code></li></ul><h4>About omeprazole</h4><p>Omeprazole is a proton-pump inhibitor used for acid-related stomach problems such as reflux disease, ulcers, gastritis, and Zollinger–Ellison syndrome. It is widely used, appears on the WHO essential medicines list, and is approved for both human and veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q422210\">Wikidata Q422210</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Omeprazole\">Omeprazole</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Omeprazole;
