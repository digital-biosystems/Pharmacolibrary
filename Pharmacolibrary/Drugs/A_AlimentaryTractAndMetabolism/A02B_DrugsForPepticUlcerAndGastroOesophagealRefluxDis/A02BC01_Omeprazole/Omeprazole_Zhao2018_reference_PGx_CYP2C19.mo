  extends Omeprazole_Zhao2018_reference(q1_m11 = q1_m11_by_phenotype[Integer(metabolizer)]);
  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>omeprazole</td></tr><tr><td>ATC code:</td><td>A02BC01</td></tr><tr><td>model:</td><td>Omeprazole_Zhao2018_reference <small>(Omeprazole_Zhao2018_reference)</small></td></tr><tr><td>source:</td><td>Zhao W et al. 2018</td></tr><tr><td>review:</td><td>PGx model of a reviewed PK model</td></tr></table><h4>About omeprazole</h4><p>Omeprazole is a proton-pump inhibitor used for acid-related stomach problems such as reflux disease, ulcers, gastritis, and Zollinger–Ellison syndrome. It is widely used, appears on the WHO essential medicines list, and is approved for both human and veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q422210\">Wikidata Q422210</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Omeprazole\">Omeprazole</a>.</p><h4>References</h4><ol><li><p>Zhao W et al. (2018). Developmental pharmacogenetics of CYP2C19 in neonates and young infants: omeprazole as a probe drug. <i>British journal of clinical pharmacology 84(5):997–1005</i>. DOI:<a href=\"https://doi.org/10.1111/bcp.13526\">10.1111/bcp.13526</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/29377228\">29377228</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Zhao_2018: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, PGx model of a reviewed PK model</li></ul></body></html>"));
end Omeprazole_Zhao2018_reference_PGx_CYP2C19;
