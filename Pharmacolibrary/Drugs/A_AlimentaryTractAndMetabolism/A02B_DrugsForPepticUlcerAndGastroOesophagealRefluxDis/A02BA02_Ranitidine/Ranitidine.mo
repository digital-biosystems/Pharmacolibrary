within Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A02B_DrugsForPepticUlcerAndGastroOesophagealRefluxDis.A02BA02_Ranitidine;
model Ranitidine "Ranitidine — default model: Ranitidine_Hawwa2013_reference"
  extends Ranitidine_Hawwa2013_reference;
  annotation (Documentation(info = "<html><body><p>The default model of ranitidine: <a href=\"modelica://Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A02B_DrugsForPepticUlcerAndGastroOesophagealRefluxDis.A02BA02_Ranitidine.Ranitidine_Hawwa2013_reference\">Ranitidine_Hawwa2013_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of ranitidine in this package:</p><ul><li><code>Ranitidine_Hawwa2013_reference</code></li></ul><h4>About ranitidine</h4><p>Ranitidine is an H2-receptor antagonist that was used to treat acid-related stomach problems such as peptic ulcers, gastritis, heartburn and reflux disease. It has been withdrawn from many markets after the drug was found to contain an impurity that may cause cancer, so it is no longer generally available.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q423037\">Wikidata Q423037</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Ranitidine\">Ranitidine</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 122400, Tolerance = 1e-9, Interval = 1));
end Ranitidine;
