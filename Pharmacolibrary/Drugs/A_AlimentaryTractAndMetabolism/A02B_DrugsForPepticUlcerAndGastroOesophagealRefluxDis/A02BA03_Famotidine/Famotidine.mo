within Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A02B_DrugsForPepticUlcerAndGastroOesophagealRefluxDis.A02BA03_Famotidine;
model Famotidine "Famotidine — default model: Famotidine_Maish1998_reference"
  extends Famotidine_Maish1998_reference;
  annotation (Documentation(info = "<html><body><p>The default model of famotidine: <a href=\"modelica://Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A02B_DrugsForPepticUlcerAndGastroOesophagealRefluxDis.A02BA03_Famotidine.Famotidine_Maish1998_reference\">Famotidine_Maish1998_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of famotidine in this package:</p><ul><li><code>Famotidine_Maish1998_reference</code></li></ul><h4>About famotidine</h4><p>Famotidine is an H2-receptor antagonist used for acid-related conditions such as gastroesophageal reflux disease, heartburn, stomach and duodenal ulcers, Zollinger–Ellison syndrome, and urticaria. It is an approved medicine, widely available over the counter and on prescription for these common digestive complaints.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q411159\">Wikidata Q411159</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Famotidine\">Famotidine</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Famotidine;
