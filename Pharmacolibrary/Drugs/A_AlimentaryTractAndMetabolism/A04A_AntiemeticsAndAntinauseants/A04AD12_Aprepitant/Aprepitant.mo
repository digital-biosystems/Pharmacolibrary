within Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A04A_AntiemeticsAndAntinauseants.A04AD12_Aprepitant;
model Aprepitant "Aprepitant — default model: Aprepitant_Nijstad2023_reference"
  extends Aprepitant_Nijstad2023_reference;
  annotation (Documentation(info = "<html><body><p>The default model of aprepitant: <a href=\"modelica://Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A04A_AntiemeticsAndAntinauseants.A04AD12_Aprepitant.Aprepitant_Nijstad2023_reference\">Aprepitant_Nijstad2023_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of aprepitant in this package:</p><ul><li><code>Aprepitant_Nijstad2023_reference</code></li></ul><h4>About aprepitant</h4><p>Aprepitant is an antiemetic (an NK1 receptor antagonist) used to prevent nausea and vomiting, including chemotherapy-induced and postoperative nausea and vomiting. It is authorised in the European Union and is widely used, mainly in cancer care to help control vomiting caused by treatment.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q621834\">Wikidata Q621834</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Aprepitant\">Aprepitant</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 259200, Tolerance = 1e-9, Interval = 1));
end Aprepitant;
