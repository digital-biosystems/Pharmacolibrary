within Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A11H_OtherPlainVitaminPreparations.A11HA07_Inositol;
model Inositol "Inositol — default model: Inositol_Phelps2016_reference"
  extends Inositol_Phelps2016_reference;
  annotation (Documentation(info = "<html><body><p>The default model of inositol: <a href=\"modelica://Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A11H_OtherPlainVitaminPreparations.A11HA07_Inositol.Inositol_Phelps2016_reference\">Inositol_Phelps2016_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of inositol in this package:</p><ul><li><code>Inositol_Phelps2016_reference</code></li></ul><h4>About inositol</h4><p>Inositol is a sugar-like compound once classed as a B vitamin and marketed as a vitamin preparation. It is no longer regarded as an essential vitamin and has been withdrawn as a drug, though it persists as a dietary supplement.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q407997\">Wikidata Q407997</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Inositol\">Inositol</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 115200, Tolerance = 1e-9, Interval = 1));
end Inositol;
