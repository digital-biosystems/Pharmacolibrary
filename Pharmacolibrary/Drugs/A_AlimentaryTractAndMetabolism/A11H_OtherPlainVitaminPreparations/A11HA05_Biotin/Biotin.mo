within Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A11H_OtherPlainVitaminPreparations.A11HA05_Biotin;
model Biotin "Biotin — default model: Biotin_Wang2001_reference"
  extends Biotin_Wang2001_reference;
  annotation (Documentation(info = "<html><body><p>The default model of biotin: <a href=\"modelica://Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A11H_OtherPlainVitaminPreparations.A11HA05_Biotin.Biotin_Wang2001_reference\">Biotin_Wang2001_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of biotin in this package:</p><ul><li><code>Biotin_Wang2001_reference</code></li></ul><h4>About biotin</h4><p>Biotin, a B vitamin, is used as a vitamin supplement and to treat inherited metabolic disorders. It is widely available as an approved supplement and is also being studied for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q181354\">Wikidata Q181354</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Biotin\">Biotin</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Biotin;
