within Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A10B_BloodGlucoseLoweringDrugsExclInsulins.A10BJ06_Semaglutide;
model Semaglutide "Semaglutide — default model: Semaglutide_Carlsson2018_base"
  extends Semaglutide_Carlsson2018_base;
  annotation (Documentation(info = "<html><body><p>The default model of semaglutide: <a href=\"modelica://Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A10B_BloodGlucoseLoweringDrugsExclInsulins.A10BJ06_Semaglutide.Semaglutide_Carlsson2018_base\">Semaglutide_Carlsson2018_base</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of semaglutide in this package:</p><ul><li><code>Semaglutide_Carlsson2018_base</code></li><li><code>Semaglutide_Carlsson2018_full</code></li><li><code>Semaglutide_Overgaard2019_estimate</code></li></ul><h4>About semaglutide</h4><p>Semaglutide is a GLP-1 analogue medicine used to treat type 2 diabetes and obesity or overweight. It is widely used and authorised in the European Union, with products also studied for fatty liver disease and related liver conditions.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27261089\">Wikidata Q27261089</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Semaglutide\">Semaglutide</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 3628800, Tolerance = 1e-9, Interval = 1));
end Semaglutide;
