within Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A10B_BloodGlucoseLoweringDrugsExclInsulins.A10BA02_Metformin;
model Metformin "Metformin — default model: Metformin_Matzuka2016_2_cpt_fast_slow"
  extends Metformin_Matzuka2016_2_cpt_fast_slow;
  annotation (Documentation(info = "<html><body><p>The default model of metformin: <a href=\"modelica://Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A10B_BloodGlucoseLoweringDrugsExclInsulins.A10BA02_Metformin.Metformin_Matzuka2016_2_cpt_fast_slow\">Metformin_Matzuka2016_2_cpt_fast_slow</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of metformin in this package:</p><ul><li><code>Metformin_Matzuka2016_2_cpt_fast_slow</code></li><li><code>Metformin_Nikolaidis2026_base</code></li><li><code>Metformin_Hong2008_PD_fla</code></li><li><code>Metformin_Stepensky2002_PD_r</code></li></ul><h4>About metformin</h4><p>Metformin is an anti-diabetic medicine used to treat diabetes and high blood sugar, including maturity-onset diabetes of the young type 2. It is widely used and appears on the WHO list of essential medicines, and is also available in many combination products with other oral glucose-lowering drugs.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q19484\">Wikidata Q19484</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Metformin\">Metformin</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 6048000, Tolerance = 1e-9, Interval = 1));
end Metformin;
