  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>metformin</td></tr><tr><td>ATC code:</td><td>A10BA02</td></tr><tr><td>model:</td><td>two compartments, oral dosing <small>(PK_2C_enteral)</small></td></tr><tr><td>source:</td><td>Matzuka B et al. 2016</td></tr><tr><td>population:</td><td>2-cpt fast/slow</td></tr><tr><td>measured compound:</td><td>metformin</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_metformin/Metformin_Matzuka2016_2_cpt_fast_slow\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>Cl (L h⁻¹)</td><td>37</td><td>L h⁻¹</td><td><small>CL</small></td></tr><tr><td>Q / F (L h⁻¹)</td><td>42.6</td><td>L h⁻¹</td><td><small>Q/F</small></td></tr><tr><td>V / F (L)</td><td>284</td><td>L</td><td><small>V/F</small></td></tr><tr><td>V2 / F (L)</td><td>8430</td><td>L</td><td><small>V2/F</small></td></tr><tr><td>ka (h⁻¹)</td><td>0.11</td><td>h⁻¹</td><td><small>kabs</small></td></tr><tr><td>ka2 (h⁻¹)</td><td>0.521</td><td>h⁻¹</td><td><small>λ1</small></td></tr><tr><td>t1/2 (elim) (h)</td><td>298</td><td>h</td><td><small>t1/2z</small></td></tr><tr><td>Loglike</td><td>50.56</td><td></td><td><small>equation variable</small></td></tr></table><h4>About metformin</h4><p>Metformin is an anti-diabetic medicine used to treat diabetes and high blood sugar, including maturity-onset diabetes of the young type 2. It is widely used and appears on the WHO list of essential medicines, and is also available in many combination products with other oral glucose-lowering drugs.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q19484\">Wikidata Q19484</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Metformin\">Metformin</a>.</p><h4>References</h4><ol><li><p>Matzuka B et al. (2016). Stochastic nonlinear mixed effects: a metformin case study. <i>Journal of pharmacokinetics and pharmacodynamics 43(1):85–98</i>. DOI:<a href=\"https://doi.org/10.1007/s10928-015-9456-7\">10.1007/s10928-015-9456-7</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/26585899\">26585899</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Matzuka_2016: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
