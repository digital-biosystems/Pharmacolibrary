within Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A10B_BloodGlucoseLoweringDrugsExclInsulins.A10BH07_Evogliptin;
model Evogliptin "Evogliptin — default model: Evogliptin_Kim2025_reference"
  extends Evogliptin_Kim2025_reference;
  annotation (Documentation(info = "<html><body><p>The default model of evogliptin: <a href=\"modelica://Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A10B_BloodGlucoseLoweringDrugsExclInsulins.A10BH07_Evogliptin.Evogliptin_Kim2025_reference\">Evogliptin_Kim2025_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of evogliptin in this package:</p><ul><li><code>Evogliptin_Kim2025_reference</code></li></ul><h4>About evogliptin</h4><p>Evogliptin is a DPP-4 inhibitor studied for lowering blood glucose in diabetes. It is considered investigational and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q25103700\">Wikidata Q25103700</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Evogliptin\">Evogliptin</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 518400, Tolerance = 1e-9, Interval = 1));
end Evogliptin;
