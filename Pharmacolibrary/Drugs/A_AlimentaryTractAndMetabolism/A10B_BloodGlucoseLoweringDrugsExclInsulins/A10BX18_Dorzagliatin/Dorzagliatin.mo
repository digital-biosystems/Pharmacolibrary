  extends Dorzagliatin_Wang2023_reference;
  annotation (Documentation(info = "<html><body><p>The default model of dorzagliatin: <a href=\"modelica://Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A10B_BloodGlucoseLoweringDrugsExclInsulins.A10BX18_Dorzagliatin.Dorzagliatin_Wang2023_reference\">Dorzagliatin_Wang2023_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of dorzagliatin in this package:</p><ul><li><code>Dorzagliatin_Wang2023_reference</code></li></ul><h4>About dorzagliatin</h4><p>Dorzagliatin is an investigational blood glucose-lowering drug studied for diabetes. It is not yet an approved medicine and has no marketing authorisation in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q76754209\">Wikidata Q76754209</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Dorzagliatin\">Dorzagliatin</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 100800, Tolerance = 1e-9, Interval = 1));
end Dorzagliatin;
