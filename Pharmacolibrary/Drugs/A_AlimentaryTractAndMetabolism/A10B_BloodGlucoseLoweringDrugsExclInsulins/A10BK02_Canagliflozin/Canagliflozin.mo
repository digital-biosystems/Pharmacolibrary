model Canagliflozin "Canagliflozin — default model: Canagliflozin_Yao2023_reference"
  extends Canagliflozin_Yao2023_reference;
  annotation (Documentation(info = "<html><body><p>The default model of canagliflozin: <a href=\"modelica://Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A10B_BloodGlucoseLoweringDrugsExclInsulins.A10BK02_Canagliflozin.Canagliflozin_Yao2023_reference\">Canagliflozin_Yao2023_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of canagliflozin in this package:</p><ul><li><code>Canagliflozin_Yao2023_reference</code></li></ul><h4>About canagliflozin</h4><p>Canagliflozin is an anti-diabetic medicine used to treat type 2 diabetes mellitus. It is an approved SGLT2 inhibitor and is authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5030940\">Wikidata Q5030940</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Canagliflozin\">Canagliflozin</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 90000, Tolerance = 1e-9, Interval = 1));
end Canagliflozin;
