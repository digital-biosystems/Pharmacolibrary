within Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A10B_BloodGlucoseLoweringDrugsExclInsulins.A10BJ02_Liraglutide;
model Liraglutide_Carlsson2021_reference
  parameter Real Cl_ref = 2.9722222222222224e-07 "Cl [m3/s]";
  parameter Real cov_sex_0 = 0 "sex covariate";
  parameter Real cov_age_1 = 0 "age covariate";
  parameter Real cov_age_2 = 0 "age covariate";
  parameter Real Vd_ref = 0.0131 "Vd [m3]";
  extends Pharmacolibrary.Pharmacokinetic.Models.PK_1C_enteral(
    weight = 70.0,
