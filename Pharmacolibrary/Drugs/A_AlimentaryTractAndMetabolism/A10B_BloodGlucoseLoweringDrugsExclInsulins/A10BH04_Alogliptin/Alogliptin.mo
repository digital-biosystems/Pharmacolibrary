within Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A10B_BloodGlucoseLoweringDrugsExclInsulins.A10BH04_Alogliptin;
model Alogliptin "Alogliptin — default model: Alogliptin_Dudkowski2017_final_parameter_estimate"
  extends Alogliptin_Dudkowski2017_final_parameter_estimate;
  annotation (Documentation(info = "<html><body><p>The default model of alogliptin: <a href=\"modelica://Pharmacolibrary.Drugs.A_AlimentaryTractAndMetabolism.A10B_BloodGlucoseLoweringDrugsExclInsulins.A10BH04_Alogliptin.Alogliptin_Dudkowski2017_final_parameter_estimate\">Alogliptin_Dudkowski2017_final_parameter_estimate</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of alogliptin in this package:</p><ul><li><code>Alogliptin_Dudkowski2017_final_parameter_estimate</code></li></ul><h4>About alogliptin</h4><p>Alogliptin is a DPP-4 inhibitor used to lower blood glucose in adults with type 2 diabetes. It is authorised in the European Union and used as an oral anti-diabetic medicine, including in fixed-dose combinations with other glucose-lowering drugs.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4734170\">Wikidata Q4734170</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Alogliptin\">Alogliptin</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 129600, Tolerance = 1e-9, Interval = 1));
end Alogliptin;
