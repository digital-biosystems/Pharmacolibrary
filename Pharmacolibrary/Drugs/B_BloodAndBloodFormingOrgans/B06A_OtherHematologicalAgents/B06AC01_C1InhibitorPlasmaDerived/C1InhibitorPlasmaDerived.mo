  extends C1InhibitorPlasmaDerived_Pawaskar2018_reference;
  annotation (Documentation(info = "<html><body><p>The default model of c1-inhibitor, plasma derived: <a href=\"modelica://Pharmacolibrary.Drugs.B_BloodAndBloodFormingOrgans.B06A_OtherHematologicalAgents.B06AC01_C1InhibitorPlasmaDerived.C1InhibitorPlasmaDerived_Pawaskar2018_reference\">C1InhibitorPlasmaDerived_Pawaskar2018_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of c1-inhibitor, plasma derived in this package:</p><ul><li><code>C1InhibitorPlasmaDerived_Pawaskar2018_reference</code></li></ul><h4>About c1-inhibitor, plasma derived</h4><p>Plasma-derived C1 inhibitor is used to treat hereditary angioedema. It is an approved medicine, with an authorised product in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q22075742\">Wikidata Q22075742</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.C1InhibitorPlasmaDerived\">C1InhibitorPlasmaDerived</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end C1InhibitorPlasmaDerived;
