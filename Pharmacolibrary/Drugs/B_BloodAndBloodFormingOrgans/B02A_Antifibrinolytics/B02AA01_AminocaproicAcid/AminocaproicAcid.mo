within Pharmacolibrary.Drugs.B_BloodAndBloodFormingOrgans.B02A_Antifibrinolytics.B02AA01_AminocaproicAcid;
model AminocaproicAcid "AminocaproicAcid — default model: AminocaproicAcid_Stricker2013_reference"
  extends AminocaproicAcid_Stricker2013_reference;
  annotation (Documentation(info = "<html><body><p>The default model of aminocaproic acid: <a href=\"modelica://Pharmacolibrary.Drugs.B_BloodAndBloodFormingOrgans.B02A_Antifibrinolytics.B02AA01_AminocaproicAcid.AminocaproicAcid_Stricker2013_reference\">AminocaproicAcid_Stricker2013_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of aminocaproic acid in this package:</p><ul><li><code>AminocaproicAcid_Stricker2013_reference</code></li></ul><h4>About aminocaproic acid</h4><p>Aminocaproic acid is an antifibrinolytic medicine used to treat or prevent bleeding. It is an approved drug, used mainly as a hemostatic agent to control excessive bleeding.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q255968\">Wikidata Q255968</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.AminocaproicAcid\">AminocaproicAcid</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end AminocaproicAcid;
