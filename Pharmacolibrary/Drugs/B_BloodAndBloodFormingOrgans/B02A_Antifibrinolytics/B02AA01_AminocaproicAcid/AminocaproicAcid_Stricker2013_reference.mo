  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>aminocaproic_acid</td></tr><tr><td>ATC code:</td><td>B02AA01</td></tr><tr><td>model:</td><td>two compartments, IV dosing <small>(PK_2C)</small></td></tr><tr><td>source:</td><td>Stricker PA et al. 2013</td></tr><tr><td>population:</td><td>infants undergoing craniofacial reconstruction surgery</td></tr><tr><td>measured compound:</td><td>epsilon-aminocaproic acid</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_aminocaproic_acid/AminocaproicAcid_Stricker2013_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>pre-/postoperative plasma drug clearance</td><td>32</td><td>ml min(-1)</td><td><small>CL</small></td></tr><tr><td>inter-compartmental clearance</td><td>42.4</td><td>ml min(-1)</td><td><small>Q</small></td></tr><tr><td>central volume of distribution</td><td>1.27</td><td>litre</td><td><small>V1</small></td></tr><tr><td>peripheral volume of distribution</td><td>2.53</td><td>litre</td><td><small>V2</small></td></tr></table><h4>About aminocaproic_acid</h4><p>Aminocaproic acid is an antifibrinolytic medicine used to treat or prevent bleeding. It is an approved drug, used mainly as a hemostatic agent to control excessive bleeding.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q255968\">Wikidata Q255968</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.AminocaproicAcid\">AminocaproicAcid</a>.</p><h4>References</h4><ol><li><p>Stricker PA et al. (2013). Population pharmacokinetics of epsilon-aminocaproic acid in infants undergoing craniofacial reconstruction surgery. <i>British journal of anaesthesia 110(5):788–799</i>. DOI:<a href=\"https://doi.org/10.1093/bja/aes507\">10.1093/bja/aes507</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/23353035\">23353035</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Stricker_2013: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
