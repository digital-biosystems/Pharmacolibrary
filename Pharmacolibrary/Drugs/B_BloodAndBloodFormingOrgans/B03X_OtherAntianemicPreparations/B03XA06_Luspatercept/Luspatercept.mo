within Pharmacolibrary.Drugs.B_BloodAndBloodFormingOrgans.B03X_OtherAntianemicPreparations.B03XA06_Luspatercept;
model Luspatercept "Luspatercept — default model: Luspatercept_Chen2020_reference"
  extends Luspatercept_Chen2020_reference;
  annotation (Documentation(info = "<html><body><p>The default model of luspatercept: <a href=\"modelica://Pharmacolibrary.Drugs.B_BloodAndBloodFormingOrgans.B03X_OtherAntianemicPreparations.B03XA06_Luspatercept.Luspatercept_Chen2020_reference\">Luspatercept_Chen2020_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of luspatercept in this package:</p><ul><li><code>Luspatercept_Chen2020_reference</code></li></ul><h4>About luspatercept</h4><p>Luspatercept is an antianemic medicine used to treat anemia in people with myelodysplastic syndromes or beta-thalassemia. It is authorised in the European Union and is also being studied for further uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q30314143\">Wikidata Q30314143</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Luspatercept\">Luspatercept</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 6652800, Tolerance = 1e-9, Interval = 1));
end Luspatercept;
