within Pharmacolibrary.Drugs.B_BloodAndBloodFormingOrgans.B03X_OtherAntianemicPreparations.B03XA02_DarbepoetinAlfa;
model DarbepoetinAlfa "DarbepoetinAlfa — default model: DarbepoetinAlfa_Kawakami2009_reference"
  extends DarbepoetinAlfa_Kawakami2009_reference;
  annotation (Documentation(info = "<html><body><p>The default model of darbepoetin alfa: <a href=\"modelica://Pharmacolibrary.Drugs.B_BloodAndBloodFormingOrgans.B03X_OtherAntianemicPreparations.B03XA02_DarbepoetinAlfa.DarbepoetinAlfa_Kawakami2009_reference\">DarbepoetinAlfa_Kawakami2009_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of darbepoetin alfa in this package:</p><ul><li><code>DarbepoetinAlfa_Doshi2010_reference</code></li><li><code>DarbepoetinAlfa_Kawakami2009_reference</code></li><li><code>DarbepoetinAlfa_Roberts2015_reference</code></li></ul><h4>About darbepoetin alfa</h4><p>Darbepoetin alfa is an antianemic medicine used to treat anemia, including anemia linked to chronic kidney failure and cancer treatment. It is an approved medicine authorised in the European Union, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2178381\">Wikidata Q2178381</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.DarbepoetinAlfa\">DarbepoetinAlfa</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end DarbepoetinAlfa;
