within Pharmacolibrary.Drugs.B_BloodAndBloodFormingOrgans.B01A_AntithromboticAgents.B01AE03_Argatroban;
model Argatroban "Argatroban — default model: Argatroban_Cox2004_reference"
  extends Argatroban_Cox2004_reference;
  annotation (Documentation(info = "<html><body><p>The default model of argatroban: <a href=\"modelica://Pharmacolibrary.Drugs.B_BloodAndBloodFormingOrgans.B01A_AntithromboticAgents.B01AE03_Argatroban.Argatroban_Cox2004_reference\">Argatroban_Cox2004_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of argatroban in this package:</p><ul><li><code>Argatroban_Cox2004_reference</code></li><li><code>Argatroban_Akimoto2011_PD_act</code></li><li><code>Argatroban_Akimoto2011_PD_eca_t</code></li><li><code>Argatroban_Akimoto2011_PD_pict</code></li><li><code>Argatroban_Akimoto2011_PD_aptt</code></li><li><code>Argatroban_Cox2004_PD_act</code></li></ul><h4>About argatroban</h4><p>Argatroban is a direct thrombin inhibitor used as an anticoagulant, mainly in patients who cannot receive heparin, such as those with heparin-induced thrombocytopenia. It is an approved anticoagulant that is used in clinical practice, though it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27074501\">Wikidata Q27074501</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Argatroban\">Argatroban</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Argatroban;
