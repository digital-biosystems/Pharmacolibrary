within Pharmacolibrary.Drugs.B_BloodAndBloodFormingOrgans.B01A_AntithromboticAgents.B01AB02_AntithrombinIii;
model AntithrombinIii_Kim2020_reference
  parameter Real Cl_ref = 3.5833333333333337e-08 "Cl [m3/s]";
  parameter Real Vd_ref = 0.00386 "Vd [m3]";
  extends Pharmacolibrary.Pharmacokinetic.Models.PK_1C(
    weight = 70.0,
    F = 1,
    Cl = Cl_ref,
    Vd = Vd_ref,
    adminDuration = 600,
    adminCount = 1,
    adminMass = 1e-05
  );

  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>antithrombin_iii</td></tr><tr><td>ATC code:</td><td>B01AB02</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Kim BR et al. 2020</td></tr><tr><td>population:</td><td>liver transplant recipients</td></tr><tr><td>measured compound:</td><td>antithrombin_iii</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_antithrombin_iii/AntithrombinIii_Kim2020_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>volume of distribution</td><td>3.86</td><td>L</td><td><small>V</small></td></tr><tr><td>clearance</td><td>0.129</td><td>L h-1</td><td><small>CL</small></td></tr></table><h4>About antithrombin_iii</h4><p>Antithrombin III is a blood protein used to treat or prevent excessive clotting, especially in people with antithrombin deficiency, and it works together with heparin. It is an approved medicine, given by infusion, mainly in hospital settings for clotting problems.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q24775482\">Wikidata Q24775482</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.AntithrombinIII\">AntithrombinIII</a>.</p><h4>References</h4><ol><li><p>Kim BR et al. (2020). Pharmacokinetics of human antithrombin III concentrate in the immediate postoperative period after liver transplantation. <i>British journal of clinical pharmacology 86(5):923–932</i>. DOI:<a href=\"https://doi.org/10.1111/bcp.14200\">10.1111/bcp.14200</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/31840271\">31840271</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Kim_2020: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 432000, Tolerance = 1e-9, Interval = 1));
end AntithrombinIii_Kim2020_reference;
