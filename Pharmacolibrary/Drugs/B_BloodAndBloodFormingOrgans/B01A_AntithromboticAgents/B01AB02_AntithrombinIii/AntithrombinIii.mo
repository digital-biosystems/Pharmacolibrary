within Pharmacolibrary.Drugs.B_BloodAndBloodFormingOrgans.B01A_AntithromboticAgents.B01AB02_AntithrombinIii;
model AntithrombinIii "AntithrombinIii — default model: AntithrombinIii_Kim2020_reference"
  extends AntithrombinIii_Kim2020_reference;
  annotation (Documentation(info = "<html><body><p>The default model of antithrombin III: <a href=\"modelica://Pharmacolibrary.Drugs.B_BloodAndBloodFormingOrgans.B01A_AntithromboticAgents.B01AB02_AntithrombinIii.AntithrombinIii_Kim2020_reference\">AntithrombinIii_Kim2020_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of antithrombin III in this package:</p><ul><li><code>AntithrombinIii_Kim2020_reference</code></li></ul><h4>About antithrombin III</h4><p>Antithrombin III is a blood protein used to treat or prevent excessive clotting, especially in people with antithrombin deficiency, and it works together with heparin. It is an approved medicine, given by infusion, mainly in hospital settings for clotting problems.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q24775482\">Wikidata Q24775482</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.AntithrombinIII\">AntithrombinIII</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 432000, Tolerance = 1e-9, Interval = 1));
end AntithrombinIii;
