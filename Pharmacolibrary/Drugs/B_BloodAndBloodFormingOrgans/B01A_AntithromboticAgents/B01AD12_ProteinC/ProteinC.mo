within Pharmacolibrary.Drugs.B_BloodAndBloodFormingOrgans.B01A_AntithromboticAgents.B01AD12_ProteinC;
model ProteinC "ProteinC — default model: ProteinC_Li2025v2_percentage_relative_standard_error"
  extends ProteinC_Li2025v2_percentage_relative_standard_error;
  annotation (Documentation(info = "<html><body><p>The default model of protein C: <a href=\"modelica://Pharmacolibrary.Drugs.B_BloodAndBloodFormingOrgans.B01A_AntithromboticAgents.B01AD12_ProteinC.ProteinC_Li2025v2_percentage_relative_standard_error\">ProteinC_Li2025v2_percentage_relative_standard_error</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of protein C in this package:</p><ul><li><code>ProteinC_Li2025v2_percentage_relative_standard_error</code></li></ul><h4>About protein C</h4><p>Protein C concentrate is used to treat purpura fulminans and protein C deficiency, acting as an antithrombotic agent. It is authorised in the European Union but appears to be a niche product, used only in these rare conditions.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q28852357\">Wikidata Q28852357</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.ProteinC\">ProteinC</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 8467200, Tolerance = 1e-9, Interval = 1));
end ProteinC;
