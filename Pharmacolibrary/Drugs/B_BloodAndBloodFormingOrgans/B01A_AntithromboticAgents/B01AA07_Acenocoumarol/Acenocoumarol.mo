within Pharmacolibrary.Drugs.B_BloodAndBloodFormingOrgans.B01A_AntithromboticAgents.B01AA07_Acenocoumarol;
model Acenocoumarol "Acenocoumarol — default model: Acenocoumarol_Delavenne2009_reference"
  extends Acenocoumarol_Delavenne2009_reference;
  annotation (Documentation(info = "<html><body><p>The default model of acenocoumarol: <a href=\"modelica://Pharmacolibrary.Drugs.B_BloodAndBloodFormingOrgans.B01A_AntithromboticAgents.B01AA07_Acenocoumarol.Acenocoumarol_Delavenne2009_reference\">Acenocoumarol_Delavenne2009_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of acenocoumarol in this package:</p><ul><li><code>Acenocoumarol_Delavenne2009_reference</code></li></ul><h4>About acenocoumarol</h4><p>Acenocoumarol is an anticoagulant, a vitamin K antagonist used to prevent and treat blood clots. It is an approved medicine and is used mainly in Europe, where it is often preferred over warfarin in some countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q304088\">Wikidata Q304088</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Acenocoumarol\">Acenocoumarol</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 1036800, Tolerance = 1e-9, Interval = 1));
end Acenocoumarol;
