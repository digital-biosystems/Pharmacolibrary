within Pharmacolibrary.Drugs.B_BloodAndBloodFormingOrgans.B01A_AntithromboticAgents.B01AX01_Defibrotide;
model Defibrotide "Defibrotide — default model: Defibrotide_Noseda1986_reference"
  extends Defibrotide_Noseda1986_reference;
  annotation (Documentation(info = "<html><body><p>The default model of defibrotide: <a href=\"modelica://Pharmacolibrary.Drugs.B_BloodAndBloodFormingOrgans.B01A_AntithromboticAgents.B01AX01_Defibrotide.Defibrotide_Noseda1986_reference\">Defibrotide_Noseda1986_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of defibrotide in this package:</p><ul><li><code>Defibrotide_Noseda1986_reference</code></li></ul><h4>About defibrotide</h4><p>Defibrotide, a mixture of single-stranded DNA fragments from pig intestinal mucosa, is an antithrombotic medicine used to treat hepatic veno-occlusive disease. It is authorised in the European Union and is also being studied for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3704725\">Wikidata Q3704725</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Defibrotide\">Defibrotide</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Defibrotide;
