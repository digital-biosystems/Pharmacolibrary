  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>defibrotide</td></tr><tr><td>ATC code:</td><td>B01AX01</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Noseda G et al. 1986</td></tr><tr><td>population:</td><td>healthy volunteers</td></tr><tr><td>measured compound:</td><td>defibrotide</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_defibrotide/Defibrotide_Noseda1986_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>β, min-1</td><td>8.22</td><td>min-1</td><td><small>kel</small></td></tr><tr><td>AUC, mg/l·min</td><td>173</td><td>mg/l·min</td><td><small>AUC</small></td></tr><tr><td>V1, ml/kg</td><td>38.1</td><td>ml/kg</td><td><small>V</small></td></tr></table><h4>About defibrotide</h4><p>Defibrotide, a mixture of single-stranded DNA fragments from pig intestinal mucosa, is an antithrombotic medicine used to treat hepatic veno-occlusive disease. It is authorised in the European Union and is also being studied for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3704725\">Wikidata Q3704725</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Defibrotide\">Defibrotide</a>.</p><h4>References</h4><ol><li><p>Noseda G et al. (1986). Pharmacokinetics of defibrotide in healthy volunteers. <i>Haemostasis 16 Suppl 1:26–30</i>. DOI:<a href=\"https://doi.org/10.1159/000215336\">10.1159/000215336</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/3754833\">3754833</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Noseda_1986: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
