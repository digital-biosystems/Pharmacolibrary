within Pharmacolibrary.Drugs.B_BloodAndBloodFormingOrgans.B01A_AntithromboticAgents.B01AB05_Enoxaparin;
model Enoxaparin "Enoxaparin — default model: Enoxaparin_Oualha2018_reference"
  extends Enoxaparin_Oualha2018_reference;
  annotation (Documentation(info = "<html><body><p>The default model of enoxaparin: <a href=\"modelica://Pharmacolibrary.Drugs.B_BloodAndBloodFormingOrgans.B01A_AntithromboticAgents.B01AB05_Enoxaparin.Enoxaparin_Oualha2018_reference\">Enoxaparin_Oualha2018_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of enoxaparin in this package:</p><ul><li><code>Enoxaparin_Oualha2018_reference</code></li></ul><h4>About enoxaparin</h4><p>Enoxaparin is a low molecular weight heparin used as an antithrombotic to prevent and treat blood clots. It is an approved medicine and is widely used in human medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q105969996\">Wikidata Q105969996</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Enoxaparin\">Enoxaparin</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 151200, Tolerance = 1e-9, Interval = 1));
end Enoxaparin;
