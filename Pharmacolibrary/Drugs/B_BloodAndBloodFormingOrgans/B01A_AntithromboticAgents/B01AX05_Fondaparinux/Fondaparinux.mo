within Pharmacolibrary.Drugs.B_BloodAndBloodFormingOrgans.B01A_AntithromboticAgents.B01AX05_Fondaparinux;
model Fondaparinux "Fondaparinux — default model: Fondaparinux_Michalikov2022_reference"
  extends Fondaparinux_Michalikov2022_reference;
  annotation (Documentation(info = "<html><body><p>The default model of fondaparinux: <a href=\"modelica://Pharmacolibrary.Drugs.B_BloodAndBloodFormingOrgans.B01A_AntithromboticAgents.B01AX05_Fondaparinux.Fondaparinux_Michalikov2022_reference\">Fondaparinux_Michalikov2022_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of fondaparinux in this package:</p><ul><li><code>Fondaparinux_Michalikov2022_reference</code></li></ul><h4>About fondaparinux</h4><p>Fondaparinux is an antithrombotic drug used to treat and prevent blood clots, including pulmonary embolism, thrombosis, thrombophlebitis, and phlebitis. It is an approved antithrombotic, classified among other antithrombotic agents, and has also been studied investigationally.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27077698\">Wikidata Q27077698</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Fondaparinux\">Fondaparinux</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 1382400, Tolerance = 1e-9, Interval = 1));
end Fondaparinux;
