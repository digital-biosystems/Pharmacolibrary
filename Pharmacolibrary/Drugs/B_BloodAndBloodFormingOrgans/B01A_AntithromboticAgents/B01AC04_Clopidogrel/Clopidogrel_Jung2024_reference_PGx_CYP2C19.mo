within Pharmacolibrary.Drugs.B_BloodAndBloodFormingOrgans.B01A_AntithromboticAgents.B01AC04_Clopidogrel;
model Clopidogrel_Jung2024_reference_PGx_CYP2C19
  "Clopidogrel_Jung2024_reference with the CYP2C19 phenotype as a parameter (Jung_2024)"
  import PGx = Pharmacolibrary.Pharmacogenomics.PGx;
  parameter PGx.MetabolizerStatus metabolizer = PGx.MetabolizerStatus.Normal
    "CYP2C19 phenotype — the reference is the record's own model"
