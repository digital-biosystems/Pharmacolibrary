  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>rivaroxaban</td></tr><tr><td>ATC code:</td><td>B01AF01</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Esmaeili T et al. 2022</td></tr><tr><td>population:</td><td>Iranian patients</td></tr><tr><td>measured compound:</td><td>rivaroxaban</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_rivaroxaban/Rivaroxaban_Esmaeili2022_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>oral volume of distribution</td><td>61.2</td><td>L</td><td><small>V</small></td></tr><tr><td>clearance</td><td>3.68</td><td>L·h-1</td><td><small>CL</small></td></tr></table><h4>About rivaroxaban</h4><p>Rivaroxaban is an anticoagulant that directly inhibits factor Xa and is used to prevent and treat blood clots, including venous thromboembolism, pulmonary embolism, and stroke prevention in atrial fibrillation. It is widely used and authorised in the European Union, with several approved products on the market.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q420262\">Wikidata Q420262</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Rivaroxaban\">Rivaroxaban</a>.</p><h4>References</h4><ol><li><p>Esmaeili T et al. (2022). Rivaroxaban population pharmacokinetic and pharmacodynamic modeling in Iranian patients. <i>Journal of clinical pharmacy and therapeutics 47(8):1284–1292</i>. DOI:<a href=\"https://doi.org/10.1111/jcpt.13673\">10.1111/jcpt.13673</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/35504629\">35504629</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Esmaeili_2022: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 259200, Tolerance = 1e-9, Interval = 1));
