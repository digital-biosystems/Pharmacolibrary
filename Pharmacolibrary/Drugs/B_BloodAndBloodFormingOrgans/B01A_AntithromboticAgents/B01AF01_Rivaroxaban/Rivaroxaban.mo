within Pharmacolibrary.Drugs.B_BloodAndBloodFormingOrgans.B01A_AntithromboticAgents.B01AF01_Rivaroxaban;
model Rivaroxaban "Rivaroxaban — default model: Rivaroxaban_Liu2022_sequential_modeling"
  extends Rivaroxaban_Liu2022_sequential_modeling;
  annotation (Documentation(info = "<html><body><p>The default model of rivaroxaban: <a href=\"modelica://Pharmacolibrary.Drugs.B_BloodAndBloodFormingOrgans.B01A_AntithromboticAgents.B01AF01_Rivaroxaban.Rivaroxaban_Liu2022_sequential_modeling\">Rivaroxaban_Liu2022_sequential_modeling</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of rivaroxaban in this package:</p><ul><li><code>Rivaroxaban_Liu2022_sequential_modeling</code></li><li><code>Rivaroxaban_Liu2022_simultaneous_modeling</code></li></ul><h4>About rivaroxaban</h4><p>Rivaroxaban is an anticoagulant that directly inhibits factor Xa and is used to prevent and treat blood clots, including venous thromboembolism, pulmonary embolism, and stroke prevention in atrial fibrillation. It is widely used and authorised in the European Union, with several approved products on the market.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q420262\">Wikidata Q420262</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Rivaroxaban\">Rivaroxaban</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 118800, Tolerance = 1e-9, Interval = 1));
end Rivaroxaban;
