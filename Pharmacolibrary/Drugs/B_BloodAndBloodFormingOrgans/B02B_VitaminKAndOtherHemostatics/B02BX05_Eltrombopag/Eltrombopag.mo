within Pharmacolibrary.Drugs.B_BloodAndBloodFormingOrgans.B02B_VitaminKAndOtherHemostatics.B02BX05_Eltrombopag;
model Eltrombopag "Eltrombopag — default model: Eltrombopag_Farrell2014_reference"
  extends Eltrombopag_Farrell2014_reference;
  annotation (Documentation(info = "<html><body><p>The default model of eltrombopag: <a href=\"modelica://Pharmacolibrary.Drugs.B_BloodAndBloodFormingOrgans.B02B_VitaminKAndOtherHemostatics.B02BX05_Eltrombopag.Eltrombopag_Farrell2014_reference\">Eltrombopag_Farrell2014_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of eltrombopag in this package:</p><ul><li><code>Eltrombopag_Farrell2014_reference</code></li></ul><h4>About eltrombopag</h4><p>Eltrombopag is a medicine used to raise low platelet counts in conditions such as immune thrombocytopenic purpura and aplastic anemia. It is an approved drug authorised in the European Union, where it is used for these platelet disorders.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q411588\">Wikidata Q411588</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Eltrombopag\">Eltrombopag</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Eltrombopag;
