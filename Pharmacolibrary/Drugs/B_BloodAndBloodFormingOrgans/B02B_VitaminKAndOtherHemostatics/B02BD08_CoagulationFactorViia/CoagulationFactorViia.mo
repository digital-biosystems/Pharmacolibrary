within Pharmacolibrary.Drugs.B_BloodAndBloodFormingOrgans.B02B_VitaminKAndOtherHemostatics.B02BD08_CoagulationFactorViia;
model CoagulationFactorViia "CoagulationFactorViia — default model: CoagulationFactorViia_Klitgaard2008_japanese_patients_with_h"
  extends CoagulationFactorViia_Klitgaard2008_japanese_patients_with_h;
  annotation (Documentation(info = "<html><body><p>The default model of coagulation factor VIIa: <a href=\"modelica://Pharmacolibrary.Drugs.B_BloodAndBloodFormingOrgans.B02B_VitaminKAndOtherHemostatics.B02BD08_CoagulationFactorViia.CoagulationFactorViia_Klitgaard2008_japanese_patients_with_h\">CoagulationFactorViia_Klitgaard2008_japanese_patients_with_h</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of coagulation factor VIIa in this package:</p><ul><li><code>CoagulationFactorViia_Klitgaard2008_japanese_patients_with_h</code></li><li><code>CoagulationFactorViia_Klitgaard2008_noncirrhotic_patients_un</code></li><li><code>CoagulationFactorViia_Klitgaard2008_paediatric_patients_with</code></li><li><code>CoagulationFactorViia_Klitgaard2008_patients_undergoing_olt</code></li><li><code>CoagulationFactorViia_Klitgaard2008_patients_undergoing_olt</code></li><li><code>CoagulationFactorViia_Klitgaard2008_patients_with_traumatic</code></li></ul><h4>About coagulation factor VIIa</h4><p>Coagulation factor VIIa is a blood coagulation factor used to treat bleeding by promoting clot formation. It is an approved medicine, though it carries a boxed warning, and has also been studied for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q20801762\">Wikidata Q20801762</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.CoagulationFactorVIIa\">CoagulationFactorVIIa</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end CoagulationFactorViia;
