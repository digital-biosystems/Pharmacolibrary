within Pharmacolibrary.Drugs.B_BloodAndBloodFormingOrgans.B05A_BloodAndRelatedProducts.B05AA07_Hydroxyethylstarch;
model Hydroxyethylstarch "Hydroxyethylstarch — default model: Hydroxyethylstarch_Asskali1999_reference"
  extends Hydroxyethylstarch_Asskali1999_reference;
  annotation (Documentation(info = "<html><body><p>The default model of hydroxyethylstarch: <a href=\"modelica://Pharmacolibrary.Drugs.B_BloodAndBloodFormingOrgans.B05A_BloodAndRelatedProducts.B05AA07_Hydroxyethylstarch.Hydroxyethylstarch_Asskali1999_reference\">Hydroxyethylstarch_Asskali1999_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of hydroxyethylstarch in this package:</p><ul><li><code>Hydroxyethylstarch_Asskali1999_reference</code></li><li><code>Hydroxyethylstarch_Yamakage2012_reference</code></li></ul><h4>About hydroxyethylstarch</h4><p>Hydroxyethyl starch is a modified starch used as a blood substitute and plasma volume expander. It remains approved but carries a boxed warning, so its use is restricted to carefully selected patients.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q415775\">Wikidata Q415775</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Hydroxyethylstarch\">Hydroxyethylstarch</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 432000, Tolerance = 1e-9, Interval = 1));
end Hydroxyethylstarch;
