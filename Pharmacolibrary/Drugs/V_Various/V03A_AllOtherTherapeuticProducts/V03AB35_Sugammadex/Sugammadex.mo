within Pharmacolibrary.Drugs.V_Various.V03A_AllOtherTherapeuticProducts.V03AB35_Sugammadex;
model Sugammadex "Sugammadex — default model: Sugammadex_Hodge2026_reference"
  extends Sugammadex_Hodge2026_reference;
  annotation (Documentation(info = "<html><body><p>The default model of sugammadex: <a href=\"modelica://Pharmacolibrary.Drugs.V_Various.V03A_AllOtherTherapeuticProducts.V03AB35_Sugammadex.Sugammadex_Hodge2026_reference\">Sugammadex_Hodge2026_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of sugammadex in this package:</p><ul><li><code>Sugammadex_Hodge2026_reference</code></li></ul><h4>About sugammadex</h4><p>Sugammadex is an antidote used to reverse neuromuscular blockade caused by muscle relaxants during anaesthesia. It is approved and authorised in the European Union, where several sugammadex products are on the market.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q81987842\">Wikidata Q81987842</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Sugammadex\">Sugammadex</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Sugammadex;
