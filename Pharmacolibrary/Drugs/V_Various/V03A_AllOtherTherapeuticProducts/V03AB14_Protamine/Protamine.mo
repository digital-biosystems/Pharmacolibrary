within Pharmacolibrary.Drugs.V_Various.V03A_AllOtherTherapeuticProducts.V03AB14_Protamine;
model Protamine "Protamine — default model: Protamine_Butterworth2002_reference"
  extends Protamine_Butterworth2002_reference;
  annotation (Documentation(info = "<html><body><p>The default model of protamine: <a href=\"modelica://Pharmacolibrary.Drugs.V_Various.V03A_AllOtherTherapeuticProducts.V03AB14_Protamine.Protamine_Butterworth2002_reference\">Protamine_Butterworth2002_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of protamine in this package:</p><ul><li><code>Protamine_Butterworth2002_reference</code></li></ul><h4>About protamine</h4><p>Protamine is an antidote used to reverse the blood-thinning effect of heparin, for example after heart surgery or when heparin causes excessive bleeding. It remains in use today, mainly in hospital settings such as operating theatres and dialysis units.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5449573\">Wikidata Q5449573</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Protamine\">Protamine</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Protamine;
