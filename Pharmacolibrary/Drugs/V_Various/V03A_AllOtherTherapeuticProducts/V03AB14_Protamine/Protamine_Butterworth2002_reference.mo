within Pharmacolibrary.Drugs.V_Various.V03A_AllOtherTherapeuticProducts.V03AB14_Protamine;
model Protamine_Butterworth2002_reference
  parameter Real Cl_ref = 3.6666666666666666e-05 "Cl [m3/s]";
  parameter Real Vd_ref = 0.00304 "Vd [m3]";
  extends Pharmacolibrary.Pharmacokinetic.Models.PK_1C(
    weight = 70.0,
    F = 1,
    Cl = Cl_ref,
    Vd = Vd_ref,
    adminDuration = 600,
    adminCount = 1,
    adminMass = 1e-05
  );

  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>protamine</td></tr><tr><td>ATC code:</td><td>V03AB14</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Butterworth J et al. 2002</td></tr><tr><td>population:</td><td>healthy volunteers</td></tr><tr><td>measured compound:</td><td>protamine</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_protamine/Protamine_Butterworth2002_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>volume of distribution at steady state</td><td>12.3</td><td>L</td><td><small>Vss</small></td></tr><tr><td>clearance</td><td>2.2</td><td>L/min</td><td><small>CL</small></td></tr><tr><td>t1/2</td><td>7.4</td><td>min</td><td><small>t1/2z</small></td></tr><tr><td>V UFH-C</td><td>3.04</td><td>L</td><td><small>V</small></td></tr></table><h4>About protamine</h4><p>Protamine is an antidote used to reverse the blood-thinning effect of heparin, for example after heart surgery or when heparin causes excessive bleeding. It remains in use today, mainly in hospital settings such as operating theatres and dialysis units.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5449573\">Wikidata Q5449573</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Protamine\">Protamine</a>.</p><h4>References</h4><ol><li><p>Butterworth J et al. (2002). The pharmacokinetics and cardiovascular effects of a single intravenous dose of protamine in normal volunteers. <i>Anesthesia and analgesia 94(3):514</i>. DOI:<a href=\"https://doi.org/10.1097/00000539-200203000-00008\">10.1097/00000539-200203000-00008</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/11867368\">11867368</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Butterworth_2002: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Protamine_Butterworth2002_reference;
