within Pharmacolibrary.Drugs.V_Various.V04C_OtherDiagnosticAgents.V04CH30_AminohippuricAcid;
model AminohippuricAcid "AminohippuricAcid — default model: AminohippuricAcid_Kinowski1995_reference"
  extends AminohippuricAcid_Kinowski1995_reference;
  annotation (Documentation(info = "<html><body><p>The default model of aminohippuric acid: <a href=\"modelica://Pharmacolibrary.Drugs.V_Various.V04C_OtherDiagnosticAgents.V04CH30_AminohippuricAcid.AminohippuricAcid_Kinowski1995_reference\">AminohippuricAcid_Kinowski1995_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of aminohippuric acid in this package:</p><ul><li><code>AminohippuricAcid_Kinowski1995_reference</code></li></ul><h4>About aminohippuric acid</h4><p>Aminohippuric acid is a diagnostic agent used in tests of kidney function and for ureteral injuries. It is an approved diagnostic product, though some formulations have been withdrawn; it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q291271\">Wikidata Q291271</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.AminohippuricAcid\">AminohippuricAcid</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end AminohippuricAcid;
