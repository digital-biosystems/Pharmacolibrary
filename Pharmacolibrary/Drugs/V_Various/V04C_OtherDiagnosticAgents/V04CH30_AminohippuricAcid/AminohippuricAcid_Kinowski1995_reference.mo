within Pharmacolibrary.Drugs.V_Various.V04C_OtherDiagnosticAgents.V04CH30_AminohippuricAcid;
model AminohippuricAcid_Kinowski1995_reference
  parameter Real Cl_ref = 8.527777777777779e-06 "Cl [m3/s]";
  parameter Real Vd_ref = 0.0106 "Vd [m3]";
  extends Pharmacolibrary.Pharmacokinetic.Models.PK_1C(
    weight = 70.0,
    F = 1,
    Cl = Cl_ref,
    Vd = Vd_ref,
    adminDuration = 600,
    adminCount = 1,
    MM = Pharmacolibrary.Drugs.Substances.AminohippuricAcid.M,
    adminMass = 1e-05
  );

  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>aminohippuric_acid</td></tr><tr><td>ATC code:</td><td>V04CH30</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Kinowski JM et al. 1995</td></tr><tr><td>population:</td><td>patients with and without renal insufficiency</td></tr><tr><td>measured compound:</td><td>aminohippuric_acid</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_aminohippuric_acid/AminohippuricAcid_Kinowski1995_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>CL</td><td>30.7</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>V</td><td>10.6</td><td>L</td><td><small>V</small></td></tr></table><h4>About aminohippuric_acid</h4><p>Aminohippuric acid is a diagnostic agent used in tests of kidney function and for ureteral injuries. It is an approved diagnostic product, though some formulations have been withdrawn; it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q291271\">Wikidata Q291271</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.AminohippuricAcid\">AminohippuricAcid</a>.</p><h4>References</h4><ol><li><p>Kinowski JM et al. (1995). Bayesian estimation of p-aminohippurate clearance by a limited sampling strategy. <i>Journal of pharmaceutical sciences 84(3):307–311</i>. DOI:<a href=\"https://doi.org/10.1002/jps.2600840309\">10.1002/jps.2600840309</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/7616369\">7616369</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Kinowski_1995: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end AminohippuricAcid_Kinowski1995_reference;
