within Pharmacolibrary.Drugs.V_Various.V08C_MagneticResonanceImagingContrastMedia.V08CA12_Gadopiclenol;
model Gadopiclenol "Gadopiclenol — default model: Gadopiclenol_Eto2025_0_025_mmol_kg"
  extends Gadopiclenol_Eto2025_0_025_mmol_kg;
  annotation (Documentation(info = "<html><body><p>The default model of gadopiclenol: <a href=\"modelica://Pharmacolibrary.Drugs.V_Various.V08C_MagneticResonanceImagingContrastMedia.V08CA12_Gadopiclenol.Gadopiclenol_Eto2025_0_025_mmol_kg\">Gadopiclenol_Eto2025_0_025_mmol_kg</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of gadopiclenol in this package:</p><ul><li><code>Gadopiclenol_Eto2025_0_025_mmol_kg</code></li><li><code>Gadopiclenol_Eto2025_0_05_mmol_kg</code></li><li><code>Gadopiclenol_Eto2025_0_1_mmol_kg</code></li></ul><h4>About gadopiclenol</h4><p>Gadopiclenol is a gadolinium-based contrast agent used to improve images in magnetic resonance imaging. It is authorised in the European Union and is a newer agent, so it is not yet widely used.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q114748523\">Wikidata Q114748523</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Gadopiclenol\">Gadopiclenol</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Gadopiclenol;
