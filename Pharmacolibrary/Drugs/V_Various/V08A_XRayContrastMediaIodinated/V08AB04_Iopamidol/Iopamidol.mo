within Pharmacolibrary.Drugs.V_Various.V08A_XRayContrastMediaIodinated.V08AB04_Iopamidol;
model Iopamidol "Iopamidol — default model: Iopamidol_Hooper2025_final"
  extends Iopamidol_Hooper2025_final;
  annotation (Documentation(info = "<html><body><p>The default model of iopamidol: <a href=\"modelica://Pharmacolibrary.Drugs.V_Various.V08A_XRayContrastMediaIodinated.V08AB04_Iopamidol.Iopamidol_Hooper2025_final\">Iopamidol_Hooper2025_final</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of iopamidol in this package:</p><ul><li><code>Iopamidol_Hooper2025_final</code></li><li><code>Iopamidol_Hooper2025_pragmatic_model</code></li></ul><h4>About iopamidol</h4><p>Iopamidol is an iodinated, low-osmolar X-ray contrast agent used to improve visibility of body structures during imaging examinations. It is an approved contrast medium that is widely used in medical imaging, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q424788\">Wikidata Q424788</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Iopamidol\">Iopamidol</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Iopamidol;
