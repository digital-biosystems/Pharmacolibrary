within Pharmacolibrary.Drugs.G_GenitoUrinarySystemAndSexHormones.G04B_Urologicals.G04BX14_Dapoxetine;
model Dapoxetine "Dapoxetine — default model: Dapoxetine_Pu2026_reference"
  extends Dapoxetine_Pu2026_reference;
  annotation (Documentation(info = "<html><body><p>The default model of dapoxetine: <a href=\"modelica://Pharmacolibrary.Drugs.G_GenitoUrinarySystemAndSexHormones.G04B_Urologicals.G04BX14_Dapoxetine.Dapoxetine_Pu2026_reference\">Dapoxetine_Pu2026_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of dapoxetine in this package:</p><ul><li><code>Dapoxetine_Pu2026_reference</code></li></ul><h4>About dapoxetine</h4><p>Dapoxetine is a urological drug developed for the treatment of premature ejaculation. It is considered investigational in the sources provided and has not been authorised in the European Union, though it has been marketed in some other countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q424965\">Wikidata Q424965</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Dapoxetine\">Dapoxetine</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Dapoxetine;
