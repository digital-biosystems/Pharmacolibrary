  annotation (Documentation(info = "<html><body><p>Mirdametinib is a MEK inhibitor anticancer drug used to treat plexiform neurofibromas associated with neurofibromatosis type 1. It is an approved medicine, authorised in the European Union, and is also being investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27088255&quot;>Wikidata Q27088255</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>mirdametinib</td></tr><tr><td>ATC codes:</td><td>L01EE05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB07101&quot;>DB07101</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/9826528&quot;>9826528</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:88249&quot;>88249</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27088255&quot;>Q27088255</a></td></tr><tr><td>formula:</td><td>C16H14F3IN2O4</td></tr><tr><td>molar mass:</td><td>482.192 g/mol (PubChem)</td></tr></table></body></html>"));
