  annotation (Documentation(info = "<html><body><p>Magnesium pidolate is a magnesium salt used as a mineral supplement to treat or prevent magnesium deficiency. It is an approved supplement, though it is not authorised in the European Union and appears to be used only in a limited number of countries.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27887010&quot;>Wikidata Q27887010</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>magnesium pidolate</td></tr><tr><td>ATC codes:</td><td>A12CC08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB03088&quot;>DB03088</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27887010&quot;>Q27887010</a></td></tr><tr><td>molar mass:</td><td>280.52 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end MagnesiumPidolate;
