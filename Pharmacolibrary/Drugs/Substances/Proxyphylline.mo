  annotation (Documentation(info = "<html><body><p>Proxyphylline is a xanthine bronchodilator developed for obstructive airway diseases such as asthma. It is now considered an experimental drug and is not in widespread clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7252904&quot;>Wikidata Q7252904</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>proxyphylline</td></tr><tr><td>ATC codes:</td><td>R03DA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13449&quot;>DB13449</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4977&quot;>4977</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32070&quot;>32070</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7252904&quot;>Q7252904</a></td></tr><tr><td>formula:</td><td>C10H14N4O3</td></tr><tr><td>molar mass:</td><td>238.247 g/mol (PubChem)</td></tr></table></body></html>"));
