    M = 0.100114);
  annotation (Documentation(info = "<html><body><p>Potassium hydrogencarbonate (potassium bicarbonate) is a potassium supplement used to treat low blood potassium levels (hypokalemia). It is an approved medicine, available as a mineral supplement, though it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q410529\">Wikidata Q410529</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>potassium hydrogencarbonate</td></tr><tr><td>ATC codes:</td><td>A12BA04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11098\">DB11098</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/516893\">516893</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:81862\">81862</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q410529\">Q410529</a></td></tr><tr><td>formula:</td><td>CHKO3</td></tr><tr><td>molar mass:</td><td>100.114 g/mol (PubChem CID 516893)</td></tr></table></body></html>"));
end PotassiumHydrogencarbonate;
