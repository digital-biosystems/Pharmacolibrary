    logP = 4.4);
  annotation (Documentation(info = "<html><body><p>Diphemanil is a synthetic anticholinergic that was used to treat functional gastrointestinal disorders such as peptic ulcer disease, and also asthma. It has been withdrawn and is no longer in human use, though it was once also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27165329&quot;>Wikidata Q27165329</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>diphemanil</td></tr><tr><td>ATC codes:</td><td>A03AB15</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13720&quot;>DB13720</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6127&quot;>6127</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:93636&quot;>93636</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27165329&quot;>Q27165329</a></td></tr><tr><td>formula:</td><td>C20H24N+</td></tr><tr><td>molar mass:</td><td>278.419 g/mol (PubChem)</td></tr></table></body></html>"));
end Diphemanil;
