within Pharmacolibrary.Drugs.Substances;
package Hyaluronidase "hyaluronidase"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "hyaluronidase",
    atcCodes = {"B06AA03"},
    drugbankId = "DB14740",
    wikidataId = "Q105488220");
  annotation (Documentation(info = "<html><body><p>Hyaluronidase is an enzyme medicine used to treat extravasation, and has also been studied for injection into the eye to treat vitreous hemorrhage. It is an approved medication, though one European application for an eye-related use was withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q105488220\">Wikidata Q105488220</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>hyaluronidase</td></tr><tr><td>ATC codes:</td><td>B06AA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB14740\">DB14740</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q105488220\">Q105488220</a></td></tr></table></body></html>"));
end Hyaluronidase;
