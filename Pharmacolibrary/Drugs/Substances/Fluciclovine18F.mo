  annotation (Documentation(info = "<html><body><p>Fluciclovine (18F) is a radioactive imaging agent used to detect tumours, mainly in prostate cancer imaging. It is authorised in the European Union and used in radionuclide imaging.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q25313613&quot;>Wikidata Q25313613</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>fluciclovine (18F)</td></tr><tr><td>ATC codes:</td><td>V09IX12</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13146&quot;>DB13146</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/450601&quot;>450601</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134703&quot;>134703</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q25313613&quot;>Q25313613</a></td></tr><tr><td>formula:</td><td>C5H8FNO2</td></tr><tr><td>molar mass:</td><td>133.122 g/mol (PubChem)</td></tr></table></body></html>"));
