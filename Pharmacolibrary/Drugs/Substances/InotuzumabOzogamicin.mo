  annotation (Documentation(info = "<html><body><p>Inotuzumab ozogamicin is an antibody-drug conjugate used to treat a form of acute lymphoblastic leukemia/lymphoma. It is authorised in the European Union and carries a boxed warning, so its use is closely monitored.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3799041\">Wikidata Q3799041</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>inotuzumab ozogamicin</td></tr><tr><td>ATC codes:</td><td>L01FB01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB05889\">DB05889</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3799041\">Q3799041</a></td></tr></table></body></html>"));
