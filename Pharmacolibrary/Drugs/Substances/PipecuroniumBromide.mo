  annotation (Documentation(info = "<html><body><p>Pipecuronium bromide is a non-depolarising neuromuscular blocking agent, a muscle relaxant used to relax muscles during surgery. It is no longer in use, having been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q20817188&quot;>Wikidata Q20817188</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pipecuronium bromide</td></tr><tr><td>ATC codes:</td><td>M03AC06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01338&quot;>DB01338</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/50192&quot;>50192</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8230&quot;>8230</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q20817188&quot;>Q20817188</a></td></tr><tr><td>formula:</td><td>C35H62N4O4+2</td></tr><tr><td>molar mass:</td><td>602.905 g/mol (PubChem)</td></tr></table></body></html>"));
