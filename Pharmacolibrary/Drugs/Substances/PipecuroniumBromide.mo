  annotation (Documentation(info = "<html><body><p>Pipecuronium bromide is a non-depolarising neuromuscular blocking agent, a muscle relaxant used to relax muscles during surgery. It is no longer in use, having been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q20817188\">Wikidata Q20817188</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pipecuronium bromide</td></tr><tr><td>ATC codes:</td><td>M03AC06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01338\">DB01338</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/50192\">50192</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8230\">8230</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q20817188\">Q20817188</a></td></tr><tr><td>formula:</td><td>C35H62N4O4+2</td></tr><tr><td>molar mass:</td><td>602.905 g/mol (PubChem CID 50192)</td></tr></table><p><small>Drugs.Common 25.09 gave 762.7 g/mol (+26.5 %); replaced by the value above</small></p></body></html>"));
