within Pharmacolibrary.Drugs.Substances;
package Tislelizumab "tislelizumab"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "tislelizumab",
    atcCodes = {"L01FF09"},
    drugbankId = "DB14922",
    wikidataId = "Q28209583");
  annotation (Documentation(info = "<html><body><p>Tislelizumab is a monoclonal antibody that blocks PD-1 and is used to treat several cancers, including esophageal, lung, nasopharyngeal, and stomach cancers. It is an approved medicine, with one product currently authorised in the European Union, though another EU product has been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q28209583\">Wikidata Q28209583</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>tislelizumab</td></tr><tr><td>ATC codes:</td><td>L01FF09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB14922\">DB14922</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q28209583\">Q28209583</a></td></tr></table></body></html>"));
end Tislelizumab;
