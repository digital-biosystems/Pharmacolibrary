  annotation (Documentation(info = "<html><body><p>Betrixaban is a direct factor Xa inhibitor anticoagulant intended for the prevention of venous thromboembolism. It is approved for use in some countries, but a marketing application in the European Union was refused, so it is not authorised there.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4898219&quot;>Wikidata Q4898219</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>betrixaban</td></tr><tr><td>ATC codes:</td><td>B01AF04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12364&quot;>DB12364</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/10275777&quot;>10275777</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:140421&quot;>140421</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4898219&quot;>Q4898219</a></td></tr><tr><td>formula:</td><td>C23H22ClN5O3</td></tr><tr><td>molar mass:</td><td>451.911 g/mol (PubChem)</td></tr></table></body></html>"));
end Betrixaban;
