    logP = 5.3);
  annotation (Documentation(info = "<html><body><p>Casopitant is an investigational antiemetic (an NK1 receptor antagonist) studied for preventing nausea and vomiting, including postoperative nausea and vomiting and vomiting associated with cancer treatment. It was never marketed; its European Union marketing application was withdrawn, so it remains investigational.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5049003\">Wikidata Q5049003</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>casopitant</td></tr><tr><td>ATC codes:</td><td>A04AD13</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06634\">DB06634</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9917021\">9917021</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135967\">135967</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5049003\">Q5049003</a></td></tr><tr><td>formula:</td><td>C30H35F7N4O2</td></tr><tr><td>molar mass:</td><td>616.622 g/mol (PubChem CID 9917021)</td></tr><tr><td>logP:</td><td>5.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Casopitant;
