  annotation (Documentation(info = "<html><body><p>Vancomycin is a glycopeptide antibiotic used to treat serious bacterial infections, including staphylococcal infections, pneumonia, infective endocarditis, and pseudomembranous colitis. It is an approved medicine and appears on the WHO list of essential medicines, so it is widely used, typically in hospital settings for severe infections.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q424027\">Wikidata Q424027</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>vancomycin</td></tr><tr><td>ATC codes:</td><td>A07AA09, J01XA01, S01AA28</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00512\">DB00512</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/14969\">14969</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:28001\">28001</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q424027\">Q424027</a></td></tr><tr><td>formula:</td><td>C66H75Cl2N9O24</td></tr><tr><td>molar mass:</td><td>1449.27 g/mol (PubChem CID 14969)</td></tr><tr><td>logP:</td><td>-2.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Vancomycin;
