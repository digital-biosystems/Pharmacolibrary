  annotation (Documentation(info = "<html><body><p>Eteplirsen is a drug used to treat Duchenne muscular dystrophy. It is approved in the United States, but the European Medicines Agency refused a marketing application for it in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5402585&quot;>Wikidata Q5402585</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>eteplirsen</td></tr><tr><td>ATC codes:</td><td>M09AX06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06014&quot;>DB06014</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5402585&quot;>Q5402585</a></td></tr><tr><td>molar mass:</td><td>10305 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
