  annotation (Documentation(info = "<html><body><p>Volanesorsen is a lipid-lowering medicine used to treat familial chylomicronemia syndrome (type I hyperlipoproteinemia). It is authorised in the European Union and is used in a limited way for this rare condition.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>volanesorsen</td></tr><tr><td>ATC codes:</td><td>C10AX18</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB15067\">DB15067</a></td></tr><tr><td>molar mass:</td><td>7165 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>-9.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
