  annotation (Documentation(info = "<html><body><p>Volanesorsen is a lipid-lowering medicine used to treat familial chylomicronemia syndrome (type I hyperlipoproteinemia). It is authorised in the European Union and is used in a limited way for this rare condition.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>volanesorsen</td></tr><tr><td>ATC codes:</td><td>C10AX18</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB15067&quot;>DB15067</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/121494123&quot;>121494123</a></td></tr><tr><td>formula:</td><td>C230H320N63O125P19S19</td></tr><tr><td>molar mass:</td><td>7165.05 g/mol (PubChem)</td></tr></table></body></html>"));
