  annotation (Documentation(info = "<html><body><p>Lindane, an organochlorine isomer of hexachlorocyclohexane, was used as a scabicide and to treat lice infestations. It has been withdrawn from use, reportedly over safety concerns including its boxed warning status.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q282003\">Wikidata Q282003</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>lindane</td></tr><tr><td>ATC codes:</td><td>P03AB02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00431\">DB00431</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/727\">727</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32888\">32888</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q282003\">Q282003</a></td></tr><tr><td>formula:</td><td>C6H6Cl6</td></tr><tr><td>molar mass:</td><td>290.814 g/mol (PubChem CID 727)</td></tr><tr><td>logP:</td><td>3.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
