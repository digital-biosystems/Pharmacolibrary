  annotation (Documentation(info = "<html><body><p>Xantinol nicotinate is a peripheral vasodilator belonging to the purine derivatives, used for circulatory disorders of the blood vessels. It has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q8042975&quot;>Wikidata Q8042975</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>xantinol nicotinate</td></tr><tr><td>ATC codes:</td><td>C04AD02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09092&quot;>DB09092</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/9913&quot;>9913</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:94314&quot;>94314</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q8042975&quot;>Q8042975</a></td></tr><tr><td>formula:</td><td>C13H21N5O4</td></tr><tr><td>molar mass:</td><td>311.342 g/mol (PubChem)</td></tr></table></body></html>"));
