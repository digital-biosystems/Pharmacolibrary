  annotation (Documentation(info = "<html><body><p>Xantinol nicotinate is a purine-derivative peripheral vasodilator once used to improve blood flow in circulatory disorders. It has been withdrawn and is no longer in clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5814478\">Wikidata Q5814478</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>xantinol nicotinate</td></tr><tr><td>ATC codes:</td><td>C04AD02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09092\">DB09092</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9913\">9913</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:94314\">94314</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5814478\">Q5814478</a></td></tr><tr><td>formula:</td><td>C13H21N5O4</td></tr><tr><td>molar mass:</td><td>311.342 g/mol (PubChem CID 9913)</td></tr></table><p><small>Drugs.Common 25.09 gave 434.4 g/mol (+39.5 %); replaced by the value above</small></p></body></html>"));
