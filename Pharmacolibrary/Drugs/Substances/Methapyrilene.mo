  annotation (Documentation(info = "<html><body><p>Methapyrilene is an antihistamine of the substituted ethylenediamine type that was used to treat allergies and related respiratory conditions. It has been withdrawn from use after safety concerns, including liver toxicity, were recognised.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q59854145&quot;>Wikidata Q59854145</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>methapyrilene</td></tr><tr><td>ATC codes:</td><td>R06AC05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB04819&quot;>DB04819</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/8667&quot;>8667</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6820&quot;>6820</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q59854145&quot;>Q59854145</a></td></tr><tr><td>formula:</td><td>C14H20ClN3S</td></tr><tr><td>molar mass:</td><td>297.845 g/mol (PubChem)</td></tr></table></body></html>"));
