  annotation (Documentation(info = "<html><body><p>Acetyldihydrocodeine is an opioid related to opium alkaloids that has been classified as a cough suppressant for coughs and colds. It does not appear to be an approved medicine today; it is regarded as an experimental substance and is also considered illicit, so its current medical use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4673302\">Wikidata Q4673302</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>acetyldihydrocodeine</td></tr><tr><td>ATC codes:</td><td>R05DA12</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01538\">DB01538</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5463874\">5463874</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135453\">135453</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4673302\">Q4673302</a></td></tr><tr><td>formula:</td><td>C20H25NO4</td></tr><tr><td>molar mass:</td><td>343.423 g/mol (PubChem CID 5463874)</td></tr><tr><td>logP:</td><td>2.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Acetyldihydrocodeine;
