  annotation (Documentation(info = "<html><body><p>Zinc orotate is a zinc-containing mineral supplement that has been investigated for use as a source of the essential mineral zinc. It is considered investigational and is not an approved medicine; it may be found in dietary supplements rather than mainstream medical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27295098\">Wikidata Q27295098</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>zinc orotate</td></tr><tr><td>ATC codes:</td><td>A12CB04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB15720\">DB15720</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27295098\">Q27295098</a></td></tr><tr><td>formula:</td><td>C10H6N4O8Zn</td></tr><tr><td>molar mass:</td><td>375.56 g/mol (knowledgebase (DrugBank calculated))</td></tr></table></body></html>"));
