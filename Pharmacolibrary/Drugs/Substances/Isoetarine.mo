    logP = 1.7);
  annotation (Documentation(info = "<html><body><p>Isoetarine is a selective beta-2 adrenergic agonist used as a bronchodilator for obstructive airway diseases such as asthma. It has been an approved medicine, given by inhalation or systemically, but is not widely used today and has no EU marketing authorisation.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6085646&quot;>Wikidata Q6085646</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>isoetarine</td></tr><tr><td>ATC codes:</td><td>R03AC07, R03CC06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00221&quot;>DB00221</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3762&quot;>3762</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6085646&quot;>Q6085646</a></td></tr><tr><td>formula:</td><td>C13H21NO3</td></tr><tr><td>molar mass:</td><td>239.315 g/mol (PubChem)</td></tr></table></body></html>"));
end Isoetarine;
