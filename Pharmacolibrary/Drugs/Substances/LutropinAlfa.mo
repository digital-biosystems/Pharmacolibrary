  annotation (Documentation(info = "<html><body><p>Lutropin alfa, a recombinant form of luteinizing hormone, is a gonadotropin used to treat female infertility by inducing ovulation. It is authorised in the European Union as a fertility treatment for women.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q208360\">Wikidata Q208360</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>lutropin alfa</td></tr><tr><td>ATC codes:</td><td>G03GA07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00044\">DB00044</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q208360\">Q208360</a></td></tr><tr><td>molar mass:</td><td>30000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end LutropinAlfa;
