  annotation (Documentation(info = "<html><body><p>Cefixime is a third-generation cephalosporin antibiotic used to treat bacterial infections such as gonorrhea, urinary tract infections, bronchitis, otitis media, and strep throat. It is an approved medicine and appears on the WHO list of essential medicines, so it remains in widespread use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q163901&quot;>Wikidata Q163901</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cefixime</td></tr><tr><td>ATC codes:</td><td>J01DD08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00671&quot;>DB00671</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5362065&quot;>5362065</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:472657&quot;>472657</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q163901&quot;>Q163901</a></td></tr><tr><td>formula:</td><td>C16H15N5O7S2</td></tr><tr><td>molar mass:</td><td>453.444 g/mol (PubChem)</td></tr></table></body></html>"));
