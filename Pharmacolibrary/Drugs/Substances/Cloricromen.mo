  annotation (Documentation(info = "<html><body><p>Cloricromen is a platelet aggregation inhibitor, an antithrombotic drug used to reduce blood clotting. It appears to be only an experimental compound and is not an established marketed medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5135145\">Wikidata Q5135145</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cloricromen</td></tr><tr><td>ATC codes:</td><td>B01AC02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13367\">DB13367</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/68876\">68876</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135628\">135628</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5135145\">Q5135145</a></td></tr><tr><td>formula:</td><td>C20H26ClNO5</td></tr><tr><td>molar mass:</td><td>395.88 g/mol (PubChem CID 68876)</td></tr><tr><td>logP:</td><td>3.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
