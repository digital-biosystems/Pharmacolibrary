  annotation (Documentation(info = "<html><body><p>Oportuzumab monatox is an investigational monoclonal antibody drug conjugate studied for treating bladder cancer. It remains investigational; a marketing application in the European Union was withdrawn, so it is not authorised there.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3884218\">Wikidata Q3884218</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>oportuzumab monatox</td></tr><tr><td>ATC codes:</td><td>L01FX16</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB05319\">DB05319</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3884218\">Q3884218</a></td></tr></table></body></html>"));
end OportuzumabMonatox;
