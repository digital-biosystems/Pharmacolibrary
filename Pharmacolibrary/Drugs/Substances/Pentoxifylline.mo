within Pharmacolibrary.Drugs.Substances;
package Pentoxifylline "pentoxifylline"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "pentoxifylline",
    atcCodes = {"C04AD03"},
    drugbankId = "DB00806",
    pubchemCid = "4740",
    chebiId = "7986",
    wikidataId = "Q416331",
    formula = "C13H18N4O3",
    M = 0.278312,
    logP = 0.3);
  annotation (Documentation(info = "<html><body><p>Pentoxifylline is a vasodilator and phosphodiesterase inhibitor used for blood-flow problems such as peripheral vascular disease, intermittent claudication, arteriosclerosis, and diabetic vascular and nerve complications. It is an approved medicine, though not authorised centrally in the European Union, and has also been studied for other conditions.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q416331\">Wikidata Q416331</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pentoxifylline</td></tr><tr><td>ATC codes:</td><td>C04AD03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00806\">DB00806</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4740\">4740</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7986\">7986</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q416331\">Q416331</a></td></tr><tr><td>formula:</td><td>C13H18N4O3</td></tr><tr><td>molar mass:</td><td>278.312 g/mol (PubChem CID 4740)</td></tr><tr><td>logP:</td><td>0.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Pentoxifylline;
