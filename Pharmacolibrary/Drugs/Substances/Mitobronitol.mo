  annotation (Documentation(info = "<html><body><p>Mitobronitol is an alkylating agent that has been used as an anticancer (antineoplastic) drug. It is no longer in routine clinical use and is considered an experimental agent.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3859447\">Wikidata Q3859447</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mitobronitol</td></tr><tr><td>ATC codes:</td><td>L01AX01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13543\">DB13543</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/656655\">656655</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:34853\">34853</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3859447\">Q3859447</a></td></tr><tr><td>formula:</td><td>C6H12Br2O4</td></tr><tr><td>molar mass:</td><td>307.966 g/mol (PubChem CID 656655)</td></tr><tr><td>logP:</td><td>-0.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
