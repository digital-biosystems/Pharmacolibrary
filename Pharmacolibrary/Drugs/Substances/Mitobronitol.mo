  annotation (Documentation(info = "<html><body><p>Mitobronitol is an alkylating agent that has been used as an anticancer (antineoplastic) drug. It is no longer in routine clinical use and is considered an experimental agent.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3859447&quot;>Wikidata Q3859447</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mitobronitol</td></tr><tr><td>ATC codes:</td><td>L01AX01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13543&quot;>DB13543</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/656655&quot;>656655</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:34853&quot;>34853</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3859447&quot;>Q3859447</a></td></tr><tr><td>formula:</td><td>C6H12Br2O4</td></tr><tr><td>molar mass:</td><td>307.966 g/mol (PubChem)</td></tr></table></body></html>"));
