within Pharmacolibrary.Drugs.Substances;
package Quinine "quinine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "quinine",
    atcCodes = {"P01BC01"},
    drugbankId = "DB00468",
    pubchemCid = "3034034",
    chebiId = "15854",
    wikidataId = "Q189522",
    formula = "C20H24N2O2",
    M = 0.324424,
    logP = 2.9);
  annotation (Documentation(info = "<html><body><p>Quinine is an antimalarial drug used to treat malaria, including falciparum malaria, and has also been used for babesiosis and muscle cramps. It remains an approved medicine, is listed among WHO essential medicines, and is used worldwide mainly for malaria, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q189522\">Wikidata Q189522</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>quinine</td></tr><tr><td>ATC codes:</td><td>P01BC01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00468\">DB00468</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3034034\">3034034</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:15854\">15854</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q189522\">Q189522</a></td></tr><tr><td>formula:</td><td>C20H24N2O2</td></tr><tr><td>molar mass:</td><td>324.424 g/mol (PubChem CID 3034034)</td></tr><tr><td>logP:</td><td>2.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Quinine;
