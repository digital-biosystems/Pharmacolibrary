  annotation (Documentation(info = "<html><body><p>Syrosingopine combined with diuretics is a combination of a Rauwolfia alkaloid with a diuretic used to lower high blood pressure. It is no longer in use, as it is listed as a withdrawn product.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27164011&quot;>Wikidata Q27164011</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>syrosingopine and diuretics</td></tr><tr><td>ATC codes:</td><td>C02LA09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB19379&quot;>DB19379</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32175&quot;>32175</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27164011&quot;>Q27164011</a></td></tr><tr><td>formula:</td><td>C35H42N2O11</td></tr><tr><td>molar mass:</td><td>666.724 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
