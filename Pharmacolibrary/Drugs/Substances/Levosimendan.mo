    logP = 2.3);
  annotation (Documentation(info = "<html><body><p>Levosimendan is a calcium sensitiser used to treat acutely decompensated congestive heart failure. It is an approved cardiac stimulant, though its use appears limited and it has also been investigated and withdrawn in some settings.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q162541&quot;>Wikidata Q162541</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>levosimendan</td></tr><tr><td>ATC codes:</td><td>C01CX08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00922&quot;>DB00922</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3033825&quot;>3033825</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:50567&quot;>50567</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q162541&quot;>Q162541</a></td></tr><tr><td>formula:</td><td>C14H12N6O</td></tr><tr><td>molar mass:</td><td>280.291 g/mol (PubChem)</td></tr></table></body></html>"));
