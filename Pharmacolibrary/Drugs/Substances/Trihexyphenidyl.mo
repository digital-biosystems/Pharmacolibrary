within Pharmacolibrary.Drugs.Substances;
package Trihexyphenidyl "trihexyphenidyl"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "trihexyphenidyl",
    atcCodes = {"N04AA01"},
    drugbankId = "DB00376",
    pubchemCid = "5572",
    chebiId = "9720",
    wikidataId = "Q2991856",
    formula = "C20H31NO",
    M = 0.301474,
    logP = 4.5);
  annotation (Documentation(info = "<html><body><p>Trihexyphenidyl is an anticholinergic (muscarinic antagonist) medicine used to treat Parkinson's disease and drug-induced movement disorders such as neuroleptic-related extrapyramidal symptoms and lingual-facial-buccal dyskinesia. It is an approved drug, though it is not authorised centrally in the European Union, and it is also being studied for investigational uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2991856\">Wikidata Q2991856</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>trihexyphenidyl</td></tr><tr><td>ATC codes:</td><td>N04AA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00376\">DB00376</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5572\">5572</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9720\">9720</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2991856\">Q2991856</a></td></tr><tr><td>formula:</td><td>C20H31NO</td></tr><tr><td>molar mass:</td><td>301.474 g/mol (PubChem CID 5572)</td></tr><tr><td>logP:</td><td>4.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Trihexyphenidyl;
