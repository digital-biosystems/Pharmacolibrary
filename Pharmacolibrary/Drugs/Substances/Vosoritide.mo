  annotation (Documentation(info = "<html><body><p>Vosoritide is a peptide drug used to treat achondroplasia, a condition affecting bone growth. It is authorised in the European Union and is also being investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q21098976&quot;>Wikidata Q21098976</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>vosoritide</td></tr><tr><td>ATC codes:</td><td>M05BX07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11928&quot;>DB11928</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/119058036&quot;>119058036</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q21098976&quot;>Q21098976</a></td></tr><tr><td>formula:</td><td>C176H290N56O51S3</td></tr><tr><td>molar mass:</td><td>4102.78 g/mol (PubChem)</td></tr></table></body></html>"));
