  annotation (Documentation(info = "<html><body><p>Vosoritide is a peptide drug used to treat achondroplasia, a condition affecting bone growth. It is authorised in the European Union and is also being investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q21098976\">Wikidata Q21098976</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>vosoritide</td></tr><tr><td>ATC codes:</td><td>M05BX07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11928\">DB11928</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q21098976\">Q21098976</a></td></tr><tr><td>molar mass:</td><td>4103 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>-20.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
