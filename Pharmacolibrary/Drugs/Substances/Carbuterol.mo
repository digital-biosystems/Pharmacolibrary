within Pharmacolibrary.Drugs.Substances;
package Carbuterol "carbuterol"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "carbuterol",
    atcCodes = {"R03AC10", "R03CC10"},
    drugbankId = "DB13625",
    pubchemCid = "36976",
    chebiId = "135100",
    wikidataId = "Q5038111",
    formula = "C13H21N3O3",
    M = 0.267329,
    logP = -0.1);
  annotation (Documentation(info = "<html><body><p>Carbuterol is a selective beta-2 adrenergic agonist developed for obstructive airway diseases such as asthma. It has remained experimental and does not appear to be an approved or marketed medicine in the European Union or elsewhere.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5038111&quot;>Wikidata Q5038111</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>carbuterol</td></tr><tr><td>ATC codes:</td><td>R03AC10, R03CC10</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13625&quot;>DB13625</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/36976&quot;>36976</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135100&quot;>135100</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5038111&quot;>Q5038111</a></td></tr><tr><td>formula:</td><td>C13H21N3O3</td></tr><tr><td>molar mass:</td><td>267.329 g/mol (PubChem)</td></tr></table></body></html>"));
end Carbuterol;
