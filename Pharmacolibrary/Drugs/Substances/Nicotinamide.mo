    logP = -0.4);
  annotation (Documentation(info = "<html><body><p>Nicotinamide, the amide form of vitamin B3, is used to treat and prevent pellagra. It is an approved vitamin preparation, listed among WHO essential medicines, and is widely available as a supplement.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q192423\">Wikidata Q192423</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nicotinamide</td></tr><tr><td>ATC codes:</td><td>A11HA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB02701\">DB02701</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/936\">936</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:17154\">17154</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q192423\">Q192423</a></td></tr><tr><td>formula:</td><td>C6H6N2O</td></tr><tr><td>molar mass:</td><td>122.127 g/mol (PubChem CID 936)</td></tr><tr><td>logP:</td><td>-0.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Nicotinamide;
