  annotation (Documentation(info = "<html><body><p>Flunisolide is a corticosteroid used to treat allergic rhinitis and other obstructive airway conditions such as asthma. It is an approved drug, available as nasal and inhaled preparations, though not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3746835\">Wikidata Q3746835</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>flunisolide</td></tr><tr><td>ATC codes:</td><td>R01AD04, R03BA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00180\">DB00180</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/82153\">82153</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:5106\">5106</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3746835\">Q3746835</a></td></tr><tr><td>formula:</td><td>C24H31FO6</td></tr><tr><td>molar mass:</td><td>434.504 g/mol (PubChem CID 82153)</td></tr><tr><td>logP:</td><td>2.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
