  annotation (Documentation(info = "<html><body><p>Tipranavir is a protease inhibitor antiviral used to treat HIV infection. It is an approved medicine authorised in the European Union for HIV, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q423404\">Wikidata Q423404</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>tipranavir</td></tr><tr><td>ATC codes:</td><td>J05AE09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00932\">DB00932</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/54682461\">54682461</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:63628\">63628</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q423404\">Q423404</a></td></tr><tr><td>formula:</td><td>C31H33F3N2O5S</td></tr><tr><td>molar mass:</td><td>602.668 g/mol (PubChem CID 54682461)</td></tr><tr><td>logP:</td><td>7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
