  annotation (Documentation(info = "<html><body><p>Laronidase is an enzyme replacement therapy used to treat mucopolysaccharidosis I, a rare inherited metabolic disorder. It is authorised in the European Union and is an approved medicine, used mainly in specialist care for this rare disease.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q20801774&quot;>Wikidata Q20801774</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>laronidase</td></tr><tr><td>ATC codes:</td><td>A16AB05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00090&quot;>DB00090</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q20801774&quot;>Q20801774</a></td></tr><tr><td>molar mass:</td><td>69899.4 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Laronidase;
