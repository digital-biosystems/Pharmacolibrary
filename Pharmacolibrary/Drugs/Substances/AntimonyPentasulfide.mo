  annotation (Documentation(info = "<html><body><p>Antimony pentasulfide has been classified as an expectorant for cough and cold preparations. It is considered experimental and there is no evidence of current authorised use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q420515\">Wikidata Q420515</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>antimony pentasulfide</td></tr><tr><td>ATC codes:</td><td>R05CA07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13473\">DB13473</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q420515\">Q420515</a></td></tr><tr><td>formula:</td><td>S5Sb2</td></tr><tr><td>molar mass:</td><td>403.82 g/mol (knowledgebase (DrugBank calculated))</td></tr></table></body></html>"));
