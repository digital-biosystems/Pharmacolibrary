    logP = 0);
  annotation (Documentation(info = "<html><body><p>Magnesium hydroxide is an antacid used for acid-related digestive problems such as heartburn, indigestion, peptic ulcers and reflux, and also as a treatment for constipation. It remains an approved, widely available over-the-counter medicine, commonly known as milk of magnesia.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q407548&quot;>Wikidata Q407548</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>magnesium hydroxide</td></tr><tr><td>ATC codes:</td><td>A02AA04, G04BX01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09104&quot;>DB09104</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/73981&quot;>73981</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6637&quot;>6637</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q407548&quot;>Q407548</a></td></tr><tr><td>formula:</td><td>H2MgO2</td></tr><tr><td>molar mass:</td><td>58.319 g/mol (PubChem)</td></tr></table></body></html>"));
end MagnesiumHydroxide;
