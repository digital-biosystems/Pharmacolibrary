    logP = 4.6);
  annotation (Documentation(info = "<html><body><p>Pleconaril is an antiviral agent that was developed for treating infections caused by picornaviruses, such as the common cold and enteroviral infections. It remains investigational and has not been approved for routine clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q770293&quot;>Wikidata Q770293</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pleconaril</td></tr><tr><td>ATC codes:</td><td>J05AX06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB05105&quot;>DB05105</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/1684&quot;>1684</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q770293&quot;>Q770293</a></td></tr><tr><td>formula:</td><td>C18H18F3N3O3</td></tr><tr><td>molar mass:</td><td>381.354 g/mol (PubChem)</td></tr></table></body></html>"));
end Pleconaril;
