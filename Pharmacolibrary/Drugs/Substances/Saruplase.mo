  annotation (Documentation(info = "<html><body><p>Saruplase is a fibrinolytic (clot-dissolving) enzyme classified as an antithrombotic agent, studied for dissolving blood clots. It is considered investigational and is not an approved medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7424731&quot;>Wikidata Q7424731</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>saruplase</td></tr><tr><td>ATC codes:</td><td>B01AD08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13646&quot;>DB13646</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7424731&quot;>Q7424731</a></td></tr></table></body></html>"));
end Saruplase;
