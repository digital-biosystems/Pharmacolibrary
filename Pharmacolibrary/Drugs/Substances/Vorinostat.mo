within Pharmacolibrary.Drugs.Substances;
package Vorinostat "vorinostat"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "vorinostat",
    atcCodes = {"L01XH01"},
    drugbankId = "DB02546",
    pubchemCid = "5311",
    chebiId = "45716",
    wikidataId = "Q905901",
    formula = "C14H20N2O3",
    M = 0.264325,
    logP = 1.9);
  annotation (Documentation(info = "<html><body><p>Vorinostat is a histone deacetylase inhibitor used as an anticancer drug, mainly for cutaneous T-cell lymphoma and studied in other blood cancers such as mycosis fungoides, acute myeloid leukemia, and lymphomas. It is an approved medicine, though an application for one product in the European Union was withdrawn, so its use is mainly outside the EU.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q905901&quot;>Wikidata Q905901</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>vorinostat</td></tr><tr><td>ATC codes:</td><td>L01XH01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB02546&quot;>DB02546</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5311&quot;>5311</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:45716&quot;>45716</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q905901&quot;>Q905901</a></td></tr><tr><td>formula:</td><td>C14H20N2O3</td></tr><tr><td>molar mass:</td><td>264.325 g/mol (PubChem)</td></tr></table></body></html>"));
end Vorinostat;
