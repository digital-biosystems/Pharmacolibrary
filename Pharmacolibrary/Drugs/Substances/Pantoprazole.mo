  annotation (Documentation(info = "<html><body><p>Pantoprazole is a proton-pump inhibitor used to treat acid-related stomach problems such as peptic ulcers, gastritis, gastroesophageal reflux disease, and Zollinger–Ellison syndrome. It is approved and widely used, with authorised products in the European Union mainly for reflux conditions.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q286846\">Wikidata Q286846</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>pantoprazole</td></tr><tr><td>ATC codes:</td><td>A02BC02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00213\">DB00213</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4679\">4679</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7915\">7915</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q286846\">Q286846</a></td></tr><tr><td>formula:</td><td>C16H15F2N3O4S</td></tr><tr><td>molar mass:</td><td>383.369 g/mol (PubChem CID 4679)</td></tr><tr><td>logP:</td><td>2.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Pantoprazole;
