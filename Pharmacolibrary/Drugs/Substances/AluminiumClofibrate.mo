  annotation (Documentation(info = "<html><body><p>Aluminium clofibrate is a fibrate, a type of lipid-modifying drug developed to lower blood lipid levels. It appears only as an experimental compound in drug databases and has no marketing authorisation recorded in the European Union, so it is not in routine medical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4737376&quot;>Wikidata Q4737376</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>aluminium clofibrate</td></tr><tr><td>ATC codes:</td><td>C10AB03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13780&quot;>DB13780</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31194&quot;>31194</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4737376&quot;>Q4737376</a></td></tr><tr><td>formula:</td><td>C20H21AlCl2O7</td></tr><tr><td>molar mass:</td><td>471.26 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
