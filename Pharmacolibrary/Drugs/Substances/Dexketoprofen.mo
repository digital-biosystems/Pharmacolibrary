within Pharmacolibrary.Drugs.Substances;
package Dexketoprofen "dexketoprofen"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "dexketoprofen",
    atcCodes = {"M01AE17", "M02AA27"},
    drugbankId = "DB09214",
    pubchemCid = "667550",
    chebiId = "76128",
    wikidataId = "Q425440",
    formula = "C16H14O3",
    M = 0.254285,
    logP = 3.1);
  annotation (Documentation(info = "<html><body><p>Dexketoprofen is an anti-inflammatory painkiller of the propionic acid class, related to ketoprofen, used to relieve pain and inflammation. It is available as tablets for systemic pain relief and as a topical preparation for muscular and joint pain, and is also combined with opioids for analgesia.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q425440\">Wikidata Q425440</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dexketoprofen</td></tr><tr><td>ATC codes:</td><td>M01AE17, M02AA27</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09214\">DB09214</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/667550\">667550</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:76128\">76128</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q425440\">Q425440</a></td></tr><tr><td>formula:</td><td>C16H14O3</td></tr><tr><td>molar mass:</td><td>254.285 g/mol (PubChem CID 667550)</td></tr><tr><td>logP:</td><td>3.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Dexketoprofen;
