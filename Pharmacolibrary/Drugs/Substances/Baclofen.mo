    logP = -1);
  annotation (Documentation(info = "<html><body><p>Baclofen is a centrally acting muscle relaxant used for spasticity and related neurological conditions such as multiple sclerosis, cerebral palsy, and spinal cord injury. It is an approved medicine in widespread use, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q413717\">Wikidata Q413717</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>baclofen</td></tr><tr><td>ATC codes:</td><td>M03BX01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00181\">DB00181</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2284\">2284</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:187893\">187893</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q413717\">Q413717</a></td></tr><tr><td>formula:</td><td>C10H12ClNO2</td></tr><tr><td>molar mass:</td><td>213.661 g/mol (PubChem CID 2284)</td></tr><tr><td>logP:</td><td>-1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
