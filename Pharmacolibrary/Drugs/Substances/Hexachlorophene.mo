    logP = 7.5);
  annotation (Documentation(info = "<html><body><p>Hexachlorophene is a phenol-derived antiseptic that was used to treat skin infections and acne. It has been withdrawn from use because of safety concerns, particularly neurological harm, and is no longer in general use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q425362\">Wikidata Q425362</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>hexachlorophene</td></tr><tr><td>ATC codes:</td><td>D08AE01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00756\">DB00756</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3598\">3598</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:5693\">5693</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q425362\">Q425362</a></td></tr><tr><td>formula:</td><td>C13H6Cl6O2</td></tr><tr><td>molar mass:</td><td>406.889 g/mol (PubChem CID 3598)</td></tr><tr><td>logP:</td><td>7.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Hexachlorophene;
