  annotation (Documentation(info = "<html><body><p>Almasilate is an antacid, a combination of aluminium and magnesium compounds, used for acid-related disorders of the stomach such as heartburn and indigestion. It is an approved medicine, but it does not appear to be authorised in the European Union and seems to be available only in a limited number of countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4733720\">Wikidata Q4733720</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>almasilate</td></tr><tr><td>ATC codes:</td><td>A02AD05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13595\">DB13595</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/131704329\">131704329</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4733720\">Q4733720</a></td></tr><tr><td>formula:</td><td>Al2H2MgO9Si2</td></tr><tr><td>molar mass:</td><td>280.446 g/mol (PubChem CID 131704329)</td></tr></table></body></html>"));
end Almasilate;
