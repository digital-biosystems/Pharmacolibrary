within Pharmacolibrary.Drugs.Substances;
package Eperisone "eperisone"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "eperisone",
    atcCodes = {"M03BX09"},
    drugbankId = "DB08992",
    pubchemCid = "3236",
    chebiId = "77070",
    wikidataId = "Q426401",
    formula = "C17H25NO",
    M = 0.259393,
    logP = 3.8);
  annotation (Documentation(info = "<html><body><p>Eperisone is a centrally acting muscle relaxant that has been used to treat muscle spasticity and related musculoskeletal conditions. It is not authorised in the European Union and is considered investigational in major drug databases, though it has been marketed in some Asian countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q426401\">Wikidata Q426401</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>eperisone</td></tr><tr><td>ATC codes:</td><td>M03BX09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08992\">DB08992</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3236\">3236</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:77070\">77070</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q426401\">Q426401</a></td></tr><tr><td>formula:</td><td>C17H25NO</td></tr><tr><td>molar mass:</td><td>259.393 g/mol (PubChem CID 3236)</td></tr><tr><td>logP:</td><td>3.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Eperisone;
