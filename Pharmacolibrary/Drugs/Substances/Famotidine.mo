    logP = -0.6);
  annotation (Documentation(info = "<html><body><p>Famotidine is an H2-receptor antagonist used for acid-related conditions such as gastroesophageal reflux disease, heartburn, stomach and duodenal ulcers, Zollinger–Ellison syndrome, and urticaria. It is an approved medicine, widely available over the counter and on prescription for these common digestive complaints.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q411159\">Wikidata Q411159</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>famotidine</td></tr><tr><td>ATC codes:</td><td>A02BA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00927\">DB00927</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3325\">3325</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4975\">4975</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q411159\">Q411159</a></td></tr><tr><td>formula:</td><td>C8H15N7O2S3</td></tr><tr><td>molar mass:</td><td>337.435 g/mol (PubChem CID 3325)</td></tr><tr><td>logP:</td><td>-0.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Famotidine;
