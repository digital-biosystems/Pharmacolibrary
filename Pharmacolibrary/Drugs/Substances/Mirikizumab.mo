  annotation (Documentation(info = "<html><body><p>Mirikizumab, a monoclonal antibody that blocks interleukin signalling, is used to treat ulcerative colitis. It is approved and authorised in the European Union, and remains under investigation for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q55641096\">Wikidata Q55641096</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>mirikizumab</td></tr><tr><td>ATC codes:</td><td>L04AC24</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB14910\">DB14910</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q55641096\">Q55641096</a></td></tr><tr><td>molar mass:</td><td>147000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Mirikizumab;
