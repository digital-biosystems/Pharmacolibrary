    logP = 0.5);
  annotation (Documentation(info = "<html><body><p>Methoxamine is a sympathomimetic alpha-1 agonist that acts as a vasoconstrictor and was used in cardiac therapy to raise blood pressure. It has been withdrawn from use and is no longer widely available.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q685119\">Wikidata Q685119</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>methoxamine</td></tr><tr><td>ATC codes:</td><td>C01CA10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00723\">DB00723</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6082\">6082</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6839\">6839</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q685119\">Q685119</a></td></tr><tr><td>formula:</td><td>C11H17NO3</td></tr><tr><td>molar mass:</td><td>211.261 g/mol (PubChem CID 6082)</td></tr><tr><td>logP:</td><td>0.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
