  annotation (Documentation(info = "<html><body><p>Florbetaben (18F) is a diagnostic radiopharmaceutical used in radionuclide imaging of the brain in Alzheimer's disease. It is authorised in the European Union and used in specialist imaging settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q17014149\">Wikidata Q17014149</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>florbetaben (18F)</td></tr><tr><td>ATC codes:</td><td>V09AX06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09148\">DB09148</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q17014149\">Q17014149</a></td></tr><tr><td>molar mass:</td><td>358.4 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>4.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
