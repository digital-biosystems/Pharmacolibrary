within Pharmacolibrary.Drugs.Substances;
package MetrizoicAcid "metrizoic acid"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "metrizoic acid",
    atcCodes = {"V08AA02"},
    drugbankId = "DB09346",
    pubchemCid = "2528",
    chebiId = "34847",
    wikidataId = "Q6824400",
    formula = "C12H11I3N2O4",
    M = 0.62793,
    logP = 1.9);
  annotation (Documentation(info = "<html><body><p>Metrizoic acid is an iodinated, water-soluble, high-osmolar X-ray contrast agent used in imaging examinations. It is an approved contrast medium, though information on how widely it is used today is limited.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6824400\">Wikidata Q6824400</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>metrizoic acid</td></tr><tr><td>ATC codes:</td><td>V08AA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09346\">DB09346</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2528\">2528</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:34847\">34847</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6824400\">Q6824400</a></td></tr><tr><td>formula:</td><td>C12H11I3N2O4</td></tr><tr><td>molar mass:</td><td>627.93 g/mol (PubChem CID 2528)</td></tr><tr><td>logP:</td><td>1.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end MetrizoicAcid;
