    logP = 2.6);
  annotation (Documentation(info = "<html><body><p>Gestonorone is a progestogen that has been classified for use in hormone-related conditions and as an endocrine therapy for cancer. It is not an approved medicine and remains only an experimental drug, with no authorisation by the European Medicines Agency.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5553699&quot;>Wikidata Q5553699</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>gestonorone</td></tr><tr><td>ATC codes:</td><td>G03DA01, L02AB03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13230&quot;>DB13230</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/102210&quot;>102210</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135991&quot;>135991</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5553699&quot;>Q5553699</a></td></tr><tr><td>formula:</td><td>C20H28O3</td></tr><tr><td>molar mass:</td><td>316.441 g/mol (PubChem)</td></tr></table></body></html>"));
end Gestonorone;
