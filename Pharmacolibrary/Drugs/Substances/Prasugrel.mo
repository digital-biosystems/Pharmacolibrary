  annotation (Documentation(info = "<html><body><p>Prasugrel is a platelet inhibitor used to prevent blood clots in people with acute coronary syndrome, including myocardial infarction and unstable angina. It is an approved antiplatelet medicine authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q416232&quot;>Wikidata Q416232</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>prasugrel</td></tr><tr><td>ATC codes:</td><td>B01AC22</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06209&quot;>DB06209</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6918456&quot;>6918456</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:87723&quot;>87723</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q416232&quot;>Q416232</a></td></tr><tr><td>formula:</td><td>C20H20FNO3S</td></tr><tr><td>molar mass:</td><td>373.442 g/mol (PubChem)</td></tr></table></body></html>"));
