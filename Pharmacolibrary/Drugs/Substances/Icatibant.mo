  annotation (Documentation(info = "<html><body><p>Icatibant is a bradykinin B2 receptor antagonist used to treat hereditary angioedema attacks. It is authorised in the European Union and used for this condition.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q902379\">Wikidata Q902379</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>icatibant</td></tr><tr><td>ATC codes:</td><td>B06AC02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06196\">DB06196</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/71364\">71364</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:68556\">68556</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q902379\">Q902379</a></td></tr><tr><td>molar mass:</td><td>1304.5 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>-6.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
