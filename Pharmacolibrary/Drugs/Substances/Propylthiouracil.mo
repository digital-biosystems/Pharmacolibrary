  annotation (Documentation(info = "<html><body><p>Propylthiouracil is an antithyroid medicine used to treat hyperthyroidism, goiter, and thyroid crisis. It remains an approved antithyroid drug, though it carries a boxed warning, meaning its use requires careful monitoring.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q377342\">Wikidata Q377342</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>propylthiouracil</td></tr><tr><td>ATC codes:</td><td>H03BA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00550\">DB00550</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/657298\">657298</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8502\">8502</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q377342\">Q377342</a></td></tr><tr><td>formula:</td><td>C7H10N2OS</td></tr><tr><td>molar mass:</td><td>170.23 g/mol (PubChem CID 657298)</td></tr><tr><td>logP:</td><td>0.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
