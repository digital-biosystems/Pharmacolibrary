  annotation (Documentation(info = "<html><body><p>Sodium perborate is an antiseptic used for local oral treatment, for example in stomatological preparations for mouth conditions. It is an approved drug, though no European Union authorisation is recorded in the available facts.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q415507\">Wikidata Q415507</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sodium perborate</td></tr><tr><td>ATC codes:</td><td>A01AB19</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13235\">DB13235</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:30175\">30175</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q415507\">Q415507</a></td></tr><tr><td>formula:</td><td>BHO3</td></tr><tr><td>molar mass:</td><td>59.82 g/mol (knowledgebase (DrugBank calculated))</td></tr></table><p><small>Drugs.Common 25.09 gave 81.8 g/mol (+36.7 %); replaced by the value above</small></p></body></html>"));
