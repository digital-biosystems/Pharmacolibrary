within Pharmacolibrary.Drugs.Substances;
package CalciumGlucoheptonate "calcium glucoheptonate"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "calcium glucoheptonate",
    atcCodes = {"A12AA10"},
    drugbankId = "DB00326",
    pubchemCid = "62859",
    chebiId = "3314",
    wikidataId = "Q5018826",
    formula = "C14H26CaO16",
    M = 0.490424);
  annotation (Documentation(info = "<html><body><p>Calcium glucoheptonate is a calcium supplement used for conditions involving low calcium or needing extra calcium, such as osteoporosis, tetany, indigestion, heartburn, peptic ulcers, and cardiac arrest. It is an approved medicine, though it does not appear to be authorised centrally in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5018826\">Wikidata Q5018826</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>calcium glucoheptonate</td></tr><tr><td>ATC codes:</td><td>A12AA10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00326\">DB00326</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/62859\">62859</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3314\">3314</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5018826\">Q5018826</a></td></tr><tr><td>formula:</td><td>C14H26CaO16</td></tr><tr><td>molar mass:</td><td>490.424 g/mol (PubChem CID 62859)</td></tr></table></body></html>"));
end CalciumGlucoheptonate;
