  annotation (Documentation(info = "<html><body><p>Crisaborole is a skin ointment used to treat dermatitis, especially atopic dermatitis. It is an approved drug, though its marketing authorisation in the European Union was withdrawn, so its use is mainly outside the EU.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q21098894&quot;>Wikidata Q21098894</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>crisaborole</td></tr><tr><td>ATC codes:</td><td>D11AH06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB05219&quot;>DB05219</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/44591583&quot;>44591583</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134677&quot;>134677</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q21098894&quot;>Q21098894</a></td></tr><tr><td>formula:</td><td>C14H10BNO3</td></tr><tr><td>molar mass:</td><td>251.048 g/mol (PubChem)</td></tr></table></body></html>"));
end Crisaborole;
