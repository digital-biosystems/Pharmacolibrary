    logP = -2.1);
  annotation (Documentation(info = "<html><body><p>Telavancin is a lipoglycopeptide antibiotic used to treat bacterial pneumonia and other serious infections such as staphylococcal, skin, and soft tissue infections. It remains an approved medicine, but its marketing authorisation in the European Union was withdrawn, so it is no longer available there.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7695658\">Wikidata Q7695658</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>telavancin</td></tr><tr><td>ATC codes:</td><td>J01XA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06402\">DB06402</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3081362\">3081362</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:71229\">71229</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7695658\">Q7695658</a></td></tr><tr><td>formula:</td><td>C80H106Cl2N11O27P</td></tr><tr><td>molar mass:</td><td>1755.65 g/mol (PubChem CID 3081362)</td></tr><tr><td>logP:</td><td>-2.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Telavancin;
