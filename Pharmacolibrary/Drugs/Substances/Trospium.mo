  annotation (Documentation(info = "<html><body><p>Trospium is a muscarinic antagonist used as an antispasmodic and to treat urinary frequency and incontinence. It is an approved drug, used mainly for overactive bladder and gastrointestinal spasms.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q513396\">Wikidata Q513396</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>trospium</td></tr><tr><td>ATC codes:</td><td>G04BD09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00209\">DB00209</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5284632\">5284632</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:145791\">145791</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q513396\">Q513396</a></td></tr><tr><td>formula:</td><td>C25H30NO3+</td></tr><tr><td>molar mass:</td><td>392.519 g/mol (PubChem CID 5284632)</td></tr><tr><td>logP:</td><td>4.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Trospium;
