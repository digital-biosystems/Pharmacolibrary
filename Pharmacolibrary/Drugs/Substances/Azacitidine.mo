within Pharmacolibrary.Drugs.Substances;
package Azacitidine "azacitidine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "azacitidine",
    atcCodes = {"L01BC07"},
    drugbankId = "DB00928",
    pubchemCid = "9444",
    chebiId = "2038",
    wikidataId = "Q416451",
    formula = "C8H12N4O5",
    M = 0.244207,
    logP = -2.2);
  annotation (Documentation(info = "<html><body><p>Azacitidine is an anticancer antimetabolite used to treat blood cancers such as myelodysplastic syndrome, acute myeloid leukemia, and chronic myelomonocytic leukemia. It is approved and authorised in the European Union, with several authorised products, and is also being studied for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q416451\">Wikidata Q416451</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>azacitidine</td></tr><tr><td>ATC codes:</td><td>L01BC07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00928\">DB00928</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9444\">9444</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:2038\">2038</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q416451\">Q416451</a></td></tr><tr><td>formula:</td><td>C8H12N4O5</td></tr><tr><td>molar mass:</td><td>244.207 g/mol (PubChem CID 9444)</td></tr><tr><td>logP:</td><td>-2.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Azacitidine;
