    wikidataId = "Q121945069");
  annotation (Documentation(info = "<html><body><p>Avacincaptad pegol is an eye medication developed for macular degeneration, specifically geographic atrophy. It is approved in the United States but remains investigational in Europe, where a marketing application was withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q121945069\">Wikidata Q121945069</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>avacincaptad pegol</td></tr><tr><td>ATC codes:</td><td>S01XA32</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB15165\">DB15165</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q121945069\">Q121945069</a></td></tr></table></body></html>"));
end AvacincaptadPegol;
