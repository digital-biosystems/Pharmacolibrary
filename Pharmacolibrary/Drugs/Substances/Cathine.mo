  annotation (Documentation(info = "<html><body><p>Cathine is classified as a centrally acting antiobesity preparation, indicating use against obesity. It is not an established medicine: databases list it as experimental and illicit, so its use is effectively restricted or prohibited rather than widely approved.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q423797\">Wikidata Q423797</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cathine</td></tr><tr><td>ATC codes:</td><td>A08AA07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01486\">DB01486</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/441457\">441457</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4109\">4109</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q423797\">Q423797</a></td></tr><tr><td>formula:</td><td>C9H13NO</td></tr><tr><td>molar mass:</td><td>151.209 g/mol (PubChem CID 441457)</td></tr><tr><td>logP:</td><td>0.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
