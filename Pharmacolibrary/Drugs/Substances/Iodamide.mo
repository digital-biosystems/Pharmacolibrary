  annotation (Documentation(info = "<html><body><p>Iodamide is an iodinated, water-soluble X-ray contrast agent formerly used to visualise body structures during imaging examinations. It has been withdrawn and is no longer in clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3801333&quot;>Wikidata Q3801333</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>iodamide</td></tr><tr><td>ATC codes:</td><td>V08AA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08948&quot;>DB08948</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3723&quot;>3723</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31703&quot;>31703</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3801333&quot;>Q3801333</a></td></tr><tr><td>formula:</td><td>C12H11I3N2O4</td></tr><tr><td>molar mass:</td><td>627.93 g/mol (PubChem)</td></tr></table></body></html>"));
