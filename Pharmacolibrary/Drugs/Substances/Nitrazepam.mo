    logP = 2.2);
  annotation (Documentation(info = "<html><body><p>Nitrazepam is a benzodiazepine sedative used as a hypnotic for insomnia, and it also has anxiolytic and anticonvulsant properties. It is an approved medicine and remains in use as a hypnotic and sedative, though it is not authorised through the European Medicines Agency.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q410078\">Wikidata Q410078</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nitrazepam</td></tr><tr><td>ATC codes:</td><td>N05CD02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01595\">DB01595</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4506\">4506</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7581\">7581</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q410078\">Q410078</a></td></tr><tr><td>formula:</td><td>C15H11N3O3</td></tr><tr><td>molar mass:</td><td>281.271 g/mol (PubChem CID 4506)</td></tr><tr><td>logP:</td><td>2.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Nitrazepam;
