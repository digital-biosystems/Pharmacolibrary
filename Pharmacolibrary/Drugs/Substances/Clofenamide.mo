    M = 0.270702,
    logP = -0.7);
  annotation (Documentation(info = "<html><body><p>Clofenamide is a sulfonamide diuretic, a low-ceiling diuretic related to the thiazides, that was classified for use as a diuretic. It appears only as an experimental drug and is not an authorised medicine in the European Union, so it is not in routine clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5134876\">Wikidata Q5134876</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>clofenamide</td></tr><tr><td>ATC codes:</td><td>C03BA07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13663\">DB13663</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/69594\">69594</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31418\">31418</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5134876\">Q5134876</a></td></tr><tr><td>formula:</td><td>C6H7ClN2O4S2</td></tr><tr><td>molar mass:</td><td>270.702 g/mol (PubChem CID 69594)</td></tr><tr><td>logP:</td><td>-0.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Clofenamide;
