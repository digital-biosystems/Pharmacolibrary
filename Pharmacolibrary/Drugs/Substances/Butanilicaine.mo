  annotation (Documentation(info = "<html><body><p>Butanilicaine is an amide-type local anesthetic. It is not an established marketed medicine and is regarded as experimental, with no EU authorisation on record.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5002356&quot;>Wikidata Q5002356</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>butanilicaine</td></tr><tr><td>ATC codes:</td><td>N01BB05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13328&quot;>DB13328</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/22379&quot;>22379</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:55518&quot;>55518</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5002356&quot;>Q5002356</a></td></tr><tr><td>formula:</td><td>C13H19ClN2O</td></tr><tr><td>molar mass:</td><td>254.758 g/mol (PubChem)</td></tr></table></body></html>"));
