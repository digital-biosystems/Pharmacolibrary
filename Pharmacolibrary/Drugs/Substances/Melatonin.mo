within Pharmacolibrary.Drugs.Substances;
package Melatonin "melatonin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "melatonin",
    atcCodes = {"N05CH01"},
    drugbankId = "DB01065",
    pubchemCid = "896",
    chebiId = "16796",
    wikidataId = "Q180912",
    formula = "C13H16N2O2",
    M = 0.232283,
    logP = 0.8);
  annotation (Documentation(info = "<html><body><p>Melatonin, a hormone made by the pineal gland, is used as a hypnotic for sleep problems such as jet lag, and in the EU also for sleep disorders in autism. It is widely used, with authorised products in the European Union, and is also available as a supplement and approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q180912\">Wikidata Q180912</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>melatonin</td></tr><tr><td>ATC codes:</td><td>N05CH01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01065\">DB01065</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/896\">896</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:16796\">16796</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q180912\">Q180912</a></td></tr><tr><td>formula:</td><td>C13H16N2O2</td></tr><tr><td>molar mass:</td><td>232.283 g/mol (PubChem CID 896)</td></tr><tr><td>logP:</td><td>0.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Melatonin;
