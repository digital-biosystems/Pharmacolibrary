  annotation (Documentation(info = "<html><body><p>Etripamil is a phenylalkylamine calcium channel blocker, a drug class used for heart conditions. It is not yet an established treatment; it is listed as investigational and has no European Union authorisation recorded.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27289030\">Wikidata Q27289030</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>etripamil</td></tr><tr><td>ATC codes:</td><td>C08DA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12605\">DB12605</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/91824132\">91824132</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27289030\">Q27289030</a></td></tr><tr><td>formula:</td><td>C27H36N2O4</td></tr><tr><td>molar mass:</td><td>452.595 g/mol (PubChem CID 91824132)</td></tr></table></body></html>"));
