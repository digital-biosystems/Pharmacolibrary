  annotation (Documentation(info = "<html><body><p>Ertugliflozin is a blood-glucose-lowering medicine (an SGLT2 inhibitor) used to treat type 2 diabetes. It is authorised in the European Union and is available both alone and in combination products with other oral diabetes drugs.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27077223&quot;>Wikidata Q27077223</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>ertugliflozin</td></tr><tr><td>ATC codes:</td><td>A10BK04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11827&quot;>DB11827</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/44814423&quot;>44814423</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:188719&quot;>188719</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27077223&quot;>Q27077223</a></td></tr><tr><td>formula:</td><td>C22H25ClO7</td></tr><tr><td>molar mass:</td><td>436.885 g/mol (PubChem)</td></tr></table></body></html>"));
