  annotation (Documentation(info = "<html><body><p>Dexchlorpheniramine is an antihistamine (H1 antagonist, related to chlorpheniramine) used to treat allergic conditions. It is classified as investigational in DrugBank and has no EU marketing authorisation, so it is not widely used today.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q937085&quot;>Wikidata Q937085</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dexchlorpheniramine</td></tr><tr><td>ATC codes:</td><td>R06AB02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13679&quot;>DB13679</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/33036&quot;>33036</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4464&quot;>4464</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q937085&quot;>Q937085</a></td></tr><tr><td>formula:</td><td>C16H19ClN2</td></tr><tr><td>molar mass:</td><td>274.792 g/mol (PubChem)</td></tr></table></body></html>"));
end Dexchlorpheniramine;
