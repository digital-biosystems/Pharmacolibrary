  annotation (Documentation(info = "<html><body><p>Indium-111 capromab pendetide is a radiolabelled monoclonal antibody imaging agent used to detect prostate cancer. It was approved but has since been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3798313\">Wikidata Q3798313</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>indium (111In) capromab pendetide</td></tr><tr><td>ATC codes:</td><td>V09IB04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00089\">DB00089</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3798313\">Q3798313</a></td></tr></table></body></html>"));
