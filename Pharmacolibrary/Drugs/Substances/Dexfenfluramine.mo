  annotation (Documentation(info = "<html><body><p>Dexfenfluramine was a centrally acting antiobesity drug used to help with weight loss in obesity. It is no longer used; it was withdrawn from the market after being linked to serious heart valve damage.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3025599&quot;>Wikidata Q3025599</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dexfenfluramine</td></tr><tr><td>ATC codes:</td><td>A08AA04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01191&quot;>DB01191</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/66265&quot;>66265</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:439329&quot;>439329</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3025599&quot;>Q3025599</a></td></tr><tr><td>formula:</td><td>C12H16F3N</td></tr><tr><td>molar mass:</td><td>231.261 g/mol (PubChem)</td></tr></table></body></html>"));
