  annotation (Documentation(info = "<html><body><p>Sulfadiazine is a sulfonamide antibiotic used to treat infections such as toxoplasmosis, urinary tract infections, nocardiosis, malaria, and gram-negative bacterial infections. It remains in use, is listed among WHO essential medicines, and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2555060&quot;>Wikidata Q2555060</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sulfadiazine</td></tr><tr><td>ATC codes:</td><td>J01EC02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00359&quot;>DB00359</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5215&quot;>5215</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9328&quot;>9328</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2555060&quot;>Q2555060</a></td></tr><tr><td>formula:</td><td>C10H10N4O2S</td></tr><tr><td>molar mass:</td><td>250.276 g/mol (PubChem)</td></tr></table></body></html>"));
