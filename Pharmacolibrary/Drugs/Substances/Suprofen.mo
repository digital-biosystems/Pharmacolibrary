    logP = 3.3);
  annotation (Documentation(info = "<html><body><p>Suprofen is a non-steroidal anti-inflammatory drug of the propionic acid type that was used to treat pain and inflammation. It has been withdrawn from the market, reportedly because it caused kidney-related side effects such as flank pain.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3978097\">Wikidata Q3978097</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>suprofen</td></tr><tr><td>ATC codes:</td><td>M01AE07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00870\">DB00870</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5359\">5359</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9362\">9362</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3978097\">Q3978097</a></td></tr><tr><td>formula:</td><td>C14H12O3S</td></tr><tr><td>molar mass:</td><td>260.307 g/mol (PubChem CID 5359)</td></tr><tr><td>logP:</td><td>3.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Suprofen;
