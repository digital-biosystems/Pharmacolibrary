  annotation (Documentation(info = "<html><body><p>Tenonitrozole is an antiprotozoal drug that has been used to treat trichomoniasis. It is not an approved medicine today and appears only as an experimental compound, so it is no longer in routine use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7700556\">Wikidata Q7700556</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tenonitrozole</td></tr><tr><td>ATC codes:</td><td>P01AX08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13659\">DB13659</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/19646\">19646</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135042\">135042</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7700556\">Q7700556</a></td></tr><tr><td>formula:</td><td>C8H5N3O3S2</td></tr><tr><td>molar mass:</td><td>255.266 g/mol (PubChem CID 19646)</td></tr><tr><td>logP:</td><td>3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
