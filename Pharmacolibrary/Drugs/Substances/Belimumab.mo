  annotation (Documentation(info = "<html><body><p>Belimumab is a monoclonal antibody immunosuppressant used to treat systemic lupus erythematosus, including lupus nephritis. It is authorised in the European Union and is an approved medicine, used mainly for lupus.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1996249\">Wikidata Q1996249</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>belimumab</td></tr><tr><td>ATC codes:</td><td>L04AG04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08879\">DB08879</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1996249\">Q1996249</a></td></tr><tr><td>molar mass:</td><td>147000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Belimumab;
