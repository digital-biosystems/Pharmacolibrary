  annotation (Documentation(info = "<html><body><p>Succinylsulfathiazole is a sulfonamide classified as an intestinal antiinfective, historically used to treat gut infections such as diarrhea. It is not an approved medicine today and is considered investigational, with no marketing authorization in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3976577&quot;>Wikidata Q3976577</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>succinylsulfathiazole</td></tr><tr><td>ATC codes:</td><td>A07AB04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13580&quot;>DB13580</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5315&quot;>5315</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9309&quot;>9309</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3976577&quot;>Q3976577</a></td></tr><tr><td>formula:</td><td>C13H13N3O5S2</td></tr><tr><td>molar mass:</td><td>355.383 g/mol (PubChem)</td></tr></table></body></html>"));
