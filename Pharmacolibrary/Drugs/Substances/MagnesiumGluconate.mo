  annotation (Documentation(info = "<html><body><p>Magnesium gluconate is a magnesium mineral supplement that was used to treat or prevent low magnesium levels. It is no longer marketed, having been withdrawn, though it was once an approved product.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6731392\">Wikidata Q6731392</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>magnesium gluconate</td></tr><tr><td>ATC codes:</td><td>A12CC03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13749\">DB13749</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/71587201\">71587201</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6731392\">Q6731392</a></td></tr><tr><td>formula:</td><td>C12H26MgO16</td></tr><tr><td>molar mass:</td><td>450.629 g/mol (PubChem CID 71587201)</td></tr></table></body></html>"));
end MagnesiumGluconate;
