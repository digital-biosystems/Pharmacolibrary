  annotation (Documentation(info = "<html><body><p>Iobenguane is a radiopharmaceutical used both to detect certain tumours in nuclear imaging and, in a radioactive iodine form, for treatment. It is an approved medicine and is also being studied for further uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27286037\">Wikidata Q27286037</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Iobenguane</td></tr><tr><td>ATC codes:</td><td>V09IX01, V09IX02, V10XA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06704\">DB06704</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/60860\">60860</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27286037\">Q27286037</a></td></tr><tr><td>formula:</td><td>C8H10IN3</td></tr><tr><td>molar mass:</td><td>275.089 g/mol (PubChem CID 60860)</td></tr></table></body></html>"));
end Iobenguane;
