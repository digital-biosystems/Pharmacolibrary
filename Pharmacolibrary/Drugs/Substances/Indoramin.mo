  annotation (Documentation(info = "<html><body><p>Indoramin is an alpha-1 adrenergic blocker that was used to treat high blood pressure and enlarged prostate. It has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q408963\">Wikidata Q408963</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>indoramin</td></tr><tr><td>ATC codes:</td><td>C02CA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08950\">DB08950</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/33625\">33625</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135470\">135470</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q408963\">Q408963</a></td></tr><tr><td>formula:</td><td>C22H25N3O</td></tr><tr><td>molar mass:</td><td>347.462 g/mol (PubChem CID 33625)</td></tr><tr><td>logP:</td><td>4.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
