  annotation (Documentation(info = "<html><body><p>Verapamil is a calcium channel blocker used to treat cardiovascular conditions such as high blood pressure, angina, and certain heart rhythm problems like atrial fibrillation and supraventricular tachycardia. It is an approved medicine and appears on the WHO list of essential medicines, so it is widely used worldwide.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q410291\">Wikidata Q410291</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>verapamil</td></tr><tr><td>ATC codes:</td><td>C08DA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00661\">DB00661</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2520\">2520</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:77733\">77733</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q410291\">Q410291</a></td></tr><tr><td>formula:</td><td>C27H38N2O4</td></tr><tr><td>molar mass:</td><td>454.611 g/mol (PubChem CID 2520)</td></tr><tr><td>logP:</td><td>3.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Verapamil;
