    logP = -1.9);
  annotation (Documentation(info = "<html><body><p>Cefonicid is a second-generation cephalosporin antibiotic used to treat bacterial infections. It is an approved antibacterial for systemic use, though it does not appear to be authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5057286\">Wikidata Q5057286</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cefonicid</td></tr><tr><td>ATC codes:</td><td>J01DC06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01328\">DB01328</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/43594\">43594</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3491\">3491</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5057286\">Q5057286</a></td></tr><tr><td>formula:</td><td>C18H18N6O8S3</td></tr><tr><td>molar mass:</td><td>542.556 g/mol (PubChem CID 43594)</td></tr><tr><td>logP:</td><td>-1.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Cefonicid;
