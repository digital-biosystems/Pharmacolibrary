  annotation (Documentation(info = "<html><body><p>Alvimopan is a peripheral opioid receptor antagonist used to treat constipation, notably opioid-induced bowel dysfunction. It is an approved medicine, mainly used in the United States, and is not authorised in the European Union; it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4738021\">Wikidata Q4738021</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>alvimopan</td></tr><tr><td>ATC codes:</td><td>A06AH02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06274\">DB06274</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5488548\">5488548</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135686\">135686</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4738021\">Q4738021</a></td></tr><tr><td>formula:</td><td>C25H32N2O4</td></tr><tr><td>molar mass:</td><td>424.541 g/mol (PubChem CID 5488548)</td></tr><tr><td>logP:</td><td>1.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
