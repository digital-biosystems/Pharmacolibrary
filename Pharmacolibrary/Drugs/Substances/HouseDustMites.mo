within Pharmacolibrary.Drugs.Substances;
package HouseDustMites "house dust mites"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "house dust mites",
    atcCodes = {"V01AA03"},
    drugbankId = "DB10400");
  annotation (Documentation(info = "<html><body><p>House dust mite extract (Dermatophagoides farinae) is an allergen extract used in allergy testing and immunotherapy for house dust mite allergy. It is an approved allergen preparation, though some related products remain investigational.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>house dust mites</td></tr><tr><td>ATC codes:</td><td>V01AA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB10400&quot;>DB10400</a></td></tr></table></body></html>"));
end HouseDustMites;
