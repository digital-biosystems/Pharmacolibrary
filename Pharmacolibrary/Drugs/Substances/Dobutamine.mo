  annotation (Documentation(info = "<html><body><p>Dobutamine is a cardiotonic sympathomimetic drug used to treat heart disease. It is an approved medication given as a cardiac stimulant, typically in hospital settings for acute heart conditions.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q422782&quot;>Wikidata Q422782</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dobutamine</td></tr><tr><td>ATC codes:</td><td>C01CA07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00841&quot;>DB00841</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/36811&quot;>36811</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4670&quot;>4670</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q422782&quot;>Q422782</a></td></tr><tr><td>formula:</td><td>C18H23NO3</td></tr><tr><td>molar mass:</td><td>301.386 g/mol (PubChem)</td></tr></table></body></html>"));
