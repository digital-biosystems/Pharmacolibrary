  annotation (Documentation(info = "<html><body><p>Pramocaine is a topical local anesthetic used to relieve pain and itching from hemorrhoids, contact dermatitis, and other minor skin conditions. It is an approved drug, used mainly in topical preparations for hemorrhoids and skin itching.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1240076\">Wikidata Q1240076</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pramocaine</td></tr><tr><td>ATC codes:</td><td>C05AD07, D04AB07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09345\">DB09345</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4886\">4886</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8357\">8357</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1240076\">Q1240076</a></td></tr><tr><td>formula:</td><td>C17H27NO3</td></tr><tr><td>molar mass:</td><td>293.407 g/mol (PubChem CID 4886)</td></tr><tr><td>logP:</td><td>3.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
