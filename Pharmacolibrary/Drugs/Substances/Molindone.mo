  annotation (Documentation(info = "<html><body><p>Molindone is an antipsychotic used to treat schizophrenia and schizophreniform disorder. It is an approved medication, but it is not authorised in the European Union and appears to be used only in a limited number of countries.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q593166&quot;>Wikidata Q593166</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>molindone</td></tr><tr><td>ATC codes:</td><td>N05AE02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01618&quot;>DB01618</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/23897&quot;>23897</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6965&quot;>6965</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q593166&quot;>Q593166</a></td></tr><tr><td>formula:</td><td>C16H24N2O2</td></tr><tr><td>molar mass:</td><td>276.38 g/mol (PubChem)</td></tr></table></body></html>"));
