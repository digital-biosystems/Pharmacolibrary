  annotation (Documentation(info = "<html><body><p>G-Strophanthin (ouabain) is a cardiac glycoside used as a cardiotonic agent, mainly for heart conditions such as heart failure. It is an approved medicine, but it is not widely used today and is employed mainly in a few countries, often by injection in hospital settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q285911\">Wikidata Q285911</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>g-strophanthin</td></tr><tr><td>ATC codes:</td><td>C01AC01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01092\">DB01092</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/439501\">439501</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q285911\">Q285911</a></td></tr><tr><td>formula:</td><td>C29H44O12</td></tr><tr><td>molar mass:</td><td>584.659 g/mol (PubChem CID 439501)</td></tr><tr><td>logP:</td><td>-1.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end GStrophanthin;
