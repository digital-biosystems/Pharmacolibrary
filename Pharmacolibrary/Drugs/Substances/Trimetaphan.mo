    logP = 3.6);
  annotation (Documentation(info = "<html><body><p>Trimetaphan is a ganglion-blocking antihypertensive drug used to treat arterial hypertension and as an adjuvant in anesthesia. It is an approved drug, but its use today is uncommon and largely limited to specialised hospital settings for rapid blood-pressure control.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q9361596\">Wikidata Q9361596</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>trimetaphan</td></tr><tr><td>ATC codes:</td><td>C02BA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01116\">DB01116</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/23576\">23576</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q9361596\">Q9361596</a></td></tr><tr><td>formula:</td><td>C22H25N2OS+</td></tr><tr><td>molar mass:</td><td>365.515 g/mol (PubChem CID 23576)</td></tr><tr><td>logP:</td><td>3.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Trimetaphan;
