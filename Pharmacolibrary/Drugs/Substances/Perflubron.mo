  annotation (Documentation(info = "<html><body><p>Perflubron is a fluorinated contrast agent investigated for use as an imaging contrast medium, and it has also been studied as a radiosensitizer and anti-obesity medication. It remains investigational and is not an approved medicine in the European Union or elsewhere.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2190150\">Wikidata Q2190150</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>perflubron</td></tr><tr><td>ATC codes:</td><td>V08CX01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB05791\">DB05791</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9873\">9873</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:38803\">38803</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2190150\">Q2190150</a></td></tr><tr><td>formula:</td><td>C8BrF17</td></tr><tr><td>molar mass:</td><td>498.958 g/mol (PubChem CID 9873)</td></tr><tr><td>logP:</td><td>6.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
