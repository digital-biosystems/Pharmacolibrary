  annotation (Documentation(info = "<html><body><p>Vedolizumab is a monoclonal antibody immunosuppressant used to treat ulcerative colitis and Crohn's disease. It is authorised in the European Union and is also being investigated for other conditions such as graft-versus-host disease.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7918002\">Wikidata Q7918002</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>vedolizumab</td></tr><tr><td>ATC codes:</td><td>L04AG05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09033\">DB09033</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7918002\">Q7918002</a></td></tr><tr><td>molar mass:</td><td>146837 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Vedolizumab;
