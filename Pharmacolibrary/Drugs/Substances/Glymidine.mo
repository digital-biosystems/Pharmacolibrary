  annotation (Documentation(info = "<html><body><p>Glymidine is a blood glucose lowering drug of the sulfonamide class used in the treatment of diabetes. It is an approved drug, but appears to be little used today and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5572813\">Wikidata Q5572813</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>glymidine</td></tr><tr><td>ATC codes:</td><td>A10BC01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01382\">DB01382</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9565\">9565</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:146188\">146188</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5572813\">Q5572813</a></td></tr><tr><td>formula:</td><td>C13H15N3O4S</td></tr><tr><td>molar mass:</td><td>309.34 g/mol (PubChem CID 9565)</td></tr><tr><td>logP:</td><td>0.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
