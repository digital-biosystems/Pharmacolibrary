within Pharmacolibrary.Drugs.Substances;
package Tobramycin "tobramycin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "tobramycin",
    atcCodes = {"J01GB01", "S01AA12"},
    drugbankId = "DB00684",
    pubchemCid = "36294",
    chebiId = "28864",
    wikidataId = "Q1758380",
    formula = "C18H37N5O9",
    M = 0.46752,
    logP = -6.2);
  annotation (Documentation(info = "<html><body><p>Tobramycin is an aminoglycoside antibiotic used to treat bacterial infections, including Pseudomonas infections, pneumonia, urinary tract infections, and lung problems in cystic fibrosis. It is approved and authorised in the European Union, mainly for cystic fibrosis and respiratory tract infections, and is also used in eye preparations.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q1758380&quot;>Wikidata Q1758380</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>tobramycin</td></tr><tr><td>ATC codes:</td><td>J01GB01, S01AA12</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00684&quot;>DB00684</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/36294&quot;>36294</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:28864&quot;>28864</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q1758380&quot;>Q1758380</a></td></tr><tr><td>formula:</td><td>C18H37N5O9</td></tr><tr><td>molar mass:</td><td>467.52 g/mol (PubChem)</td></tr></table></body></html>"));
end Tobramycin;
