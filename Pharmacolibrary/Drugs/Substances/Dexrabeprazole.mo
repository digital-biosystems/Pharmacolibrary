  annotation (Documentation(info = "<html><body><p>Dexrabeprazole is the R-enantiomer of the proton pump inhibitor rabeprazole, a drug class used for acid-related disorders such as peptic ulcer and gastro-oesophageal reflux disease. It is classed as investigational and is not an authorised medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27263884&quot;>Wikidata Q27263884</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dexrabeprazole</td></tr><tr><td>ATC codes:</td><td>A02BC07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13762&quot;>DB13762</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/9906855&quot;>9906855</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134729&quot;>134729</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27263884&quot;>Q27263884</a></td></tr><tr><td>formula:</td><td>C18H21N3O3S</td></tr><tr><td>molar mass:</td><td>359.444 g/mol (PubChem)</td></tr></table></body></html>"));
