  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "salicylic acid",
    atcCodes = {"D01AE12", "S01BC08"},
    drugbankId = "DB00936",
    pubchemCid = "338",
    chebiId = "16914",
    wikidataId = "Q193572",
    formula = "C7H6O3",
