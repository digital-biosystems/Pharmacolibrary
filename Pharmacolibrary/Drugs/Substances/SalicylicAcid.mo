    logP = 2.3);
  annotation (Documentation(info = "<html><body><p>Salicylic acid is a keratolytic and antifungal agent used topically for skin conditions such as acne, warts, seborrhoeic dermatitis, and other dermatoses. It is widely used, appears on the WHO list of essential medicines, and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q193572&quot;>Wikidata Q193572</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>salicylic acid</td></tr><tr><td>ATC codes:</td><td>D01AE12, S01BC08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00936&quot;>DB00936</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/338&quot;>338</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:16914&quot;>16914</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q193572&quot;>Q193572</a></td></tr><tr><td>formula:</td><td>C7H6O3</td></tr><tr><td>molar mass:</td><td>138.122 g/mol (PubChem)</td></tr></table></body></html>"));
end SalicylicAcid;
