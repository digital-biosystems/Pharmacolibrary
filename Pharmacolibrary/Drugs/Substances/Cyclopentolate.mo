  annotation (Documentation(info = "<html><body><p>Cyclopentolate is an anticholinergic eye drop used as a mydriatic and cycloplegic, for example to dilate the pupil before eye examinations. It is an approved medicine and is widely used in ophthalmic practice.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q867332\">Wikidata Q867332</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cyclopentolate</td></tr><tr><td>ATC codes:</td><td>S01FA04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00979\">DB00979</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2905\">2905</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4024\">4024</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q867332\">Q867332</a></td></tr><tr><td>formula:</td><td>C17H25NO3</td></tr><tr><td>molar mass:</td><td>291.391 g/mol (PubChem CID 2905)</td></tr><tr><td>logP:</td><td>2.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
