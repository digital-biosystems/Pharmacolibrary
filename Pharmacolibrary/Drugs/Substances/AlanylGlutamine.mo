  annotation (Documentation(info = "<html><body><p>Alanyl glutamine is an amino acid dipeptide classified as an intravenous solution additive, studied as a source of glutamine for parenteral nutrition. It remains investigational and is not an approved medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27144111&quot;>Wikidata Q27144111</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>alanyl glutamine</td></tr><tr><td>ATC codes:</td><td>B05XB02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11876&quot;>DB11876</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/123935&quot;>123935</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:73788&quot;>73788</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27144111&quot;>Q27144111</a></td></tr><tr><td>formula:</td><td>C8H15N3O4</td></tr><tr><td>molar mass:</td><td>217.225 g/mol (PubChem)</td></tr></table></body></html>"));
