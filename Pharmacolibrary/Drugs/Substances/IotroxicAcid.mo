    logP = 4.5);
  annotation (Documentation(info = "<html><body><p>Iotroxic acid is an iodinated, water-soluble X-ray contrast medium that is taken up by the liver, used to visualise the biliary tract. It has been withdrawn from use, although it was once listed among WHO essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3183847\">Wikidata Q3183847</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>iotroxic acid</td></tr><tr><td>ATC codes:</td><td>V08AC02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08945\">DB08945</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31716\">31716</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3183847\">Q3183847</a></td></tr><tr><td>formula:</td><td>C22H18I6N2O9</td></tr><tr><td>molar mass:</td><td>1215.81 g/mol (knowledgebase (DrugBank calculated))</td></tr><tr><td>logP:</td><td>4.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end IotroxicAcid;
