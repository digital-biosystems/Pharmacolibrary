  annotation (Documentation(info = "<html><body><p>Didecyldimethylammonium chloride is a quaternary ammonium antiseptic and disinfectant used to disinfect skin and surfaces. It is an approved drug and remains in use as a dermatological antiseptic.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27095047&quot;>Wikidata Q27095047</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>didecyldimethylammonium chloride</td></tr><tr><td>ATC codes:</td><td>D08AJ06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB04221&quot;>DB04221</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/16958&quot;>16958</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27095047&quot;>Q27095047</a></td></tr><tr><td>formula:</td><td>C22H48N+</td></tr><tr><td>molar mass:</td><td>326.633 g/mol (PubChem)</td></tr></table></body></html>"));
