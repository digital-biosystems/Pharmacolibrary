  annotation (Documentation(info = "<html><body><p>Didecyldimethylammonium chloride is a quaternary ammonium antiseptic and disinfectant used to disinfect skin and surfaces. It is an approved drug and remains in use as a dermatological antiseptic.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27095047\">Wikidata Q27095047</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>didecyldimethylammonium chloride</td></tr><tr><td>ATC codes:</td><td>D08AJ06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB04221\">DB04221</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/16958\">16958</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27095047\">Q27095047</a></td></tr><tr><td>formula:</td><td>C22H48N+</td></tr><tr><td>molar mass:</td><td>326.633 g/mol (PubChem CID 16958)</td></tr></table><p><small>Drugs.Common 25.09 gave 362.1 g/mol (+10.9 %); replaced by the value above</small></p></body></html>"));
end DidecyldimethylammoniumChloride;
