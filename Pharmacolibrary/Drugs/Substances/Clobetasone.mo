  annotation (Documentation(info = "<html><body><p>Clobetasone is a moderately potent topical corticosteroid used to treat inflammatory skin conditions, and is also used as an ophthalmological anti-inflammatory agent, alone or combined with antiinfectives. It is an approved medicine and remains in use, mainly in dermatological preparations.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5134764\">Wikidata Q5134764</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>clobetasone</td></tr><tr><td>ATC codes:</td><td>D07AB01, S01BA09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13158\">DB13158</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/71387\">71387</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5134764\">Q5134764</a></td></tr><tr><td>formula:</td><td>C22H26ClFO4</td></tr><tr><td>molar mass:</td><td>408.894 g/mol (PubChem CID 71387)</td></tr><tr><td>logP:</td><td>2.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
