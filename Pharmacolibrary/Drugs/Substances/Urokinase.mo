  annotation (Documentation(info = "<html><body><p>Urokinase is a thrombolytic enzyme used to treat blood clots such as myocardial infarction, pulmonary embolism, and coronary thrombosis. It has been withdrawn from use, though it was once an approved medication.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q110969665&quot;>Wikidata Q110969665</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>urokinase</td></tr><tr><td>ATC codes:</td><td>B01AD04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00013&quot;>DB00013</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q110969665&quot;>Q110969665</a></td></tr><tr><td>molar mass:</td><td>31126.5 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Urokinase;
