  annotation (Documentation(info = "<html><body><p>Clobenzorex is a centrally acting antiobesity drug used to treat obesity. It is not an approved medicine in major markets and is considered investigational, though it has been used in some countries for weight loss.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q106010224\">Wikidata Q106010224</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>clobenzorex</td></tr><tr><td>ATC codes:</td><td>A08AA08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13561\">DB13561</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/735998\">735998</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135069\">135069</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q106010224\">Q106010224</a></td></tr><tr><td>formula:</td><td>C16H18ClN</td></tr><tr><td>molar mass:</td><td>259.777 g/mol (PubChem CID 735998)</td></tr><tr><td>logP:</td><td>4.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
