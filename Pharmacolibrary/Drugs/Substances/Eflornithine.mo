within Pharmacolibrary.Drugs.Substances;
package Eflornithine "eflornithine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "eflornithine",
    atcCodes = {"D11AX16", "L01XX79", "P01CX03"},
    drugbankId = "DB06243",
    pubchemCid = "3009",
    chebiId = "41948",
    wikidataId = "Q72470623",
    formula = "C6H12F2N2O2",
    M = 0.18217,
    logP = -2.9);
  annotation (Documentation(info = "<html><body><p>Eflornithine is used to treat excessive facial hair growth in women (hirsutism) and, in combination therapy, the childhood cancer neuroblastoma; it has also been used against sleeping sickness. It remains authorised in the European Union for these uses, with a topical dermatological product for hirsutism and an oncology product for neuroblastoma, though some applications have been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q72470623\">Wikidata Q72470623</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>eflornithine</td></tr><tr><td>ATC codes:</td><td>D11AX16, L01XX79, P01CX03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06243\">DB06243</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3009\">3009</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:41948\">41948</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q72470623\">Q72470623</a></td></tr><tr><td>formula:</td><td>C6H12F2N2O2</td></tr><tr><td>molar mass:</td><td>182.17 g/mol (PubChem CID 3009)</td></tr><tr><td>logP:</td><td>-2.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Eflornithine;
