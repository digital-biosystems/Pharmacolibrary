within Pharmacolibrary.Drugs.Substances;
package Eflornithine "eflornithine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "eflornithine",
    atcCodes = {"D11AX16", "L01XX79", "P01CX03"},
    drugbankId = "DB06243",
    pubchemCid = "3009",
    chebiId = "41948",
    wikidataId = "Q424751",
    formula = "C6H12F2N2O2",
    M = 0.18217,
    logP = -2.9);
  annotation (Documentation(info = "<html><body><p>Eflornithine is used to treat African trypanosomiasis and, as a skin cream, unwanted facial hair in women (hirsutism); it has also been studied for neuroblastoma. It remains in use: an EMA-authorised product exists for hirsutism, while its use for sleeping sickness is mainly in endemic tropical regions.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q424751&quot;>Wikidata Q424751</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>eflornithine</td></tr><tr><td>ATC codes:</td><td>D11AX16, L01XX79, P01CX03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06243&quot;>DB06243</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3009&quot;>3009</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:41948&quot;>41948</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q424751&quot;>Q424751</a></td></tr><tr><td>formula:</td><td>C6H12F2N2O2</td></tr><tr><td>molar mass:</td><td>182.17 g/mol (PubChem)</td></tr></table></body></html>"));
end Eflornithine;
