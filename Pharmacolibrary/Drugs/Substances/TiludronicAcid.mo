  annotation (Documentation(info = "<html><body><p>Tiludronic acid is a bisphosphonate that was used to treat Paget's disease of bone. It has been withdrawn from human use, though it remains approved for veterinary purposes.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2823312&quot;>Wikidata Q2823312</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tiludronic acid</td></tr><tr><td>ATC codes:</td><td>M05BA05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01133&quot;>DB01133</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/60937&quot;>60937</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9598&quot;>9598</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2823312&quot;>Q2823312</a></td></tr><tr><td>formula:</td><td>C7H9ClO6P2S</td></tr><tr><td>molar mass:</td><td>318.601 g/mol (PubChem)</td></tr></table></body></html>"));
