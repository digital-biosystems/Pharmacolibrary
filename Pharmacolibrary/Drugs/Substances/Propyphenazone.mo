  annotation (Documentation(info = "<html><body><p>Propyphenazone is a pyrazolone non-steroidal anti-inflammatory drug used as an analgesic and antipyretic for pain and fever. It is classified as investigational in DrugBank and has no European Union authorisation, so its current availability appears limited.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q425111\">Wikidata Q425111</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>propyphenazone</td></tr><tr><td>ATC codes:</td><td>N02BB04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13524\">DB13524</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3778\">3778</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135538\">135538</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q425111\">Q425111</a></td></tr><tr><td>formula:</td><td>C14H18N2O</td></tr><tr><td>molar mass:</td><td>230.311 g/mol (PubChem CID 3778)</td></tr><tr><td>logP:</td><td>1.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
