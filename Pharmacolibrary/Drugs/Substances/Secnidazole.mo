    logP = 0.2);
  annotation (Documentation(info = "<html><body><p>Secnidazole is a nitroimidazole antiprotozoal drug used against protozoal infections such as amoebiasis. It is an approved antibacterial and antiprotozoal, available in combination antibacterial products, though not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4413249&quot;>Wikidata Q4413249</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>secnidazole</td></tr><tr><td>ATC codes:</td><td>P01AB07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12834&quot;>DB12834</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/71815&quot;>71815</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:140628&quot;>140628</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4413249&quot;>Q4413249</a></td></tr><tr><td>formula:</td><td>C7H11N3O3</td></tr><tr><td>molar mass:</td><td>185.183 g/mol (PubChem)</td></tr></table></body></html>"));
end Secnidazole;
