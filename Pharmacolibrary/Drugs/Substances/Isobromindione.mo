  annotation (Documentation(info = "<html><body><p>Isobromindione is a uricosuric antigout drug, meaning it was used to treat gout by increasing the excretion of uric acid. It appears to be only experimental and is not an established marketed medicine today.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q15264815\">Wikidata Q15264815</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>isobromindione</td></tr><tr><td>ATC codes:</td><td>M04AB04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13545\">DB13545</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/68953\">68953</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135275\">135275</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q15264815\">Q15264815</a></td></tr><tr><td>formula:</td><td>C15H9BrO2</td></tr><tr><td>molar mass:</td><td>301.139 g/mol (PubChem CID 68953)</td></tr><tr><td>logP:</td><td>3.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
