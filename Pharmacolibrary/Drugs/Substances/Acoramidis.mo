  annotation (Documentation(info = "<html><body><p>Acoramidis is a heart medicine used to treat familial amyloid polyneuropathy, a rare inherited condition affecting the nerves. It is authorised in the European Union and remains under investigation for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27451739&quot;>Wikidata Q27451739</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>acoramidis</td></tr><tr><td>ATC codes:</td><td>C01EB25</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB17999&quot;>DB17999</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/71464713&quot;>71464713</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27451739&quot;>Q27451739</a></td></tr><tr><td>formula:</td><td>C15H17FN2O3</td></tr><tr><td>molar mass:</td><td>292.31 g/mol (PubChem)</td></tr></table></body></html>"));
