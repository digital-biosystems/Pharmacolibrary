  annotation (Documentation(info = "<html><body><p>Atracurium is a muscle relaxant used to relax muscles during surgery and to help with insertion of a breathing tube under anaesthesia. It is widely used in anaesthetic practice and appears on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q165660&quot;>Wikidata Q165660</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>atracurium</td></tr><tr><td>ATC codes:</td><td>M03AC04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13295&quot;>DB13295</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/47319&quot;>47319</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q165660&quot;>Q165660</a></td></tr><tr><td>formula:</td><td>C53H72N2O12+2</td></tr><tr><td>molar mass:</td><td>929.161 g/mol (PubChem)</td></tr></table></body></html>"));
end Atracurium;
