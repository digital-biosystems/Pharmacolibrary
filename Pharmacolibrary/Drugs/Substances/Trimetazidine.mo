  annotation (Documentation(info = "<html><body><p>Trimetazidine is a cardiac drug used to treat angina pectoris, acting as a vasodilator agent. It is approved and sold under many brand names, and is also being studied investigationally.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q674703&quot;>Wikidata Q674703</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>trimetazidine</td></tr><tr><td>ATC codes:</td><td>C01EB15</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09069&quot;>DB09069</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/21109&quot;>21109</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:94789&quot;>94789</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q674703&quot;>Q674703</a></td></tr><tr><td>formula:</td><td>C14H22N2O3</td></tr><tr><td>molar mass:</td><td>266.341 g/mol (PubChem)</td></tr></table></body></html>"));
