  annotation (Documentation(info = "<html><body><p>Carboplatin is a platinum-based anticancer drug used to treat many cancers, including ovarian, breast, lung, head and neck, and brain cancers. It is an approved medicine and appears on the WHO list of essential medicines, so it is widely used in cancer care worldwide.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q415588&quot;>Wikidata Q415588</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>carboplatin</td></tr><tr><td>ATC codes:</td><td>L01XA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00958&quot;>DB00958</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/38904&quot;>38904</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31355&quot;>31355</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q415588&quot;>Q415588</a></td></tr><tr><td>formula:</td><td>C6H14N2O4Pt</td></tr><tr><td>molar mass:</td><td>373.268 g/mol (PubChem)</td></tr></table></body></html>"));
