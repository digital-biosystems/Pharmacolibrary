package Dapivirine "dapivirine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "dapivirine",
    atcCodes = {"G01AX17"},
    drugbankId = "DB08639",
    pubchemCid = "214347",
    wikidataId = "Q27097831",
    formula = "C20H19N5",
