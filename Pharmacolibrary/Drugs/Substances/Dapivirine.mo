    logP = 4.8);
  annotation (Documentation(info = "<html><body><p>Dapivirine is an investigational anti-HIV drug, a reverse-transcriptase inhibitor studied for preventing HIV infection. It is not an approved medicine; it remains investigational, though its ATC code places it among gynecological antiinfectives, consistent with topical vaginal use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27097831\">Wikidata Q27097831</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dapivirine</td></tr><tr><td>ATC codes:</td><td>G01AX17</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08639\">DB08639</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/214347\">214347</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27097831\">Q27097831</a></td></tr><tr><td>formula:</td><td>C20H19N5</td></tr><tr><td>molar mass:</td><td>329.407 g/mol (PubChem CID 214347)</td></tr><tr><td>logP:</td><td>4.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Dapivirine;
