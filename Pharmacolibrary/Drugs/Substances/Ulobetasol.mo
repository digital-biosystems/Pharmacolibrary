  annotation (Documentation(info = "<html><body><p>Ulobetasol is a potent topical corticosteroid used on the skin, including as an antipsoriatic treatment. It is an approved medicine, but no European Union authorisation is recorded in the available facts, so its availability appears limited.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7879715&quot;>Wikidata Q7879715</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ulobetasol</td></tr><tr><td>ATC codes:</td><td>D07AC21</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00596&quot;>DB00596</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5311167&quot;>5311167</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:197151&quot;>197151</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7879715&quot;>Q7879715</a></td></tr><tr><td>formula:</td><td>C22H27ClF2O4</td></tr><tr><td>molar mass:</td><td>428.9 g/mol (PubChem)</td></tr></table></body></html>"));
