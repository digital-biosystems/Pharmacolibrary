  annotation (Documentation(info = "<html><body><p>Bambuterol is a bronchodilator, a beta-2 agonist, that has been investigated for treating asthma and chronic obstructive pulmonary disease. It is considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3633651\">Wikidata Q3633651</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bambuterol</td></tr><tr><td>ATC codes:</td><td>R03CC12</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01408\">DB01408</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/54766\">54766</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:553827\">553827</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3633651\">Q3633651</a></td></tr><tr><td>formula:</td><td>C18H29N3O5</td></tr><tr><td>molar mass:</td><td>367.446 g/mol (PubChem CID 54766)</td></tr><tr><td>logP:</td><td>1.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
