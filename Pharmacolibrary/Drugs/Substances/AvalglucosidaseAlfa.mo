  annotation (Documentation(info = "<html><body><p>Avalglucosidase alfa is an enzyme medication used to treat glycogen storage disease type II (Pompe disease). It is authorised in the European Union and is an approved medicine, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q107693067\">Wikidata Q107693067</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>avalglucosidase alfa</td></tr><tr><td>ATC codes:</td><td>A16AB22</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB16099\">DB16099</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q107693067\">Q107693067</a></td></tr><tr><td>molar mass:</td><td>124000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end AvalglucosidaseAlfa;
