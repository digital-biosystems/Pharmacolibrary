  annotation (Documentation(info = "<html><body><p>Phenelzine is a monoamine oxidase inhibitor antidepressant used to treat depression, including neurotic disorders. It remains an approved medicine, though it is not authorised centrally in the European Union and is used relatively rarely.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1747559\">Wikidata Q1747559</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>phenelzine</td></tr><tr><td>ATC codes:</td><td>N06AF03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00780\">DB00780</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3675\">3675</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8060\">8060</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1747559\">Q1747559</a></td></tr><tr><td>formula:</td><td>C8H12N2</td></tr><tr><td>molar mass:</td><td>136.198 g/mol (PubChem CID 3675)</td></tr><tr><td>logP:</td><td>1.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
