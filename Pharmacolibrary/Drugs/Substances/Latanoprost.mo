  annotation (Documentation(info = "<html><body><p>Latanoprost is a prostaglandin analogue eye drop used to treat glaucoma, especially open-angle glaucoma, and ocular hypertension. It is widely used, is included on the WHO list of essential medicines, and is authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q634959\">Wikidata Q634959</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>latanoprost</td></tr><tr><td>ATC codes:</td><td>S01EE01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00654\">DB00654</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5311221\">5311221</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6384\">6384</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q634959\">Q634959</a></td></tr><tr><td>formula:</td><td>C26H40O5</td></tr><tr><td>molar mass:</td><td>432.601 g/mol (PubChem CID 5311221)</td></tr><tr><td>logP:</td><td>4.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
