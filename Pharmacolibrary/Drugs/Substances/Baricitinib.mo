  annotation (Documentation(info = "<html><body><p>Baricitinib is a JAK inhibitor used to treat rheumatoid arthritis and, in some settings, COVID-19. It is an approved medicine and is authorised in the European Union for rheumatoid arthritis.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4860707\">Wikidata Q4860707</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>baricitinib</td></tr><tr><td>ATC codes:</td><td>L04AA37, L04AF02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11817\">DB11817</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/44205240\">44205240</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:95341\">95341</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4860707\">Q4860707</a></td></tr><tr><td>formula:</td><td>C16H17N7O2S</td></tr><tr><td>molar mass:</td><td>371.419 g/mol (PubChem CID 44205240)</td></tr><tr><td>logP:</td><td>-0.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
