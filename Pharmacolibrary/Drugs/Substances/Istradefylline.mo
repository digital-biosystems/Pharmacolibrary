  annotation (Documentation(info = "<html><body><p>Istradefylline is a drug used to treat Parkinson's disease, acting as an adenosine A2 receptor antagonist. It is an approved antiparkinson medicine, though a marketing application was refused in the European Union, so its use is mainly elsewhere.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q905783\">Wikidata Q905783</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>istradefylline</td></tr><tr><td>ATC codes:</td><td>N04CX01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11757\">DB11757</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5311037\">5311037</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134726\">134726</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q905783\">Q905783</a></td></tr><tr><td>formula:</td><td>C20H24N4O4</td></tr><tr><td>molar mass:</td><td>384.436 g/mol (PubChem CID 5311037)</td></tr><tr><td>logP:</td><td>2.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Istradefylline;
