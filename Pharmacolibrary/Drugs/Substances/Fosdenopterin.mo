  annotation (Documentation(info = "<html><body><p>Fosdenopterin is used to treat molybdenum cofactor deficiency, a rare inherited disorder of metal metabolism. It is an approved medicine and is authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5198226\">Wikidata Q5198226</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>fosdenopterin</td></tr><tr><td>ATC codes:</td><td>A16AX19</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB16628\">DB16628</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/135463437\">135463437</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:60210\">60210</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5198226\">Q5198226</a></td></tr><tr><td>formula:</td><td>C10H14N5O8P</td></tr><tr><td>molar mass:</td><td>363.223 g/mol (PubChem CID 135463437)</td></tr><tr><td>logP:</td><td>-4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
