  annotation (Documentation(info = "<html><body><p>Suloctidil is a vasodilator that was classified as a peripheral vasodilator for cardiovascular use. It is no longer in routine use and is considered an experimental compound.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7636084&quot;>Wikidata Q7636084</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>suloctidil</td></tr><tr><td>ATC codes:</td><td>C04AX19</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13340&quot;>DB13340</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6604413&quot;>6604413</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7636084&quot;>Q7636084</a></td></tr><tr><td>formula:</td><td>C20H35NOS</td></tr><tr><td>molar mass:</td><td>337.566 g/mol (PubChem)</td></tr></table></body></html>"));
