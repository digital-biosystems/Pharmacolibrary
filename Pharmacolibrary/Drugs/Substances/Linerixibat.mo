  annotation (Documentation(info = "<html><body><p>Linerixibat is an investigational bile acid inhibitor being studied for cholestatic itching associated with liver disease. It is not yet approved and remains under clinical investigation.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27256749&quot;>Wikidata Q27256749</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>linerixibat</td></tr><tr><td>ATC codes:</td><td>A05AX08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11729&quot;>DB11729</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/53492727&quot;>53492727</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27256749&quot;>Q27256749</a></td></tr><tr><td>formula:</td><td>C28H38N2O7S</td></tr><tr><td>molar mass:</td><td>546.679 g/mol (PubChem)</td></tr></table></body></html>"));
