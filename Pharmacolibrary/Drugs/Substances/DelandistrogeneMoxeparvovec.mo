  annotation (Documentation(info = "<html><body><p>Delandistrogene moxeparvovec is a gene therapy intended to treat Duchenne muscular dystrophy. It is approved in the United States but investigational in Europe, where a marketing application was refused.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q120434975&quot;>Wikidata Q120434975</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>delandistrogene moxeparvovec</td></tr><tr><td>ATC codes:</td><td>M09AX15</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB16802&quot;>DB16802</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q120434975&quot;>Q120434975</a></td></tr></table></body></html>"));
