  annotation (Documentation(info = "<html><body><p>Dornase alfa is a mucolytic drug used to treat cystic fibrosis and has also been used for acute bronchitis. It is an approved medicine, used mainly in the management of cystic fibrosis.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2067922&quot;>Wikidata Q2067922</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dornase alfa (desoxyribonuclease)</td></tr><tr><td>ATC codes:</td><td>R05CB13</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00003&quot;>DB00003</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2067922&quot;>Q2067922</a></td></tr><tr><td>molar mass:</td><td>29253.9 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
