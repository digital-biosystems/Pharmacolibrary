    logP = -2.7);
  annotation (Documentation(info = "<html><body><p>Angiotensinamide is a vasoconstrictor agent classified as a cardiac stimulant, historically used to raise blood pressure in states of shock. It is considered experimental and is not an authorised medicine in the European Union, so it is no longer in routine clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4763296&quot;>Wikidata Q4763296</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>angiotensinamide</td></tr><tr><td>ATC codes:</td><td>C01CX06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13517&quot;>DB13517</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/10351092&quot;>10351092</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135950&quot;>135950</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4763296&quot;>Q4763296</a></td></tr><tr><td>formula:</td><td>C49H70N14O11</td></tr><tr><td>molar mass:</td><td>1031.19 g/mol (PubChem)</td></tr></table></body></html>"));
end Angiotensinamide;
