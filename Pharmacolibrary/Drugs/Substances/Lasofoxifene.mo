  annotation (Documentation(info = "<html><body><p>Lasofoxifene is a selective estrogen receptor modulator that was developed to treat postmenopausal osteoporosis. It is no longer in use; its European Union marketing authorisation has lapsed, and it is considered withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q644675&quot;>Wikidata Q644675</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>lasofoxifene</td></tr><tr><td>ATC codes:</td><td>G03XC03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06202&quot;>DB06202</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/216416&quot;>216416</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q644675&quot;>Q644675</a></td></tr><tr><td>formula:</td><td>C28H31NO2</td></tr><tr><td>molar mass:</td><td>413.561 g/mol (PubChem)</td></tr></table></body></html>"));
