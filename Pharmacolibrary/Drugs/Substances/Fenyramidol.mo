  annotation (Documentation(info = "<html><body><p>Fenyramidol is a centrally acting muscle relaxant once explored for treating painful muscle spasms. It is not an approved medicine today; DrugBank lists it only as investigational, with no authorisation in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5443698\">Wikidata Q5443698</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>fenyramidol</td></tr><tr><td>ATC codes:</td><td>M03BX30</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13414\">DB13414</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9470\">9470</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134888\">134888</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5443698\">Q5443698</a></td></tr><tr><td>formula:</td><td>C13H14N2O</td></tr><tr><td>molar mass:</td><td>214.268 g/mol (PubChem CID 9470)</td></tr><tr><td>logP:</td><td>2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Fenyramidol;
