within Pharmacolibrary.Drugs.Substances;
package MethoxyPolyethyleneGlycolEpoetinBeta "methoxy polyethylene glycol-epoetin beta"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "methoxy polyethylene glycol-epoetin beta",
    atcCodes = {"B03XA03"},
    drugbankId = "DB09107",
    wikidataId = "Q6011913");
  annotation (Documentation(info = "<html><body><p>Methoxy polyethylene glycol-epoetin beta is a long-acting erythropoietin-type medicine used to treat anemia in people with chronic kidney disease. It is an approved antianemic medicine, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6011913\">Wikidata Q6011913</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>methoxy polyethylene glycol-epoetin beta</td></tr><tr><td>ATC codes:</td><td>B03XA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09107\">DB09107</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6011913\">Q6011913</a></td></tr></table></body></html>"));
end MethoxyPolyethyleneGlycolEpoetinBeta;
