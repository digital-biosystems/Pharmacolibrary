  annotation (Documentation(info = "<html><body><p>Zastaprazan is a proton pump inhibitor being developed for acid-related disorders such as peptic ulcer and gastro-oesophageal reflux disease. It is still investigational and not yet approved for routine clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q131599122\">Wikidata Q131599122</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>zastaprazan</td></tr><tr><td>ATC codes:</td><td>A02BC12</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB21524\">DB21524</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/138622158\">138622158</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q131599122\">Q131599122</a></td></tr><tr><td>formula:</td><td>C22H26N4O</td></tr><tr><td>molar mass:</td><td>362.477 g/mol (PubChem CID 138622158)</td></tr></table></body></html>"));
