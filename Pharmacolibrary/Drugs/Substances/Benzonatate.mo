  annotation (Documentation(info = "<html><body><p>Benzonatate is a cough suppressant used to relieve cough, and has also been used for hiccups. It is an approved medicine, used mainly in the United States; it is not authorised in the European Union and carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2070778&quot;>Wikidata Q2070778</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>benzonatate</td></tr><tr><td>ATC codes:</td><td>R05DB01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00868&quot;>DB00868</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/7699&quot;>7699</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3032&quot;>3032</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2070778&quot;>Q2070778</a></td></tr><tr><td>formula:</td><td>C30H53NO11</td></tr><tr><td>molar mass:</td><td>603.75 g/mol (PubChem)</td></tr></table></body></html>"));
