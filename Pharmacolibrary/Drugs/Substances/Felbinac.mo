  annotation (Documentation(info = "<html><body><p>Felbinac is a non-steroidal anti-inflammatory drug applied to the skin to relieve joint and muscular pain. It is not an approved medicine in major databases, where it is listed only as investigational, though topical products are available in some countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3742067\">Wikidata Q3742067</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>felbinac</td></tr><tr><td>ATC codes:</td><td>M02AA08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB07477\">DB07477</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3332\">3332</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31597\">31597</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3742067\">Q3742067</a></td></tr><tr><td>formula:</td><td>C14H12O2</td></tr><tr><td>molar mass:</td><td>212.248 g/mol (PubChem CID 3332)</td></tr><tr><td>logP:</td><td>3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
