    logP = -1.3);
  annotation (Documentation(info = "<html><body><p>Inosine is a naturally occurring metabolite that has been used as an antiviral agent, applied topically for skin, gynecological, and eye infections. It is approved and used in various topical formulations, though it is not widely employed and no EU-wide authorisation is recorded.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q422564&quot;>Wikidata Q422564</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>inosine</td></tr><tr><td>ATC codes:</td><td>D06BB05, G01AX02, S01XA10</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB04335&quot;>DB04335</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6021&quot;>6021</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:17596&quot;>17596</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q422564&quot;>Q422564</a></td></tr><tr><td>formula:</td><td>C10H12N4O5</td></tr><tr><td>molar mass:</td><td>268.226 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Inosine;
