    logP = 6.2);
  annotation (Documentation(info = "<html><body><p>Cyfluthrin is a pyrethroid insecticide used to kill insects and other ectoparasites. It is not an approved human medicine; it appears only as an experimental substance, and its use is mainly as an insecticide rather than a drug.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q61641151\">Wikidata Q61641151</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cyfluthrin</td></tr><tr><td>ATC codes:</td><td>P03BA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13828\">DB13828</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/104926\">104926</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4034\">4034</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q61641151\">Q61641151</a></td></tr><tr><td>formula:</td><td>C22H18Cl2FNO3</td></tr><tr><td>molar mass:</td><td>434.288 g/mol (PubChem CID 104926)</td></tr><tr><td>logP:</td><td>6.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Cyfluthrin;
