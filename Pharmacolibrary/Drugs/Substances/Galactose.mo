  annotation (Documentation(info = "<html><body><p>Galactose is a sugar used as a diagnostic agent, in tests of liver functional capacity and as an ultrasound contrast medium. It is an approved diagnostic agent, though some uses have been withdrawn or remain investigational.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q66589593\">Wikidata Q66589593</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>galactose</td></tr><tr><td>ATC codes:</td><td>V04CE01, V08DA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11735\">DB11735</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3037556\">3037556</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:17118\">17118</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q66589593\">Q66589593</a></td></tr><tr><td>formula:</td><td>C6H12O6</td></tr><tr><td>molar mass:</td><td>180.156 g/mol (PubChem CID 3037556)</td></tr><tr><td>logP:</td><td>-2.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Galactose;
