  annotation (Documentation(info = "<html><body><p>Diflunisal is a non-steroidal anti-inflammatory drug used to treat pain, osteoarthritis, and rheumatoid arthritis. It remains an approved medicine, with an authorised product in the European Union, where it is also indicated for familial amyloid neuropathy.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2602750\">Wikidata Q2602750</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>diflunisal</td></tr><tr><td>ATC codes:</td><td>N02BA11</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00861\">DB00861</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3059\">3059</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:39669\">39669</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2602750\">Q2602750</a></td></tr><tr><td>formula:</td><td>C13H8F2O3</td></tr><tr><td>molar mass:</td><td>250.2 g/mol (PubChem CID 3059)</td></tr><tr><td>logP:</td><td>4.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
