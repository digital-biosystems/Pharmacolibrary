within Pharmacolibrary.Drugs.Substances;
package PeginterferonAlfa2a "peginterferon alfa-2a"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "peginterferon alfa-2a",
    atcCodes = {"L03AB11"},
    drugbankId = "DB00008",
    wikidataId = "Q420056",
    M = 60);
  annotation (Documentation(info = "<html><body><p>Peginterferon alfa-2a is an antiviral, immune-stimulating medicine used to treat chronic hepatitis B and C and certain blood disorders such as polycythemia vera and essential thrombocythemia. It is authorised in the European Union and is included on the WHO list of essential medicines, so it remains in widespread use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q420056\">Wikidata Q420056</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>peginterferon alfa-2a</td></tr><tr><td>ATC codes:</td><td>L03AB11</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00008\">DB00008</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q420056\">Q420056</a></td></tr><tr><td>molar mass:</td><td>60000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end PeginterferonAlfa2a;
