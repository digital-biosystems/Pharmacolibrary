within Pharmacolibrary.Drugs.Substances;
package Ranitidine "ranitidine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "ranitidine",
    atcCodes = {"A02BA02", "A02BA07"},
    drugbankId = "DB00863",
    pubchemCid = "3001055",
    chebiId = "92246",
    wikidataId = "Q423037",
    formula = "C13H22N4O3S",
    M = 0.314404,
    logP = 0.3);
  annotation (Documentation(info = "<html><body><p>Ranitidine is an H2-receptor antagonist that was used to treat acid-related stomach problems such as peptic ulcers, gastritis, heartburn and reflux disease. It has been withdrawn from many markets after the drug was found to contain an impurity that may cause cancer, so it is no longer generally available.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q423037\">Wikidata Q423037</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ranitidine</td></tr><tr><td>ATC codes:</td><td>A02BA02, A02BA07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00863\">DB00863</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3001055\">3001055</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:92246\">92246</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q423037\">Q423037</a></td></tr><tr><td>formula:</td><td>C13H22N4O3S</td></tr><tr><td>molar mass:</td><td>314.404 g/mol (PubChem CID 3001055)</td></tr><tr><td>logP:</td><td>0.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Ranitidine;
