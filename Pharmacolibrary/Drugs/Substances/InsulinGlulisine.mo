  annotation (Documentation(info = "<html><body><p>Insulin glulisine is a fast-acting insulin analogue used to treat diabetes, particularly type-1 diabetes. It is an approved anti-diabetic medicine authorised in the European Union for diabetes mellitus.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6042242&quot;>Wikidata Q6042242</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>insulin glulisine</td></tr><tr><td>ATC codes:</td><td>A10AB06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01309&quot;>DB01309</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6042242&quot;>Q6042242</a></td></tr><tr><td>molar mass:</td><td>5823 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
