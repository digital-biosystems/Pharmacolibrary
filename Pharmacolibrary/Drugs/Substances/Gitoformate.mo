  annotation (Documentation(info = "<html><body><p>Gitoformate is a digitalis-type cardiac glycoside developed for heart conditions such as heart failure. It is considered investigational and is not an established marketed medicine today.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>gitoformate</td></tr><tr><td>ATC codes:</td><td>C01AA09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13537\">DB13537</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/20055283\">20055283</a></td></tr><tr><td>formula:</td><td>C46H64O19</td></tr><tr><td>molar mass:</td><td>920.999 g/mol (PubChem CID 20055283)</td></tr><tr><td>logP:</td><td>4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Gitoformate;
