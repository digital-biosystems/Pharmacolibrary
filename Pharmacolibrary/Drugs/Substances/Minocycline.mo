    logP = -0.6);
  annotation (Documentation(info = "<html><body><p>Minocycline is a tetracycline antibiotic used to treat bacterial infections such as acne, rosacea, meningitis, anthrax, brucellosis, and gum disease. It is an approved medicine, used both systemically for infections and topically for acne, as well as in oral preparations for dental infections.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q415336&quot;>Wikidata Q415336</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>minocycline</td></tr><tr><td>ATC codes:</td><td>A01AB23, D10AF07, J01AA08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01017&quot;>DB01017</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/54675783&quot;>54675783</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:50694&quot;>50694</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q415336&quot;>Q415336</a></td></tr><tr><td>formula:</td><td>C23H27N3O7</td></tr><tr><td>molar mass:</td><td>457.483 g/mol (PubChem)</td></tr></table></body></html>"));
end Minocycline;
