  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "minocycline",
    atcCodes = {"A01AB23", "D10AF07", "J01AA08"},
    drugbankId = "DB01017",
    pubchemCid = "54675783",
    chebiId = "50694",
    wikidataId = "Q415336",
    formula = "C23H27N3O7",
