    M = 1.43106,
    logP = 1.9);
  annotation (Documentation(info = "<html><body><p>Cetrorelix is a hormone antagonist used to help induce ovulation in fertility treatment. It is authorised in the European Union and is used in assisted reproduction, mainly to prevent premature ovulation during ovarian stimulation.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5065704&quot;>Wikidata Q5065704</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>cetrorelix</td></tr><tr><td>ATC codes:</td><td>H01CC02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00050&quot;>DB00050</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/25074887&quot;>25074887</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:59224&quot;>59224</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5065704&quot;>Q5065704</a></td></tr><tr><td>formula:</td><td>C70H92ClN17O14</td></tr><tr><td>molar mass:</td><td>1431.06 g/mol (PubChem)</td></tr></table></body></html>"));
end Cetrorelix;
