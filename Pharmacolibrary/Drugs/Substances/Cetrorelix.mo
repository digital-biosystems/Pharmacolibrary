within Pharmacolibrary.Drugs.Substances;
package Cetrorelix "cetrorelix"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "cetrorelix",
    atcCodes = {"H01CC02"},
    drugbankId = "DB00050",
    pubchemCid = "25074887",
    chebiId = "59224",
    wikidataId = "Q5065704",
