  annotation (Documentation(info = "<html><body><p>Promegestone is a synthetic progestogen, a sex hormone modulator. It appears to be only experimental and is not authorised in the European Union; where it is used is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7249694\">Wikidata Q7249694</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>promegestone</td></tr><tr><td>ATC codes:</td><td>G03DB07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13602\">DB13602</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/36709\">36709</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:73390\">73390</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7249694\">Q7249694</a></td></tr><tr><td>formula:</td><td>C22H30O2</td></tr><tr><td>molar mass:</td><td>326.48 g/mol (PubChem CID 36709)</td></tr><tr><td>logP:</td><td>3.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
