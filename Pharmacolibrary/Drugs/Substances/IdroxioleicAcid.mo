  annotation (Documentation(info = "<html><body><p>Idroxioleic acid (2-hydroxyoleic acid) is an investigational antineoplastic agent being studied as a cancer treatment. It is not yet an approved medicine and remains in clinical investigation, with no marketing authorisation such as from the European Medicines Agency.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q28816084&quot;>Wikidata Q28816084</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>idroxioleic acid</td></tr><tr><td>ATC codes:</td><td>L01XX85</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB18213&quot;>DB18213</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:143096&quot;>143096</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q28816084&quot;>Q28816084</a></td></tr><tr><td>formula:</td><td>C18H34O3</td></tr><tr><td>molar mass:</td><td>298.467 g/mol (KB manifest)</td></tr></table></body></html>"));
