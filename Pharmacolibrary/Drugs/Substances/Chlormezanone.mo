  annotation (Documentation(info = "<html><body><p>Chlormezanone is a centrally acting muscle relaxant with anxiolytic effects that was used to treat spasticity and anxiety disorders. It has been withdrawn from the market and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5102983&quot;>Wikidata Q5102983</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>chlormezanone</td></tr><tr><td>ATC codes:</td><td>M03BB02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01178&quot;>DB01178</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2717&quot;>2717</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3619&quot;>3619</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5102983&quot;>Q5102983</a></td></tr><tr><td>formula:</td><td>C11H12ClNO3S</td></tr><tr><td>molar mass:</td><td>273.731 g/mol (PubChem)</td></tr></table></body></html>"));
