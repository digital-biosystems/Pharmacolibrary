  annotation (Documentation(info = "<html><body><p>Dexamfetamine is a stimulant medicine used to treat attention deficit hyperactivity disorder and narcolepsy. It is an approved drug used widely for these conditions, though it is a controlled stimulant carrying a boxed warning and is also used illicitly.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q1706418&quot;>Wikidata Q1706418</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dexamfetamine</td></tr><tr><td>ATC codes:</td><td>N06BA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01576&quot;>DB01576</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5826&quot;>5826</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q1706418&quot;>Q1706418</a></td></tr><tr><td>formula:</td><td>C9H13N</td></tr><tr><td>molar mass:</td><td>135.21 g/mol (PubChem)</td></tr></table></body></html>"));
