  annotation (Documentation(info = "<html><body><p>Chorionic gonadotrophin is a human hormone used to treat infertility, acting as a gonadotropin that stimulates ovulation. It is an approved medicine and also approved for veterinary use, with some investigational applications.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q407172\">Wikidata Q407172</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>chorionic gonadotrophin</td></tr><tr><td>ATC codes:</td><td>G03GA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09126\">DB09126</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q407172\">Q407172</a></td></tr><tr><td>molar mass:</td><td>321.35 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>-4.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
