  annotation (Documentation(info = "<html><body><p>Bucillamine is an antirheumatic agent related to penicillamine, studied for treating rheumatic conditions. It is not authorised in the European Union and is currently considered investigational.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4982752&quot;>Wikidata Q4982752</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bucillamine</td></tr><tr><td>ATC codes:</td><td>M01CC02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12160&quot;>DB12160</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/656604&quot;>656604</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31312&quot;>31312</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4982752&quot;>Q4982752</a></td></tr><tr><td>formula:</td><td>C7H13NO3S2</td></tr><tr><td>molar mass:</td><td>223.305 g/mol (PubChem)</td></tr></table></body></html>"));
