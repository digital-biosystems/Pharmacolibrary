  annotation (Documentation(info = "<html><body><p>Bentazepam is a benzodiazepine-derivative anxiolytic, sedative and hypnotic that has been used to treat anxiety and sleep problems. It is considered an experimental drug and is not in routine clinical use today.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q1421936&quot;>Wikidata Q1421936</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bentazepam</td></tr><tr><td>ATC codes:</td><td>N05BA24</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB14719&quot;>DB14719</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/135412795&quot;>135412795</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135252&quot;>135252</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q1421936&quot;>Q1421936</a></td></tr><tr><td>formula:</td><td>C17H16N2OS</td></tr><tr><td>molar mass:</td><td>296.388 g/mol (PubChem)</td></tr></table></body></html>"));
