  annotation (Documentation(info = "<html><body><p>Inclisiran is a small interfering RNA medication used to treat hypercholesterolaemia and other dyslipidaemias. It is authorised in the European Union as a lipid-lowering agent.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q48969359&quot;>Wikidata Q48969359</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>inclisiran</td></tr><tr><td>ATC codes:</td><td>C10AX16</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB14901&quot;>DB14901</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q48969359&quot;>Q48969359</a></td></tr></table></body></html>"));
end Inclisiran;
