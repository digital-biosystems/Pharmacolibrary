  annotation (Documentation(info = "<html><body><p>Roxatidine is an H2-receptor antagonist developed as an anti-ulcer drug for acid-related disorders such as peptic ulcer and gastro-oesophageal reflux disease. It is considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q20077596\">Wikidata Q20077596</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>roxatidine</td></tr><tr><td>ATC codes:</td><td>A02BA06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08806\">DB08806</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5105\">5105</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:94758\">94758</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q20077596\">Q20077596</a></td></tr><tr><td>formula:</td><td>C19H28N2O4</td></tr><tr><td>molar mass:</td><td>348.443 g/mol (PubChem CID 5105)</td></tr><tr><td>logP:</td><td>1.5 (Drugs.Common 25.09, not verified)</td></tr></table><p><small>Drugs.Common 25.09 gave 306.4 g/mol (-12.1 %); replaced by the value above</small></p></body></html>"));
end Roxatidine;
