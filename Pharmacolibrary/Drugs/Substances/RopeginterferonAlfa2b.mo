  annotation (Documentation(info = "<html><body><p>Ropeginterferon alfa-2b is a long-acting pegylated interferon used to treat polycythemia vera. It is authorised in the European Union and remains investigational for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q99754007\">Wikidata Q99754007</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>ropeginterferon alfa-2b</td></tr><tr><td>ATC codes:</td><td>L03AB15</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB15119\">DB15119</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q99754007\">Q99754007</a></td></tr><tr><td>molar mass:</td><td>447.5 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>-1.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
