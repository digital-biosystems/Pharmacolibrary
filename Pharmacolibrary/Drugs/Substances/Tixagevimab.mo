  annotation (Documentation(info = "<html><body><p>Tixagevimab is an antiviral monoclonal antibody that targets the spike protein of the coronavirus and was used to help prevent infection in people at high risk.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q105908740\">Wikidata Q105908740</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Tixagevimab</td></tr><tr><td>ATC codes:</td><td>J06BD03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB16394\">DB16394</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q105908740\">Q105908740</a></td></tr></table></body></html>"));
end Tixagevimab;
