  annotation (Documentation(info = "<html><body><p>Tixagevimab is an antiviral monoclonal antibody that targets the spike protein of the coronavirus and was used to help prevent infection in people at high risk.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q105908740&quot;>Wikidata Q105908740</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Tixagevimab</td></tr><tr><td>ATC codes:</td><td>J06BD03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB16394&quot;>DB16394</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q105908740&quot;>Q105908740</a></td></tr><tr><td>molar mass:</td><td>152000 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
