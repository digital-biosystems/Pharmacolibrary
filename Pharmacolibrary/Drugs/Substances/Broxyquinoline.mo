    logP = 3.2);
  annotation (Documentation(info = "<html><body><p>Broxyquinoline is a quinoline derivative classified as an intestinal antiinfective, gynecological antiseptic, and agent against amoebiasis. It appears only as an experimental agent in drug databases, with no EU authorisation, so its current use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4976946\">Wikidata Q4976946</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>broxyquinoline</td></tr><tr><td>ATC codes:</td><td>A07AX01, G01AC06, P01AA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13536\">DB13536</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2453\">2453</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:109543\">109543</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4976946\">Q4976946</a></td></tr><tr><td>formula:</td><td>C9H5Br2NO</td></tr><tr><td>molar mass:</td><td>302.953 g/mol (PubChem CID 2453)</td></tr><tr><td>logP:</td><td>3.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Broxyquinoline;
