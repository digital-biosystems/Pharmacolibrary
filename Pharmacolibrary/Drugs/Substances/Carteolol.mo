within Pharmacolibrary.Drugs.Substances;
package Carteolol "carteolol"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "carteolol",
    atcCodes = {"C07AA15", "S01ED05"},
    drugbankId = "DB00521",
    pubchemCid = "2583",
    chebiId = "3437",
    wikidataId = "Q546434",
    formula = "C16H24N2O3",
    M = 0.292379,
    logP = 1);
  annotation (Documentation(info = "<html><body><p>Carteolol is a non-selective beta blocker used to treat arterial hypertension and to lower pressure in the eye in open-angle glaucoma and ocular hypertension. It is an approved medicine, available both as a cardiovascular beta blocker and as an eye drop for glaucoma.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q546434&quot;>Wikidata Q546434</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>carteolol</td></tr><tr><td>ATC codes:</td><td>C07AA15, S01ED05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00521&quot;>DB00521</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2583&quot;>2583</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3437&quot;>3437</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q546434&quot;>Q546434</a></td></tr><tr><td>formula:</td><td>C16H24N2O3</td></tr><tr><td>molar mass:</td><td>292.379 g/mol (PubChem)</td></tr></table></body></html>"));
end Carteolol;
