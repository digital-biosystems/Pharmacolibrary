  annotation (Documentation(info = "<html><body><p>Dimethylaminopropionylphenothiazine is classified as a synthetic antispasmodic for functional gastrointestinal disorders. It appears to have only experimental status, and no authorised use is documented in the available facts.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5277331&quot;>Wikidata Q5277331</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dimethylaminopropionylphenothiazine</td></tr><tr><td>ATC codes:</td><td>A03AC02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13672&quot;>DB13672</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/113918&quot;>113918</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:81224&quot;>81224</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5277331&quot;>Q5277331</a></td></tr><tr><td>formula:</td><td>C17H18N2OS</td></tr><tr><td>molar mass:</td><td>298.404 g/mol (PubChem)</td></tr></table></body></html>"));
