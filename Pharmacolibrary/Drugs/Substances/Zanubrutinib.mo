  annotation (Documentation(info = "<html><body><p>Zanubrutinib is a Bruton's tyrosine kinase inhibitor used to treat blood cancers, including mantle cell lymphoma and Waldenstrom macroglobulinemia. It is an approved medicine and is authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q75192022\">Wikidata Q75192022</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>zanubrutinib</td></tr><tr><td>ATC codes:</td><td>L01EL03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB15035\">DB15035</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/135565884\">135565884</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q75192022\">Q75192022</a></td></tr><tr><td>formula:</td><td>C27H29N5O3</td></tr><tr><td>molar mass:</td><td>471.561 g/mol (PubChem CID 135565884)</td></tr><tr><td>logP:</td><td>3.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
