  annotation (Documentation(info = "<html><body><p>Ecothiopate (echothiophate) is an eye drop medicine used to treat glaucoma, working as a parasympathomimetic miotic. It is an approved drug, but it is not authorised in the European Union and is now only rarely used.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4352952&quot;>Wikidata Q4352952</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ecothiopate</td></tr><tr><td>ATC codes:</td><td>S01EB03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01057&quot;>DB01057</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/10548&quot;>10548</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4753&quot;>4753</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4352952&quot;>Q4352952</a></td></tr><tr><td>formula:</td><td>C9H23NO3PS+</td></tr><tr><td>molar mass:</td><td>256.321 g/mol (PubChem)</td></tr></table></body></html>"));
end Ecothiopate;
