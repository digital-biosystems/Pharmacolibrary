  annotation (Documentation(info = "<html><body><p>Dopexamine is a cardiac stimulant that acts as a dopamine agonist and beta-adrenergic agonist with vasodilator effects, used to support heart function. It has been withdrawn and is no longer in clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5297311\">Wikidata Q5297311</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dopexamine</td></tr><tr><td>ATC codes:</td><td>C01CA14</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12313\">DB12313</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/55483\">55483</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135507\">135507</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5297311\">Q5297311</a></td></tr><tr><td>formula:</td><td>C22H32N2O2</td></tr><tr><td>molar mass:</td><td>356.51 g/mol (PubChem CID 55483)</td></tr><tr><td>logP:</td><td>2.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Dopexamine;
