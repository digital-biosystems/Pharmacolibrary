  annotation (Documentation(info = "<html><body><p>Sodium cellulose phosphate is a medication used to treat hypercalcemia (high blood calcium levels). It is an approved drug, though it does not appear to have a centralised European Union authorisation.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7553300&quot;>Wikidata Q7553300</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sodium cellulose phosphate</td></tr><tr><td>ATC codes:</td><td>V03AG01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06776&quot;>DB06776</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7553300&quot;>Q7553300</a></td></tr></table></body></html>"));
end SodiumCellulosePhosphate;
