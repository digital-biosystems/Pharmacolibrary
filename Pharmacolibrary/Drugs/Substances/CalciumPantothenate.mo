within Pharmacolibrary.Drugs.Substances;
package CalciumPantothenate "calcium pantothenate"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "calcium pantothenate",
    atcCodes = {"A11HA31", "D03AX04"},
    drugbankId = "DB01783",
    pubchemCid = "167945",
    wikidataId = "Q179894",
    formula = "C9H16NO5-",
    M = 0.218229,
    logP = 0);
  annotation (Documentation(info = "<html><body><p>Calcium pantothenate is a form of pantothenic acid, a B vitamin used as a vitamin supplement and in preparations for treating wounds and ulcers. It is approved as a plain vitamin preparation and as a dermatological cicatrizant, and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q179894&quot;>Wikidata Q179894</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>calcium pantothenate</td></tr><tr><td>ATC codes:</td><td>A11HA31, D03AX04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01783&quot;>DB01783</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/167945&quot;>167945</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q179894&quot;>Q179894</a></td></tr><tr><td>formula:</td><td>C9H16NO5-</td></tr><tr><td>molar mass:</td><td>218.229 g/mol (PubChem)</td></tr></table></body></html>"));
end CalciumPantothenate;
