    formula = "C9H16NO5-",
    M = 0.218229);
  annotation (Documentation(info = "<html><body><p>Calcium pantothenate, a form of pantothenic acid, is used as a vitamin preparation and as a cicatrizant for wounds and ulcers. It is approved as a supplement and veterinary medicine, and is also studied investigationally.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27261387\">Wikidata Q27261387</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>calcium pantothenate</td></tr><tr><td>ATC codes:</td><td>A11HA31, D03AX04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01783\">DB01783</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/167945\">167945</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27261387\">Q27261387</a></td></tr><tr><td>formula:</td><td>C9H16NO5-</td></tr><tr><td>molar mass:</td><td>218.229 g/mol (PubChem CID 167945)</td></tr></table><p><small>Drugs.Common 25.09 gave 476.5 g/mol (+118.3 %); replaced by the value above</small></p></body></html>"));
end CalciumPantothenate;
