  annotation (Documentation(info = "<html><body><p>Fendiline is a non-selective calcium channel blocker of the phenylalkylamine type, once used for cardiovascular conditions such as angina and high blood pressure. It is no longer in use, having been withdrawn from the market.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q999767\">Wikidata Q999767</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>fendiline</td></tr><tr><td>ATC codes:</td><td>C08EA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08980\">DB08980</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3336\">3336</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:94434\">94434</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q999767\">Q999767</a></td></tr><tr><td>formula:</td><td>C23H25N</td></tr><tr><td>molar mass:</td><td>315.46 g/mol (PubChem CID 3336)</td></tr><tr><td>logP:</td><td>5.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Fendiline;
