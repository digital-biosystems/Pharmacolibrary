    logP = 3.2);
  annotation (Documentation(info = "<html><body><p>Dixanthogen is a sulfur-containing ectoparasiticide, classified for use against parasites on the skin such as scabies and other ectoparasites. It is currently considered experimental, with no established approved therapeutic use, and no authorisation by the European Medicines Agency is recorded.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5284770&quot;>Wikidata Q5284770</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dixanthogen</td></tr><tr><td>ATC codes:</td><td>P03AA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13712&quot;>DB13712</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/10404&quot;>10404</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:82241&quot;>82241</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5284770&quot;>Q5284770</a></td></tr><tr><td>formula:</td><td>C6H10O2S4</td></tr><tr><td>molar mass:</td><td>242.384 g/mol (PubChem)</td></tr></table></body></html>"));
end Dixanthogen;
