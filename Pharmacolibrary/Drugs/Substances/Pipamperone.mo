    logP = 2);
  annotation (Documentation(info = "<html><body><p>Pipamperone is a butyrophenone antipsychotic that has been used to treat psychotic disorders and also acts as a serotonin antagonist. It is considered investigational in major drug databases and is not authorised in the European Union; it has mainly been used in a few European countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q415118\">Wikidata Q415118</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pipamperone</td></tr><tr><td>ATC codes:</td><td>N05AD05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09286\">DB09286</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4830\">4830</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:78549\">78549</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q415118\">Q415118</a></td></tr><tr><td>formula:</td><td>C21H30FN3O2</td></tr><tr><td>molar mass:</td><td>375.488 g/mol (PubChem CID 4830)</td></tr><tr><td>logP:</td><td>2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Pipamperone;
