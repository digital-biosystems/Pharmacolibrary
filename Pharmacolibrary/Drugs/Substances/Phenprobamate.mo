  annotation (Documentation(info = "<html><body><p>Phenprobamate is a centrally acting muscle relaxant that has been used to relieve muscle spasms and stiffness. It is classified as investigational in major drug databases and is not authorised in the European Union; its availability today is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7181402&quot;>Wikidata Q7181402</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>phenprobamate</td></tr><tr><td>ATC codes:</td><td>M03BA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13354&quot;>DB13354</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4770&quot;>4770</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31992&quot;>31992</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7181402&quot;>Q7181402</a></td></tr><tr><td>formula:</td><td>C10H13NO2</td></tr><tr><td>molar mass:</td><td>179.219 g/mol (PubChem)</td></tr></table></body></html>"));
