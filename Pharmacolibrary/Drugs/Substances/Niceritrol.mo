  annotation (Documentation(info = "<html><body><p>Niceritrol is a nicotinic acid derivative that has been used as a hypolipidemic agent to lower blood lipid levels. It is considered experimental and does not appear to be an approved medicine today.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q824174&quot;>Wikidata Q824174</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>niceritrol</td></tr><tr><td>ATC codes:</td><td>C10AD01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13441&quot;>DB13441</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4476&quot;>4476</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31903&quot;>31903</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q824174&quot;>Q824174</a></td></tr><tr><td>formula:</td><td>C29H24N4O8</td></tr><tr><td>molar mass:</td><td>556.531 g/mol (PubChem)</td></tr></table></body></html>"));
