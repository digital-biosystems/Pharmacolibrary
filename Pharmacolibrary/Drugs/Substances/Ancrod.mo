within Pharmacolibrary.Drugs.Substances;
package Ancrod "ancrod"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "ancrod",
    atcCodes = {"B01AD09"},
    drugbankId = "DB05099",
    wikidataId = "Q2846011");
  annotation (Documentation(info = "<html><body><p>Ancrod is an anticoagulant enzyme derived from snake venom that was used to treat thrombotic conditions by lowering fibrinogen levels. It has been withdrawn and is no longer in clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2846011&quot;>Wikidata Q2846011</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ancrod</td></tr><tr><td>ATC codes:</td><td>B01AD09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB05099&quot;>DB05099</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2846011&quot;>Q2846011</a></td></tr></table></body></html>"));
end Ancrod;
