    logP = 1.7);
  annotation (Documentation(info = "<html><body><p>Thioctic acid (alpha-lipoic acid) is used for conditions of the alimentary tract and metabolism, and is also taken as a dietary supplement. It is approved and widely available, being marketed both as a medicine and as a nutraceutical supplement.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27887203\">Wikidata Q27887203</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>thioctic acid</td></tr><tr><td>ATC codes:</td><td>A16AX01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00166\">DB00166</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6112\">6112</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:30314\">30314</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27887203\">Q27887203</a></td></tr><tr><td>formula:</td><td>C8H14O2S2</td></tr><tr><td>molar mass:</td><td>206.318 g/mol (PubChem CID 6112)</td></tr><tr><td>logP:</td><td>1.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end ThiocticAcid;
