    logP = -1.5);
  annotation (Documentation(info = "<html><body><p>Ertapenem is a carbapenem antibiotic used to treat bacterial infections such as sepsis, urinary tract infections, pyelonephritis, and skin infections. It is an approved antibiotic, authorised in the European Union, and used for a range of community-acquired bacterial infections.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q553220\">Wikidata Q553220</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>ertapenem</td></tr><tr><td>ATC codes:</td><td>J01DH03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00303\">DB00303</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/150610\">150610</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:404903\">404903</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q553220\">Q553220</a></td></tr><tr><td>formula:</td><td>C22H25N3O7S</td></tr><tr><td>molar mass:</td><td>475.516 g/mol (PubChem CID 150610)</td></tr><tr><td>logP:</td><td>-1.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Ertapenem;
