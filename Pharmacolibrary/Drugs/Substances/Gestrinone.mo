    logP = 2.2);
  annotation (Documentation(info = "<html><body><p>Gestrinone is a synthetic steroid hormone (an antigonadotropin/progestin) that has been used as an oral contraceptive and in the treatment of gynaecological conditions such as endometriosis. It is an approved drug, but it does not appear to be authorised in the European Union and is used only in some countries.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3761406&quot;>Wikidata Q3761406</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>gestrinone</td></tr><tr><td>ATC codes:</td><td>G03XA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11619&quot;>DB11619</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/27812&quot;>27812</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:89642&quot;>89642</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3761406&quot;>Q3761406</a></td></tr><tr><td>formula:</td><td>C21H24O2</td></tr><tr><td>molar mass:</td><td>308.421 g/mol (PubChem)</td></tr></table></body></html>"));
