  annotation (Documentation(info = "<html><body><p>Tesamorelin is a pharmaceutical drug that acts as a growth hormone-releasing agent, and it has been studied for investigational uses in addition to an approved indication. It is an approved medicine, but a marketing application for it in the European Union was withdrawn, so its use is limited to other regions.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7705415\">Wikidata Q7705415</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>tesamorelin</td></tr><tr><td>ATC codes:</td><td>H01AC06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08869\">DB08869</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/56928011\">56928011</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:63626\">63626</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7705415\">Q7705415</a></td></tr><tr><td>molar mass:</td><td>5136 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>-23.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
