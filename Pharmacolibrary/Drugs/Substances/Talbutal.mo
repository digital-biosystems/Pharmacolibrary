    logP = 1.4);
  annotation (Documentation(info = "<html><body><p>Talbutal is a barbiturate used as a sedative and hypnotic to treat insomnia and anxiety. It is an approved barbiturate sedative, though barbiturates of this kind are now rarely prescribed and it is also listed as illicit in some contexts.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q409942\">Wikidata Q409942</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>talbutal</td></tr><tr><td>ATC codes:</td><td>N05CA07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00306\">DB00306</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/8275\">8275</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134923\">134923</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q409942\">Q409942</a></td></tr><tr><td>formula:</td><td>C11H16N2O3</td></tr><tr><td>molar mass:</td><td>224.26 g/mol (PubChem CID 8275)</td></tr><tr><td>logP:</td><td>1.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Talbutal;
