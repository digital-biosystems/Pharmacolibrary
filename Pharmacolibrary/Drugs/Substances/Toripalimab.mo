  annotation (Documentation(info = "<html><body><p>Toripalimab is a PD-1 inhibitor monoclonal antibody used to treat cancers, including nasopharyngeal carcinoma and esophageal squamous cell carcinoma. It is approved and authorised in the European Union, with further uses still under investigation.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>toripalimab</td></tr><tr><td>ATC codes:</td><td>L01FF13</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB15043\">DB15043</a></td></tr><tr><td>molar mass:</td><td>150000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Toripalimab;
