  annotation (Documentation(info = "<html><body><p>Alosetron is a serotonin antagonist used to treat irritable bowel syndrome. It was withdrawn after serious gastrointestinal safety concerns but later made available again under a restricted programme in the United States, carrying a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q416463&quot;>Wikidata Q416463</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>alosetron</td></tr><tr><td>ATC codes:</td><td>A03AE01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00969&quot;>DB00969</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2099&quot;>2099</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:253342&quot;>253342</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q416463&quot;>Q416463</a></td></tr><tr><td>formula:</td><td>C17H18N4O</td></tr><tr><td>molar mass:</td><td>294.358 g/mol (PubChem)</td></tr></table></body></html>"));
