  annotation (Documentation(info = "<html><body><p>Patiromer is a potassium binder used to treat hyperkalemia (high blood potassium levels). It is an approved medicine, though detailed information on where and how widely it is used is not available here.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q21284261&quot;>Wikidata Q21284261</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>patiromer</td></tr><tr><td>ATC codes:</td><td>V03AE09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09263&quot;>DB09263</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q21284261&quot;>Q21284261</a></td></tr></table></body></html>"));
end Patiromer;
