    logP = 0);
  annotation (Documentation(info = "<html><body><p>Gadoxetic acid is a gadolinium-based contrast agent used in magnetic resonance imaging, particularly for liver imaging. It is an approved injectable contrast medium used in hospitals for MRI scans.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q15322710&quot;>Wikidata Q15322710</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>gadoxetic acid</td></tr><tr><td>ATC codes:</td><td>V08CA10</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08884&quot;>DB08884</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/131704314&quot;>131704314</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q15322710&quot;>Q15322710</a></td></tr><tr><td>formula:</td><td>C23H30GdN3O11</td></tr><tr><td>molar mass:</td><td>681.753 g/mol (PubChem)</td></tr></table></body></html>"));
end GadoxeticAcid;
