within Pharmacolibrary.Drugs.Substances;
package Pegteograstim "pegteograstim"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "pegteograstim",
    atcCodes = {"L03AA17"},
    drugbankId = "DB15290",
    wikidataId = "Q84770357");
  annotation (Documentation(info = "<html><body><p>Pegteograstim is a long-acting colony stimulating factor, a class of drugs used to stimulate white blood cell production, for example in patients receiving cancer chemotherapy. It is classed as investigational, meaning it has not been approved for routine clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q84770357\">Wikidata Q84770357</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pegteograstim</td></tr><tr><td>ATC codes:</td><td>L03AA17</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB15290\">DB15290</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q84770357\">Q84770357</a></td></tr></table></body></html>"));
end Pegteograstim;
