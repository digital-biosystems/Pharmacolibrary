  annotation (Documentation(info = "<html><body><p>Fomivirsen was an antiviral eye medicine used to treat cytomegalovirus retinitis in people with HIV infection. It is no longer used: its marketing authorisation in the European Union has been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q104213687&quot;>Wikidata Q104213687</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>fomivirsen</td></tr><tr><td>ATC codes:</td><td>S01AD08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06759&quot;>DB06759</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q104213687&quot;>Q104213687</a></td></tr><tr><td>molar mass:</td><td>7122 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Fomivirsen;
