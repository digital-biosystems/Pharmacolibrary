within Pharmacolibrary.Drugs.Substances;
package Emepronium "emepronium"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "emepronium",
    atcCodes = {"G04BD01"},
    drugbankId = "DB13505",
    pubchemCid = "34055",
    chebiId = "135169",
    wikidataId = "Q27247669",
    formula = "C20H28N+",
    M = 0.282451,
    logP = 4.8);
  annotation (Documentation(info = "<html><body><p>Emepronium is an anticholinergic (muscarinic antagonist) drug that was used as a urological agent for urinary frequency and incontinence, and in combination products for functional gastrointestinal disorders. It appears to be no longer in routine use, being classed as experimental, with no EU authorisation on record.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27247669\">Wikidata Q27247669</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>emepronium</td></tr><tr><td>ATC codes:</td><td>G04BD01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13505\">DB13505</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/34055\">34055</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135169\">135169</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27247669\">Q27247669</a></td></tr><tr><td>formula:</td><td>C20H28N+</td></tr><tr><td>molar mass:</td><td>282.451 g/mol (PubChem CID 34055)</td></tr><tr><td>logP:</td><td>4.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Emepronium;
