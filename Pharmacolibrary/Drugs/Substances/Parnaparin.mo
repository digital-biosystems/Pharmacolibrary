within Pharmacolibrary.Drugs.Substances;
package Parnaparin "parnaparin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "parnaparin",
    atcCodes = {"B01AB07"},
    drugbankId = "DB09260",
    wikidataId = "Q3896308");
  annotation (Documentation(info = "<html><body><p>Parnaparin is a low-molecular-weight heparin used as an antithrombotic to prevent and treat blood clots. It is an approved medicine, used mainly in Italy and not widely elsewhere.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3896308\">Wikidata Q3896308</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>parnaparin</td></tr><tr><td>ATC codes:</td><td>B01AB07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09260\">DB09260</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3896308\">Q3896308</a></td></tr></table></body></html>"));
end Parnaparin;
