  annotation (Documentation(info = "<html><body><p>Antazoline is an antihistamine used to treat allergic eye conditions such as giant papillary conjunctivitis. It is an approved medicine, used topically in nasal preparations and also as a systemic antihistamine.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q771975\">Wikidata Q771975</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>antazoline</td></tr><tr><td>ATC codes:</td><td>R01AC04, R06AX05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08799\">DB08799</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2200\">2200</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:84115\">84115</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q771975\">Q771975</a></td></tr><tr><td>formula:</td><td>C17H19N3</td></tr><tr><td>molar mass:</td><td>265.36 g/mol (PubChem CID 2200)</td></tr><tr><td>logP:</td><td>2.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
