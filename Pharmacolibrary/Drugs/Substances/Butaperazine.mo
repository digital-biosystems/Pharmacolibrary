  annotation (Documentation(info = "<html><body><p>Butaperazine is a phenothiazine antipsychotic used to treat psychotic disorders such as schizophrenia. It is an approved antipsychotic, but it is not widely used today and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5002359&quot;>Wikidata Q5002359</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>butaperazine</td></tr><tr><td>ATC codes:</td><td>N05AB09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13213&quot;>DB13213</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/12598&quot;>12598</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135663&quot;>135663</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5002359&quot;>Q5002359</a></td></tr><tr><td>formula:</td><td>C24H31N3OS</td></tr><tr><td>molar mass:</td><td>409.592 g/mol (PubChem)</td></tr></table></body></html>"));
