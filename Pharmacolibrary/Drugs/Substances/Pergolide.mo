    logP = 4.2);
  annotation (Documentation(info = "<html><body><p>Pergolide is a dopamine agonist of the ergot alkaloid family that was used to treat Parkinson's disease and Tourette syndrome. It has been withdrawn from human use because of serious heart valve damage, though it remains approved in veterinary medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q415752\">Wikidata Q415752</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pergolide</td></tr><tr><td>ATC codes:</td><td>N04BC02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01186\">DB01186</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/47811\">47811</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:63617\">63617</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q415752\">Q415752</a></td></tr><tr><td>formula:</td><td>C19H26N2S</td></tr><tr><td>molar mass:</td><td>314.491 g/mol (PubChem CID 47811)</td></tr><tr><td>logP:</td><td>4.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
