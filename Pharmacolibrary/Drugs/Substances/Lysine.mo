    logP = -3);
  annotation (Documentation(info = "<html><body><p>Lysine is an essential amino acid used as an additive to intravenous solutions and as a detoxifying agent during antineoplastic treatment; it has also been linked to patent ductus arteriosus. It is approved and also regarded as a nutraceutical, though some of its uses remain investigational.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q20816880&quot;>Wikidata Q20816880</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>lysine</td></tr><tr><td>ATC codes:</td><td>B05XB03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00123&quot;>DB00123</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5962&quot;>5962</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:194466&quot;>194466</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q20816880&quot;>Q20816880</a></td></tr><tr><td>formula:</td><td>C6H14N2O2</td></tr><tr><td>molar mass:</td><td>146.19 g/mol (PubChem)</td></tr></table></body></html>"));
end Lysine;
