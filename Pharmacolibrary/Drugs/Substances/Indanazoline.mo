  annotation (Documentation(info = "<html><body><p>Indanazoline is a sympathomimetic agent classified as a nasal decongestant for topical use. It appears to be only experimental, with no authorised marketing identified in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27282563\">Wikidata Q27282563</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>indanazoline</td></tr><tr><td>ATC codes:</td><td>R01AA15</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13827\">DB13827</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/65979\">65979</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134863\">134863</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27282563\">Q27282563</a></td></tr><tr><td>formula:</td><td>C12H15N3</td></tr><tr><td>molar mass:</td><td>201.273 g/mol (PubChem CID 65979)</td></tr><tr><td>logP:</td><td>1.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
