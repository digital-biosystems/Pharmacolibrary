  annotation (Documentation(info = "<html><body><p>Tisopurine is a xanthine oxidase inhibitor that was used as an antigout agent, lowering uric acid production. It is classified as experimental and does not appear to be an approved medicine today, so its current availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7809617&quot;>Wikidata Q7809617</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tisopurine</td></tr><tr><td>ATC codes:</td><td>M04AA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13807&quot;>DB13807</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/135445058&quot;>135445058</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134776&quot;>134776</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7809617&quot;>Q7809617</a></td></tr><tr><td>formula:</td><td>C5H4N4S</td></tr><tr><td>molar mass:</td><td>152.175 g/mol (PubChem)</td></tr></table></body></html>"));
