    logP = 0.8);
  annotation (Documentation(info = "<html><body><p>Ticarcillin is a penicillin antibiotic used to treat bacterial infections such as sepsis, urinary, skin and respiratory tract infections, and Pseudomonas and other gram-negative infections. It has been withdrawn from human use, though it was also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2601832&quot;>Wikidata Q2601832</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ticarcillin</td></tr><tr><td>ATC codes:</td><td>J01CA13</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01607&quot;>DB01607</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/36921&quot;>36921</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9587&quot;>9587</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2601832&quot;>Q2601832</a></td></tr><tr><td>formula:</td><td>C15H16N2O6S2</td></tr><tr><td>molar mass:</td><td>384.421 g/mol (PubChem)</td></tr></table></body></html>"));
end Ticarcillin;
