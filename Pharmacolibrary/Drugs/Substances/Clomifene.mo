  annotation (Documentation(info = "<html><body><p>Clomifene is an ovulation stimulant used as a fertility agent to treat female infertility. It is widely used and appears on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q418730\">Wikidata Q418730</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>clomifene</td></tr><tr><td>ATC codes:</td><td>G03GB02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00882\">DB00882</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2800\">2800</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3752\">3752</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q418730\">Q418730</a></td></tr><tr><td>formula:</td><td>C26H28ClNO</td></tr><tr><td>molar mass:</td><td>405.966 g/mol (PubChem CID 2800)</td></tr><tr><td>logP:</td><td>7.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
