  annotation (Documentation(info = "<html><body><p>Belotecan is a topoisomerase I inhibitor investigated for treating ovarian cancer and small cell lung cancer. It is not an approved medicine and remains investigational, with no authorisation in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4884574&quot;>Wikidata Q4884574</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>belotecan</td></tr><tr><td>ATC codes:</td><td>L01CE04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12459&quot;>DB12459</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6456014&quot;>6456014</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135702&quot;>135702</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4884574&quot;>Q4884574</a></td></tr><tr><td>formula:</td><td>C25H27N3O4</td></tr><tr><td>molar mass:</td><td>433.508 g/mol (PubChem)</td></tr></table></body></html>"));
