  annotation (Documentation(info = "<html><body><p>Nifurtoinol is a nitrofuran antibacterial that acts as a urinary anti-infective agent. It is considered experimental and there is no evidence it is currently authorised or in widespread clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q1217936&quot;>Wikidata Q1217936</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nifurtoinol</td></tr><tr><td>ATC codes:</td><td>J01XE02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13730&quot;>DB13730</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/9571062&quot;>9571062</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:88255&quot;>88255</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q1217936&quot;>Q1217936</a></td></tr><tr><td>formula:</td><td>C9H8N4O6</td></tr><tr><td>molar mass:</td><td>268.185 g/mol (PubChem)</td></tr></table></body></html>"));
