  annotation (Documentation(info = "<html><body><p>Sodium zirconium cyclosilicate is a potassium binder used to treat hyperkalemia (high blood potassium). It is authorised in the European Union and is an approved medicine, used for the treatment of hyperkalemia.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q17091153&quot;>Wikidata Q17091153</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>sodium zirconium cyclosilicate</td></tr><tr><td>ATC codes:</td><td>V03AE10</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB14048&quot;>DB14048</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q17091153&quot;>Q17091153</a></td></tr><tr><td>formula:</td><td>Na2O9Si3Zr</td></tr><tr><td>molar mass:</td><td>365.452 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end SodiumZirconiumCyclosilicate;
