  annotation (Documentation(info = "<html><body><p>Nafarelin is a gonadotropin-releasing hormone analogue used to treat endometriosis. It is an approved medicine, though not authorised in the European Union, and has also been investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3869873\">Wikidata Q3869873</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nafarelin</td></tr><tr><td>ATC codes:</td><td>H01CA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00666\">DB00666</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/25077405\">25077405</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7445\">7445</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3869873\">Q3869873</a></td></tr><tr><td>formula:</td><td>C66H83N17O13</td></tr><tr><td>molar mass:</td><td>1322.5 g/mol (PubChem CID 25077405)</td></tr><tr><td>logP:</td><td>0.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
