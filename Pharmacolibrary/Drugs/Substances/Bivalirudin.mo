  annotation (Documentation(info = "<html><body><p>Bivalirudin is a direct thrombin inhibitor used as an anticoagulant, notably in acute coronary syndrome and unstable angina. It is an approved antithrombotic, though one product has been withdrawn in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4919218\">Wikidata Q4919218</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>bivalirudin</td></tr><tr><td>ATC codes:</td><td>B01AE06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00006\">DB00006</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/16129704\">16129704</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:59173\">59173</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4919218\">Q4919218</a></td></tr><tr><td>formula:</td><td>C98H138N24O33</td></tr><tr><td>molar mass:</td><td>2180.32 g/mol (PubChem CID 16129704)</td></tr><tr><td>logP:</td><td>-7.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
