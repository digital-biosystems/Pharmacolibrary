    wikidataId = "Q906271");
  annotation (Documentation(info = "<html><body><p>Danaparoid is an anticoagulant of the heparin group used to prevent and treat blood clots. It was approved at one time but has since been withdrawn and is no longer in general use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q906271&quot;>Wikidata Q906271</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>danaparoid</td></tr><tr><td>ATC codes:</td><td>B01AB09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06754&quot;>DB06754</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q906271&quot;>Q906271</a></td></tr></table></body></html>"));
end Danaparoid;
