  annotation (Documentation(info = "<html><body><p>Artemotil is an artemisinin-derivative antimalarial used to treat malaria. It is an approved antimalarial, though it does not appear to be authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q72443831\">Wikidata Q72443831</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>artemotil</td></tr><tr><td>ATC codes:</td><td>P01BE04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13851\">DB13851</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3000469\">3000469</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135335\">135335</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q72443831\">Q72443831</a></td></tr><tr><td>formula:</td><td>C17H28O5</td></tr><tr><td>molar mass:</td><td>312.406 g/mol (PubChem CID 3000469)</td></tr><tr><td>logP:</td><td>3.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Artemotil;
