  annotation (Documentation(info = "<html><body><p>Diiodohydroxypropane is an iodine-containing compound classified as a dermatological antiseptic and disinfectant. It appears only as an experimental agent in drug databases, so its current clinical use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1811187\">Wikidata Q1811187</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>diiodohydroxypropane</td></tr><tr><td>ATC codes:</td><td>D08AG04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13383\">DB13383</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/68295\">68295</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135970\">135970</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1811187\">Q1811187</a></td></tr><tr><td>formula:</td><td>C3H6I2O</td></tr><tr><td>molar mass:</td><td>311.88 g/mol (PubChem CID 68295)</td></tr><tr><td>logP:</td><td>1.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
