  annotation (Documentation(info = "<html><body><p>Magnesium carbonate is an antacid used to relieve heartburn, indigestion, and gastroesophageal reflux, and is also used as a laxative for constipation. It is an approved, widely available over-the-counter medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q407931&quot;>Wikidata Q407931</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>magnesium carbonate</td></tr><tr><td>ATC codes:</td><td>A02AA01, A06AD01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09481&quot;>DB09481</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/11029&quot;>11029</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31793&quot;>31793</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q407931&quot;>Q407931</a></td></tr><tr><td>formula:</td><td>CMgO3</td></tr><tr><td>molar mass:</td><td>84.313 g/mol (PubChem)</td></tr></table></body></html>"));
