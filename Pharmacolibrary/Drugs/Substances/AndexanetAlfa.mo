within Pharmacolibrary.Drugs.Substances;
package AndexanetAlfa "andexanet alfa"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "andexanet alfa",
    atcCodes = {"V03AB38"},
    drugbankId = "DB14562",
    wikidataId = "Q7120529");
  annotation (Documentation(info = "<html><body><p>Andexanet alfa is an antidote used to reverse the anticoagulant effects of the direct oral anticoagulants apixaban and rivaroxaban. It is authorised in the European Union and carries a boxed warning, so its use is limited to urgent bleeding situations under close supervision.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7120529&quot;>Wikidata Q7120529</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>andexanet alfa</td></tr><tr><td>ATC codes:</td><td>V03AB38</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB14562&quot;>DB14562</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7120529&quot;>Q7120529</a></td></tr></table></body></html>"));
end AndexanetAlfa;
