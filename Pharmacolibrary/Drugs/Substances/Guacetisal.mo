  annotation (Documentation(info = "<html><body><p>Guacetisal is a salicylic acid derivative that has been used as a pain-relieving, anti-inflammatory medicine and also as a cough remedy that helps clear mucus. It appears to be only experimental today, with no evidence of current authorisation or widespread use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q1028455&quot;>Wikidata Q1028455</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>guacetisal</td></tr><tr><td>ATC codes:</td><td>N02BA14</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13538&quot;>DB13538</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/68749&quot;>68749</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135185&quot;>135185</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q1028455&quot;>Q1028455</a></td></tr><tr><td>formula:</td><td>C16H14O5</td></tr><tr><td>molar mass:</td><td>286.283 g/mol (PubChem)</td></tr></table></body></html>"));
