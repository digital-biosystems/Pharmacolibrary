  annotation (Documentation(info = "<html><body><p>Levosulpiride, the left-handed form of sulpiride, has been used to treat schizophrenia, major depressive disorder, and indigestion. It is classified as investigational and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1452256\">Wikidata Q1452256</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>levosulpiride</td></tr><tr><td>ATC codes:</td><td>N05AL07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB16021\">DB16021</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/688272\">688272</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:64119\">64119</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1452256\">Q1452256</a></td></tr><tr><td>formula:</td><td>C15H23N3O4S</td></tr><tr><td>molar mass:</td><td>341.426 g/mol (PubChem CID 688272)</td></tr><tr><td>logP:</td><td>0.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
