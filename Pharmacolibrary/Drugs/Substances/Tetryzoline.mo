    logP = 1.8);
  annotation (Documentation(info = "<html><body><p>Tetryzoline is a decongestant used to relieve nasal congestion in conditions such as sinusitis and vasomotor rhinitis, and to reduce redness of the eye. It remains an approved medicine, available in nasal sprays and eye drops for topical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q425109\">Wikidata Q425109</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tetryzoline</td></tr><tr><td>ATC codes:</td><td>R01AA06, R01AB03, S01GA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06764\">DB06764</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5419\">5419</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:28674\">28674</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q425109\">Q425109</a></td></tr><tr><td>formula:</td><td>C13H16N2</td></tr><tr><td>molar mass:</td><td>200.285 g/mol (PubChem CID 5419)</td></tr><tr><td>logP:</td><td>1.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Tetryzoline;
