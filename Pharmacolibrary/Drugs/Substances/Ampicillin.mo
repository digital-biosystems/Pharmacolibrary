  annotation (Documentation(info = "<html><body><p>Ampicillin is a penicillin antibiotic used to treat a range of bacterial infections, including urinary tract infections, meningitis, and respiratory infections. It is an approved medicine on the WHO essential medicines list and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q244150&quot;>Wikidata Q244150</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ampicillin</td></tr><tr><td>ATC codes:</td><td>J01CA01, S01AA19</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00415&quot;>DB00415</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6249&quot;>6249</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:28971&quot;>28971</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q244150&quot;>Q244150</a></td></tr><tr><td>formula:</td><td>C16H19N3O4S</td></tr><tr><td>molar mass:</td><td>349.405 g/mol (PubChem)</td></tr></table></body></html>"));
