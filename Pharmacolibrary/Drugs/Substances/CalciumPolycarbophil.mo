within Pharmacolibrary.Drugs.Substances;
package CalciumPolycarbophil "Calcium polycarbophil"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "Calcium polycarbophil",
    atcCodes = {"A06AC08"},
    drugbankId = "DB14684",
    wikidataId = "Q7226181");
  annotation (Documentation(info = "<html><body><p>Calcium polycarbophil is a bulk-forming laxative used to treat constipation and irritable bowel syndrome, and it can also act as an antidiarrhoeal. It is an approved drug, but it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7226181&quot;>Wikidata Q7226181</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Calcium polycarbophil</td></tr><tr><td>ATC codes:</td><td>A06AC08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB14684&quot;>DB14684</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7226181&quot;>Q7226181</a></td></tr></table></body></html>"));
end CalciumPolycarbophil;
