    logP = -1.5);
  annotation (Documentation(info = "<html><body><p>Riboflavin, a B vitamin, is used to treat or prevent ariboflavinosis, a deficiency of this vitamin. It is widely used as a vitamin supplement, appears on the WHO essential medicines list, and is also approved for veterinary use and as a nutraceutical.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q130365&quot;>Wikidata Q130365</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>riboflavin</td></tr><tr><td>ATC codes:</td><td>A11HA04, S01XA26</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00140&quot;>DB00140</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/493570&quot;>493570</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:17015&quot;>17015</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q130365&quot;>Q130365</a></td></tr><tr><td>formula:</td><td>C17H20N4O6</td></tr><tr><td>molar mass:</td><td>376.369 g/mol (PubChem)</td></tr></table></body></html>"));
end Riboflavin;
