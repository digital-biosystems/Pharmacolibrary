  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "riboflavin",
    atcCodes = {"A11HA04", "S01XA26"},
    drugbankId = "DB00140",
    pubchemCid = "493570",
    chebiId = "17015",
    wikidataId = "Q130365",
