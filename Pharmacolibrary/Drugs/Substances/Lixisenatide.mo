  annotation (Documentation(info = "<html><body><p>Lixisenatide is a glucagon-like peptide-1 agonist used as an anti-diabetic medication for type 2 diabetes. It is an approved injectable diabetes drug, authorised in the European Union, although one product there has been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6659956\">Wikidata Q6659956</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>lixisenatide</td></tr><tr><td>ATC codes:</td><td>A10BJ03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09265\">DB09265</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/131704317\">131704317</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:85662\">85662</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6659956\">Q6659956</a></td></tr><tr><td>molar mass:</td><td>4858 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>-30.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
