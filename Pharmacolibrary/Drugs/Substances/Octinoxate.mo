  annotation (Documentation(info = "<html><body><p>Octinoxate is a sunscreen agent that protects the skin against UV radiation. It is an approved, widely used ingredient in topical sun protection products.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q739648&quot;>Wikidata Q739648</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>octinoxate</td></tr><tr><td>ATC codes:</td><td>D02BA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09496&quot;>DB09496</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5355130&quot;>5355130</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:88667&quot;>88667</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q739648&quot;>Q739648</a></td></tr><tr><td>formula:</td><td>C18H26O3</td></tr><tr><td>molar mass:</td><td>290.403 g/mol (PubChem)</td></tr></table></body></html>"));
