  annotation (Documentation(info = "<html><body><p>Carboquone is an alkylating agent that has been used as an anticancer (antineoplastic) drug. It is not an established marketed medicine in major Western databases, where it is listed only as experimental, and it appears to be used mainly in Japan.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5038065&quot;>Wikidata Q5038065</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>carboquone</td></tr><tr><td>ATC codes:</td><td>L01AC03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13677&quot;>DB13677</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2569&quot;>2569</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31356&quot;>31356</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5038065&quot;>Q5038065</a></td></tr><tr><td>formula:</td><td>C15H19N3O5</td></tr><tr><td>molar mass:</td><td>321.333 g/mol (PubChem)</td></tr></table></body></html>"));
