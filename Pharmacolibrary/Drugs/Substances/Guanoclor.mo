  annotation (Documentation(info = "<html><body><p>Guanoclor is a guanidine derivative classified as a peripherally acting antiadrenergic antihypertensive agent, indicating it was used to treat high blood pressure. It is currently listed only as an experimental drug, with no authorisation records, so its present availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5613775\">Wikidata Q5613775</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>guanoclor</td></tr><tr><td>ATC codes:</td><td>C02CC05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13779\">DB13779</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/71835\">71835</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135992\">135992</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5613775\">Q5613775</a></td></tr><tr><td>formula:</td><td>C9H12Cl2N4O</td></tr><tr><td>molar mass:</td><td>263.122 g/mol (PubChem CID 71835)</td></tr><tr><td>logP:</td><td>2.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
