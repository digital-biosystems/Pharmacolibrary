    logP = 2.9);
  annotation (Documentation(info = "<html><body><p>Niperotidine is an H2-receptor antagonist developed for acid-related disorders such as peptic ulcer and gastro-oesophageal reflux disease. It is considered investigational and does not appear to be an approved medicine in major markets such as the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7039435\">Wikidata Q7039435</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>niperotidine</td></tr><tr><td>ATC codes:</td><td>A02BA05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13760\">DB13760</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/66753191\">66753191</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135706\">135706</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7039435\">Q7039435</a></td></tr><tr><td>formula:</td><td>C20H26N4O5S</td></tr><tr><td>molar mass:</td><td>434.511 g/mol (PubChem CID 66753191)</td></tr><tr><td>logP:</td><td>2.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Niperotidine;
