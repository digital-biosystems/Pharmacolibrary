    logP = 2.9);
  annotation (Documentation(info = "<html><body><p>Niperotidine is an H2-receptor antagonist developed for acid-related disorders such as peptic ulcer and gastro-oesophageal reflux disease. It appears to be investigational rather than an approved medicine, with no marketing authorisation recorded in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q110907625&quot;>Wikidata Q110907625</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>niperotidine</td></tr><tr><td>ATC codes:</td><td>A02BA05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13760&quot;>DB13760</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/66753191&quot;>66753191</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135706&quot;>135706</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q110907625&quot;>Q110907625</a></td></tr><tr><td>formula:</td><td>C20H26N4O5S</td></tr><tr><td>molar mass:</td><td>434.511 g/mol (PubChem)</td></tr></table></body></html>"));
end Niperotidine;
