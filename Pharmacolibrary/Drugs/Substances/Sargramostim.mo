    M = 14.4345);
  annotation (Documentation(info = "<html><body><p>Sargramostim, a granulocyte-macrophage colony-stimulating factor, is an immunostimulant used in cancers such as breast cancer, melanoma, and lymphomas, and is authorised in the European Union for acute radiation syndrome. It remains in use, with an authorised product in the European Union, though its use appears limited to specific indications.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3950557&quot;>Wikidata Q3950557</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>sargramostim</td></tr><tr><td>ATC codes:</td><td>L03AA09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00020&quot;>DB00020</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3950557&quot;>Q3950557</a></td></tr><tr><td>molar mass:</td><td>14434.5 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Sargramostim;
