    logP = 3.9);
  annotation (Documentation(info = "<html><body><p>Iopanoic acid is an iodinated X-ray contrast medium used for imaging of the gallbladder and bile ducts, and has also been used to treat hyperthyroidism. It has been withdrawn and is no longer in clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1672108\">Wikidata Q1672108</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>iopanoic acid</td></tr><tr><td>ATC codes:</td><td>V08AC06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08946\">DB08946</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3735\">3735</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:5951\">5951</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1672108\">Q1672108</a></td></tr><tr><td>formula:</td><td>C11H12I3NO2</td></tr><tr><td>molar mass:</td><td>570.922 g/mol (PubChem CID 3735)</td></tr><tr><td>logP:</td><td>3.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end IopanoicAcid;
