  annotation (Documentation(info = "<html><body><p>Nitrofurantoin is an antibiotic used to treat urinary tract infections, including cystitis, and other gram-negative bacterial infections. It is an approved medicine, appears on the WHO list of essential medicines, and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q422669\">Wikidata Q422669</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nitrofurantoin</td></tr><tr><td>ATC codes:</td><td>J01XE01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00698\">DB00698</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6604200\">6604200</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:71415\">71415</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q422669\">Q422669</a></td></tr><tr><td>formula:</td><td>C8H6N4O5</td></tr><tr><td>molar mass:</td><td>238.159 g/mol (PubChem CID 6604200)</td></tr><tr><td>logP:</td><td>-0.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
