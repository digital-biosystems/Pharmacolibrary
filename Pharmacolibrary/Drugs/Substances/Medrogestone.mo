  annotation (Documentation(info = "<html><body><p>Medrogestone is a progestogen that was used in hormone therapy, both alone and in sequential combination with estrogens. It has been withdrawn and is no longer available.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6807285\">Wikidata Q6807285</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>medrogestone</td></tr><tr><td>ATC codes:</td><td>G03DB03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09124\">DB09124</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9949848\">9949848</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135446\">135446</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6807285\">Q6807285</a></td></tr><tr><td>formula:</td><td>C23H32O2</td></tr><tr><td>molar mass:</td><td>340.507 g/mol (PubChem CID 9949848)</td></tr><tr><td>logP:</td><td>4.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
