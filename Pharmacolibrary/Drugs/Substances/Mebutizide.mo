  annotation (Documentation(info = "<html><body><p>Mebutizide is a thiazide-class diuretic, a drug type used to treat high blood pressure and fluid retention. It is listed as an experimental drug and has no marketing authorisation in the European Union, so it does not appear to be in routine clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6804380\">Wikidata Q6804380</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mebutizide</td></tr><tr><td>ATC codes:</td><td>C03AA13</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13430\">DB13430</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/71652\">71652</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135597\">135597</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6804380\">Q6804380</a></td></tr><tr><td>formula:</td><td>C13H20ClN3O4S2</td></tr><tr><td>molar mass:</td><td>381.89 g/mol (PubChem CID 71652)</td></tr><tr><td>logP:</td><td>2.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
