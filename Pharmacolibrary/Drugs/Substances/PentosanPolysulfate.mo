  annotation (Documentation(info = "<html><body><p>Pentosan polysulfate is a urological drug used to treat interstitial cystitis, and is also applied topically as a vasoprotective agent. It is an approved medicine, and is also being studied for other uses; it is additionally known as a treatment for joint disease in animals.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q72500089&quot;>Wikidata Q72500089</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Pentosan polysulfate</td></tr><tr><td>ATC codes:</td><td>C05BA04, G04BX15</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00686&quot;>DB00686</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q72500089&quot;>Q72500089</a></td></tr></table></body></html>"));
end PentosanPolysulfate;
