    logP = 3.8);
  annotation (Documentation(info = "<html><body><p>Pridinol is a centrally acting muscle relaxant used for painful muscle spasms and related musculoskeletal conditions. It is considered investigational in DrugBank and is not authorised in the European Union; it appears to be used only in a few countries.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q827515&quot;>Wikidata Q827515</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pridinol</td></tr><tr><td>ATC codes:</td><td>M03BX03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13642&quot;>DB13642</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4904&quot;>4904</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:75247&quot;>75247</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q827515&quot;>Q827515</a></td></tr><tr><td>formula:</td><td>C20H25NO</td></tr><tr><td>molar mass:</td><td>295.426 g/mol (PubChem)</td></tr></table></body></html>"));
