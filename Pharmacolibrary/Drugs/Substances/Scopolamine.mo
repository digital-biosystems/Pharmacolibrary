  annotation (Documentation(info = "<html><body><p>Scopolamine is an anticholinergic used for conditions such as motion sickness, iridocyclitis, and other disorders listed in its treatment records. It remains an approved medicine and is included on the WHO essential medicines list, used in ophthalmic, antiemetic, and sedative roles.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q337188\">Wikidata Q337188</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>scopolamine</td></tr><tr><td>ATC codes:</td><td>A04AD01, N05CM05, S01FA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00747\">DB00747</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3000322\">3000322</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:16794\">16794</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q337188\">Q337188</a></td></tr><tr><td>formula:</td><td>C17H21NO4</td></tr><tr><td>molar mass:</td><td>303.358 g/mol (PubChem CID 3000322)</td></tr><tr><td>logP:</td><td>0.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
