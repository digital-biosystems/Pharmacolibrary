  annotation (Documentation(info = "<html><body><p>Cilastatin is used as part of a combination antibacterial treatment with imipenem for bacterial infections. The combination is a WHO essential medicine and is widely used, mainly in hospital settings for serious infections.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6004128&quot;>Wikidata Q6004128</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Cilastatin</td></tr><tr><td>ATC codes:</td><td>J01DH51, J01DH56</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01597&quot;>DB01597</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6435415&quot;>6435415</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6004128&quot;>Q6004128</a></td></tr><tr><td>formula:</td><td>C16H26N2O5S</td></tr><tr><td>molar mass:</td><td>358.453 g/mol (PubChem)</td></tr></table></body></html>"));
end Cilastatin;
