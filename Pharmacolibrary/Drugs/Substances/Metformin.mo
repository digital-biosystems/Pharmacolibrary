    logP = -1.3);
  annotation (Documentation(info = "<html><body><p>Metformin is an anti-diabetic medicine used to treat diabetes and high blood sugar, including maturity-onset diabetes of the young type 2. It is widely used and appears on the WHO list of essential medicines, and is also available in many combination products with other oral glucose-lowering drugs.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q19484&quot;>Wikidata Q19484</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>metformin</td></tr><tr><td>ATC codes:</td><td>A10BA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00331&quot;>DB00331</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4091&quot;>4091</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6801&quot;>6801</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q19484&quot;>Q19484</a></td></tr><tr><td>formula:</td><td>C4H11N5</td></tr><tr><td>molar mass:</td><td>129.167 g/mol (PubChem)</td></tr></table></body></html>"));
end Metformin;
