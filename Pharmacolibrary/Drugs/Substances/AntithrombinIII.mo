within Pharmacolibrary.Drugs.Substances;
package AntithrombinIII "antithrombin III"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "antithrombin III",
    atcCodes = {"B01AB02"},
    drugbankId = "DB11598",
    wikidataId = "Q24775482");
  annotation (Documentation(info = "<html><body><p>Antithrombin III is a blood protein used to treat or prevent excessive clotting, especially in people with antithrombin deficiency, and it works together with heparin. It is an approved medicine, given by infusion, mainly in hospital settings for clotting problems.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q24775482&quot;>Wikidata Q24775482</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>antithrombin III</td></tr><tr><td>ATC codes:</td><td>B01AB02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11598&quot;>DB11598</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q24775482&quot;>Q24775482</a></td></tr></table></body></html>"));
end AntithrombinIII;
