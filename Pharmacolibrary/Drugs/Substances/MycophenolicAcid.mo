    logP = 3.2);
  annotation (Documentation(info = "<html><body><p>Mycophenolic acid is an immunosuppressant used to prevent organ transplant rejection and, according to Wikidata, also to treat lupus nephritis. It is an approved medicine, widely used in transplant medicine, and has also been studied for other investigational uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q420553&quot;>Wikidata Q420553</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mycophenolic acid</td></tr><tr><td>ATC codes:</td><td>L04AA06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01024&quot;>DB01024</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/446541&quot;>446541</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:168396&quot;>168396</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q420553&quot;>Q420553</a></td></tr><tr><td>formula:</td><td>C17H20O6</td></tr><tr><td>molar mass:</td><td>320.341 g/mol (PubChem)</td></tr></table></body></html>"));
