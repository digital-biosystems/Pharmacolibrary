  annotation (Documentation(info = "<html><body><p>Dyclonine is a local anesthetic used to relieve pain, especially in the throat, such as with pharyngitis. It is an approved drug used mainly in throat preparations for topical numbing of the mouth and throat.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q425386\">Wikidata Q425386</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dyclonine</td></tr><tr><td>ATC codes:</td><td>N01BX02, R02AD04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00645\">DB00645</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3180\">3180</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4724\">4724</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q425386\">Q425386</a></td></tr><tr><td>formula:</td><td>C18H27NO2</td></tr><tr><td>molar mass:</td><td>289.419 g/mol (PubChem CID 3180)</td></tr><tr><td>logP:</td><td>3.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
