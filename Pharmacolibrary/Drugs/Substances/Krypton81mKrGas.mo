  annotation (Documentation(info = "<html><body><p>Krypton-81m gas is a diagnostic radiopharmaceutical used for imaging of the respiratory system, such as lung ventilation studies. It is an approved diagnostic agent, used in specialised nuclear medicine settings rather than widely in routine care.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q18880414\">Wikidata Q18880414</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>krypton (81mKr) gas</td></tr><tr><td>ATC codes:</td><td>V09EX01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09443\">DB09443</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q18880414\">Q18880414</a></td></tr><tr><td>molar mass:</td><td>80.917 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Krypton81mKrGas;
