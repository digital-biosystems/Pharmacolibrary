within Pharmacolibrary.Drugs.Substances;
package Nusinersen "nusinersen"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "nusinersen",
    atcCodes = {"M09AX07"},
    drugbankId = "DB13161",
    wikidataId = "Q25105466");
  annotation (Documentation(info = "<html><body><p>Nusinersen is an antisense oligonucleotide medicine used to treat spinal muscular atrophy. It is authorised in the European Union and is an approved drug, used for this rare muscle-wasting condition.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q25105466\">Wikidata Q25105466</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>nusinersen</td></tr><tr><td>ATC codes:</td><td>M09AX07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13161\">DB13161</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q25105466\">Q25105466</a></td></tr></table></body></html>"));
end Nusinersen;
