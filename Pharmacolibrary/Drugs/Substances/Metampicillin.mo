  annotation (Documentation(info = "<html><body><p>Metampicillin is a penicillin antibiotic with an extended spectrum, developed for treating bacterial infections. It appears to be only experimental and is not authorised in the European Union, so its current use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6584200\">Wikidata Q6584200</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>metampicillin</td></tr><tr><td>ATC codes:</td><td>J01CA14</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13836\">DB13836</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6713928\">6713928</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:52060\">52060</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6584200\">Q6584200</a></td></tr><tr><td>formula:</td><td>C17H19N3O4S</td></tr><tr><td>molar mass:</td><td>361.416 g/mol (PubChem CID 6713928)</td></tr><tr><td>logP:</td><td>3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Metampicillin;
