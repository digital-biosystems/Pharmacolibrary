  annotation (Documentation(info = "<html><body><p>Chaste tree fruit extract is a herbal gynecological remedy traditionally used for menstrual cycle and related gynecological complaints. It is classified as investigational in DrugBank and has no EMA authorisation, so it is not an approved medicine.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Agni casti fructus</td></tr><tr><td>ATC codes:</td><td>G02CX03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13193&quot;>DB13193</a></td></tr></table></body></html>"));
end AgniCastiFructus;
