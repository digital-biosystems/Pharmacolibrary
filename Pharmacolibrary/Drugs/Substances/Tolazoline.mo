within Pharmacolibrary.Drugs.Substances;
package Tolazoline "tolazoline"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "tolazoline",
    atcCodes = {"C04AB02", "M02AX02"},
    drugbankId = "DB00797",
    pubchemCid = "5504",
    chebiId = "28502",
    wikidataId = "Q413772",
    formula = "C10H12N2",
    M = 0.16022,
    logP = 2.6);
  annotation (Documentation(info = "<html><body><p>Tolazoline is a vasodilator that was used for circulatory disorders such as Raynaud disease, thrombophlebitis, thromboangiitis obliterans, arteriosclerosis obliterans, systemic scleroderma, causalgia, and persistent fetal circulation syndrome. It has been withdrawn for human use but remains an approved veterinary drug.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q413772\">Wikidata Q413772</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tolazoline</td></tr><tr><td>ATC codes:</td><td>C04AB02, M02AX02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00797\">DB00797</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5504\">5504</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:28502\">28502</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q413772\">Q413772</a></td></tr><tr><td>formula:</td><td>C10H12N2</td></tr><tr><td>molar mass:</td><td>160.22 g/mol (PubChem CID 5504)</td></tr><tr><td>logP:</td><td>2.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Tolazoline;
