  annotation (Documentation(info = "<html><body><p>Azapetine is a peripheral vasodilator, a type of drug used for circulatory problems involving poor blood flow to the limbs. It is no longer in practical use; it is listed only as an experimental compound and has no marketing authorisation in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q738815\">Wikidata Q738815</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>azapetine</td></tr><tr><td>ATC codes:</td><td>C04AX30</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13727\">DB13727</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/8966\">8966</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134955\">134955</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q738815\">Q738815</a></td></tr><tr><td>formula:</td><td>C17H17N</td></tr><tr><td>molar mass:</td><td>235.33 g/mol (PubChem CID 8966)</td></tr><tr><td>logP:</td><td>3.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Azapetine;
