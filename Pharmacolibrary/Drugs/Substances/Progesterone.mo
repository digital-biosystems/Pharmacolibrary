  annotation (Documentation(info = "<html><body><p>Progesterone is a progestogen sex hormone used to treat conditions such as amenorrhea and endometrial hyperplasia. It is an approved medicine, also approved for veterinary use, and is available both alone and in fixed combinations with estrogens.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q26963&quot;>Wikidata Q26963</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>progesterone</td></tr><tr><td>ATC codes:</td><td>G03DA04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00396&quot;>DB00396</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5994&quot;>5994</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:17026&quot;>17026</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q26963&quot;>Q26963</a></td></tr><tr><td>formula:</td><td>C21H30O2</td></tr><tr><td>molar mass:</td><td>314.469 g/mol (PubChem)</td></tr></table></body></html>"));
