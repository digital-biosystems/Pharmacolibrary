  annotation (Documentation(info = "<html><body><p>Casimersen is an antisense RNA medication used for disorders of the musculo-skeletal system. It is an approved medicine, though its use appears limited rather than widespread.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q105714904&quot;>Wikidata Q105714904</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>casimersen</td></tr><tr><td>ATC codes:</td><td>M09AX13</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB14984&quot;>DB14984</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q105714904&quot;>Q105714904</a></td></tr><tr><td>molar mass:</td><td>7585 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
