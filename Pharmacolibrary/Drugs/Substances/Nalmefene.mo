  annotation (Documentation(info = "<html><body><p>Nalmefene is an opioid antagonist used to treat alcohol dependence and has been studied for opiate dependence. It is authorised in the European Union as a medicine for alcohol-related disorders.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4353252&quot;>Wikidata Q4353252</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>nalmefene</td></tr><tr><td>ATC codes:</td><td>N07BB05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06230&quot;>DB06230</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5284594&quot;>5284594</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7457&quot;>7457</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4353252&quot;>Q4353252</a></td></tr><tr><td>formula:</td><td>C21H25NO3</td></tr><tr><td>molar mass:</td><td>339.435 g/mol (PubChem)</td></tr></table></body></html>"));
