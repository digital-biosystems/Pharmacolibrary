  annotation (Documentation(info = "<html><body><p>Procaine is a local anesthetic used to relieve pain, for example in procedures involving the skin, eye, or hemorrhoids. It is an approved drug, also approved for veterinary use, and remains in use mainly as a local anesthetic.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q423741\">Wikidata Q423741</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>procaine</td></tr><tr><td>ATC codes:</td><td>C05AD05, N01BA02, S01HA05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00721\">DB00721</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4914\">4914</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8430\">8430</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q423741\">Q423741</a></td></tr><tr><td>formula:</td><td>C13H20N2O2</td></tr><tr><td>molar mass:</td><td>236.315 g/mol (PubChem CID 4914)</td></tr><tr><td>logP:</td><td>1.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
