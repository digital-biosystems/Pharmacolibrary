  annotation (Documentation(info = "<html><body><p>Gadopiclenol is a gadolinium-based contrast agent used to improve images in magnetic resonance imaging. It is authorised in the European Union and is a newer agent, so it is not yet widely used.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q114748523&quot;>Wikidata Q114748523</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>gadopiclenol</td></tr><tr><td>ATC codes:</td><td>V08CA12</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB17084&quot;>DB17084</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/16223405&quot;>16223405</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q114748523&quot;>Q114748523</a></td></tr><tr><td>formula:</td><td>C35H54GdN7O15</td></tr><tr><td>molar mass:</td><td>970.101 g/mol (PubChem)</td></tr></table></body></html>"));
