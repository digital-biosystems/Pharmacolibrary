    logP = 1.9);
  annotation (Documentation(info = "<html><body><p>Methylprednisolone is a glucocorticoid used to treat inflammatory and autoimmune conditions such as arthritis, multiple sclerosis, lupus nephritis, and graft-versus-host disease. It is widely used in human medicine and is also approved for veterinary use, appearing on the WHO essential medicines list.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q417222&quot;>Wikidata Q417222</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>methylprednisolone</td></tr><tr><td>ATC codes:</td><td>D07AA01, D10AA02, H02AB04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00959&quot;>DB00959</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6741&quot;>6741</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6888&quot;>6888</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q417222&quot;>Q417222</a></td></tr><tr><td>formula:</td><td>C22H30O5</td></tr><tr><td>molar mass:</td><td>374.477 g/mol (PubChem)</td></tr></table></body></html>"));
