  annotation (Documentation(info = "<html><body><p>Fluocortolone is a glucocorticoid (corticosteroid) with anti-inflammatory activity, used topically for skin conditions, haemorrhoids, and eye inflammation, and also systemically. It has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5462793\">Wikidata Q5462793</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>fluocortolone</td></tr><tr><td>ATC codes:</td><td>C05AA08, D07AC05, D07XC05, H02AB03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08971\">DB08971</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9053\">9053</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135581\">135581</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5462793\">Q5462793</a></td></tr><tr><td>formula:</td><td>C22H29FO4</td></tr><tr><td>molar mass:</td><td>376.468 g/mol (PubChem CID 9053)</td></tr><tr><td>logP:</td><td>2.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
