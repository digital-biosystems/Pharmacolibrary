    logP = 2.1);
  annotation (Documentation(info = "<html><body><p>Naphazoline is a decongestant used to relieve nasal congestion in rhinitis and sinusitis, and to reduce redness of the eye. It is an approved medicine, used topically in nasal and eye preparations, and is widely available over the counter.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q415433\">Wikidata Q415433</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>naphazoline</td></tr><tr><td>ATC codes:</td><td>R01AA08, R01AB02, S01GA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06711\">DB06711</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4436\">4436</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:93363\">93363</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q415433\">Q415433</a></td></tr><tr><td>formula:</td><td>C14H14N2</td></tr><tr><td>molar mass:</td><td>210.28 g/mol (PubChem CID 4436)</td></tr><tr><td>logP:</td><td>2.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Naphazoline;
