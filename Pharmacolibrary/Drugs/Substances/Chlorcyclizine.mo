  annotation (Documentation(info = "<html><body><p>Chlorcyclizine is an antihistamine used to treat allergic rhinitis, motion sickness, and vomiting. It is an approved drug, though it does not appear to have centralised authorisation in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2393323\">Wikidata Q2393323</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>chlorcyclizine</td></tr><tr><td>ATC codes:</td><td>R06AE04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08936\">DB08936</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2710\">2710</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:94402\">94402</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2393323\">Q2393323</a></td></tr><tr><td>formula:</td><td>C18H21ClN2</td></tr><tr><td>molar mass:</td><td>300.83 g/mol (PubChem CID 2710)</td></tr><tr><td>logP:</td><td>4.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
