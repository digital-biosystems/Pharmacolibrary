  annotation (Documentation(info = "<html><body><p>Drisapersen is an antisense drug that was developed to treat Duchenne muscular dystrophy. It was withdrawn after clinical trials failed to show meaningful benefit and regulators declined approval.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5307793&quot;>Wikidata Q5307793</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>drisapersen</td></tr><tr><td>ATC codes:</td><td>M09AX04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13688&quot;>DB13688</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5307793&quot;>Q5307793</a></td></tr></table></body></html>"));
end Drisapersen;
