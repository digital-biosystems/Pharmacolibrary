    logP = 3.5);
  annotation (Documentation(info = "<html><body><p>Chlorquinaldol is an antiseptic and anti-infective agent used against infections such as vaginitis, and applied to skin, gynecological, throat, and protozoal conditions. It remains an approved drug, used mainly in topical preparations for skin, vaginal, and throat antisepsis.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q1645622&quot;>Wikidata Q1645622</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>chlorquinaldol</td></tr><tr><td>ATC codes:</td><td>D08AH02, G01AC03, P01AA04, R02AA11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13306&quot;>DB13306</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6301&quot;>6301</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:74500&quot;>74500</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q1645622&quot;>Q1645622</a></td></tr><tr><td>formula:</td><td>C10H7Cl2NO</td></tr><tr><td>molar mass:</td><td>228.072 g/mol (PubChem)</td></tr></table></body></html>"));
