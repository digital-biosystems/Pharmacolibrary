  annotation (Documentation(info = "<html><body><p>Paraoxon is an acetylcholinesterase inhibitor classified as a parasympathomimetic antiglaucoma and miotic eye preparation. It is regarded as an experimental compound and is not an approved medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q416108&quot;>Wikidata Q416108</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>paraoxon</td></tr><tr><td>ATC codes:</td><td>S01EB10</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13495&quot;>DB13495</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/9395&quot;>9395</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:27827&quot;>27827</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q416108&quot;>Q416108</a></td></tr><tr><td>formula:</td><td>C10H14NO6P</td></tr><tr><td>molar mass:</td><td>275.197 g/mol (PubChem)</td></tr></table></body></html>"));
