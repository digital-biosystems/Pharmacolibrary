  annotation (Documentation(info = "<html><body><p>Glutethimide is a sedative-hypnotic that was used to treat insomnia. It is no longer widely prescribed and has largely fallen out of medical use, but it is still encountered as a drug of abuse.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q414236\">Wikidata Q414236</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>glutethimide</td></tr><tr><td>ATC codes:</td><td>N05CE01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01437\">DB01437</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3487\">3487</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:5439\">5439</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q414236\">Q414236</a></td></tr><tr><td>formula:</td><td>C13H15NO2</td></tr><tr><td>molar mass:</td><td>217.268 g/mol (PubChem CID 3487)</td></tr><tr><td>logP:</td><td>1.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
