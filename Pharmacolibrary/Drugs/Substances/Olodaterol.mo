  annotation (Documentation(info = "<html><body><p>Olodaterol is an inhaled long-acting beta-2 agonist used as a bronchodilator for obstructive airway diseases such as COPD. It is an approved medicine, available alone and in fixed combinations with anticholinergics, and is also being investigated for further uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7088466&quot;>Wikidata Q7088466</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>olodaterol</td></tr><tr><td>ATC codes:</td><td>R03AC19</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09080&quot;>DB09080</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/11504295&quot;>11504295</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:82700&quot;>82700</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7088466&quot;>Q7088466</a></td></tr><tr><td>formula:</td><td>C21H26N2O5</td></tr><tr><td>molar mass:</td><td>386.448 g/mol (PubChem)</td></tr></table></body></html>"));
