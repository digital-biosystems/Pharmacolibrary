    logP = 2.2);
  annotation (Documentation(info = "<html><body><p>Esomeprazole is a proton-pump inhibitor used for acid-related stomach problems such as gastroesophageal reflux disease, peptic and duodenal ulcers, gastritis, esophagitis, and heartburn. It is an approved medicine with an authorised product in the European Union and is widely used for these conditions.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q553223\">Wikidata Q553223</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>esomeprazole</td></tr><tr><td>ATC codes:</td><td>A02BC05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00736\">DB00736</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9568614\">9568614</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:50275\">50275</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q553223\">Q553223</a></td></tr><tr><td>formula:</td><td>C17H19N3O3S</td></tr><tr><td>molar mass:</td><td>345.417 g/mol (PubChem CID 9568614)</td></tr><tr><td>logP:</td><td>2.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Esomeprazole;
