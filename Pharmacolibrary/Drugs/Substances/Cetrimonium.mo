  annotation (Documentation(info = "<html><body><p>Cetrimonium is a quaternary ammonium compound whose salts are used as antiseptics, acting as a local anti-infective agent and surfactant. It is an approved antiseptic used in dermatological and throat preparations, for skin disinfection and throat conditions.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5065700&quot;>Wikidata Q5065700</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cetrimonium</td></tr><tr><td>ATC codes:</td><td>D08AJ02, R02AA17</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01718&quot;>DB01718</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2681&quot;>2681</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:39561&quot;>39561</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5065700&quot;>Q5065700</a></td></tr><tr><td>formula:</td><td>C19H42N+</td></tr><tr><td>molar mass:</td><td>284.552 g/mol (PubChem)</td></tr></table></body></html>"));
