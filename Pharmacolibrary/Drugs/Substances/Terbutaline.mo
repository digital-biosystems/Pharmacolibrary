  annotation (Documentation(info = "<html><body><p>Terbutaline is a beta-2 agonist bronchodilator used to treat asthma and other obstructive lung diseases. It is an approved medicine, available as inhalation and systemic formulations, and has also been investigated as a uterine relaxant.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q424340\">Wikidata Q424340</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>terbutaline</td></tr><tr><td>ATC codes:</td><td>R03AC03, R03CC03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00871\">DB00871</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5403\">5403</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9449\">9449</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q424340\">Q424340</a></td></tr><tr><td>formula:</td><td>C12H19NO3</td></tr><tr><td>molar mass:</td><td>225.288 g/mol (PubChem CID 5403)</td></tr><tr><td>logP:</td><td>0.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
