  annotation (Documentation(info = "<html><body><p>Hexetidine is an antifungal and local anti-infective agent used as an antiseptic for local oral treatment and in gynecological antiinfective preparations. It has been withdrawn, though it was once an approved drug.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q419749&quot;>Wikidata Q419749</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>hexetidine</td></tr><tr><td>ATC codes:</td><td>A01AB12, G01AX16</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08958&quot;>DB08958</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3607&quot;>3607</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:94339&quot;>94339</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q419749&quot;>Q419749</a></td></tr><tr><td>formula:</td><td>C21H45N3</td></tr><tr><td>molar mass:</td><td>339.612 g/mol (PubChem)</td></tr></table></body></html>"));
