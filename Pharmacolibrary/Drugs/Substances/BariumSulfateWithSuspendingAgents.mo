  annotation (Documentation(info = "<html><body><p>Barium sulfate with suspending agents is an X-ray contrast medium used to make the digestive tract visible during imaging examinations. It is an approved, widely used imaging agent, given by mouth or rectally before X-ray procedures.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q309038\">Wikidata Q309038</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>barium sulfate with suspending agents</td></tr><tr><td>ATC codes:</td><td>V08BA01, V08BA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11150\">DB11150</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/24414\">24414</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:133326\">133326</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q309038\">Q309038</a></td></tr><tr><td>formula:</td><td>BaO4S</td></tr><tr><td>molar mass:</td><td>233.386 g/mol (PubChem CID 24414)</td></tr><tr><td>logP:</td><td>-0.84 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
