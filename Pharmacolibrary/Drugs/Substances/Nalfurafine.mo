  annotation (Documentation(info = "<html><body><p>Nalfurafine is an investigational drug that has been studied for the treatment of pruritus (itching) in patients with chronic kidney disease. It is not authorised in the European Union and remains investigational according to DrugBank.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6960874&quot;>Wikidata Q6960874</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nalfurafine</td></tr><tr><td>ATC codes:</td><td>V03AX02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13471&quot;>DB13471</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6445230&quot;>6445230</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:136019&quot;>136019</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6960874&quot;>Q6960874</a></td></tr><tr><td>formula:</td><td>C28H32N2O5</td></tr><tr><td>molar mass:</td><td>476.573 g/mol (PubChem)</td></tr></table></body></html>"));
