  annotation (Documentation(info = "<html><body><p>Udenafil is a phosphodiesterase type 5 inhibitor used to treat erectile dysfunction. It is approved and marketed, mainly in South Korea and some other Asian countries, but it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4815980&quot;>Wikidata Q4815980</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>udenafil</td></tr><tr><td>ATC codes:</td><td>G04BE11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06267&quot;>DB06267</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6918523&quot;>6918523</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135926&quot;>135926</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4815980&quot;>Q4815980</a></td></tr><tr><td>formula:</td><td>C25H36N6O4S</td></tr><tr><td>molar mass:</td><td>516.656 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
