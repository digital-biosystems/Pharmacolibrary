  annotation (Documentation(info = "<html><body><p>Glimepiride is a sulfonylurea medicine used to lower blood sugar in people with diabetes. It is an approved drug, widely used as an oral diabetes treatment, and is also available in combination products with other glucose-lowering medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q106029845\">Wikidata Q106029845</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>glimepiride</td></tr><tr><td>ATC codes:</td><td>A10BB12</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00222\">DB00222</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3476\">3476</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:5383\">5383</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q106029845\">Q106029845</a></td></tr><tr><td>formula:</td><td>C24H34N4O5S</td></tr><tr><td>molar mass:</td><td>490.619 g/mol (PubChem CID 3476)</td></tr><tr><td>logP:</td><td>3.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
