within Pharmacolibrary.Drugs.Substances;
package Tavaborole "tavaborole"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "tavaborole",
    atcCodes = {"D01AE24"},
    drugbankId = "DB09041",
    pubchemCid = "11499245",
    chebiId = "77942",
    wikidataId = "Q21011226",
    formula = "C7H6BFO2",
    M = 0.151931);
  annotation (Documentation(info = "<html><body><p>Tavaborole is a topical antifungal drug used to treat fungal infections of the skin, notably onychomycosis (fungal nail infections). It is an approved medicine, applied topically, and is used mainly in the United States; it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q21011226\">Wikidata Q21011226</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tavaborole</td></tr><tr><td>ATC codes:</td><td>D01AE24</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09041\">DB09041</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/11499245\">11499245</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:77942\">77942</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q21011226\">Q21011226</a></td></tr><tr><td>formula:</td><td>C7H6BFO2</td></tr><tr><td>molar mass:</td><td>151.931 g/mol (PubChem CID 11499245)</td></tr></table></body></html>"));
end Tavaborole;
