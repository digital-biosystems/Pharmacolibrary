within Pharmacolibrary.Drugs.Substances;
package Cobamamide "cobamamide"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "cobamamide",
    atcCodes = {"B03BA04"},
    drugbankId = "DB11191",
    pubchemCid = "6436143",
    chebiId = "18408",
    wikidataId = "Q239593",
    formula = "C72H100CoN18O17P",
    M = 1.57961);
  annotation (Documentation(info = "<html><body><p>Cobamamide, a vitamin B12 analogue, is used as an antianemic preparation to treat vitamin B12 deficiency anaemia. It is approved and also sold as a nutraceutical, but it is not authorised in the European Union and appears to be used only in a limited number of countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q239593\">Wikidata Q239593</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cobamamide</td></tr><tr><td>ATC codes:</td><td>B03BA04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11191\">DB11191</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6436143\">6436143</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:18408\">18408</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q239593\">Q239593</a></td></tr><tr><td>formula:</td><td>C72H100CoN18O17P</td></tr><tr><td>molar mass:</td><td>1579.61 g/mol (PubChem CID 6436143)</td></tr></table></body></html>"));
end Cobamamide;
