  annotation (Documentation(info = "<html><body><p>Oxybuprocaine is a local anesthetic used to numb surfaces, especially in the eye and on the skin. It is an approved topical anesthetic, used mainly in ophthalmology and dermatology.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1530958\">Wikidata Q1530958</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>oxybuprocaine</td></tr><tr><td>ATC codes:</td><td>D04AB03, S01HA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00892\">DB00892</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4633\">4633</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:309594\">309594</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1530958\">Q1530958</a></td></tr><tr><td>formula:</td><td>C17H28N2O3</td></tr><tr><td>molar mass:</td><td>308.422 g/mol (PubChem CID 4633)</td></tr><tr><td>logP:</td><td>3.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Oxybuprocaine;
