    logP = 0);
  annotation (Documentation(info = "<html><body><p>Magnesium sulfate is used as a laxative for constipation, as a magnesium supplement, and in electrolyte solutions; it also acts as an anticonvulsant, antiarrhythmic, analgesic, anesthetic, and tocolytic agent. It is widely used in human medicine and is also an approved veterinary drug, with some investigational uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q288266&quot;>Wikidata Q288266</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>magnesium sulfate</td></tr><tr><td>ATC codes:</td><td>A06AD04, A12CC02, B05XA05, D11AX05, V04CC02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00653&quot;>DB00653</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/24083&quot;>24083</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32599&quot;>32599</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q288266&quot;>Q288266</a></td></tr><tr><td>formula:</td><td>MgO4S</td></tr><tr><td>molar mass:</td><td>120.361 g/mol (PubChem)</td></tr></table></body></html>"));
