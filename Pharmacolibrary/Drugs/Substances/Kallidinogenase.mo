within Pharmacolibrary.Drugs.Substances;
package Kallidinogenase "kallidinogenase"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "kallidinogenase",
    atcCodes = {"C04AF01"},
    drugbankId = "DB13197",
    wikidataId = "Q85716360");
  annotation (Documentation(info = "<html><body><p>Kallidinogenase is an enzyme that acts as a peripheral vasodilator, and has been investigated for widening blood vessels in circulatory conditions. It is considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q85716360\">Wikidata Q85716360</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>kallidinogenase</td></tr><tr><td>ATC codes:</td><td>C04AF01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13197\">DB13197</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q85716360\">Q85716360</a></td></tr></table></body></html>"));
end Kallidinogenase;
