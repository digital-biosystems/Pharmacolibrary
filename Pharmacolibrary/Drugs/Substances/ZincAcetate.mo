  annotation (Documentation(info = "<html><body><p>Zinc acetate is a zinc salt used to supply zinc, for example in Wilson's disease and as a dietary zinc supplement. It is an approved medicine, used in various countries as a supplement and for zinc-deficiency-related indications.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q204639&quot;>Wikidata Q204639</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>zinc acetate</td></tr><tr><td>ATC codes:</td><td>A16AX05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB14487&quot;>DB14487</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/11192&quot;>11192</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:62984&quot;>62984</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q204639&quot;>Q204639</a></td></tr><tr><td>formula:</td><td>C4H6O4Zn</td></tr><tr><td>molar mass:</td><td>183.468 g/mol (PubChem)</td></tr></table></body></html>"));
