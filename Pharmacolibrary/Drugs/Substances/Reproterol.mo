    logP = -0.5);
  annotation (Documentation(info = "<html><body><p>Reproterol is a selective beta-2 adrenergic agonist that acts as a bronchodilator for obstructive airway diseases such as asthma. It is considered investigational in DrugBank and has no European Union marketing authorisation, so it is not widely used.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q1292703&quot;>Wikidata Q1292703</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>reproterol</td></tr><tr><td>ATC codes:</td><td>R03AC15, R03CC14</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12846&quot;>DB12846</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/25654&quot;>25654</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135612&quot;>135612</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q1292703&quot;>Q1292703</a></td></tr><tr><td>formula:</td><td>C18H23N5O5</td></tr><tr><td>molar mass:</td><td>389.412 g/mol (PubChem)</td></tr></table></body></html>"));
end Reproterol;
