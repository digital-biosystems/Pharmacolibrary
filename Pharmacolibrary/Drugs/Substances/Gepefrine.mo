    logP = 1.4);
  annotation (Documentation(info = "<html><body><p>Gepefrine is an adrenergic (sympathomimetic) cardiac stimulant that has been investigated as a potential treatment for low blood pressure conditions. It remains an experimental compound and does not appear to be an approved medicine in major markets such as the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q23714168&quot;>Wikidata Q23714168</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>gepefrine</td></tr><tr><td>ATC codes:</td><td>C01CA15</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13703&quot;>DB13703</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/219105&quot;>219105</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q23714168&quot;>Q23714168</a></td></tr><tr><td>formula:</td><td>C9H13NO</td></tr><tr><td>molar mass:</td><td>151.209 g/mol (PubChem)</td></tr></table></body></html>"));
end Gepefrine;
