  annotation (Documentation(info = "<html><body><p>Visnadine is a peripheral vasodilator that has been investigated for circulatory problems affecting the blood vessels. It is not an approved medicine and remains investigational, with no authorisation from the European Medicines Agency.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q15410171&quot;>Wikidata Q15410171</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>visnadine</td></tr><tr><td>ATC codes:</td><td>C04AX24</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13355&quot;>DB13355</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/442151&quot;>442151</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:10001&quot;>10001</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q15410171&quot;>Q15410171</a></td></tr><tr><td>formula:</td><td>C21H24O7</td></tr><tr><td>molar mass:</td><td>388.416 g/mol (PubChem)</td></tr></table></body></html>"));
