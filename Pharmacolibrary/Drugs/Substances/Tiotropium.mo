    M = 0.392508);
  annotation (Documentation(info = "<html><body><p>Tiotropium is an inhaled anticholinergic bronchodilator used to treat obstructive and other lung diseases, including pneumonia, bronchiectasis, and pulmonary hypertension. It is an approved medicine and is widely used as a maintenance inhalation treatment for obstructive airway diseases.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q424316\">Wikidata Q424316</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Tiotropium</td></tr><tr><td>ATC codes:</td><td>R03BB04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01409\">DB01409</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5487427\">5487427</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q424316\">Q424316</a></td></tr><tr><td>formula:</td><td>C19H22NO4S2+</td></tr><tr><td>molar mass:</td><td>392.508 g/mol (PubChem CID 5487427)</td></tr></table></body></html>"));
end Tiotropium;
