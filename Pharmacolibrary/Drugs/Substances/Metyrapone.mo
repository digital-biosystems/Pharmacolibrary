  annotation (Documentation(info = "<html><body><p>Metyrapone is a diagnostic agent used in tests of pituitary function, notably to assess adrenal-related disorders such as Cushing's syndrome. It remains an approved drug, though it is used only in specialised diagnostic settings rather than as a routine treatment.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q821641&quot;>Wikidata Q821641</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>metyrapone</td></tr><tr><td>ATC codes:</td><td>V04CD01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01011&quot;>DB01011</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4174&quot;>4174</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:44241&quot;>44241</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q821641&quot;>Q821641</a></td></tr><tr><td>formula:</td><td>C14H14N2O</td></tr><tr><td>molar mass:</td><td>226.279 g/mol (PubChem)</td></tr></table></body></html>"));
