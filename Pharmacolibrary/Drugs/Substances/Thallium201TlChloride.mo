  annotation (Documentation(info = "<html><body><p>Thallous chloride Tl-201 is a radioactive tracer used in diagnostic imaging of the heart, for example to assess blood flow to the heart muscle. It is an approved diagnostic radiopharmaceutical, used in nuclear medicine settings for cardiovascular imaging.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27114831&quot;>Wikidata Q27114831</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>thallium (201Tl) chloride</td></tr><tr><td>ATC codes:</td><td>V09GX01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB16624&quot;>DB16624</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27114831&quot;>Q27114831</a></td></tr><tr><td>molar mass:</td><td>236.42 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
