  annotation (Documentation(info = "<html><body><p>Phensuximide is an antiepileptic drug of the succinimide class used to treat absence epilepsy in children. It is an approved medicine, but it does not appear to be authorised in the European Union and is not widely used today.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q999805\">Wikidata Q999805</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>phensuximide</td></tr><tr><td>ATC codes:</td><td>N03AD02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00832\">DB00832</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6839\">6839</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8079\">8079</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q999805\">Q999805</a></td></tr><tr><td>formula:</td><td>C11H11NO2</td></tr><tr><td>molar mass:</td><td>189.214 g/mol (PubChem CID 6839)</td></tr><tr><td>logP:</td><td>0.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
