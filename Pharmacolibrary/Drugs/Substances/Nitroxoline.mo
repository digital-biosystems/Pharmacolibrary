  annotation (Documentation(info = "<html><body><p>Nitroxoline is an antibacterial agent used to treat urinary tract infections. It is not authorised in the European Union and is considered experimental, so its current availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q304570&quot;>Wikidata Q304570</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nitroxoline</td></tr><tr><td>ATC codes:</td><td>J01XX07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01422&quot;>DB01422</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/19910&quot;>19910</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:67121&quot;>67121</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q304570&quot;>Q304570</a></td></tr><tr><td>formula:</td><td>C9H6N2O3</td></tr><tr><td>molar mass:</td><td>190.158 g/mol (PubChem)</td></tr></table></body></html>"));
