  annotation (Documentation(info = "<html><body><p>Dronabinol (tetrahydrocannabinol) is used to treat vomiting and nausea, as well as anorexia including anorexia associated with serious illness. It is an approved medicine, used mainly in the United States, and is also classified as an illicit substance in some places.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q190067&quot;>Wikidata Q190067</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dronabinol</td></tr><tr><td>ATC codes:</td><td>A04AD10</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00470&quot;>DB00470</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/16078&quot;>16078</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:66964&quot;>66964</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q190067&quot;>Q190067</a></td></tr><tr><td>formula:</td><td>C21H30O2</td></tr><tr><td>molar mass:</td><td>314.469 g/mol (PubChem)</td></tr></table></body></html>"));
