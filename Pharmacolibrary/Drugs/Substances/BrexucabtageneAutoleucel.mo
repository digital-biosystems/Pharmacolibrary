  annotation (Documentation(info = "<html><body><p>Brexucabtagene autoleucel is a cell-based gene therapy used to treat mantle cell lymphoma. It is authorised in the European Union and is a hospital-administered, specialised anticancer treatment given to individual patients.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q97704053\">Wikidata Q97704053</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>brexucabtagene autoleucel</td></tr><tr><td>ATC codes:</td><td>L01XL06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB15699\">DB15699</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q97704053\">Q97704053</a></td></tr></table></body></html>"));
