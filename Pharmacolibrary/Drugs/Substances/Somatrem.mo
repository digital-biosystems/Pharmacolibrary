  annotation (Documentation(info = "<html><body><p>Somatrem, a growth hormone analogue, was used for conditions such as Prader–Willi syndrome, cachexia, and congestive heart failure. It was approved but has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7559307\">Wikidata Q7559307</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>somatrem</td></tr><tr><td>ATC codes:</td><td>H01AC02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09098\">DB09098</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7559307\">Q7559307</a></td></tr><tr><td>molar mass:</td><td>1009.1 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>-6.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Somatrem;
