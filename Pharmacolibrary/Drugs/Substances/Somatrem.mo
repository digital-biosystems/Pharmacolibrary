  annotation (Documentation(info = "<html><body><p>Somatrem, a growth hormone analogue, was used for conditions such as Prader–Willi syndrome, cachexia, and congestive heart failure. It was approved but has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7559307&quot;>Wikidata Q7559307</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>somatrem</td></tr><tr><td>ATC codes:</td><td>H01AC02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09098&quot;>DB09098</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5487805&quot;>5487805</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7559307&quot;>Q7559307</a></td></tr><tr><td>formula:</td><td>C43H72N14O14</td></tr><tr><td>molar mass:</td><td>1009.13 g/mol (PubChem)</td></tr></table></body></html>"));
