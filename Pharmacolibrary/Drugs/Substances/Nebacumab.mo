  annotation (Documentation(info = "<html><body><p>Nebacumab is an antibacterial monoclonal antibody, an immune globulin-type medicine intended to fight bacterial infections. It remains experimental and has not reached routine clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6984546\">Wikidata Q6984546</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nebacumab</td></tr><tr><td>ATC codes:</td><td>J06BC01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13535\">DB13535</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6984546\">Q6984546</a></td></tr></table></body></html>"));
end Nebacumab;
