  annotation (Documentation(info = "<html><body><p>Glafenine is a non-opioid analgesic and antipyretic that was used to relieve pain and fever. It has been withdrawn from the market, reportedly because of safety concerns, and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5566483&quot;>Wikidata Q5566483</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>glafenine</td></tr><tr><td>ATC codes:</td><td>N02BG03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08963&quot;>DB08963</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3474&quot;>3474</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31653&quot;>31653</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5566483&quot;>Q5566483</a></td></tr><tr><td>formula:</td><td>C19H17ClN2O4</td></tr><tr><td>molar mass:</td><td>372.805 g/mol (PubChem)</td></tr></table></body></html>"));
