  annotation (Documentation(info = "<html><body><p>Clofibride is a fibrate lipid-modifying agent, a class of drugs used to lower blood lipid levels. It is not an established marketed medicine and appears only as an experimental compound, so its current availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4117086\">Wikidata Q4117086</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>clofibride</td></tr><tr><td>ATC codes:</td><td>C10AB10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13849\">DB13849</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/160134\">160134</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135401\">135401</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4117086\">Q4117086</a></td></tr><tr><td>formula:</td><td>C16H22ClNO4</td></tr><tr><td>molar mass:</td><td>327.805 g/mol (PubChem CID 160134)</td></tr><tr><td>logP:</td><td>2.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
