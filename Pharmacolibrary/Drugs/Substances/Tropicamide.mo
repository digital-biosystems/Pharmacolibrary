    logP = 1.5);
  annotation (Documentation(info = "<html><body><p>Tropicamide is an eye drop that widens the pupil and temporarily paralyses focusing, used in eye examinations and to treat inflammatory eye conditions such as iritis, iridocyclitis and keratitis. It is an approved medicine, included on the WHO list of essential medicines, and is widely used in ophthalmic practice.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q29310&quot;>Wikidata Q29310</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tropicamide</td></tr><tr><td>ATC codes:</td><td>S01FA06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00809&quot;>DB00809</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5593&quot;>5593</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9757&quot;>9757</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q29310&quot;>Q29310</a></td></tr><tr><td>formula:</td><td>C17H20N2O2</td></tr><tr><td>molar mass:</td><td>284.359 g/mol (PubChem)</td></tr></table></body></html>"));
end Tropicamide;
