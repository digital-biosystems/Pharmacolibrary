  annotation (Documentation(info = "<html><body><p>Bevantolol is a selective beta-blocker developed for cardiovascular conditions such as high blood pressure and angina. It is not an approved medicine and remains investigational, with no marketing authorisation in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1956953\">Wikidata Q1956953</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bevantolol</td></tr><tr><td>ATC codes:</td><td>C07AB06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01295\">DB01295</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2372\">2372</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:238698\">238698</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1956953\">Q1956953</a></td></tr><tr><td>formula:</td><td>C20H27NO4</td></tr><tr><td>molar mass:</td><td>345.439 g/mol (PubChem CID 2372)</td></tr><tr><td>logP:</td><td>3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
