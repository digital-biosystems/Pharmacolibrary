  annotation (Documentation(info = "<html><body><p>Bendazac is a non-steroidal anti-inflammatory drug that was used topically for joint and muscular pain and as an ophthalmic anti-inflammatory agent. It appears to have been withdrawn from use, as it is listed as withdrawn despite once being approved.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q862414&quot;>Wikidata Q862414</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bendazac</td></tr><tr><td>ATC codes:</td><td>M02AA11, S01BC07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13501&quot;>DB13501</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2313&quot;>2313</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31257&quot;>31257</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q862414&quot;>Q862414</a></td></tr><tr><td>formula:</td><td>C16H14N2O3</td></tr><tr><td>molar mass:</td><td>282.299 g/mol (PubChem)</td></tr></table></body></html>"));
