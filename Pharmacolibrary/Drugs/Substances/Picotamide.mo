    logP = 1.3);
  annotation (Documentation(info = "<html><body><p>Picotamide is a platelet aggregation inhibitor, an antithrombotic drug used to prevent blood clots. It is not an approved medicine in the European Union and appears only as an experimental agent, so its current clinical use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1235921\">Wikidata Q1235921</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>picotamide</td></tr><tr><td>ATC codes:</td><td>B01AC03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13327\">DB13327</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4814\">4814</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:93175\">93175</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1235921\">Q1235921</a></td></tr><tr><td>formula:</td><td>C21H20N4O3</td></tr><tr><td>molar mass:</td><td>376.416 g/mol (PubChem CID 4814)</td></tr><tr><td>logP:</td><td>1.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Picotamide;
