  annotation (Documentation(info = "<html><body><p>Phenylmercuric borate is a mercurial compound classified as an antiseptic and disinfectant for use on the skin. It is currently regarded as an experimental substance and does not appear to be an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27895276\">Wikidata Q27895276</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>phenylmercuric borate</td></tr><tr><td>ATC codes:</td><td>D08AK02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13834\">DB13834</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27895276\">Q27895276</a></td></tr><tr><td>formula:</td><td>C12H13BHg2O4</td></tr><tr><td>molar mass:</td><td>633.22 g/mol (knowledgebase (DrugBank calculated))</td></tr></table></body></html>"));
