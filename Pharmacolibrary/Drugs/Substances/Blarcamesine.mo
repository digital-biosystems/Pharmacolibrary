  annotation (Documentation(info = "<html><body><p>Blarcamesine is an investigational drug developed for dementia. It is not approved; a marketing application in the European Union was withdrawn, so it remains experimental.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q25110485\">Wikidata Q25110485</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>blarcamesine</td></tr><tr><td>ATC codes:</td><td>N06DX06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB05592\">DB05592</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9882189\">9882189</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q25110485\">Q25110485</a></td></tr><tr><td>formula:</td><td>C19H23NO</td></tr><tr><td>molar mass:</td><td>281.399 g/mol (PubChem CID 9882189)</td></tr></table></body></html>"));
