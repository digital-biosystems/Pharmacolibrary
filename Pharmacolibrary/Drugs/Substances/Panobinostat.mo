  annotation (Documentation(info = "<html><body><p>Panobinostat is an anticancer medicine (a histone deacetylase inhibitor) used to treat multiple myeloma. It is authorised in the European Union as an antineoplastic agent, and is also being investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7131441\">Wikidata Q7131441</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>panobinostat</td></tr><tr><td>ATC codes:</td><td>L01XH03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06603\">DB06603</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6918837\">6918837</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:85990\">85990</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7131441\">Q7131441</a></td></tr><tr><td>formula:</td><td>C21H23N3O2</td></tr><tr><td>molar mass:</td><td>349.434 g/mol (PubChem CID 6918837)</td></tr><tr><td>logP:</td><td>3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
