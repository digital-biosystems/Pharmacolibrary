    logP = -0.6);
  annotation (Documentation(info = "<html><body><p>Oxedrine (synephrine) is a sympathomimetic, alpha-adrenergic agonist that acts as a vasoconstrictor and decongestant, and has been classified as a cardiac stimulant and eye decongestant. It is considered investigational, with no authorised marketing record in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q421351\">Wikidata Q421351</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>oxedrine</td></tr><tr><td>ATC codes:</td><td>C01CA08, S01GA06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09203\">DB09203</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/7172\">7172</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q421351\">Q421351</a></td></tr><tr><td>formula:</td><td>C9H13NO2</td></tr><tr><td>molar mass:</td><td>167.208 g/mol (PubChem CID 7172)</td></tr><tr><td>logP:</td><td>-0.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Oxedrine;
