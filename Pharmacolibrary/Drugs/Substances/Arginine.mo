  annotation (Documentation(info = "<html><body><p>Arginine is an amino acid used as an additive to intravenous solutions and as a detoxifying agent during antineoplastic treatment. It is approved and also sold as a nutraceutical, with some investigational uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27277776\">Wikidata Q27277776</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Arginine</td></tr><tr><td>ATC codes:</td><td>B05XB01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00125\">DB00125</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6322\">6322</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27277776\">Q27277776</a></td></tr><tr><td>formula:</td><td>C6H14N4O2</td></tr><tr><td>molar mass:</td><td>174.204 g/mol (PubChem CID 6322)</td></tr></table></body></html>"));
end Arginine;
