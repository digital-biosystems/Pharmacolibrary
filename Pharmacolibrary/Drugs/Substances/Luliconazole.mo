  annotation (Documentation(info = "<html><body><p>Luliconazole is a topical antifungal drug used to treat fungal skin infections such as tinea corporis, tinea cruris, and tinea pedis. It is an approved medicine and is used topically on the skin.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q15624030\">Wikidata Q15624030</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>luliconazole</td></tr><tr><td>ATC codes:</td><td>D01AC18</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08933\">DB08933</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3003141\">3003141</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:34825\">34825</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q15624030\">Q15624030</a></td></tr><tr><td>formula:</td><td>C14H9Cl2N3S2</td></tr><tr><td>molar mass:</td><td>354.267 g/mol (PubChem CID 3003141)</td></tr><tr><td>logP:</td><td>4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
