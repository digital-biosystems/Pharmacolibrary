  annotation (Documentation(info = "<html><body><p>Somapacitan is a long-acting growth hormone analogue used to treat growth disorders in children. It is authorised in the European Union as a once-weekly injectable treatment.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27270325\">Wikidata Q27270325</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>somapacitan</td></tr><tr><td>ATC codes:</td><td>H01AC07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB15093\">DB15093</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27270325\">Q27270325</a></td></tr><tr><td>molar mass:</td><td>1310.5 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>-2.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Somapacitan;
