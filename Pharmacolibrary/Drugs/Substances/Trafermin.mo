within Pharmacolibrary.Drugs.Substances;
package Trafermin "trafermin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "trafermin",
    atcCodes = {"D03AX15"},
    drugbankId = "DB06244",
    wikidataId = "Q30315131");
  annotation (Documentation(info = "<html><body><p>Trafermin, a recombinant human basic fibroblast growth factor, has been investigated as a cicatrizant for promoting the healing of wounds and ulcers. It remains investigational and is not an approved medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q30315131\">Wikidata Q30315131</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>trafermin</td></tr><tr><td>ATC codes:</td><td>D03AX15</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06244\">DB06244</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q30315131\">Q30315131</a></td></tr></table></body></html>"));
end Trafermin;
