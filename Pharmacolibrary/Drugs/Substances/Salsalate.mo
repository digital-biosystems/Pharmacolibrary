  annotation (Documentation(info = "<html><body><p>Salsalate is a non-steroidal anti-inflammatory drug of the salicylic acid group used to treat pain, arthritis, and fever. It is an approved medicine, though it carries a boxed warning and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1320691\">Wikidata Q1320691</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>salsalate</td></tr><tr><td>ATC codes:</td><td>N02BA06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01399\">DB01399</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5161\">5161</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9014\">9014</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1320691\">Q1320691</a></td></tr><tr><td>formula:</td><td>C14H10O5</td></tr><tr><td>molar mass:</td><td>258.229 g/mol (PubChem CID 5161)</td></tr><tr><td>logP:</td><td>3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
