    M = 0.004003);
  annotation (Documentation(info = "<html><body><p>Helium is a medical gas used in breathing mixtures, for example to help patients with airway obstruction breathe more easily. It is an approved medical gas and is also vet-approved, used mainly in hospital settings as an inhaled gas.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q560\">Wikidata Q560</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>helium</td></tr><tr><td>ATC codes:</td><td>V03AN03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09155\">DB09155</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/23987\">23987</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:33681\">33681</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q560\">Q560</a></td></tr><tr><td>formula:</td><td>He</td></tr><tr><td>molar mass:</td><td>4.003 g/mol (PubChem CID 23987)</td></tr></table></body></html>"));
