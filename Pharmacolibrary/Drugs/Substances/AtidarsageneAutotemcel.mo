  annotation (Documentation(info = "<html><body><p>Atidarsagene autotemcel is a gene therapy used to treat metachromatic leukodystrophy. It is authorised in the European Union as a one-off treatment, but its use remains limited to specialised centres.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>atidarsagene autotemcel</td></tr><tr><td>ATC codes:</td><td>A16AB21</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB17538\">DB17538</a></td></tr></table></body></html>"));
