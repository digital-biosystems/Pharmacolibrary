    M = 0.48643);
  annotation (Documentation(info = "<html><body><p>Vilanterol is a long-acting inhaled beta-2 agonist used to treat obstructive airway diseases such as COPD and asthma, given in combination inhalers with corticosteroids or anticholinergics. It is an approved medicine, available in fixed-dose combination inhalers for respiratory conditions.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q15053666\">Wikidata Q15053666</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Vilanterol</td></tr><tr><td>ATC codes:</td><td>R03AK10, R03AL03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09082\">DB09082</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/10184665\">10184665</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:75037\">75037</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q15053666\">Q15053666</a></td></tr><tr><td>formula:</td><td>C24H33Cl2NO5</td></tr><tr><td>molar mass:</td><td>486.43 g/mol (PubChem CID 10184665)</td></tr></table></body></html>"));
end Vilanterol;
