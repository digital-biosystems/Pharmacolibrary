  annotation (Documentation(info = "<html><body><p>Yttrium-90 citrate colloid is a therapeutic radiopharmaceutical used to deliver radiation treatment, classified among antiinflammatory radiopharmaceuticals. It is an approved medicine, though its use is specialised and limited to certain settings rather than being widely prescribed.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2650092\">Wikidata Q2650092</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>yttrium (90Y) citrate colloid</td></tr><tr><td>ATC codes:</td><td>V10AA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13076\">DB13076</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/104760\">104760</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2650092\">Q2650092</a></td></tr><tr><td>formula:</td><td>Y</td></tr><tr><td>molar mass:</td><td>88.906 g/mol (PubChem CID 104760)</td></tr></table><p><small>Drugs.Common 25.09 gave 279.01 g/mol (+213.8 %); replaced by the value above</small></p></body></html>"));
