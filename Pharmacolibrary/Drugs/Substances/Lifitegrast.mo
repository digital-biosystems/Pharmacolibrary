  annotation (Documentation(info = "<html><body><p>Lifitegrast is an eye drop used to treat dry eye disease. It is approved and used in the United States, but a marketing application in the European Union was withdrawn, so it is not authorised there.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q23044263\">Wikidata Q23044263</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>lifitegrast</td></tr><tr><td>ATC codes:</td><td>S01XA25</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11611\">DB11611</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/11965427\">11965427</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:133023\">133023</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q23044263\">Q23044263</a></td></tr><tr><td>formula:</td><td>C29H24Cl2N2O7S</td></tr><tr><td>molar mass:</td><td>615.478 g/mol (PubChem CID 11965427)</td></tr><tr><td>logP:</td><td>4.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Lifitegrast;
