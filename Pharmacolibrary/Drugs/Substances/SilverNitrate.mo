    M = 0.170882);
  annotation (Documentation(info = "<html><body><p>Silver nitrate is an antiseptic used to treat bleeding, burns, and gram-negative bacterial infections. It is an approved topical antiseptic, used mainly in dermatological care.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q207442\">Wikidata Q207442</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>silver nitrate</td></tr><tr><td>ATC codes:</td><td>D08AL01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11080\">DB11080</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/516904\">516904</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32130\">32130</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q207442\">Q207442</a></td></tr><tr><td>formula:</td><td>AgHNO3</td></tr><tr><td>molar mass:</td><td>170.882 g/mol (PubChem CID 516904)</td></tr></table></body></html>"));
end SilverNitrate;
