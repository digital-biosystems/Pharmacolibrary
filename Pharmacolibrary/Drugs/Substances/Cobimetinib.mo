  annotation (Documentation(info = "<html><body><p>Cobimetinib is a MEK inhibitor anticancer drug used to treat melanoma, including metastatic melanoma. It is authorised in the European Union for melanoma and is also under investigation for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q15708292\">Wikidata Q15708292</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>cobimetinib</td></tr><tr><td>ATC codes:</td><td>L01EE02, L01XE38</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB05239\">DB05239</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/16222096\">16222096</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:90851\">90851</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q15708292\">Q15708292</a></td></tr><tr><td>formula:</td><td>C21H21F3IN3O2</td></tr><tr><td>molar mass:</td><td>531.312 g/mol (PubChem CID 16222096)</td></tr><tr><td>logP:</td><td>3.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
