    logP = 0);
  annotation (Documentation(info = "<html><body><p>Sodium bicarbonate is used to treat conditions such as cardiac arrest, heartburn, indigestion, gastroesophageal reflux disease, and renal tubular acidosis. It is an approved medicine, given as intravenous electrolyte and irrigating salt solutions, and is widely available, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q179731&quot;>Wikidata Q179731</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sodium bicarbonate</td></tr><tr><td>ATC codes:</td><td>B05CB04, B05XA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01390&quot;>DB01390</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/516892&quot;>516892</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32139&quot;>32139</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q179731&quot;>Q179731</a></td></tr><tr><td>formula:</td><td>CHNaO3</td></tr><tr><td>molar mass:</td><td>84.006 g/mol (PubChem)</td></tr></table></body></html>"));
