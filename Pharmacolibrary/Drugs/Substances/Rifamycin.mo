within Pharmacolibrary.Drugs.Substances;
package Rifamycin "rifamycin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "rifamycin",
    atcCodes = {"A07AA13", "D06AX15", "J04AB03", "S01AA16", "S02AA12"},
    drugbankId = "DB11753",
    pubchemCid = "6324616",
    chebiId = "29673",
    wikidataId = "Q26270990",
    formula = "C37H47NO12",
    M = 0.697778,
    logP = 4.9);
  annotation (Documentation(info = "<html><body><p>Rifamycin is an antibiotic used against tuberculosis and other mycobacterial infections, and also applied topically for skin, eye, and ear infections and as an intestinal antiinfective for diarrhoea. It remains an approved medicine, used in various countries for these indications, though some specific products have been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q26270990\">Wikidata Q26270990</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>rifamycin</td></tr><tr><td>ATC codes:</td><td>A07AA13, D06AX15, J04AB03, S01AA16, S02AA12</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11753\">DB11753</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6324616\">6324616</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:29673\">29673</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q26270990\">Q26270990</a></td></tr><tr><td>formula:</td><td>C37H47NO12</td></tr><tr><td>molar mass:</td><td>697.778 g/mol (PubChem CID 6324616)</td></tr><tr><td>logP:</td><td>4.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Rifamycin;
