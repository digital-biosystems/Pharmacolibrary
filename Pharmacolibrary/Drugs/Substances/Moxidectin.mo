    logP = 4.3);
  annotation (Documentation(info = "<html><body><p>Moxidectin is an antinematodal drug used to treat parasitic worm infections, notably onchocerciasis, and is also used in veterinary medicine. It is approved for human use in the United States and is also widely used as a veterinary antiparasitic.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q903824\">Wikidata Q903824</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>moxidectin</td></tr><tr><td>ATC codes:</td><td>P02CX03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11431\">DB11431</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9832912\">9832912</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q903824\">Q903824</a></td></tr><tr><td>formula:</td><td>C37H53NO8</td></tr><tr><td>molar mass:</td><td>639.83 g/mol (PubChem CID 9832912)</td></tr><tr><td>logP:</td><td>4.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Moxidectin;
