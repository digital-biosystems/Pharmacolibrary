  annotation (Documentation(info = "<html><body><p>Galcanezumab is a humanized monoclonal antibody used to prevent migraine attacks. It is an approved medicine, authorised in the European Union for migraine, and is also under investigation for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q25326707\">Wikidata Q25326707</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>galcanezumab</td></tr><tr><td>ATC codes:</td><td>N02CD02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB14042\">DB14042</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q25326707\">Q25326707</a></td></tr><tr><td>molar mass:</td><td>147000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
