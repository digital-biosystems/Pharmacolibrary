  annotation (Documentation(info = "<html><body><p>Phenylpropanolamine is a sympathomimetic drug that was used as a decongestant for nasal congestion. It has been withdrawn from human use in many countries over safety concerns, though it remains approved for some veterinary purposes.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q59627745&quot;>Wikidata Q59627745</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>phenylpropanolamine</td></tr><tr><td>ATC codes:</td><td>R01BA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00397&quot;>DB00397</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/26934&quot;>26934</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:80680&quot;>80680</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q59627745&quot;>Q59627745</a></td></tr><tr><td>formula:</td><td>C9H13NO</td></tr><tr><td>molar mass:</td><td>151.209 g/mol (PubChem)</td></tr></table></body></html>"));
