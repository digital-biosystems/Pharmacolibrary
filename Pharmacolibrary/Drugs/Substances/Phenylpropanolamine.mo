  annotation (Documentation(info = "<html><body><p>Phenylpropanolamine is a decongestant that was used to relieve nasal congestion. It has been withdrawn from human use over safety concerns, but remains approved for veterinary purposes.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q97786582\">Wikidata Q97786582</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>phenylpropanolamine</td></tr><tr><td>ATC codes:</td><td>R01BA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00397\">DB00397</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/26934\">26934</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:80680\">80680</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q97786582\">Q97786582</a></td></tr><tr><td>formula:</td><td>C9H13NO</td></tr><tr><td>molar mass:</td><td>151.209 g/mol (PubChem CID 26934)</td></tr><tr><td>logP:</td><td>0.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
