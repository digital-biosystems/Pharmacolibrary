  annotation (Documentation(info = "<html><body><p>Histamine is used as an immunostimulant in cancer treatment and as a diagnostic agent in tests of gastric acid secretion. It is an approved drug, though its use is limited to these specialised roles rather than widespread clinical practice.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5772985\">Wikidata Q5772985</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Histamine</td></tr><tr><td>ATC codes:</td><td>L03AX14, V04CG03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB05381\">DB05381</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/774\">774</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5772985\">Q5772985</a></td></tr><tr><td>formula:</td><td>C5H9N3</td></tr><tr><td>molar mass:</td><td>111.148 g/mol (PubChem CID 774)</td></tr></table></body></html>"));
