  annotation (Documentation(info = "<html><body><p>Patisiran is a medicine used to treat hereditary amyloidosis, a rare nerve-related condition. It is authorised in the European Union and is also being studied for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q40441442\">Wikidata Q40441442</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>patisiran</td></tr><tr><td>ATC codes:</td><td>N07XX12</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB14582\">DB14582</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q40441442\">Q40441442</a></td></tr></table></body></html>"));
end Patisiran;
