  annotation (Documentation(info = "<html><body><p>Bisacodyl is a stimulant laxative used to treat constipation, taken by mouth or as an enema. It is an approved medicine that remains widely available, generally without prescription, for short-term relief of constipation.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q417874&quot;>Wikidata Q417874</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bisacodyl</td></tr><tr><td>ATC codes:</td><td>A06AB02, A06AG02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09020&quot;>DB09020</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2391&quot;>2391</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3125&quot;>3125</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q417874&quot;>Q417874</a></td></tr><tr><td>formula:</td><td>C22H19NO4</td></tr><tr><td>molar mass:</td><td>361.397 g/mol (PubChem)</td></tr></table></body></html>"));
