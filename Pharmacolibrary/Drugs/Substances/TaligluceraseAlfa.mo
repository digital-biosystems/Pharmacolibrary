  annotation (Documentation(info = "<html><body><p>Taliglucerase alfa is an enzyme therapy used to treat Gaucher disease. It is approved according to DrugBank, but a marketing application in the European Union was refused, so it is not authorised there.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7679506\">Wikidata Q7679506</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>taliglucerase alfa</td></tr><tr><td>ATC codes:</td><td>A16AB11</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08876\">DB08876</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7679506\">Q7679506</a></td></tr><tr><td>molar mass:</td><td>56637.9 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end TaligluceraseAlfa;
