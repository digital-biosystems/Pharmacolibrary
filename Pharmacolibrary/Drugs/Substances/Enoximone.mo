within Pharmacolibrary.Drugs.Substances;
package Enoximone "enoximone"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "enoximone",
    atcCodes = {"C01CE03"},
    drugbankId = "DB04880",
    pubchemCid = "53708",
    chebiId = "135010",
    wikidataId = "Q5379471",
    formula = "C12H12N2O2S",
    M = 0.2483,
    logP = 1.6);
  annotation (Documentation(info = "<html><body><p>Enoximone is a phosphodiesterase inhibitor with cardiotonic and vasodilating effects that was used as a cardiac stimulant in heart failure. It has been withdrawn and is no longer in general use, though it has also been investigated.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5379471\">Wikidata Q5379471</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>enoximone</td></tr><tr><td>ATC codes:</td><td>C01CE03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB04880\">DB04880</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/53708\">53708</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135010\">135010</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5379471\">Q5379471</a></td></tr><tr><td>formula:</td><td>C12H12N2O2S</td></tr><tr><td>molar mass:</td><td>248.3 g/mol (PubChem CID 53708)</td></tr><tr><td>logP:</td><td>1.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Enoximone;
