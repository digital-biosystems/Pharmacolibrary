within Pharmacolibrary.Drugs.Substances;
package Protamine "protamine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "protamine",
    atcCodes = {"V03AB14"},
    drugbankId = "DB13700",
    wikidataId = "Q5449573");
  annotation (Documentation(info = "<html><body><p>Protamine is an antidote used to reverse the blood-thinning effect of heparin, for example after heart surgery or when heparin causes excessive bleeding. It remains in use today, mainly in hospital settings such as operating theatres and dialysis units.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5449573\">Wikidata Q5449573</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>protamine</td></tr><tr><td>ATC codes:</td><td>V03AB14</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13700\">DB13700</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5449573\">Q5449573</a></td></tr></table></body></html>"));
end Protamine;
