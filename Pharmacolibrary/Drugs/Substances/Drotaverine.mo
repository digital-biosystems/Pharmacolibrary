    logP = 5.4);
  annotation (Documentation(info = "<html><body><p>Drotaverine is a papaverine-like antispasmodic used to relieve smooth-muscle spasms, especially of the gastrointestinal tract. It has been approved in some countries but withdrawn in others, and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q831929\">Wikidata Q831929</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>drotaverine</td></tr><tr><td>ATC codes:</td><td>A03AD02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06751\">DB06751</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/1712095\">1712095</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135630\">135630</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q831929\">Q831929</a></td></tr><tr><td>formula:</td><td>C24H31NO4</td></tr><tr><td>molar mass:</td><td>397.515 g/mol (PubChem CID 1712095)</td></tr><tr><td>logP:</td><td>5.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Drotaverine;
