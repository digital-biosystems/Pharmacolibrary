    M = 0.3724);
  annotation (Documentation(info = "<html><body><p>Conjugated estrogens, a mixture of estrogens derived from horse urine, are used as estrogen therapy, mainly for menopausal symptoms. They remain an approved medicine, though they carry a boxed warning and are not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4118295\">Wikidata Q4118295</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>conjugated estrogens</td></tr><tr><td>ATC codes:</td><td>G03CA57</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00286\">DB00286</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4118295\">Q4118295</a></td></tr><tr><td>molar mass:</td><td>372.4 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end ConjugatedEstrogens;
