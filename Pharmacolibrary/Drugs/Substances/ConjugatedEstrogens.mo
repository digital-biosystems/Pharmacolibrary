  annotation (Documentation(info = "<html><body><p>Conjugated estrogens are estrogen medicines used for hormone-related conditions in women, such as menopausal symptoms. They are approved and in use, and are also combined with bazedoxifene in a combination drug.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q16274732&quot;>Wikidata Q16274732</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>conjugated estrogens</td></tr><tr><td>ATC codes:</td><td>G03CA57</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00286&quot;>DB00286</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q16274732&quot;>Q16274732</a></td></tr><tr><td>molar mass:</td><td>372.4 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
