    logP = 7.6);
  annotation (Documentation(info = "<html><body><p>Bexarotene is a retinoid anticancer drug used to treat cutaneous T-cell lymphoma, including mycosis fungoides. It is approved and authorised in the European Union for this cancer, and is also being studied for other investigational uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q418192&quot;>Wikidata Q418192</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>bexarotene</td></tr><tr><td>ATC codes:</td><td>L01XF03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00307&quot;>DB00307</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/82146&quot;>82146</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:50859&quot;>50859</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q418192&quot;>Q418192</a></td></tr><tr><td>formula:</td><td>C24H28O2</td></tr><tr><td>molar mass:</td><td>348.486 g/mol (PubChem)</td></tr></table></body></html>"));
end Bexarotene;
