    logP = 0.88);
  annotation (Documentation(info = "<html><body><p>Epitizide is a diuretic of the thiazide type combined with a potassium-sparing agent, used to treat fluid retention and high blood pressure. It is not an established marketed medicine today; databases list it only as an experimental drug, so its current availability is unclear.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Epitizide</td></tr><tr><td>ATC codes:</td><td>C03EA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13989&quot;>DB13989</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/15671&quot;>15671</a></td></tr><tr><td>formula:</td><td>C10H11ClF3N3O4S3</td></tr><tr><td>molar mass:</td><td>425.839 g/mol (PubChem)</td></tr></table></body></html>"));
end Epitizide;
