  annotation (Documentation(info = "<html><body><p>Nimesulide is a non-steroidal anti-inflammatory drug used to treat pain and inflammation. It has been approved in some countries but withdrawn in others, reportedly over safety concerns including liver damage, so its availability varies by country.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q20994&quot;>Wikidata Q20994</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nimesulide</td></tr><tr><td>ATC codes:</td><td>M01AX17, M02AA26</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB04743&quot;>DB04743</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4495&quot;>4495</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:44445&quot;>44445</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q20994&quot;>Q20994</a></td></tr><tr><td>formula:</td><td>C13H12N2O5S</td></tr><tr><td>molar mass:</td><td>308.308 g/mol (PubChem)</td></tr></table></body></html>"));
