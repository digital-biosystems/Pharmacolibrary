  annotation (Documentation(info = "<html><body><p>Monoethanolamine oleate is a sclerosing agent used to treat varicose veins by injection. It is an approved medicine, used as a local injection for antivaricose therapy.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6901567&quot;>Wikidata Q6901567</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>monoethanolamine oleate</td></tr><tr><td>ATC codes:</td><td>C05BB01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06689&quot;>DB06689</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5282489&quot;>5282489</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:178699&quot;>178699</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6901567&quot;>Q6901567</a></td></tr><tr><td>formula:</td><td>C20H41NO3</td></tr><tr><td>molar mass:</td><td>343.552 g/mol (PubChem)</td></tr></table></body></html>"));
