  annotation (Documentation(info = "<html><body><p>Donepezil is an acetylcholinesterase inhibitor used to treat Alzheimer's disease and other forms of dementia, including vascular and Lewy body dementia. It is an approved medicine, widely used for dementia, and has also been investigated for other memory-related conditions.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q415081\">Wikidata Q415081</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>donepezil</td></tr><tr><td>ATC codes:</td><td>N06DA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00843\">DB00843</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3152\">3152</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q415081\">Q415081</a></td></tr><tr><td>formula:</td><td>C24H29NO3</td></tr><tr><td>molar mass:</td><td>379.5 g/mol (PubChem CID 3152)</td></tr><tr><td>logP:</td><td>4.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
