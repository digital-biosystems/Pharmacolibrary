  annotation (Documentation(info = "<html><body><p>Donepezil is an anticholinesterase medicine used to treat dementia, particularly Alzheimer's disease. It is widely used and approved, and is also available in a fixed combination with memantine.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q28859529&quot;>Wikidata Q28859529</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>donepezil</td></tr><tr><td>ATC codes:</td><td>N06DA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00843&quot;>DB00843</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3152&quot;>3152</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q28859529&quot;>Q28859529</a></td></tr><tr><td>formula:</td><td>C24H29NO3</td></tr><tr><td>molar mass:</td><td>379.5 g/mol (PubChem)</td></tr></table></body></html>"));
