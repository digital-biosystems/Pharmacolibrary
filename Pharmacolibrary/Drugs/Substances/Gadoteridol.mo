  annotation (Documentation(info = "<html><body><p>Gadoteridol is a gadolinium-based contrast agent used to improve the visibility of tissues during magnetic resonance imaging scans. It is an approved paramagnetic MRI contrast medium, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5516429\">Wikidata Q5516429</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>gadoteridol</td></tr><tr><td>ATC codes:</td><td>V08CA04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00597\">DB00597</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/60714\">60714</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31643\">31643</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5516429\">Q5516429</a></td></tr><tr><td>formula:</td><td>C17H29GdN4O7</td></tr><tr><td>molar mass:</td><td>558.69 g/mol (PubChem CID 60714)</td></tr></table></body></html>"));
end Gadoteridol;
