  annotation (Documentation(info = "<html><body><p>Seratrodast is an antiasthmatic, anti-inflammatory drug developed for obstructive airway diseases such as asthma. It is not an established marketed medicine and remains an experimental compound, with no authorisation recorded in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7452735\">Wikidata Q7452735</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>seratrodast</td></tr><tr><td>ATC codes:</td><td>R03DX06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06739\">DB06739</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2449\">2449</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32126\">32126</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7452735\">Q7452735</a></td></tr><tr><td>formula:</td><td>C22H26O4</td></tr><tr><td>molar mass:</td><td>354.446 g/mol (PubChem CID 2449)</td></tr><tr><td>logP:</td><td>4.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
