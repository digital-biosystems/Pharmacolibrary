  annotation (Documentation(info = "<html><body><p>Tecovirimat is an antiviral medicine used to treat poxvirus infections, including smallpox, monkeypox, cowpox, and vaccinia. It is authorised in the European Union and also has approved and investigational status elsewhere.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7692792\">Wikidata Q7692792</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>tecovirimat</td></tr><tr><td>ATC codes:</td><td>J05AX24</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12020\">DB12020</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/16124688\">16124688</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7692792\">Q7692792</a></td></tr><tr><td>formula:</td><td>C19H15F3N2O3</td></tr><tr><td>molar mass:</td><td>376.334 g/mol (PubChem CID 16124688)</td></tr><tr><td>logP:</td><td>2.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Tecovirimat;
