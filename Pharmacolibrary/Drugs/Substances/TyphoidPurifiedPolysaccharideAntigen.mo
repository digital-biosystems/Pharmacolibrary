within Pharmacolibrary.Drugs.Substances;
package TyphoidPurifiedPolysaccharideAntigen "typhoid, purified polysaccharide antigen"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "typhoid, purified polysaccharide antigen",
    atcCodes = {"J07AP03"},
    drugbankId = "DB10803");
  annotation (Documentation(info = "<html><body><p>This vaccine is used to protect against typhoid fever caused by Salmonella typhi. It is an approved bacterial typhoid vaccine, though its availability appears limited and it has also been investigated for other uses.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>typhoid, purified polysaccharide antigen</td></tr><tr><td>ATC codes:</td><td>J07AP03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB10803&quot;>DB10803</a></td></tr></table></body></html>"));
end TyphoidPurifiedPolysaccharideAntigen;
