  annotation (Documentation(info = "<html><body><p>Isavuconazole is a triazole antifungal used to treat aspergillosis, a fungal infection. It is authorised in the European Union and is an approved medicine, though also still under investigation for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6079042\">Wikidata Q6079042</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>isavuconazole</td></tr><tr><td>ATC codes:</td><td>J02AC05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11633\">DB11633</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6918485\">6918485</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:85979\">85979</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6079042\">Q6079042</a></td></tr><tr><td>formula:</td><td>C22H17F2N5OS</td></tr><tr><td>molar mass:</td><td>437.468 g/mol (PubChem CID 6918485)</td></tr><tr><td>logP:</td><td>3.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
