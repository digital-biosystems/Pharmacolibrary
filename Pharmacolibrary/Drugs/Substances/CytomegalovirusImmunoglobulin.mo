within Pharmacolibrary.Drugs.Substances;
package CytomegalovirusImmunoglobulin "cytomegalovirus immunoglobulin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "cytomegalovirus immunoglobulin",
    atcCodes = {"J06BB09"},
    drugbankId = "DB13886");
  annotation (Documentation(info = "<html><body><p>Cytomegalovirus immunoglobulin is a specific immunoglobulin used to prevent or treat cytomegalovirus infection, mainly in transplant patients. It is an approved blood-product medicine and remains in clinical use, given by infusion under specialist care.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cytomegalovirus immunoglobulin</td></tr><tr><td>ATC codes:</td><td>J06BB09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13886\">DB13886</a></td></tr></table></body></html>"));
end CytomegalovirusImmunoglobulin;
