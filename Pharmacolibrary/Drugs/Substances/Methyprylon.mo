  annotation (Documentation(info = "<html><body><p>Methyprylon is a sedative-hypnotic drug that was used to treat insomnia. It has been withdrawn from the market, largely because of its potential for abuse and dependence.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q409558&quot;>Wikidata Q409558</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>methyprylon</td></tr><tr><td>ATC codes:</td><td>N05CE02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01107&quot;>DB01107</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4162&quot;>4162</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31837&quot;>31837</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q409558&quot;>Q409558</a></td></tr><tr><td>formula:</td><td>C10H17NO2</td></tr><tr><td>molar mass:</td><td>183.251 g/mol (PubChem)</td></tr></table></body></html>"));
