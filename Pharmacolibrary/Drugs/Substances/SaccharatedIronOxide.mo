  annotation (Documentation(info = "<html><body><p>Iron sucrose is an intravenous iron preparation used to treat iron deficiency anemia. It is an approved medicine and remains in use as a hematinic for anemia.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27888379\">Wikidata Q27888379</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>saccharated iron oxide</td></tr><tr><td>ATC codes:</td><td>B03AB02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09146\">DB09146</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27888379\">Q27888379</a></td></tr><tr><td>logP:</td><td>-4.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
