    logP = -7.5);
  annotation (Documentation(info = "<html><body><p>Bleomycin is a cytotoxic antibiotic used to treat several cancers, including testicular cancer, melanoma, squamous cell carcinoma, and Hodgkin's lymphoma. It is an approved medicine and appears on the WHO list of essential medicines, so it remains in use worldwide, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q415571&quot;>Wikidata Q415571</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bleomycin</td></tr><tr><td>ATC codes:</td><td>L01DC01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00290&quot;>DB00290</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5360373&quot;>5360373</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:22907&quot;>22907</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q415571&quot;>Q415571</a></td></tr><tr><td>formula:</td><td>C55H84N17O21S3+</td></tr><tr><td>molar mass:</td><td>1415.56 g/mol (PubChem)</td></tr></table></body></html>"));
end Bleomycin;
