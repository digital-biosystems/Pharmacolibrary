    M = 0.251293);
  annotation (Documentation(info = "<html><body><p>Picodralazine combined with diuretics is a hydrazinophthalazine combination classified as an antihypertensive, used to lower high blood pressure. It is considered experimental and there is no evidence of current authorised use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27285512\">Wikidata Q27285512</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>picodralazine and diuretics</td></tr><tr><td>ATC codes:</td><td>C02LG03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB21022\">DB21022</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:136022\">136022</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27285512\">Q27285512</a></td></tr><tr><td>formula:</td><td>C14H13N5</td></tr><tr><td>molar mass:</td><td>251.293 g/mol (knowledgebase (DrugBank calculated))</td></tr></table></body></html>"));
end PicodralazineAndDiuretics;
