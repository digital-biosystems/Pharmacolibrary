  annotation (Documentation(info = "<html><body><p>Docetaxel is a taxane chemotherapy drug used to treat several cancers, including breast, ovarian, lung, stomach, pancreatic, head and neck cancers and melanoma. It is widely used worldwide, is included on the WHO essential medicines list, and remains authorised in the European Union for several cancer types.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q420436&quot;>Wikidata Q420436</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>docetaxel</td></tr><tr><td>ATC codes:</td><td>L01CD02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01248&quot;>DB01248</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/148124&quot;>148124</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4672&quot;>4672</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q420436&quot;>Q420436</a></td></tr><tr><td>formula:</td><td>C43H53NO14</td></tr><tr><td>molar mass:</td><td>807.89 g/mol (PubChem)</td></tr></table></body></html>"));
