  annotation (Documentation(info = "<html><body><p>Axatilimab is a monoclonal antibody drug used to treat chronic graft-versus-host disease. It is an approved medicine, though further uses are still being investigated; it is not authorised in the European Union.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>axatilimab</td></tr><tr><td>ATC codes:</td><td>L04AG19</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB16388\">DB16388</a></td></tr></table></body></html>"));
