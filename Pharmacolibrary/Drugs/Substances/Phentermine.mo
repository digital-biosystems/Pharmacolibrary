  annotation (Documentation(info = "<html><body><p>Phentermine is an appetite suppressant used to treat obesity. It is an approved antiobesity medicine, though it also has illicit use and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q418157&quot;>Wikidata Q418157</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>phentermine</td></tr><tr><td>ATC codes:</td><td>A08AA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00191&quot;>DB00191</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4771&quot;>4771</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8080&quot;>8080</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q418157&quot;>Q418157</a></td></tr><tr><td>formula:</td><td>C10H15N</td></tr><tr><td>molar mass:</td><td>149.237 g/mol (PubChem)</td></tr></table></body></html>"));
