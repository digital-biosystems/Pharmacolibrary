  annotation (Documentation(info = "<html><body><p>Interferon beta-1b is an immunomodulating drug used to treat multiple sclerosis, including relapsing-remitting and secondary progressive forms. It remains authorised in the European Union, though one EU product has been withdrawn, and it is also under investigation for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1851162\">Wikidata Q1851162</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>interferon beta-1b</td></tr><tr><td>ATC codes:</td><td>L03AB08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00068\">DB00068</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1851162\">Q1851162</a></td></tr><tr><td>molar mass:</td><td>20011 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end InterferonBeta1b;
