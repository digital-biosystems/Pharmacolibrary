within Pharmacolibrary.Drugs.Substances;
package Ethinylestradiol "ethinylestradiol"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "ethinylestradiol",
    atcCodes = {"G03CA01", "L02AA03"},
    drugbankId = "DB00977",
    pubchemCid = "5991",
    chebiId = "4903",
    wikidataId = "Q415563",
    formula = "C20H24O2",
