    logP = 3.7);
  annotation (Documentation(info = "<html><body><p>Ethinylestradiol is an estrogen used mainly in combined birth control pills, and has also been used for hormone-related conditions such as menopausal problems, hypogonadism, and certain cancers. It is widely used around the world in fixed and sequential combinations with progestogens for hormonal contraception.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q415563\">Wikidata Q415563</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ethinylestradiol</td></tr><tr><td>ATC codes:</td><td>G03CA01, L02AA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00977\">DB00977</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5991\">5991</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4903\">4903</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q415563\">Q415563</a></td></tr><tr><td>formula:</td><td>C20H24O2</td></tr><tr><td>molar mass:</td><td>296.41 g/mol (PubChem CID 5991)</td></tr><tr><td>logP:</td><td>3.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Ethinylestradiol;
