  annotation (Documentation(info = "<html><body><p>Galantamine is an acetylcholinesterase inhibitor used to treat Alzheimer's disease and other forms of dementia. It is an approved medicine, widely used for these conditions, and has also been investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q412690\">Wikidata Q412690</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>galantamine</td></tr><tr><td>ATC codes:</td><td>N06DA04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00674\">DB00674</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9651\">9651</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:42944\">42944</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q412690\">Q412690</a></td></tr><tr><td>formula:</td><td>C17H21NO3</td></tr><tr><td>molar mass:</td><td>287.359 g/mol (PubChem CID 9651)</td></tr><tr><td>logP:</td><td>1.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
