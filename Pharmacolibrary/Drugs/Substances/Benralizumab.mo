  annotation (Documentation(info = "<html><body><p>Benralizumab is a monoclonal antibody used as an antiasthmatic drug for obstructive airway disease, and has also been studied for chronic spontaneous urticaria. It is authorised in the European Union for asthma and is also under investigation for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3638304&quot;>Wikidata Q3638304</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>benralizumab</td></tr><tr><td>ATC codes:</td><td>R03DX10</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12023&quot;>DB12023</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3638304&quot;>Q3638304</a></td></tr><tr><td>molar mass:</td><td>146054 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Benralizumab;
