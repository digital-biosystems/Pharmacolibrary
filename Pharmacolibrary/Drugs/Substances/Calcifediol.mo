    logP = 6.2);
  annotation (Documentation(info = "<html><body><p>Calcifediol, a vitamin D3 analogue, is used to treat vitamin D deficiency, metabolic bone disease, and secondary hyperparathyroidism of renal origin. It is an approved medicine and is also available as a nutraceutical supplement, though it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q139307&quot;>Wikidata Q139307</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>calcifediol</td></tr><tr><td>ATC codes:</td><td>A11CC06, H05BX05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00146&quot;>DB00146</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5283731&quot;>5283731</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:17933&quot;>17933</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q139307&quot;>Q139307</a></td></tr><tr><td>formula:</td><td>C27H44O2</td></tr><tr><td>molar mass:</td><td>400.647 g/mol (PubChem)</td></tr></table></body></html>"));
end Calcifediol;
