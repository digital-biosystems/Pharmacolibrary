  annotation (Documentation(info = "<html><body><p>Panipenem with betamipron is a carbapenem antibiotic combination used to treat bacterial infections. It is considered experimental and is not authorised in the European Union; it has been used mainly in Japan.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4897351&quot;>Wikidata Q4897351</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>panipenem and betamipron</td></tr><tr><td>ATC codes:</td><td>J01DH55</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB19858&quot;>DB19858</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31278&quot;>31278</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4897351&quot;>Q4897351</a></td></tr><tr><td>formula:</td><td>C10H11NO3</td></tr><tr><td>molar mass:</td><td>193.202 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end PanipenemAndBetamipron;
