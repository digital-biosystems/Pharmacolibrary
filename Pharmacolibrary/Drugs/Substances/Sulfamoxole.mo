    logP = 1.3);
  annotation (Documentation(info = "<html><body><p>Sulfamoxole is an intermediate-acting sulfonamide antibiotic used against bacterial infections, also available in combination with trimethoprim. It is classed as experimental and has no EMA authorisation, so it appears to be little used today.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6577297&quot;>Wikidata Q6577297</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sulfamoxole</td></tr><tr><td>ATC codes:</td><td>J01EC03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08798&quot;>DB08798</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/12894&quot;>12894</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:55548&quot;>55548</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6577297&quot;>Q6577297</a></td></tr><tr><td>formula:</td><td>C11H13N3O3S</td></tr><tr><td>molar mass:</td><td>267.303 g/mol (PubChem)</td></tr></table></body></html>"));
end Sulfamoxole;
