within Pharmacolibrary.Drugs.Substances;
package Idrocilamide "idrocilamide"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "idrocilamide",
    atcCodes = {"M02AX05"},
    drugbankId = "DB13297",
    pubchemCid = "1550874",
    chebiId = "134842",
    wikidataId = "Q682532",
    formula = "C11H13NO2",
    M = 0.19123,
    logP = 0.9);
  annotation (Documentation(info = "<html><body><p>Idrocilamide is a skeletal muscle relaxant used as a topical product for joint and muscular pain. It appears to be little used today, being classed as experimental, with no EU authorisation on record.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q682532&quot;>Wikidata Q682532</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>idrocilamide</td></tr><tr><td>ATC codes:</td><td>M02AX05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13297&quot;>DB13297</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/1550874&quot;>1550874</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134842&quot;>134842</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q682532&quot;>Q682532</a></td></tr><tr><td>formula:</td><td>C11H13NO2</td></tr><tr><td>molar mass:</td><td>191.23 g/mol (PubChem)</td></tr></table></body></html>"));
end Idrocilamide;
