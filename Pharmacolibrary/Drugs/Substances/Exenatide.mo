  annotation (Documentation(info = "<html><body><p>Exenatide is a GLP-1 agonist used as an anti-diabetic medication, notably for type 2 diabetes. It is authorised in the European Union and widely used for diabetes, with some additional investigational uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q417762\">Wikidata Q417762</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>exenatide</td></tr><tr><td>ATC codes:</td><td>A10BJ01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01276\">DB01276</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q417762\">Q417762</a></td></tr><tr><td>molar mass:</td><td>4187 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>-21 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
