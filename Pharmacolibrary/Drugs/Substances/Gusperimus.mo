  annotation (Documentation(info = "<html><body><p>Gusperimus is an investigational immunosuppressive drug that was studied for treating Wegener's granulomatosis. It is not an approved medicine; a marketing application in the European Union was withdrawn, so it remains investigational.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q10910504\">Wikidata Q10910504</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>gusperimus</td></tr><tr><td>ATC codes:</td><td>L04AA19</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12692\">DB12692</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/55362\">55362</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135609\">135609</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q10910504\">Q10910504</a></td></tr><tr><td>formula:</td><td>C17H37N7O3</td></tr><tr><td>molar mass:</td><td>387.529 g/mol (PubChem CID 55362)</td></tr><tr><td>logP:</td><td>-2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
