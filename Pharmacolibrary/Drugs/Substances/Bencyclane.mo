within Pharmacolibrary.Drugs.Substances;
package Bencyclane "bencyclane"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "bencyclane",
    atcCodes = {"C04AX11"},
    drugbankId = "DB13488",
    pubchemCid = "2312",
    chebiId = "135205",
    wikidataId = "Q723117",
    formula = "C19H31NO",
    M = 0.289463,
    logP = 4.6);
  annotation (Documentation(info = "<html><body><p>Bencyclane is a vasodilator and calcium channel blocker classified as a peripheral vasodilator, used for problems with blood flow in the limbs. It appears to be only experimental today and is not authorised in the European Union, so its current use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q723117&quot;>Wikidata Q723117</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bencyclane</td></tr><tr><td>ATC codes:</td><td>C04AX11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13488&quot;>DB13488</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2312&quot;>2312</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135205&quot;>135205</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q723117&quot;>Q723117</a></td></tr><tr><td>formula:</td><td>C19H31NO</td></tr><tr><td>molar mass:</td><td>289.463 g/mol (PubChem)</td></tr></table></body></html>"));
end Bencyclane;
