  annotation (Documentation(info = "<html><body><p>Metacycline is a tetracycline antibiotic used to treat bacterial infections such as bronchitis. It is an approved antibacterial for systemic use, but does not appear to be widely marketed today.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2365033&quot;>Wikidata Q2365033</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>metacycline</td></tr><tr><td>ATC codes:</td><td>J01AA05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00931&quot;>DB00931</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/54675785&quot;>54675785</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6805&quot;>6805</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2365033&quot;>Q2365033</a></td></tr><tr><td>formula:</td><td>C22H22N2O8</td></tr><tr><td>molar mass:</td><td>442.424 g/mol (PubChem)</td></tr></table></body></html>"));
