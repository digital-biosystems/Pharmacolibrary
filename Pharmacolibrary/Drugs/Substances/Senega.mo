within Pharmacolibrary.Drugs.Substances;
package Senega "senega"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "senega",
    atcCodes = {"R05CA06"},
    drugbankId = "DB14749",
    wikidataId = "Q3395566");
  annotation (Documentation(info = "<html><body><p>Senega, an extract of Polygala senega root, is a herbal expectorant used to relieve cough and cold symptoms. It is classified as an approved expectorant for respiratory use, though it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3395566&quot;>Wikidata Q3395566</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>senega</td></tr><tr><td>ATC codes:</td><td>R05CA06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB14749&quot;>DB14749</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3395566&quot;>Q3395566</a></td></tr></table></body></html>"));
end Senega;
