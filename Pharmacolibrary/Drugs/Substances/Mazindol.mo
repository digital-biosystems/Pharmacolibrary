  annotation (Documentation(info = "<html><body><p>Mazindol is a stimulant appetite suppressant used to treat obesity. It has approved status but is not authorised by the European Medicines Agency, so its availability today is limited.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q255680\">Wikidata Q255680</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mazindol</td></tr><tr><td>ATC codes:</td><td>A08AA05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00579\">DB00579</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4020\">4020</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6702\">6702</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q255680\">Q255680</a></td></tr><tr><td>formula:</td><td>C16H13ClN2O</td></tr><tr><td>molar mass:</td><td>284.743 g/mol (PubChem CID 4020)</td></tr><tr><td>logP:</td><td>2.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
