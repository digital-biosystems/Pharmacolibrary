within Pharmacolibrary.Drugs.Substances;
package Neltenexine "neltenexine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "neltenexine",
    atcCodes = {"R05CB14"},
    drugbankId = "DB13239",
    pubchemCid = "3047787",
    chebiId = "135789",
    wikidataId = "Q6990833",
    formula = "C18H20Br2N2O2S",
    M = 0.488238,
    logP = 4.2);
  annotation (Documentation(info = "<html><body><p>Neltenexine is a mucolytic, a type of drug that thins mucus, and was investigated for use in respiratory conditions involving excess mucus such as cough and cold complaints. It remains investigational and does not appear to be an approved medicine in major markets such as the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6990833\">Wikidata Q6990833</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>neltenexine</td></tr><tr><td>ATC codes:</td><td>R05CB14</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13239\">DB13239</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3047787\">3047787</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135789\">135789</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6990833\">Q6990833</a></td></tr><tr><td>formula:</td><td>C18H20Br2N2O2S</td></tr><tr><td>molar mass:</td><td>488.238 g/mol (PubChem CID 3047787)</td></tr><tr><td>logP:</td><td>4.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Neltenexine;
