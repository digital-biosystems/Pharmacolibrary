  annotation (Documentation(info = "<html><body><p>Aluminium phosphate is an antacid used for acid-related disorders of the digestive tract, and also serves as an immunologic adjuvant in vaccines. It is an approved drug, used widely as a non-prescription antacid.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q419503&quot;>Wikidata Q419503</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>aluminium phosphate</td></tr><tr><td>ATC codes:</td><td>A02AB03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB14517&quot;>DB14517</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q419503&quot;>Q419503</a></td></tr><tr><td>formula:</td><td>AlO4P</td></tr><tr><td>molar mass:</td><td>121.953 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
