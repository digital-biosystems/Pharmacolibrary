  annotation (Documentation(info = "<html><body><p>Aluminium phosphate is an antacid used for acid-related disorders of the digestive tract, and also serves as an immunologic adjuvant in vaccines. It is an approved drug, used widely as a non-prescription antacid.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q419503\">Wikidata Q419503</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>aluminium phosphate</td></tr><tr><td>ATC codes:</td><td>A02AB03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB14517\">DB14517</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q419503\">Q419503</a></td></tr><tr><td>formula:</td><td>AlO4P</td></tr><tr><td>molar mass:</td><td>121.953 g/mol (knowledgebase (DrugBank calculated))</td></tr></table></body></html>"));
end AluminiumPhosphate;
