    logP = 0.9);
  annotation (Documentation(info = "<html><body><p>Pseudoephedrine is a decongestant used to relieve nasal congestion from conditions such as the common cold, sinusitis, and nasopharyngitis, and it also acts as a bronchodilator. It is an approved medicine, available in nasal and respiratory preparations, and is widely used as a systemic nasal decongestant.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q263958&quot;>Wikidata Q263958</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pseudoephedrine</td></tr><tr><td>ATC codes:</td><td>R01BA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00852&quot;>DB00852</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/7028&quot;>7028</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:51209&quot;>51209</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q263958&quot;>Q263958</a></td></tr><tr><td>formula:</td><td>C10H15NO</td></tr><tr><td>molar mass:</td><td>165.236 g/mol (PubChem)</td></tr></table></body></html>"));
