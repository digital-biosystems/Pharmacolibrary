within Pharmacolibrary.Drugs.Substances;
package HepatitisBImmunoglobulin "hepatitis B immunoglobulin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "hepatitis B immunoglobulin",
    atcCodes = {"J06BB04"},
    drugbankId = "DB05276",
    wikidataId = "Q5731700");
  annotation (Documentation(info = "<html><body><p>Hepatitis B immune globulin is a specific immunoglobulin (antibody) preparation used against hepatitis B infection. It is an approved medicine, given as an injection, and is used in many countries for protection against hepatitis B, for example after exposure or around the time of liver transplantation.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5731700\">Wikidata Q5731700</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>hepatitis B immunoglobulin</td></tr><tr><td>ATC codes:</td><td>J06BB04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB05276\">DB05276</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5731700\">Q5731700</a></td></tr></table></body></html>"));
end HepatitisBImmunoglobulin;
