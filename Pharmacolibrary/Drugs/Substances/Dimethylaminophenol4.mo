  annotation (Documentation(info = "<html><body><p>4-Dimethylaminophenol is an antidote, used as an experimental treatment for cyanide poisoning. It is not an approved medicine; it remains experimental and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q229950\">Wikidata Q229950</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>4-dimethylaminophenol</td></tr><tr><td>ATC codes:</td><td>V03AB27</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13549\">DB13549</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135941\">135941</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q229950\">Q229950</a></td></tr><tr><td>formula:</td><td>C8H11NO</td></tr><tr><td>molar mass:</td><td>137.182 g/mol (knowledgebase (DrugBank calculated))</td></tr><tr><td>logP:</td><td>2.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
