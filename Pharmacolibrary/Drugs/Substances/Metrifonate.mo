within Pharmacolibrary.Drugs.Substances;
package Metrifonate "metrifonate"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "metrifonate",
    atcCodes = {"P02BB01"},
    drugbankId = "DB11473",
    pubchemCid = "5853",
    chebiId = "6908",
    wikidataId = "Q422991",
    formula = "C4H8Cl3O4P",
    M = 0.257428,
    logP = 0.5);
  annotation (Documentation(info = "<html><body><p>Metrifonate is an organophosphorus anthelmintic used to treat parasitic worm infections, and has also been studied as an acetylcholinesterase inhibitor. It is no longer approved for human use and is now mainly a veterinary medicine, with any other use still experimental.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q422991&quot;>Wikidata Q422991</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>metrifonate</td></tr><tr><td>ATC codes:</td><td>P02BB01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11473&quot;>DB11473</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5853&quot;>5853</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6908&quot;>6908</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q422991&quot;>Q422991</a></td></tr><tr><td>formula:</td><td>C4H8Cl3O4P</td></tr><tr><td>molar mass:</td><td>257.428 g/mol (PubChem)</td></tr></table></body></html>"));
end Metrifonate;
