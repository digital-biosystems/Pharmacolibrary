    logP = 3.2);
  annotation (Documentation(info = "<html><body><p>Ketotifen is an antihistamine used to treat allergic conditions, acting as an H1 antagonist with anti-allergic and anti-itch effects. It is an approved medicine, available both as a systemic antihistamine and as an eye preparation for allergic eye symptoms.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2458673\">Wikidata Q2458673</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ketotifen</td></tr><tr><td>ATC codes:</td><td>R06AX17, S01GX08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00920\">DB00920</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3827\">3827</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:92511\">92511</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2458673\">Q2458673</a></td></tr><tr><td>formula:</td><td>C19H19NOS</td></tr><tr><td>molar mass:</td><td>309.427 g/mol (PubChem CID 3827)</td></tr><tr><td>logP:</td><td>3.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
