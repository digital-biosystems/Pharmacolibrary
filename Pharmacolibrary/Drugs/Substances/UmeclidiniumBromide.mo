  annotation (Documentation(info = "<html><body><p>Umeclidinium bromide is a muscarinic antagonist used to treat chronic obstructive pulmonary disease. It is authorised in the European Union, typically inhaled alone or in combination with adrenergic bronchodilators.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q21011235&quot;>Wikidata Q21011235</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>umeclidinium bromide</td></tr><tr><td>ATC codes:</td><td>R03BB07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09076&quot;>DB09076</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/11519070&quot;>11519070</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:79041&quot;>79041</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q21011235&quot;>Q21011235</a></td></tr><tr><td>formula:</td><td>C29H34NO2+</td></tr><tr><td>molar mass:</td><td>428.596 g/mol (PubChem)</td></tr></table></body></html>"));
