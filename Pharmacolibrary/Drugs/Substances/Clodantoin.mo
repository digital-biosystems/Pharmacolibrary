  annotation (Documentation(info = "<html><body><p>Clodantoin (chlordantoin) is classified as a gynecological antiinfective and antiseptic, suggesting use against genital infections. It is listed as an experimental compound and has no European Union marketing authorisation, so its current availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5134854&quot;>Wikidata Q5134854</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>clodantoin</td></tr><tr><td>ATC codes:</td><td>G01AX01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13516&quot;>DB13516</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/21782&quot;>21782</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135965&quot;>135965</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5134854&quot;>Q5134854</a></td></tr><tr><td>formula:</td><td>C11H17Cl3N2O2S</td></tr><tr><td>molar mass:</td><td>347.679 g/mol (PubChem)</td></tr></table></body></html>"));
