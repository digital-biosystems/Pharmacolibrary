  annotation (Documentation(info = "<html><body><p>Formoterol is a long-acting inhaled beta-2 agonist used to treat asthma and chronic obstructive pulmonary disease. It is widely used, both alone and in combination inhalers with corticosteroids or anticholinergics, and is an approved medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q637247\">Wikidata Q637247</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>formoterol</td></tr><tr><td>ATC codes:</td><td>R03AC13, R03CC15</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00983\">DB00983</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3410\">3410</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:63082\">63082</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q637247\">Q637247</a></td></tr><tr><td>formula:</td><td>C19H24N2O4</td></tr><tr><td>molar mass:</td><td>344.411 g/mol (PubChem CID 3410)</td></tr><tr><td>logP:</td><td>1.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
