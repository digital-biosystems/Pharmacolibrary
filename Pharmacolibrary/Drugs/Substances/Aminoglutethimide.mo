    logP = 1.2);
  annotation (Documentation(info = "<html><body><p>Aminoglutethimide is an aromatase inhibitor that was used as hormonal therapy for breast cancer, and also for prostate cancer and Cushing's syndrome. It has been withdrawn from the market, reportedly because of toxicity concerns.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q241150&quot;>Wikidata Q241150</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>aminoglutethimide</td></tr><tr><td>ATC codes:</td><td>L02BG01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00357&quot;>DB00357</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2145&quot;>2145</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:2654&quot;>2654</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q241150&quot;>Q241150</a></td></tr><tr><td>formula:</td><td>C13H16N2O2</td></tr><tr><td>molar mass:</td><td>232.283 g/mol (PubChem)</td></tr></table></body></html>"));
