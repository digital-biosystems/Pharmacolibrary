  annotation (Documentation(info = "<html><body><p>Prednicarbate is a topical corticosteroid used to treat inflammatory skin conditions, including dermatoses of the face, scalp, legs, and hands. It is an approved medicine and is used as a potent topical dermatological corticosteroid.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4376623\">Wikidata Q4376623</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>prednicarbate</td></tr><tr><td>ATC codes:</td><td>D07AC18</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01130\">DB01130</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6714002\">6714002</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135791\">135791</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4376623\">Q4376623</a></td></tr><tr><td>formula:</td><td>C27H36O8</td></tr><tr><td>molar mass:</td><td>488.577 g/mol (PubChem CID 6714002)</td></tr><tr><td>logP:</td><td>4.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
