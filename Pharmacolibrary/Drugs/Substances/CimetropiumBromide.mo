  annotation (Documentation(info = "<html><body><p>Cimetropium bromide is an anticholinergic (parasympatholytic) belladonna-derivative drug intended for functional gastrointestinal disorders, acting as an antispasmodic. It is considered investigational and does not appear to be authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27252634&quot;>Wikidata Q27252634</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cimetropium bromide</td></tr><tr><td>ATC codes:</td><td>A03BB05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09271&quot;>DB09271</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/20054871&quot;>20054871</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135516&quot;>135516</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27252634&quot;>Q27252634</a></td></tr><tr><td>formula:</td><td>C21H28NO4+</td></tr><tr><td>molar mass:</td><td>358.458 g/mol (PubChem)</td></tr></table></body></html>"));
