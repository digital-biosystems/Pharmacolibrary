  annotation (Documentation(info = "<html><body><p>Senna glycosides are stimulant laxatives used to treat constipation. They are widely used and are included on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q502327&quot;>Wikidata Q502327</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>senna glycosides</td></tr><tr><td>ATC codes:</td><td>A06AB06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11365&quot;>DB11365</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/656822&quot;>656822</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q502327&quot;>Q502327</a></td></tr><tr><td>formula:</td><td>C42H38O20</td></tr><tr><td>molar mass:</td><td>862.746 g/mol (PubChem)</td></tr></table></body></html>"));
