    logP = 0.2);
  annotation (Documentation(info = "<html><body><p>Cytisinicline (cytisine) is a drug used to help people quit smoking, classified for nicotine dependence. It is not authorised in the European Union and is considered investigational, though it has long been used for smoking cessation in parts of Eastern Europe.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q417343\">Wikidata Q417343</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cytisinicline</td></tr><tr><td>ATC codes:</td><td>N07BA04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09028\">DB09028</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/10235\">10235</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4055\">4055</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q417343\">Q417343</a></td></tr><tr><td>formula:</td><td>C11H14N2O</td></tr><tr><td>molar mass:</td><td>190.246 g/mol (PubChem CID 10235)</td></tr><tr><td>logP:</td><td>0.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
