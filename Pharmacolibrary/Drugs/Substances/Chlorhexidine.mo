within Pharmacolibrary.Drugs.Substances;
package Chlorhexidine "chlorhexidine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "chlorhexidine",
    atcCodes = {"A01AB03", "B05CA02", "D08AC02", "D09AA12", "R02AA05", "S01AX09", "S02AA09", "S03AA04"},
    drugbankId = "DB00878",
    pubchemCid = "9552079",
    chebiId = "3614",
    wikidataId = "Q15646788",
    formula = "C22H30Cl2N10",
    M = 0.505452,
    logP = 0.1);
  annotation (Documentation(info = "<html><body><p>Chlorhexidine is an antiseptic used to prevent and treat infections such as gingivitis, oral candidiasis, and skin and wound infections, and it also serves as a disinfectant. It is widely used in many forms, including mouthwashes, skin antiseptics, irrigating solutions, eye and ear preparations, and medicated dressings, and is listed as a WHO essential medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q15646788&quot;>Wikidata Q15646788</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>chlorhexidine</td></tr><tr><td>ATC codes:</td><td>A01AB03, B05CA02, D08AC02, D09AA12, R02AA05, S01AX09, S02AA09, S03AA04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00878&quot;>DB00878</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/9552079&quot;>9552079</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3614&quot;>3614</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q15646788&quot;>Q15646788</a></td></tr><tr><td>formula:</td><td>C22H30Cl2N10</td></tr><tr><td>molar mass:</td><td>505.452 g/mol (PubChem)</td></tr></table></body></html>"));
end Chlorhexidine;
