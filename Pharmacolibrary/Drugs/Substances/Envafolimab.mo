  annotation (Documentation(info = "<html><body><p>Envafolimab is an investigational anticancer monoclonal antibody that blocks the PD-1/PD-L1 pathway. It is not yet an approved medicine and remains under investigation, with no marketing authorisation in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q123499516&quot;>Wikidata Q123499516</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>envafolimab</td></tr><tr><td>ATC codes:</td><td>L01FF15</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB15769&quot;>DB15769</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q123499516&quot;>Q123499516</a></td></tr></table></body></html>"));
end Envafolimab;
