  annotation (Documentation(info = "<html><body><p>Distigmine is an acetylcholinesterase inhibitor that has been used to treat myasthenia gravis and neurogenic bladder. It is considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27149809&quot;>Wikidata Q27149809</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>distigmine</td></tr><tr><td>ATC codes:</td><td>N07AA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13694&quot;>DB13694</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3116&quot;>3116</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:80756&quot;>80756</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27149809&quot;>Q27149809</a></td></tr><tr><td>formula:</td><td>C22H32N4O4+2</td></tr><tr><td>molar mass:</td><td>416.522 g/mol (PubChem)</td></tr></table></body></html>"));
