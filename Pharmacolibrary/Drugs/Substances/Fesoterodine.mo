  annotation (Documentation(info = "<html><body><p>Fesoterodine is a muscarinic antagonist used to treat overactive bladder, a condition involving urinary frequency and incontinence. It is an approved medicine, authorised in the European Union, and is used for this urological indication.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4482372&quot;>Wikidata Q4482372</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>fesoterodine</td></tr><tr><td>ATC codes:</td><td>G04BD11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06702&quot;>DB06702</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6918558&quot;>6918558</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135920&quot;>135920</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4482372&quot;>Q4482372</a></td></tr><tr><td>formula:</td><td>C26H37NO3</td></tr><tr><td>molar mass:</td><td>411.586 g/mol (PubChem)</td></tr></table></body></html>"));
