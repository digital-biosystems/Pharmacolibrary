  annotation (Documentation(info = "<html><body><p>Moclobemide is an antidepressant that works as a reversible inhibitor of monoamine oxidase A. It is an approved medicine, used in several countries for depression, though it is not authorised centrally in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q421934\">Wikidata Q421934</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>moclobemide</td></tr><tr><td>ATC codes:</td><td>N06AG02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01171\">DB01171</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4235\">4235</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:83531\">83531</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q421934\">Q421934</a></td></tr><tr><td>formula:</td><td>C13H17ClN2O2</td></tr><tr><td>molar mass:</td><td>268.741 g/mol (PubChem CID 4235)</td></tr><tr><td>logP:</td><td>1.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
