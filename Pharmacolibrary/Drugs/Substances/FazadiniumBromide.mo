  annotation (Documentation(info = "<html><body><p>Fazadinium bromide is a peripherally acting muscle relaxant that was used to relax muscles, for example during surgery. It is no longer in routine clinical use and is regarded as an experimental compound.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5439136&quot;>Wikidata Q5439136</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>fazadinium bromide</td></tr><tr><td>ATC codes:</td><td>M03AC08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13745&quot;>DB13745</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5439136&quot;>Q5439136</a></td></tr><tr><td>formula:</td><td>C28H24Br2N6</td></tr><tr><td>molar mass:</td><td>604.35 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
