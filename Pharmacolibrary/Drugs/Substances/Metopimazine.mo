  annotation (Documentation(info = "<html><body><p>Metopimazine is a phenothiazine-type antiemetic used to treat nausea and vomiting. It is considered investigational in DrugBank and is not authorised in the European Union; it has been used mainly in a few countries such as France.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q194682&quot;>Wikidata Q194682</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>metopimazine</td></tr><tr><td>ATC codes:</td><td>A04AD05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13591&quot;>DB13591</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/26388&quot;>26388</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135726&quot;>135726</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q194682&quot;>Q194682</a></td></tr><tr><td>formula:</td><td>C22H27N3O3S2</td></tr><tr><td>molar mass:</td><td>445.596 g/mol (PubChem)</td></tr></table></body></html>"));
