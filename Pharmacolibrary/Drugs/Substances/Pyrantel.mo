    logP = 1.6);
  annotation (Documentation(info = "<html><body><p>Pyrantel is an antinematodal medicine used to treat intestinal worm infections such as ascariasis, enterobiasis, trichuriasis and ancylostomiasis. It is an approved human medicine and is also approved for veterinary use, and it appears on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q426897\">Wikidata Q426897</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pyrantel</td></tr><tr><td>ATC codes:</td><td>P02CC01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11156\">DB11156</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/708857\">708857</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8654\">8654</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q426897\">Q426897</a></td></tr><tr><td>formula:</td><td>C11H14N2S</td></tr><tr><td>molar mass:</td><td>206.307 g/mol (PubChem CID 708857)</td></tr><tr><td>logP:</td><td>1.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Pyrantel;
