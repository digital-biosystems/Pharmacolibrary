  annotation (Documentation(info = "<html><body><p>Fidaxomicin is an intestinal antibiotic used to treat Clostridium infections. It is approved and authorised in the European Union, and is also under investigation for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q111242331&quot;>Wikidata Q111242331</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>fidaxomicin</td></tr><tr><td>ATC codes:</td><td>A07AA12</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08874&quot;>DB08874</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/70678896&quot;>70678896</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:68590&quot;>68590</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q111242331&quot;>Q111242331</a></td></tr><tr><td>formula:</td><td>C52H74Cl2O18</td></tr><tr><td>molar mass:</td><td>1058.05 g/mol (PubChem)</td></tr></table></body></html>"));
