within Pharmacolibrary.Drugs.Substances;
package Methdilazine "methdilazine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "methdilazine",
    atcCodes = {"R06AD04"},
    drugbankId = "DB00902",
    pubchemCid = "14677",
    chebiId = "6823",
    wikidataId = "Q6665709",
    formula = "C18H20N2S",
    M = 0.296432,
    logP = 5.2);
  annotation (Documentation(info = "<html><body><p>Methdilazine is an antihistamine (a phenothiazine H1 antagonist) used for allergic and itchy skin conditions such as urticaria, eczema, atopic dermatitis, allergic contact dermatitis, and pityriasis rosea. It is an approved medicine, but it is not authorised in the European Union and appears to be used only in a limited number of countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6665709\">Wikidata Q6665709</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>methdilazine</td></tr><tr><td>ATC codes:</td><td>R06AD04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00902\">DB00902</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/14677\">14677</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6823\">6823</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6665709\">Q6665709</a></td></tr><tr><td>formula:</td><td>C18H20N2S</td></tr><tr><td>molar mass:</td><td>296.432 g/mol (PubChem CID 14677)</td></tr><tr><td>logP:</td><td>5.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Methdilazine;
