  annotation (Documentation(info = "<html><body><p>Perflenapent (dodecafluoropentane) is a perfluorocarbon used as an ultrasound contrast agent, notably for echocardiography. Its European product has been withdrawn, so it is no longer available in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7168152\">Wikidata Q7168152</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>perflenapent</td></tr><tr><td>ATC codes:</td><td>V08DA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11625\">DB11625</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/12675\">12675</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:39428\">39428</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7168152\">Q7168152</a></td></tr><tr><td>formula:</td><td>C5F12</td></tr><tr><td>molar mass:</td><td>288.031 g/mol (PubChem CID 12675)</td></tr><tr><td>logP:</td><td>4.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
