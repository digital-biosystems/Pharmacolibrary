  annotation (Documentation(info = "<html><body><p>Vernakalant is an antiarrhythmic drug used to treat atrial fibrillation. It is an approved medicine, available in some countries, mainly for hospital use in restoring normal heart rhythm.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q665725\">Wikidata Q665725</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>vernakalant</td></tr><tr><td>ATC codes:</td><td>C01BG11</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06217\">DB06217</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9930049\">9930049</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135956\">135956</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q665725\">Q665725</a></td></tr><tr><td>formula:</td><td>C20H31NO4</td></tr><tr><td>molar mass:</td><td>349.471 g/mol (PubChem CID 9930049)</td></tr><tr><td>logP:</td><td>2.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
