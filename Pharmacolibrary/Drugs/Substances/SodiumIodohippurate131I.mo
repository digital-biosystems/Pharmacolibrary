  annotation (Documentation(info = "<html><body><p>Sodium iodohippurate (131I) is a radiopharmaceutical used as a diagnostic imaging agent for the kidneys. It is an approved diagnostic radiopharmaceutical, used in nuclear medicine for renal imaging.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27272329\">Wikidata Q27272329</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sodium iodohippurate (131I)</td></tr><tr><td>ATC codes:</td><td>V09CX02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09382\">DB09382</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134740\">134740</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27272329\">Q27272329</a></td></tr><tr><td>formula:</td><td>C9H7INNaO3</td></tr><tr><td>molar mass:</td><td>331.055 g/mol (knowledgebase (DrugBank calculated))</td></tr></table></body></html>"));
