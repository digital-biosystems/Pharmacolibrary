within Pharmacolibrary.Drugs.Substances;
package Ravulizumab "ravulizumab"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "ravulizumab",
    atcCodes = {"L04AA43", "L04AJ02"},
    drugbankId = "DB11580",
    wikidataId = "Q55641547",
    M = 148);
  annotation (Documentation(info = "<html><body><p>Ravulizumab, a monoclonal antibody complement inhibitor, is used for paroxysmal nocturnal hemoglobinuria and is also studied or used for conditions such as myasthenia gravis, neuromyelitis optica, and atypical hemolytic uremic syndrome. It is an approved medicine, authorised in the European Union for paroxysmal nocturnal hemoglobinuria, and carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q55641547\">Wikidata Q55641547</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>ravulizumab</td></tr><tr><td>ATC codes:</td><td>L04AA43, L04AJ02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11580\">DB11580</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q55641547\">Q55641547</a></td></tr><tr><td>molar mass:</td><td>148000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Ravulizumab;
