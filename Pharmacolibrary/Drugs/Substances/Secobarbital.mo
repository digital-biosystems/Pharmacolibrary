  annotation (Documentation(info = "<html><body><p>Secobarbital is a barbiturate sedative-hypnotic used to treat insomnia. It remains an approved medicine, including for veterinary use, though barbiturate sleeping pills are now used only rarely and largely in hospital settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q414788\">Wikidata Q414788</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>secobarbital</td></tr><tr><td>ATC codes:</td><td>N05CA06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00418\">DB00418</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5193\">5193</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9073\">9073</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q414788\">Q414788</a></td></tr><tr><td>formula:</td><td>C12H18N2O3</td></tr><tr><td>molar mass:</td><td>238.287 g/mol (PubChem CID 5193)</td></tr><tr><td>logP:</td><td>2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
