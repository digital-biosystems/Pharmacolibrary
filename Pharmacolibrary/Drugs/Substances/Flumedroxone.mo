  annotation (Documentation(info = "<html><body><p>Flumedroxone is a corticosteroid derivative classified as an antimigraine preparation, used for migraine. It appears only as an experimental compound, with no marketing authorisation found, so its current use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q8564075&quot;>Wikidata Q8564075</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>flumedroxone</td></tr><tr><td>ATC codes:</td><td>N02CB01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13610&quot;>DB13610</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/20055352&quot;>20055352</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135987&quot;>135987</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q8564075&quot;>Q8564075</a></td></tr><tr><td>formula:</td><td>C22H29F3O3</td></tr><tr><td>molar mass:</td><td>398.465 g/mol (PubChem)</td></tr></table></body></html>"));
