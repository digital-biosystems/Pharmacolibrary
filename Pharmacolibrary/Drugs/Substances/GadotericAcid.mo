within Pharmacolibrary.Drugs.Substances;
package GadotericAcid "gadoteric acid"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "gadoteric acid",
    atcCodes = {"V08CA02"},
    drugbankId = "DB09132",
    pubchemCid = "158536",
    chebiId = "73732",
    wikidataId = "Q1490905",
    formula = "C16H25GdN4O8",
    M = 0.558646,
    logP = 0);
  annotation (Documentation(info = "<html><body><p>Gadoteric acid is a paramagnetic contrast agent used to improve the visibility of tissues in magnetic resonance imaging scans. It is an approved medicine and is used in clinical practice as an MRI contrast medium.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q1490905&quot;>Wikidata Q1490905</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>gadoteric acid</td></tr><tr><td>ATC codes:</td><td>V08CA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09132&quot;>DB09132</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/158536&quot;>158536</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:73732&quot;>73732</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q1490905&quot;>Q1490905</a></td></tr><tr><td>formula:</td><td>C16H25GdN4O8</td></tr><tr><td>molar mass:</td><td>558.646 g/mol (PubChem)</td></tr></table></body></html>"));
end GadotericAcid;
