    logP = 4.5);
  annotation (Documentation(info = "<html><body><p>Pimavanserin is an antipsychotic drug used to treat psychosis associated with Parkinson's disease and related conditions such as dementia with Lewy bodies. It is approved and used mainly in the United States for Parkinson's disease psychosis, and remains investigational for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7194603&quot;>Wikidata Q7194603</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pimavanserin</td></tr><tr><td>ATC codes:</td><td>N05AX17</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB05316&quot;>DB05316</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/10071196&quot;>10071196</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:133017&quot;>133017</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7194603&quot;>Q7194603</a></td></tr><tr><td>formula:</td><td>C25H34FN3O2</td></tr><tr><td>molar mass:</td><td>427.564 g/mol (PubChem)</td></tr></table></body></html>"));
end Pimavanserin;
