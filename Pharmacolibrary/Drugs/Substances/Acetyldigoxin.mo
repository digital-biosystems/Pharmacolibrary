  annotation (Documentation(info = "<html><body><p>Acetyldigoxin is a digitalis glycoside, a class of heart medicines used for cardiac conditions such as heart failure and certain rhythm problems. It appears only as an experimental compound in drug databases, with no marketing authorisation in the European Union, so its current use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4673300&quot;>Wikidata Q4673300</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>acetyldigoxin</td></tr><tr><td>ATC codes:</td><td>C01AA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13691&quot;>DB13691</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/11765960&quot;>11765960</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4673300&quot;>Q4673300</a></td></tr><tr><td>formula:</td><td>C43H66O15</td></tr><tr><td>molar mass:</td><td>822.986 g/mol (PubChem)</td></tr></table></body></html>"));
