  annotation (Documentation(info = "<html><body><p>Edrophonium is a short-acting acetylcholinesterase inhibitor used as a diagnostic agent. It is classified under diagnostic agents in the ATC system and is approved, though it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3177745\">Wikidata Q3177745</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>edrophonium</td></tr><tr><td>ATC codes:</td><td>V04CX07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01010\">DB01010</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3202\">3202</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:251408\">251408</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3177745\">Q3177745</a></td></tr><tr><td>formula:</td><td>C10H16NO+</td></tr><tr><td>molar mass:</td><td>166.244 g/mol (PubChem CID 3202)</td></tr><tr><td>logP:</td><td>1.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
