  annotation (Documentation(info = "<html><body><p>Cyclofenil is a synthetic compound classed as an ovulation stimulant, used as a female fertility agent. It appears only as an experimental drug, with no evidence of current authorisation, so its present use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q513583&quot;>Wikidata Q513583</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cyclofenil</td></tr><tr><td>ATC codes:</td><td>G03GB01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13472&quot;>DB13472</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2898&quot;>2898</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31446&quot;>31446</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q513583&quot;>Q513583</a></td></tr><tr><td>formula:</td><td>C23H24O4</td></tr><tr><td>molar mass:</td><td>364.441 g/mol (PubChem)</td></tr></table></body></html>"));
