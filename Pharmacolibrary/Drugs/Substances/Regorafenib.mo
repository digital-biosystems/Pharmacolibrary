  annotation (Documentation(info = "<html><body><p>Regorafenib is a protein kinase inhibitor used to treat colorectal cancer and gastrointestinal stromal tumours. It is authorised in the European Union for colorectal cancer and remains in use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3891664\">Wikidata Q3891664</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>regorafenib</td></tr><tr><td>ATC codes:</td><td>L01EX05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08896\">DB08896</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/11167602\">11167602</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:68647\">68647</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3891664\">Q3891664</a></td></tr><tr><td>formula:</td><td>C21H15ClF4N4O3</td></tr><tr><td>molar mass:</td><td>482.818 g/mol (PubChem CID 11167602)</td></tr><tr><td>logP:</td><td>4.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
