    logP = 3.2);
  annotation (Documentation(info = "<html><body><p>Clarithromycin is a macrolide antibiotic used to treat many bacterial infections, including respiratory, skin, ear, and throat infections, and to help eradicate Helicobacter pylori in peptic ulcer disease. It is widely used in human medicine and appears on the WHO list of essential medicines, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q118551&quot;>Wikidata Q118551</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>clarithromycin</td></tr><tr><td>ATC codes:</td><td>J01FA09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01211&quot;>DB01211</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/84029&quot;>84029</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3732&quot;>3732</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q118551&quot;>Q118551</a></td></tr><tr><td>formula:</td><td>C38H69NO13</td></tr><tr><td>molar mass:</td><td>747.964 g/mol (PubChem)</td></tr></table></body></html>"));
end Clarithromycin;
