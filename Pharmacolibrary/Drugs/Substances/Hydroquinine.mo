  annotation (Documentation(info = "<html><body><p>Hydroquinine, a quinine derivative, is classified among drugs for disorders of the musculo-skeletal system. It is not an established marketed medicine; it is listed only as an experimental compound, so its current clinical use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5276450\">Wikidata Q5276450</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>hydroquinine</td></tr><tr><td>ATC codes:</td><td>M09AA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13718\">DB13718</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/121515\">121515</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135994\">135994</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5276450\">Q5276450</a></td></tr><tr><td>formula:</td><td>C20H26N2O2</td></tr><tr><td>molar mass:</td><td>326.44 g/mol (PubChem CID 121515)</td></tr><tr><td>logP:</td><td>3.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
