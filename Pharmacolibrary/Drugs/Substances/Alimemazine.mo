    logP = 4.7);
  annotation (Documentation(info = "<html><body><p>Alimemazine (trimeprazine) is an antihistamine of the phenothiazine class used to treat allergic skin conditions such as urticaria, atopic dermatitis and contact dermatitis, and to relieve itching. It is an approved medicine and is also approved for veterinary use, but it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2623251&quot;>Wikidata Q2623251</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>alimemazine</td></tr><tr><td>ATC codes:</td><td>R06AD01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01246&quot;>DB01246</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5574&quot;>5574</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9725&quot;>9725</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2623251&quot;>Q2623251</a></td></tr><tr><td>formula:</td><td>C18H22N2S</td></tr><tr><td>molar mass:</td><td>298.448 g/mol (PubChem)</td></tr></table></body></html>"));
end Alimemazine;
