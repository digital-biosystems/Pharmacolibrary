  annotation (Documentation(info = "<html><body><p>Ferric sodium citrate is a trivalent oral iron preparation intended for use as an antianemic agent, i.e. to treat iron-deficiency anaemia. It is currently classed as investigational and does not appear to be an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27258614&quot;>Wikidata Q27258614</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ferric sodium citrate</td></tr><tr><td>ATC codes:</td><td>B03AB01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13771&quot;>DB13771</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27258614&quot;>Q27258614</a></td></tr><tr><td>formula:</td><td>C6H4FeNaO7</td></tr><tr><td>molar mass:</td><td>266.926 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end FerricSodiumCitrate;
