  annotation (Documentation(info = "<html><body><p>Retifanlimab is a PD-1-blocking monoclonal antibody used to treat cancers, including Merkel cell carcinoma, anal cancer, and squamous cell carcinoma. It is an approved anticancer medicine, with one product authorised in the European Union and other uses still under investigation.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q117349369\">Wikidata Q117349369</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>retifanlimab</td></tr><tr><td>ATC codes:</td><td>L01FF10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB15766\">DB15766</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q117349369\">Q117349369</a></td></tr><tr><td>molar mass:</td><td>148000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
