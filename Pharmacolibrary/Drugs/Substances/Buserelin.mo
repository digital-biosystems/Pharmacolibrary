  annotation (Documentation(info = "<html><body><p>Buserelin is a gonadotropin-releasing hormone analogue used in endocrine therapy, mainly as a fertility agent in women and for hormone-related cancer treatment. It is an approved medicine, though not authorised centrally in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q414745&quot;>Wikidata Q414745</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>buserelin</td></tr><tr><td>ATC codes:</td><td>L02AE01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06719&quot;>DB06719</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/50225&quot;>50225</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135907&quot;>135907</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q414745&quot;>Q414745</a></td></tr><tr><td>formula:</td><td>C60H86N16O13</td></tr><tr><td>molar mass:</td><td>1239.45 g/mol (PubChem)</td></tr></table></body></html>"));
