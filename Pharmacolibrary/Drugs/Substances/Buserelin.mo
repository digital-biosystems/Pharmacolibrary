  annotation (Documentation(info = "<html><body><p>Buserelin is a gonadotropin-releasing hormone analogue used in endocrine therapy, mainly as a fertility agent in women and for hormone-related cancer treatment. It is an approved medicine, though not authorised centrally in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q414745\">Wikidata Q414745</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>buserelin</td></tr><tr><td>ATC codes:</td><td>L02AE01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06719\">DB06719</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135907\">135907</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q414745\">Q414745</a></td></tr><tr><td>molar mass:</td><td>1239.4 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>-0.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
