  annotation (Documentation(info = "<html><body><p>Talampicillin is an antibiotic belonging to the penicillins with extended spectrum, a class of beta-lactam antibacterials used against bacterial infections. It is currently listed only as an experimental drug, and no marketing authorisation information is available, so its present use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3980350&quot;>Wikidata Q3980350</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>talampicillin</td></tr><tr><td>ATC codes:</td><td>J01CA15</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13814&quot;>DB13814</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/71447&quot;>71447</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9391&quot;>9391</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3980350&quot;>Q3980350</a></td></tr><tr><td>formula:</td><td>C24H23N3O6S</td></tr><tr><td>molar mass:</td><td>481.523 g/mol (PubChem)</td></tr></table></body></html>"));
