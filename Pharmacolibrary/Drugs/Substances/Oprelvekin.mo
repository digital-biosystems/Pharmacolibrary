  annotation (Documentation(info = "<html><body><p>Oprelvekin is a recombinant interleukin that acts as an immunostimulant in the treatment of cancer-related conditions. It was approved at one point but has been withdrawn and is no longer in general use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7098691\">Wikidata Q7098691</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>oprelvekin</td></tr><tr><td>ATC codes:</td><td>L03AC02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00038\">DB00038</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7098691\">Q7098691</a></td></tr><tr><td>molar mass:</td><td>19047.2 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Oprelvekin;
