    logP = 2.2);
  annotation (Documentation(info = "<html><body><p>Menadione, a synthetic form of vitamin K, is used to treat clotting problems such as hypoprothrombinemia and other blood coagulation disorders. It is approved as a nutraceutical and is used as a vitamin K supplement, though it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q192471&quot;>Wikidata Q192471</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>menadione</td></tr><tr><td>ATC codes:</td><td>B02BA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00170&quot;>DB00170</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4055&quot;>4055</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:28869&quot;>28869</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q192471&quot;>Q192471</a></td></tr><tr><td>formula:</td><td>C11H8O2</td></tr><tr><td>molar mass:</td><td>172.183 g/mol (PubChem)</td></tr></table></body></html>"));
end Menadione;
