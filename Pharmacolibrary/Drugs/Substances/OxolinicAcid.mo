  annotation (Documentation(info = "<html><body><p>Oxolinic acid is a quinolone antibiotic that was used as a urinary anti-infective to treat bacterial infections. It is now considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q287840&quot;>Wikidata Q287840</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>oxolinic acid</td></tr><tr><td>ATC codes:</td><td>J01MB05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13627&quot;>DB13627</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:138856&quot;>138856</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q287840&quot;>Q287840</a></td></tr><tr><td>formula:</td><td>C13H11NO5</td></tr><tr><td>molar mass:</td><td>261.23 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
