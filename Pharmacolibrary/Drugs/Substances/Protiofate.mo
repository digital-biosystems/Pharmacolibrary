  annotation (Documentation(info = "<html><body><p>Protiofate is classified as a gynecological antiinfective and antiseptic, suggesting use against genital infections. It is not an approved medicine and appears only as an experimental compound, so it is not in routine use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7251822\">Wikidata Q7251822</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>protiofate</td></tr><tr><td>ATC codes:</td><td>G01AX13</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13632\">DB13632</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/68780\">68780</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135194\">135194</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7251822\">Q7251822</a></td></tr><tr><td>formula:</td><td>C12H16O6S</td></tr><tr><td>molar mass:</td><td>288.314 g/mol (PubChem CID 68780)</td></tr><tr><td>logP:</td><td>4.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
