  annotation (Documentation(info = "<html><body><p>Fusafungine is an antibiotic that was used as a throat preparation to treat throat infections. It has been withdrawn from the market, reportedly because of rare serious allergic reactions.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q222424&quot;>Wikidata Q222424</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>fusafungine</td></tr><tr><td>ATC codes:</td><td>R02AB03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08965&quot;>DB08965</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3084092&quot;>3084092</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q222424&quot;>Q222424</a></td></tr><tr><td>formula:</td><td>C33H57N3O9</td></tr><tr><td>molar mass:</td><td>639.831 g/mol (PubChem)</td></tr></table></body></html>"));
