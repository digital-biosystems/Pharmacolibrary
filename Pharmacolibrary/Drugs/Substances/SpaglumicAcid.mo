  annotation (Documentation(info = "<html><body><p>Spaglumic acid is an antiallergic compound that has been used in nasal and eye preparations for allergic conditions such as allergic rhinitis and conjunctivitis. It is considered investigational, with no authorised marketing recorded in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q20817261\">Wikidata Q20817261</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>spaglumic acid</td></tr><tr><td>ATC codes:</td><td>R01AC05, S01GX03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08835\">DB08835</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/210320\">210320</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135289\">135289</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q20817261\">Q20817261</a></td></tr><tr><td>formula:</td><td>C11H16N2O8</td></tr><tr><td>molar mass:</td><td>304.255 g/mol (PubChem CID 210320)</td></tr><tr><td>logP:</td><td>-2.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
