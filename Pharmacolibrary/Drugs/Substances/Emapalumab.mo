  annotation (Documentation(info = "<html><body><p>Emapalumab is a monoclonal antibody used to treat hemophagocytic lymphohistiocytosis, an immune system disease. It is an approved immunosuppressant, though a marketing application for one product was refused in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q28209889&quot;>Wikidata Q28209889</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>emapalumab</td></tr><tr><td>ATC codes:</td><td>L04AA39, L04AG09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB14724&quot;>DB14724</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q28209889&quot;>Q28209889</a></td></tr><tr><td>molar mass:</td><td>154400 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Emapalumab;
