within Pharmacolibrary.Drugs.Substances;
package Carbenicillin "carbenicillin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "carbenicillin",
    atcCodes = {"J01CA03"},
    drugbankId = "DB00578",
    pubchemCid = "20824",
    chebiId = "3393",
    wikidataId = "Q1050019",
    formula = "C17H18N2O6S",
    M = 0.378399,
    logP = 1.1);
  annotation (Documentation(info = "<html><body><p>Carbenicillin is an extended-spectrum penicillin antibiotic used to treat urinary tract infections, prostatitis, and other gram-negative bacterial infections. It is an approved antibacterial for systemic use, though it is not authorised in the European Union and is now little used, having largely been replaced by newer agents.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1050019\">Wikidata Q1050019</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>carbenicillin</td></tr><tr><td>ATC codes:</td><td>J01CA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00578\">DB00578</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/20824\">20824</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3393\">3393</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1050019\">Q1050019</a></td></tr><tr><td>formula:</td><td>C17H18N2O6S</td></tr><tr><td>molar mass:</td><td>378.399 g/mol (PubChem CID 20824)</td></tr><tr><td>logP:</td><td>1.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Carbenicillin;
