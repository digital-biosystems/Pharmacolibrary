    logP = -1.9);
  annotation (Documentation(info = "<html><body><p>Penciclovir is an antiviral nucleoside analogue used to treat herpes simplex infections and has been used against Epstein–Barr virus infection. It is an approved drug, applied topically to the skin as a dermatological antiviral and also available for systemic use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q420364\">Wikidata Q420364</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>penciclovir</td></tr><tr><td>ATC codes:</td><td>D06BB06, J05AB13</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00299\">DB00299</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4725\">4725</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7956\">7956</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q420364\">Q420364</a></td></tr><tr><td>formula:</td><td>C10H15N5O3</td></tr><tr><td>molar mass:</td><td>253.258 g/mol (knowledgebase (DrugBank calculated))</td></tr><tr><td>logP:</td><td>-1.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Penciclovir;
