    logP = 5.3);
  annotation (Documentation(info = "<html><body><p>Allylestrenol is a progestin (an estren derivative steroid) that has been used as a progestogen, historically for pregnancy-related conditions such as threatened miscarriage. It is not authorised in the European Union and is considered investigational in major drug databases; it remains available only in a few countries.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q531965&quot;>Wikidata Q531965</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>allylestrenol</td></tr><tr><td>ATC codes:</td><td>G03DC01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01431&quot;>DB01431</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/235905&quot;>235905</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31189&quot;>31189</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q531965&quot;>Q531965</a></td></tr><tr><td>formula:</td><td>C21H32O</td></tr><tr><td>molar mass:</td><td>300.486 g/mol (PubChem)</td></tr></table></body></html>"));
end Allylestrenol;
