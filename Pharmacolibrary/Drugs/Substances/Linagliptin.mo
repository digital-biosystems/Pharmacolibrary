within Pharmacolibrary.Drugs.Substances;
package Linagliptin "linagliptin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "linagliptin",
    atcCodes = {"A10BH05"},
    drugbankId = "DB08882",
    pubchemCid = "10096344",
    chebiId = "68610",
    wikidataId = "Q909745",
    formula = "C25H28N8O2",
    M = 0.472553,
    logP = 1.9);
  annotation (Documentation(info = "<html><body><p>Linagliptin is a DPP-4 inhibitor used to lower blood sugar in adults with type 2 diabetes, available alone or in fixed oral combinations with other glucose-lowering drugs. It is approved and authorised in the European Union and is widely used as an oral anti-diabetic medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q909745\">Wikidata Q909745</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>linagliptin</td></tr><tr><td>ATC codes:</td><td>A10BH05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08882\">DB08882</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/10096344\">10096344</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:68610\">68610</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q909745\">Q909745</a></td></tr><tr><td>formula:</td><td>C25H28N8O2</td></tr><tr><td>molar mass:</td><td>472.553 g/mol (PubChem CID 10096344)</td></tr><tr><td>logP:</td><td>1.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Linagliptin;
