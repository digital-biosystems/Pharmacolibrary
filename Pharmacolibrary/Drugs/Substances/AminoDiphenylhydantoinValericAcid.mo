  annotation (Documentation(info = "<html><body><p>Aminodiphenylhydantoin valeric acid (Neocitrullamon) is a hydantoin compound classified as an antiepileptic, used for the treatment of epilepsy. It is considered experimental and there is no evidence of current authorised use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27268499&quot;>Wikidata Q27268499</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>amino(diphenylhydantoin) valeric acid</td></tr><tr><td>ATC codes:</td><td>N03AB03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13396&quot;>DB13396</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3084726&quot;>3084726</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27268499&quot;>Q27268499</a></td></tr><tr><td>formula:</td><td>C20H21N3O4</td></tr><tr><td>molar mass:</td><td>367.405 g/mol (PubChem)</td></tr></table></body></html>"));
