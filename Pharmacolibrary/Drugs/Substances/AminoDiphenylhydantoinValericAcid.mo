  annotation (Documentation(info = "<html><body><p>Aminodiphenylhydantoin valeric acid (Neocitrullamon) is a hydantoin compound classified as an antiepileptic, used for the treatment of epilepsy. It is considered experimental and there is no evidence of current authorised use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27268499\">Wikidata Q27268499</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>amino(diphenylhydantoin) valeric acid</td></tr><tr><td>ATC codes:</td><td>N03AB03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13396\">DB13396</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3084726\">3084726</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27268499\">Q27268499</a></td></tr><tr><td>formula:</td><td>C20H21N3O4</td></tr><tr><td>molar mass:</td><td>367.405 g/mol (PubChem CID 3084726)</td></tr><tr><td>logP:</td><td>-0.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
