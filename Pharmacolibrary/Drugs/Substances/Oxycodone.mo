    logP = 1.2);
  annotation (Documentation(info = "<html><body><p>Oxycodone is an opioid painkiller used to treat pain, including pain from injury and conditions such as fibromyalgia. It is widely used and appears on the WHO list of essential medicines, though it carries a boxed warning and is also misused illicitly.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q407535&quot;>Wikidata Q407535</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>oxycodone</td></tr><tr><td>ATC codes:</td><td>N02AA05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00497&quot;>DB00497</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5284603&quot;>5284603</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7852&quot;>7852</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q407535&quot;>Q407535</a></td></tr><tr><td>formula:</td><td>C18H21NO4</td></tr><tr><td>molar mass:</td><td>315.369 g/mol (PubChem)</td></tr></table></body></html>"));
end Oxycodone;
