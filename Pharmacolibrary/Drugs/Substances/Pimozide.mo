    logP = 6.3);
  annotation (Documentation(info = "<html><body><p>Pimozide is an antipsychotic used for conditions such as Tourette syndrome, tic disorders, schizophreniform disorder and Huntington's disease. It is an approved medicine, but is not authorised in the European Union and is used only in a limited way, mainly for severe tic disorders.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q144085&quot;>Wikidata Q144085</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pimozide</td></tr><tr><td>ATC codes:</td><td>N05AG02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01100&quot;>DB01100</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/16362&quot;>16362</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8212&quot;>8212</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q144085&quot;>Q144085</a></td></tr><tr><td>formula:</td><td>C28H29F2N3O</td></tr><tr><td>molar mass:</td><td>461.556 g/mol (PubChem)</td></tr></table></body></html>"));
end Pimozide;
