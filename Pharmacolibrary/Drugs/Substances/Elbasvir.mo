    logP = 6.7);
  annotation (Documentation(info = "<html><body><p>Elbasvir is an antiviral medicine used, in combination with grazoprevir, to treat hepatitis C infections. It is an approved direct-acting antiviral for HCV and is used in the treatment of chronic hepatitis C.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q22673321\">Wikidata Q22673321</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>elbasvir</td></tr><tr><td>ATC codes:</td><td>J05AP10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11574\">DB11574</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/71661251\">71661251</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q22673321\">Q22673321</a></td></tr><tr><td>formula:</td><td>C49H55N9O7</td></tr><tr><td>molar mass:</td><td>882.035 g/mol (PubChem CID 71661251)</td></tr><tr><td>logP:</td><td>6.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Elbasvir;
