    logP = 1.9);
  annotation (Documentation(info = "<html><body><p>Fluperolone is a moderately potent corticosteroid that has been used topically on the skin for inflammatory skin conditions. It is currently considered an experimental drug and does not appear to be an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27288511&quot;>Wikidata Q27288511</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>fluperolone</td></tr><tr><td>ATC codes:</td><td>D07AB05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13491&quot;>DB13491</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/56841872&quot;>56841872</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27288511&quot;>Q27288511</a></td></tr><tr><td>formula:</td><td>C22H29FO5</td></tr><tr><td>molar mass:</td><td>392.467 g/mol (PubChem)</td></tr></table></body></html>"));
end Fluperolone;
