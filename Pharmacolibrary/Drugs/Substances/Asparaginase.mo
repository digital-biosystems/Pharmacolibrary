within Pharmacolibrary.Drugs.Substances;
package Asparaginase "asparaginase"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "asparaginase",
    atcCodes = {"L01XX02", "LX1XX02"},
    drugbankId = "DB00023",
    wikidataId = "Q105296036");
  annotation (Documentation(info = "<html><body><p>Asparaginase is an enzyme medication used as an anticancer drug to treat lymphoma and lymphoid leukemia. It is an approved medicine, included on the WHO list of essential medicines, and is authorised in the European Union for precursor cell lymphoblastic leukemia-lymphoma.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q105296036&quot;>Wikidata Q105296036</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>asparaginase</td></tr><tr><td>ATC codes:</td><td>L01XX02, LX1XX02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00023&quot;>DB00023</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q105296036&quot;>Q105296036</a></td></tr></table></body></html>"));
end Asparaginase;
