within Pharmacolibrary.Drugs.Substances;
package Aminophylline "aminophylline"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "aminophylline",
    atcCodes = {"R03DA05"},
    drugbankId = "DB01223",
    pubchemCid = "9433",
    chebiId = "2659",
    wikidataId = "Q471763",
    formula = "C16H24N10O4",
    M = 0.420434);
  annotation (Documentation(info = "<html><body><p>Aminophylline is a bronchodilator used to treat breathing problems such as asthma, pulmonary emphysema, and acute bronchitis, and it has also been used for bradycardia. It is an approved medicine, though not authorised in the European Union, and is now used less often than newer inhaled treatments, mainly in hospital settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q471763\">Wikidata Q471763</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>aminophylline</td></tr><tr><td>ATC codes:</td><td>R03DA05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01223\">DB01223</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9433\">9433</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:2659\">2659</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q471763\">Q471763</a></td></tr><tr><td>formula:</td><td>C16H24N10O4</td></tr><tr><td>molar mass:</td><td>420.434 g/mol (PubChem CID 9433)</td></tr></table></body></html>"));
end Aminophylline;
