  annotation (Documentation(info = "<html><body><p>Limaprost is a vasodilator compound classified as an antiplatelet (antithrombotic) agent, investigated for improving blood flow. It is not an approved medicine in major markets such as the European Union and remains investigational.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q22075873\">Wikidata Q22075873</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>limaprost</td></tr><tr><td>ATC codes:</td><td>B01AC28</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09211\">DB09211</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6438378\">6438378</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135594\">135594</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q22075873\">Q22075873</a></td></tr><tr><td>formula:</td><td>C22H36O5</td></tr><tr><td>molar mass:</td><td>380.525 g/mol (PubChem CID 6438378)</td></tr><tr><td>logP:</td><td>4.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
