within Pharmacolibrary.Drugs.Substances;
package Inulin "Inulin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "Inulin",
    atcCodes = {"V04CH01"},
    drugbankId = "DB00638");
  annotation (Documentation(info = "<html><body><p>Inulin is used as a diagnostic agent for testing kidney (renal) function. It is an approved substance and is also considered a nutraceutical, so it is used both in medical testing and as a dietary supplement.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Inulin</td></tr><tr><td>ATC codes:</td><td>V04CH01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00638&quot;>DB00638</a></td></tr></table></body></html>"));
end Inulin;
