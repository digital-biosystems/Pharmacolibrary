  annotation (Documentation(info = "<html><body><p>Iclaprim is an investigational antibacterial drug, a trimethoprim derivative and folic acid antagonist studied for treating bacterial infections. It is not an approved medicine; it remains in the investigational stage and has no authorisation, for example in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q907480\">Wikidata Q907480</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>iclaprim</td></tr><tr><td>ATC codes:</td><td>J01EA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06358\">DB06358</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/213043\">213043</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:131751\">131751</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q907480\">Q907480</a></td></tr><tr><td>formula:</td><td>C19H22N4O3</td></tr><tr><td>molar mass:</td><td>354.41 g/mol (PubChem CID 213043)</td></tr><tr><td>logP:</td><td>2.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
