    logP = 7.9);
  annotation (Documentation(info = "<html><body><p>Benzalkonium is an antiseptic and disinfectant used to treat or prevent infection on skin, wounds and throat preparations. It is widely used in topical products such as antiseptics, medicated dressings and throat preparations.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q72445001\">Wikidata Q72445001</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>benzalkonium</td></tr><tr><td>ATC codes:</td><td>D08AJ01, D09AA11, R02AA16</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11105\">DB11105</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2330\">2330</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q72445001\">Q72445001</a></td></tr><tr><td>formula:</td><td>C22H40N+</td></tr><tr><td>molar mass:</td><td>318.569 g/mol (PubChem CID 2330)</td></tr><tr><td>logP:</td><td>7.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Benzalkonium;
