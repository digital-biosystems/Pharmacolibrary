    logP = -0.1);
  annotation (Documentation(info = "<html><body><p>Caffeine is a stimulant used to treat breathing problems such as apnea in newborns, and is also used in dermatological and diagnostic preparations. It is widely used and authorised in the European Union, mainly for apnea of prematurity.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q60235&quot;>Wikidata Q60235</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>caffeine</td></tr><tr><td>ATC codes:</td><td>D11AX26, N06BC01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00201&quot;>DB00201</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2519&quot;>2519</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:27732&quot;>27732</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q60235&quot;>Q60235</a></td></tr><tr><td>formula:</td><td>C8H10N4O2</td></tr><tr><td>molar mass:</td><td>194.194 g/mol (PubChem)</td></tr></table></body></html>"));
end Caffeine;
