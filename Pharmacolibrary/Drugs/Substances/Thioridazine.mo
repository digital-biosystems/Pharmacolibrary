  annotation (Documentation(info = "<html><body><p>Thioridazine is a phenothiazine antipsychotic that was used to treat schizophrenia and schizophreniform disorder. It has been withdrawn from the market, reportedly because of safety concerns including serious heart rhythm problems.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q58375\">Wikidata Q58375</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>thioridazine</td></tr><tr><td>ATC codes:</td><td>N05AC02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00679\">DB00679</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5452\">5452</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9566\">9566</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q58375\">Q58375</a></td></tr><tr><td>formula:</td><td>C21H26N2S2</td></tr><tr><td>molar mass:</td><td>370.573 g/mol (PubChem CID 5452)</td></tr><tr><td>logP:</td><td>5.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
