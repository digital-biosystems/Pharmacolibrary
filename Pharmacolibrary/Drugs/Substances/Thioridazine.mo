  annotation (Documentation(info = "<html><body><p>Thioridazine is a phenothiazine antipsychotic that was used to treat schizophrenia and schizophreniform disorder. It has been withdrawn from the market, reportedly because of safety concerns including serious heart rhythm problems.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q58375&quot;>Wikidata Q58375</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>thioridazine</td></tr><tr><td>ATC codes:</td><td>N05AC02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00679&quot;>DB00679</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5452&quot;>5452</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9566&quot;>9566</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q58375&quot;>Q58375</a></td></tr><tr><td>formula:</td><td>C21H26N2S2</td></tr><tr><td>molar mass:</td><td>370.573 g/mol (PubChem)</td></tr></table></body></html>"));
