  annotation (Documentation(info = "<html><body><p>Belatacept is an immunosuppressant used to prevent rejection of a transplanted kidney. It is authorised in the European Union and is given under medical supervision, carrying a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4881990&quot;>Wikidata Q4881990</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>belatacept</td></tr><tr><td>ATC codes:</td><td>L04AA28</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06681&quot;>DB06681</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4881990&quot;>Q4881990</a></td></tr><tr><td>molar mass:</td><td>92300 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
