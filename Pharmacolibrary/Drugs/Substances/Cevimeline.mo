  annotation (Documentation(info = "<html><body><p>Cevimeline is a parasympathomimetic (muscarinic agonist) drug used to treat Sjögren's syndrome. It is an approved medicine, mainly used in the United States; it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3665683\">Wikidata Q3665683</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cevimeline</td></tr><tr><td>ATC codes:</td><td>N07AX03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00185\">DB00185</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/25137844\">25137844</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3568\">3568</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3665683\">Q3665683</a></td></tr><tr><td>formula:</td><td>C10H17NOS</td></tr><tr><td>molar mass:</td><td>199.312 g/mol (PubChem CID 25137844)</td></tr><tr><td>logP:</td><td>1.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
