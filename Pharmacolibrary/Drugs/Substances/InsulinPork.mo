  annotation (Documentation(info = "<html><body><p>Insulin of pork origin is an injectable insulin used to treat diabetes mellitus. It has been an approved medicine, though it has largely been replaced by human and analogue insulins in many countries.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q20801773&quot;>Wikidata Q20801773</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>insulin (pork)</td></tr><tr><td>ATC codes:</td><td>A10AB03, A10AC03, A10AD03, A10AE03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00071&quot;>DB00071</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q20801773&quot;>Q20801773</a></td></tr><tr><td>molar mass:</td><td>5778 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
