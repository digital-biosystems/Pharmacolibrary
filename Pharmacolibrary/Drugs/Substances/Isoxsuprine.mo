within Pharmacolibrary.Drugs.Substances;
package Isoxsuprine "isoxsuprine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "isoxsuprine",
    atcCodes = {"C04AA01"},
    drugbankId = "DB08941",
    pubchemCid = "11779629",
    wikidataId = "Q1117888",
    formula = "C18H23NO3",
    M = 0.301386,
    logP = 2.8);
  annotation (Documentation(info = "<html><body><p>Isoxsuprine is a vasodilator that was used for peripheral vascular diseases such as arteriosclerosis, thromboangiitis obliterans, and Raynaud's disease, and also as a tocolytic to relax the uterus. It has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q1117888&quot;>Wikidata Q1117888</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>isoxsuprine</td></tr><tr><td>ATC codes:</td><td>C04AA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08941&quot;>DB08941</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/11779629&quot;>11779629</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q1117888&quot;>Q1117888</a></td></tr><tr><td>formula:</td><td>C18H23NO3</td></tr><tr><td>molar mass:</td><td>301.386 g/mol (PubChem)</td></tr></table></body></html>"));
end Isoxsuprine;
