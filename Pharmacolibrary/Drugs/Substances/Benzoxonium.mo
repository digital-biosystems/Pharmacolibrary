within Pharmacolibrary.Drugs.Substances;
package Benzoxonium "Benzoxonium"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "Benzoxonium",
    atcCodes = {"A01AB14", "D08AJ05"},
    drugbankId = "DB13565",
    pubchemCid = "29564",
    wikidataId = "Q716544",
    formula = "C23H42NO2+",
    M = 0.364594);
  annotation (Documentation(info = "<html><body><p>Benzoxonium is an antiseptic agent classified for local oral treatment in stomatological preparations and for skin antisepsis and disinfection. It appears to be only an experimental substance, with no authorisation records in the European Union, so its current clinical use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q716544\">Wikidata Q716544</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Benzoxonium</td></tr><tr><td>ATC codes:</td><td>A01AB14, D08AJ05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13565\">DB13565</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/29564\">29564</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q716544\">Q716544</a></td></tr><tr><td>formula:</td><td>C23H42NO2+</td></tr><tr><td>molar mass:</td><td>364.594 g/mol (PubChem CID 29564)</td></tr></table></body></html>"));
end Benzoxonium;
