    logP = 0.6);
  annotation (Documentation(info = "<html><body><p>Brimonidine is an alpha-adrenergic agonist used to treat glaucoma and ocular hypertension, and topically for the skin condition rosacea. It is an approved medicine, with an authorised product in the European Union for skin use, and is widely used in eye care.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q577377&quot;>Wikidata Q577377</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>brimonidine</td></tr><tr><td>ATC codes:</td><td>D11AX21, S01EA05, S01GA07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00484&quot;>DB00484</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2435&quot;>2435</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3175&quot;>3175</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q577377&quot;>Q577377</a></td></tr><tr><td>formula:</td><td>C11H10BrN5</td></tr><tr><td>molar mass:</td><td>292.14 g/mol (PubChem)</td></tr></table></body></html>"));
end Brimonidine;
