  annotation (Documentation(info = "<html><body><p>Acemetacin is a non-steroidal anti-inflammatory drug used to treat pain and inflammation in musculoskeletal and rheumatic conditions. It is an approved medicine, used mainly in some European countries, though it is not authorised across the whole European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2723146\">Wikidata Q2723146</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>acemetacin</td></tr><tr><td>ATC codes:</td><td>M01AB11</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13783\">DB13783</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/1981\">1981</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31162\">31162</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2723146\">Q2723146</a></td></tr><tr><td>formula:</td><td>C21H18ClNO6</td></tr><tr><td>molar mass:</td><td>415.826 g/mol (PubChem CID 1981)</td></tr><tr><td>logP:</td><td>4.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
