  annotation (Documentation(info = "<html><body><p>Dasabuvir is an antiviral medicine used to treat chronic hepatitis C infection. It has been an approved medicine and was included on the WHO essential medicines list, although its authorisation in the European Union has since been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q19462214&quot;>Wikidata Q19462214</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>dasabuvir</td></tr><tr><td>ATC codes:</td><td>J05AP09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09183&quot;>DB09183</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/56640146&quot;>56640146</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:85182&quot;>85182</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q19462214&quot;>Q19462214</a></td></tr><tr><td>formula:</td><td>C26H27N3O5S</td></tr><tr><td>molar mass:</td><td>493.578 g/mol (PubChem)</td></tr></table></body></html>"));
