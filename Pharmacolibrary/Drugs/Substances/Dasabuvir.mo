  annotation (Documentation(info = "<html><body><p>Dasabuvir is an antiviral medicine used to treat chronic hepatitis C infection. It has been an approved medicine and was included on the WHO essential medicines list, although its authorisation in the European Union has since been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q19462214\">Wikidata Q19462214</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>dasabuvir</td></tr><tr><td>ATC codes:</td><td>J05AP09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09183\">DB09183</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/56640146\">56640146</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:85182\">85182</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q19462214\">Q19462214</a></td></tr><tr><td>formula:</td><td>C26H27N3O5S</td></tr><tr><td>molar mass:</td><td>493.578 g/mol (PubChem CID 56640146)</td></tr><tr><td>logP:</td><td>4.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
