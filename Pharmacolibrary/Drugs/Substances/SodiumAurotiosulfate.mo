  annotation (Documentation(info = "<html><body><p>Sodium aurotiosulfate is a gold preparation used as a disease-modifying antirheumatic drug to treat rheumatic disease. It is an approved antirheumatic medicine, though gold-based treatments are now used only rarely in rheumatology.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27275512&quot;>Wikidata Q27275512</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sodium aurotiosulfate</td></tr><tr><td>ATC codes:</td><td>M01CB02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13743&quot;>DB13743</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27275512&quot;>Q27275512</a></td></tr><tr><td>formula:</td><td>AuH4Na3O8S4</td></tr><tr><td>molar mass:</td><td>526.2 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
