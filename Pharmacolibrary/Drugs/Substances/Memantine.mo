  annotation (Documentation(info = "<html><body><p>Memantine is an anti-dementia drug used to treat Alzheimer's disease and other forms of dementia, including vascular dementia. It is approved and widely used, with several products authorised in the European Union for Alzheimer's disease.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q412189\">Wikidata Q412189</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>memantine</td></tr><tr><td>ATC codes:</td><td>N06DX01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01043\">DB01043</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4054\">4054</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:64312\">64312</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q412189\">Q412189</a></td></tr><tr><td>formula:</td><td>C12H21N</td></tr><tr><td>molar mass:</td><td>179.307 g/mol (PubChem CID 4054)</td></tr><tr><td>logP:</td><td>3.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Memantine;
