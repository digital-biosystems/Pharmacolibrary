  annotation (Documentation(info = "<html><body><p>Ursodeoxycholic acid (ursodiol) is a bile acid used to treat primary biliary cholangitis and gallstone disease. It is an approved medicine, classified for bile therapy, and is widely used for these liver and gallbladder conditions.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q241374\">Wikidata Q241374</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ursodeoxycholic acid</td></tr><tr><td>ATC codes:</td><td>A05AA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01586\">DB01586</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/31401\">31401</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9907\">9907</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q241374\">Q241374</a></td></tr><tr><td>formula:</td><td>C24H40O4</td></tr><tr><td>molar mass:</td><td>392.58 g/mol (PubChem CID 31401)</td></tr><tr><td>logP:</td><td>4.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
