within Pharmacolibrary.Drugs.Substances;
package Hexaminolevulinate "hexaminolevulinate"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "hexaminolevulinate",
    atcCodes = {"V04CX06"},
    drugbankId = "DB06261",
    pubchemCid = "6433083",
    chebiId = "134892",
    wikidataId = "Q5749089",
