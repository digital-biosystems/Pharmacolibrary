    logP = 1.1);
  annotation (Documentation(info = "<html><body><p>Hexaminolevulinate is a diagnostic agent used to help detect bladder cancer during cystoscopy by making abnormal tissue glow under light. It is an approved medicine, used mainly in specialist urology settings for this diagnostic purpose.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5749089\">Wikidata Q5749089</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>hexaminolevulinate</td></tr><tr><td>ATC codes:</td><td>V04CX06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06261\">DB06261</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6433083\">6433083</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134892\">134892</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5749089\">Q5749089</a></td></tr><tr><td>formula:</td><td>C11H21NO3</td></tr><tr><td>molar mass:</td><td>215.293 g/mol (PubChem CID 6433083)</td></tr><tr><td>logP:</td><td>1.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Hexaminolevulinate;
