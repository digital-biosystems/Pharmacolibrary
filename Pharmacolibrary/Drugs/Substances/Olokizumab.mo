within Pharmacolibrary.Drugs.Substances;
package Olokizumab "olokizumab"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "olokizumab",
    atcCodes = {"L04AC23"},
    drugbankId = "DB13127",
    wikidataId = "Q7088501");
  annotation (Documentation(info = "<html><body><p>Olokizumab is an investigational monoclonal antibody that blocks interleukin signalling and has been studied as an immunosuppressive treatment. It is not an approved medicine and remains in the investigational stage.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7088501\">Wikidata Q7088501</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>olokizumab</td></tr><tr><td>ATC codes:</td><td>L04AC23</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13127\">DB13127</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7088501\">Q7088501</a></td></tr></table></body></html>"));
end Olokizumab;
