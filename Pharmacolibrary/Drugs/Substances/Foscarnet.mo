    logP = -2);
  annotation (Documentation(info = "<html><body><p>Foscarnet is an antiviral drug used to treat cytomegalovirus disease and herpes simplex infections, including genital herpes. It is an approved antiviral for systemic use, generally reserved for serious viral infections, often in hospital settings.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q420387&quot;>Wikidata Q420387</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>foscarnet</td></tr><tr><td>ATC codes:</td><td>J05AD01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00529&quot;>DB00529</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3415&quot;>3415</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:127780&quot;>127780</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q420387&quot;>Q420387</a></td></tr><tr><td>formula:</td><td>CH3O5P</td></tr><tr><td>molar mass:</td><td>126.004 g/mol (PubChem)</td></tr></table></body></html>"));
end Foscarnet;
