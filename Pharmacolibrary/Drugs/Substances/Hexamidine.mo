within Pharmacolibrary.Drugs.Substances;
package Hexamidine "hexamidine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "hexamidine",
    atcCodes = {"D08AC04", "R01AX07", "R02AA18", "S01AX08", "S03AA05"},
    drugbankId = "DB03808",
    pubchemCid = "65130",
    chebiId = "87184",
    wikidataId = "Q250360",
    formula = "C20H26N4O2",
    M = 0.354454,
    logP = 2.9);
  annotation (Documentation(info = "<html><body><p>Hexamidine is an anti-infective agent used as an antiseptic and disinfectant, for example on the skin, in nasal and throat preparations, and for eye infections. It is an approved drug, though not authorised by the European Medicines Agency, and appears to be used only in limited settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q250360\">Wikidata Q250360</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>hexamidine</td></tr><tr><td>ATC codes:</td><td>D08AC04, R01AX07, R02AA18, S01AX08, S03AA05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB03808\">DB03808</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/65130\">65130</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:87184\">87184</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q250360\">Q250360</a></td></tr><tr><td>formula:</td><td>C20H26N4O2</td></tr><tr><td>molar mass:</td><td>354.454 g/mol (PubChem CID 65130)</td></tr><tr><td>logP:</td><td>2.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Hexamidine;
