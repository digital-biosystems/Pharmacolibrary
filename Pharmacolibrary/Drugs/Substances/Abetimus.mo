  annotation (Documentation(info = "<html><body><p>Abetimus is an investigational immunosuppressant that was developed for the treatment of lupus nephritis. It was never marketed; a marketing application in the European Union was withdrawn, so it remains an investigational drug.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4667244&quot;>Wikidata Q4667244</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>abetimus</td></tr><tr><td>ATC codes:</td><td>L04AA22</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06662&quot;>DB06662</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4667244&quot;>Q4667244</a></td></tr></table></body></html>"));
end Abetimus;
