  annotation (Documentation(info = "<html><body><p>Inositol nicotinate is a vasodilator of the nicotinic acid group, once used to improve peripheral blood flow. It has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6036641\">Wikidata Q6036641</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>inositol nicotinate</td></tr><tr><td>ATC codes:</td><td>C04AC03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08949\">DB08949</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3720\">3720</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31699\">31699</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6036641\">Q6036641</a></td></tr><tr><td>formula:</td><td>C42H30N6O12</td></tr><tr><td>molar mass:</td><td>810.732 g/mol (PubChem CID 3720)</td></tr><tr><td>logP:</td><td>3.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
