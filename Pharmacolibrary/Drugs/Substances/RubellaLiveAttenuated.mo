  annotation (Documentation(info = "<html><body><p>This live attenuated rubella vaccine is used to prevent rubella infection. It is an approved vaccine, given alone or in combination with other viral vaccines such as measles vaccines.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>rubella, live attenuated</td></tr><tr><td>ATC codes:</td><td>J07BJ01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB10317\">DB10317</a></td></tr></table></body></html>"));
end RubellaLiveAttenuated;
