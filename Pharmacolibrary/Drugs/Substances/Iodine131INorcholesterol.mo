  annotation (Documentation(info = "<html><body><p>Iodine-131 labelled norcholesterol is a diagnostic radiopharmaceutical used to image the adrenal glands. It is classed as investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27116313\">Wikidata Q27116313</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>iodine (131I) norcholesterol</td></tr><tr><td>ATC codes:</td><td>V09XA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13487\">DB13487</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:34893\">34893</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27116313\">Q27116313</a></td></tr><tr><td>formula:</td><td>C27H45IO</td></tr><tr><td>molar mass:</td><td>516.562 g/mol (knowledgebase (DrugBank calculated))</td></tr><tr><td>logP:</td><td>8.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
