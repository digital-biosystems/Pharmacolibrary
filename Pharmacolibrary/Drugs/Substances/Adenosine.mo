within Pharmacolibrary.Drugs.Substances;
package Adenosine "adenosine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "adenosine",
    atcCodes = {"C01EB10"},
    drugbankId = "DB00640",
    pubchemCid = "60961",
    chebiId = "16335",
    wikidataId = "Q190012",
    formula = "C10H13N5O4",
    M = 0.267245,
    logP = -1.1);
  annotation (Documentation(info = "<html><body><p>Adenosine is a cardiac drug used to treat certain rapid heart rhythm problems, including paroxysmal tachycardia and Wolff–Parkinson–White syndrome. It is an approved medicine, given by injection mainly in hospital settings to quickly restore a normal heart rhythm.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q190012\">Wikidata Q190012</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>adenosine</td></tr><tr><td>ATC codes:</td><td>C01EB10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00640\">DB00640</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/60961\">60961</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:16335\">16335</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q190012\">Q190012</a></td></tr><tr><td>formula:</td><td>C10H13N5O4</td></tr><tr><td>molar mass:</td><td>267.245 g/mol (PubChem CID 60961)</td></tr><tr><td>logP:</td><td>-1.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Adenosine;
