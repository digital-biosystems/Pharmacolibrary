    drugbankId = "DB06773",
    M = 3.4179);
  annotation (Documentation(info = "<html><body><p>Synthetic human calcitonin is a hormone preparation used to lower blood calcium, for example in conditions of excessive calcium or bone breakdown. It is an approved medicine, though it appears to be little used compared with other calcitonin preparations.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>calcitonin (human synthetic)</td></tr><tr><td>ATC codes:</td><td>H05BA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06773\">DB06773</a></td></tr><tr><td>molar mass:</td><td>3417.9 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end CalcitoninHumanSynthetic;
