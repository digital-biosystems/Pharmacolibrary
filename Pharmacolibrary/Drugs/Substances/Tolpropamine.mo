  annotation (Documentation(info = "<html><body><p>Tolpropamine is an antihistamine used topically on the skin to relieve itching. It is not an approved medicine today and is regarded as experimental, with no authorisation from the European Medicines Agency.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7814615&quot;>Wikidata Q7814615</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tolpropamine</td></tr><tr><td>ATC codes:</td><td>D04AA12</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13305&quot;>DB13305</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/72141&quot;>72141</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135035&quot;>135035</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7814615&quot;>Q7814615</a></td></tr><tr><td>formula:</td><td>C18H23N</td></tr><tr><td>molar mass:</td><td>253.389 g/mol (PubChem)</td></tr></table></body></html>"));
