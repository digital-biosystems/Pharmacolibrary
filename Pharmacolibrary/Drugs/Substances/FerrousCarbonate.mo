  annotation (Documentation(info = "<html><body><p>Ferrous carbonate is an oral iron(II) preparation classified as an antianemic, used to treat iron deficiency anaemia. It is currently regarded as an experimental agent and does not appear to be an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4214595&quot;>Wikidata Q4214595</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ferrous carbonate</td></tr><tr><td>ATC codes:</td><td>B03AA04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13698&quot;>DB13698</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:86235&quot;>86235</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4214595&quot;>Q4214595</a></td></tr><tr><td>formula:</td><td>CFeO3</td></tr><tr><td>molar mass:</td><td>115.854 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
