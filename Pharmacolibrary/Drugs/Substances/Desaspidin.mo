  annotation (Documentation(info = "<html><body><p>Desaspidin is an anticestodal drug, meaning it was used to treat tapeworm infections. It is no longer in practical use and is regarded today as an experimental compound.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q904668&quot;>Wikidata Q904668</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>desaspidin</td></tr><tr><td>ATC codes:</td><td>P02DX01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13567&quot;>DB13567</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/8238&quot;>8238</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135960&quot;>135960</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q904668&quot;>Q904668</a></td></tr><tr><td>formula:</td><td>C24H30O8</td></tr><tr><td>molar mass:</td><td>446.496 g/mol (PubChem)</td></tr></table></body></html>"));
end Desaspidin;
