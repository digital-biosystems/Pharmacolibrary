  annotation (Documentation(info = "<html><body><p>Glasdegib is a hedgehog pathway inhibitor used to treat acute myeloid leukemia. It is an approved medicine, authorised in the European Union, and also remains under investigation for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27077810&quot;>Wikidata Q27077810</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>glasdegib</td></tr><tr><td>ATC codes:</td><td>L01XJ03, L01XX63</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11978&quot;>DB11978</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/25166913&quot;>25166913</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:145428&quot;>145428</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27077810&quot;>Q27077810</a></td></tr><tr><td>formula:</td><td>C21H22N6O</td></tr><tr><td>molar mass:</td><td>374.448 g/mol (PubChem)</td></tr></table></body></html>"));
