  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "chloral hydrate",
    atcCodes = {"N05CC01"},
    drugbankId = "DB01563",
    pubchemCid = "2707",
    chebiId = "28142",
    wikidataId = "Q412340",
