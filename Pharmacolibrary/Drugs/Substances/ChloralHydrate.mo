    logP = 1);
  annotation (Documentation(info = "<html><body><p>Chloral hydrate is a sedative-hypnotic drug that has been used to treat agitation in dementia and to induce sleep. It remains an approved medicine, is also approved for veterinary use, and is sometimes misused as an illicit drug.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q412340\">Wikidata Q412340</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>chloral hydrate</td></tr><tr><td>ATC codes:</td><td>N05CC01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01563\">DB01563</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2707\">2707</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:28142\">28142</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q412340\">Q412340</a></td></tr><tr><td>formula:</td><td>C2H3Cl3O2</td></tr><tr><td>molar mass:</td><td>165.394 g/mol (PubChem CID 2707)</td></tr><tr><td>logP:</td><td>1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end ChloralHydrate;
