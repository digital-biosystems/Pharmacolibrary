    logP = -1.6);
  annotation (Documentation(info = "<html><body><p>Ascorbic acid (vitamin C) is a vitamin used to treat or prevent vitamin C deficiency and is also used as a dietary supplement. It is widely used worldwide, available as a plain vitamin product and in combinations, and also appears in gynecological and ophthalmological preparations.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q193598&quot;>Wikidata Q193598</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ascorbic acid</td></tr><tr><td>ATC codes:</td><td>A11GA01, G01AD03, S01XA15</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00126&quot;>DB00126</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/54670067&quot;>54670067</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:29073&quot;>29073</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q193598&quot;>Q193598</a></td></tr><tr><td>formula:</td><td>C6H8O6</td></tr><tr><td>molar mass:</td><td>176.124 g/mol (PubChem)</td></tr></table></body></html>"));
