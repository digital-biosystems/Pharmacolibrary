    logP = -1.6);
  annotation (Documentation(info = "<html><body><p>Ascorbic acid, better known as vitamin C, is a water-soluble vitamin and antioxidant that the body needs to make collagen and support the immune system. It is widely used as a dietary supplement and approved medicine, and is also applied in gynecological and eye preparations.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q199678\">Wikidata Q199678</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ascorbic acid</td></tr><tr><td>ATC codes:</td><td>A11GA01, G01AD03, S01XA15</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00126\">DB00126</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/54670067\">54670067</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:29073\">29073</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q199678\">Q199678</a></td></tr><tr><td>formula:</td><td>C6H8O6</td></tr><tr><td>molar mass:</td><td>176.124 g/mol (PubChem CID 54670067)</td></tr><tr><td>logP:</td><td>-1.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end AscorbicAcid;
