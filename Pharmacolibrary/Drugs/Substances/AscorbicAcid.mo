  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "ascorbic acid",
    atcCodes = {"A11GA01", "G01AD03", "S01XA15"},
    drugbankId = "DB00126",
    pubchemCid = "54670067",
    chebiId = "29073",
    wikidataId = "Q199678",
