  annotation (Documentation(info = "<html><body><p>Crizotinib is an ALK inhibitor anticancer drug used to treat non-small-cell lung carcinoma and other tumours such as inflammatory myofibroblastic tumour. It is authorised in the European Union and is an approved medicine, used mainly in oncology care.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5186964&quot;>Wikidata Q5186964</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>crizotinib</td></tr><tr><td>ATC codes:</td><td>L01ED01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08865&quot;>DB08865</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/11626560&quot;>11626560</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:64310&quot;>64310</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5186964&quot;>Q5186964</a></td></tr><tr><td>formula:</td><td>C21H22Cl2FN5O</td></tr><tr><td>molar mass:</td><td>450.339 g/mol (PubChem)</td></tr></table></body></html>"));
