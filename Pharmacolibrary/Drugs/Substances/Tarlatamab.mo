  annotation (Documentation(info = "<html><body><p>Tarlatamab is a bispecific monoclonal antibody used to treat small cell lung cancer. It is an approved anticancer medicine and is authorised in the European Union, with further uses still under investigation.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>tarlatamab</td></tr><tr><td>ATC codes:</td><td>L01FX33</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB17256\">DB17256</a></td></tr></table></body></html>"));
