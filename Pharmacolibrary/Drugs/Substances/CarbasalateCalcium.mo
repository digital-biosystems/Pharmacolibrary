    formula = "C10H12N2O5",
    M = 0.240215);
  annotation (Documentation(info = "<html><body><p>Carbasalate calcium is a salicylate derivative related to aspirin, classified as a non-steroidal anti-inflammatory drug with antithrombotic (antiplatelet) and analgesic/antipyretic uses. It is considered investigational and does not appear to be an approved medicine in major databases such as the EMA.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2203957\">Wikidata Q2203957</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>carbasalate calcium</td></tr><tr><td>ATC codes:</td><td>B01AC08, N02BA15</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13612\">DB13612</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/162666\">162666</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2203957\">Q2203957</a></td></tr><tr><td>formula:</td><td>C10H12N2O5</td></tr><tr><td>molar mass:</td><td>240.215 g/mol (PubChem CID 162666)</td></tr></table><p><small>Drugs.Common 25.09 gave 458.4 g/mol (+90.8 %); replaced by the value above</small></p></body></html>"));
end CarbasalateCalcium;
