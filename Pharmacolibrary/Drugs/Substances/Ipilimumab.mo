  annotation (Documentation(info = "<html><body><p>Ipilimumab is a monoclonal antibody used to treat several cancers, including melanoma, renal cell carcinoma, non-small-cell lung cancer, mesothelioma, and colorectal cancer. It is approved and authorised in the European Union, where it is used in the treatment of these cancers.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2459042&quot;>Wikidata Q2459042</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>ipilimumab</td></tr><tr><td>ATC codes:</td><td>L01FX04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06186&quot;>DB06186</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2459042&quot;>Q2459042</a></td></tr><tr><td>molar mass:</td><td>148000 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
