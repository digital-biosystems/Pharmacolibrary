  annotation (Documentation(info = "<html><body><p>Benzoyl peroxide is a topical skin medicine used to treat acne and rosacea. It is widely used, appears on the WHO list of essential medicines, and is approved, though also being studied for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q411424&quot;>Wikidata Q411424</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>benzoyl peroxide</td></tr><tr><td>ATC codes:</td><td>D10AE01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09096&quot;>DB09096</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/7187&quot;>7187</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:82405&quot;>82405</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q411424&quot;>Q411424</a></td></tr><tr><td>formula:</td><td>C14H10O4</td></tr><tr><td>molar mass:</td><td>242.23 g/mol (PubChem)</td></tr></table></body></html>"));
