  annotation (Documentation(info = "<html><body><p>Nifedipine is a calcium channel blocker used to treat high blood pressure and angina. It is widely used and appears on the WHO list of essential medicines, and is also being investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q39111&quot;>Wikidata Q39111</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nifedipine</td></tr><tr><td>ATC codes:</td><td>C08CA05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01115&quot;>DB01115</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4485&quot;>4485</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7565&quot;>7565</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q39111&quot;>Q39111</a></td></tr><tr><td>formula:</td><td>C17H18N2O6</td></tr><tr><td>molar mass:</td><td>346.339 g/mol (PubChem)</td></tr></table></body></html>"));
