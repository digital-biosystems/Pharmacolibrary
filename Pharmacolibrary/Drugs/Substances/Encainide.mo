    logP = 4.3);
  annotation (Documentation(info = "<html><body><p>Encainide is a class Ic antiarrhythmic that was used to treat heart rhythm disorders (arrhythmias). It has been withdrawn from the market after studies showed it could increase the risk of death in patients with certain heart arrhythmias.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q514534\">Wikidata Q514534</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>encainide</td></tr><tr><td>ATC codes:</td><td>C01BC08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01228\">DB01228</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/48041\">48041</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4788\">4788</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q514534\">Q514534</a></td></tr><tr><td>formula:</td><td>C22H28N2O2</td></tr><tr><td>molar mass:</td><td>352.478 g/mol (PubChem CID 48041)</td></tr><tr><td>logP:</td><td>4.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Encainide;
