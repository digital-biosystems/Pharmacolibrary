  annotation (Documentation(info = "<html><body><p>Dantron is an anthraquinone contact laxative that was used to treat constipation. It has been withdrawn in some countries because it is considered a carcinogen and mutagen, though it remains approved in some settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5221244\">Wikidata Q5221244</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dantron</td></tr><tr><td>ATC codes:</td><td>A06AB03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB04816\">DB04816</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2950\">2950</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3682\">3682</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5221244\">Q5221244</a></td></tr><tr><td>formula:</td><td>C14H8O4</td></tr><tr><td>molar mass:</td><td>240.214 g/mol (PubChem CID 2950)</td></tr><tr><td>logP:</td><td>3.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Dantron;
