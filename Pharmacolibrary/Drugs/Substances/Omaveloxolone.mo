  annotation (Documentation(info = "<html><body><p>Omaveloxolone is a medicine used to treat Friedreich ataxia, a rare inherited neurological disorder. It is authorised in the European Union and is also being studied for other uses; it is a niche treatment for a rare disease rather than a widely used drug.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q21098900\">Wikidata Q21098900</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>omaveloxolone</td></tr><tr><td>ATC codes:</td><td>N07XX25</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12513\">DB12513</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/71811910\">71811910</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q21098900\">Q21098900</a></td></tr><tr><td>formula:</td><td>C33H44F2N2O3</td></tr><tr><td>molar mass:</td><td>554.722 g/mol (PubChem CID 71811910)</td></tr></table></body></html>"));
