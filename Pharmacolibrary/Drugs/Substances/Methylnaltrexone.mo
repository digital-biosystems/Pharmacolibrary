  annotation (Documentation(info = "<html><body><p>Methylnaltrexone is a peripheral opioid receptor antagonist used to treat constipation, particularly opioid-induced constipation. It is an approved medicine and has also been investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q59904170\">Wikidata Q59904170</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Methylnaltrexone</td></tr><tr><td>ATC codes:</td><td>A06AH01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06800\">DB06800</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5361918\">5361918</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q59904170\">Q59904170</a></td></tr><tr><td>formula:</td><td>C21H26NO4+</td></tr><tr><td>molar mass:</td><td>356.442 g/mol (PubChem CID 5361918)</td></tr></table></body></html>"));
