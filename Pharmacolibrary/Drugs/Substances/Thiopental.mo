  annotation (Documentation(info = "<html><body><p>Thiopental is a barbiturate used as a general anesthetic and also as a hypnotic and sedative. It is an approved drug, also approved for veterinary use, though some products have been withdrawn in places.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q55186498\">Wikidata Q55186498</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>thiopental</td></tr><tr><td>ATC codes:</td><td>N01AF03, N05CA19</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00599\">DB00599</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3000715\">3000715</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:102166\">102166</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q55186498\">Q55186498</a></td></tr><tr><td>formula:</td><td>C11H18N2O2S</td></tr><tr><td>molar mass:</td><td>242.337 g/mol (PubChem CID 3000715)</td></tr><tr><td>logP:</td><td>2.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
