  annotation (Documentation(info = "<html><body><p>Dimercaprol is a chelating agent used as an antidote, including for lead poisoning. It is an approved medicine and appears on the WHO essential medicines list, so it remains in use, though it is not authorised by the European Medicines Agency.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q413968&quot;>Wikidata Q413968</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dimercaprol</td></tr><tr><td>ATC codes:</td><td>V03AB09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06782&quot;>DB06782</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3080&quot;>3080</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:64198&quot;>64198</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q413968&quot;>Q413968</a></td></tr><tr><td>formula:</td><td>C3H8OS2</td></tr><tr><td>molar mass:</td><td>124.216 g/mol (PubChem)</td></tr></table></body></html>"));
