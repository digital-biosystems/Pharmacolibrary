  annotation (Documentation(info = "<html><body><p>Fingolimod is an immunosuppressant used to treat multiple sclerosis, including relapsing-remitting forms. It is authorised in the European Union and widely used as a treatment for multiple sclerosis.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q425137&quot;>Wikidata Q425137</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>fingolimod</td></tr><tr><td>ATC codes:</td><td>L04AA27, L04AE01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08868&quot;>DB08868</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/107970&quot;>107970</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:63115&quot;>63115</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q425137&quot;>Q425137</a></td></tr><tr><td>formula:</td><td>C19H33NO2</td></tr><tr><td>molar mass:</td><td>307.478 g/mol (PubChem)</td></tr></table></body></html>"));
