  annotation (Documentation(info = "<html><body><p>Bismuth subnitrate is a bismuth compound that was used as an antacid and anti-ulcer medicine for acid-related stomach disorders such as peptic ulcer and reflux disease. It is no longer in use, as it is listed as a withdrawn drug.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q126605705\">Wikidata Q126605705</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bismuth subnitrate</td></tr><tr><td>ATC codes:</td><td>A02BX12</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13209\">DB13209</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31293\">31293</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q126605705\">Q126605705</a></td></tr><tr><td>formula:</td><td>Bi5H9N4O22</td></tr><tr><td>molar mass:</td><td>1461.98 g/mol (knowledgebase (DrugBank calculated))</td></tr></table></body></html>"));
