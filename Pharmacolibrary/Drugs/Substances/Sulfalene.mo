  annotation (Documentation(info = "<html><body><p>Sulfalene is a long-acting sulfonamide antibiotic that was used as an anti-infective, including for urinary infections and malaria. It has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6577302&quot;>Wikidata Q6577302</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sulfalene</td></tr><tr><td>ATC codes:</td><td>J01ED02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00664&quot;>DB00664</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/9047&quot;>9047</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6577302&quot;>Q6577302</a></td></tr><tr><td>formula:</td><td>C11H12N4O3S</td></tr><tr><td>molar mass:</td><td>280.302 g/mol (PubChem)</td></tr></table></body></html>"));
