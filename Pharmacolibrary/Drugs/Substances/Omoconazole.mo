  annotation (Documentation(info = "<html><body><p>Omoconazole is an imidazole antifungal used topically against fungal skin infections and, in gynaecological formulations, vaginal fungal infections. It appears only as an experimental drug and is not an established marketed medicine; its current availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3882290&quot;>Wikidata Q3882290</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>omoconazole</td></tr><tr><td>ATC codes:</td><td>D01AC13, G01AF16</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13684&quot;>DB13684</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3033988&quot;>3033988</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135685&quot;>135685</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3882290&quot;>Q3882290</a></td></tr><tr><td>formula:</td><td>C20H17Cl3N2O2</td></tr><tr><td>molar mass:</td><td>423.718 g/mol (PubChem)</td></tr></table></body></html>"));
end Omoconazole;
