  annotation (Documentation(info = "<html><body><p>Acefylline is a xanthine that has been used as a systemic drug for obstructive airway diseases such as asthma. It is considered experimental and does not appear to be an approved medicine today.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27251411\">Wikidata Q27251411</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Acefylline</td></tr><tr><td>ATC codes:</td><td>R03DA09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13573\">DB13573</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/69550\">69550</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27251411\">Q27251411</a></td></tr><tr><td>formula:</td><td>C9H10N4O4</td></tr><tr><td>molar mass:</td><td>238.203 g/mol (PubChem CID 69550)</td></tr></table></body></html>"));
end Acefylline;
