  annotation (Documentation(info = "<html><body><p>Donanemab is a monoclonal antibody used to treat Alzheimer's disease. It is an approved anti-dementia medicine and has been authorised in the European Union.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>donanemab</td></tr><tr><td>ATC codes:</td><td>N06DX05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB16647&quot;>DB16647</a></td></tr><tr><td>molar mass:</td><td>145000 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
