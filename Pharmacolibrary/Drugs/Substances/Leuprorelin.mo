  annotation (Documentation(info = "<html><body><p>Leuprorelin is a hormone analogue used to treat hormone-related conditions such as prostate cancer, breast cancer, endometriosis, precocious puberty, and infertility. It is widely used, appears on the WHO essential medicines list, and is authorised in the European Union mainly for prostate cancer.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q907160\">Wikidata Q907160</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>leuprorelin</td></tr><tr><td>ATC codes:</td><td>L02AE02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00007\">DB00007</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6427\">6427</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q907160\">Q907160</a></td></tr><tr><td>molar mass:</td><td>1209.4 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>0.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
