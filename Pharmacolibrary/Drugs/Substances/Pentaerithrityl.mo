  annotation (Documentation(info = "<html><body><p>Pentaerithrityl (pentaerythritol) is a polyol chemical compound classified as an osmotically acting laxative for constipation. It is not an established marketed medicine; databases list it as investigational, and no EU authorisation is recorded.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q421828&quot;>Wikidata Q421828</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pentaerithrityl</td></tr><tr><td>ATC codes:</td><td>A06AD14</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13526&quot;>DB13526</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/8285&quot;>8285</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134760&quot;>134760</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q421828&quot;>Q421828</a></td></tr><tr><td>formula:</td><td>C5H12O4</td></tr><tr><td>molar mass:</td><td>136.147 g/mol (PubChem)</td></tr></table></body></html>"));
