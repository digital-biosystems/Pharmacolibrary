  annotation (Documentation(info = "<html><body><p>Lesinurad was a uricosuric drug used to treat gout and high uric acid levels in the blood. It has been withdrawn from the market, including in the European Union, and is no longer available.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q21820633\">Wikidata Q21820633</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>lesinurad</td></tr><tr><td>ATC codes:</td><td>M04AB05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11560\">DB11560</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/53465279\">53465279</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:90929\">90929</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q21820633\">Q21820633</a></td></tr><tr><td>formula:</td><td>C17H14BrN3O2S</td></tr><tr><td>molar mass:</td><td>404.282 g/mol (PubChem CID 53465279)</td></tr><tr><td>logP:</td><td>4.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
