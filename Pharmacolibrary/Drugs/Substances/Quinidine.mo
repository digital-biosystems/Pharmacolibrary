  annotation (Documentation(info = "<html><body><p>Quinidine is a class Ia antiarrhythmic used to treat heart rhythm problems such as atrial fibrillation. It is an approved medicine, though it is not widely used today and has largely been replaced by newer antiarrhythmic drugs.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q412496&quot;>Wikidata Q412496</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>quinidine</td></tr><tr><td>ATC codes:</td><td>C01BA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00908&quot;>DB00908</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/441074&quot;>441074</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:28593&quot;>28593</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q412496&quot;>Q412496</a></td></tr><tr><td>formula:</td><td>C20H24N2O2</td></tr><tr><td>molar mass:</td><td>324.424 g/mol (PubChem)</td></tr></table></body></html>"));
