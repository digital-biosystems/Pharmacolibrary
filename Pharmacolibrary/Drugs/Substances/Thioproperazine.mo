  annotation (Documentation(info = "<html><body><p>Thioproperazine is a phenothiazine antipsychotic used to treat psychotic disorders such as schizophrenia. It is an approved medicine, but appears to be little used today and is not authorised across the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2622839&quot;>Wikidata Q2622839</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>thioproperazine</td></tr><tr><td>ATC codes:</td><td>N05AB08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01622&quot;>DB01622</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/9429&quot;>9429</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:59120&quot;>59120</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2622839&quot;>Q2622839</a></td></tr><tr><td>formula:</td><td>C22H30N4O2S2</td></tr><tr><td>molar mass:</td><td>446.628 g/mol (PubChem)</td></tr></table></body></html>"));
