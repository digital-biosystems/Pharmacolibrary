  annotation (Documentation(info = "<html><body><p>Zuclopenthixol is an antipsychotic of the thioxanthene class used to treat psychotic disorders such as schizophrenia. It is an approved medicine and remains in clinical use, though it is not authorised centrally in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q228143\">Wikidata Q228143</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>zuclopenthixol</td></tr><tr><td>ATC codes:</td><td>N05AF05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01624\">DB01624</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5311507\">5311507</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:51364\">51364</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q228143\">Q228143</a></td></tr><tr><td>formula:</td><td>C22H25ClN2OS</td></tr><tr><td>molar mass:</td><td>400.965 g/mol (PubChem CID 5311507)</td></tr><tr><td>logP:</td><td>4.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
