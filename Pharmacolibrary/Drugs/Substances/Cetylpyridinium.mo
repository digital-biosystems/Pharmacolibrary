    logP = 8.7);
  annotation (Documentation(info = "<html><body><p>Cetylpyridinium is an antiseptic used to treat or prevent infections in the mouth and throat, and for disinfecting skin and wounds. It is widely used in over-the-counter oral care products such as mouthwashes and throat lozenges.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27115152&quot;>Wikidata Q27115152</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cetylpyridinium</td></tr><tr><td>ATC codes:</td><td>B05CA01, D08AJ03, D09AA07, R02AA06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11073&quot;>DB11073</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2683&quot;>2683</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32914&quot;>32914</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27115152&quot;>Q27115152</a></td></tr><tr><td>formula:</td><td>C21H38N+</td></tr><tr><td>molar mass:</td><td>304.542 g/mol (PubChem)</td></tr></table></body></html>"));
end Cetylpyridinium;
