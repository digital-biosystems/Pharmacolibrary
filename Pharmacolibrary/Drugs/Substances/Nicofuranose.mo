  annotation (Documentation(info = "<html><body><p>Nicofuranose is a nicotinic acid derivative that has been used as a vasodilator and lipid-modifying agent. It is considered experimental and does not appear to be an approved medicine today.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3295509&quot;>Wikidata Q3295509</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nicofuranose</td></tr><tr><td>ATC codes:</td><td>C10AD03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13422&quot;>DB13422</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/25495&quot;>25495</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135846&quot;>135846</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3295509&quot;>Q3295509</a></td></tr><tr><td>formula:</td><td>C30H24N4O10</td></tr><tr><td>molar mass:</td><td>600.54 g/mol (PubChem)</td></tr></table></body></html>"));
end Nicofuranose;
