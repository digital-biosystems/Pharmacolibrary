  annotation (Documentation(info = "<html><body><p>Etidocaine is a local anesthetic of the amide type used to relieve pain by numbing a specific area of the body. It is an approved drug, though it is not widely used today and has largely been replaced by other local anesthetics.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q304782&quot;>Wikidata Q304782</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>etidocaine</td></tr><tr><td>ATC codes:</td><td>N01BB07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08987&quot;>DB08987</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/37497&quot;>37497</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4904&quot;>4904</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q304782&quot;>Q304782</a></td></tr><tr><td>formula:</td><td>C17H28N2O</td></tr><tr><td>molar mass:</td><td>276.424 g/mol (PubChem)</td></tr></table></body></html>"));
