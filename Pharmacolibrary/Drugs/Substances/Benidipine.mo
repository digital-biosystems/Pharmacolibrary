  annotation (Documentation(info = "<html><body><p>Benidipine is a dihydropyridine calcium channel blocker developed for cardiovascular conditions such as high blood pressure. It is considered investigational and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q11336997&quot;>Wikidata Q11336997</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>benidipine</td></tr><tr><td>ATC codes:</td><td>C08CA15</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09231&quot;>DB09231</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/656668&quot;>656668</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q11336997&quot;>Q11336997</a></td></tr><tr><td>formula:</td><td>C28H31N3O6</td></tr><tr><td>molar mass:</td><td>505.571 g/mol (PubChem)</td></tr></table></body></html>"));
