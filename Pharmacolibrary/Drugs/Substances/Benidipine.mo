  annotation (Documentation(info = "<html><body><p>Benidipine is a dihydropyridine calcium channel blocker developed for treating high blood pressure and related cardiovascular conditions. It is not approved in the European Union and remains investigational in major drug databases, with use limited to certain Asian markets.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q113514884\">Wikidata Q113514884</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>benidipine</td></tr><tr><td>ATC codes:</td><td>C08CA15</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09231\">DB09231</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/656668\">656668</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q113514884\">Q113514884</a></td></tr><tr><td>formula:</td><td>C28H31N3O6</td></tr><tr><td>molar mass:</td><td>505.571 g/mol (PubChem CID 656668)</td></tr><tr><td>logP:</td><td>4.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Benidipine;
