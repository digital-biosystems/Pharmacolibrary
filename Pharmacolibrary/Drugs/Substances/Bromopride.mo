  annotation (Documentation(info = "<html><body><p>Bromopride is a dopamine antagonist antiemetic and propulsive drug used to treat indigestion and other functional gastrointestinal problems. It is not approved in major markets such as the European Union or the United States and is considered investigational, though it has been used in some countries, mainly in Latin America.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1958189\">Wikidata Q1958189</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bromopride</td></tr><tr><td>ATC codes:</td><td>A03FA04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09018\">DB09018</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2446\">2446</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:95304\">95304</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1958189\">Q1958189</a></td></tr><tr><td>formula:</td><td>C14H22BrN3O2</td></tr><tr><td>molar mass:</td><td>344.253 g/mol (PubChem CID 2446)</td></tr><tr><td>logP:</td><td>2.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
