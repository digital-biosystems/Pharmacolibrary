within Pharmacolibrary.Drugs.Substances;
package LiquidParaffin "liquid paraffin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "liquid paraffin",
    atcCodes = {"A06AA01"},
    drugbankId = "DB11057",
    wikidataId = "Q6557471");
  annotation (Documentation(info = "<html><body><p>Liquid paraffin, a mineral oil, is used as a laxative to treat constipation and also serves as an excipient in cosmetics and medicines. It remains in use, is approved for human and veterinary use, and is widely available as a mild treatment for constipation.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6557471\">Wikidata Q6557471</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>liquid paraffin</td></tr><tr><td>ATC codes:</td><td>A06AA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11057\">DB11057</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6557471\">Q6557471</a></td></tr></table></body></html>"));
end LiquidParaffin;
