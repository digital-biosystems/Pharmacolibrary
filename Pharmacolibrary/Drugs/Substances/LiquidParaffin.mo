  annotation (Documentation(info = "<html><body><p>Liquid paraffin (mineral oil) is a lubricant laxative used to treat constipation. It is an approved medicine and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q72492483&quot;>Wikidata Q72492483</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>liquid paraffin</td></tr><tr><td>ATC codes:</td><td>A06AA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11057&quot;>DB11057</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q72492483&quot;>Q72492483</a></td></tr></table></body></html>"));
end LiquidParaffin;
