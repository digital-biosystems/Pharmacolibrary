  annotation (Documentation(info = "<html><body><p>Efepoetin alfa is an investigational long-acting erythropoiesis-stimulating fusion protein being studied as a treatment for anaemia. It is not yet approved; it remains in clinical development and is not authorised for routine use.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>efepoetin alfa</td></tr><tr><td>ATC codes:</td><td>B03XA10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB19197\">DB19197</a></td></tr></table></body></html>"));
