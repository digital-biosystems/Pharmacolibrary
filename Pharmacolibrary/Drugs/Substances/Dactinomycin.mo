    logP = 3.8);
  annotation (Documentation(info = "<html><body><p>Dactinomycin is a cytotoxic antibiotic used to treat various cancers, including melanoma, testicular cancer, neuroblastoma, rhabdomyosarcoma, Ewing sarcoma, choriocarcinoma, and retinoblastoma. It remains an approved medicine and is included on the WHO list of essential medicines, so it is still in clinical use worldwide.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q186127&quot;>Wikidata Q186127</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dactinomycin</td></tr><tr><td>ATC codes:</td><td>L01DA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00970&quot;>DB00970</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/457193&quot;>457193</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:27666&quot;>27666</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q186127&quot;>Q186127</a></td></tr><tr><td>formula:</td><td>C62H86N12O16</td></tr><tr><td>molar mass:</td><td>1255.44 g/mol (PubChem)</td></tr></table></body></html>"));
end Dactinomycin;
