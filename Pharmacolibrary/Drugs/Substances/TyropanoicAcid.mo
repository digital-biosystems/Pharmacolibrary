    logP = 4.6);
  annotation (Documentation(info = "<html><body><p>Tyropanoic acid is an iodinated, water-soluble, liver-targeted X-ray contrast agent used in imaging of the hepatobiliary system. It is an approved contrast medium, though it does not appear to be authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6587055&quot;>Wikidata Q6587055</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tyropanoic acid</td></tr><tr><td>ATC codes:</td><td>V08AC09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09340&quot;>DB09340</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5611&quot;>5611</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135862&quot;>135862</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6587055&quot;>Q6587055</a></td></tr><tr><td>formula:</td><td>C15H18I3NO3</td></tr><tr><td>molar mass:</td><td>641.013 g/mol (PubChem)</td></tr></table></body></html>"));
