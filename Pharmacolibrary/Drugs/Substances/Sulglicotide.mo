  annotation (Documentation(info = "<html><body><p>Sulglicotide is an anti-ulcer drug, used for peptic ulcer and other acid-related stomach disorders. It is not an approved medicine today and appears only as an experimental compound, so its current availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7636239\">Wikidata Q7636239</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sulglicotide</td></tr><tr><td>ATC codes:</td><td>A02BX08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13299\">DB13299</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7636239\">Q7636239</a></td></tr></table></body></html>"));
end Sulglicotide;
