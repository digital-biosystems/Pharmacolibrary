    logP = 3.1);
  annotation (Documentation(info = "<html><body><p>Cyproterone acetate is an antiandrogen used to treat prostate cancer and, in combination with estrogens, for other androgen-related conditions. It is an approved medicine, available in formulations both as a plain antiandrogen and combined with estrogens.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q426185&quot;>Wikidata Q426185</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cyproterone</td></tr><tr><td>ATC codes:</td><td>G03HA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB04839&quot;>DB04839</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/9880&quot;>9880</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:50743&quot;>50743</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q426185&quot;>Q426185</a></td></tr><tr><td>formula:</td><td>C24H29ClO4</td></tr><tr><td>molar mass:</td><td>416.942 g/mol (PubChem)</td></tr></table></body></html>"));
