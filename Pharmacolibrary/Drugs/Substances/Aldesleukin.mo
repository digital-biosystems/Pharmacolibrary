  annotation (Documentation(info = "<html><body><p>Aldesleukin, a form of interleukin-2, is an immunostimulant used to treat cancers such as melanoma and kidney-related malignancies, and has also been studied for other conditions including HIV infection. It is an approved medicine, mainly used in specialist cancer care, and carries a boxed warning reflecting its significant toxicity.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q20801763&quot;>Wikidata Q20801763</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>aldesleukin</td></tr><tr><td>ATC codes:</td><td>L03AC01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00041&quot;>DB00041</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q20801763&quot;>Q20801763</a></td></tr><tr><td>molar mass:</td><td>15314.8 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Aldesleukin;
