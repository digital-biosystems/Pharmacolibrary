  annotation (Documentation(info = "<html><body><p>Rose bengal is a colouring agent used as an ophthalmological diagnostic agent to stain damaged cells on the eye surface. It is an approved diagnostic dye used in eye examinations, and has also been investigated for other uses.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Rose bengal</td></tr><tr><td>ATC codes:</td><td>S01JA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11182&quot;>DB11182</a></td></tr><tr><td>molar mass:</td><td>1017.6 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end RoseBengal;
