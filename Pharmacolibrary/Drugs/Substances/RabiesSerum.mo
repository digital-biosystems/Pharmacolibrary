within Pharmacolibrary.Drugs.Substances;
package RabiesSerum "rabies serum"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "rabies serum",
    atcCodes = {"J06AA06"},
    drugbankId = "DB10062",
    wikidataId = "Q4067112");
  annotation (Documentation(info = "<html><body><p>Rabies serum (rabies immunoglobulin or antiserum) is an immune serum used to prevent or treat rabies infection. It is an approved antiviral medication and is included on the WHO list of essential medicines, so it is used worldwide.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4067112&quot;>Wikidata Q4067112</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>rabies serum</td></tr><tr><td>ATC codes:</td><td>J06AA06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB10062&quot;>DB10062</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4067112&quot;>Q4067112</a></td></tr></table></body></html>"));
end RabiesSerum;
