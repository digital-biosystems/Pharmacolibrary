  annotation (Documentation(info = "<html><body><p>Digitoxin is a cardiac glycoside used to treat atrial fibrillation, supraventricular tachycardia, and congestive heart failure. It has been withdrawn from use in some markets, though it remains an approved drug elsewhere.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q423890\">Wikidata Q423890</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>digitoxin</td></tr><tr><td>ATC codes:</td><td>C01AA04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01396\">DB01396</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/441207\">441207</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:28544\">28544</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q423890\">Q423890</a></td></tr><tr><td>formula:</td><td>C41H64O13</td></tr><tr><td>molar mass:</td><td>764.95 g/mol (PubChem CID 441207)</td></tr><tr><td>logP:</td><td>2.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Digitoxin;
