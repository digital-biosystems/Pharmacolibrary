  annotation (Documentation(info = "<html><body><p>Telaprevir is an antiviral drug that was used to treat chronic hepatitis C. It is no longer in use; its approval in the European Union has expired and it is listed as withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q408557\">Wikidata Q408557</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>telaprevir</td></tr><tr><td>ATC codes:</td><td>J05AP02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB05521\">DB05521</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3010818\">3010818</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:68595\">68595</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q408557\">Q408557</a></td></tr><tr><td>formula:</td><td>C36H53N7O6</td></tr><tr><td>molar mass:</td><td>679.863 g/mol (PubChem CID 3010818)</td></tr><tr><td>logP:</td><td>4.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
