  annotation (Documentation(info = "<html><body><p>Chloropyramine is an antihistamine (H1 blocker) used to treat allergy, available as a topical antipruritic and for systemic use. It is not authorised in the European Union and is considered investigational in major drug databases.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q729863&quot;>Wikidata Q729863</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>chloropyramine</td></tr><tr><td>ATC codes:</td><td>D04AA09, R06AC03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08800&quot;>DB08800</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/25295&quot;>25295</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:94767&quot;>94767</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q729863&quot;>Q729863</a></td></tr><tr><td>formula:</td><td>C16H20ClN3</td></tr><tr><td>molar mass:</td><td>289.807 g/mol (PubChem)</td></tr></table></body></html>"));
