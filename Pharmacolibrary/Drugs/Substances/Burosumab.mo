  annotation (Documentation(info = "<html><body><p>Burosumab, a monoclonal antibody, is used to treat bone-mineralisation disorders such as familial hypophosphataemia, X-linked hypophosphataemic rickets and osteomalacia. It is an approved medicine, authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q28209068&quot;>Wikidata Q28209068</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>burosumab</td></tr><tr><td>ATC codes:</td><td>M05BX05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB14012&quot;>DB14012</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q28209068&quot;>Q28209068</a></td></tr><tr><td>molar mass:</td><td>144100 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Burosumab;
