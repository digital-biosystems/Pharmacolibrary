  annotation (Documentation(info = "<html><body><p>Sitaxentan is an endothelin receptor antagonist that was used to treat pulmonary arterial hypertension. It has been withdrawn from the market, reportedly because of concerns about liver damage.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q905664\">Wikidata Q905664</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sitaxentan</td></tr><tr><td>ATC codes:</td><td>C02KX03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06268\">DB06268</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/216235\">216235</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135736\">135736</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q905664\">Q905664</a></td></tr><tr><td>formula:</td><td>C18H15ClN2O6S2</td></tr><tr><td>molar mass:</td><td>454.896 g/mol (PubChem CID 216235)</td></tr><tr><td>logP:</td><td>3.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
