  annotation (Documentation(info = "<html><body><p>Chiniofon is an antiprotozoal agent classified for use against amoebiasis and other protozoal diseases. It is currently regarded as experimental, with no authorised marketing identified, so its present availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27272118\">Wikidata Q27272118</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>chiniofon</td></tr><tr><td>ATC codes:</td><td>P01AX01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13379\">DB13379</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/23673836\">23673836</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27272118\">Q27272118</a></td></tr><tr><td>formula:</td><td>C10H7INNaO7S</td></tr><tr><td>molar mass:</td><td>435.116 g/mol (PubChem CID 23673836)</td></tr></table></body></html>"));
