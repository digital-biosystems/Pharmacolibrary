    logP = -3.9);
  annotation (Documentation(info = "<html><body><p>Lypressin, a lysine analogue of vasopressin, is a posterior pituitary hormone used for conditions involving deficiency of this hormone, such as diabetes insipidus. It is an approved vasopressin analogue and remains in use, though it is a less commonly used alternative to other vasopressin preparations.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27082434&quot;>Wikidata Q27082434</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>lypressin</td></tr><tr><td>ATC codes:</td><td>H01BA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB14642&quot;>DB14642</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/644076&quot;>644076</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:94802&quot;>94802</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27082434&quot;>Q27082434</a></td></tr><tr><td>formula:</td><td>C46H65N13O12S2</td></tr><tr><td>molar mass:</td><td>1056.22 g/mol (PubChem)</td></tr></table></body></html>"));
end Lypressin;
