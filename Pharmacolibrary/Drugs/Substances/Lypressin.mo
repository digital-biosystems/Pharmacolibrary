within Pharmacolibrary.Drugs.Substances;
package Lypressin "lypressin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "lypressin",
    atcCodes = {"H01BA03"},
    drugbankId = "DB14642",
    pubchemCid = "644076",
    chebiId = "94802",
    wikidataId = "Q27107266",
    formula = "C46H65N13O12S2",
    M = 1.05622,
    logP = -3.9);
  annotation (Documentation(info = "<html><body><p>Lypressin, a lysine vasopressin from pigs, is a vasopressin analogue with antidiuretic, vasoconstricting and blood-stopping actions. It is an approved medicine, classified among posterior pituitary lobe hormones (vasopressin and analogues), though it is not an EU-authorised product.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27107266\">Wikidata Q27107266</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>lypressin</td></tr><tr><td>ATC codes:</td><td>H01BA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB14642\">DB14642</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/644076\">644076</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:94802\">94802</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27107266\">Q27107266</a></td></tr><tr><td>formula:</td><td>C46H65N13O12S2</td></tr><tr><td>molar mass:</td><td>1056.22 g/mol (PubChem CID 644076)</td></tr><tr><td>logP:</td><td>-3.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Lypressin;
