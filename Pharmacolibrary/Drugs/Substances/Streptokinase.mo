within Pharmacolibrary.Drugs.Substances;
package Streptokinase "streptokinase"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "streptokinase",
    atcCodes = {"B01AD01"},
    drugbankId = "DB00086",
    wikidataId = "Q416485",
    M = 47.2867);
  annotation (Documentation(info = "<html><body><p>Streptokinase is a clot-dissolving enzyme used to treat conditions such as heart attack, pulmonary embolism, and peripheral vascular disease. It is an approved medicine and has been included on the WHO list of essential medicines, so it remains in use, though it has also been withdrawn in some settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q416485\">Wikidata Q416485</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>streptokinase</td></tr><tr><td>ATC codes:</td><td>B01AD01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00086\">DB00086</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q416485\">Q416485</a></td></tr><tr><td>molar mass:</td><td>47286.7 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Streptokinase;
