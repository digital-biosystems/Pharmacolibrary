  annotation (Documentation(info = "<html><body><p>Grazoprevir is an antiviral drug used to treat hepatitis C. It is an approved direct-acting antiviral for HCV infections, generally used in combination with other hepatitis C medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q19786991&quot;>Wikidata Q19786991</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>grazoprevir</td></tr><tr><td>ATC codes:</td><td>J05AP11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11575&quot;>DB11575</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/44603531&quot;>44603531</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:132975&quot;>132975</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q19786991&quot;>Q19786991</a></td></tr><tr><td>formula:</td><td>C38H50N6O9S</td></tr><tr><td>molar mass:</td><td>766.911 g/mol (PubChem)</td></tr></table></body></html>"));
