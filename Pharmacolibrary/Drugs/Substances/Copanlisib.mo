  annotation (Documentation(info = "<html><body><p>Copanlisib is a PI3K inhibitor investigated as a cancer treatment, notably for marginal zone lymphoma. Its marketing application in the European Union was withdrawn, so it is not authorised there.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q19903876&quot;>Wikidata Q19903876</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>copanlisib</td></tr><tr><td>ATC codes:</td><td>L01EM02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12483&quot;>DB12483</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/24989044&quot;>24989044</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:173077&quot;>173077</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q19903876&quot;>Q19903876</a></td></tr><tr><td>formula:</td><td>C23H28N8O4</td></tr><tr><td>molar mass:</td><td>480.529 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
