    wikidataId = "Q28163645");
  annotation (Documentation(info = "<html><body><p>Tetanus immunoglobulin is a medication containing antibodies against the tetanus toxin, used to prevent or treat tetanus. It is an approved medicine and is included on the WHO list of essential medicines, so it is widely available.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q28163645&quot;>Wikidata Q28163645</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tetanus immunoglobulin</td></tr><tr><td>ATC codes:</td><td>J06BB02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11604&quot;>DB11604</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q28163645&quot;>Q28163645</a></td></tr></table></body></html>"));
end TetanusImmunoglobulin;
