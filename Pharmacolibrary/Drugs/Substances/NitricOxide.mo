within Pharmacolibrary.Drugs.Substances;
package NitricOxide "nitric oxide"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "nitric oxide",
    atcCodes = {"R07AX01"},
    drugbankId = "DB00435",
    pubchemCid = "145068",
    chebiId = "16480",
    wikidataId = "Q207843",
    formula = "NO",
    M = 0.030006,
    logP = 0.2);
  annotation (Documentation(info = "<html><body><p>Nitric oxide, a gaseous signaling molecule with bronchodilator activity, is used as an inhaled respiratory medicine, mainly to treat dangerous blood-pressure problems in the lungs of newborn babies. It is an approved medicine used in specialised hospital settings, and it is also being studied for other investigational uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q207843&quot;>Wikidata Q207843</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nitric oxide</td></tr><tr><td>ATC codes:</td><td>R07AX01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00435&quot;>DB00435</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/145068&quot;>145068</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:16480&quot;>16480</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q207843&quot;>Q207843</a></td></tr><tr><td>formula:</td><td>NO</td></tr><tr><td>molar mass:</td><td>30.006 g/mol (PubChem)</td></tr></table></body></html>"));
end NitricOxide;
