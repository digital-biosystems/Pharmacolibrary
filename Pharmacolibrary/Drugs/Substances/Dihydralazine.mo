  annotation (Documentation(info = "<html><body><p>Dihydralazine is a hydrazinophthalazine vasodilator that was used to treat high blood pressure, alone or combined with a diuretic. It has been withdrawn from use and is no longer available as a medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q408370&quot;>Wikidata Q408370</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dihydralazine</td></tr><tr><td>ATC codes:</td><td>C02DB01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12945&quot;>DB12945</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/10230&quot;>10230</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134841&quot;>134841</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q408370&quot;>Q408370</a></td></tr><tr><td>formula:</td><td>C8H10N6</td></tr><tr><td>molar mass:</td><td>190.21 g/mol (PubChem)</td></tr></table></body></html>"));
