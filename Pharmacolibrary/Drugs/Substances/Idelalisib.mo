    logP = 3.7);
  annotation (Documentation(info = "<html><body><p>Idelalisib is an anticancer medicine used to treat certain B-cell blood cancers, including chronic lymphocytic leukemia and several types of lymphoma. It is authorised in the European Union for non-Hodgkin lymphoma and chronic lymphocytic leukemia, and carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5908266\">Wikidata Q5908266</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>idelalisib</td></tr><tr><td>ATC codes:</td><td>L01EM01, L01XX47</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09054\">DB09054</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/11625818\">11625818</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:82701\">82701</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5908266\">Q5908266</a></td></tr><tr><td>formula:</td><td>C22H18FN7O</td></tr><tr><td>molar mass:</td><td>415.432 g/mol (PubChem CID 11625818)</td></tr><tr><td>logP:</td><td>3.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Idelalisib;
