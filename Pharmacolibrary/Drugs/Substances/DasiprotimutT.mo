  annotation (Documentation(info = "<html><body><p>Dasiprotimut-T (BiovaxID) is an experimental cancer vaccine, an idiotype antigen vaccine, investigated for treating non-Hodgkin lymphoma. It remains experimental; a marketing application in the European Union was refused, so it is not an approved medicine.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>dasiprotimut-T</td></tr><tr><td>ATC codes:</td><td>L03AX19</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB17287\">DB17287</a></td></tr></table></body></html>"));
end DasiprotimutT;
