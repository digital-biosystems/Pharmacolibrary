  annotation (Documentation(info = "<html><body><p>Cetuximab is a monoclonal antibody used to treat several cancers, mainly head and neck cancers and colorectal cancers. It is approved and authorised in the European Union, and is also being investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q420296&quot;>Wikidata Q420296</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>cetuximab</td></tr><tr><td>ATC codes:</td><td>L01FE01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00002&quot;>DB00002</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q420296&quot;>Q420296</a></td></tr><tr><td>molar mass:</td><td>145782 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
