  annotation (Documentation(info = "<html><body><p>Mepartricin is an antifungal antibiotic used for local treatment of oral, skin, and gynecological fungal infections, and also as a urological drug for benign prostatic hypertrophy. It is not an approved medicine in major markets and is considered investigational.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q194535\">Wikidata Q194535</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mepartricin</td></tr><tr><td>ATC codes:</td><td>A01AB16, D01AA06, G01AA09, G04CX03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13633\">DB13633</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/11981152\">11981152</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q194535\">Q194535</a></td></tr><tr><td>formula:</td><td>C119H174N4O38</td></tr><tr><td>molar mass:</td><td>2268.69 g/mol (PubChem CID 11981152)</td></tr></table></body></html>"));
