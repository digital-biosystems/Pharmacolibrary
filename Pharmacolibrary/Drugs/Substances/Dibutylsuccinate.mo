  annotation (Documentation(info = "<html><body><p>Dibutylsuccinate is an insecticide and repellent, classified among ectoparasiticidal agents. It appears only as an experimental compound, with no authorised marketing identified.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27155847\">Wikidata Q27155847</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dibutylsuccinate</td></tr><tr><td>ATC codes:</td><td>P03BX04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13332\">DB13332</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/8830\">8830</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:82263\">82263</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27155847\">Q27155847</a></td></tr><tr><td>formula:</td><td>C12H22O4</td></tr><tr><td>molar mass:</td><td>230.304 g/mol (PubChem CID 8830)</td></tr><tr><td>logP:</td><td>2.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
