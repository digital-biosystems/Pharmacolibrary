    logP = 2.7);
  annotation (Documentation(info = "<html><body><p>Desonide is a moderately potent topical corticosteroid used to treat inflammatory skin conditions such as atopic dermatitis, psoriasis, seborrhoeic dermatitis, contact dermatitis, and other eczematous skin diseases. It is an approved medicine, available in dermatological preparations and also as an ophthalmic anti-inflammatory agent.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q904011&quot;>Wikidata Q904011</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>desonide</td></tr><tr><td>ATC codes:</td><td>D07AB08, S01BA11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01260&quot;>DB01260</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5311066&quot;>5311066</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:204734&quot;>204734</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q904011&quot;>Q904011</a></td></tr><tr><td>formula:</td><td>C24H32O6</td></tr><tr><td>molar mass:</td><td>416.514 g/mol (PubChem)</td></tr></table></body></html>"));
end Desonide;
