  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "desonide",
    atcCodes = {"D07AB08", "S01BA11"},
    drugbankId = "DB01260",
    pubchemCid = "5311066",
    chebiId = "204734",
    wikidataId = "Q904011",
