  annotation (Documentation(info = "<html><body><p>Lubiprostone is a chloride channel agonist used to treat constipation and irritable bowel syndrome. It is an approved drug, though not authorised in the European Union, and is also being studied for further uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6695342&quot;>Wikidata Q6695342</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>lubiprostone</td></tr><tr><td>ATC codes:</td><td>A06AX03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01046&quot;>DB01046</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/157920&quot;>157920</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6695342&quot;>Q6695342</a></td></tr><tr><td>formula:</td><td>C20H32F2O5</td></tr><tr><td>molar mass:</td><td>390.467 g/mol (PubChem)</td></tr></table></body></html>"));
