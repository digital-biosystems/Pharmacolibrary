  annotation (Documentation(info = "<html><body><p>Vincamine is a vasodilator alkaloid that has been used to widen blood vessels and lower blood pressure. It is considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q416225&quot;>Wikidata Q416225</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>vincamine</td></tr><tr><td>ATC codes:</td><td>C04AX07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13374&quot;>DB13374</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/15376&quot;>15376</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9985&quot;>9985</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q416225&quot;>Q416225</a></td></tr><tr><td>formula:</td><td>C21H26N2O3</td></tr><tr><td>molar mass:</td><td>354.45 g/mol (PubChem)</td></tr></table></body></html>"));
end Vincamine;
