  annotation (Documentation(info = "<html><body><p>Metenolone is an anabolic steroid that has been used to promote muscle growth and counter wasting conditions. It is considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q905078&quot;>Wikidata Q905078</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>metenolone</td></tr><tr><td>ATC codes:</td><td>A14AA04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13710&quot;>DB13710</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3037705&quot;>3037705</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135283&quot;>135283</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q905078&quot;>Q905078</a></td></tr><tr><td>formula:</td><td>C20H30O2</td></tr><tr><td>molar mass:</td><td>302.458 g/mol (PubChem)</td></tr></table></body></html>"));
end Metenolone;
