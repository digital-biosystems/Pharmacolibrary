  annotation (Documentation(info = "<html><body><p>Bibenzonium bromide is a cough suppressant that has been used to relieve coughing. It is considered experimental and does not appear to be an approved medicine in major markets such as the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27256401\">Wikidata Q27256401</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bibenzonium bromide</td></tr><tr><td>ATC codes:</td><td>R05DB12</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13630\">DB13630</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/71954\">71954</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135175\">135175</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27256401\">Q27256401</a></td></tr><tr><td>formula:</td><td>C19H26NO+</td></tr><tr><td>molar mass:</td><td>284.423 g/mol (PubChem CID 71954)</td></tr></table><p><small>Drugs.Common 25.09 gave 364.3 g/mol (+28.1 %); replaced by the value above</small></p></body></html>"));
