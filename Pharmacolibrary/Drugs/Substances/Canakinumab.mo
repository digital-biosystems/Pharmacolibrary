    M = 145.157);
  annotation (Documentation(info = "<html><body><p>Canakinumab is a monoclonal antibody that blocks interleukin signalling and is used to treat Cryopyrin-Associated Periodic Syndromes and juvenile idiopathic arthritis, with investigational use in gouty arthritis and cardiovascular conditions such as acute coronary syndrome. It is authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3655009&quot;>Wikidata Q3655009</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>canakinumab</td></tr><tr><td>ATC codes:</td><td>L04AC08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06168&quot;>DB06168</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3655009&quot;>Q3655009</a></td></tr><tr><td>molar mass:</td><td>145157 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Canakinumab;
