    logP = 1.4);
  annotation (Documentation(info = "<html><body><p>Terazosin is an alpha-blocker used to treat high blood pressure and urinary problems caused by an enlarged prostate, such as difficulty passing urine. It is an approved medicine and is used fairly widely, mainly for benign prostatic enlargement.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q280786&quot;>Wikidata Q280786</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>terazosin</td></tr><tr><td>ATC codes:</td><td>G04CA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01162&quot;>DB01162</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5401&quot;>5401</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9445&quot;>9445</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q280786&quot;>Q280786</a></td></tr><tr><td>formula:</td><td>C19H25N5O4</td></tr><tr><td>molar mass:</td><td>387.44 g/mol (PubChem)</td></tr></table></body></html>"));
