  annotation (Documentation(info = "<html><body><p>Luspatercept is an antianemic medicine used to treat anemia in people with myelodysplastic syndromes or beta-thalassemia. It is authorised in the European Union and is also being studied for further uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q30314143&quot;>Wikidata Q30314143</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>luspatercept</td></tr><tr><td>ATC codes:</td><td>B03XA06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12281&quot;>DB12281</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q30314143&quot;>Q30314143</a></td></tr><tr><td>molar mass:</td><td>76000 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Luspatercept;
