  annotation (Documentation(info = "<html><body><p>Sodium glycerophosphate is used as a source of phosphate in intravenous solutions, added to infusion fluids to supply electrolytes. It is an approved drug, used mainly in hospital settings as an additive to intravenous solutions.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27278714&quot;>Wikidata Q27278714</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sodium glycerophosphate</td></tr><tr><td>ATC codes:</td><td>B05XA14</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09561&quot;>DB09561</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/22251426&quot;>22251426</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27278714&quot;>Q27278714</a></td></tr><tr><td>formula:</td><td>C3H9Na2O7P</td></tr><tr><td>molar mass:</td><td>234.052 g/mol (PubChem)</td></tr></table></body></html>"));
