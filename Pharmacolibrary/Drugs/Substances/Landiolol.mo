  annotation (Documentation(info = "<html><body><p>Landiolol is a selective beta blocker with antiarrhythmic activity, used to control fast heart rhythms. It is an approved medicine, given by infusion in hospital settings, and is used mainly in Japan and some Asian countries rather than in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6484656&quot;>Wikidata Q6484656</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>landiolol</td></tr><tr><td>ATC codes:</td><td>C07AB14</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12212&quot;>DB12212</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/114905&quot;>114905</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135809&quot;>135809</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6484656&quot;>Q6484656</a></td></tr><tr><td>formula:</td><td>C25H39N3O8</td></tr><tr><td>molar mass:</td><td>509.6 g/mol (PubChem)</td></tr></table></body></html>"));
