  annotation (Documentation(info = "<html><body><p>Quetiapine is an atypical antipsychotic used for conditions such as schizophrenia, bipolar disorder, and related mental disorders. It is an approved medicine used widely in psychiatric care, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q408535\">Wikidata Q408535</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>quetiapine</td></tr><tr><td>ATC codes:</td><td>N05AH04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01224\">DB01224</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5002\">5002</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8707\">8707</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q408535\">Q408535</a></td></tr><tr><td>formula:</td><td>C21H25N3O2S</td></tr><tr><td>molar mass:</td><td>383.51 g/mol (PubChem CID 5002)</td></tr><tr><td>logP:</td><td>2.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
