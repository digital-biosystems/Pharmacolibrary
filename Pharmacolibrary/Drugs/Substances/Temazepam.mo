    logP = 2.2);
  annotation (Documentation(info = "<html><body><p>Temazepam is a benzodiazepine sedative used to treat insomnia and anxiety-related conditions such as anxiety disorder, panic disorder, and sleep-wake disorders. It is an approved medicine and remains in use as a hypnotic and anxiolytic, though benzodiazepines are generally prescribed for short-term treatment.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q414796\">Wikidata Q414796</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>temazepam</td></tr><tr><td>ATC codes:</td><td>N05CD07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00231\">DB00231</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5391\">5391</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9435\">9435</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q414796\">Q414796</a></td></tr><tr><td>formula:</td><td>C16H13ClN2O2</td></tr><tr><td>molar mass:</td><td>300.742 g/mol (PubChem CID 5391)</td></tr><tr><td>logP:</td><td>2.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Temazepam;
