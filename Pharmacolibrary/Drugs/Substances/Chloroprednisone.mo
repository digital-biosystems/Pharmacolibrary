  annotation (Documentation(info = "<html><body><p>Chloroprednisone is a corticosteroid that has been used in eye preparations combined with antiinfective agents to treat inflammatory eye conditions. It appears to be only an experimental drug and is not an established marketed medicine today.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Chloroprednisone</td></tr><tr><td>ATC codes:</td><td>S01CA09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB15970&quot;>DB15970</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3034026&quot;>3034026</a></td></tr><tr><td>formula:</td><td>C21H25ClO5</td></tr><tr><td>molar mass:</td><td>392.876 g/mol (PubChem)</td></tr></table></body></html>"));
