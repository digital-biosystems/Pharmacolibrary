  annotation (Documentation(info = "<html><body><p>Levonadifloxacin is an investigational fluoroquinolone antibacterial, related to nadifloxacin, studied as a treatment for bacterial infections. It is not an approved medicine; it remains under investigation and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27117310\">Wikidata Q27117310</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>levonadifloxacin</td></tr><tr><td>ATC codes:</td><td>J01MA24</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB16219\">DB16219</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9850038\">9850038</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:37908\">37908</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27117310\">Q27117310</a></td></tr><tr><td>formula:</td><td>C19H21FN2O4</td></tr><tr><td>molar mass:</td><td>360.385 g/mol (PubChem CID 9850038)</td></tr><tr><td>logP:</td><td>2.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
