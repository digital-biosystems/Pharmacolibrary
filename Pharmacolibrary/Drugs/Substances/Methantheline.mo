  annotation (Documentation(info = "<html><body><p>Methantheline is a synthetic anticholinergic (muscarinic antagonist) used for functional gastrointestinal disorders. It is an approved drug, though it does not appear to have centralised European Union authorisation.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6823610&quot;>Wikidata Q6823610</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>methantheline</td></tr><tr><td>ATC codes:</td><td>A03AB07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00940&quot;>DB00940</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4097&quot;>4097</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6817&quot;>6817</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6823610&quot;>Q6823610</a></td></tr><tr><td>formula:</td><td>C21H26NO3+</td></tr><tr><td>molar mass:</td><td>340.443 g/mol (PubChem)</td></tr></table></body></html>"));
