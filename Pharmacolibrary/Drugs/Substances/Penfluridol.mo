    logP = 7.3);
  annotation (Documentation(info = "<html><body><p>Penfluridol is an antipsychotic of the diphenylbutylpiperidine class that acts as a dopamine antagonist and was used to treat psychotic disorders such as schizophrenia. It is currently considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2149707\">Wikidata Q2149707</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>penfluridol</td></tr><tr><td>ATC codes:</td><td>N05AG03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13791\">DB13791</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/33630\">33630</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:92278\">92278</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2149707\">Q2149707</a></td></tr><tr><td>formula:</td><td>C28H27ClF5NO</td></tr><tr><td>molar mass:</td><td>523.97 g/mol (PubChem CID 33630)</td></tr><tr><td>logP:</td><td>7.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Penfluridol;
