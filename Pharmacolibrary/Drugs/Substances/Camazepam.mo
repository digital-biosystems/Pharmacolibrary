  annotation (Documentation(info = "<html><body><p>Camazepam is a benzodiazepine drug with sedative properties, used as an anxiolytic for anxiety. It is not an established marketed medicine today; databases list it only as experimental, and it is controlled as a benzodiazepine derivative.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3651150\">Wikidata Q3651150</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>camazepam</td></tr><tr><td>ATC codes:</td><td>N05BA15</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01489\">DB01489</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/37367\">37367</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135570\">135570</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3651150\">Q3651150</a></td></tr><tr><td>formula:</td><td>C19H18ClN3O3</td></tr><tr><td>molar mass:</td><td>371.821 g/mol (PubChem CID 37367)</td></tr><tr><td>logP:</td><td>2.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
