  annotation (Documentation(info = "<html><body><p>Tasosartan is an angiotensin II receptor antagonist, a drug class used to lower blood pressure in hypertension. It remains experimental and does not appear to be an approved medicine in the European Union or elsewhere.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q1317131&quot;>Wikidata Q1317131</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tasosartan</td></tr><tr><td>ATC codes:</td><td>C09CA05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01349&quot;>DB01349</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/60919&quot;>60919</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135666&quot;>135666</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q1317131&quot;>Q1317131</a></td></tr><tr><td>formula:</td><td>C23H21N7O</td></tr><tr><td>molar mass:</td><td>411.469 g/mol (PubChem)</td></tr></table></body></html>"));
