    logP = -2.6);
  annotation (Documentation(info = "<html><body><p>Miglitol is an alpha-glucosidase inhibitor used to lower blood sugar in type 2 diabetes and in maturity-onset diabetes of the young type 2. It is an approved anti-diabetic medication, though it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q772735\">Wikidata Q772735</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>miglitol</td></tr><tr><td>ATC codes:</td><td>A10BF02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00491\">DB00491</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/441314\">441314</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6935\">6935</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q772735\">Q772735</a></td></tr><tr><td>formula:</td><td>C8H17NO5</td></tr><tr><td>molar mass:</td><td>207.226 g/mol (PubChem CID 441314)</td></tr><tr><td>logP:</td><td>-2.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Miglitol;
