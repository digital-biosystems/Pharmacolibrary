within Pharmacolibrary.Drugs.Substances;
package Dimetindene "dimetindene"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "dimetindene",
    atcCodes = {"D04AA13", "R06AB03"},
    drugbankId = "DB08801",
    pubchemCid = "21855",
    chebiId = "135222",
    wikidataId = "Q426070",
    formula = "C20H24N2",
    M = 0.292426,
    logP = 2.7);
  annotation (Documentation(info = "<html><body><p>Dimetindene is an antihistamine (H1 blocker) used to relieve itching and allergic conditions, applied topically to the skin or taken by mouth. It is an approved medicine, used mainly in topical antipruritic and systemic antihistamine preparations, though it is not an EMA-authorised centrally approved product.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q426070\">Wikidata Q426070</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dimetindene</td></tr><tr><td>ATC codes:</td><td>D04AA13, R06AB03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08801\">DB08801</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/21855\">21855</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135222\">135222</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q426070\">Q426070</a></td></tr><tr><td>formula:</td><td>C20H24N2</td></tr><tr><td>molar mass:</td><td>292.426 g/mol (PubChem CID 21855)</td></tr><tr><td>logP:</td><td>2.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Dimetindene;
