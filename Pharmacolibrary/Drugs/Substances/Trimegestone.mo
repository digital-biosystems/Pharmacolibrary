    logP = 3.75);
  annotation (Documentation(info = "<html><body><p>Trimegestone is a progestogen studied for use in combined hormone therapy with estrogens for menopausal hormone replacement. It remains investigational and does not appear to have an authorised marketing approval in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7842164&quot;>Wikidata Q7842164</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Trimegestone</td></tr><tr><td>ATC codes:</td><td>G03FA16, G03FB11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13129&quot;>DB13129</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/68926&quot;>68926</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:136027&quot;>136027</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7842164&quot;>Q7842164</a></td></tr><tr><td>formula:</td><td>C22H30O3</td></tr><tr><td>molar mass:</td><td>342.479 g/mol (PubChem)</td></tr></table></body></html>"));
end Trimegestone;
