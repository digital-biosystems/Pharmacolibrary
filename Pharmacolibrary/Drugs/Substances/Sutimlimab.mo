within Pharmacolibrary.Drugs.Substances;
package Sutimlimab "sutimlimab"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "sutimlimab",
    atcCodes = {"L04AJ04"},
    drugbankId = "DB14996",
    wikidataId = "Q60785670",
    M = 147);
  annotation (Documentation(info = "<html><body><p>Sutimlimab is a monoclonal antibody that inhibits complement and is used to treat haemolysis in cold agglutinin disease, a form of autoimmune haemolytic anaemia. It is approved and authorised in the European Union, though it remains a newer, specialised treatment.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q60785670\">Wikidata Q60785670</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>sutimlimab</td></tr><tr><td>ATC codes:</td><td>L04AJ04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB14996\">DB14996</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q60785670\">Q60785670</a></td></tr><tr><td>molar mass:</td><td>147000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Sutimlimab;
