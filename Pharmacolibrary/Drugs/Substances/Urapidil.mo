    logP = 1.5);
  annotation (Documentation(info = "<html><body><p>Urapidil is a sympatholytic antihypertensive drug that lowers blood pressure by blocking alpha-1 adrenergic receptors and acting as a vasodilator. It is considered investigational and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q418922&quot;>Wikidata Q418922</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>urapidil</td></tr><tr><td>ATC codes:</td><td>C02CA06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12661&quot;>DB12661</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5639&quot;>5639</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32278&quot;>32278</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q418922&quot;>Q418922</a></td></tr><tr><td>formula:</td><td>C20H29N5O3</td></tr><tr><td>molar mass:</td><td>387.484 g/mol (PubChem)</td></tr></table></body></html>"));
