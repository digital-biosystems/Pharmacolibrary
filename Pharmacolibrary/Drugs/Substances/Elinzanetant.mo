  annotation (Documentation(info = "<html><body><p>Elinzanetant is used to treat hot flashes associated with menopause, including in women with breast cancer. It is authorised in the European Union as a recently approved medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q108453435\">Wikidata Q108453435</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>elinzanetant</td></tr><tr><td>ATC codes:</td><td>G02CX07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB18968\">DB18968</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/16063568\">16063568</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q108453435\">Q108453435</a></td></tr><tr><td>formula:</td><td>C33H35F7N4O3</td></tr><tr><td>molar mass:</td><td>668.654 g/mol (PubChem CID 16063568)</td></tr></table><h4>Metabolites</h4><table><tr><td><code>M1821</code></td><td>M18/21</td><td>molar mass unknown</td></tr><tr><td><code>M27</code></td><td>M27</td><td>molar mass unknown</td></tr><tr><td><code>M3034</code></td><td>M30/34</td><td>molar mass unknown</td></tr></table></body></html>"));
