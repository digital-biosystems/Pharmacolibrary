    logP = 3);
  annotation (Documentation(info = "<html><body><p>Mupirocin is a topical antibiotic used to treat skin infections such as impetigo and other staphylococcal infections, and is also applied in nasal preparations. It is an approved medicine in widespread human use, is also approved for veterinary use, and is included on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q413578\">Wikidata Q413578</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mupirocin</td></tr><tr><td>ATC codes:</td><td>D06AX09, R01AX06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00410\">DB00410</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/446596\">446596</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7025\">7025</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q413578\">Q413578</a></td></tr><tr><td>formula:</td><td>C26H44O9</td></tr><tr><td>molar mass:</td><td>500.629 g/mol (PubChem CID 446596)</td></tr><tr><td>logP:</td><td>3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Mupirocin;
