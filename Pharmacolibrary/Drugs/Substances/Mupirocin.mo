  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "mupirocin",
    atcCodes = {"D06AX09", "R01AX06"},
    drugbankId = "DB00410",
    pubchemCid = "446596",
    chebiId = "7025",
    wikidataId = "Q413578",
    formula = "C26H44O9",
