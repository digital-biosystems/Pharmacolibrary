within Pharmacolibrary.Drugs.Substances;
package DornaseAlfa "Dornase alfa"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "Dornase alfa",
    atcCodes = {"R05CB13"},
    drugbankId = "DB00003");
  annotation (Documentation(info = "<html><body><p>Dornase alfa is an inhaled mucolytic enzyme used to thin mucus in the airways of people with cystic fibrosis. It is an approved medicine, widely used as a maintenance inhalation treatment in cystic fibrosis care.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Dornase alfa</td></tr><tr><td>ATC codes:</td><td>R05CB13</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00003\">DB00003</a></td></tr></table></body></html>"));
end DornaseAlfa;
