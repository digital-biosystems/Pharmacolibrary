  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "nelarabine",
    atcCodes = {"L01BB07"},
    drugbankId = "DB01280",
    pubchemCid = "3011155",
    chebiId = "63612",
    wikidataId = "Q1216264",
