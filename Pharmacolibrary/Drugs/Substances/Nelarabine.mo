    logP = -0.7);
  annotation (Documentation(info = "<html><body><p>Nelarabine is a purine analogue anticancer drug used to treat precursor T-cell lymphoblastic leukemia and lymphoma. It is authorised in the European Union and is used mainly in specialist care for these rare T-cell blood cancers.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1216264\">Wikidata Q1216264</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>nelarabine</td></tr><tr><td>ATC codes:</td><td>L01BB07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01280\">DB01280</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3011155\">3011155</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:63612\">63612</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1216264\">Q1216264</a></td></tr><tr><td>formula:</td><td>C11H15N5O5</td></tr><tr><td>molar mass:</td><td>297.271 g/mol (PubChem CID 3011155)</td></tr><tr><td>logP:</td><td>-0.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Nelarabine;
