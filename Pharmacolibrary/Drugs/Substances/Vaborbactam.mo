  annotation (Documentation(info = "<html><body><p>Vaborbactam is a beta-lactamase inhibitor used in combination with a carbapenem antibiotic to treat urinary tract infections caused by resistant bacteria. It is an approved drug, used mainly in hospital settings for serious gram-negative infections.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27252228&quot;>Wikidata Q27252228</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Vaborbactam</td></tr><tr><td>ATC codes:</td><td>J01DH52</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12107&quot;>DB12107</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/56649692&quot;>56649692</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27252228&quot;>Q27252228</a></td></tr><tr><td>formula:</td><td>C12H16BNO5S</td></tr><tr><td>molar mass:</td><td>297.132 g/mol (PubChem)</td></tr></table></body></html>"));
