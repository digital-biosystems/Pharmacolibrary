  annotation (Documentation(info = "<html><body><p>Divozilimab is an investigational monoclonal antibody that targets a human B-cell surface antigen and is classed as an immunosuppressant. It is still experimental and has not been authorised for use in the European Union.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>divozilimab</td></tr><tr><td>ATC codes:</td><td>L04AG15</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB18878&quot;>DB18878</a></td></tr></table></body></html>"));
