    wikidataId = "Q104153457");
  annotation (Documentation(info = "<html><body><p>Concizumab, a monoclonal antibody, is used to treat hemophilia A and hemophilia B. It is authorised in the European Union and is also being investigated for further uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q104153457&quot;>Wikidata Q104153457</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>concizumab</td></tr><tr><td>ATC codes:</td><td>B02BX10</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12820&quot;>DB12820</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q104153457&quot;>Q104153457</a></td></tr></table></body></html>"));
end Concizumab;
