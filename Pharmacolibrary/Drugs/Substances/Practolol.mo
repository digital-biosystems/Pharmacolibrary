  annotation (Documentation(info = "<html><body><p>Practolol is a selective beta-1 blocking agent used as an antiarrhythmic drug for heart rhythm problems. It is recorded as an approved medicine, though it appears to be little used today.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7237376&quot;>Wikidata Q7237376</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>practolol</td></tr><tr><td>ATC codes:</td><td>C07AB01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01297&quot;>DB01297</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4883&quot;>4883</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:258351&quot;>258351</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7237376&quot;>Q7237376</a></td></tr><tr><td>formula:</td><td>C14H22N2O3</td></tr><tr><td>molar mass:</td><td>266.341 g/mol (PubChem)</td></tr></table></body></html>"));
