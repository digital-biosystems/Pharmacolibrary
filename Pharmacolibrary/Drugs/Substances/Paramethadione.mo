within Pharmacolibrary.Drugs.Substances;
package Paramethadione "paramethadione"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "paramethadione",
    atcCodes = {"N03AC01"},
    drugbankId = "DB00617",
    pubchemCid = "8280",
    chebiId = "7921",
    wikidataId = "Q3895202",
    formula = "C7H11NO3",
    M = 0.157169,
    logP = 0.8);
  annotation (Documentation(info = "<html><body><p>Paramethadione is an oxazolidine-derivative antiepileptic drug used to treat epilepsy, especially absence seizures. It is listed as an approved drug, but it is no longer widely used and is largely unavailable in most countries, partly because of concerns about toxicity during pregnancy.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3895202\">Wikidata Q3895202</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>paramethadione</td></tr><tr><td>ATC codes:</td><td>N03AC01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00617\">DB00617</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/8280\">8280</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7921\">7921</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3895202\">Q3895202</a></td></tr><tr><td>formula:</td><td>C7H11NO3</td></tr><tr><td>molar mass:</td><td>157.169 g/mol (PubChem CID 8280)</td></tr><tr><td>logP:</td><td>0.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Paramethadione;
