  annotation (Documentation(info = "<html><body><p>Methoxyphenamine is a non-selective beta-adrenergic agonist used for obstructive airway diseases such as asthma. It is an approved drug, but it is not authorised in the European Union and appears to be little used today.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6823901\">Wikidata Q6823901</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>methoxyphenamine</td></tr><tr><td>ATC codes:</td><td>R03CB02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13624\">DB13624</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4117\">4117</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134817\">134817</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6823901\">Q6823901</a></td></tr><tr><td>formula:</td><td>C11H17NO</td></tr><tr><td>molar mass:</td><td>179.263 g/mol (PubChem CID 4117)</td></tr><tr><td>logP:</td><td>2.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
