    M = 0.895203);
  annotation (Documentation(info = "<html><body><p>Stibophen is an antimony-based antitrematodal drug, historically used to treat trematode (fluke) infections. It is no longer in routine clinical use and is regarded as an experimental agent.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27892813\">Wikidata Q27892813</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>stibophen</td></tr><tr><td>ATC codes:</td><td>P02BX03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13236\">DB13236</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/16683008\">16683008</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27892813\">Q27892813</a></td></tr><tr><td>formula:</td><td>C12H18Na5O23S4Sb</td></tr><tr><td>molar mass:</td><td>895.203 g/mol (PubChem CID 16683008)</td></tr></table></body></html>"));
end Stibophen;
