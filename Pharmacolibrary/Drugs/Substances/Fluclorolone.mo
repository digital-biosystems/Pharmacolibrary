  annotation (Documentation(info = "<html><body><p>Fluclorolone is a potent topical corticosteroid used to treat inflammatory skin conditions. It appears to be little used today, being listed only as an experimental drug with no marketing authorisation recorded in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27247536&quot;>Wikidata Q27247536</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>fluclorolone</td></tr><tr><td>ATC codes:</td><td>D07AC02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13856&quot;>DB13856</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/76962649&quot;>76962649</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135986&quot;>135986</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27247536&quot;>Q27247536</a></td></tr><tr><td>formula:</td><td>C21H25Cl2FO5</td></tr><tr><td>molar mass:</td><td>447.324 g/mol (PubChem)</td></tr></table></body></html>"));
