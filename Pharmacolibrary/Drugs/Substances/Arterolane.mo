  annotation (Documentation(info = "<html><body><p>Arterolane is an antimalarial drug developed for the treatment of malaria. It is still classed as investigational and is not widely approved; it has been used mainly in combination therapy in India.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Arterolane</td></tr><tr><td>ATC codes:</td><td>P01BX02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB19027\">DB19027</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/10475633\">10475633</a></td></tr><tr><td>formula:</td><td>C22H36N2O4</td></tr><tr><td>molar mass:</td><td>392.54 g/mol (PubChem CID 10475633)</td></tr></table></body></html>"));
end Arterolane;
