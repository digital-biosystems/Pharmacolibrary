  annotation (Documentation(info = "<html><body><p>Vinflunine is a vinca alkaloid anticancer drug used to treat transitional cell carcinoma of the urinary tract. It is authorised in the European Union, but its use is limited to this indication and it is not widely used elsewhere.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2195393\">Wikidata Q2195393</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>vinflunine</td></tr><tr><td>ATC codes:</td><td>L01CA05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11641\">DB11641</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/10629256\">10629256</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:90241\">90241</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2195393\">Q2195393</a></td></tr><tr><td>formula:</td><td>C45H54F2N4O8</td></tr><tr><td>molar mass:</td><td>816.943 g/mol (PubChem CID 10629256)</td></tr><tr><td>logP:</td><td>4.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
