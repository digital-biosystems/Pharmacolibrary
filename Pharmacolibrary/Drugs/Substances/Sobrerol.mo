  annotation (Documentation(info = "<html><body><p>Sobrerol is a mucokinetic mucolytic agent used as an expectorant for cough and cold preparations. It is considered investigational and is not an established marketed medicine in major jurisdictions.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3963210\">Wikidata Q3963210</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sobrerol</td></tr><tr><td>ATC codes:</td><td>R05CB07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13315\">DB13315</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/91463\">91463</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3963210\">Q3963210</a></td></tr><tr><td>formula:</td><td>C10H18O2</td></tr><tr><td>molar mass:</td><td>170.252 g/mol (PubChem CID 91463)</td></tr><tr><td>logP:</td><td>0.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
