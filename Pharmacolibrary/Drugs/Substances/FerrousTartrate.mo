  annotation (Documentation(info = "<html><body><p>Ferrous tartrate is an oral iron(II) preparation classified as an antianemic medicine, used to treat iron deficiency anaemia. It appears only as an experimental compound in drug databases, so it does not seem to be in routine clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q18207095&quot;>Wikidata Q18207095</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ferrous tartrate</td></tr><tr><td>ATC codes:</td><td>B03AA08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13639&quot;>DB13639</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q18207095&quot;>Q18207095</a></td></tr><tr><td>formula:</td><td>C4H4FeO6</td></tr><tr><td>molar mass:</td><td>203.915 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end FerrousTartrate;
