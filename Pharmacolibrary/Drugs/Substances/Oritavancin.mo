  annotation (Documentation(info = "<html><body><p>Oritavancin is a lipoglycopeptide antibiotic used to treat bacterial skin and soft tissue infections such as cellulitis. It is an approved medicine, with one product authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7102878&quot;>Wikidata Q7102878</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>oritavancin</td></tr><tr><td>ATC codes:</td><td>J01XA05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB04911&quot;>DB04911</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/16136912&quot;>16136912</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:82699&quot;>82699</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7102878&quot;>Q7102878</a></td></tr><tr><td>formula:</td><td>C86H97Cl3N10O26</td></tr><tr><td>molar mass:</td><td>1793.12 g/mol (PubChem)</td></tr></table></body></html>"));
