  annotation (Documentation(info = "<html><body><p>Trichloroethylene is a chlorinated hydrocarbon that has been used as an inhalational general anaesthetic. It is an approved drug, though it is also classified as a carcinogen and toxicant, so its use is limited.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q407936&quot;>Wikidata Q407936</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>trichloroethylene</td></tr><tr><td>ATC codes:</td><td>N01AB05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13323&quot;>DB13323</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6575&quot;>6575</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:16602&quot;>16602</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q407936&quot;>Q407936</a></td></tr><tr><td>formula:</td><td>C2HCl3</td></tr><tr><td>molar mass:</td><td>131.38 g/mol (PubChem)</td></tr></table></body></html>"));
