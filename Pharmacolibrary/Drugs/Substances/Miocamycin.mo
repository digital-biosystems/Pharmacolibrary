  annotation (Documentation(info = "<html><body><p>Miocamycin (midecamycin acetate) is a macrolide antibiotic used to treat bacterial infections. It is an approved macrolide antibacterial, but it does not appear to be authorised in the European Union and its use today is limited to certain countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3858659\">Wikidata Q3858659</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>miocamycin</td></tr><tr><td>ATC codes:</td><td>J01FA11</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13287\">DB13287</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3858659\">Q3858659</a></td></tr><tr><td>molar mass:</td><td>898 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>3.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
