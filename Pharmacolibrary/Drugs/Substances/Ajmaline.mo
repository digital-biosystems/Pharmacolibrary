  annotation (Documentation(info = "<html><body><p>Ajmaline is a class Ia antiarrhythmic, a sodium channel blocker used to treat heart rhythm disorders. It has been withdrawn from use in some markets, though it remains approved elsewhere.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q385858\">Wikidata Q385858</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ajmaline</td></tr><tr><td>ATC codes:</td><td>C01BA05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01426\">DB01426</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/441080\">441080</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:28462\">28462</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q385858\">Q385858</a></td></tr><tr><td>formula:</td><td>C20H26N2O2</td></tr><tr><td>molar mass:</td><td>326.44 g/mol (PubChem CID 441080)</td></tr><tr><td>logP:</td><td>1.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
