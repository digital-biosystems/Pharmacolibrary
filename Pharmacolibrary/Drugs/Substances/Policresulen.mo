  annotation (Documentation(info = "<html><body><p>Policresulen is an antiseptic and disinfectant used on the skin and as a gynecological antiinfective. It is not an approved medicine in major databases and is currently classed as investigational.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q906883\">Wikidata Q906883</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>policresulen</td></tr><tr><td>ATC codes:</td><td>D08AE02, G01AX03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13492\">DB13492</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q906883\">Q906883</a></td></tr></table></body></html>"));
