within Pharmacolibrary.Drugs.Substances;
package Pegaspargase "pegaspargase"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "pegaspargase",
    atcCodes = {"L01XX24"},
    drugbankId = "DB00059",
    wikidataId = "Q7160547",
    M = 31.7319);
  annotation (Documentation(info = "<html><body><p>Pegaspargase is a PEGylated asparaginase enzyme used as an antineoplastic drug to treat lymphoid leukemias and lymphomas, including acute lymphoblastic leukemia/lymphoma. It is an approved medicine, with one product authorised in the European Union for precursor cell lymphoblastic leukemia-lymphoma, and it is also used in the United States.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7160547\">Wikidata Q7160547</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>pegaspargase</td></tr><tr><td>ATC codes:</td><td>L01XX24</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00059\">DB00059</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7160547\">Q7160547</a></td></tr><tr><td>molar mass:</td><td>31731.9 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Pegaspargase;
