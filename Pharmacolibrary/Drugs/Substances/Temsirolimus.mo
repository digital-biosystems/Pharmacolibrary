  annotation (Documentation(info = "<html><body><p>Temsirolimus is an anticancer medicine used to treat kidney cancer (renal cell carcinoma) and mantle cell lymphoma. It is an authorised medicine in the European Union and is used mainly in oncology, typically in hospital settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7699074\">Wikidata Q7699074</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>temsirolimus</td></tr><tr><td>ATC codes:</td><td>L01EG01, L01XE09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06287\">DB06287</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/23724530\">23724530</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:79699\">79699</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7699074\">Q7699074</a></td></tr><tr><td>formula:</td><td>C56H87NO16</td></tr><tr><td>molar mass:</td><td>1030.3 g/mol (PubChem CID 23724530)</td></tr><tr><td>logP:</td><td>5.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
