within Pharmacolibrary.Drugs.Substances;
package Somatostatin "somatostatin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "somatostatin",
    atcCodes = {"H01CB01"},
    drugbankId = "DB09099",
    pubchemCid = "16129681",
    chebiId = "64628",
    wikidataId = "Q22075835",
    formula = "C76H104N18O19S2",
    M = 1.63789,
    logP = -3.1);
  annotation (Documentation(info = "<html><body><p>Somatostatin is a hypothalamic hormone used to reduce secretions of the gut and pancreas, for example in bleeding from dilated veins in the esophagus and in pancreatic leaks. It remains an approved medicine and is used mainly in hospital settings, though it has largely been replaced by longer-acting analogues.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q22075835\">Wikidata Q22075835</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>somatostatin</td></tr><tr><td>ATC codes:</td><td>H01CB01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09099\">DB09099</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/16129681\">16129681</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:64628\">64628</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q22075835\">Q22075835</a></td></tr><tr><td>formula:</td><td>C76H104N18O19S2</td></tr><tr><td>molar mass:</td><td>1637.89 g/mol (PubChem CID 16129681)</td></tr><tr><td>logP:</td><td>-3.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Somatostatin;
