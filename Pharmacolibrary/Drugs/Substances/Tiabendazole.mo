  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "tiabendazole",
    atcCodes = {"D01AC06", "P02CA02"},
    drugbankId = "DB00730",
    pubchemCid = "5430",
    chebiId = "45979",
    wikidataId = "Q424986",
    formula = "C10H7N3S",
