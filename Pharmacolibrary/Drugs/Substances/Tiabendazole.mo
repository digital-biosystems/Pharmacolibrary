    logP = 2.5);
  annotation (Documentation(info = "<html><body><p>Tiabendazole is an anthelmintic used to treat parasitic worm infections such as strongyloidiasis, trichinosis, dracunculiasis and other helminthiases. It has been withdrawn from human use, though it was previously approved and also used in veterinary medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q424986\">Wikidata Q424986</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tiabendazole</td></tr><tr><td>ATC codes:</td><td>D01AC06, P02CA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00730\">DB00730</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5430\">5430</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:45979\">45979</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q424986\">Q424986</a></td></tr><tr><td>formula:</td><td>C10H7N3S</td></tr><tr><td>molar mass:</td><td>201.247 g/mol (PubChem CID 5430)</td></tr><tr><td>logP:</td><td>2.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Tiabendazole;
