    logP = 2.7);
  annotation (Documentation(info = "<html><body><p>Iodoform is an antiseptic iodine compound that has been used in medicated dressings to help prevent infection in wounds. It is no longer widely used in human medicine, having been largely replaced by other antiseptics, though it remains approved for some uses, including in veterinary medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q412393&quot;>Wikidata Q412393</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>iodoform</td></tr><tr><td>ATC codes:</td><td>D09AA13</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13813&quot;>DB13813</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6374&quot;>6374</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:37758&quot;>37758</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q412393&quot;>Q412393</a></td></tr><tr><td>formula:</td><td>CHI3</td></tr><tr><td>molar mass:</td><td>393.719 g/mol (PubChem)</td></tr></table></body></html>"));
end Iodoform;
