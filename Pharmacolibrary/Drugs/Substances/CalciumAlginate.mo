within Pharmacolibrary.Drugs.Substances;
package CalciumAlginate "calcium alginate"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "calcium alginate",
    atcCodes = {"B02BC08"},
    drugbankId = "DB13372",
    pubchemCid = "5102882",
