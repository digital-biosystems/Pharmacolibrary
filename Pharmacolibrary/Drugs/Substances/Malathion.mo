  annotation (Documentation(info = "<html><body><p>Malathion is an insecticide used to treat lice infestations. It is an approved medicine, classified as an ectoparasiticide including scabicides, and is used widely for this purpose.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q423005&quot;>Wikidata Q423005</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>malathion</td></tr><tr><td>ATC codes:</td><td>P03AX03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00772&quot;>DB00772</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4004&quot;>4004</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:141474&quot;>141474</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q423005&quot;>Q423005</a></td></tr><tr><td>formula:</td><td>C10H19O6PS2</td></tr><tr><td>molar mass:</td><td>330.35 g/mol (PubChem)</td></tr></table></body></html>"));
