  annotation (Documentation(info = "<html><body><p>Liraglutide is a GLP-1 analogue used as an anti-diabetic medicine to treat type 2 diabetes and glucose intolerance, and is also authorised for obesity and overweight. It is approved and authorised in the European Union, and is widely used for diabetes care.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2526479\">Wikidata Q2526479</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>liraglutide</td></tr><tr><td>ATC codes:</td><td>A10BJ02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06655\">DB06655</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:71193\">71193</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2526479\">Q2526479</a></td></tr><tr><td>molar mass:</td><td>3751 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>-3.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
