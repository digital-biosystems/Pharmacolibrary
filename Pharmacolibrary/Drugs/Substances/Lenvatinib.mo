  annotation (Documentation(info = "<html><body><p>Lenvatinib is a protein kinase inhibitor used to treat certain cancers, including thyroid cancer and kidney (renal cell) cancer. It is authorised in the European Union and is used in cancer care.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6523413\">Wikidata Q6523413</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>lenvatinib</td></tr><tr><td>ATC codes:</td><td>L01EX08, L01XE, L01XE29</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09078\">DB09078</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9823820\">9823820</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:85994\">85994</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6523413\">Q6523413</a></td></tr><tr><td>formula:</td><td>C21H19ClN4O4</td></tr><tr><td>molar mass:</td><td>426.857 g/mol (PubChem CID 9823820)</td></tr><tr><td>logP:</td><td>2.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
