  annotation (Documentation(info = "<html><body><p>Pembrolizumab is a monoclonal antibody that blocks PD-1 and is used to treat several cancers, including melanoma, lung, bladder, kidney, head and neck, and endometrial cancers. It is approved and widely used, including an authorised product in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q13896859&quot;>Wikidata Q13896859</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>pembrolizumab</td></tr><tr><td>ATC codes:</td><td>L01FF02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09037&quot;>DB09037</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/168009853&quot;>168009853</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q13896859&quot;>Q13896859</a></td></tr><tr><td>formula:</td><td>C85H170N4OS</td></tr><tr><td>molar mass:</td><td>1296.38 g/mol (PubChem)</td></tr></table></body></html>"));
end Pembrolizumab;
