  annotation (Documentation(info = "<html><body><p>Noxytiolin is a local anti-infective agent used in irrigating solutions to treat or prevent infection. It is an approved drug, though information on how widely it is used today is limited.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7067325&quot;>Wikidata Q7067325</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>noxytiolin</td></tr><tr><td>ATC codes:</td><td>B05CA07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13838&quot;>DB13838</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5251503&quot;>5251503</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134756&quot;>134756</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7067325&quot;>Q7067325</a></td></tr><tr><td>formula:</td><td>C3H8N2OS</td></tr><tr><td>molar mass:</td><td>120.17 g/mol (PubChem)</td></tr></table></body></html>"));
