  annotation (Documentation(info = "<html><body><p>Lodoxamide is an antiallergic eye medicine used to treat allergic eye conditions such as conjunctivitis and vernal keratoconjunctivitis. It is an approved drug, used as ophthalmic (eye) drops.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6666510&quot;>Wikidata Q6666510</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>lodoxamide</td></tr><tr><td>ATC codes:</td><td>S01GX05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06794&quot;>DB06794</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/44564&quot;>44564</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135333&quot;>135333</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6666510&quot;>Q6666510</a></td></tr><tr><td>formula:</td><td>C11H6ClN3O6</td></tr><tr><td>molar mass:</td><td>311.634 g/mol (PubChem)</td></tr></table></body></html>"));
