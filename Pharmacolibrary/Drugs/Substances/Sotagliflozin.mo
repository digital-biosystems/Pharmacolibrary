  annotation (Documentation(info = "<html><body><p>Sotagliflozin is a blood glucose-lowering drug of the gliflozin class developed for type 1 diabetes. It has been investigated and, in some places, approved, but its marketing authorisation in the European Union was withdrawn, so it is not in routine use there.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27088840\">Wikidata Q27088840</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>sotagliflozin</td></tr><tr><td>ATC codes:</td><td>A10BK06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12713\">DB12713</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/24831714\">24831714</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27088840\">Q27088840</a></td></tr><tr><td>formula:</td><td>C21H25ClO5S</td></tr><tr><td>molar mass:</td><td>424.936 g/mol (PubChem CID 24831714)</td></tr><tr><td>logP:</td><td>3.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Sotagliflozin;
