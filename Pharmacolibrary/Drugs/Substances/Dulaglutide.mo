  annotation (Documentation(info = "<html><body><p>Dulaglutide is a GLP-1 analogue anti-diabetic medicine used to lower blood glucose, mainly in type 2 diabetes. It is authorised in the European Union and is used widely as an approved diabetes treatment.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q21011228&quot;>Wikidata Q21011228</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>dulaglutide</td></tr><tr><td>ATC codes:</td><td>A10BJ05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09045&quot;>DB09045</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q21011228&quot;>Q21011228</a></td></tr><tr><td>molar mass:</td><td>59669.8 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
