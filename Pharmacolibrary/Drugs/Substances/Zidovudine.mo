  annotation (Documentation(info = "<html><body><p>Zidovudine (AZT) is an antiviral nucleoside analogue used to treat HIV infection and AIDS. It remains an approved medicine, is included on the WHO essential medicines list, and is used worldwide, often in combination with other HIV drugs.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q198504&quot;>Wikidata Q198504</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>zidovudine</td></tr><tr><td>ATC codes:</td><td>J05AF01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00495&quot;>DB00495</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/35370&quot;>35370</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:10110&quot;>10110</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q198504&quot;>Q198504</a></td></tr><tr><td>formula:</td><td>C10H13N5O4</td></tr><tr><td>molar mass:</td><td>267.245 g/mol (PubChem)</td></tr></table></body></html>"));
