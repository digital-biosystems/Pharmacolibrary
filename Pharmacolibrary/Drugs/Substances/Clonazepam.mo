    logP = 2.4);
  annotation (Documentation(info = "<html><body><p>Clonazepam is a benzodiazepine anticonvulsant used to treat epilepsy, including myoclonic and childhood absence epilepsy, as well as panic disorder, anxiety, insomnia, and restless legs syndrome. It is an approved medicine used widely in clinical practice, though it carries a boxed warning and also has investigational and illicit uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q407988&quot;>Wikidata Q407988</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>clonazepam</td></tr><tr><td>ATC codes:</td><td>N03AE01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01068&quot;>DB01068</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2802&quot;>2802</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3756&quot;>3756</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q407988&quot;>Q407988</a></td></tr><tr><td>formula:</td><td>C15H10ClN3O3</td></tr><tr><td>molar mass:</td><td>315.713 g/mol (PubChem)</td></tr></table></body></html>"));
