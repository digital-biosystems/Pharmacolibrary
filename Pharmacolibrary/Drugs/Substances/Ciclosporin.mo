within Pharmacolibrary.Drugs.Substances;
package Ciclosporin "ciclosporin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "ciclosporin",
    atcCodes = {"L04AD01", "S01XA18"},
    drugbankId = "DB00091",
    pubchemCid = "5284373",
    wikidataId = "Q367700",
    formula = "C62H111N11O12",
    M = 1.20263,
    logP = 7.5);
  annotation (Documentation(info = "<html><body><p>Ciclosporin is an immunosuppressant used to treat autoimmune conditions such as rheumatoid arthritis, systemic lupus erythematosus, myasthenia gravis, and graft-versus-host disease, as well as certain eye conditions like dry eye syndromes. It is widely used and is included on the WHO essential medicines list; several products are authorised in the European Union, mainly for eye conditions, and it is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q367700\">Wikidata Q367700</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>ciclosporin</td></tr><tr><td>ATC codes:</td><td>L04AD01, S01XA18</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00091\">DB00091</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5284373\">5284373</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q367700\">Q367700</a></td></tr><tr><td>formula:</td><td>C62H111N11O12</td></tr><tr><td>molar mass:</td><td>1202.63 g/mol (PubChem CID 5284373)</td></tr><tr><td>logP:</td><td>7.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Ciclosporin;
