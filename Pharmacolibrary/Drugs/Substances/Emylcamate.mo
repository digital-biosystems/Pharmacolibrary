    logP = 1.5);
  annotation (Documentation(info = "<html><body><p>Emylcamate is a carbamate-class anxiolytic developed for the treatment of anxiety. It is no longer an established medicine: it is listed only as an experimental drug and has no authorisation from the European Medicines Agency, so it appears to be essentially obsolete.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q378997&quot;>Wikidata Q378997</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>emylcamate</td></tr><tr><td>ATC codes:</td><td>N05BC03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13572&quot;>DB13572</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6526&quot;>6526</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134769&quot;>134769</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q378997&quot;>Q378997</a></td></tr><tr><td>formula:</td><td>C7H15NO2</td></tr><tr><td>molar mass:</td><td>145.202 g/mol (PubChem)</td></tr></table></body></html>"));
