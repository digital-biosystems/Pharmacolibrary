  annotation (Documentation(info = "<html><body><p>Lurasidone is an antipsychotic used to treat schizophrenia and related psychotic and mood conditions such as schizoaffective disorder. It is an approved medicine, authorised in the European Union for schizophrenia, and is also being investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q416992\">Wikidata Q416992</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>lurasidone</td></tr><tr><td>ATC codes:</td><td>N05AE05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08815\">DB08815</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/213046\">213046</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:70735\">70735</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q416992\">Q416992</a></td></tr><tr><td>formula:</td><td>C28H36N4O2S</td></tr><tr><td>molar mass:</td><td>492.682 g/mol (PubChem CID 213046)</td></tr><tr><td>logP:</td><td>5.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
