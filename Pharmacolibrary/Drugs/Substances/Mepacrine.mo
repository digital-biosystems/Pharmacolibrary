  annotation (Documentation(info = "<html><body><p>Mepacrine (quinacrine) is an antiprotozoal drug that has been used against giardiasis and Plasmodium falciparum malaria. It is currently classed as investigational and is not an approved treatment in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q417208&quot;>Wikidata Q417208</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mepacrine</td></tr><tr><td>ATC codes:</td><td>P01AX05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01103&quot;>DB01103</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/237&quot;>237</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q417208&quot;>Q417208</a></td></tr><tr><td>formula:</td><td>C23H30ClN3O</td></tr><tr><td>molar mass:</td><td>399.963 g/mol (PubChem)</td></tr></table></body></html>"));
end Mepacrine;
