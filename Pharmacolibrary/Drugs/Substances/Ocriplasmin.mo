  annotation (Documentation(info = "<html><body><p>Ocriplasmin was an ophthalmological drug used for retinal disease. It was authorised in the European Union but has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2212643\">Wikidata Q2212643</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>ocriplasmin</td></tr><tr><td>ATC codes:</td><td>S01XA22</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08888\">DB08888</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2212643\">Q2212643</a></td></tr><tr><td>molar mass:</td><td>27250 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
