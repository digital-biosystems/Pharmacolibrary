    logP = 3.2);
  annotation (Documentation(info = "<html><body><p>Faricimab is a monoclonal antibody used to treat eye conditions involving abnormal blood vessel growth, such as wet macular degeneration, macular edema, and complications of diabetes. It is authorised in the European Union and is also under investigation for further uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q60785557\">Wikidata Q60785557</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>faricimab</td></tr><tr><td>ATC codes:</td><td>S01LA09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB15303\">DB15303</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q60785557\">Q60785557</a></td></tr><tr><td>molar mass:</td><td>440 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>3.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Faricimab;
