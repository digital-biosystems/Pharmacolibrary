  annotation (Documentation(info = "<html><body><p>Octenidine is an antiseptic (anti-infective) agent used for local treatment, such as in the mouth and throat. It is classified as investigational in DrugBank and has no European Union marketing authorisation, so it is not an approved medicine there.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27285931\">Wikidata Q27285931</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>octenidine</td></tr><tr><td>ATC codes:</td><td>A01AB24, R02AA21</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12624\">DB12624</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/51167\">51167</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135826\">135826</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27285931\">Q27285931</a></td></tr><tr><td>formula:</td><td>C36H62N4</td></tr><tr><td>molar mass:</td><td>550.92 g/mol (PubChem CID 51167)</td></tr><tr><td>logP:</td><td>11 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Octenidine;
