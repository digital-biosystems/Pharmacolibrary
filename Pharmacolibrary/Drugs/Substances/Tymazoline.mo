  annotation (Documentation(info = "<html><body><p>Tymazoline is a sympathomimetic imidazoline that has been used as a topical nasal decongestant. It is currently regarded as experimental, with no authorised marketing in the European Union, so it does not appear to be in routine clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q9363588\">Wikidata Q9363588</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tymazoline</td></tr><tr><td>ATC codes:</td><td>R01AA13</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08803\">DB08803</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/34154\">34154</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134947\">134947</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q9363588\">Q9363588</a></td></tr><tr><td>formula:</td><td>C14H20N2O</td></tr><tr><td>molar mass:</td><td>232.327 g/mol (PubChem CID 34154)</td></tr><tr><td>logP:</td><td>2.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Tymazoline;
