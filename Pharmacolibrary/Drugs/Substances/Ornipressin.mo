  annotation (Documentation(info = "<html><body><p>Ornipressin is a vasopressin analogue with vasoconstrictor and antihemorrhagic properties, classified among posterior pituitary lobe hormones. It appears to be only an experimental agent, with no authorised marketing identified in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3038432&quot;>Wikidata Q3038432</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ornipressin</td></tr><tr><td>ATC codes:</td><td>H01BA05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13464&quot;>DB13464</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/14257660&quot;>14257660</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:136020&quot;>136020</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3038432&quot;>Q3038432</a></td></tr><tr><td>formula:</td><td>C45H63N13O12S2</td></tr><tr><td>molar mass:</td><td>1042.2 g/mol (PubChem)</td></tr></table></body></html>"));
