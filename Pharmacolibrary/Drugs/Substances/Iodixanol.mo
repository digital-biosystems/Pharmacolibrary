  annotation (Documentation(info = "<html><body><p>Iodixanol is an iodinated X-ray contrast agent used to visualise tissues and blood vessels during imaging procedures. It is an approved, low-osmolar, water-soluble contrast medium and is widely used in medical imaging.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2419291&quot;>Wikidata Q2419291</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>iodixanol</td></tr><tr><td>ATC codes:</td><td>V08AB09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01249&quot;>DB01249</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3724&quot;>3724</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31705&quot;>31705</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2419291&quot;>Q2419291</a></td></tr><tr><td>formula:</td><td>C35H44I6N6O15</td></tr><tr><td>molar mass:</td><td>1550.16 g/mol (PubChem)</td></tr></table></body></html>"));
