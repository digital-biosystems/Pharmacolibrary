    M = 0.074548);
  annotation (Documentation(info = "<html><body><p>Potassium chloride is used to treat or prevent low potassium levels in the blood (hypokalemia). It is widely used as a mineral supplement and as an additive in intravenous solutions, and is included on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q184630\">Wikidata Q184630</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>potassium chloride</td></tr><tr><td>ATC codes:</td><td>A12BA01, B05XA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00761\">DB00761</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4873\">4873</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32588\">32588</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q184630\">Q184630</a></td></tr><tr><td>formula:</td><td>ClK</td></tr><tr><td>molar mass:</td><td>74.548 g/mol (PubChem CID 4873)</td></tr></table></body></html>"));
end PotassiumChloride;
