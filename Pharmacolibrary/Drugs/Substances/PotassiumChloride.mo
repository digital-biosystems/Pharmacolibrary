within Pharmacolibrary.Drugs.Substances;
package PotassiumChloride "potassium chloride"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "potassium chloride",
    atcCodes = {"A12BA01", "B05XA01"},
    drugbankId = "DB00761",
    pubchemCid = "4873",
    chebiId = "32588",
