    logP = 1.8);
  annotation (Documentation(info = "<html><body><p>Diatrizoic acid is an iodinated X-ray contrast agent used to make body structures visible during imaging examinations. It is an approved medicine, including for veterinary use, and appears on the WHO list of essential medicines, so it remains widely available.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q411511\">Wikidata Q411511</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>diatrizoic acid</td></tr><tr><td>ATC codes:</td><td>V08AA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00271\">DB00271</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2140\">2140</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:53691\">53691</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q411511\">Q411511</a></td></tr><tr><td>formula:</td><td>C11H9I3N2O4</td></tr><tr><td>molar mass:</td><td>613.903 g/mol (PubChem CID 2140)</td></tr><tr><td>logP:</td><td>1.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
