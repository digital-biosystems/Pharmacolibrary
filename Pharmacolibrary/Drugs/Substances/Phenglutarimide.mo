  annotation (Documentation(info = "<html><body><p>Phenglutarimide is an anticholinergic drug that was classified for the treatment of Parkinson's disease. It appears to be little used today, being regarded as an experimental compound with no current marketing authorisation.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q999780\">Wikidata Q999780</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>phenglutarimide</td></tr><tr><td>ATC codes:</td><td>N04AA09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13413\">DB13413</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/102669\">102669</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135195\">135195</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q999780\">Q999780</a></td></tr><tr><td>formula:</td><td>C17H24N2O2</td></tr><tr><td>molar mass:</td><td>288.391 g/mol (PubChem CID 102669)</td></tr><tr><td>logP:</td><td>2.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
