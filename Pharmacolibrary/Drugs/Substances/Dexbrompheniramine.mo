  annotation (Documentation(info = "<html><body><p>Dexbrompheniramine is an antihistamine (H1 antagonist) used for allergic conditions such as sinusitis. It is an approved drug, available in some countries as a systemic antihistamine, though not authorised centrally in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5268318&quot;>Wikidata Q5268318</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dexbrompheniramine</td></tr><tr><td>ATC codes:</td><td>R06AB06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00405&quot;>DB00405</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/16960&quot;>16960</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:59269&quot;>59269</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5268318&quot;>Q5268318</a></td></tr><tr><td>formula:</td><td>C16H19BrN2</td></tr><tr><td>molar mass:</td><td>319.246 g/mol (PubChem)</td></tr></table></body></html>"));
