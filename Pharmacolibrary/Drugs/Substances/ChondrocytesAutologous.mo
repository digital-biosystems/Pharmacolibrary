  annotation (Documentation(info = "<html><body><p>Autologous cultured chondrocytes are a cell therapy used to treat cartilage defects in the knee. It is an approved medicine, though its use appears limited, with an EU marketing authorisation that has since expired.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q28852345&quot;>Wikidata Q28852345</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>chondrocytes, autologous</td></tr><tr><td>ATC codes:</td><td>M09AX02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB10997&quot;>DB10997</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q28852345&quot;>Q28852345</a></td></tr></table></body></html>"));
end ChondrocytesAutologous;
