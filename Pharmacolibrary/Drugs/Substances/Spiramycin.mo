  annotation (Documentation(info = "<html><body><p>Spiramycin is a macrolide antibiotic used to treat bacterial infections and has also been used as a coccidiostat. It remains an approved antibacterial for systemic use, available alone and in combination with other antibiotics, though it has been withdrawn in some markets.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q422265\">Wikidata Q422265</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>spiramycin</td></tr><tr><td>ATC codes:</td><td>J01FA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06145\">DB06145</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6440717\">6440717</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:85260\">85260</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q422265\">Q422265</a></td></tr><tr><td>formula:</td><td>C43H74N2O14</td></tr><tr><td>molar mass:</td><td>843.065 g/mol (PubChem CID 6440717)</td></tr><tr><td>logP:</td><td>2.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
