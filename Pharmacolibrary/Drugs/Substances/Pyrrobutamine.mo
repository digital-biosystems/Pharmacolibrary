  annotation (Documentation(info = "<html><body><p>Pyrrobutamine is an antihistamine for systemic use, historically used to treat allergic conditions. It appears to be no longer in practical use, being listed only as an experimental drug.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6676374\">Wikidata Q6676374</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pyrrobutamine</td></tr><tr><td>ATC codes:</td><td>R06AX08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13846\">DB13846</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/8669\">8669</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135334\">135334</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6676374\">Q6676374</a></td></tr><tr><td>formula:</td><td>C20H22ClN</td></tr><tr><td>molar mass:</td><td>311.853 g/mol (PubChem CID 8669)</td></tr><tr><td>logP:</td><td>5.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
