  annotation (Documentation(info = "<html><body><p>Saccharomyces boulardii is a probiotic yeast used to help treat diarrhoea. It is an approved probiotic available as a dietary supplement and medicine in many countries, and is also being studied for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q135368\">Wikidata Q135368</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>saccharomyces boulardii</td></tr><tr><td>ATC codes:</td><td>A07FA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11017\">DB11017</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q135368\">Q135368</a></td></tr></table></body></html>"));
end SaccharomycesBoulardii;
