    logP = -4.3);
  annotation (Documentation(info = "<html><body><p>Lactulose is a disaccharide laxative used to treat constipation and, in higher doses, hepatic encephalopathy and hepatic coma. It is widely used and appears on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q422689&quot;>Wikidata Q422689</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>lactulose</td></tr><tr><td>ATC codes:</td><td>A06AD11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00581&quot;>DB00581</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/11333&quot;>11333</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6359&quot;>6359</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q422689&quot;>Q422689</a></td></tr><tr><td>formula:</td><td>C12H22O11</td></tr><tr><td>molar mass:</td><td>342.297 g/mol (PubChem)</td></tr></table></body></html>"));
end Lactulose;
