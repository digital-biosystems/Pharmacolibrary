  annotation (Documentation(info = "<html><body><p>Copper usnate is a salt classified as a gynecological antiinfective and antiseptic. It has only experimental status and no authorised marketing is recorded, so its current use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5168808\">Wikidata Q5168808</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>copper usnate</td></tr><tr><td>ATC codes:</td><td>G01AX15</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13830\">DB13830</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5168808\">Q5168808</a></td></tr><tr><td>formula:</td><td>C18H14CuO7</td></tr><tr><td>molar mass:</td><td>405.849 g/mol (knowledgebase (DrugBank calculated))</td></tr></table></body></html>"));
end CopperUsnate;
