  annotation (Documentation(info = "<html><body><p>Itopride is a prokinetic drug used to treat functional gastrointestinal disorders. It is not approved in the European Union or the United States and remains investigational there, though it is used in some Asian countries.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4409774&quot;>Wikidata Q4409774</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>itopride</td></tr><tr><td>ATC codes:</td><td>A03FA07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB04924&quot;>DB04924</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3792&quot;>3792</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:94809&quot;>94809</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4409774&quot;>Q4409774</a></td></tr><tr><td>formula:</td><td>C20H26N2O4</td></tr><tr><td>molar mass:</td><td>358.438 g/mol (PubChem)</td></tr></table></body></html>"));
