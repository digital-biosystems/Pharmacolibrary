  annotation (Documentation(info = "<html><body><p>Atezolizumab is a monoclonal antibody that blocks PD-L1 and is used to treat several cancers, including bladder, lung, breast, and colorectal cancers. It is approved and authorised in the European Union, where it is used in cancer care.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q20707748&quot;>Wikidata Q20707748</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>atezolizumab</td></tr><tr><td>ATC codes:</td><td>L01FF05, L01XC32</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11595&quot;>DB11595</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q20707748&quot;>Q20707748</a></td></tr><tr><td>molar mass:</td><td>145000 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Atezolizumab;
