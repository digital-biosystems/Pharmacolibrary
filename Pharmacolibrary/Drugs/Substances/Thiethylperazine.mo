  annotation (Documentation(info = "<html><body><p>Thiethylperazine is a phenothiazine antiemetic used to treat vomiting and vertigo of central nervous system origin. It has been withdrawn and is no longer in general use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q372725\">Wikidata Q372725</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>thiethylperazine</td></tr><tr><td>ATC codes:</td><td>R06AD03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00372\">DB00372</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5440\">5440</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9544\">9544</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q372725\">Q372725</a></td></tr><tr><td>formula:</td><td>C22H29N3S2</td></tr><tr><td>molar mass:</td><td>399.615 g/mol (PubChem CID 5440)</td></tr><tr><td>logP:</td><td>5.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
