  annotation (Documentation(info = "<html><body><p>Rocuronium is a non-depolarising neuromuscular blocking agent used to relax muscles, for example during surgery. It is an approved medicine and is widely used in anaesthesia, mainly in hospital settings.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q185331&quot;>Wikidata Q185331</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Rocuronium</td></tr><tr><td>ATC codes:</td><td>M03AC09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00728&quot;>DB00728</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/441290&quot;>441290</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q185331&quot;>Q185331</a></td></tr><tr><td>formula:</td><td>C32H53N2O4+</td></tr><tr><td>molar mass:</td><td>529.786 g/mol (PubChem)</td></tr></table></body></html>"));
end Rocuronium;
