    M = 0.529786);
  annotation (Documentation(info = "<html><body><p>Rocuronium is a non-depolarising neuromuscular blocking agent used to relax muscles, for example during surgery. It is an approved medicine and is widely used in anaesthesia, mainly in hospital settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q185331\">Wikidata Q185331</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Rocuronium</td></tr><tr><td>ATC codes:</td><td>M03AC09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00728\">DB00728</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/441290\">441290</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q185331\">Q185331</a></td></tr><tr><td>formula:</td><td>C32H53N2O4+</td></tr><tr><td>molar mass:</td><td>529.786 g/mol (PubChem CID 441290)</td></tr></table></body></html>"));
end Rocuronium;
