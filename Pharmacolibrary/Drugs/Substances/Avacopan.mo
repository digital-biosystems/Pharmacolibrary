within Pharmacolibrary.Drugs.Substances;
package Avacopan "avacopan"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "avacopan",
    atcCodes = {"L04AJ05"},
    drugbankId = "DB15011",
    pubchemCid = "49841217",
    wikidataId = "Q27285470",
    formula = "C33H35F4N3O2",
