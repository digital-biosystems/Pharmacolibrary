    logP = 7.2);
  annotation (Documentation(info = "<html><body><p>Avacopan is a complement inhibitor used to treat ANCA-associated vasculitis, including microscopic polyangiitis and granulomatosis with polyangiitis (formerly Wegener's granulomatosis). It is an approved medicine authorised in the European Union, though it remains a relatively specialised treatment.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27285470\">Wikidata Q27285470</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>avacopan</td></tr><tr><td>ATC codes:</td><td>L04AJ05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB15011\">DB15011</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/49841217\">49841217</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27285470\">Q27285470</a></td></tr><tr><td>formula:</td><td>C33H35F4N3O2</td></tr><tr><td>molar mass:</td><td>581.654 g/mol (PubChem CID 49841217)</td></tr><tr><td>logP:</td><td>7.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Avacopan;
