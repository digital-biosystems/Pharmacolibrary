    wikidataId = "Q85125058");
  annotation (Documentation(info = "<html><body><p>Begelomab is a monoclonal antibody with immunosuppressive activity investigated for graft-versus-host disease in patients undergoing hematopoietic stem cell transplantation. It remains investigational; its marketing application in the European Union was withdrawn, so it is not an approved medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q85125058&quot;>Wikidata Q85125058</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>begelomab</td></tr><tr><td>ATC codes:</td><td>L04AA35, L04AG07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13241&quot;>DB13241</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q85125058&quot;>Q85125058</a></td></tr></table></body></html>"));
end Begelomab;
