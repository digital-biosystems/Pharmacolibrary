  annotation (Documentation(info = "<html><body><p>Acipimox is a lipid-lowering agent used to treat high blood lipid levels. It is a nicotinic acid derivative that has been approved, but it is not authorised in the European Union and appears to be used only in a limited number of countries.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2342544&quot;>Wikidata Q2342544</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>acipimox</td></tr><tr><td>ATC codes:</td><td>C10AD06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09055&quot;>DB09055</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5310993&quot;>5310993</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:94688&quot;>94688</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2342544&quot;>Q2342544</a></td></tr><tr><td>formula:</td><td>C6H6N2O3</td></tr><tr><td>molar mass:</td><td>154.125 g/mol (PubChem)</td></tr></table></body></html>"));
