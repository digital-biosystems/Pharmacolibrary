  annotation (Documentation(info = "<html><body><p>Satranidazole is a nitroimidazole antiprotozoal agent developed for the treatment of protozoal infections such as amoebiasis. It remains an experimental drug and does not appear to have an established, widely authorised place in therapy.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27260233&quot;>Wikidata Q27260233</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>satranidazole</td></tr><tr><td>ATC codes:</td><td>P01AB08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB19950&quot;>DB19950</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/41841&quot;>41841</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27260233&quot;>Q27260233</a></td></tr><tr><td>formula:</td><td>C8H11N5O5S</td></tr><tr><td>molar mass:</td><td>289.266 g/mol (PubChem)</td></tr></table></body></html>"));
end Satranidazole;
