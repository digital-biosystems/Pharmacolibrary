  annotation (Documentation(info = "<html><body><p>Ticlopidine is an antiplatelet drug that inhibits platelet aggregation and is used to prevent blood clots. It is an approved medicine, though it has largely been replaced by newer antiplatelet agents in routine practice.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q420571\">Wikidata Q420571</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ticlopidine</td></tr><tr><td>ATC codes:</td><td>B01AC05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00208\">DB00208</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5472\">5472</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9588\">9588</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q420571\">Q420571</a></td></tr><tr><td>formula:</td><td>C14H14ClNS</td></tr><tr><td>molar mass:</td><td>263.783 g/mol (PubChem CID 5472)</td></tr><tr><td>logP:</td><td>3.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
