  annotation (Documentation(info = "<html><body><p>Zopiclone is a hypnotic and sedative medicine used to treat sleep disorders such as insomnia. It is an approved drug, widely used as a short-term sleeping aid in many countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q220426\">Wikidata Q220426</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>zopiclone</td></tr><tr><td>ATC codes:</td><td>N05CF01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01198\">DB01198</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5735\">5735</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32315\">32315</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q220426\">Q220426</a></td></tr><tr><td>formula:</td><td>C17H17ClN6O3</td></tr><tr><td>molar mass:</td><td>388.812 g/mol (PubChem CID 5735)</td></tr><tr><td>logP:</td><td>0.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
