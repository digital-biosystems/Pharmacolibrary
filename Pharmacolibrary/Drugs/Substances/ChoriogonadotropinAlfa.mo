    M = 25.7197);
  annotation (Documentation(info = "<html><body><p>Choriogonadotropin alfa is a recombinant form of the hormone human chorionic gonadotropin, used to treat female infertility, including anovulation and assisted reproduction techniques. It is authorised in the European Union and used in fertility treatment, though its use is typically managed within specialised reproductive medicine settings.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q407172&quot;>Wikidata Q407172</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>choriogonadotropin alfa</td></tr><tr><td>ATC codes:</td><td>G03GA08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00097&quot;>DB00097</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q407172&quot;>Q407172</a></td></tr><tr><td>molar mass:</td><td>25719.7 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end ChoriogonadotropinAlfa;
