    logP = -0.1);
  annotation (Documentation(info = "<html><body><p>Furazolidone is a nitrofuran antiinfective used against protozoal and bacterial infections, including giardiasis and other intestinal protozoal diseases. It is no longer approved for human use and is now used mainly in veterinary medicine, with any human application limited to investigational settings.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q139540184&quot;>Wikidata Q139540184</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>furazolidone</td></tr><tr><td>ATC codes:</td><td>G01AX06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00614&quot;>DB00614</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3435&quot;>3435</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:5195&quot;>5195</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q139540184&quot;>Q139540184</a></td></tr><tr><td>formula:</td><td>C8H7N3O5</td></tr><tr><td>molar mass:</td><td>225.16 g/mol (PubChem)</td></tr></table></body></html>"));
end Furazolidone;
