within Pharmacolibrary.Drugs.Substances;
package Furazolidone "furazolidone"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "furazolidone",
    atcCodes = {"G01AX06"},
    drugbankId = "DB00614",
    pubchemCid = "3435",
    chebiId = "5195",
    wikidataId = "Q2467555",
    formula = "C8H7N3O5",
    M = 0.22516,
    logP = -0.1);
  annotation (Documentation(info = "<html><body><p>Furazolidone is a nitrofuran antimicrobial used against protozoal and bacterial infections such as giardiasis, cholera, shigellosis, and staphylococcal or gram-negative infections. It is no longer approved for human use and is now used mainly in veterinary medicine, with no European Union authorisation.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2467555\">Wikidata Q2467555</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>furazolidone</td></tr><tr><td>ATC codes:</td><td>G01AX06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00614\">DB00614</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3435\">3435</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:5195\">5195</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2467555\">Q2467555</a></td></tr><tr><td>formula:</td><td>C8H7N3O5</td></tr><tr><td>molar mass:</td><td>225.16 g/mol (PubChem CID 3435)</td></tr><tr><td>logP:</td><td>-0.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Furazolidone;
