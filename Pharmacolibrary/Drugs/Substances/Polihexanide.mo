within Pharmacolibrary.Drugs.Substances;
package Polihexanide "polihexanide"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "polihexanide",
    atcCodes = {"D08AC05", "S01AX24"},
    drugbankId = "DB12277",
    wikidataId = "Q408205");
  annotation (Documentation(info = "<html><body><p>Polihexanide is an antiseptic and disinfectant used to treat skin conditions and, in the European Union, an authorised eye medicine for Acanthamoeba keratitis. It is approved and used mainly as a topical antiseptic and as an ophthalmic antiinfective, with an authorised product available in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q408205\">Wikidata Q408205</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>polihexanide</td></tr><tr><td>ATC codes:</td><td>D08AC05, S01AX24</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12277\">DB12277</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q408205\">Q408205</a></td></tr></table></body></html>"));
end Polihexanide;
