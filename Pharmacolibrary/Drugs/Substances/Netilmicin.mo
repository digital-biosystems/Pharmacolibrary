  annotation (Documentation(info = "<html><body><p>Netilmicin is an aminoglycoside antibiotic used to treat serious bacterial infections, including eye infections. It is an approved medicine and is used mainly in hospital settings for severe infections, given by injection, with ophthalmic formulations also available.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2553496&quot;>Wikidata Q2553496</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>netilmicin</td></tr><tr><td>ATC codes:</td><td>J01GB07, S01AA23</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00955&quot;>DB00955</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/441306&quot;>441306</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7528&quot;>7528</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2553496&quot;>Q2553496</a></td></tr><tr><td>formula:</td><td>C21H41N5O7</td></tr><tr><td>molar mass:</td><td>475.587 g/mol (PubChem)</td></tr></table></body></html>"));
