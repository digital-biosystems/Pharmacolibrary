  annotation (Documentation(info = "<html><body><p>Rucaparib is a PARP inhibitor anticancer drug used to treat ovarian, fallopian tube, and peritoneal cancers. It is authorised in the European Union and also has approved and investigational uses elsewhere.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7376558\">Wikidata Q7376558</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>rucaparib</td></tr><tr><td>ATC codes:</td><td>L01XK03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12332\">DB12332</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9931954\">9931954</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134689\">134689</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7376558\">Q7376558</a></td></tr><tr><td>formula:</td><td>C19H18FN3O</td></tr><tr><td>molar mass:</td><td>323.371 g/mol (PubChem CID 9931954)</td></tr><tr><td>logP:</td><td>2.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
