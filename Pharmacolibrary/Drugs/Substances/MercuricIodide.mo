    logP = 0);
  annotation (Documentation(info = "<html><body><p>Mercuric iodide is a mercury compound that has been classified as a mercurial antiseptic and disinfectant for use on the skin. It is currently regarded as an experimental substance rather than an established medicine, and no regulatory authorisation is recorded.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q414632&quot;>Wikidata Q414632</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mercuric iodide</td></tr><tr><td>ATC codes:</td><td>D08AK30</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB04445&quot;>DB04445</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/24485&quot;>24485</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:49659&quot;>49659</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q414632&quot;>Q414632</a></td></tr><tr><td>formula:</td><td>HgI2</td></tr><tr><td>molar mass:</td><td>454.39 g/mol (PubChem)</td></tr></table></body></html>"));
end MercuricIodide;
