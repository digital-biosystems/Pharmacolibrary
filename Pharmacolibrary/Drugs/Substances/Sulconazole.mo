within Pharmacolibrary.Drugs.Substances;
package Sulconazole "sulconazole"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "sulconazole",
    atcCodes = {"D01AC09"},
    drugbankId = "DB06820",
    pubchemCid = "5318",
    chebiId = "77776",
    wikidataId = "Q2392530",
    formula = "C18H15Cl3N2S",
    M = 0.397742,
    logP = 6.1);
  annotation (Documentation(info = "<html><body><p>Sulconazole is a topical antifungal used to treat fungal skin infections such as tinea, tinea pedis, tinea cruris, pityriasis versicolor, and cutaneous candidiasis. It is an approved topical antifungal, though it is not authorised in the European Union and appears to be used only in some countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2392530\">Wikidata Q2392530</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sulconazole</td></tr><tr><td>ATC codes:</td><td>D01AC09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06820\">DB06820</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5318\">5318</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:77776\">77776</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2392530\">Q2392530</a></td></tr><tr><td>formula:</td><td>C18H15Cl3N2S</td></tr><tr><td>molar mass:</td><td>397.742 g/mol (PubChem CID 5318)</td></tr><tr><td>logP:</td><td>6.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Sulconazole;
