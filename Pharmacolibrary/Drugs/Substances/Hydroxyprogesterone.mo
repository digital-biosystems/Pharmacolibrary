  annotation (Documentation(info = "<html><body><p>Hydroxyprogesterone (17α-hydroxyprogesterone) is a progestogen steroid that has been used or studied for conditions such as endometriosis, amenorrhea, and uterine cancer. It is currently considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q175901&quot;>Wikidata Q175901</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>hydroxyprogesterone</td></tr><tr><td>ATC codes:</td><td>G03DA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB14570&quot;>DB14570</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6238&quot;>6238</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:17252&quot;>17252</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q175901&quot;>Q175901</a></td></tr><tr><td>formula:</td><td>C21H30O3</td></tr><tr><td>molar mass:</td><td>330.468 g/mol (PubChem)</td></tr></table></body></html>"));
