  annotation (Documentation(info = "<html><body><p>Tetroxoprim is an anti-infective agent classified among combinations of sulfonamides and trimethoprim, used as an antibacterial for systemic infections. It is considered experimental and does not appear to be an approved medicine in the European Union, so its current clinical use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q937551&quot;>Wikidata Q937551</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Tetroxoprim</td></tr><tr><td>ATC codes:</td><td>J01EE06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB15976&quot;>DB15976</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/65450&quot;>65450</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135420&quot;>135420</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q937551&quot;>Q937551</a></td></tr><tr><td>formula:</td><td>C16H22N4O4</td></tr><tr><td>molar mass:</td><td>334.376 g/mol (PubChem)</td></tr></table></body></html>"));
