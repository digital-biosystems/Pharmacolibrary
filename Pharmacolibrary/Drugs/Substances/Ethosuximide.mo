  annotation (Documentation(info = "<html><body><p>Ethosuximide is an anticonvulsant used to treat epilepsy, especially childhood absence epilepsy. It is an approved medicine and appears on the WHO essential medicines list, so it remains widely used.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q421567\">Wikidata Q421567</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ethosuximide</td></tr><tr><td>ATC codes:</td><td>N03AD01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00593\">DB00593</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3291\">3291</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4887\">4887</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q421567\">Q421567</a></td></tr><tr><td>formula:</td><td>C7H11NO2</td></tr><tr><td>molar mass:</td><td>141.17 g/mol (PubChem CID 3291)</td></tr><tr><td>logP:</td><td>0.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
