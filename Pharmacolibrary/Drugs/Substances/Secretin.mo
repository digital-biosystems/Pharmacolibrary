  annotation (Documentation(info = "<html><body><p>Secretin is a hormone used as a diagnostic agent in tests of pancreatic function and in evaluating conditions such as exocrine pancreatic insufficiency and gastrinoma. It is an approved diagnostic agent, used mainly in specialised testing rather than as a routine treatment.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q422301\">Wikidata Q422301</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>secretin</td></tr><tr><td>ATC codes:</td><td>V04CK01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09532\">DB09532</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135913\">135913</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q422301\">Q422301</a></td></tr><tr><td>molar mass:</td><td>3056.4 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>-13.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
