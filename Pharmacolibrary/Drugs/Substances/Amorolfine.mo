  annotation (Documentation(info = "<html><body><p>Amorolfine is a topical antifungal drug used to treat fungal skin infections (dermatomycosis). It is classified for dermatological topical use and remains an approved medicine, though it is not authorised centrally in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q123195\">Wikidata Q123195</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>amorolfine</td></tr><tr><td>ATC codes:</td><td>D01AE16</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09056\">DB09056</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/54260\">54260</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:599440\">599440</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q123195\">Q123195</a></td></tr><tr><td>formula:</td><td>C21H35NO</td></tr><tr><td>molar mass:</td><td>317.517 g/mol (PubChem CID 54260)</td></tr><tr><td>logP:</td><td>5.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
