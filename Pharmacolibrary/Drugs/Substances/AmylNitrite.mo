    logP = 1.7);
  annotation (Documentation(info = "<html><body><p>Amyl nitrite is a vasodilator that has been used to treat angina pectoris and is classified as an antidote. It is an approved drug, though its medicinal use is now limited, with cyanide poisoning treatment being a remaining antidote role.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q412350&quot;>Wikidata Q412350</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>amyl nitrite</td></tr><tr><td>ATC codes:</td><td>V03AB22</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01612&quot;>DB01612</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/10026&quot;>10026</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:55344&quot;>55344</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q412350&quot;>Q412350</a></td></tr><tr><td>formula:</td><td>C5H11NO2</td></tr><tr><td>molar mass:</td><td>117.148 g/mol (PubChem)</td></tr></table></body></html>"));
