  annotation (Documentation(info = "<html><body><p>Phenacetin is a non-opioid painkiller and fever reducer that was once used to treat pain and high temperature. It has been withdrawn from the market because it was found to be carcinogenic and harmful to the kidneys.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q419175\">Wikidata Q419175</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>phenacetin</td></tr><tr><td>ATC codes:</td><td>N02BE03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB03783\">DB03783</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4754\">4754</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8050\">8050</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q419175\">Q419175</a></td></tr><tr><td>formula:</td><td>C10H13NO2</td></tr><tr><td>molar mass:</td><td>179.219 g/mol (PubChem CID 4754)</td></tr><tr><td>logP:</td><td>1.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
