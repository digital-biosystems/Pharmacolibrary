  annotation (Documentation(info = "<html><body><p>Clascoterone is a topical steroid-based medicine used to treat acne vulgaris. It is approved and authorised in the European Union as a topical anti-acne preparation, and remains investigational for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27293917\">Wikidata Q27293917</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>clascoterone</td></tr><tr><td>ATC codes:</td><td>D10AX06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12499\">DB12499</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/11750009\">11750009</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27293917\">Q27293917</a></td></tr><tr><td>formula:</td><td>C24H34O5</td></tr><tr><td>molar mass:</td><td>402.531 g/mol (PubChem CID 11750009)</td></tr><tr><td>logP:</td><td>3.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Clascoterone;
