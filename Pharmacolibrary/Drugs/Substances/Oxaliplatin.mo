  annotation (Documentation(info = "<html><body><p>Oxaliplatin is a platinum-based anticancer drug used to treat colorectal and other gastrointestinal cancers, including colon, rectal, gastric, and pancreatic adenocarcinomas. It is an approved medicine and is included on the WHO list of essential medicines, so it is widely used in cancer care.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q422327\">Wikidata Q422327</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>oxaliplatin</td></tr><tr><td>ATC codes:</td><td>L01XA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00526\">DB00526</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6857599\">6857599</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31941\">31941</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q422327\">Q422327</a></td></tr><tr><td>formula:</td><td>C8H16N2O4Pt+2</td></tr><tr><td>molar mass:</td><td>399.306 g/mol (PubChem CID 6857599)</td></tr></table></body></html>"));
