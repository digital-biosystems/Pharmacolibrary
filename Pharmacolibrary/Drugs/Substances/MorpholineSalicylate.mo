  annotation (Documentation(info = "<html><body><p>Morpholine salicylate is a salicylic acid derivative classified as an analgesic and antipyretic, used for pain and fever relief. It appears only as an experimental drug, with no authorisation record in the European Union, so its current clinical use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q410243\">Wikidata Q410243</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>morpholine salicylate</td></tr><tr><td>ATC codes:</td><td>N02BA08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13669\">DB13669</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/8083\">8083</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:34856\">34856</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q410243\">Q410243</a></td></tr><tr><td>formula:</td><td>C4H9NO</td></tr><tr><td>molar mass:</td><td>87.122 g/mol (PubChem CID 8083)</td></tr></table><p><small>Drugs.Common 25.09 gave 225.24 g/mol (+158.5 %); replaced by the value above</small></p></body></html>"));
