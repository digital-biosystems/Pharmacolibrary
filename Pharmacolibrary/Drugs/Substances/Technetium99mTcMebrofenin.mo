  annotation (Documentation(info = "<html><body><p>Technetium (99mTc) mebrofenin is a diagnostic radiopharmaceutical used for imaging of the liver and biliary system. It is an approved imaging agent used in nuclear medicine for hepatobiliary scans.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7692227\">Wikidata Q7692227</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>technetium (99mTc) mebrofenin</td></tr><tr><td>ATC codes:</td><td>V09DA04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09137\">DB09137</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7692227\">Q7692227</a></td></tr><tr><td>molar mass:</td><td>869.3 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Technetium99mTcMebrofenin;
