within Pharmacolibrary.Drugs.Substances;
package AntiDRhImmunoglobulin "anti-D (rh) immunoglobulin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "anti-D (rh) immunoglobulin",
    atcCodes = {"J06BB01"},
    drugbankId = "DB11597");
  annotation (Documentation(info = "<html><body><p>Anti-D immunoglobulin is a human antibody product used to prevent sensitisation to the RhD blood group, mainly in RhD-negative mothers during pregnancy and after delivery. It is an approved medicine, widely used in maternal care, and classified as a specific immunoglobulin for systemic use.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>anti-D (rh) immunoglobulin</td></tr><tr><td>ATC codes:</td><td>J06BB01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11597\">DB11597</a></td></tr></table></body></html>"));
end AntiDRhImmunoglobulin;
