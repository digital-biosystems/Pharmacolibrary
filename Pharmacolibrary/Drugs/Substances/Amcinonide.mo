  annotation (Documentation(info = "<html><body><p>Amcinonide is a potent topical corticosteroid used to treat inflammatory skin conditions such as dermatitis, including on the face, scalp, legs, and hands. It is an approved medicine, used mainly in dermatological care as a prescription skin preparation.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4742041\">Wikidata Q4742041</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>amcinonide</td></tr><tr><td>ATC codes:</td><td>D07AC11</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00288\">DB00288</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/443958\">443958</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31199\">31199</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4742041\">Q4742041</a></td></tr><tr><td>formula:</td><td>C28H35FO7</td></tr><tr><td>molar mass:</td><td>502.579 g/mol (PubChem CID 443958)</td></tr><tr><td>logP:</td><td>3.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
