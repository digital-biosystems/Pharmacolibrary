    M = 0.332464);
  annotation (Documentation(info = "<html><body><p>Ipratropium is an inhaled anticholinergic used for obstructive airway diseases such as COPD and asthma, and also as a nasal preparation. It is an approved medicine, appears on the WHO list of essential medicines, and is widely used, including in fixed combinations with inhaled adrenergic drugs.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q424294\">Wikidata Q424294</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Ipratropium</td></tr><tr><td>ATC codes:</td><td>R01AX03, R03BB01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00332\">DB00332</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/657309\">657309</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q424294\">Q424294</a></td></tr><tr><td>formula:</td><td>C20H30NO3+</td></tr><tr><td>molar mass:</td><td>332.464 g/mol (PubChem CID 657309)</td></tr></table></body></html>"));
end Ipratropium;
