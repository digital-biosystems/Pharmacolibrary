  annotation (Documentation(info = "<html><body><p>Magnesium levulinate is a magnesium salt used as a mineral supplement to raise magnesium levels. It is considered a nutraceutical and remains investigational, so it is not an established approved medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6731395&quot;>Wikidata Q6731395</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>magnesium levulinate</td></tr><tr><td>ATC codes:</td><td>A12CC07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB14514&quot;>DB14514</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6731395&quot;>Q6731395</a></td></tr><tr><td>formula:</td><td>C10H14MgO6</td></tr><tr><td>molar mass:</td><td>254.521 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
