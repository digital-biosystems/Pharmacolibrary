  annotation (Documentation(info = "<html><body><p>Calcium gluconate is a calcium supplement used for conditions such as osteoporosis, tetany, and cardiac arrest. It is widely used, appears on the WHO essential medicines list, and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q413739&quot;>Wikidata Q413739</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>calcium gluconate</td></tr><tr><td>ATC codes:</td><td>A12AA03, B05XA19, D11AX03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11126&quot;>DB11126</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/9290&quot;>9290</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3309&quot;>3309</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q413739&quot;>Q413739</a></td></tr><tr><td>formula:</td><td>C12H22CaO14</td></tr><tr><td>molar mass:</td><td>430.372 g/mol (PubChem)</td></tr></table></body></html>"));
