  annotation (Documentation(info = "<html><body><p>Physostigmine is a cholinesterase inhibitor used as a miotic to treat glaucoma and as an antidote. It remains an approved medicine, used mainly in ophthalmology for glaucoma and in antidote preparations.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q410595\">Wikidata Q410595</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>physostigmine</td></tr><tr><td>ATC codes:</td><td>S01EB05, V03AB19</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00981\">DB00981</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5983\">5983</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:27953\">27953</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q410595\">Q410595</a></td></tr><tr><td>formula:</td><td>C15H21N3O2</td></tr><tr><td>molar mass:</td><td>275.352 g/mol (PubChem CID 5983)</td></tr><tr><td>logP:</td><td>0.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
