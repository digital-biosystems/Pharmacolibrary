  annotation (Documentation(info = "<html><body><p>Xenon-133 is a radioactive isotope of xenon used as a diagnostic radiopharmaceutical for imaging of the respiratory system. It is an approved diagnostic agent, classified among respiratory-system diagnostic radiopharmaceuticals, and is used in nuclear medicine for lung ventilation studies.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2451397\">Wikidata Q2451397</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>xenon (133Xe) gas</td></tr><tr><td>ATC codes:</td><td>V09EX03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09315\">DB09315</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/66376\">66376</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2451397\">Q2451397</a></td></tr><tr><td>formula:</td><td>Xe</td></tr><tr><td>molar mass:</td><td>131.29 g/mol (PubChem CID 66376)</td></tr></table><p><small>Drugs.Common 25.09 gave 132.906 g/mol (+1.2 %); replaced by the value above</small></p></body></html>"));
