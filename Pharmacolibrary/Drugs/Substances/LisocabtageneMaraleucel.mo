  annotation (Documentation(info = "<html><body><p>Lisocabtagene maraleucel is a cell and gene therapy used to treat certain B-cell lymphomas, including diffuse large B-cell lymphoma, follicular lymphoma, and mediastinal tumours. It is an authorised medicine in the European Union.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>lisocabtagene maraleucel</td></tr><tr><td>ATC codes:</td><td>L01XL08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB16582\">DB16582</a></td></tr></table></body></html>"));
