within Pharmacolibrary.Drugs.Substances;
package Fenoterol "fenoterol"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "fenoterol",
    atcCodes = {"G02CA03", "R03AC04", "R03CC04"},
    drugbankId = "DB01288",
    pubchemCid = "3343",
    chebiId = "149226",
    wikidataId = "Q420188",
    formula = "C17H21NO4",
    M = 0.303358,
    logP = 2);
  annotation (Documentation(info = "<html><body><p>Fenoterol is a beta-2 adrenergic agonist used as a bronchodilator for obstructive airway diseases and as a labour-repressing (tocolytic) agent. It has been approved but is no longer available in some markets, having been withdrawn there.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q420188\">Wikidata Q420188</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>fenoterol</td></tr><tr><td>ATC codes:</td><td>G02CA03, R03AC04, R03CC04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01288\">DB01288</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3343\">3343</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:149226\">149226</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q420188\">Q420188</a></td></tr><tr><td>formula:</td><td>C17H21NO4</td></tr><tr><td>molar mass:</td><td>303.358 g/mol (PubChem CID 3343)</td></tr><tr><td>logP:</td><td>2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Fenoterol;
