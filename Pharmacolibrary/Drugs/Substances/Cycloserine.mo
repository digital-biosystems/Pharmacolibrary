  annotation (Documentation(info = "<html><body><p>Cycloserine is an antibiotic used to treat tuberculosis and has also been studied for Gaucher's disease. It is an approved medicine, appears on the WHO essential medicines list, and is used mainly as part of tuberculosis treatment.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q418508&quot;>Wikidata Q418508</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cycloserine</td></tr><tr><td>ATC codes:</td><td>J04AB01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00260&quot;>DB00260</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6234&quot;>6234</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:40009&quot;>40009</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q418508&quot;>Q418508</a></td></tr><tr><td>formula:</td><td>C3H6N2O2</td></tr><tr><td>molar mass:</td><td>102.093 g/mol (PubChem)</td></tr></table></body></html>"));
end Cycloserine;
