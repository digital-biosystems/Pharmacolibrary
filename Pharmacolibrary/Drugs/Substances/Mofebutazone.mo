within Pharmacolibrary.Drugs.Substances;
package Mofebutazone "mofebutazone"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "mofebutazone",
    atcCodes = {"M01AA02", "M02AA02"},
    drugbankId = "DB13629",
    pubchemCid = "16639",
    chebiId = "76252",
    wikidataId = "Q6890329",
    formula = "C13H16N2O2",
    M = 0.232283,
    logP = 2.7);
  annotation (Documentation(info = "<html><body><p>Mofebutazone is a non-steroidal anti-inflammatory drug of the butylpyrazolidine group, used for inflammatory and rheumatic conditions and as a topical preparation for joint and muscle pain. It is not an established marketed medicine today; databases classify it as experimental, and no EU authorisation is recorded.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6890329\">Wikidata Q6890329</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mofebutazone</td></tr><tr><td>ATC codes:</td><td>M01AA02, M02AA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13629\">DB13629</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/16639\">16639</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:76252\">76252</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6890329\">Q6890329</a></td></tr><tr><td>formula:</td><td>C13H16N2O2</td></tr><tr><td>molar mass:</td><td>232.283 g/mol (PubChem CID 16639)</td></tr><tr><td>logP:</td><td>2.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Mofebutazone;
