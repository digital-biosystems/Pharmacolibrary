    logP = 1.8);
  annotation (Documentation(info = "<html><body><p>Picloxydine is an antiinfective agent classified for use in eye conditions, as an ophthalmological antiinfective. It is not an approved medicine in the European Union and is considered experimental, so its current clinical use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7190966\">Wikidata Q7190966</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>picloxydine</td></tr><tr><td>ATC codes:</td><td>S01AX16</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13607\">DB13607</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5748610\">5748610</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135768\">135768</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7190966\">Q7190966</a></td></tr><tr><td>formula:</td><td>C20H24Cl2N10</td></tr><tr><td>molar mass:</td><td>475.382 g/mol (PubChem CID 5748610)</td></tr><tr><td>logP:</td><td>1.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Picloxydine;
