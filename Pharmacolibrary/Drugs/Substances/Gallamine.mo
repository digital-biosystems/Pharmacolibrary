    logP = 4.1);
  annotation (Documentation(info = "<html><body><p>Gallamine is a peripherally acting muscle relaxant that was used to relax muscles during surgical procedures. It is no longer in routine clinical use and is today regarded as an experimental compound.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q69758886\">Wikidata Q69758886</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>gallamine</td></tr><tr><td>ATC codes:</td><td>M03AC02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13584\">DB13584</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/67425\">67425</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:503442\">503442</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q69758886\">Q69758886</a></td></tr><tr><td>formula:</td><td>C24H45N3O3</td></tr><tr><td>molar mass:</td><td>423.642 g/mol (PubChem CID 67425)</td></tr><tr><td>logP:</td><td>4.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Gallamine;
