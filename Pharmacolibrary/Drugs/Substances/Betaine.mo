  annotation (Documentation(info = "<html><body><p>Betaine is used to treat homocystinuria and also acts as a digestive aid. It is authorised in the European Union for homocystinuria and is also available as a nutraceutical.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q10860583\">Wikidata Q10860583</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>betaine</td></tr><tr><td>ATC codes:</td><td>A09AB02, A16AA06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06756\">DB06756</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/247\">247</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:17750\">17750</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q10860583\">Q10860583</a></td></tr><tr><td>formula:</td><td>C5H11NO2</td></tr><tr><td>molar mass:</td><td>117.148 g/mol (PubChem CID 247)</td></tr><tr><td>logP:</td><td>0.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
