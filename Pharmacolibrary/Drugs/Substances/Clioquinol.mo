    logP = 3.5);
  annotation (Documentation(info = "<html><body><p>Clioquinol is an antifungal and antibacterial agent used for skin infections such as tinea and athlete's foot, and was formerly taken by mouth against amoebiasis. Oral use was withdrawn after it was linked to a serious neurological disorder, but it remains approved in topical preparations such as creams and medicated dressings.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5134338&quot;>Wikidata Q5134338</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>clioquinol</td></tr><tr><td>ATC codes:</td><td>D08AH30, D09AA10, G01AC02, P01AA02, S02AA05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB04815&quot;>DB04815</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2788&quot;>2788</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:74460&quot;>74460</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5134338&quot;>Q5134338</a></td></tr><tr><td>formula:</td><td>C9H5ClINO</td></tr><tr><td>molar mass:</td><td>305.495 g/mol (PubChem)</td></tr></table></body></html>"));
end Clioquinol;
