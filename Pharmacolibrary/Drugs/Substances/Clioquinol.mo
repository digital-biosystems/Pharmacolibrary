within Pharmacolibrary.Drugs.Substances;
package Clioquinol "clioquinol"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "clioquinol",
    atcCodes = {"D08AH30", "D09AA10", "G01AC02", "P01AA02", "S02AA05"},
