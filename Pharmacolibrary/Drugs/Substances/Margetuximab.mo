  annotation (Documentation(info = "<html><body><p>Margetuximab is a monoclonal antibody that inhibits HER2 and is used as an anticancer drug. It is approved but not authorised in the European Union, and remains investigational for some uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q109356831\">Wikidata Q109356831</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>margetuximab</td></tr><tr><td>ATC codes:</td><td>L01FD06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB14967\">DB14967</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q109356831\">Q109356831</a></td></tr><tr><td>molar mass:</td><td>149000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Margetuximab;
