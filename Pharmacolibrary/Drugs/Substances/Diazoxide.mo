    logP = 1.2);
  annotation (Documentation(info = "<html><body><p>Diazoxide is a vasodilator and potassium channel activator used to treat hypoglycemia and malignant hypertension. It is an approved medicine, used mainly in hospital settings for these conditions.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q420009&quot;>Wikidata Q420009</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>diazoxide</td></tr><tr><td>ATC codes:</td><td>C02DA01, V03AH01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01119&quot;>DB01119</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3019&quot;>3019</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4495&quot;>4495</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q420009&quot;>Q420009</a></td></tr><tr><td>formula:</td><td>C8H7ClN2O2S</td></tr><tr><td>molar mass:</td><td>230.666 g/mol (PubChem)</td></tr></table></body></html>"));
end Diazoxide;
