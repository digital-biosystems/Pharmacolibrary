within Pharmacolibrary.Drugs.Substances;
package Catridecacog "catridecacog"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "catridecacog",
    atcCodes = {"B02BD11"},
    drugbankId = "DB09310",
    wikidataId = "Q16858452");
  annotation (Documentation(info = "<html><body><p>Catridecacog is a recombinant coagulation factor XIII A-subunit used to treat inherited blood coagulation disorders, specifically factor XIII deficiency. It is approved and authorised in the European Union, though it is a specialised product used in a small patient population.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q16858452&quot;>Wikidata Q16858452</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>catridecacog</td></tr><tr><td>ATC codes:</td><td>B02BD11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09310&quot;>DB09310</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q16858452&quot;>Q16858452</a></td></tr></table></body></html>"));
end Catridecacog;
