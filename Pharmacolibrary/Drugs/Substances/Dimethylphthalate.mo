  annotation (Documentation(info = "<html><body><p>Dimethylphthalate is an insect repellent, classified among ectoparasiticides used to repel insects. It is currently considered experimental and does not appear to be an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q423551\">Wikidata Q423551</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dimethylphthalate</td></tr><tr><td>ATC codes:</td><td>P03BX02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13336\">DB13336</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/8554\">8554</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4609\">4609</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q423551\">Q423551</a></td></tr><tr><td>formula:</td><td>C10H10O4</td></tr><tr><td>molar mass:</td><td>194.186 g/mol (PubChem CID 8554)</td></tr><tr><td>logP:</td><td>1.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
