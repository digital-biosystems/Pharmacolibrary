  annotation (Documentation(info = "<html><body><p>Olopatadine is an antihistamine used to treat allergic conjunctivitis, allergic rhinitis, and giant papillary conjunctivitis. It is approved and an eye-drop product is authorised in the European Union for allergic conjunctivitis; it is also available as a nasal preparation.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3267092\">Wikidata Q3267092</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>olopatadine</td></tr><tr><td>ATC codes:</td><td>R01AC08, S01GX09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00768\">DB00768</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5281071\">5281071</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3267092\">Q3267092</a></td></tr><tr><td>formula:</td><td>C21H23NO3</td></tr><tr><td>molar mass:</td><td>337.419 g/mol (PubChem CID 5281071)</td></tr><tr><td>logP:</td><td>1.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Olopatadine;
