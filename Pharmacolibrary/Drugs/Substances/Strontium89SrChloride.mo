  annotation (Documentation(info = "<html><body><p>Strontium-89 chloride is a bone-seeking radiopharmaceutical used to relieve pain from cancer that has spread to the bones. It is an approved medicine and is used in hospitals with nuclear medicine facilities for pain palliation.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27262770&quot;>Wikidata Q27262770</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>strontium (89Sr) chloride</td></tr><tr><td>ATC codes:</td><td>V10BX01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09498&quot;>DB09498</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27262770&quot;>Q27262770</a></td></tr><tr><td>molar mass:</td><td>159.81 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Strontium89SrChloride;
