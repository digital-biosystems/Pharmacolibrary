  annotation (Documentation(info = "<html><body><p>Gallium-67 citrate is a radioactive imaging agent used to detect sites of inflammation and infection in the body. It is an approved diagnostic radiopharmaceutical, used mainly in nuclear medicine departments for such scans.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27260007&quot;>Wikidata Q27260007</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>gallium (67Ga) citrate</td></tr><tr><td>ATC codes:</td><td>V09HX01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06784&quot;>DB06784</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27260007&quot;>Q27260007</a></td></tr><tr><td>molar mass:</td><td>256.03 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Gallium67GaCitrate;
