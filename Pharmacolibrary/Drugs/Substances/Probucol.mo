within Pharmacolibrary.Drugs.Substances;
package Probucol "probucol"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "probucol",
    atcCodes = {"C10AX02"},
    drugbankId = "DB01599",
    pubchemCid = "4912",
    chebiId = "8427",
    wikidataId = "Q10354103",
    formula = "C31H48O2S2",
    M = 0.516843,
    logP = 11.3);
  annotation (Documentation(info = "<html><body><p>Probucol is a lipid-lowering and antioxidant drug that was used to treat high blood lipids, including familial hyperlipidemia, and conditions such as arteriosclerosis and coronary artery disease. It has been withdrawn from the market in many countries, largely because it can prolong the heart's electrical repolarisation, raising safety concerns.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q10354103\">Wikidata Q10354103</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>probucol</td></tr><tr><td>ATC codes:</td><td>C10AX02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01599\">DB01599</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4912\">4912</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8427\">8427</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q10354103\">Q10354103</a></td></tr><tr><td>formula:</td><td>C31H48O2S2</td></tr><tr><td>molar mass:</td><td>516.843 g/mol (PubChem CID 4912)</td></tr><tr><td>logP:</td><td>11.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Probucol;
