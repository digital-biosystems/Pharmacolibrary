  annotation (Documentation(info = "<html><body><p>Teplizumab is a monoclonal antibody used to treat type 1 diabetes. It is authorised in the European Union and also approved elsewhere, though it remains partly investigational.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7701358\">Wikidata Q7701358</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>teplizumab</td></tr><tr><td>ATC codes:</td><td>A10XX01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06606\">DB06606</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7701358\">Q7701358</a></td></tr><tr><td>molar mass:</td><td>150000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
