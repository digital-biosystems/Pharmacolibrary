    logP = 2.8);
  annotation (Documentation(info = "<html><body><p>Anethole trithione is a drug used to treat dry mouth (xerostomia) and has also been used to stimulate saliva and bile flow. It is an approved medicine, used in some countries mainly for dry mouth relief, though not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4761739&quot;>Wikidata Q4761739</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>anethole trithione</td></tr><tr><td>ATC codes:</td><td>A16AX02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13853&quot;>DB13853</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2194&quot;>2194</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31221&quot;>31221</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4761739&quot;>Q4761739</a></td></tr><tr><td>formula:</td><td>C10H8OS3</td></tr><tr><td>molar mass:</td><td>240.353 g/mol (PubChem)</td></tr></table></body></html>"));
end AnetholeTrithione;
