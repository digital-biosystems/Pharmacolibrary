  annotation (Documentation(info = "<html><body><p>Muzolimine is a loop-type (high-ceiling) diuretic that was used to treat fluid retention and high blood pressure. It has been withdrawn and is no longer in clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3868794\">Wikidata Q3868794</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>muzolimine</td></tr><tr><td>ATC codes:</td><td>C03CD01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13801\">DB13801</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/41386\">41386</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135124\">135124</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3868794\">Q3868794</a></td></tr><tr><td>formula:</td><td>C11H11Cl2N3O</td></tr><tr><td>molar mass:</td><td>272.129 g/mol (PubChem CID 41386)</td></tr><tr><td>logP:</td><td>2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
