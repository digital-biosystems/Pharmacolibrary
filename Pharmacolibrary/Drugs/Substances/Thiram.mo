  annotation (Documentation(info = "<html><body><p>Thiram is a sulfur-containing ectoparasiticide used against parasitic skin infestations. It is an approved drug, though it appears to be only a minor, niche medicine rather than a widely used one.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q416572\">Wikidata Q416572</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>thiram</td></tr><tr><td>ATC codes:</td><td>P03AA05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13245\">DB13245</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5455\">5455</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9495\">9495</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q416572\">Q416572</a></td></tr><tr><td>formula:</td><td>C6H12N2S4</td></tr><tr><td>molar mass:</td><td>240.416 g/mol (PubChem CID 5455)</td></tr><tr><td>logP:</td><td>1.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
