  annotation (Documentation(info = "<html><body><p>Ipragliflozin is a sodium-glucose co-transporter 2 inhibitor, a class of blood glucose-lowering drugs developed for diabetes. It is not authorised in the European Union and is considered investigational, though it has been used in Japan.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q17193526&quot;>Wikidata Q17193526</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ipragliflozin</td></tr><tr><td>ATC codes:</td><td>A10BK05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11698&quot;>DB11698</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/10453870&quot;>10453870</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134724&quot;>134724</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q17193526&quot;>Q17193526</a></td></tr><tr><td>formula:</td><td>C21H21FO5S</td></tr><tr><td>molar mass:</td><td>404.452 g/mol (PubChem)</td></tr></table></body></html>"));
