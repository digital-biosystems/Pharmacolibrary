  annotation (Documentation(info = "<html><body><p>Carfecillin is an antibiotic that was used as a urinary anti-infective to treat infections of the urinary tract. It is no longer in routine clinical use and is regarded as an experimental agent, with no current marketing authorisation in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5039237&quot;>Wikidata Q5039237</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>carfecillin</td></tr><tr><td>ATC codes:</td><td>G01AA08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13506&quot;>DB13506</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/33672&quot;>33672</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3414&quot;>3414</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5039237&quot;>Q5039237</a></td></tr><tr><td>formula:</td><td>C23H22N2O6S</td></tr><tr><td>molar mass:</td><td>454.497 g/mol (PubChem)</td></tr></table></body></html>"));
