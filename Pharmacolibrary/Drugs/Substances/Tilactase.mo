    logP = -2.6);
  annotation (Documentation(info = "<html><body><p>Tilactase (lactase, a beta-galactosidase enzyme) is a digestive enzyme preparation used to help break down lactose, for example in lactose intolerance. It is an approved digestive enzyme, available as a food enzyme and digestive aid rather than a prescription medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q286379&quot;>Wikidata Q286379</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tilactase</td></tr><tr><td>ATC codes:</td><td>A09AA04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13761&quot;>DB13761</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q286379&quot;>Q286379</a></td></tr><tr><td>molar mass:</td><td>180.16 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Tilactase;
