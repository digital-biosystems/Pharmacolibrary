within Pharmacolibrary.Drugs.Substances;
package Tilactase "tilactase"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "tilactase",
    atcCodes = {"A09AA04"},
    drugbankId = "DB13761",
    wikidataId = "Q84937963",
    M = 0.18016,
    logP = -2.6);
  annotation (Documentation(info = "<html><body><p>Tilactase (lactase, a beta-galactosidase enzyme) is a digestive enzyme preparation used to help break down lactose, supporting people with lactose intolerance. It is an approved enzyme preparation in the digestives class and is available as a supplement, though it is not authorised centrally in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q84937963\">Wikidata Q84937963</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tilactase</td></tr><tr><td>ATC codes:</td><td>A09AA04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13761\">DB13761</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q84937963\">Q84937963</a></td></tr><tr><td>molar mass:</td><td>180.16 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>-2.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Tilactase;
