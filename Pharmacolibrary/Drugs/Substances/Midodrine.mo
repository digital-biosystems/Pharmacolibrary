within Pharmacolibrary.Drugs.Substances;
package Midodrine "midodrine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "midodrine",
    atcCodes = {"C01CA17"},
    drugbankId = "DB00211",
    pubchemCid = "4195",
    chebiId = "6933",
    wikidataId = "Q415051",
    formula = "C12H18N2O4",
    M = 0.254286,
    logP = -0.6);
  annotation (Documentation(info = "<html><body><p>Midodrine is a peripheral alpha-1 agonist used to treat orthostatic hypotension and dysautonomia, and has also been used for urinary incontinence. It is an approved medicine, though not authorised in the European Union, and is used fairly narrowly for low blood pressure on standing.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q415051\">Wikidata Q415051</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>midodrine</td></tr><tr><td>ATC codes:</td><td>C01CA17</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00211\">DB00211</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4195\">4195</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6933\">6933</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q415051\">Q415051</a></td></tr><tr><td>formula:</td><td>C12H18N2O4</td></tr><tr><td>molar mass:</td><td>254.286 g/mol (PubChem CID 4195)</td></tr><tr><td>logP:</td><td>-0.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Midodrine;
