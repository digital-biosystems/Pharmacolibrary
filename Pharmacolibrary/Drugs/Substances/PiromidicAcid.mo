  annotation (Documentation(info = "<html><body><p>Piromidic acid is a quinolone antibacterial that was used as a urinary anti-infective to treat urinary tract infections. It is considered investigational and does not appear to be an approved medicine in major markets such as the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q745206&quot;>Wikidata Q745206</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>piromidic acid</td></tr><tr><td>ATC codes:</td><td>J01MB03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13744&quot;>DB13744</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32019&quot;>32019</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q745206&quot;>Q745206</a></td></tr><tr><td>formula:</td><td>C14H16N4O3</td></tr><tr><td>molar mass:</td><td>288.307 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
