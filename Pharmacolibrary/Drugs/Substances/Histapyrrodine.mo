  annotation (Documentation(info = "<html><body><p>Histapyrrodine is an antihistamine of the substituted ethylenediamine type, used for allergic conditions. It is not an approved medicine today and is considered experimental, so it is no longer in routine use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3698382\">Wikidata Q3698382</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>histapyrrodine</td></tr><tr><td>ATC codes:</td><td>R06AC02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13479\">DB13479</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/68122\">68122</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135164\">135164</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3698382\">Q3698382</a></td></tr><tr><td>formula:</td><td>C19H24N2</td></tr><tr><td>molar mass:</td><td>280.415 g/mol (PubChem CID 68122)</td></tr><tr><td>logP:</td><td>4.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
