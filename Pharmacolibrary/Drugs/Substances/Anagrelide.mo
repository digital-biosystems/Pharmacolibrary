  annotation (Documentation(info = "<html><body><p>Anagrelide is used to treat essential thrombocythemia, a condition in which the body makes too many platelets. It is authorised in the European Union and remains in clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q408163\">Wikidata Q408163</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>anagrelide</td></tr><tr><td>ATC codes:</td><td>L01XX35</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00261\">DB00261</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2182\">2182</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:142290\">142290</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q408163\">Q408163</a></td></tr><tr><td>formula:</td><td>C10H7Cl2N3O</td></tr><tr><td>molar mass:</td><td>256.088 g/mol (knowledgebase (DrugBank calculated))</td></tr><tr><td>logP:</td><td>1.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Anagrelide;
