  annotation (Documentation(info = "<html><body><p>Sultopride is an antipsychotic of the benzamide class, acting as a dopamine antagonist, used to treat psychotic disorders such as schizophrenia. It is an approved medicine, but it does not appear to be authorised across the whole European Union and seems to be used only in some countries.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4445779&quot;>Wikidata Q4445779</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sultopride</td></tr><tr><td>ATC codes:</td><td>N05AL02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13273&quot;>DB13273</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5357&quot;>5357</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9356&quot;>9356</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4445779&quot;>Q4445779</a></td></tr><tr><td>formula:</td><td>C17H26N2O4S</td></tr><tr><td>molar mass:</td><td>354.465 g/mol (PubChem)</td></tr></table></body></html>"));
