within Pharmacolibrary.Drugs.Substances;
package Chymopapain "chymopapain"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "chymopapain",
    atcCodes = {"M09AB01"},
    drugbankId = "DB06752",
    wikidataId = "Q5118581",
    M = 27);
  annotation (Documentation(info = "<html><body><p>Chymopapain, an enzyme from papaya, was once injected to dissolve herniated disc material in a treatment called chemonucleolysis for sciatica. It has been withdrawn from the market, largely because of rare serious allergic reactions and the availability of safer alternatives.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5118581\">Wikidata Q5118581</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>chymopapain</td></tr><tr><td>ATC codes:</td><td>M09AB01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06752\">DB06752</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5118581\">Q5118581</a></td></tr><tr><td>molar mass:</td><td>27000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Chymopapain;
