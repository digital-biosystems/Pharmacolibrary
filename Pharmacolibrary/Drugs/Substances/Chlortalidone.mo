within Pharmacolibrary.Drugs.Substances;
package Chlortalidone "chlortalidone"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "chlortalidone",
    atcCodes = {"C03BA04"},
    drugbankId = "DB00310",
    pubchemCid = "2732",
    wikidataId = "Q425289",
    formula = "C14H11ClN2O4S",
    M = 0.338762,
    logP = 0.9);
  annotation (Documentation(info = "<html><body><p>Chlortalidone is a diuretic and antihypertensive drug used to treat arterial hypertension, congestive heart failure, and fluid retention conditions such as anasarca and nephrotic syndrome, and also nephrogenic diabetes insipidus. It is an approved medicine, available alone or in combination products with potassium-sparing agents or potassium, and is used widely in cardiovascular care.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q425289\">Wikidata Q425289</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>chlortalidone</td></tr><tr><td>ATC codes:</td><td>C03BA04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00310\">DB00310</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2732\">2732</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q425289\">Q425289</a></td></tr><tr><td>formula:</td><td>C14H11ClN2O4S</td></tr><tr><td>molar mass:</td><td>338.762 g/mol (PubChem CID 2732)</td></tr><tr><td>logP:</td><td>0.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Chlortalidone;
