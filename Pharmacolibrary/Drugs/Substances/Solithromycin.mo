  annotation (Documentation(info = "<html><body><p>Solithromycin is an investigational macrolide antibiotic studied for treating infections such as pneumonia, tularemia, and anthrax. It has never reached routine use; its marketing application in the European Union was withdrawn, so it remains an investigational drug.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7558263&quot;>Wikidata Q7558263</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>solithromycin</td></tr><tr><td>ATC codes:</td><td>J01FA16</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09308&quot;>DB09308</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/25242512&quot;>25242512</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7558263&quot;>Q7558263</a></td></tr><tr><td>formula:</td><td>C43H65FN6O10</td></tr><tr><td>molar mass:</td><td>845.023 g/mol (PubChem)</td></tr></table></body></html>"));
