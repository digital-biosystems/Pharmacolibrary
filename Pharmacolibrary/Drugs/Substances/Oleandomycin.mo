  annotation (Documentation(info = "<html><body><p>Oleandomycin is a macrolide antibiotic used to treat bacterial infections. It is no longer used in human medicine and is now approved mainly for veterinary use, being considered largely experimental otherwise.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1076248\">Wikidata Q1076248</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>oleandomycin</td></tr><tr><td>ATC codes:</td><td>J01FA05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11442\">DB11442</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/72493\">72493</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:16869\">16869</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1076248\">Q1076248</a></td></tr><tr><td>formula:</td><td>C35H61NO12</td></tr><tr><td>molar mass:</td><td>687.868 g/mol (PubChem CID 72493)</td></tr><tr><td>logP:</td><td>2.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Oleandomycin;
