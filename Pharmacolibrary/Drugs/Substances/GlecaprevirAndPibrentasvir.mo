  annotation (Documentation(info = "<html><body><p>Glecaprevir/pibrentasvir is a combination antiviral medicine used to treat hepatitis C. It is an approved direct-acting antiviral for HCV infections.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q39048038\">Wikidata Q39048038</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>glecaprevir and pibrentasvir</td></tr><tr><td>ATC codes:</td><td>J05AP57</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13878\">DB13878</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q39048038\">Q39048038</a></td></tr><tr><td>molar mass:</td><td>1952 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
