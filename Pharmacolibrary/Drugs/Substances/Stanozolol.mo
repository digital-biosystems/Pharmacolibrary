  annotation (Documentation(info = "<html><body><p>Stanozolol is an anabolic steroid used to promote growth and treat conditions involving protein loss, such as hereditary angioedema. It is approved for human use and also approved for veterinary use, though it is controlled in many countries because of misuse in sports.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q417219&quot;>Wikidata Q417219</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>stanozolol</td></tr><tr><td>ATC codes:</td><td>A14AA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06718&quot;>DB06718</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/25249&quot;>25249</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9249&quot;>9249</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q417219&quot;>Q417219</a></td></tr><tr><td>formula:</td><td>C21H32N2O</td></tr><tr><td>molar mass:</td><td>328.5 g/mol (PubChem)</td></tr></table></body></html>"));
