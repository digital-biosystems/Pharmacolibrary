  annotation (Documentation(info = "<html><body><p>Brolucizumab is an antineovascularisation eye medicine (a monoclonal antibody) used to treat wet macular degeneration. It is an approved drug and is authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q25326694&quot;>Wikidata Q25326694</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>brolucizumab</td></tr><tr><td>ATC codes:</td><td>S01LA06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB14864&quot;>DB14864</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q25326694&quot;>Q25326694</a></td></tr><tr><td>molar mass:</td><td>26000 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
