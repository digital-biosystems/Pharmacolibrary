  annotation (Documentation(info = "<html><body><p>Hydrocodone is an opioid used to treat pain and to suppress cough. It is an approved medicine, typically given in combination with non-opioid painkillers, and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q411441\">Wikidata Q411441</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>hydrocodone</td></tr><tr><td>ATC codes:</td><td>R05DA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00956\">DB00956</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5284569\">5284569</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:5779\">5779</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q411441\">Q411441</a></td></tr><tr><td>formula:</td><td>C18H21NO3</td></tr><tr><td>molar mass:</td><td>299.37 g/mol (PubChem CID 5284569)</td></tr><tr><td>logP:</td><td>2.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
