  annotation (Documentation(info = "<html><body><p>Tioguanine is a purine analogue anticancer drug used to treat acute myeloid leukemia. It is an approved medicine and appears on the WHO list of essential medicines, so it remains in clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q385347&quot;>Wikidata Q385347</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tioguanine</td></tr><tr><td>ATC codes:</td><td>L01BB03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00352&quot;>DB00352</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2723601&quot;>2723601</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9555&quot;>9555</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q385347&quot;>Q385347</a></td></tr><tr><td>formula:</td><td>C5H5N5S</td></tr><tr><td>molar mass:</td><td>167.19 g/mol (PubChem)</td></tr></table></body></html>"));
