  annotation (Documentation(info = "<html><body><p>Quingestanol is a progestogen that has been used in hormonal contraceptives, both alone and in fixed combinations with estrogens. It is currently considered experimental and does not appear to be an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7272227\">Wikidata Q7272227</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>quingestanol</td></tr><tr><td>ATC codes:</td><td>G03AC04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13685\">DB13685</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9842127\">9842127</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7272227\">Q7272227</a></td></tr><tr><td>formula:</td><td>C25H34O2</td></tr><tr><td>molar mass:</td><td>366.545 g/mol (PubChem CID 9842127)</td></tr><tr><td>logP:</td><td>4.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
