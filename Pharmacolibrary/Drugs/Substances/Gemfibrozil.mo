  annotation (Documentation(info = "<html><body><p>Gemfibrozil is a fibrate lipid-lowering drug used to treat high triglycerides and other lipid disorders, and to help prevent arteriosclerosis and coronary artery disease. It remains an approved medicine, but carries a boxed warning, so its use requires caution.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q384295\">Wikidata Q384295</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>gemfibrozil</td></tr><tr><td>ATC codes:</td><td>C10AB04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01241\">DB01241</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3463\">3463</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:5296\">5296</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q384295\">Q384295</a></td></tr><tr><td>formula:</td><td>C15H22O3</td></tr><tr><td>molar mass:</td><td>250.338 g/mol (PubChem CID 3463)</td></tr><tr><td>logP:</td><td>3.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
