  annotation (Documentation(info = "<html><body><p>Infigratinib is a protein kinase inhibitor that was developed to treat cholangiocarcinoma (bile duct cancer). It is no longer in use: its marketing application in the European Union was withdrawn, and it is listed as withdrawn elsewhere.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27075200\">Wikidata Q27075200</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>infigratinib</td></tr><tr><td>ATC codes:</td><td>L01EN03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11886\">DB11886</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/53235510\">53235510</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:63451\">63451</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27075200\">Q27075200</a></td></tr><tr><td>formula:</td><td>C26H31Cl2N7O3</td></tr><tr><td>molar mass:</td><td>560.48 g/mol (PubChem CID 53235510)</td></tr><tr><td>logP:</td><td>4.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Infigratinib;
