    M = 0.414476,
    logP = 2.9);
  annotation (Documentation(info = "<html><body><p>Nafcillin is a penicillin antibiotic used to treat serious bacterial infections such as sepsis, endocarditis, meningitis, osteomyelitis, cellulitis, and urinary or respiratory tract infections. It is an approved beta-lactamase–resistant penicillin, generally given by injection, and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1638852\">Wikidata Q1638852</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nafcillin</td></tr><tr><td>ATC codes:</td><td>J01CF06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00607\">DB00607</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/8982\">8982</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7447\">7447</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1638852\">Q1638852</a></td></tr><tr><td>formula:</td><td>C21H22N2O5S</td></tr><tr><td>molar mass:</td><td>414.476 g/mol (PubChem CID 8982)</td></tr><tr><td>logP:</td><td>2.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Nafcillin;
