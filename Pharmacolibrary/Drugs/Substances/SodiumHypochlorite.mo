  annotation (Documentation(info = "<html><body><p>Sodium hypochlorite is an antiseptic and disinfectant used to kill germs on skin and surfaces. It is widely used as a topical antiseptic and household disinfectant.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q409049&quot;>Wikidata Q409049</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sodium hypochlorite</td></tr><tr><td>ATC codes:</td><td>D08AX07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11123&quot;>DB11123</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/61739&quot;>61739</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:29222&quot;>29222</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q409049&quot;>Q409049</a></td></tr><tr><td>formula:</td><td>ClO-</td></tr><tr><td>molar mass:</td><td>51.449 g/mol (PubChem)</td></tr></table></body></html>"));
end SodiumHypochlorite;
