    logP = 3.3);
  annotation (Documentation(info = "<html><body><p>Levonorgestrel is a progestogen used for hormonal contraception, including emergency contraception, and also to treat endometriosis and adenomyosis. It is widely used worldwide and is included on the WHO essential medicines list.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q416950\">Wikidata Q416950</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>levonorgestrel</td></tr><tr><td>ATC codes:</td><td>G03AC03, G03AD01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00367\">DB00367</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/13109\">13109</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6443\">6443</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q416950\">Q416950</a></td></tr><tr><td>formula:</td><td>C21H28O2</td></tr><tr><td>molar mass:</td><td>312.453 g/mol (PubChem CID 13109)</td></tr><tr><td>logP:</td><td>3.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
