  annotation (Documentation(info = "<html><body><p>Technetium (99mTc) arcitumomab is a radiolabelled monoclonal antibody used as a diagnostic radiopharmaceutical for detecting tumours. It is classed as experimental and does not appear to be an approved medicine in the European Union, so its use appears limited to research settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q637504\">Wikidata Q637504</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>technetium (99mTc) arcitumomab</td></tr><tr><td>ATC codes:</td><td>V09IA06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00113\">DB00113</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q637504\">Q637504</a></td></tr><tr><td>molar mass:</td><td>98.906 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
