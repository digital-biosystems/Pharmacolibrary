within Pharmacolibrary.Drugs.Substances;
package Oxiconazole "oxiconazole"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "oxiconazole",
    atcCodes = {"D01AC11", "G01AF17"},
    drugbankId = "DB00239",
    pubchemCid = "5353853",
    chebiId = "7825",
    wikidataId = "Q3359058",
    formula = "C18H13Cl4N3O",
    M = 0.429122,
    logP = 6.1);
  annotation (Documentation(info = "<html><body><p>Oxiconazole is a topical antifungal used to treat skin fungal infections such as ringworm, athlete's foot, jock itch, tinea, pityriasis versicolor, and cutaneous candidiasis. It is an approved medicine, available in topical (skin) and gynecological formulations, though it does not appear to have central European Union authorisation.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3359058&quot;>Wikidata Q3359058</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>oxiconazole</td></tr><tr><td>ATC codes:</td><td>D01AC11, G01AF17</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00239&quot;>DB00239</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5353853&quot;>5353853</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7825&quot;>7825</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3359058&quot;>Q3359058</a></td></tr><tr><td>formula:</td><td>C18H13Cl4N3O</td></tr><tr><td>molar mass:</td><td>429.122 g/mol (PubChem)</td></tr></table></body></html>"));
end Oxiconazole;
