    logP = 4.2);
  annotation (Documentation(info = "<html><body><p>Aprepitant is an antiemetic (an NK1 receptor antagonist) used to prevent nausea and vomiting, including chemotherapy-induced and postoperative nausea and vomiting. It is authorised in the European Union and is widely used, mainly in cancer care to help control vomiting caused by treatment.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q621834\">Wikidata Q621834</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>aprepitant</td></tr><tr><td>ATC codes:</td><td>A04AD12</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00673\">DB00673</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/135413536\">135413536</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q621834\">Q621834</a></td></tr><tr><td>formula:</td><td>C23H21F7N4O3</td></tr><tr><td>molar mass:</td><td>534.432 g/mol (PubChem CID 135413536)</td></tr><tr><td>logP:</td><td>4.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Aprepitant;
