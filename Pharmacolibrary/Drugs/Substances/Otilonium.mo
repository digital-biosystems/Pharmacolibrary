  annotation (Documentation(info = "<html><body><p>Otilonium bromide is an antispasmodic agent used for functional gastrointestinal disorders such as irritable bowel syndrome. It is not approved in the European Union and is considered investigational in major drug databases, though it has been marketed in some countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q920900\">Wikidata Q920900</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Otilonium</td></tr><tr><td>ATC codes:</td><td>A03AB06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13500\">DB13500</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/72093\">72093</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q920900\">Q920900</a></td></tr><tr><td>formula:</td><td>C29H43N2O4+</td></tr><tr><td>molar mass:</td><td>483.673 g/mol (PubChem CID 72093)</td></tr></table></body></html>"));
end Otilonium;
