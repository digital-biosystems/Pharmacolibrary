  annotation (Documentation(info = "<html><body><p>Chlorotrianisene is a non-steroidal estrogen that was used to treat conditions such as prostate cancer, hypogonadism, ovarian dysfunction, and premature menopause. It has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5103213&quot;>Wikidata Q5103213</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>chlorotrianisene</td></tr><tr><td>ATC codes:</td><td>G03CA06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00269&quot;>DB00269</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/11289&quot;>11289</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3641&quot;>3641</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5103213&quot;>Q5103213</a></td></tr><tr><td>formula:</td><td>C23H21ClO3</td></tr><tr><td>molar mass:</td><td>380.868 g/mol (PubChem)</td></tr></table></body></html>"));
