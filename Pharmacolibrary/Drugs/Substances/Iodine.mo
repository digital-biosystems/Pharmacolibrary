  annotation (Documentation(info = "<html><body><p>Iodine is used as a topical antiseptic and disinfectant for the skin. It is an approved drug, widely available for skin antisepsis, and is also being studied for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2064483\">Wikidata Q2064483</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>iodine</td></tr><tr><td>ATC codes:</td><td>D08AG03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB05382\">DB05382</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/807\">807</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:17606\">17606</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2064483\">Q2064483</a></td></tr><tr><td>formula:</td><td>I2</td></tr><tr><td>molar mass:</td><td>253.8 g/mol (PubChem CID 807)</td></tr><tr><td>logP:</td><td>1.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
