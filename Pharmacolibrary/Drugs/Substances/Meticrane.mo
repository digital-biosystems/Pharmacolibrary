    M = 0.275337,
    logP = 0.5);
  annotation (Documentation(info = "<html><body><p>Meticrane is a sulfonamide diuretic used to treat high blood pressure and fluid retention (oedema). It is an approved medicine but is not authorised in the European Union; it is used only in a few countries, mainly Japan.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6824077\">Wikidata Q6824077</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>meticrane</td></tr><tr><td>ATC codes:</td><td>C03BA09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13284\">DB13284</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4165\">4165</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31839\">31839</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6824077\">Q6824077</a></td></tr><tr><td>formula:</td><td>C10H13NO4S2</td></tr><tr><td>molar mass:</td><td>275.337 g/mol (PubChem CID 4165)</td></tr><tr><td>logP:</td><td>0.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Meticrane;
