  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "meticrane",
    atcCodes = {"C03BA09"},
    drugbankId = "DB13284",
    pubchemCid = "4165",
    chebiId = "31839",
    wikidataId = "Q6824077",
