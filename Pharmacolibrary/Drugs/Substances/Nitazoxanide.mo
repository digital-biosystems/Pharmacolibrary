  annotation (Documentation(info = "<html><body><p>Nitazoxanide is an antiparasitic drug used to treat the intestinal infections giardiasis and cryptosporidiosis. It is an approved medicine, also has veterinary approval, and is being studied for further uses; it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2943789&quot;>Wikidata Q2943789</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nitazoxanide</td></tr><tr><td>ATC codes:</td><td>P01AX11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00507&quot;>DB00507</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/41684&quot;>41684</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:94807&quot;>94807</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2943789&quot;>Q2943789</a></td></tr><tr><td>formula:</td><td>C12H9N3O5S</td></tr><tr><td>molar mass:</td><td>307.28 g/mol (PubChem)</td></tr></table></body></html>"));
