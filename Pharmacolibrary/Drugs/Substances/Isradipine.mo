  annotation (Documentation(info = "<html><body><p>Isradipine is a dihydropyridine calcium channel blocker used to treat high blood pressure and angina. It is an approved drug, though not authorised in the European Union, and has also been studied for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q414873\">Wikidata Q414873</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>isradipine</td></tr><tr><td>ATC codes:</td><td>C08CA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00270\">DB00270</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3784\">3784</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6073\">6073</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q414873\">Q414873</a></td></tr><tr><td>formula:</td><td>C19H21N3O5</td></tr><tr><td>molar mass:</td><td>371.393 g/mol (PubChem CID 3784)</td></tr><tr><td>logP:</td><td>4.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
