    logP = 2.3);
  annotation (Documentation(info = "<html><body><p>Cocaine is a stimulant and local anesthetic that has been used to treat pain and cough. It is an approved but illicit drug, and its medical use as a local anesthetic is now largely restricted to specialist settings such as eye, ear, nose, and throat procedures.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q41576\">Wikidata Q41576</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cocaine</td></tr><tr><td>ATC codes:</td><td>N01BC01, R02AD03, S01HA01, S02DA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00907\">DB00907</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/446220\">446220</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:27958\">27958</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q41576\">Q41576</a></td></tr><tr><td>formula:</td><td>C17H21NO4</td></tr><tr><td>molar mass:</td><td>303.358 g/mol (PubChem CID 446220)</td></tr><tr><td>logP:</td><td>2.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
