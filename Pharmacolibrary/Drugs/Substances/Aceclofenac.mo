    logP = 4.3);
  annotation (Documentation(info = "<html><body><p>Aceclofenac is a non-steroidal anti-inflammatory drug used to relieve pain and inflammation in musculoskeletal and joint conditions. It is an approved medicine, available as oral antiinflammatory/rheumatic products and as topical preparations for joint and muscular pain.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q481757&quot;>Wikidata Q481757</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>aceclofenac</td></tr><tr><td>ATC codes:</td><td>M01AB16, M02AA25</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06736&quot;>DB06736</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/71771&quot;>71771</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31159&quot;>31159</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q481757&quot;>Q481757</a></td></tr><tr><td>formula:</td><td>C16H13Cl2NO4</td></tr><tr><td>molar mass:</td><td>354.183 g/mol (PubChem)</td></tr></table></body></html>"));
end Aceclofenac;
