  annotation (Documentation(info = "<html><body><p>Ethchlorvynol is a sedative-hypnotic drug that was used to treat insomnia. It has been withdrawn from the market and is no longer in medical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3085140\">Wikidata Q3085140</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ethchlorvynol</td></tr><tr><td>ATC codes:</td><td>N05CM08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00189\">DB00189</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5281077\">5281077</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4882\">4882</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3085140\">Q3085140</a></td></tr><tr><td>formula:</td><td>C7H9ClO</td></tr><tr><td>molar mass:</td><td>144.598 g/mol (PubChem CID 5281077)</td></tr><tr><td>logP:</td><td>1.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
