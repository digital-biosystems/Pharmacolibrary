within Pharmacolibrary.Drugs.Substances;
package Butenafine "butenafine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "butenafine",
    atcCodes = {"D01AE23"},
    drugbankId = "DB01091",
    pubchemCid = "2484",
    chebiId = "3238",
    wikidataId = "Q850729",
    formula = "C23H27N",
    M = 0.317476,
    logP = 6.3);
  annotation (Documentation(info = "<html><body><p>Butenafine is a topical antifungal used to treat fungal skin infections such as tinea pedis, other tinea infections, and pityriasis versicolor. It is an approved medicine used as a cream applied to the skin, mainly in North America and some other countries; it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q850729\">Wikidata Q850729</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>butenafine</td></tr><tr><td>ATC codes:</td><td>D01AE23</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01091\">DB01091</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2484\">2484</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3238\">3238</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q850729\">Q850729</a></td></tr><tr><td>formula:</td><td>C23H27N</td></tr><tr><td>molar mass:</td><td>317.476 g/mol (PubChem CID 2484)</td></tr><tr><td>logP:</td><td>6.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Butenafine;
