  annotation (Documentation(info = "<html><body><p>Dinutuximab is a monoclonal antibody anticancer drug used to treat neuroblastoma. It is authorised in the European Union, though one EU product has been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q21011236\">Wikidata Q21011236</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>dinutuximab</td></tr><tr><td>ATC codes:</td><td>L01FX06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09077\">DB09077</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q21011236\">Q21011236</a></td></tr></table></body></html>"));
end Dinutuximab;
