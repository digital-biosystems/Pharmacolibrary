  annotation (Documentation(info = "<html><body><p>Hypochlorite (sodium hypochlorite) is an antiseptic and disinfectant used to treat fungal skin infection such as athlete's foot (tinea pedis). It is widely used as a disinfectant, including in water treatment.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q407204\">Wikidata Q407204</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Hypochlorite</td></tr><tr><td>ATC codes:</td><td>D08AX07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11123\">DB11123</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/61739\">61739</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q407204\">Q407204</a></td></tr><tr><td>formula:</td><td>ClO-</td></tr><tr><td>molar mass:</td><td>51.449 g/mol (PubChem CID 61739)</td></tr></table></body></html>"));
end Hypochlorite;
