  annotation (Documentation(info = "<html><body><p>Oxyphenisatine is a contact laxative that was used to treat constipation. It has been withdrawn from the market, reportedly because of safety concerns, and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7116108\">Wikidata Q7116108</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>oxyphenisatine</td></tr><tr><td>ATC codes:</td><td>A06AB01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB04823\">DB04823</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/31315\">31315</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135358\">135358</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7116108\">Q7116108</a></td></tr><tr><td>formula:</td><td>C20H15NO3</td></tr><tr><td>molar mass:</td><td>317.344 g/mol (PubChem CID 31315)</td></tr><tr><td>logP:</td><td>3.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
