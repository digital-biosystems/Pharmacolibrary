  annotation (Documentation(info = "<html><body><p>Pargyline is a monoamine oxidase inhibitor that was used as an antihypertensive drug to treat high blood pressure. Although it has approved status in some drug databases, it is no longer widely used in clinical practice today.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q781329\">Wikidata Q781329</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pargyline</td></tr><tr><td>ATC codes:</td><td>C02KC01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01626\">DB01626</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4688\">4688</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7930\">7930</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q781329\">Q781329</a></td></tr><tr><td>formula:</td><td>C11H13N</td></tr><tr><td>molar mass:</td><td>159.232 g/mol (PubChem CID 4688)</td></tr><tr><td>logP:</td><td>2.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Pargyline;
