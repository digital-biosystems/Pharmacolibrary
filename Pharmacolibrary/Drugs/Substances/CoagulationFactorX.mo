within Pharmacolibrary.Drugs.Substances;
package CoagulationFactorX "coagulation factor X"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "coagulation factor X",
    atcCodes = {"B02BD13"},
    drugbankId = "DB13148",
    wikidataId = "Q423701",
    M = 59);
  annotation (Documentation(info = "<html><body><p>Coagulation factor X is a human blood-clotting protein used to treat bleeding caused by a lack of factor X. It is an approved medicine, classified among blood coagulation factors, though it appears to be used only in limited settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q423701\">Wikidata Q423701</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>coagulation factor X</td></tr><tr><td>ATC codes:</td><td>B02BD13</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13148\">DB13148</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q423701\">Q423701</a></td></tr><tr><td>molar mass:</td><td>59000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end CoagulationFactorX;
