  annotation (Documentation(info = "<html><body><p>Prazepam is a benzodiazepine anxiolytic used to treat anxiety, and has also been used for spasticity, duodenal ulcer, and focal epilepsy. It is an approved medicine, though not authorised in the European Union, and is also encountered as an illicit drug.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2149443\">Wikidata Q2149443</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>prazepam</td></tr><tr><td>ATC codes:</td><td>N05BA11</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01588\">DB01588</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4890\">4890</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8362\">8362</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2149443\">Q2149443</a></td></tr><tr><td>formula:</td><td>C19H17ClN2O</td></tr><tr><td>molar mass:</td><td>324.808 g/mol (PubChem CID 4890)</td></tr><tr><td>logP:</td><td>3.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
