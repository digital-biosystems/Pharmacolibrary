  annotation (Documentation(info = "<html><body><p>Binimetinib is a MEK inhibitor anticancer drug used to treat melanoma and low-grade serous carcinoma. It is approved and authorised in the European Union, though one marketing application there was withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q19903515\">Wikidata Q19903515</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>binimetinib</td></tr><tr><td>ATC codes:</td><td>L01EE03, L01XE</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11967\">DB11967</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/10288191\">10288191</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:145371\">145371</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q19903515\">Q19903515</a></td></tr><tr><td>formula:</td><td>C17H15BrF2N4O3</td></tr><tr><td>molar mass:</td><td>441.232 g/mol (PubChem CID 10288191)</td></tr><tr><td>logP:</td><td>3.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
