    logP = 5);
  annotation (Documentation(info = "<html><body><p>Triclosan is an antimicrobial agent used as an antiseptic and disinfectant, for example in skin antisepsis and medicated dressings. It is an approved substance and remains in use, mainly in topical dermatological products such as antiseptics and anti-infective dressings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q408646\">Wikidata Q408646</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>triclosan</td></tr><tr><td>ATC codes:</td><td>D08AE04, D09AA06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08604\">DB08604</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5564\">5564</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:164200\">164200</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q408646\">Q408646</a></td></tr><tr><td>formula:</td><td>C12H7Cl3O2</td></tr><tr><td>molar mass:</td><td>289.536 g/mol (PubChem CID 5564)</td></tr><tr><td>logP:</td><td>5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Triclosan;
