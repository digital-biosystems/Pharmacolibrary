  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "triclosan",
    atcCodes = {"D08AE04", "D09AA06"},
    drugbankId = "DB08604",
    pubchemCid = "5564",
    chebiId = "164200",
    wikidataId = "Q408646",
