  annotation (Documentation(info = "<html><body><p>Sulpiride is an antipsychotic medicine used to treat psychotic disorders such as schizophrenia. It is approved in some countries and used mainly in Europe and Asia, but it is not available everywhere, as some markets have withdrawn it.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q422418&quot;>Wikidata Q422418</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sulpiride</td></tr><tr><td>ATC codes:</td><td>N05AL01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00391&quot;>DB00391</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5355&quot;>5355</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32168&quot;>32168</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q422418&quot;>Q422418</a></td></tr><tr><td>formula:</td><td>C15H23N3O4S</td></tr><tr><td>molar mass:</td><td>341.426 g/mol (PubChem)</td></tr></table></body></html>"));
