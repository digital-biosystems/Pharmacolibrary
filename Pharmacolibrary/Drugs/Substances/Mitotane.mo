within Pharmacolibrary.Drugs.Substances;
package Mitotane "mitotane"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "mitotane",
    atcCodes = {"L01XX23"},
    drugbankId = "DB00648",
    pubchemCid = "4211",
    chebiId = "6954",
    wikidataId = "Q417465",
