within Pharmacolibrary.Drugs.Substances;
package Sevelamer "sevelamer"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "sevelamer",
    atcCodes = {"V03AE02"},
    drugbankId = "DB00658",
    pubchemCid = "3085017",
    wikidataId = "Q904153",
    formula = "C6H12ClNO",
    M = 0.149618,
    logP = 0.68);
  annotation (Documentation(info = "<html><body><p>Sevelamer is a phosphate-binding (chelating) agent used to treat high blood phosphate levels in people with chronic kidney disease. It is authorised in the European Union for controlling hyperphosphatemia in patients on dialysis.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q904153&quot;>Wikidata Q904153</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>sevelamer</td></tr><tr><td>ATC codes:</td><td>V03AE02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00658&quot;>DB00658</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3085017&quot;>3085017</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q904153&quot;>Q904153</a></td></tr><tr><td>formula:</td><td>C6H12ClNO</td></tr><tr><td>molar mass:</td><td>149.618 g/mol (PubChem)</td></tr></table></body></html>"));
end Sevelamer;
