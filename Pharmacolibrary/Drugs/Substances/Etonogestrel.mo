  annotation (Documentation(info = "<html><body><p>Etonogestrel is a progestogen used as a hormonal contraceptive and has also been used for conditions such as endometriosis. It is an approved drug used widely as a female contraceptive agent.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3733839&quot;>Wikidata Q3733839</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>etonogestrel</td></tr><tr><td>ATC codes:</td><td>G03AC08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00294&quot;>DB00294</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6917715&quot;>6917715</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:50777&quot;>50777</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3733839&quot;>Q3733839</a></td></tr><tr><td>formula:</td><td>C22H28O2</td></tr><tr><td>molar mass:</td><td>324.464 g/mol (PubChem)</td></tr></table></body></html>"));
