  annotation (Documentation(info = "<html><body><p>Dextrothyroxine, a form of thyroxine, was used as a lipid-lowering agent for high blood lipids and related conditions such as arteriosclerosis and coronary artery disease. It has been withdrawn from the market and is no longer used.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5268499\">Wikidata Q5268499</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dextrothyroxine</td></tr><tr><td>ATC codes:</td><td>C10AX01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00509\">DB00509</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/8730\">8730</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:30659\">30659</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5268499\">Q5268499</a></td></tr><tr><td>formula:</td><td>C15H11I4NO4</td></tr><tr><td>molar mass:</td><td>776.856 g/mol (PubChem CID 8730)</td></tr><tr><td>logP:</td><td>2.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Dextrothyroxine;
