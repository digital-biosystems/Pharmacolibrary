  annotation (Documentation(info = "<html><body><p>Clofedanol (chlophedianol) is a cough suppressant that was used to relieve cough. It is no longer in use, having been withdrawn from the market.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2964078\">Wikidata Q2964078</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>clofedanol</td></tr><tr><td>ATC codes:</td><td>R05DB10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB04837\">DB04837</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2795\">2795</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135207\">135207</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2964078\">Q2964078</a></td></tr><tr><td>formula:</td><td>C17H20ClNO</td></tr><tr><td>molar mass:</td><td>289.803 g/mol (PubChem CID 2795)</td></tr><tr><td>logP:</td><td>3.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
