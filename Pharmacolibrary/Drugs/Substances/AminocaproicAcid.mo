  annotation (Documentation(info = "<html><body><p>Aminocaproic acid is an antifibrinolytic medicine used to treat or prevent bleeding. It is an approved drug, used mainly as a hemostatic agent to control excessive bleeding.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q255968&quot;>Wikidata Q255968</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>aminocaproic acid</td></tr><tr><td>ATC codes:</td><td>B02AA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00513&quot;>DB00513</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/564&quot;>564</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:57826&quot;>57826</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q255968&quot;>Q255968</a></td></tr><tr><td>formula:</td><td>C6H13NO2</td></tr><tr><td>molar mass:</td><td>131.175 g/mol (PubChem)</td></tr></table></body></html>"));
