  annotation (Documentation(info = "<html><body><p>Betahistine is an antivertigo medicine used to treat vertigo and balance disorders such as Ménière's disease. It is approved and widely used, mainly in Europe and other countries outside the United States, taken by mouth.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q368995&quot;>Wikidata Q368995</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>betahistine</td></tr><tr><td>ATC codes:</td><td>N07CA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06698&quot;>DB06698</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2366&quot;>2366</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:35677&quot;>35677</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q368995&quot;>Q368995</a></td></tr><tr><td>formula:</td><td>C8H12N2</td></tr><tr><td>molar mass:</td><td>136.198 g/mol (PubChem)</td></tr></table></body></html>"));
