within Pharmacolibrary.Drugs.Substances;
package LiothyronineSodium "liothyronine sodium"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "liothyronine sodium",
    atcCodes = {"H03AA02"},
    drugbankId = "DB00279",
    pubchemCid = "5920",
    chebiId = "533015",
    wikidataId = "Q327362",
    formula = "C15H12I3NO4",
    M = 0.650964);
  annotation (Documentation(info = "<html><body><p>Liothyronine sodium, a synthetic thyroid hormone, is used to treat hypothyroidism and other thyroid-related conditions such as goiter, myxedema, and thyroid carcinoma. It is an approved medicine, also approved for veterinary use, and is used less widely than levothyroxine, mainly where a faster-acting thyroid hormone is needed.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q327362\">Wikidata Q327362</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>liothyronine sodium</td></tr><tr><td>ATC codes:</td><td>H03AA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00279\">DB00279</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5920\">5920</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:533015\">533015</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q327362\">Q327362</a></td></tr><tr><td>formula:</td><td>C15H12I3NO4</td></tr><tr><td>molar mass:</td><td>650.964 g/mol (PubChem CID 5920)</td></tr></table><p><small>Drugs.Common 25.09 gave 672.95 g/mol (+3.4 %); replaced by the value above</small></p></body></html>"));
end LiothyronineSodium;
