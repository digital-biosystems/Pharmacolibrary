within Pharmacolibrary.Drugs.Substances;
package LiothyronineSodium "liothyronine sodium"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "liothyronine sodium",
    atcCodes = {"H03AA02"},
    drugbankId = "DB00279",
    pubchemCid = "5920",
    chebiId = "533015",
    wikidataId = "Q327362",
    formula = "C15H12I3NO4",
    M = 0.650964,
    logP = 0);
  annotation (Documentation(info = "<html><body><p>Liothyronine sodium, a synthetic thyroid hormone, is used to treat hypothyroidism and other thyroid-related conditions such as goiter, myxedema, and thyroid carcinoma. It is an approved medicine, also approved for veterinary use, and is used less widely than levothyroxine, mainly where a faster-acting thyroid hormone is needed.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q327362&quot;>Wikidata Q327362</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>liothyronine sodium</td></tr><tr><td>ATC codes:</td><td>H03AA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00279&quot;>DB00279</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5920&quot;>5920</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:533015&quot;>533015</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q327362&quot;>Q327362</a></td></tr><tr><td>formula:</td><td>C15H12I3NO4</td></tr><tr><td>molar mass:</td><td>650.964 g/mol (PubChem)</td></tr></table></body></html>"));
end LiothyronineSodium;
