  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "troleandomycin",
    atcCodes = {"J01FA08"},
    drugbankId = "DB13179",
    pubchemCid = "202225",
    chebiId = "45735",
    wikidataId = "Q1087499",
