within Pharmacolibrary.Drugs.Substances;
package EfbemalenograstimAlfa "efbemalenograstim alfa"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "efbemalenograstim alfa",
    atcCodes = {"L03AA18"},
    drugbankId = "DB18704");
  annotation (Documentation(info = "<html><body><p>Efbemalenograstim alfa is a long-acting colony stimulating factor (a G-CSF fusion protein) intended to stimulate white blood cell production, such as in neutropenia associated with cancer treatment. It is not an established marketed medicine; it has been investigated in clinical studies and is not authorised in the European Union.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>efbemalenograstim alfa</td></tr><tr><td>ATC codes:</td><td>L03AA18</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB18704\">DB18704</a></td></tr></table></body></html>"));
end EfbemalenograstimAlfa;
