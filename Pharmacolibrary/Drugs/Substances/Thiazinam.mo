  annotation (Documentation(info = "<html><body><p>Thiazinam is a phenothiazine-derivative antihistamine for systemic use, intended for allergic and related respiratory conditions. It appears only as an experimental compound, with no marketing authorisation, so it is not in routine clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7783885\">Wikidata Q7783885</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>thiazinam</td></tr><tr><td>ATC codes:</td><td>R06AD06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13420\">DB13420</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6016\">6016</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135268\">135268</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7783885\">Q7783885</a></td></tr><tr><td>formula:</td><td>C18H23N2S+</td></tr><tr><td>molar mass:</td><td>299.456 g/mol (PubChem CID 6016)</td></tr><tr><td>logP:</td><td>4.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
