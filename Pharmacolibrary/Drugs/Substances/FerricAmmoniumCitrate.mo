  annotation (Documentation(info = "<html><body><p>Ferric ammonium citrate is a paramagnetic contrast agent that was used in magnetic resonance imaging. It has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q473522\">Wikidata Q473522</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ferric ammonium citrate</td></tr><tr><td>ATC codes:</td><td>V08CA07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09501\">DB09501</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q473522\">Q473522</a></td></tr><tr><td>formula:</td><td>C6H11FeNO7</td></tr><tr><td>molar mass:</td><td>264.997 g/mol (knowledgebase (DrugBank calculated))</td></tr></table></body></html>"));
