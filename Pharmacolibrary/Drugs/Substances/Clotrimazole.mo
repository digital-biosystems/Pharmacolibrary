  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "clotrimazole",
    atcCodes = {"A01AB18", "D01AC01", "G01AF02"},
    drugbankId = "DB00257",
    pubchemCid = "2812",
    chebiId = "3764",
    wikidataId = "Q413546",
