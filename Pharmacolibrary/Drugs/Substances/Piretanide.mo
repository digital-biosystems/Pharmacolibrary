    logP = 2.2);
  annotation (Documentation(info = "<html><body><p>Piretanide is a loop (high-ceiling) diuretic used to treat conditions involving fluid retention, such as oedema and hypertension. It is an approved medicine, though it is not widely used and is not authorised across the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3905617\">Wikidata Q3905617</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>piretanide</td></tr><tr><td>ATC codes:</td><td>C03CA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB02925\">DB02925</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4849\">4849</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32015\">32015</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3905617\">Q3905617</a></td></tr><tr><td>formula:</td><td>C17H18N2O5S</td></tr><tr><td>molar mass:</td><td>362.4 g/mol (PubChem CID 4849)</td></tr><tr><td>logP:</td><td>2.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Piretanide;
