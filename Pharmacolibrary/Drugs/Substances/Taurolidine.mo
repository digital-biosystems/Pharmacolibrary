    logP = -1.7);
  annotation (Documentation(info = "<html><body><p>Taurolidine is an anti-infective agent used as an irrigating solution, and has also been investigated as an antineoplastic drug. It is an approved medicine, though not authorised centrally in the European Union, and is used only in limited settings such as irrigation.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3981568\">Wikidata Q3981568</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>taurolidine</td></tr><tr><td>ATC codes:</td><td>B05CA05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12473\">DB12473</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/29566\">29566</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135173\">135173</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3981568\">Q3981568</a></td></tr><tr><td>formula:</td><td>C7H16N4O4S2</td></tr><tr><td>molar mass:</td><td>284.349 g/mol (PubChem CID 29566)</td></tr><tr><td>logP:</td><td>-1.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Taurolidine;
