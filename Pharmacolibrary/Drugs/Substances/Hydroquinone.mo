    logP = 0.6);
  annotation (Documentation(info = "<html><body><p>Hydroquinone is a skin-lightening agent used to treat hyperpigmentation such as dark spots and melasma. It is an approved topical dermatological medicine, though its availability is restricted in some countries due to safety concerns.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q419164\">Wikidata Q419164</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>hydroquinone</td></tr><tr><td>ATC codes:</td><td>D11AX11</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09526\">DB09526</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/785\">785</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:17594\">17594</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q419164\">Q419164</a></td></tr><tr><td>formula:</td><td>C6H6O2</td></tr><tr><td>molar mass:</td><td>110.112 g/mol (PubChem CID 785)</td></tr><tr><td>logP:</td><td>0.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
