    logP = 1);
  annotation (Documentation(info = "<html><body><p>Thiamine (vitamin B1) is used to treat or prevent thiamine deficiency states such as beriberi and Wernicke encephalopathy, and related conditions like alcoholic neuropathy. It is widely used worldwide, appears on the WHO essential medicines list, is approved as a supplement and medicine, and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q83187\">Wikidata Q83187</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>thiamine (vit B1)</td></tr><tr><td>ATC codes:</td><td>A11DA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00152\">DB00152</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/1130\">1130</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:18385\">18385</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q83187\">Q83187</a></td></tr><tr><td>formula:</td><td>C12H17N4OS+</td></tr><tr><td>molar mass:</td><td>265.355 g/mol (PubChem CID 1130)</td></tr><tr><td>logP:</td><td>1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end ThiamineVitB1;
