  annotation (Documentation(info = "<html><body><p>Cicletanine is a diuretic that has also been described as an antihypertensive and antiarrhythmic agent. It is considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5119443\">Wikidata Q5119443</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cicletanine</td></tr><tr><td>ATC codes:</td><td>C03BX03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12766\">DB12766</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/54910\">54910</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135078\">135078</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5119443\">Q5119443</a></td></tr><tr><td>formula:</td><td>C14H12ClNO2</td></tr><tr><td>molar mass:</td><td>261.705 g/mol (PubChem CID 54910)</td></tr><tr><td>logP:</td><td>2.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
