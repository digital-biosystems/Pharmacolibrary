    M = 0.425917,
    logP = 3.9);
  annotation (Documentation(info = "<html><body><p>Domperidone is a dopamine-blocking medicine used to treat nausea and vomiting and to help the stomach empty, and it is also taken to boost milk production. It is an approved medicine, widely used in many countries for these stomach-related problems, though it is not authorised in the United States.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q424238&quot;>Wikidata Q424238</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>domperidone</td></tr><tr><td>ATC codes:</td><td>A03FA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01184&quot;>DB01184</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3151&quot;>3151</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31515&quot;>31515</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q424238&quot;>Q424238</a></td></tr><tr><td>formula:</td><td>C22H24ClN5O2</td></tr><tr><td>molar mass:</td><td>425.917 g/mol (PubChem)</td></tr></table></body></html>"));
end Domperidone;
