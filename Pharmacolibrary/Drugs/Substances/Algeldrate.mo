  annotation (Documentation(info = "<html><body><p>Algeldrate (aluminium hydroxide) is an antacid used to treat acid-related digestive problems such as duodenal ulcers. It is an approved medicine, widely used as an antacid, and also serves as an immunologic adjuvant in vaccines.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q407125&quot;>Wikidata Q407125</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>algeldrate</td></tr><tr><td>ATC codes:</td><td>A02AB02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06723&quot;>DB06723</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/22721319&quot;>22721319</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q407125&quot;>Q407125</a></td></tr><tr><td>formula:</td><td>AlH5O4</td></tr><tr><td>molar mass:</td><td>96.018 g/mol (PubChem)</td></tr></table></body></html>"));
