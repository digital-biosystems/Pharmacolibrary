  annotation (Documentation(info = "<html><body><p>Algeldrate (aluminium hydroxide) is an antacid used to relieve acid-related stomach disorders such as heartburn and indigestion. It is an approved, widely available over-the-counter antacid, often combined with other antacids.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4060653\">Wikidata Q4060653</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>algeldrate</td></tr><tr><td>ATC codes:</td><td>A02AB02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06723\">DB06723</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/22721319\">22721319</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4060653\">Q4060653</a></td></tr><tr><td>formula:</td><td>AlH5O4</td></tr><tr><td>molar mass:</td><td>96.018 g/mol (PubChem CID 22721319)</td></tr></table></body></html>"));
end Algeldrate;
