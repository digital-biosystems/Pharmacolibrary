    logP = 1.2);
  annotation (Documentation(info = "<html><body><p>Quinethazone is a diuretic used to treat high blood pressure, congestive heart failure, nephrotic syndrome, and widespread fluid retention (anasarka). It is an approved low-ceiling diuretic, though it is not authorised in the European Union and appears to be used only to a limited extent.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7272222&quot;>Wikidata Q7272222</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>quinethazone</td></tr><tr><td>ATC codes:</td><td>C03BA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01325&quot;>DB01325</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6307&quot;>6307</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8717&quot;>8717</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7272222&quot;>Q7272222</a></td></tr><tr><td>formula:</td><td>C10H12ClN3O3S</td></tr><tr><td>molar mass:</td><td>289.734 g/mol (PubChem)</td></tr></table></body></html>"));
end Quinethazone;
