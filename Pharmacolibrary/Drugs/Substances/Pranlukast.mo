  annotation (Documentation(info = "<html><body><p>Pranlukast is a leukotriene receptor antagonist developed as an antiasthmatic medicine for obstructive airway disease. It is not authorised in the European Union and is listed as investigational, so its availability appears limited.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7238392&quot;>Wikidata Q7238392</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pranlukast</td></tr><tr><td>ATC codes:</td><td>R03DC02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01411&quot;>DB01411</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4887&quot;>4887</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:94810&quot;>94810</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7238392&quot;>Q7238392</a></td></tr><tr><td>formula:</td><td>C27H23N5O4</td></tr><tr><td>molar mass:</td><td>481.512 g/mol (PubChem)</td></tr></table></body></html>"));
