  annotation (Documentation(info = "<html><body><p>Etynodiol is a synthetic progestogen that has been used in hormonal contraceptives, notably in fixed combinations with estrogens. It is currently classified as an experimental compound and does not appear to be an approved medicine today.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5405158\">Wikidata Q5405158</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>etynodiol</td></tr><tr><td>ATC codes:</td><td>G03DC06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13866\">DB13866</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/14687\">14687</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:50785\">50785</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5405158\">Q5405158</a></td></tr><tr><td>formula:</td><td>C20H28O2</td></tr><tr><td>molar mass:</td><td>300.442 g/mol (PubChem CID 14687)</td></tr><tr><td>logP:</td><td>3.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
