  annotation (Documentation(info = "<html><body><p>Demecarium is a parasympathomimetic miotic eye drop used to treat glaucoma. It is an approved medicine, but it is not widely used and is mainly a niche option in glaucoma care.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q81984383\">Wikidata Q81984383</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>demecarium</td></tr><tr><td>ATC codes:</td><td>S01EB04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00944\">DB00944</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5966\">5966</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:59719\">59719</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q81984383\">Q81984383</a></td></tr><tr><td>formula:</td><td>C32H52N4O4+2</td></tr><tr><td>molar mass:</td><td>556.792 g/mol (PubChem CID 5966)</td></tr><tr><td>logP:</td><td>6.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
