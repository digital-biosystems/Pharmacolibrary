  annotation (Documentation(info = "<html><body><p>Vutrisiran is a medication used to treat familial amyloid polyneuropathy, a hereditary nerve disease. It is authorised in the European Union and is also being studied for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q112620160&quot;>Wikidata Q112620160</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>vutrisiran</td></tr><tr><td>ATC codes:</td><td>N07XX18</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB16699&quot;>DB16699</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q112620160&quot;>Q112620160</a></td></tr><tr><td>molar mass:</td><td>16345 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
