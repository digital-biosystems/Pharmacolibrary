  annotation (Documentation(info = "<html><body><p>Bamipine is an antihistamine (a histamine antagonist) used against itching and allergy, applied topically to the skin or taken by mouth. It is considered investigational and does not appear to be an approved medicine in major markets such as the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4853502\">Wikidata Q4853502</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bamipine</td></tr><tr><td>ATC codes:</td><td>D04AA15, R06AX01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13489\">DB13489</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/72075\">72075</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135165\">135165</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4853502\">Q4853502</a></td></tr><tr><td>formula:</td><td>C19H24N2</td></tr><tr><td>molar mass:</td><td>280.415 g/mol (PubChem CID 72075)</td></tr><tr><td>logP:</td><td>4.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
