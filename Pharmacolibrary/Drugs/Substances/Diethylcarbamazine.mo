  annotation (Documentation(info = "<html><body><p>Diethylcarbamazine is an antinematodal drug used to treat infections caused by roundworms, such as filarial diseases. It remains in use, is included on the WHO list of essential medicines, and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q409267\">Wikidata Q409267</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>diethylcarbamazine</td></tr><tr><td>ATC codes:</td><td>P02CB02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00711\">DB00711</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3052\">3052</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4527\">4527</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q409267\">Q409267</a></td></tr><tr><td>formula:</td><td>C10H21N3O</td></tr><tr><td>molar mass:</td><td>199.298 g/mol (PubChem CID 3052)</td></tr><tr><td>logP:</td><td>0.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
