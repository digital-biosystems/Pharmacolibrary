  annotation (Documentation(info = "<html><body><p>Halcinonide is a very potent topical corticosteroid used to treat inflammatory skin conditions such as dermatoses of the face, scalp, legs, and hands. It has been withdrawn, so it is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q425991\">Wikidata Q425991</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>halcinonide</td></tr><tr><td>ATC codes:</td><td>D07AD02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06786\">DB06786</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/443943\">443943</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31663\">31663</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q425991\">Q425991</a></td></tr><tr><td>formula:</td><td>C24H32ClFO5</td></tr><tr><td>molar mass:</td><td>454.963 g/mol (PubChem CID 443943)</td></tr><tr><td>logP:</td><td>3.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
