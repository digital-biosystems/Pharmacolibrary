    logP = 3.6);
  annotation (Documentation(info = "<html><body><p>Halcinonide is a very potent topical corticosteroid used to treat inflammatory skin conditions such as dermatoses of the face, scalp, legs, and hands. It has been withdrawn, so it is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q425991&quot;>Wikidata Q425991</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>halcinonide</td></tr><tr><td>ATC codes:</td><td>D07AD02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06786&quot;>DB06786</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/443943&quot;>443943</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31663&quot;>31663</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q425991&quot;>Q425991</a></td></tr><tr><td>formula:</td><td>C24H32ClFO5</td></tr><tr><td>molar mass:</td><td>454.963 g/mol (PubChem)</td></tr></table></body></html>"));
end Halcinonide;
