within Pharmacolibrary.Drugs.Substances;
package Metronidazole "metronidazole"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "metronidazole",
    atcCodes = {"A01AB17", "D06BX01", "G01AF01", "J01XD01", "P01AB01"},
    drugbankId = "DB00916",
    pubchemCid = "4173",
    chebiId = "6909",
    wikidataId = "Q169569",
    formula = "C6H9N3O3",
    M = 0.171156);
  annotation (Documentation(info = "<html><body><p>Metronidazole is an antibacterial and antiprotozoal drug used to treat infections such as bacterial vaginosis, amebiasis, giardiasis, abscesses, rosacea, and to help eradicate Helicobacter pylori. It is widely used around the world and appears on the WHO essential medicines list, available in oral, topical, and gynecological formulations.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q169569\">Wikidata Q169569</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>metronidazole</td></tr><tr><td>ATC codes:</td><td>A01AB17, D06BX01, G01AF01, J01XD01, P01AB01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00916\">DB00916</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4173\">4173</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6909\">6909</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q169569\">Q169569</a></td></tr><tr><td>formula:</td><td>C6H9N3O3</td></tr><tr><td>molar mass:</td><td>171.156 g/mol (PubChem CID 4173)</td></tr></table></body></html>"));
end Metronidazole;
