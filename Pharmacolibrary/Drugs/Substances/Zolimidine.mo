  annotation (Documentation(info = "<html><body><p>Zolimidine is a drug classified under other drugs for peptic ulcer and gastro-oesophageal reflux disease, suggesting it was intended for acid-related stomach disorders. It is currently listed only as an experimental compound, with no authorisation records, so its current availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q8073565\">Wikidata Q8073565</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>zolimidine</td></tr><tr><td>ATC codes:</td><td>A02BX10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13593\">DB13593</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/14652\">14652</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135125\">135125</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q8073565\">Q8073565</a></td></tr><tr><td>formula:</td><td>C14H12N2O2S</td></tr><tr><td>molar mass:</td><td>272.322 g/mol (PubChem CID 14652)</td></tr><tr><td>logP:</td><td>2.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
