  annotation (Documentation(info = "<html><body><p>Phenazone (antipyrine) is a pyrazolone painkiller and fever reducer used for pain and ear conditions such as middle ear inflammation. It remains an approved medicine, used mainly in ear drops for ear pain, though it is no longer a common general painkiller.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q415578&quot;>Wikidata Q415578</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>phenazone</td></tr><tr><td>ATC codes:</td><td>N02BB01, S02DA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01435&quot;>DB01435</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2206&quot;>2206</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q415578&quot;>Q415578</a></td></tr><tr><td>formula:</td><td>C11H12N2O</td></tr><tr><td>molar mass:</td><td>188.23 g/mol (PubChem)</td></tr></table></body></html>"));
end Phenazone;
