  annotation (Documentation(info = "<html><body><p>Agomelatine is an antidepressant used to treat major depressive disorder. It is authorised in the European Union, though some marketing applications were refused or withdrawn, so its availability there is limited.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q395229\">Wikidata Q395229</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>agomelatine</td></tr><tr><td>ATC codes:</td><td>N06AX22</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06594\">DB06594</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/82148\">82148</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134990\">134990</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q395229\">Q395229</a></td></tr><tr><td>formula:</td><td>C15H17NO2</td></tr><tr><td>molar mass:</td><td>243.306 g/mol (PubChem CID 82148)</td></tr><tr><td>logP:</td><td>2.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
