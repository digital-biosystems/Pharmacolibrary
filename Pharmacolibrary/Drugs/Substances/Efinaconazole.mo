  annotation (Documentation(info = "<html><body><p>Efinaconazole is a topical antifungal drug used to treat fungal infections of the skin and nails. It is an approved medicine, used mainly as a topical treatment applied directly to the affected area.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q21011225&quot;>Wikidata Q21011225</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>efinaconazole</td></tr><tr><td>ATC codes:</td><td>D01AC19</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09040&quot;>DB09040</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/489181&quot;>489181</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:82718&quot;>82718</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q21011225&quot;>Q21011225</a></td></tr><tr><td>formula:</td><td>C18H22F2N4O</td></tr><tr><td>molar mass:</td><td>348.397 g/mol (PubChem)</td></tr></table></body></html>"));
