  annotation (Documentation(info = "<html><body><p>Cloridarol is a vasodilator drug classified under cardiac therapy, suggesting it was used for heart-related conditions involving poor blood flow. It appears only as an experimental compound and is not authorised in the European Union, so its current use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5135141\">Wikidata Q5135141</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cloridarol</td></tr><tr><td>ATC codes:</td><td>C01DX15</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13291\">DB13291</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/71132\">71132</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135066\">135066</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5135141\">Q5135141</a></td></tr><tr><td>formula:</td><td>C15H11ClO2</td></tr><tr><td>molar mass:</td><td>258.701 g/mol (PubChem CID 71132)</td></tr><tr><td>logP:</td><td>3.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
