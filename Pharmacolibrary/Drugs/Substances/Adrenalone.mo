    logP = 0.5);
  annotation (Documentation(info = "<html><body><p>Adrenalone is a vasoconstrictor and hemostatic compound used to stop local bleeding, including in dental (stomatological) preparations. It is considered an experimental drug and is not an authorised medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2186476&quot;>Wikidata Q2186476</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>adrenalone</td></tr><tr><td>ATC codes:</td><td>A01AD06, B02BC05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13394&quot;>DB13394</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/7436&quot;>7436</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134821&quot;>134821</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2186476&quot;>Q2186476</a></td></tr><tr><td>formula:</td><td>C9H11NO3</td></tr><tr><td>molar mass:</td><td>181.191 g/mol (PubChem)</td></tr></table></body></html>"));
end Adrenalone;
