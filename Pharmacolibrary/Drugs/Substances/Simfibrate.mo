  annotation (Documentation(info = "<html><body><p>Simfibrate is a fibrate, a class of lipid-modifying drugs used to lower blood lipid levels. It is classed as an experimental compound and does not appear to be an approved medicine today.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4117078\">Wikidata Q4117078</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>simfibrate</td></tr><tr><td>ATC codes:</td><td>C10AB06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13433\">DB13433</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5217\">5217</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32131\">32131</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4117078\">Q4117078</a></td></tr><tr><td>formula:</td><td>C23H26Cl2O6</td></tr><tr><td>molar mass:</td><td>469.355 g/mol (PubChem CID 5217)</td></tr><tr><td>logP:</td><td>6.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
