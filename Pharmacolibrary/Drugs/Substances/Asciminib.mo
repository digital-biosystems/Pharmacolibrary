  annotation (Documentation(info = "<html><body><p>Asciminib is a BCR-ABL tyrosine kinase inhibitor used to treat chronic myeloid leukemia. It is authorised in the European Union for BCR-ABL positive chronic myelogenous leukemia.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27074535\">Wikidata Q27074535</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>asciminib</td></tr><tr><td>ATC codes:</td><td>L01EA06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12597\">DB12597</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/72165228\">72165228</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27074535\">Q27074535</a></td></tr><tr><td>formula:</td><td>C20H18ClF2N5O3</td></tr><tr><td>molar mass:</td><td>449.842 g/mol (PubChem CID 72165228)</td></tr><tr><td>logP:</td><td>3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
