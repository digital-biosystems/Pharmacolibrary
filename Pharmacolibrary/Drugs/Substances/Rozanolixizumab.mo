    M = 148);
  annotation (Documentation(info = "<html><body><p>Rozanolixizumab is a monoclonal antibody used to treat myasthenia gravis. It is an authorised medicine in the European Union, given as an immunosuppressant that blocks the neonatal Fc receptor.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q120491843\">Wikidata Q120491843</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>rozanolixizumab</td></tr><tr><td>ATC codes:</td><td>L04AG16, L04AL02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB14919\">DB14919</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q120491843\">Q120491843</a></td></tr><tr><td>molar mass:</td><td>148000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Rozanolixizumab;
