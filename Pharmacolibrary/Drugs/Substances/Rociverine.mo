  annotation (Documentation(info = "<html><body><p>Rociverine is an anticholinergic (parasympatholytic) drug intended for functional gastrointestinal disorders. It is considered investigational and does not appear to be an approved medicine in major markets such as the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3939643&quot;>Wikidata Q3939643</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>rociverine</td></tr><tr><td>ATC codes:</td><td>A03AA06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13581&quot;>DB13581</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/24892842&quot;>24892842</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135440&quot;>135440</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3939643&quot;>Q3939643</a></td></tr><tr><td>formula:</td><td>C20H37NO3</td></tr><tr><td>molar mass:</td><td>339.52 g/mol (PubChem)</td></tr></table></body></html>"));
