    logP = 2.7);
  annotation (Documentation(info = "<html><body><p>Erythromycin is a macrolide antibiotic used to treat a range of bacterial infections, including acne, chlamydia, pertussis, legionnaires' disease, and campylobacteriosis. It is widely used in human medicine and is also approved for veterinary use; it appears on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q213511&quot;>Wikidata Q213511</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>erythromycin</td></tr><tr><td>ATC codes:</td><td>D10AF02, J01FA01, S01AA17</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00199&quot;>DB00199</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/12560&quot;>12560</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:42355&quot;>42355</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q213511&quot;>Q213511</a></td></tr><tr><td>formula:</td><td>C37H67NO13</td></tr><tr><td>molar mass:</td><td>733.937 g/mol (PubChem)</td></tr></table></body></html>"));
end Erythromycin;
