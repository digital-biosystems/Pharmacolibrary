  annotation (Documentation(info = "<html><body><p>Etilevodopa (given with a decarboxylase inhibitor) is a dopa-derivative drug developed for treating Parkinson's disease. It remains experimental and is not an established marketed treatment.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5404593\">Wikidata Q5404593</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>etilevodopa and decarboxylase inhibitor</td></tr><tr><td>ATC codes:</td><td>N04BA06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06535\">DB06535</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135971\">135971</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5404593\">Q5404593</a></td></tr><tr><td>formula:</td><td>C11H15NO4</td></tr><tr><td>molar mass:</td><td>225.244 g/mol (knowledgebase (DrugBank calculated))</td></tr><tr><td>logP:</td><td>0.97 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
