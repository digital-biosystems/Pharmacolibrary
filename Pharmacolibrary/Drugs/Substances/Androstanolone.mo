  annotation (Documentation(info = "<html><body><p>Androstanolone (dihydrotestosterone) is an androgen steroid that has been used as an anabolic agent and sex-hormone treatment. It is not an approved medicine today; it is considered investigational and is also treated as an illicit doping substance.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q411054&quot;>Wikidata Q411054</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>androstanolone</td></tr><tr><td>ATC codes:</td><td>A14AA01, G03BB02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB02901&quot;>DB02901</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/10635&quot;>10635</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q411054&quot;>Q411054</a></td></tr><tr><td>formula:</td><td>C19H30O2</td></tr><tr><td>molar mass:</td><td>290.447 g/mol (PubChem)</td></tr></table></body></html>"));
