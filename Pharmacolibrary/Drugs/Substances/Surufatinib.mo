  annotation (Documentation(info = "<html><body><p>Surufatinib is an investigational protein kinase inhibitor studied for treating neuroendocrine tumors. Its marketing application in the European Union was withdrawn, so it is not authorised there.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q126122215\">Wikidata Q126122215</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>surufatinib</td></tr><tr><td>ATC codes:</td><td>L01EX24</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB15106\">DB15106</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/52920501\">52920501</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q126122215\">Q126122215</a></td></tr><tr><td>formula:</td><td>C24H28N6O3S</td></tr><tr><td>molar mass:</td><td>480.587 g/mol (PubChem CID 52920501)</td></tr><tr><td>logP:</td><td>3.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
