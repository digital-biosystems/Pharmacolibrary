  annotation (Documentation(info = "<html><body><p>Relebactam is a beta-lactamase inhibitor used to treat serious bacterial infections, given alongside a carbapenem antibiotic. It is an approved medicine, used mainly in hospital settings for infections caused by resistant bacteria.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27252695&quot;>Wikidata Q27252695</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Relebactam</td></tr><tr><td>ATC codes:</td><td>J01DH56</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12377&quot;>DB12377</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/44129647&quot;>44129647</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27252695&quot;>Q27252695</a></td></tr><tr><td>formula:</td><td>C12H20N4O6S</td></tr><tr><td>molar mass:</td><td>348.374 g/mol (PubChem)</td></tr></table></body></html>"));
