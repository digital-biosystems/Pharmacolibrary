  annotation (Documentation(info = "<html><body><p>Etybenzatropine is a tropine-derivative anticholinergic agent classified for the treatment of Parkinson's disease. It appears to be only an experimental compound, with no authorised marketing identified.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3592644\">Wikidata Q3592644</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>etybenzatropine</td></tr><tr><td>ATC codes:</td><td>N04AC30</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13468\">DB13468</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/20055089\">20055089</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135972\">135972</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3592644\">Q3592644</a></td></tr><tr><td>formula:</td><td>C22H27NO</td></tr><tr><td>molar mass:</td><td>321.464 g/mol (PubChem CID 20055089)</td></tr><tr><td>logP:</td><td>4.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
