  annotation (Documentation(info = "<html><body><p>Ioflupane I-123 is a radiopharmaceutical used as an imaging agent for brain scans, notably in assessing movement disorders and dementia. It is authorised in the European Union and used in radionuclide imaging, mainly in specialist settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3801359\">Wikidata Q3801359</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>iodine ioflupane (123I)</td></tr><tr><td>ATC codes:</td><td>V09AB03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08824\">DB08824</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3801359\">Q3801359</a></td></tr><tr><td>molar mass:</td><td>427.3 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
