    logP = 2.4);
  annotation (Documentation(info = "<html><body><p>Propyliodone is an iodinated X-ray contrast medium used to make body structures visible during imaging. It is classified as a non-water-soluble contrast agent and is listed as an approved drug.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7250472&quot;>Wikidata Q7250472</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>propyliodone</td></tr><tr><td>ATC codes:</td><td>V08AD03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09366&quot;>DB09366</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4949&quot;>4949</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32064&quot;>32064</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7250472&quot;>Q7250472</a></td></tr><tr><td>formula:</td><td>C10H11I2NO3</td></tr><tr><td>molar mass:</td><td>447.002 g/mol (PubChem)</td></tr></table></body></html>"));
end Propyliodone;
