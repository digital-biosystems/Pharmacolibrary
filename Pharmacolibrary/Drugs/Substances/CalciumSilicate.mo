  annotation (Documentation(info = "<html><body><p>Calcium silicate is a calcium compound classified as an antacid for acid-related digestive disorders. It is listed as investigational, so it is not an established, widely approved treatment.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q416365\">Wikidata Q416365</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>calcium silicate</td></tr><tr><td>ATC codes:</td><td>A02AC02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13829\">DB13829</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q416365\">Q416365</a></td></tr><tr><td>formula:</td><td>CaH6O8Si2</td></tr><tr><td>molar mass:</td><td>230.288 g/mol (knowledgebase (DrugBank calculated))</td></tr></table></body></html>"));
end CalciumSilicate;
