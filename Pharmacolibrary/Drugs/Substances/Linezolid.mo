within Pharmacolibrary.Drugs.Substances;
package Linezolid "linezolid"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "linezolid",
    atcCodes = {"J01XX08"},
    drugbankId = "DB00601",
    pubchemCid = "441401",
    chebiId = "63607",
    wikidataId = "Q411377",
    formula = "C16H20FN3O4",
    M = 0.337351,
    logP = 0.7);
  annotation (Documentation(info = "<html><body><p>Linezolid is an antibiotic used to treat serious bacterial infections, including pneumonia, skin infections such as cellulitis, urinary tract infections, and resistant staphylococcal infections like MRSA. It is an approved medicine and is included on the WHO list of essential medicines, so it is widely available for human use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q411377\">Wikidata Q411377</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>linezolid</td></tr><tr><td>ATC codes:</td><td>J01XX08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00601\">DB00601</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/441401\">441401</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:63607\">63607</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q411377\">Q411377</a></td></tr><tr><td>formula:</td><td>C16H20FN3O4</td></tr><tr><td>molar mass:</td><td>337.351 g/mol (PubChem CID 441401)</td></tr><tr><td>logP:</td><td>0.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Linezolid;
