  annotation (Documentation(info = "<html><body><p>Pyritinol is a nootropic compound, related to vitamin B6, that has been studied for treating Alzheimer's disease. It is considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q416361&quot;>Wikidata Q416361</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pyritinol</td></tr><tr><td>ATC codes:</td><td>N06BX02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13084&quot;>DB13084</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/14190&quot;>14190</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135554&quot;>135554</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q416361&quot;>Q416361</a></td></tr><tr><td>formula:</td><td>C16H20N2O4S2</td></tr><tr><td>molar mass:</td><td>368.466 g/mol (PubChem)</td></tr></table></body></html>"));
