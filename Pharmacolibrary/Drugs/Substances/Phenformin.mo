    logP = -0.8);
  annotation (Documentation(info = "<html><body><p>Phenformin is a biguanide anti-diabetic medication that was used to lower blood sugar in people with diabetes. It has been withdrawn from the market because it caused serious lactic acidosis, and it is no longer used in human medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q753100\">Wikidata Q753100</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>phenformin</td></tr><tr><td>ATC codes:</td><td>A10BA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00914\">DB00914</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/8249\">8249</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8064\">8064</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q753100\">Q753100</a></td></tr><tr><td>formula:</td><td>C10H15N5</td></tr><tr><td>molar mass:</td><td>205.265 g/mol (PubChem CID 8249)</td></tr><tr><td>logP:</td><td>-0.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Phenformin;
