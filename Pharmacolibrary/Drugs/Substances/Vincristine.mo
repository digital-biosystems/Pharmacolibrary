    logP = 2.8);
  annotation (Documentation(info = "<html><body><p>Vincristine is a Vinca alkaloid chemotherapy used to treat several cancers, including leukemia, lymphoma, neuroblastoma, and sarcomas such as Ewing sarcoma and rhabdomyosarcoma. It is an approved medicine and is included on the WHO list of essential medicines, so it is widely used in cancer care.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q408977&quot;>Wikidata Q408977</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>vincristine</td></tr><tr><td>ATC codes:</td><td>L01CA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00541&quot;>DB00541</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5978&quot;>5978</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:28445&quot;>28445</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q408977&quot;>Q408977</a></td></tr><tr><td>formula:</td><td>C46H56N4O10</td></tr><tr><td>molar mass:</td><td>824.972 g/mol (PubChem)</td></tr></table></body></html>"));
end Vincristine;
