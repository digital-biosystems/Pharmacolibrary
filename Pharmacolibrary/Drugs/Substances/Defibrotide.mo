within Pharmacolibrary.Drugs.Substances;
package Defibrotide "defibrotide"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "defibrotide",
    atcCodes = {"B01AX01"},
    drugbankId = "DB04932",
    wikidataId = "Q3704725");
  annotation (Documentation(info = "<html><body><p>Defibrotide, a mixture of single-stranded DNA fragments from pig intestinal mucosa, is an antithrombotic medicine used to treat hepatic veno-occlusive disease. It is authorised in the European Union and is also being studied for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3704725&quot;>Wikidata Q3704725</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>defibrotide</td></tr><tr><td>ATC codes:</td><td>B01AX01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB04932&quot;>DB04932</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3704725&quot;>Q3704725</a></td></tr></table></body></html>"));
end Defibrotide;
