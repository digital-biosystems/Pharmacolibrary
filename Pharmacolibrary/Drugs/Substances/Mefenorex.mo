    logP = 3.1);
  annotation (Documentation(info = "<html><body><p>Mefenorex is a sympathomimetic amphetamine-type drug that was used as a centrally acting antiobesity medicine to treat obesity. It is no longer in routine medical use and is considered an experimental drug, with no authorisation from the European Medicines Agency.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q10579342\">Wikidata Q10579342</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mefenorex</td></tr><tr><td>ATC codes:</td><td>A08AA09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13852\">DB13852</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/21777\">21777</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134883\">134883</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q10579342\">Q10579342</a></td></tr><tr><td>formula:</td><td>C12H18ClN</td></tr><tr><td>molar mass:</td><td>211.733 g/mol (PubChem CID 21777)</td></tr><tr><td>logP:</td><td>3.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Mefenorex;
