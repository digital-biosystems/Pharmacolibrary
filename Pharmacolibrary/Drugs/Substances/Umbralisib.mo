  annotation (Documentation(info = "<html><body><p>Umbralisib is a protein kinase inhibitor that was used to treat certain blood cancers, including lymphoma. It is no longer used: its approval was withdrawn after safety concerns, including an increased risk of death seen in clinical trials.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27088612\">Wikidata Q27088612</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>umbralisib</td></tr><tr><td>ATC codes:</td><td>L01EX25</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB14989\">DB14989</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/72950888\">72950888</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27088612\">Q27088612</a></td></tr><tr><td>formula:</td><td>C31H24F3N5O3</td></tr><tr><td>molar mass:</td><td>571.559 g/mol (PubChem CID 72950888)</td></tr><tr><td>logP:</td><td>5.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
