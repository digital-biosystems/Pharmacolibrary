  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "valproic acid",
    atcCodes = {"N03AG01"},
    drugbankId = "DB00313",
    pubchemCid = "3121",
    chebiId = "39867",
    wikidataId = "Q240642",
    formula = "C8H16O2",
    M = 0.144214,
    logP = 2.8);
  annotation (Documentation(info = "<html><body><p>Valproic acid is an antiepileptic drug used to treat epilepsy, including childhood absence epilepsy and complex partial seizures, and also bipolar disorder. It is widely used and appears on the WHO essential medicines list, though it carries a boxed warning as a developmental toxicant.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q240642&quot;>Wikidata Q240642</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>valproic acid</td></tr><tr><td>ATC codes:</td><td>N03AG01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00313&quot;>DB00313</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3121&quot;>3121</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:39867&quot;>39867</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q240642&quot;>Q240642</a></td></tr><tr><td>formula:</td><td>C8H16O2</td></tr><tr><td>molar mass:</td><td>144.214 g/mol (PubChem)</td></tr></table></body></html>"));
