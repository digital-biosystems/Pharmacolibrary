  annotation (Documentation(info = "<html><body><p>Interferon alfacon-1 is an antiviral, immunostimulating interferon that was used to treat chronic hepatitis C. It was approved but has since been withdrawn, including its product in the European Union, and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q15353101\">Wikidata Q15353101</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>interferon alfacon-1</td></tr><tr><td>ATC codes:</td><td>L03AB09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00069\">DB00069</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q15353101\">Q15353101</a></td></tr><tr><td>molar mass:</td><td>19343 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end InterferonAlfacon1;
