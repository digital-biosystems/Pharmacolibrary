    logP = -0.4);
  annotation (Documentation(info = "<html><body><p>Nimorazole is a nitroimidazole antiprotozoal drug that has been used to treat infections caused by protozoa, particularly trichomoniasis. It is considered investigational in current drug databases and is not authorised in the European Union, so it is not in widespread clinical use today.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7037737&quot;>Wikidata Q7037737</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nimorazole</td></tr><tr><td>ATC codes:</td><td>P01AB06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12172&quot;>DB12172</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/23009&quot;>23009</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134929&quot;>134929</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7037737&quot;>Q7037737</a></td></tr><tr><td>formula:</td><td>C9H14N4O3</td></tr><tr><td>molar mass:</td><td>226.236 g/mol (PubChem)</td></tr></table></body></html>"));
end Nimorazole;
