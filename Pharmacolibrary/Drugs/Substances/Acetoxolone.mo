  annotation (Documentation(info = "<html><body><p>Acetoxolone is a drug classified for treating peptic ulcer and gastro-oesophageal reflux disease, i.e. acid-related stomach disorders. It appears to be experimental rather than an established marketed medicine, and no authorisation by the European Medicines Agency is recorded.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4673282\">Wikidata Q4673282</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>acetoxolone</td></tr><tr><td>ATC codes:</td><td>A02BX09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13640\">DB13640</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/94320\">94320</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:81306\">81306</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4673282\">Q4673282</a></td></tr><tr><td>formula:</td><td>C32H48O5</td></tr><tr><td>molar mass:</td><td>512.731 g/mol (PubChem CID 94320)</td></tr><tr><td>logP:</td><td>7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
