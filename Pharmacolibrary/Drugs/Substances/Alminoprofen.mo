  annotation (Documentation(info = "<html><body><p>Alminoprofen is a propionic acid derivative that acts as a non-steroidal anti-inflammatory drug, a class used for pain and inflammatory conditions. It is not an approved medicine in major markets and appears only as an experimental compound, so its current availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3612806\">Wikidata Q3612806</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>alminoprofen</td></tr><tr><td>ATC codes:</td><td>M01AE16</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13314\">DB13314</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2097\">2097</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31190\">31190</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3612806\">Q3612806</a></td></tr><tr><td>formula:</td><td>C13H17NO2</td></tr><tr><td>molar mass:</td><td>219.284 g/mol (PubChem CID 2097)</td></tr><tr><td>logP:</td><td>3.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
