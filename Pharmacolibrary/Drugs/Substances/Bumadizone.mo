  annotation (Documentation(info = "<html><body><p>Bumadizone is a non-steroidal anti-inflammatory drug used to treat inflammatory and rheumatic conditions of the musculoskeletal system. It has approved status, but it does not appear to be authorised in the European Union and its current availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q851922&quot;>Wikidata Q851922</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bumadizone</td></tr><tr><td>ATC codes:</td><td>M01AB07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13286&quot;>DB13286</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/19161&quot;>19161</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:76119&quot;>76119</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q851922&quot;>Q851922</a></td></tr><tr><td>formula:</td><td>C19H22N2O3</td></tr><tr><td>molar mass:</td><td>326.396 g/mol (PubChem)</td></tr></table></body></html>"));
