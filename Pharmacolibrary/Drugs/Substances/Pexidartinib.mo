    logP = 4.5);
  annotation (Documentation(info = "<html><body><p>Pexidartinib is a protein kinase inhibitor used to treat tenosynovial giant cell tumour of the tendon sheath (pigmented villonodular synovitis). It is approved in the United States but its use is restricted, carrying a boxed warning for liver injury; a marketing application in the European Union was refused.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q25100640\">Wikidata Q25100640</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>pexidartinib</td></tr><tr><td>ATC codes:</td><td>L01EX15, L01XE</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12978\">DB12978</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/25151352\">25151352</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:145373\">145373</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q25100640\">Q25100640</a></td></tr><tr><td>formula:</td><td>C20H15ClF3N5</td></tr><tr><td>molar mass:</td><td>417.819 g/mol (PubChem CID 25151352)</td></tr><tr><td>logP:</td><td>4.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Pexidartinib;
