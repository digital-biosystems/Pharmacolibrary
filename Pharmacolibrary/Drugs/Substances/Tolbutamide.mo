  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "tolbutamide",
    atcCodes = {"A10BB03", "V04CA01"},
    drugbankId = "DB01124",
    pubchemCid = "5505",
    chebiId = "27999",
    wikidataId = "Q414275",
    formula = "C12H18N2O3S",
    M = 0.270347,
    logP = 2.3);
  annotation (Documentation(info = "<html><body><p>Tolbutamide is a sulfonylurea blood-glucose-lowering drug used to treat type 2 diabetes and maturity-onset diabetes of the young type 2, and it also serves as a diagnostic agent in tests for diabetes. It is an approved medication, though it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q414275&quot;>Wikidata Q414275</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tolbutamide</td></tr><tr><td>ATC codes:</td><td>A10BB03, V04CA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01124&quot;>DB01124</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5505&quot;>5505</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:27999&quot;>27999</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q414275&quot;>Q414275</a></td></tr><tr><td>formula:</td><td>C12H18N2O3S</td></tr><tr><td>molar mass:</td><td>270.347 g/mol (PubChem)</td></tr></table></body></html>"));
end Tolbutamide;
