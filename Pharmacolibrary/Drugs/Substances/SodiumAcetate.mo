  annotation (Documentation(info = "<html><body><p>Sodium acetate is a sodium salt used as an electrolyte additive in intravenous solutions to correct or maintain electrolyte balance. It is an approved medicine, given as an additive to infusion and perfusion solutions, typically in hospital settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q339940\">Wikidata Q339940</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sodium acetate</td></tr><tr><td>ATC codes:</td><td>B05XA08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09395\">DB09395</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/517045\">517045</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32954\">32954</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q339940\">Q339940</a></td></tr><tr><td>formula:</td><td>C2H3NaO2</td></tr><tr><td>molar mass:</td><td>82.034 g/mol (PubChem CID 517045)</td></tr></table></body></html>"));
