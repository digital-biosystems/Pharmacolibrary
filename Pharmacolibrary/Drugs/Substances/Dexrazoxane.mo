    M = 0.268273,
    logP = -1.4);
  annotation (Documentation(info = "<html><body><p>Dexrazoxane is a detoxifying agent used to protect against tissue damage from anthracycline chemotherapy, notably in breast cancer patients, and to treat extravasation of certain drugs. It remains authorised in the European Union, though its approved status has been accompanied by investigational uses and some withdrawn indications.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q524995&quot;>Wikidata Q524995</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>dexrazoxane</td></tr><tr><td>ATC codes:</td><td>V03AF02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00380&quot;>DB00380</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/71384&quot;>71384</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:50223&quot;>50223</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q524995&quot;>Q524995</a></td></tr><tr><td>formula:</td><td>C11H16N4O4</td></tr><tr><td>molar mass:</td><td>268.273 g/mol (PubChem)</td></tr></table></body></html>"));
end Dexrazoxane;
