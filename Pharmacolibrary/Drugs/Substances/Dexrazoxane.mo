  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "dexrazoxane",
    atcCodes = {"V03AF02"},
    drugbankId = "DB00380",
    pubchemCid = "71384",
    chebiId = "50223",
    wikidataId = "Q524995",
