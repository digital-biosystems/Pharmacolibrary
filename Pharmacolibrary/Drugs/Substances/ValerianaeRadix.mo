  annotation (Documentation(info = "<html><body><p>Valerian root is a herbal sedative used to relieve restlessness and sleep problems. It is widely available as an over-the-counter herbal remedy in many countries.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Valerianae radix</td></tr><tr><td>ATC codes:</td><td>N05CM09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13196\">DB13196</a></td></tr></table></body></html>"));
