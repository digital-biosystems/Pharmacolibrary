    logP = 2.9);
  annotation (Documentation(info = "<html><body><p>Chloroprocaine is a local anesthetic used to prevent or relieve pain, for example during procedures. It is an approved medicine, available as a local anesthetic for nerve blocks and in eye drops, and is used mainly in the United States rather than the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2964133&quot;>Wikidata Q2964133</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>chloroprocaine</td></tr><tr><td>ATC codes:</td><td>N01BA04, S01HA08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01161&quot;>DB01161</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/8612&quot;>8612</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3636&quot;>3636</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2964133&quot;>Q2964133</a></td></tr><tr><td>formula:</td><td>C13H19ClN2O2</td></tr><tr><td>molar mass:</td><td>270.757 g/mol (PubChem)</td></tr></table></body></html>"));
end Chloroprocaine;
