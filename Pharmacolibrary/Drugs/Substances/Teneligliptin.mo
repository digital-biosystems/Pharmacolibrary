  annotation (Documentation(info = "<html><body><p>Teneligliptin is a DPP-4 inhibitor developed to lower blood glucose in adults with type 2 diabetes. It is not authorised in the European Union and is considered investigational there, though it is used in some Asian countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q15269678\">Wikidata Q15269678</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>teneligliptin</td></tr><tr><td>ATC codes:</td><td>A10BH08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11950\">DB11950</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/11949652\">11949652</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:136042\">136042</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q15269678\">Q15269678</a></td></tr><tr><td>formula:</td><td>C22H30N6OS</td></tr><tr><td>molar mass:</td><td>426.583 g/mol (PubChem CID 11949652)</td></tr><tr><td>logP:</td><td>2.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Teneligliptin;
