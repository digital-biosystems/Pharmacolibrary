  annotation (Documentation(info = "<html><body><p>Loracarbef is a second-generation cephalosporin antibiotic that was used to treat bacterial infections such as sinusitis, otitis media, skin infections, and upper respiratory tract infections. It has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q979521&quot;>Wikidata Q979521</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>loracarbef</td></tr><tr><td>ATC codes:</td><td>J01DC08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00447&quot;>DB00447</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5284585&quot;>5284585</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:214480&quot;>214480</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q979521&quot;>Q979521</a></td></tr><tr><td>formula:</td><td>C16H16ClN3O4</td></tr><tr><td>molar mass:</td><td>349.771 g/mol (PubChem)</td></tr></table></body></html>"));
