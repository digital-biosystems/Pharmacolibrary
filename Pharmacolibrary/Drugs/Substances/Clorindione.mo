  annotation (Documentation(info = "<html><body><p>Clorindione is a vitamin K antagonist, a class of anticoagulant drugs used to prevent or treat blood clots. It is considered experimental and there is no evidence it is currently authorised or in routine use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2358705&quot;>Wikidata Q2358705</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>clorindione</td></tr><tr><td>ATC codes:</td><td>B01AA09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13275&quot;>DB13275</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/70846&quot;>70846</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135057&quot;>135057</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2358705&quot;>Q2358705</a></td></tr><tr><td>formula:</td><td>C15H9ClO2</td></tr><tr><td>molar mass:</td><td>256.685 g/mol (PubChem)</td></tr></table></body></html>"));
