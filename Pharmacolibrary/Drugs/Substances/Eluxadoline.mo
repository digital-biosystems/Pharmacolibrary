    logP = 0.9);
  annotation (Documentation(info = "<html><body><p>Eluxadoline is a gastrointestinal medicine developed to treat diarrhoea in people with irritable bowel syndrome. It has been approved for use, although its marketing authorisation in the European Union was later withdrawn, so it is no longer available there.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q20539232\">Wikidata Q20539232</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>eluxadoline</td></tr><tr><td>ATC codes:</td><td>A07DA06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09272\">DB09272</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/11250029\">11250029</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:85980\">85980</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q20539232\">Q20539232</a></td></tr><tr><td>formula:</td><td>C32H35N5O5</td></tr><tr><td>molar mass:</td><td>569.662 g/mol (PubChem CID 11250029)</td></tr><tr><td>logP:</td><td>0.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Eluxadoline;
