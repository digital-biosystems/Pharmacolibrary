within Pharmacolibrary.Drugs.Substances;
package Chlormethine "chlormethine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "chlormethine",
    atcCodes = {"L01AA05"},
    drugbankId = "DB00888",
    pubchemCid = "4033",
    wikidataId = "Q418011",
    formula = "C5H11Cl2N",
    M = 0.15605,
    logP = 0.9);
  annotation (Documentation(info = "<html><body><p>Chlormethine (mechlorethamine) is a nitrogen mustard alkylating agent used to treat certain lymphomas, including Hodgkin's lymphoma and the skin cancer mycosis fungoides. It remains in use and is authorised in the European Union for treating mycosis fungoides.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q418011\">Wikidata Q418011</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>chlormethine</td></tr><tr><td>ATC codes:</td><td>L01AA05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00888\">DB00888</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4033\">4033</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q418011\">Q418011</a></td></tr><tr><td>formula:</td><td>C5H11Cl2N</td></tr><tr><td>molar mass:</td><td>156.05 g/mol (PubChem CID 4033)</td></tr><tr><td>logP:</td><td>0.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Chlormethine;
