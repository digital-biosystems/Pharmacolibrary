  annotation (Documentation(info = "<html><body><p>Acetohexamide is a sulfonylurea blood-glucose-lowering drug that was used to treat diabetes, including a form of maturity-onset diabetes of the young. It has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4673274&quot;>Wikidata Q4673274</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>acetohexamide</td></tr><tr><td>ATC codes:</td><td>A10BB31</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00414&quot;>DB00414</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/1989&quot;>1989</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:28052&quot;>28052</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4673274&quot;>Q4673274</a></td></tr><tr><td>formula:</td><td>C15H20N2O4S</td></tr><tr><td>molar mass:</td><td>324.395 g/mol (PubChem)</td></tr></table></body></html>"));
