  annotation (Documentation(info = "<html><body><p>Clometocillin is a penicillin antibiotic classified among beta-lactamase sensitive penicillins, used against bacterial infections. It is not an established marketed medicine today; DrugBank lists it only as experimental, and no regulatory approval information is available.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5134930\">Wikidata Q5134930</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>clometocillin</td></tr><tr><td>ATC codes:</td><td>J01CE07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13686\">DB13686</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/71807\">71807</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:131732\">131732</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5134930\">Q5134930</a></td></tr><tr><td>formula:</td><td>C17H18Cl2N2O5S</td></tr><tr><td>molar mass:</td><td>433.3 g/mol (PubChem CID 71807)</td></tr><tr><td>logP:</td><td>2.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
