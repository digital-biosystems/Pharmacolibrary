    M = 0.299414,
    logP = 3.5);
  annotation (Documentation(info = "<html><body><p>Buphenine (nylidrin) is a sympathomimetic vasodilator that was used to improve peripheral blood flow and as a tocolytic to relax the uterus. It has been withdrawn and is no longer in clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q851507&quot;>Wikidata Q851507</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>buphenine</td></tr><tr><td>ATC codes:</td><td>C04AA02, G02CA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06152&quot;>DB06152</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4567&quot;>4567</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q851507&quot;>Q851507</a></td></tr><tr><td>formula:</td><td>C19H25NO2</td></tr><tr><td>molar mass:</td><td>299.414 g/mol (PubChem)</td></tr></table></body></html>"));
end Buphenine;
