within Pharmacolibrary.Drugs.Substances;
package Buphenine "buphenine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "buphenine",
    atcCodes = {"C04AA02", "G02CA02"},
    drugbankId = "DB06152",
    pubchemCid = "4567",
    wikidataId = "Q851507",
