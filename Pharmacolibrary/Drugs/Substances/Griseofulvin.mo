    logP = 2.2);
  annotation (Documentation(info = "<html><body><p>Griseofulvin is an antifungal medication used to treat fungal skin infections such as dermatophytosis, ringworm, and athlete's foot. It is an approved medicine, including for veterinary use, and is listed among essential medicines, available both topically and by mouth for skin fungal infections.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q416096&quot;>Wikidata Q416096</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>griseofulvin</td></tr><tr><td>ATC codes:</td><td>D01AA08, D01BA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00400&quot;>DB00400</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/441140&quot;>441140</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:27779&quot;>27779</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q416096&quot;>Q416096</a></td></tr><tr><td>formula:</td><td>C17H17ClO6</td></tr><tr><td>molar mass:</td><td>352.767 g/mol (PubChem)</td></tr></table></body></html>"));
