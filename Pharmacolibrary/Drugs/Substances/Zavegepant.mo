  annotation (Documentation(info = "<html><body><p>Zavegepant is a CGRP antagonist used as an antimigraine medicine for the acute treatment of migraine attacks. It is an approved active ingredient, though it is not authorised in the European Union and appears to be used mainly in the United States.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q99388898&quot;>Wikidata Q99388898</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>zavegepant</td></tr><tr><td>ATC codes:</td><td>N02CD08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB15688&quot;>DB15688</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/53472683&quot;>53472683</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q99388898&quot;>Q99388898</a></td></tr><tr><td>formula:</td><td>C36H46N8O3</td></tr><tr><td>molar mass:</td><td>638.817 g/mol (PubChem)</td></tr></table></body></html>"));
