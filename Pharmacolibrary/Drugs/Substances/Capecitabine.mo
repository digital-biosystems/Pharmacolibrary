    logP = 0.6);
  annotation (Documentation(info = "<html><body><p>Capecitabine is an antimetabolite cancer medicine used to treat various cancers, including breast, colorectal, gastric, and other gastrointestinal tumours. It is widely used and is included on the WHO essential medicines list, with several products authorised in the European Union for bowel, breast, and stomach cancers.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q420207&quot;>Wikidata Q420207</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>capecitabine</td></tr><tr><td>ATC codes:</td><td>L01BC06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01101&quot;>DB01101</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/60953&quot;>60953</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31348&quot;>31348</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q420207&quot;>Q420207</a></td></tr><tr><td>formula:</td><td>C15H22FN3O6</td></tr><tr><td>molar mass:</td><td>359.354 g/mol (PubChem)</td></tr></table></body></html>"));
end Capecitabine;
