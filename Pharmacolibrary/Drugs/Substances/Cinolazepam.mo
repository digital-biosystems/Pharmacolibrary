  annotation (Documentation(info = "<html><body><p>Cinolazepam is a benzodiazepine sedative developed as a hypnotic for sleep problems. It is not an approved medicine today; databases list it as investigational, and it appears to have been marketed only in a few countries in the past.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q667184&quot;>Wikidata Q667184</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cinolazepam</td></tr><tr><td>ATC codes:</td><td>N05CD13</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01594&quot;>DB01594</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3033621&quot;>3033621</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:59514&quot;>59514</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q667184&quot;>Q667184</a></td></tr><tr><td>formula:</td><td>C18H13ClFN3O2</td></tr><tr><td>molar mass:</td><td>357.769 g/mol (PubChem)</td></tr></table></body></html>"));
