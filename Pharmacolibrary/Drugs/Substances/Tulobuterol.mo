    logP = 2.3);
  annotation (Documentation(info = "<html><body><p>Tulobuterol is a selective beta-2 adrenergic agonist that acts as a bronchodilator, intended for obstructive airway diseases such as asthma. It is considered investigational and is not authorised in the European Union; it has mainly been used in Japan, available as an inhaled or oral medication.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q909353&quot;>Wikidata Q909353</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tulobuterol</td></tr><tr><td>ATC codes:</td><td>R03AC11, R03CC11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12248&quot;>DB12248</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5606&quot;>5606</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:93856&quot;>93856</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q909353&quot;>Q909353</a></td></tr><tr><td>formula:</td><td>C12H18ClNO</td></tr><tr><td>molar mass:</td><td>227.732 g/mol (PubChem)</td></tr></table></body></html>"));
end Tulobuterol;
