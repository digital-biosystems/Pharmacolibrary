  annotation (Documentation(info = "<html><body><p>Dasiglucagon is a glycogenolytic pancreatic hormone peptide used in the treatment of diabetes mellitus, notably for raising blood sugar in severe hypoglycaemia. It is authorised in the European Union and remains investigational for some uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q106158304\">Wikidata Q106158304</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>dasiglucagon</td></tr><tr><td>ATC codes:</td><td>H04AA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB15226\">DB15226</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q106158304\">Q106158304</a></td></tr><tr><td>molar mass:</td><td>3381.6 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>-15.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Dasiglucagon;
