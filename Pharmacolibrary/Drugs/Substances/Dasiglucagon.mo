  annotation (Documentation(info = "<html><body><p>Dasiglucagon is a glycogenolytic pancreatic hormone peptide used in the treatment of diabetes mellitus, notably for raising blood sugar in severe hypoglycaemia. It is authorised in the European Union and remains investigational for some uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q106158304&quot;>Wikidata Q106158304</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>dasiglucagon</td></tr><tr><td>ATC codes:</td><td>H04AA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB15226&quot;>DB15226</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/126961379&quot;>126961379</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q106158304&quot;>Q106158304</a></td></tr><tr><td>formula:</td><td>C152H222N38O50</td></tr><tr><td>molar mass:</td><td>3381.66 g/mol (PubChem)</td></tr></table></body></html>"));
end Dasiglucagon;
