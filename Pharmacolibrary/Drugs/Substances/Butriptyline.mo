  annotation (Documentation(info = "<html><body><p>Butriptyline is a tricyclic antidepressant that was used to treat depression and also has anxiolytic effects. It has been withdrawn and is no longer marketed.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q904524\">Wikidata Q904524</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>butriptyline</td></tr><tr><td>ATC codes:</td><td>N06AA15</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09016\">DB09016</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/21772\">21772</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q904524\">Q904524</a></td></tr><tr><td>formula:</td><td>C21H27N</td></tr><tr><td>molar mass:</td><td>293.454 g/mol (PubChem CID 21772)</td></tr><tr><td>logP:</td><td>5.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
