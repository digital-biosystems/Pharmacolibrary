  annotation (Documentation(info = "<html><body><p>Demegestone is a progestogen, a sex hormone used for conditions involving progesterone deficiency. It is not an approved medicine and is considered experimental, so it is not in routine clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5255131&quot;>Wikidata Q5255131</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>demegestone</td></tr><tr><td>ATC codes:</td><td>G03DB05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13857&quot;>DB13857</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/93057&quot;>93057</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135339&quot;>135339</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5255131&quot;>Q5255131</a></td></tr><tr><td>formula:</td><td>C21H28O2</td></tr><tr><td>molar mass:</td><td>312.453 g/mol (PubChem)</td></tr></table></body></html>"));
