within Pharmacolibrary.Drugs.Substances;
package Capsaicin "capsaicin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "capsaicin",
    atcCodes = {"M02AB01", "N01BX04"},
    drugbankId = "DB06774",
    pubchemCid = "1548943",
    chebiId = "3374",
    wikidataId = "Q273169",
    formula = "C18H27NO3",
    M = 0.305418,
    logP = 3.6);
  annotation (Documentation(info = "<html><body><p>Capsaicin is used topically to relieve pain, including pain associated with neuralgia such as peripheral and diabetic neuropathy and post-herpetic pain. It is approved and widely used as a topical treatment for joint and muscular pain, and an authorised product for neuralgia exists in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q273169&quot;>Wikidata Q273169</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>capsaicin</td></tr><tr><td>ATC codes:</td><td>M02AB01, N01BX04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06774&quot;>DB06774</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/1548943&quot;>1548943</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3374&quot;>3374</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q273169&quot;>Q273169</a></td></tr><tr><td>formula:</td><td>C18H27NO3</td></tr><tr><td>molar mass:</td><td>305.418 g/mol (PubChem)</td></tr></table></body></html>"));
end Capsaicin;
