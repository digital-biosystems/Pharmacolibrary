    logP = -0.5);
  annotation (Documentation(info = "<html><body><p>Amifampridine is a potassium channel blocker used to treat Lambert-Eaton myasthenic syndrome and myasthenia gravis. It is approved and authorised in the European Union, where two products are on the market.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q411707\">Wikidata Q411707</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>amifampridine</td></tr><tr><td>ATC codes:</td><td>N07XX05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11640\">DB11640</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5918\">5918</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135948\">135948</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q411707\">Q411707</a></td></tr><tr><td>formula:</td><td>C5H7N3</td></tr><tr><td>molar mass:</td><td>109.132 g/mol (PubChem CID 5918)</td></tr><tr><td>logP:</td><td>-0.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Amifampridine;
