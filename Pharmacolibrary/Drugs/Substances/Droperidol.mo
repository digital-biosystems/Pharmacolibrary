  annotation (Documentation(info = "<html><body><p>Droperidol is a butyrophenone antipsychotic and antiemetic used for conditions such as pain and schizophreniform disorder, and as an adjuvant in anesthesia. It remains an approved medicine, including veterinary use, but carries a boxed warning, so its use is cautious.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q174259&quot;>Wikidata Q174259</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>droperidol</td></tr><tr><td>ATC codes:</td><td>N05AD08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00450&quot;>DB00450</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3168&quot;>3168</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4717&quot;>4717</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q174259&quot;>Q174259</a></td></tr><tr><td>formula:</td><td>C22H22FN3O2</td></tr><tr><td>molar mass:</td><td>379.435 g/mol (PubChem)</td></tr></table></body></html>"));
