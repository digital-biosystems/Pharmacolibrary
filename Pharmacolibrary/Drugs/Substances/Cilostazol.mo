  annotation (Documentation(info = "<html><body><p>Cilostazol is a platelet aggregation inhibitor used to treat intermittent claudication and cerebral infarction. It is an approved medicine, though it carries a boxed warning and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q258591&quot;>Wikidata Q258591</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cilostazol</td></tr><tr><td>ATC codes:</td><td>B01AC23</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01166&quot;>DB01166</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2754&quot;>2754</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31401&quot;>31401</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q258591&quot;>Q258591</a></td></tr><tr><td>formula:</td><td>C20H27N5O2</td></tr><tr><td>molar mass:</td><td>369.469 g/mol (PubChem)</td></tr></table></body></html>"));
