  annotation (Documentation(info = "<html><body><p>Methaqualone is a sedative-hypnotic drug that was used as a sleep aid. It has been withdrawn from the market and is now only encountered as an illicit drug.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q423912\">Wikidata Q423912</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>methaqualone</td></tr><tr><td>ATC codes:</td><td>N05CM01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB04833\">DB04833</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6292\">6292</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6821\">6821</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q423912\">Q423912</a></td></tr><tr><td>formula:</td><td>C16H14N2O</td></tr><tr><td>molar mass:</td><td>250.301 g/mol (PubChem CID 6292)</td></tr><tr><td>logP:</td><td>2.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Methaqualone;
