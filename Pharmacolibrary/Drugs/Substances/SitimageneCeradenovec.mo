  annotation (Documentation(info = "<html><body><p>Sitimagene ceradenovec is an experimental gene-therapy anticancer agent investigated for treating brain tumours (glioma). It remains experimental and is not an approved medicine; no marketing authorisation is recorded in the European Union.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sitimagene ceradenovec</td></tr><tr><td>ATC codes:</td><td>L01XL01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB04907\">DB04907</a></td></tr></table></body></html>"));
