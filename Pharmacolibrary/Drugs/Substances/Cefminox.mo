  annotation (Documentation(info = "<html><body><p>Cefminox is a second-generation cephalosporin antibiotic used to treat bacterial infections. It is not an approved medicine and remains an experimental drug, with no authorisation in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5057239\">Wikidata Q5057239</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cefminox</td></tr><tr><td>ATC codes:</td><td>J01DC12</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09062\">DB09062</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/71141\">71141</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135817\">135817</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5057239\">Q5057239</a></td></tr><tr><td>formula:</td><td>C16H21N7O7S3</td></tr><tr><td>molar mass:</td><td>519.566 g/mol (PubChem CID 71141)</td></tr><tr><td>logP:</td><td>-4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
