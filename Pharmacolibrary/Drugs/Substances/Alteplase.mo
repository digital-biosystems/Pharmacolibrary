    M = 59);
  annotation (Documentation(info = "<html><body><p>Alteplase is a clot-dissolving enzyme used to treat blood clots in conditions such as pulmonary embolism, stroke, and heart attack. It is an approved medicine and is listed as a WHO essential medicine, so it is widely used worldwide.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q45769835&quot;>Wikidata Q45769835</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>alteplase</td></tr><tr><td>ATC codes:</td><td>B01AD02, S01XA13</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00009&quot;>DB00009</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q45769835&quot;>Q45769835</a></td></tr><tr><td>molar mass:</td><td>59000 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Alteplase;
