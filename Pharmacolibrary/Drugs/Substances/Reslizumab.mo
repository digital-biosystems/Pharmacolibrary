  annotation (Documentation(info = "<html><body><p>Reslizumab is a monoclonal antibody used as an antiasthmatic medicine for asthma. It is authorised in the European Union for asthma and remains in use, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7315650&quot;>Wikidata Q7315650</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>reslizumab</td></tr><tr><td>ATC codes:</td><td>R03DX08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06602&quot;>DB06602</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7315650&quot;>Q7315650</a></td></tr><tr><td>molar mass:</td><td>147000 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Reslizumab;
