  annotation (Documentation(info = "<html><body><p>Telmisartan is an angiotensin II receptor blocker used to treat high blood pressure and congestive heart failure. It is widely used and authorised in the European Union, available alone and in combination products.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q733186\">Wikidata Q733186</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>telmisartan</td></tr><tr><td>ATC codes:</td><td>C09CA07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00966\">DB00966</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/65999\">65999</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9434\">9434</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q733186\">Q733186</a></td></tr><tr><td>formula:</td><td>C33H30N4O2</td></tr><tr><td>molar mass:</td><td>514.629 g/mol (PubChem CID 65999)</td></tr><tr><td>logP:</td><td>6.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
