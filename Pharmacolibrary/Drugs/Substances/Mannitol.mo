within Pharmacolibrary.Drugs.Substances;
package Mannitol "mannitol"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "mannitol",
    atcCodes = {"A06AD16", "B05BC01", "B05CX04", "R05CB16", "V04CX04"},
    drugbankId = "DB00742",
    pubchemCid = "6251",
    chebiId = "16899",
    wikidataId = "Q407646",
    formula = "C6H14O6",
    M = 0.182172,
    logP = -3.1);
  annotation (Documentation(info = "<html><body><p>Mannitol is an osmotic diuretic used for conditions such as anuria, oliguria, cerebral edema, and ocular hypertension, and is also used as a laxative, irrigating solution, mucolytic in cystic fibrosis, and diagnostic agent. It remains widely used and is included on the WHO essential medicines list, with an authorised product in the European Union for cystic fibrosis.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q407646\">Wikidata Q407646</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>mannitol</td></tr><tr><td>ATC codes:</td><td>A06AD16, B05BC01, B05CX04, R05CB16, V04CX04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00742\">DB00742</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6251\">6251</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:16899\">16899</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q407646\">Q407646</a></td></tr><tr><td>formula:</td><td>C6H14O6</td></tr><tr><td>molar mass:</td><td>182.172 g/mol (PubChem CID 6251)</td></tr><tr><td>logP:</td><td>-3.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Mannitol;
