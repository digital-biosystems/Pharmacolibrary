    logP = 0.1);
  annotation (Documentation(info = "<html><body><p>Sulfamerazine is a long-acting sulfonamide antibiotic used to treat bacterial infections, including topical skin use and combination therapy with trimethoprim. It has been withdrawn from human use, though it remains approved for veterinary purposes.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q415196&quot;>Wikidata Q415196</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sulfamerazine</td></tr><tr><td>ATC codes:</td><td>D06BA06, J01ED07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01581&quot;>DB01581</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5325&quot;>5325</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:102130&quot;>102130</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q415196&quot;>Q415196</a></td></tr><tr><td>formula:</td><td>C11H12N4O2S</td></tr><tr><td>molar mass:</td><td>264.303 g/mol (PubChem)</td></tr></table></body></html>"));
