    logP = 3.2);
  annotation (Documentation(info = "<html><body><p>Alfaxalone is a steroid-based general anesthetic used to induce and maintain anesthesia. It is approved for veterinary use, where it is widely used as an anesthetic in animals, while in humans it is considered experimental.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3611058&quot;>Wikidata Q3611058</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>alfaxalone</td></tr><tr><td>ATC codes:</td><td>N01AX05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11371&quot;>DB11371</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/104845&quot;>104845</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:34531&quot;>34531</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3611058&quot;>Q3611058</a></td></tr><tr><td>formula:</td><td>C21H32O3</td></tr><tr><td>molar mass:</td><td>332.484 g/mol (PubChem)</td></tr></table></body></html>"));
end Alfaxalone;
