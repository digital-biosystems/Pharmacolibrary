  annotation (Documentation(info = "<html><body><p>Candicidin is an antifungal antibiotic that was used, mainly as a vaginal preparation, to treat fungal infections. It has been withdrawn and is no longer in clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q61653285\">Wikidata Q61653285</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>candicidin</td></tr><tr><td>ATC codes:</td><td>G01AA04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01152\">DB01152</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/10079874\">10079874</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3349\">3349</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q61653285\">Q61653285</a></td></tr><tr><td>formula:</td><td>C59H84N2O18</td></tr><tr><td>molar mass:</td><td>1109.32 g/mol (PubChem CID 10079874)</td></tr><tr><td>logP:</td><td>1.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
