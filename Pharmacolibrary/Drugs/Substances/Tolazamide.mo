    logP = 1.5);
  annotation (Documentation(info = "<html><body><p>Tolazamide is a sulfonylurea blood-glucose-lowering drug used to treat diabetes, including maturity-onset diabetes of the young type 2. It is an approved anti-diabetic medication, though it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7814101\">Wikidata Q7814101</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tolazamide</td></tr><tr><td>ATC codes:</td><td>A10BB05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00839\">DB00839</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5503\">5503</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9613\">9613</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7814101\">Q7814101</a></td></tr><tr><td>formula:</td><td>C14H21N3O3S</td></tr><tr><td>molar mass:</td><td>311.4 g/mol (PubChem CID 5503)</td></tr><tr><td>logP:</td><td>1.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
