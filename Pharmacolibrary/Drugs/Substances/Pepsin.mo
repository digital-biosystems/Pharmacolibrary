within Pharmacolibrary.Drugs.Substances;
package Pepsin "pepsin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "pepsin",
    atcCodes = {"A09AA03"},
    drugbankId = "DB13198",
    wikidataId = "Q95992717");
  annotation (Documentation(info = "<html><body><p>Pepsin, a digestive enzyme preparation obtained from hog or cattle stomach lining, was used as a digestive aid to help break down food proteins. It is no longer used as a medicine, having been withdrawn from the market.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q95992717&quot;>Wikidata Q95992717</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pepsin</td></tr><tr><td>ATC codes:</td><td>A09AA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13198&quot;>DB13198</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q95992717&quot;>Q95992717</a></td></tr></table></body></html>"));
end Pepsin;
