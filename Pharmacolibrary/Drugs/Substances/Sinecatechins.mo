    wikidataId = "Q20817162");
  annotation (Documentation(info = "<html><body><p>Sinecatechins, a green tea extract, is a topical treatment for external genital and perianal warts. It is approved and used as a prescription skin ointment, mainly in North America; it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q20817162&quot;>Wikidata Q20817162</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sinecatechins</td></tr><tr><td>ATC codes:</td><td>D06BB12</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01266&quot;>DB01266</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q20817162&quot;>Q20817162</a></td></tr></table></body></html>"));
end Sinecatechins;
