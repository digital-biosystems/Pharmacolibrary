    logP = 0);
  annotation (Documentation(info = "<html><body><p>Bufylline (ambuphylline) is a xanthine combination drug that acts as a bronchodilator and vasodilator, and has been used for obstructive airway diseases. It is currently listed only as an experimental compound, so it does not appear to be in widespread clinical use today.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4741993&quot;>Wikidata Q4741993</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bufylline</td></tr><tr><td>ATC codes:</td><td>R03DA10</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13812&quot;>DB13812</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/21850&quot;>21850</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4741993&quot;>Q4741993</a></td></tr><tr><td>formula:</td><td>C11H19N5O3</td></tr><tr><td>molar mass:</td><td>269.305 g/mol (PubChem)</td></tr></table></body></html>"));
end Bufylline;
