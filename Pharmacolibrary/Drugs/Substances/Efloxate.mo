    logP = 4.2);
  annotation (Documentation(info = "<html><body><p>Efloxate is a flavone-type vasodilator that was classified for use in cardiac diseases, acting as a vasodilator in heart conditions. It appears only as an experimental drug and is not an approved medicine today, so it is no longer in clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q962269&quot;>Wikidata Q962269</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>efloxate</td></tr><tr><td>ATC codes:</td><td>C01DX13</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13333&quot;>DB13333</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/8395&quot;>8395</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31531&quot;>31531</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q962269&quot;>Q962269</a></td></tr><tr><td>formula:</td><td>C19H16O5</td></tr><tr><td>molar mass:</td><td>324.332 g/mol (PubChem)</td></tr></table></body></html>"));
end Efloxate;
