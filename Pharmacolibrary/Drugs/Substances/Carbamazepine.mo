  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "carbamazepine",
    atcCodes = {"N03AF01"},
    drugbankId = "DB00564",
    pubchemCid = "2554",
    chebiId = "3387",
    wikidataId = "Q410412",
