  annotation (Documentation(info = "<html><body><p>Dimetotiazine is an antihistamine (H1 antagonist) used as an antimigraine medicine to treat migraine. It is an approved drug but is not widely used; it is available only in a few countries and is not authorised by the European Medicines Agency.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27097974&quot;>Wikidata Q27097974</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dimetotiazine</td></tr><tr><td>ATC codes:</td><td>N02CX05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08967&quot;>DB08967</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3089&quot;>3089</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135616&quot;>135616</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27097974&quot;>Q27097974</a></td></tr><tr><td>formula:</td><td>C19H25N3O2S2</td></tr><tr><td>molar mass:</td><td>391.548 g/mol (PubChem)</td></tr></table></body></html>"));
