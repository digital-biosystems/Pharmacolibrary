  annotation (Documentation(info = "<html><body><p>Pyrrolnitrin is an antifungal antibiotic used for topical treatment of fungal skin infections. It is currently considered experimental and does not appear to be an approved medicine in major markets.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q371817\">Wikidata Q371817</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pyrrolnitrin</td></tr><tr><td>ATC codes:</td><td>D01AA07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13603\">DB13603</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/13916\">13916</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32079\">32079</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q371817\">Q371817</a></td></tr><tr><td>formula:</td><td>C10H6Cl2N2O2</td></tr><tr><td>molar mass:</td><td>257.07 g/mol (PubChem CID 13916)</td></tr><tr><td>logP:</td><td>4.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
