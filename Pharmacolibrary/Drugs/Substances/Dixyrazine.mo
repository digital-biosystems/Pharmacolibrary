  annotation (Documentation(info = "<html><body><p>Dixyrazine is a phenothiazine antipsychotic that has also been used as an antiemetic and non-opioid pain reliever. It is currently considered experimental and does not appear to be an approved medicine in major markets.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2759774\">Wikidata Q2759774</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dixyrazine</td></tr><tr><td>ATC codes:</td><td>N05AB01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13784\">DB13784</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/17182\">17182</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135695\">135695</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2759774\">Q2759774</a></td></tr><tr><td>formula:</td><td>C24H33N3O2S</td></tr><tr><td>molar mass:</td><td>427.607 g/mol (PubChem CID 17182)</td></tr><tr><td>logP:</td><td>3.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
