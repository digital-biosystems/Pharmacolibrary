  annotation (Documentation(info = "<html><body><p>Glycerol is used to treat constipation, and has also been used for dermatitis. It is an approved drug, given as enemas or other formulations for constipation, and is widely available.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q132501\">Wikidata Q132501</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>glycerol</td></tr><tr><td>ATC codes:</td><td>A06AG04, A06AX01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09462\">DB09462</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/753\">753</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:17754\">17754</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q132501\">Q132501</a></td></tr><tr><td>formula:</td><td>C3H8O3</td></tr><tr><td>molar mass:</td><td>92.094 g/mol (PubChem CID 753)</td></tr><tr><td>logP:</td><td>-1.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
