  annotation (Documentation(info = "<html><body><p>Hidrosmin is a bioflavonoid classified as a vasoprotective and capillary-stabilizing agent, a class of drugs used to treat conditions affecting the veins and small blood vessels. It is considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5752914\">Wikidata Q5752914</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>hidrosmin</td></tr><tr><td>ATC codes:</td><td>C05CA05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13490\">DB13490</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3087722\">3087722</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135840\">135840</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5752914\">Q5752914</a></td></tr><tr><td>formula:</td><td>C30H36O16</td></tr><tr><td>molar mass:</td><td>652.602 g/mol (PubChem CID 3087722)</td></tr><tr><td>logP:</td><td>-1.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
