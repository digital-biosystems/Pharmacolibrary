    logP = 1);
  annotation (Documentation(info = "<html><body><p>Ethotoin is a hydantoin anticonvulsant used to treat epilepsy, including visual epilepsy. It is an approved antiepileptic, though it is not widely used and is largely a niche option compared with other hydantoin drugs.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4533122\">Wikidata Q4533122</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ethotoin</td></tr><tr><td>ATC codes:</td><td>N03AB01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00754\">DB00754</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3292\">3292</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4888\">4888</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4533122\">Q4533122</a></td></tr><tr><td>formula:</td><td>C11H12N2O2</td></tr><tr><td>molar mass:</td><td>204.229 g/mol (PubChem CID 3292)</td></tr><tr><td>logP:</td><td>1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Ethotoin;
