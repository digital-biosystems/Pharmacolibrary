  annotation (Documentation(info = "<html><body><p>Rilmenidine is a centrally acting antihypertensive drug used to treat high blood pressure. It is not approved in the United States and is used only in a limited number of countries, mainly in Europe.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q967973\">Wikidata Q967973</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>rilmenidine</td></tr><tr><td>ATC codes:</td><td>C02AC06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11738\">DB11738</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/68712\">68712</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8862\">8862</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q967973\">Q967973</a></td></tr><tr><td>formula:</td><td>C10H16N2O</td></tr><tr><td>molar mass:</td><td>180.251 g/mol (PubChem CID 68712)</td></tr><tr><td>logP:</td><td>1.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
