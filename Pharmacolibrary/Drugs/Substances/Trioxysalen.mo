  annotation (Documentation(info = "<html><body><p>Trioxysalen is a psoralen photosensitizer that was used to treat pigmentation disorders such as vitiligo, albinism, and acropustulosis. It has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q854263\">Wikidata Q854263</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>trioxysalen</td></tr><tr><td>ATC codes:</td><td>D05AD01, D05BA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB04571\">DB04571</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5585\">5585</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:28329\">28329</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q854263\">Q854263</a></td></tr><tr><td>formula:</td><td>C14H12O3</td></tr><tr><td>molar mass:</td><td>228.247 g/mol (PubChem CID 5585)</td></tr><tr><td>logP:</td><td>3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
