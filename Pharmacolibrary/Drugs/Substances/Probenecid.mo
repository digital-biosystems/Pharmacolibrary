  annotation (Documentation(info = "<html><body><p>Probenecid is a uricosuric drug used to treat gout, and has also been used in gonorrhea and neurosyphilis. It remains an approved medicine, used mainly for gout, and is also being investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q900898&quot;>Wikidata Q900898</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>probenecid</td></tr><tr><td>ATC codes:</td><td>M04AB01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01032&quot;>DB01032</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4911&quot;>4911</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8426&quot;>8426</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q900898&quot;>Q900898</a></td></tr><tr><td>formula:</td><td>C13H19NO4S</td></tr><tr><td>molar mass:</td><td>285.358 g/mol (PubChem)</td></tr></table></body></html>"));
