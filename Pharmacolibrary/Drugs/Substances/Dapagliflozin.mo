  annotation (Documentation(info = "<html><body><p>Dapagliflozin is a blood-glucose-lowering medicine (an SGLT2 inhibitor) used to treat type 2 diabetes, and also heart failure and chronic kidney disease. It is widely used and authorised in the European Union, available both alone and in combination products.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q409898\">Wikidata Q409898</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>dapagliflozin</td></tr><tr><td>ATC codes:</td><td>A10BK01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06292\">DB06292</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9887712\">9887712</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:85078\">85078</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q409898\">Q409898</a></td></tr><tr><td>formula:</td><td>C21H25ClO6</td></tr><tr><td>molar mass:</td><td>408.875 g/mol (PubChem CID 9887712)</td></tr><tr><td>logP:</td><td>2.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
