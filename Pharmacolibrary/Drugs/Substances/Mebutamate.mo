  annotation (Documentation(info = "<html><body><p>Mebutamate is a carbamate anxiolytic drug used to treat anxiety. It is an approved medicine, but appears to be little used today and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6804368\">Wikidata Q6804368</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mebutamate</td></tr><tr><td>ATC codes:</td><td>N05BC04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06797\">DB06797</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6151\">6151</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31804\">31804</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6804368\">Q6804368</a></td></tr><tr><td>formula:</td><td>C10H20N2O4</td></tr><tr><td>molar mass:</td><td>232.28 g/mol (PubChem CID 6151)</td></tr><tr><td>logP:</td><td>1.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
