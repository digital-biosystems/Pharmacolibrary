  annotation (Documentation(info = "<html><body><p>Pholcodine is an opium-derivative cough suppressant that also has pain-relieving properties. It is an approved medicine, used as a cough suppressant in respiratory preparations.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3124290\">Wikidata Q3124290</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pholcodine</td></tr><tr><td>ATC codes:</td><td>R05DA08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09209\">DB09209</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5311356\">5311356</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:53579\">53579</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3124290\">Q3124290</a></td></tr><tr><td>formula:</td><td>C23H30N2O4</td></tr><tr><td>molar mass:</td><td>398.503 g/mol (PubChem CID 5311356)</td></tr><tr><td>logP:</td><td>0.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
