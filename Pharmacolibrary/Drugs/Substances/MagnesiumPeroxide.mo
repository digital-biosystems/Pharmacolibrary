within Pharmacolibrary.Drugs.Substances;
package MagnesiumPeroxide "magnesium peroxide"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "magnesium peroxide",
    atcCodes = {"A02AA03", "A06AD03"},
    drugbankId = "DB13486",
    chebiId = "81304",
