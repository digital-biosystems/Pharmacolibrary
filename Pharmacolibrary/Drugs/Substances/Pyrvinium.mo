  annotation (Documentation(info = "<html><body><p>Pyrvinium is an anthelmintic that was used to treat intestinal worm infections, especially pinworm infestations. It is no longer in general use and has been withdrawn from the market.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q264039&quot;>Wikidata Q264039</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pyrvinium</td></tr><tr><td>ATC codes:</td><td>P02CX01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06816&quot;>DB06816</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5281035&quot;>5281035</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8687&quot;>8687</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q264039&quot;>Q264039</a></td></tr><tr><td>formula:</td><td>C26H28N3+</td></tr><tr><td>molar mass:</td><td>382.531 g/mol (PubChem)</td></tr></table></body></html>"));
