  annotation (Documentation(info = "<html><body><p>Bamethan is a vasodilator that was used for peripheral vascular disease. It is classified as experimental and is not authorised in the European Union, so it appears to be little used or no longer in clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4853482\">Wikidata Q4853482</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bamethan</td></tr><tr><td>ATC codes:</td><td>C04AA31</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13206\">DB13206</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2292\">2292</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4853482\">Q4853482</a></td></tr><tr><td>formula:</td><td>C12H19NO2</td></tr><tr><td>molar mass:</td><td>209.289 g/mol (PubChem CID 2292)</td></tr><tr><td>logP:</td><td>0.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
