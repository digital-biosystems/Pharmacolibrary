  annotation (Documentation(info = "<html><body><p>Metamfetamine is a central nervous system stimulant used for attention deficit hyperactivity disorder, narcolepsy, and obesity. It is an approved psychostimulant but is also used illicitly, so its medical use is limited and tightly controlled.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q191924\">Wikidata Q191924</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>metamfetamine</td></tr><tr><td>ATC codes:</td><td>N06BA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01577\">DB01577</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/10836\">10836</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6809\">6809</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q191924\">Q191924</a></td></tr><tr><td>formula:</td><td>C10H15N</td></tr><tr><td>molar mass:</td><td>149.237 g/mol (PubChem CID 10836)</td></tr><tr><td>logP:</td><td>2.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
