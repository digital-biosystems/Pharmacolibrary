  annotation (Documentation(info = "<html><body><p>Tenoxicam is a non-steroidal anti-inflammatory drug of the oxicam class, used to treat pain and inflammation in musculoskeletal and rheumatic conditions. It is an approved medicine and remains in use, though it is not authorised centrally in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q45050\">Wikidata Q45050</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tenoxicam</td></tr><tr><td>ATC codes:</td><td>M01AC02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00469\">DB00469</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/54677971\">54677971</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32192\">32192</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q45050\">Q45050</a></td></tr><tr><td>formula:</td><td>C13H11N3O4S2</td></tr><tr><td>molar mass:</td><td>337.368 g/mol (PubChem CID 54677971)</td></tr><tr><td>logP:</td><td>1.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
