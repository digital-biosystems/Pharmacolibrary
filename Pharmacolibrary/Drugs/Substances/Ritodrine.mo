  annotation (Documentation(info = "<html><body><p>Ritodrine is a beta-2 adrenergic agonist that was used as a tocolytic to suppress premature labour. It has been withdrawn from the market in some countries, though it may remain available elsewhere.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5577596&quot;>Wikidata Q5577596</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ritodrine</td></tr><tr><td>ATC codes:</td><td>G02CA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00867&quot;>DB00867</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/33572&quot;>33572</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:156577&quot;>156577</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5577596&quot;>Q5577596</a></td></tr><tr><td>formula:</td><td>C17H21NO3</td></tr><tr><td>molar mass:</td><td>287.359 g/mol (PubChem)</td></tr></table></body></html>"));
