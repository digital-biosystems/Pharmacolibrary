  annotation (Documentation(info = "<html><body><p>Lamivudine is an antiviral nucleoside analogue used to treat HIV infection and chronic hepatitis B. It is widely used, appears on the WHO essential medicines list, and is authorised in the European Union for HIV and hepatitis B, often in combination products.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q422631\">Wikidata Q422631</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>lamivudine</td></tr><tr><td>ATC codes:</td><td>J05AF05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00709\">DB00709</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/60825\">60825</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:63577\">63577</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q422631\">Q422631</a></td></tr><tr><td>formula:</td><td>C8H11N3O3S</td></tr><tr><td>molar mass:</td><td>229.254 g/mol (PubChem CID 60825)</td></tr><tr><td>logP:</td><td>-0.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
