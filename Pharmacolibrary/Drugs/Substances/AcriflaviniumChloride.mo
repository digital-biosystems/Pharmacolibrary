  annotation (Documentation(info = "<html><body><p>Acriflavinium chloride (acriflavine) is a topical antiseptic used against local infections, historically for throat preparations. It is currently considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q225854&quot;>Wikidata Q225854</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>acriflavinium chloride</td></tr><tr><td>ATC codes:</td><td>R02AA13</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13373&quot;>DB13373</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/443101&quot;>443101</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q225854&quot;>Q225854</a></td></tr><tr><td>formula:</td><td>C27H25ClN6</td></tr><tr><td>molar mass:</td><td>468.989 g/mol (PubChem)</td></tr></table></body></html>"));
end AcriflaviniumChloride;
