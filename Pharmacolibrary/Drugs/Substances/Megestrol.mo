    logP = 2.6);
  annotation (Documentation(info = "<html><body><p>Megestrol is a synthetic progestogen used as a hormonal contraceptive and to treat hormone-related conditions such as breast cancer, endometrial carcinoma, anorexia and cachexia. It remains an approved medicine and is used in various countries, mainly in oral hormonal therapy and cancer-related endocrine treatment.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q410513\">Wikidata Q410513</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>megestrol</td></tr><tr><td>ATC codes:</td><td>G03AC05, G03DB02, L02AB01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB19378\">DB19378</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/19090\">19090</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6722\">6722</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q410513\">Q410513</a></td></tr><tr><td>formula:</td><td>C22H30O3</td></tr><tr><td>molar mass:</td><td>342.479 g/mol (PubChem CID 19090)</td></tr><tr><td>logP:</td><td>2.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Megestrol;
