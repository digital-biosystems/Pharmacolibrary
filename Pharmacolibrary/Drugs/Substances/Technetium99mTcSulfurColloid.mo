  annotation (Documentation(info = "<html><body><p>Technetium (99mTc) sulfur colloid is a diagnostic radiopharmaceutical used for imaging of the liver and the reticuloendothelial system. It is an approved imaging agent, used in nuclear medicine for liver and reticuloendothelial system scans.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>technetium (99mTc) sulfur colloid</td></tr><tr><td>ATC codes:</td><td>V09DB05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09397\">DB09397</a></td></tr><tr><td>molar mass:</td><td>355.4 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Technetium99mTcSulfurColloid;
