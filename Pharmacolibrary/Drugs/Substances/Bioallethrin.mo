  annotation (Documentation(info = "<html><body><p>Bioallethrin is a synthetic pyrethroid insecticide used to kill ectoparasites such as lice. It has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2102184\">Wikidata Q2102184</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bioallethrin</td></tr><tr><td>ATC codes:</td><td>P03AC02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13746\">DB13746</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/15558638\">15558638</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:34572\">34572</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2102184\">Q2102184</a></td></tr><tr><td>formula:</td><td>C19H26O3</td></tr><tr><td>molar mass:</td><td>302.414 g/mol (PubChem CID 15558638)</td></tr><tr><td>logP:</td><td>4.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
