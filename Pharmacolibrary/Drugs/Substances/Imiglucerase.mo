within Pharmacolibrary.Drugs.Substances;
package Imiglucerase "imiglucerase"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "imiglucerase",
    atcCodes = {"A16AB02"},
    drugbankId = "DB00053",
    wikidataId = "Q2620206",
    M = 55.5974);
  annotation (Documentation(info = "<html><body><p>Imiglucerase is an enzyme replacement medicine used to treat Gaucher's disease, a lipid storage disorder that can affect organs such as the liver and spleen. It is authorised in the European Union and is used mainly in specialist care for this rare condition.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2620206\">Wikidata Q2620206</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>imiglucerase</td></tr><tr><td>ATC codes:</td><td>A16AB02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00053\">DB00053</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2620206\">Q2620206</a></td></tr><tr><td>molar mass:</td><td>55597.4 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Imiglucerase;
