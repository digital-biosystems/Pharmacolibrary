  annotation (Documentation(info = "<html><body><p>Sparteine is an alkaloid that was used as a class Ia antiarrhythmic to treat heart rhythm disorders, and also as an oxytocic agent. It has been withdrawn and is no longer in clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q419552&quot;>Wikidata Q419552</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sparteine</td></tr><tr><td>ATC codes:</td><td>C01BA04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06727&quot;>DB06727</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/168213&quot;>168213</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:28827&quot;>28827</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q419552&quot;>Q419552</a></td></tr><tr><td>formula:</td><td>C15H26N2</td></tr><tr><td>molar mass:</td><td>234.387 g/mol (PubChem)</td></tr></table></body></html>"));
