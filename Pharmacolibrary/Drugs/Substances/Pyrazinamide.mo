  annotation (Documentation(info = "<html><body><p>Pyrazinamide is an antituberculous drug used to treat tuberculosis, often in combination with other tuberculosis medicines. It is widely used and appears on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q417571\">Wikidata Q417571</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pyrazinamide</td></tr><tr><td>ATC codes:</td><td>J04AK01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00339\">DB00339</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/1046\">1046</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:45285\">45285</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q417571\">Q417571</a></td></tr><tr><td>formula:</td><td>C5H5N3O</td></tr><tr><td>molar mass:</td><td>123.115 g/mol (PubChem CID 1046)</td></tr><tr><td>logP:</td><td>-0.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
