  annotation (Documentation(info = "<html><body><p>Relatlimab is a monoclonal antibody used as an anticancer agent in combination with another monoclonal antibody. It is an approved drug, though it does not appear to be authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q58315670\">Wikidata Q58315670</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Relatlimab</td></tr><tr><td>ATC codes:</td><td>L01FY02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB14851\">DB14851</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q58315670\">Q58315670</a></td></tr></table></body></html>"));
end Relatlimab;
