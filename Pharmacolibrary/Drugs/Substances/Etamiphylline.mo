  annotation (Documentation(info = "<html><body><p>Etamiphylline is a xanthine bronchodilator used for obstructive airway diseases. It is listed as experimental and appears to be little used today; no marketing authorisation in the European Union is recorded.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5402412&quot;>Wikidata Q5402412</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>etamiphylline</td></tr><tr><td>ATC codes:</td><td>R03DA06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13592&quot;>DB13592</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/28329&quot;>28329</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135157&quot;>135157</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5402412&quot;>Q5402412</a></td></tr><tr><td>formula:</td><td>C13H21N5O2</td></tr><tr><td>molar mass:</td><td>279.344 g/mol (PubChem)</td></tr></table></body></html>"));
