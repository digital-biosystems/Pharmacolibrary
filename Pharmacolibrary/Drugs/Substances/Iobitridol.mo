  annotation (Documentation(info = "<html><body><p>Iobitridol is an iodinated, low-osmolar X-ray contrast agent used to improve visibility of body structures during imaging examinations. It was approved but has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6062197&quot;>Wikidata Q6062197</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>iobitridol</td></tr><tr><td>ATC codes:</td><td>V08AB11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12407&quot;>DB12407</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/65985&quot;>65985</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31701&quot;>31701</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6062197&quot;>Q6062197</a></td></tr><tr><td>formula:</td><td>C20H28I3N3O9</td></tr><tr><td>molar mass:</td><td>835.156 g/mol (PubChem)</td></tr></table></body></html>"));
