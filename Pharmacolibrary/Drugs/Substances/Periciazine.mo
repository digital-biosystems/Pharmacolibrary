  annotation (Documentation(info = "<html><body><p>Periciazine is a phenothiazine antipsychotic used to treat psychotic disorders such as schizophrenia. It is an approved medicine, though not authorised by the European Medicines Agency, and is used only to a limited extent in some countries.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2622907&quot;>Wikidata Q2622907</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>periciazine</td></tr><tr><td>ATC codes:</td><td>N05AC01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01608&quot;>DB01608</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4747&quot;>4747</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31981&quot;>31981</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2622907&quot;>Q2622907</a></td></tr><tr><td>formula:</td><td>C21H23N3OS</td></tr><tr><td>molar mass:</td><td>365.495 g/mol (PubChem)</td></tr></table></body></html>"));
