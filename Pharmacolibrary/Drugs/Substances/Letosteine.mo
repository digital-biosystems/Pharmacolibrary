    logP = -1);
  annotation (Documentation(info = "<html><body><p>Letosteine is a mucolytic (mucokinetic) agent developed for respiratory conditions involving thick mucus, such as cough and cold-related airway problems. It appears to be only experimental and is not an established, widely authorised medicine; its current availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q660090&quot;>Wikidata Q660090</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>letosteine</td></tr><tr><td>ATC codes:</td><td>R05CB09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08939&quot;>DB08939</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/68707&quot;>68707</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:88271&quot;>88271</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q660090&quot;>Q660090</a></td></tr><tr><td>formula:</td><td>C10H17NO4S2</td></tr><tr><td>molar mass:</td><td>279.369 g/mol (PubChem)</td></tr></table></body></html>"));
