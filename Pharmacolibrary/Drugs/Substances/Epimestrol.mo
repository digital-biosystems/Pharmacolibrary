    logP = 2.8);
  annotation (Documentation(info = "<html><body><p>Epimestrol is a synthetic estrogen that has been classified as an ovulation stimulant, suggesting use for inducing ovulation. It appears only as an experimental compound today, with no current marketing authorisation in the European Union, so it is not in routine use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5383041\">Wikidata Q5383041</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>epimestrol</td></tr><tr><td>ATC codes:</td><td>G03GB03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13386\">DB13386</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/244809\">244809</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:34738\">34738</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5383041\">Q5383041</a></td></tr><tr><td>formula:</td><td>C19H26O3</td></tr><tr><td>molar mass:</td><td>302.414 g/mol (PubChem CID 244809)</td></tr><tr><td>logP:</td><td>2.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Epimestrol;
