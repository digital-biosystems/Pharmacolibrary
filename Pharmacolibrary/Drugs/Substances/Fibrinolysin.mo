  annotation (Documentation(info = "<html><body><p>Fibrinolysin is a fibrinolytic enzyme that has been used to dissolve blood clots. It is considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2619971\">Wikidata Q2619971</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>fibrinolysin</td></tr><tr><td>ATC codes:</td><td>B01AD05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB05254\">DB05254</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2619971\">Q2619971</a></td></tr><tr><td>molar mass:</td><td>88411.4 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
