within Pharmacolibrary.Drugs.Substances;
package Camylofin "camylofin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "camylofin",
    atcCodes = {"A03AA03"},
    drugbankId = "DB13738",
    pubchemCid = "5902",
    chebiId = "95216",
    wikidataId = "Q4725854",
    formula = "C19H32N2O2",
    M = 0.320477,
    logP = 3.9);
  annotation (Documentation(info = "<html><body><p>Camylofin is an anticholinergic (parasympatholytic) antispasmodic drug used for functional gastrointestinal disorders and spasms, and has been given for complications of obstetric labor. It is not an established approved medicine in major databases, where it is listed only as experimental, and appears mainly in combination antispasmodic products in some countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4725854\">Wikidata Q4725854</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>camylofin</td></tr><tr><td>ATC codes:</td><td>A03AA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13738\">DB13738</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5902\">5902</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:95216\">95216</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4725854\">Q4725854</a></td></tr><tr><td>formula:</td><td>C19H32N2O2</td></tr><tr><td>molar mass:</td><td>320.477 g/mol (PubChem CID 5902)</td></tr><tr><td>logP:</td><td>3.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Camylofin;
