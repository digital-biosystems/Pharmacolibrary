  annotation (Documentation(info = "<html><body><p>Linopirdine is a nootropic and potassium channel blocker that was investigated as a possible neuroprotective, cognition-enhancing drug for brain disorders. It remains an experimental compound and is not an approved medicine anywhere.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6554730\">Wikidata Q6554730</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>linopirdine</td></tr><tr><td>ATC codes:</td><td>N06BX09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13806\">DB13806</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3932\">3932</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:34823\">34823</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6554730\">Q6554730</a></td></tr><tr><td>formula:</td><td>C26H21N3O</td></tr><tr><td>molar mass:</td><td>391.474 g/mol (PubChem CID 3932)</td></tr><tr><td>logP:</td><td>4.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
