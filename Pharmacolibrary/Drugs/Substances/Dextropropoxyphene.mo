  annotation (Documentation(info = "<html><body><p>Dextropropoxyphene is an opioid painkiller that was used to treat mild to moderate pain. It has been withdrawn from the market because it could cause serious heart problems, even at recommended doses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2268608&quot;>Wikidata Q2268608</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dextropropoxyphene</td></tr><tr><td>ATC codes:</td><td>N02AC04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00647&quot;>DB00647</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/10100&quot;>10100</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:51173&quot;>51173</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2268608&quot;>Q2268608</a></td></tr><tr><td>formula:</td><td>C22H29NO2</td></tr><tr><td>molar mass:</td><td>339.479 g/mol (PubChem)</td></tr></table></body></html>"));
