  annotation (Documentation(info = "<html><body><p>Mexazolam is a benzodiazepine anxiolytic developed for the treatment of anxiety. It is not authorised in the European Union and is considered investigational in major drug databases; it has been used mainly in Japan.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6148446&quot;>Wikidata Q6148446</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mexazolam</td></tr><tr><td>ATC codes:</td><td>N05BA25</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB15489&quot;>DB15489</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4177&quot;>4177</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31842&quot;>31842</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6148446&quot;>Q6148446</a></td></tr><tr><td>formula:</td><td>C18H16Cl2N2O2</td></tr><tr><td>molar mass:</td><td>363.238 g/mol (PubChem)</td></tr></table></body></html>"));
