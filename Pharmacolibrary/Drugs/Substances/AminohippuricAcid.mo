  annotation (Documentation(info = "<html><body><p>Aminohippuric acid is a diagnostic agent used in tests of kidney function and for ureteral injuries. It is an approved diagnostic product, though some formulations have been withdrawn; it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q291271\">Wikidata Q291271</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>aminohippuric acid</td></tr><tr><td>ATC codes:</td><td>V04CH30</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00345\">DB00345</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2148\">2148</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:104011\">104011</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q291271\">Q291271</a></td></tr><tr><td>formula:</td><td>C9H10N2O3</td></tr><tr><td>molar mass:</td><td>194.19 g/mol (PubChem CID 2148)</td></tr><tr><td>logP:</td><td>-0.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
