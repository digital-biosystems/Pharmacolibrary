    logP = -0.4);
  annotation (Documentation(info = "<html><body><p>Metrizamide is an iodinated, water-soluble X-ray contrast agent used to make body structures visible during imaging. It is no longer in routine clinical use and is regarded as an experimental agent.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6824399&quot;>Wikidata Q6824399</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>metrizamide</td></tr><tr><td>ATC codes:</td><td>V08AB01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01578&quot;>DB01578</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/20056604&quot;>20056604</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6824399&quot;>Q6824399</a></td></tr><tr><td>formula:</td><td>C18H22I3N3O8</td></tr><tr><td>molar mass:</td><td>789.087 g/mol (PubChem)</td></tr></table></body></html>"));
end Metrizamide;
