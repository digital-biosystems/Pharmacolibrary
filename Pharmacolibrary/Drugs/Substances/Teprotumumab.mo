  annotation (Documentation(info = "<html><body><p>Teprotumumab is a monoclonal antibody used to treat Graves ophthalmopathy. It is an approved medicine, with one product authorised in the European Union, and remains investigational for other uses.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>teprotumumab</td></tr><tr><td>ATC codes:</td><td>L04AG13</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06343\">DB06343</a></td></tr><tr><td>molar mass:</td><td>148000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
