  annotation (Documentation(info = "<html><body><p>Podophyllotoxin (podofilox) is a topical treatment for common warts. It is an approved dermatological medicine, applied topically to the skin.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q421193&quot;>Wikidata Q421193</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>podophyllotoxin</td></tr><tr><td>ATC codes:</td><td>D06BB04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01179&quot;>DB01179</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/10607&quot;>10607</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:50305&quot;>50305</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q421193&quot;>Q421193</a></td></tr><tr><td>formula:</td><td>C22H22O8</td></tr><tr><td>molar mass:</td><td>414.41 g/mol (PubChem)</td></tr></table></body></html>"));
