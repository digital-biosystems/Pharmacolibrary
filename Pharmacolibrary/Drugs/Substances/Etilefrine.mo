within Pharmacolibrary.Drugs.Substances;
package Etilefrine "etilefrine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "etilefrine",
    atcCodes = {"C01CA01"},
    drugbankId = "DB08985",
    pubchemCid = "3306",
    chebiId = "91518",
    wikidataId = "Q417873",
    formula = "C10H15NO2",
    M = 0.181235,
    logP = 0.1);
  annotation (Documentation(info = "<html><body><p>Etilefrine is a sympathomimetic drug that acts on alpha- and beta-1 adrenergic receptors and was used as a cardiotonic and vasoconstrictor, mainly to raise blood pressure in low blood pressure conditions. It has been approved in some countries but is listed as withdrawn, so it is no longer in general use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q417873\">Wikidata Q417873</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>etilefrine</td></tr><tr><td>ATC codes:</td><td>C01CA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08985\">DB08985</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3306\">3306</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:91518\">91518</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q417873\">Q417873</a></td></tr><tr><td>formula:</td><td>C10H15NO2</td></tr><tr><td>molar mass:</td><td>181.235 g/mol (PubChem CID 3306)</td></tr><tr><td>logP:</td><td>0.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Etilefrine;
