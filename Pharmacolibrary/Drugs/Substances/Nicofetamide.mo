  annotation (Documentation(info = "<html><body><p>Nicofetamide is a synthetic antispasmodic drug, classified as an amide with a tertiary amine, used for functional gastrointestinal disorders. It appears only as an experimental compound and there is no evidence of current marketing or regulatory authorisation, so its present use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3876099\">Wikidata Q3876099</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nicofetamide</td></tr><tr><td>ATC codes:</td><td>A03AC04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13531\">DB13531</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3033975\">3033975</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:81301\">81301</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3876099\">Q3876099</a></td></tr><tr><td>formula:</td><td>C20H18N2O</td></tr><tr><td>molar mass:</td><td>302.377 g/mol (PubChem CID 3033975)</td></tr><tr><td>logP:</td><td>3.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
