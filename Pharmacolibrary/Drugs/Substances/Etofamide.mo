  annotation (Documentation(info = "<html><body><p>Etofamide is an antiprotozoal drug of the dichloroacetamide group used to treat amoebiasis. It is an approved medicine, but it is not authorised in the European Union and appears to be used only in a limited number of countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5404754\">Wikidata Q5404754</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>etofamide</td></tr><tr><td>ATC codes:</td><td>P01AC03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13258\">DB13258</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/65718\">65718</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135692\">135692</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5404754\">Q5404754</a></td></tr><tr><td>formula:</td><td>C19H20Cl2N2O5</td></tr><tr><td>molar mass:</td><td>427.278 g/mol (PubChem CID 65718)</td></tr><tr><td>logP:</td><td>4.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
