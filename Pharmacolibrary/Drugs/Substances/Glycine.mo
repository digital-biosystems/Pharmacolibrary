  annotation (Documentation(info = "<html><body><p>Glycine, a proteinogenic amino acid that also acts as a neurotransmitter, is used as an irrigating solution and has been used in peptic ulcer disease. It is an approved, generally available compound, also approved for veterinary use and considered a nutraceutical.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q620730&quot;>Wikidata Q620730</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>glycine</td></tr><tr><td>ATC codes:</td><td>B05CX03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00145&quot;>DB00145</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/750&quot;>750</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:57305&quot;>57305</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q620730&quot;>Q620730</a></td></tr><tr><td>formula:</td><td>C2H5NO2</td></tr><tr><td>molar mass:</td><td>75.067 g/mol (PubChem)</td></tr></table></body></html>"));
