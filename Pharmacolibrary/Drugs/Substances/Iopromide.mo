  annotation (Documentation(info = "<html><body><p>Iopromide is an iodinated X-ray contrast agent used to make body structures visible during imaging examinations. It is an approved, low-osmolar water-soluble contrast medium used in medical imaging practice.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4202805&quot;>Wikidata Q4202805</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>iopromide</td></tr><tr><td>ATC codes:</td><td>V08AB05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09156&quot;>DB09156</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3736&quot;>3736</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:63578&quot;>63578</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4202805&quot;>Q4202805</a></td></tr><tr><td>formula:</td><td>C18H24I3N3O8</td></tr><tr><td>molar mass:</td><td>791.103 g/mol (PubChem)</td></tr></table></body></html>"));
