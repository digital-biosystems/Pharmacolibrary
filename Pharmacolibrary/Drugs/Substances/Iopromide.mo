  annotation (Documentation(info = "<html><body><p>Iopromide is an iodinated X-ray contrast agent used to make body structures visible during imaging examinations. It is an approved, low-osmolar water-soluble contrast medium used in medical imaging practice.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4202805\">Wikidata Q4202805</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>iopromide</td></tr><tr><td>ATC codes:</td><td>V08AB05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09156\">DB09156</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3736\">3736</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:63578\">63578</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4202805\">Q4202805</a></td></tr><tr><td>formula:</td><td>C18H24I3N3O8</td></tr><tr><td>molar mass:</td><td>791.103 g/mol (PubChem CID 3736)</td></tr><tr><td>logP:</td><td>-2.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
