    logP = 3.1);
  annotation (Documentation(info = "<html><body><p>Tilidine is an opioid painkiller used to treat moderate to severe pain. It is classified as investigational in DrugBank and is not authorised in the European Union; it is used mainly in a few countries such as Germany, often combined with naloxone.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q421108&quot;>Wikidata Q421108</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tilidine</td></tr><tr><td>ATC codes:</td><td>N02AX01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13787&quot;>DB13787</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/12546498&quot;>12546498</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:77822&quot;>77822</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q421108&quot;>Q421108</a></td></tr><tr><td>formula:</td><td>C17H23NO2</td></tr><tr><td>molar mass:</td><td>273.376 g/mol (PubChem)</td></tr></table></body></html>"));
end Tilidine;
