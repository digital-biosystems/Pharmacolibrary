  annotation (Documentation(info = "<html><body><p>Amlexanox is a drug used to treat aphthous stomatitis (canker sores), applied locally in the mouth. It has been withdrawn from the market in some countries, though it remains approved and used in others.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q695611&quot;>Wikidata Q695611</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>amlexanox</td></tr><tr><td>ATC codes:</td><td>A01AD07, R03DX01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01025&quot;>DB01025</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2161&quot;>2161</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31205&quot;>31205</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q695611&quot;>Q695611</a></td></tr><tr><td>formula:</td><td>C16H14N2O4</td></tr><tr><td>molar mass:</td><td>298.298 g/mol (PubChem)</td></tr></table></body></html>"));
