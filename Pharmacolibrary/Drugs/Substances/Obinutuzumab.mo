  annotation (Documentation(info = "<html><body><p>Obinutuzumab is a monoclonal antibody used to treat B-cell blood cancers such as chronic lymphocytic leukemia and various lymphomas. It is approved and authorised in the European Union for chronic lymphocytic leukemia, and is also being investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q389496&quot;>Wikidata Q389496</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>obinutuzumab</td></tr><tr><td>ATC codes:</td><td>L01FA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08935&quot;>DB08935</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q389496&quot;>Q389496</a></td></tr><tr><td>molar mass:</td><td>146100 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Obinutuzumab;
