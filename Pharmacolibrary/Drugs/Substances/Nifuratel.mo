  annotation (Documentation(info = "<html><body><p>Nifuratel is an antiinfective used against gynecological infections such as trichomoniasis and urinary tract infections. It is considered investigational in DrugBank and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3876717&quot;>Wikidata Q3876717</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nifuratel</td></tr><tr><td>ATC codes:</td><td>G01AX05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13724&quot;>DB13724</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6433427&quot;>6433427</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135180&quot;>135180</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3876717&quot;>Q3876717</a></td></tr><tr><td>formula:</td><td>C10H11N3O5S</td></tr><tr><td>molar mass:</td><td>285.274 g/mol (PubChem)</td></tr></table></body></html>"));
