  annotation (Documentation(info = "<html><body><p>Carbinoxamine is an antihistamine (H1 antagonist) used to treat allergic conditions such as vasomotor rhinitis. It is an approved medicine and remains in use, mainly as a systemic antihistamine for respiratory/allergic complaints.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3728177&quot;>Wikidata Q3728177</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>carbinoxamine</td></tr><tr><td>ATC codes:</td><td>R06AA08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00748&quot;>DB00748</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2564&quot;>2564</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3398&quot;>3398</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3728177&quot;>Q3728177</a></td></tr><tr><td>formula:</td><td>C16H19ClN2O</td></tr><tr><td>molar mass:</td><td>290.791 g/mol (PubChem)</td></tr></table></body></html>"));
