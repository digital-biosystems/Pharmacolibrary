  annotation (Documentation(info = "<html><body><p>Diflorasone is a potent topical corticosteroid used to treat inflammatory skin conditions such as dermatoses of the face, scalp, legs, and hands. It is an approved medicine, used mainly in dermatological practice as a topical treatment.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5275451\">Wikidata Q5275451</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>diflorasone</td></tr><tr><td>ATC codes:</td><td>D07AC10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00223\">DB00223</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/71415\">71415</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:59750\">59750</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5275451\">Q5275451</a></td></tr><tr><td>formula:</td><td>C22H28F2O5</td></tr><tr><td>molar mass:</td><td>410.457 g/mol (PubChem CID 71415)</td></tr><tr><td>logP:</td><td>1.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
