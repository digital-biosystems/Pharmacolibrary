  annotation (Documentation(info = "<html><body><p>Cefbuperazone is a second-generation cephalosporin antibiotic used to treat bacterial infections. It is not an authorised medicine in the European Union and appears to be little used today.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5057221&quot;>Wikidata Q5057221</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cefbuperazone</td></tr><tr><td>ATC codes:</td><td>J01DC13</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13638&quot;>DB13638</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/127527&quot;>127527</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135856&quot;>135856</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5057221&quot;>Q5057221</a></td></tr><tr><td>formula:</td><td>C22H29N9O9S2</td></tr><tr><td>molar mass:</td><td>627.648 g/mol (PubChem)</td></tr></table></body></html>"));
