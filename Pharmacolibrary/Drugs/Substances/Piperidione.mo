  annotation (Documentation(info = "<html><body><p>Piperidione is a cough suppressant, classified among other antitussive medicines for cough and cold preparations. It appears to be only an experimental compound, with no evidence of authorised or widespread use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7197355\">Wikidata Q7197355</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>piperidione</td></tr><tr><td>ATC codes:</td><td>R05DB23</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13224\">DB13224</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6465\">6465</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:81302\">81302</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7197355\">Q7197355</a></td></tr><tr><td>formula:</td><td>C9H15NO2</td></tr><tr><td>molar mass:</td><td>169.224 g/mol (PubChem CID 6465)</td></tr><tr><td>logP:</td><td>0.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
