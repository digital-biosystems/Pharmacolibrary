within Pharmacolibrary.Drugs.Substances;
package Glycopyrronium "glycopyrronium"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "glycopyrronium",
    atcCodes = {"A03AB02", "D11AA01", "R03BB06"},
    drugbankId = "DB00986",
    pubchemCid = "9933193",
    chebiId = "94449",
    wikidataId = "Q411917",
    formula = "C19H28NO3+",
    M = 0.318437,
    logP = 3.1);
  annotation (Documentation(info = "<html><body><p>Glycopyrronium is an anticholinergic (muscarinic antagonist) used for conditions such as peptic ulcer disease and chronic obstructive pulmonary disease, and also as an anesthetic adjuvant and antihidrotic. It remains in use, with approved and veterinary-approved products, and is used in inhaled combinations for obstructive airway diseases as well as gastrointestinal and dermatological preparations.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q411917\">Wikidata Q411917</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>glycopyrronium</td></tr><tr><td>ATC codes:</td><td>A03AB02, D11AA01, R03BB06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00986\">DB00986</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9933193\">9933193</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:94449\">94449</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q411917\">Q411917</a></td></tr><tr><td>formula:</td><td>C19H28NO3+</td></tr><tr><td>molar mass:</td><td>318.437 g/mol (PubChem CID 9933193)</td></tr><tr><td>logP:</td><td>3.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Glycopyrronium;
