  annotation (Documentation(info = "<html><body><p>Bupropion is an antidepressant used mainly for major depressive disorder and to help people stop smoking. It is an approved medicine in widespread clinical use, and is also being studied for other conditions such as ADHD.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q834280\">Wikidata Q834280</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bupropion</td></tr><tr><td>ATC codes:</td><td>N06AX12</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01156\">DB01156</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/444\">444</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3219\">3219</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q834280\">Q834280</a></td></tr><tr><td>formula:</td><td>C13H18ClNO</td></tr><tr><td>molar mass:</td><td>239.743 g/mol (PubChem CID 444)</td></tr><tr><td>logP:</td><td>3.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
