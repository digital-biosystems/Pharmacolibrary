    drugbankId = "DB17107");
  annotation (Documentation(info = "<html><body><p>Lifileucel, an autologous tumour-infiltrating lymphocyte cell therapy, is an antineoplastic treatment for melanoma. It is approved in the United States, but its marketing application in the European Union was withdrawn.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>lifileucel</td></tr><tr><td>ATC codes:</td><td>L01XL11</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB17107\">DB17107</a></td></tr></table></body></html>"));
end Lifileucel;
