  annotation (Documentation(info = "<html><body><p>Ustekinumab, a monoclonal antibody that blocks interleukins, is used to treat plaque psoriasis, psoriatic arthritis, Crohn's disease, and ulcerative colitis. It is an approved medicine with several authorised products in the European Union, where it is used for these inflammatory conditions.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q420305&quot;>Wikidata Q420305</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>ustekinumab</td></tr><tr><td>ATC codes:</td><td>L04AC05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB05679&quot;>DB05679</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q420305&quot;>Q420305</a></td></tr><tr><td>molar mass:</td><td>148600 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Ustekinumab;
