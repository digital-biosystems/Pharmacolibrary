    drugbankId = "DB11627");
  annotation (Documentation(info = "<html><body><p>This is a combination vaccine that protects against Haemophilus influenzae type b infection and hepatitis B. It is an approved vaccine used in childhood immunisation programmes in various countries.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>haemophilus influenzae B and hepatitis B</td></tr><tr><td>ATC codes:</td><td>J07CA08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11627&quot;>DB11627</a></td></tr></table></body></html>"));
end HaemophilusInfluenzaeBAndHepatitisB;
