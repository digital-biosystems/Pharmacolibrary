    logP = 0);
  annotation (Documentation(info = "<html><body><p>Calcium carbonate is used as an antacid for heartburn, indigestion and acid-related stomach problems, and as a calcium supplement, for example in osteoporosis. It is an approved, widely available over-the-counter medicine used broadly for these common conditions.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q23767&quot;>Wikidata Q23767</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>calcium carbonate</td></tr><tr><td>ATC codes:</td><td>A02AC01, A12AA04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06724&quot;>DB06724</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/10112&quot;>10112</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3311&quot;>3311</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q23767&quot;>Q23767</a></td></tr><tr><td>formula:</td><td>CCaO3</td></tr><tr><td>molar mass:</td><td>100.086 g/mol (PubChem)</td></tr></table></body></html>"));
