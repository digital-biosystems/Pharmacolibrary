  annotation (Documentation(info = "<html><body><p>Brentuximab vedotin is an antibody-drug conjugate used to treat lymphoma, including Hodgkin lymphoma and several types of T-cell and non-Hodgkin lymphoma. It is approved and authorised in the European Union, and is also being investigated for additional uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q422324&quot;>Wikidata Q422324</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>brentuximab vedotin</td></tr><tr><td>ATC codes:</td><td>L01FX05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08870&quot;>DB08870</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q422324&quot;>Q422324</a></td></tr><tr><td>molar mass:</td><td>150500 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end BrentuximabVedotin;
