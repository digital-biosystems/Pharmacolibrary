  annotation (Documentation(info = "<html><body><p>Hemoglobin crosfumaril (DCLHb) is a modified human hemoglobin developed as a blood substitute for use as a replacement solution. It remained experimental and was never approved for routine clinical use.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>hemoglobin crosfumaril</td></tr><tr><td>ATC codes:</td><td>B05AA08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13864\">DB13864</a></td></tr></table></body></html>"));
