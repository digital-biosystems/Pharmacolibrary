  annotation (Documentation(info = "<html><body><p>Buformin is a biguanide anti-diabetic medication used to lower blood glucose in diabetes. It has been withdrawn from the market, reportedly because of safety concerns including lactic acidosis risk.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q715104\">Wikidata Q715104</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>buformin</td></tr><tr><td>ATC codes:</td><td>A10BA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB04830\">DB04830</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2468\">2468</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3209\">3209</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q715104\">Q715104</a></td></tr><tr><td>formula:</td><td>C6H15N5</td></tr><tr><td>molar mass:</td><td>157.221 g/mol (PubChem CID 2468)</td></tr><tr><td>logP:</td><td>-0.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Buformin;
