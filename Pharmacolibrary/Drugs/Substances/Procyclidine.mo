within Pharmacolibrary.Drugs.Substances;
package Procyclidine "procyclidine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "procyclidine",
    atcCodes = {"N04AA04"},
    drugbankId = "DB00387",
    pubchemCid = "4919",
    chebiId = "8448",
    wikidataId = "Q268997",
