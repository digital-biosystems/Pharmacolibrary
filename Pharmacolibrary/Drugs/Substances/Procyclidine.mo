    M = 0.287447,
    logP = 4.1);
  annotation (Documentation(info = "<html><body><p>Procyclidine is an anticholinergic medicine used to treat parkinsonian symptoms and drug-related movement disorders such as lingual-facial-buccal dyskinesia. It is an approved drug, generally used as an antiparkinson agent, though it is not authorised centrally in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q268997&quot;>Wikidata Q268997</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>procyclidine</td></tr><tr><td>ATC codes:</td><td>N04AA04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00387&quot;>DB00387</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4919&quot;>4919</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8448&quot;>8448</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q268997&quot;>Q268997</a></td></tr><tr><td>formula:</td><td>C19H29NO</td></tr><tr><td>molar mass:</td><td>287.447 g/mol (PubChem)</td></tr></table></body></html>"));
end Procyclidine;
