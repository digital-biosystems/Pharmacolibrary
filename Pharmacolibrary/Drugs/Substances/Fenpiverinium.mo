  annotation (Documentation(info = "<html><body><p>Fenpiverinium is a synthetic anticholinergic (quaternary ammonium) compound studied for use in functional gastrointestinal disorders. It is considered investigational and does not appear to be an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5443572\">Wikidata Q5443572</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>fenpiverinium</td></tr><tr><td>ATC codes:</td><td>A03AB21</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13759\">DB13759</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/71490\">71490</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:94773\">94773</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5443572\">Q5443572</a></td></tr><tr><td>formula:</td><td>C22H29N2O+</td></tr><tr><td>molar mass:</td><td>337.487 g/mol (PubChem CID 71490)</td></tr><tr><td>logP:</td><td>3.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
