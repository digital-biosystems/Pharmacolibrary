within Pharmacolibrary.Drugs.Substances;
package GadobenicAcid "gadobenic acid"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "gadobenic acid",
    atcCodes = {"V08CA08"},
    drugbankId = "DB00743",
    pubchemCid = "131704172",
    wikidataId = "Q5516409",
    formula = "C22H28GdN3O11",
    M = 0.667726);
  annotation (Documentation(info = "<html><body><p>Gadobenic acid is a gadolinium-based contrast agent used to improve images in magnetic resonance imaging. It is an approved paramagnetic MRI contrast medium, though its use is limited to certain regions rather than worldwide.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5516409\">Wikidata Q5516409</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>gadobenic acid</td></tr><tr><td>ATC codes:</td><td>V08CA08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00743\">DB00743</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/131704172\">131704172</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5516409\">Q5516409</a></td></tr><tr><td>formula:</td><td>C22H28GdN3O11</td></tr><tr><td>molar mass:</td><td>667.726 g/mol (PubChem CID 131704172)</td></tr></table></body></html>"));
end GadobenicAcid;
