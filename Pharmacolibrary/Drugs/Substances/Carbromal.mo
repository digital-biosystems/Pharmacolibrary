  annotation (Documentation(info = "<html><body><p>Carbromal is a sedative-hypnotic drug that was used to treat sleeplessness and calm anxiety. It is now considered an experimental compound and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q382185\">Wikidata Q382185</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>carbromal</td></tr><tr><td>ATC codes:</td><td>N05CM04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13817\">DB13817</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6488\">6488</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134961\">134961</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q382185\">Q382185</a></td></tr><tr><td>formula:</td><td>C7H13BrN2O2</td></tr><tr><td>molar mass:</td><td>237.097 g/mol (PubChem CID 6488)</td></tr><tr><td>logP:</td><td>1.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
