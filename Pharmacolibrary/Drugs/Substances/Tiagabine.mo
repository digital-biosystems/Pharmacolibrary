  annotation (Documentation(info = "<html><body><p>Tiagabine is an anticonvulsant used to treat focal epilepsy and has also been studied for bipolar disorder. It is an approved medicine, though not authorised in the European Union, and remains under investigation for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q907219\">Wikidata Q907219</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tiagabine</td></tr><tr><td>ATC codes:</td><td>N03AG06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00906\">DB00906</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/60648\">60648</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9586\">9586</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q907219\">Q907219</a></td></tr><tr><td>formula:</td><td>C20H25NO2S2</td></tr><tr><td>molar mass:</td><td>375.545 g/mol (PubChem CID 60648)</td></tr><tr><td>logP:</td><td>2.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Tiagabine;
