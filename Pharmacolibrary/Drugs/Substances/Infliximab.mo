within Pharmacolibrary.Drugs.Substances;
package Infliximab "infliximab"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "infliximab",
    atcCodes = {"L04AB02"},
    drugbankId = "DB00065",
    wikidataId = "Q415264",
    M = 144.19);
  annotation (Documentation(info = "<html><body><p>Infliximab is a monoclonal antibody that blocks tumour necrosis factor alpha and is used to treat inflammatory conditions such as rheumatoid and psoriatic arthritis, Crohn's disease, ulcerative colitis, psoriasis, and ankylosing spondylitis. It is approved and widely used, with several products authorised in the European Union, and is also being studied for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q415264\">Wikidata Q415264</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>infliximab</td></tr><tr><td>ATC codes:</td><td>L04AB02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00065\">DB00065</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q415264\">Q415264</a></td></tr><tr><td>molar mass:</td><td>144190 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Infliximab;
