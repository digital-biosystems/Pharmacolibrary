  annotation (Documentation(info = "<html><body><p>Alitretinoin is a retinoid used to treat Kaposi's sarcoma, including AIDS-related cases, and certain skin conditions. It is an approved medicine, though one European Union product has been withdrawn; it is used mainly in dermatology and cancer care.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3611854&quot;>Wikidata Q3611854</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>alitretinoin</td></tr><tr><td>ATC codes:</td><td>D11AH04, L01XF02, L01XX22</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00523&quot;>DB00523</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/449171&quot;>449171</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:50648&quot;>50648</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3611854&quot;>Q3611854</a></td></tr><tr><td>formula:</td><td>C20H28O2</td></tr><tr><td>molar mass:</td><td>300.442 g/mol (PubChem)</td></tr></table></body></html>"));
