  annotation (Documentation(info = "<html><body><p>Pirprofen is a non-steroidal anti-inflammatory drug of the propionic acid derivative class, developed for pain and inflammation in musculoskeletal conditions. It is no longer in routine use and is currently listed only as an experimental drug.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3905662&quot;>Wikidata Q3905662</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pirprofen</td></tr><tr><td>ATC codes:</td><td>M01AE08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13722&quot;>DB13722</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/35935&quot;>35935</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135028&quot;>135028</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3905662&quot;>Q3905662</a></td></tr><tr><td>formula:</td><td>C13H14ClNO2</td></tr><tr><td>molar mass:</td><td>251.71 g/mol (PubChem)</td></tr></table></body></html>"));
