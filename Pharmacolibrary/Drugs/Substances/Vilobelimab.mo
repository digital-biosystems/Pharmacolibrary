  annotation (Documentation(info = "<html><body><p>Vilobelimab is a complement inhibitor used for adult respiratory distress syndrome associated with COVID-19. It is authorised in the European Union and remains investigational for other uses.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>vilobelimab</td></tr><tr><td>ATC codes:</td><td>L04AJ10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB16416\">DB16416</a></td></tr></table></body></html>"));
