  annotation (Documentation(info = "<html><body><p>Calcipotriol is a vitamin D-based skin medicine used to treat psoriasis and acropustulosis. It is an approved topical antipsoriatic, applied directly to the skin, and is widely used for this purpose.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q155683\">Wikidata Q155683</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>calcipotriol</td></tr><tr><td>ATC codes:</td><td>D05AX02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB02300\">DB02300</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5288783\">5288783</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:50749\">50749</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q155683\">Q155683</a></td></tr><tr><td>formula:</td><td>C27H40O3</td></tr><tr><td>molar mass:</td><td>412.614 g/mol (PubChem CID 5288783)</td></tr><tr><td>logP:</td><td>4.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
