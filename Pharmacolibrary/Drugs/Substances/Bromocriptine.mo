within Pharmacolibrary.Drugs.Substances;
package Bromocriptine "bromocriptine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "bromocriptine",
    atcCodes = {"G02CB01", "N04BC01"},
    drugbankId = "DB01200",
    pubchemCid = "31101",
    chebiId = "3181",
    wikidataId = "Q413581",
    formula = "C32H40BrN5O5",
    M = 0.654606,
    logP = 3.8);
  annotation (Documentation(info = "<html><body><p>Bromocriptine is a dopamine agonist used for conditions involving high prolactin such as prolactinoma and hyperprolactinemia, as well as Parkinson's disease, acromegaly, infertility, and related hormonal disorders. It remains an approved medicine used in many countries, though some uses have been withdrawn; it is not authorised centrally in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q413581&quot;>Wikidata Q413581</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bromocriptine</td></tr><tr><td>ATC codes:</td><td>G02CB01, N04BC01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01200&quot;>DB01200</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/31101&quot;>31101</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3181&quot;>3181</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q413581&quot;>Q413581</a></td></tr><tr><td>formula:</td><td>C32H40BrN5O5</td></tr><tr><td>molar mass:</td><td>654.606 g/mol (PubChem)</td></tr></table></body></html>"));
end Bromocriptine;
