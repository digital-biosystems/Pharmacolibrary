    logP = 3);
  annotation (Documentation(info = "<html><body><p>Pipradrol is a psychostimulant that was used as a mild central nervous system stimulant, for example to treat fatigue and narcolepsy. It is no longer in use, having been withdrawn from the market because of its abuse and dependence potential.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2084598\">Wikidata Q2084598</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pipradrol</td></tr><tr><td>ATC codes:</td><td>N06BX15</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11584\">DB11584</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/10083\">10083</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135101\">135101</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2084598\">Q2084598</a></td></tr><tr><td>formula:</td><td>C18H21NO</td></tr><tr><td>molar mass:</td><td>267.372 g/mol (PubChem CID 10083)</td></tr><tr><td>logP:</td><td>3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Pipradrol;
