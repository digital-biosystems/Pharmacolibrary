  annotation (Documentation(info = "<html><body><p>Lumefantrine is an antimalarial drug used to treat malaria, typically in combination with artemisinin derivatives. It is an approved medicine and is widely used in antimalarial combination therapy around the world.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q904464&quot;>Wikidata Q904464</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Lumefantrine</td></tr><tr><td>ATC codes:</td><td>P01BF01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06708&quot;>DB06708</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6437380&quot;>6437380</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:156095&quot;>156095</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q904464&quot;>Q904464</a></td></tr><tr><td>formula:</td><td>C30H32Cl3NO</td></tr><tr><td>molar mass:</td><td>528.942 g/mol (PubChem)</td></tr></table></body></html>"));
