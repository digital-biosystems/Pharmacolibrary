  annotation (Documentation(info = "<html><body><p>Acitretin is a retinoid medicine used to treat psoriasis, including severe forms such as acropustulosis. It is an approved, systemically used antipsoriatic, prescribed under medical supervision and carrying a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q341500\">Wikidata Q341500</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>acitretin</td></tr><tr><td>ATC codes:</td><td>D05BB02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00459\">DB00459</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5284513\">5284513</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:50173\">50173</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q341500\">Q341500</a></td></tr><tr><td>formula:</td><td>C21H26O3</td></tr><tr><td>molar mass:</td><td>326.436 g/mol (PubChem CID 5284513)</td></tr><tr><td>logP:</td><td>6.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
