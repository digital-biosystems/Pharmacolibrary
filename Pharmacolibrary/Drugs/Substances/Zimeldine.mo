  annotation (Documentation(info = "<html><body><p>Zimeldine was an antidepressant of the selective serotonin reuptake inhibitor class, used to treat depression. It was later withdrawn from the market after being linked to serious neurological adverse reactions, so it is no longer used.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q203483&quot;>Wikidata Q203483</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>zimeldine</td></tr><tr><td>ATC codes:</td><td>N06AB02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB04832&quot;>DB04832</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5365247&quot;>5365247</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q203483&quot;>Q203483</a></td></tr><tr><td>formula:</td><td>C16H17BrN2</td></tr><tr><td>molar mass:</td><td>317.23 g/mol (PubChem)</td></tr></table></body></html>"));
