  annotation (Documentation(info = "<html><body><p>Deferoxamine is an iron chelating agent used to treat iron overload, including in conditions such as thalassemia and myelodysplastic syndrome. It is an approved medicine and is included on the WHO essential medicines list, so it remains in widespread clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q419618&quot;>Wikidata Q419618</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>deferoxamine</td></tr><tr><td>ATC codes:</td><td>V03AC01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00746&quot;>DB00746</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2973&quot;>2973</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4356&quot;>4356</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q419618&quot;>Q419618</a></td></tr><tr><td>formula:</td><td>C25H48N6O8</td></tr><tr><td>molar mass:</td><td>560.693 g/mol (PubChem)</td></tr></table></body></html>"));
