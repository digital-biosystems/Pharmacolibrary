  annotation (Documentation(info = "<html><body><p>Ethyl chloride (chloroethane) is a local anesthetic that was used to relieve pain, for example by numbing the skin. It is no longer used in medicine, largely because it is considered a carcinogen.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q409133\">Wikidata Q409133</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ethyl chloride</td></tr><tr><td>ATC codes:</td><td>N01BX01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13259\">DB13259</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6337\">6337</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:47554\">47554</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q409133\">Q409133</a></td></tr><tr><td>formula:</td><td>C2H5Cl</td></tr><tr><td>molar mass:</td><td>64.512 g/mol (PubChem CID 6337)</td></tr><tr><td>logP:</td><td>1.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
