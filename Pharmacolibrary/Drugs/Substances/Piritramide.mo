  annotation (Documentation(info = "<html><body><p>Piritramide is a strong opioid painkiller used to treat moderate to severe pain, such as pain after surgery. It is not approved everywhere and has been withdrawn in some countries, but it remains in clinical use in parts of Europe, mainly in hospital settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q416439\">Wikidata Q416439</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>piritramide</td></tr><tr><td>ATC codes:</td><td>N02AC03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12492\">DB12492</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9331\">9331</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135699\">135699</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q416439\">Q416439</a></td></tr><tr><td>formula:</td><td>C27H34N4O</td></tr><tr><td>molar mass:</td><td>430.596 g/mol (PubChem CID 9331)</td></tr><tr><td>logP:</td><td>3.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
