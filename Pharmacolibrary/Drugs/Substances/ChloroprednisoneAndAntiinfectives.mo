  annotation (Documentation(info = "<html><body><p>Chloroprednisone combined with antiinfectives is an eye preparation classified as a corticosteroid plus antiinfective combination, used for inflammatory eye conditions where infection may be present. It appears only as an experimental entry in DrugBank, with no marketing authorisation found, so its current availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5103160&quot;>Wikidata Q5103160</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>chloroprednisone and antiinfectives</td></tr><tr><td>ATC codes:</td><td>S01CA09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB15970&quot;>DB15970</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135618&quot;>135618</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5103160&quot;>Q5103160</a></td></tr><tr><td>formula:</td><td>C21H25ClO5</td></tr><tr><td>molar mass:</td><td>392.88 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end ChloroprednisoneAndAntiinfectives;
