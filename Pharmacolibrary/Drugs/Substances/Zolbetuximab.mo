  annotation (Documentation(info = "<html><body><p>Zolbetuximab is a monoclonal antibody used to treat stomach and esophageal cancers. It is an authorised medicine in the European Union and remains under investigation for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q17107865\">Wikidata Q17107865</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>zolbetuximab</td></tr><tr><td>ATC codes:</td><td>L01FX31</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB15118\">DB15118</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q17107865\">Q17107865</a></td></tr></table></body></html>"));
end Zolbetuximab;
