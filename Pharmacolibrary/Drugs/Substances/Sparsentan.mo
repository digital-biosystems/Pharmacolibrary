  annotation (Documentation(info = "<html><body><p>Sparsentan is used to treat IgA glomerulonephritis, a kidney disease. It is approved and authorised in the European Union, though it remains under investigation for other uses and carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27088845&quot;>Wikidata Q27088845</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>sparsentan</td></tr><tr><td>ATC codes:</td><td>C09XX01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12548&quot;>DB12548</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/10257882&quot;>10257882</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27088845&quot;>Q27088845</a></td></tr><tr><td>formula:</td><td>C32H40N4O5S</td></tr><tr><td>molar mass:</td><td>592.755 g/mol (PubChem)</td></tr></table></body></html>"));
