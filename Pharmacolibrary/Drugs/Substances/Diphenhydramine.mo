    pubchemCid = "3100",
    chebiId = "4636",
    wikidataId = "Q413486",
    formula = "C17H21NO",
    M = 0.255361,
    logP = 3.3);
  annotation (Documentation(info = "<html><body><p>Diphenhydramine is an antihistamine used for conditions such as urticaria, motion sickness, insomnia and anxiety, and also acts as a sedative, antiemetic and topical antipruritic. It is an approved medicine in widespread use, available both as a systemic antihistamine and in topical preparations for itching.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q413486\">Wikidata Q413486</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>diphenhydramine</td></tr><tr><td>ATC codes:</td><td>D04AA32, D04AA33, R06AA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01075\">DB01075</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3100\">3100</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4636\">4636</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q413486\">Q413486</a></td></tr><tr><td>formula:</td><td>C17H21NO</td></tr><tr><td>molar mass:</td><td>255.361 g/mol (PubChem CID 3100)</td></tr><tr><td>logP:</td><td>3.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Diphenhydramine;
