  annotation (Documentation(info = "<html><body><p>Aducanumab is a monoclonal antibody against beta-amyloid that was developed to treat Alzheimer's disease. Its marketing application was withdrawn in the European Union, and it is not in routine use there.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q15708278&quot;>Wikidata Q15708278</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>aducanumab</td></tr><tr><td>ATC codes:</td><td>N06DX03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12274&quot;>DB12274</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q15708278&quot;>Q15708278</a></td></tr><tr><td>molar mass:</td><td>146000 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
