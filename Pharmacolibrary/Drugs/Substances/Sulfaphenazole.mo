  annotation (Documentation(info = "<html><body><p>Sulfaphenazole is a long-acting sulfonamide antibiotic used to treat bacterial infections. It is an approved antibacterial for systemic use, though it is not widely used today.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6577293&quot;>Wikidata Q6577293</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sulfaphenazole</td></tr><tr><td>ATC codes:</td><td>J01ED08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06729&quot;>DB06729</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5335&quot;>5335</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:77780&quot;>77780</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6577293&quot;>Q6577293</a></td></tr><tr><td>formula:</td><td>C15H14N4O2S</td></tr><tr><td>molar mass:</td><td>314.363 g/mol (PubChem)</td></tr></table></body></html>"));
