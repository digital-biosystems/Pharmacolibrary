  annotation (Documentation(info = "<html><body><p>Timepidium bromide is a synthetic anticholinergic (quaternary ammonium) drug intended for the treatment of functional gastrointestinal disorders. It is considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27275072\">Wikidata Q27275072</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>timepidium bromide</td></tr><tr><td>ATC codes:</td><td>A03AB19</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13850\">DB13850</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5476\">5476</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27275072\">Q27275072</a></td></tr><tr><td>formula:</td><td>C17H22NOS2+</td></tr><tr><td>molar mass:</td><td>320.489 g/mol (PubChem CID 5476)</td></tr></table><p><small>Drugs.Common 25.09 gave 400.4 g/mol (+24.9 %); replaced by the value above</small></p></body></html>"));
