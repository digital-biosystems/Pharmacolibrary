within Pharmacolibrary.Drugs.Substances;
package Fluorescein "fluorescein"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "fluorescein",
    atcCodes = {"S01JA01"},
    drugbankId = "DB00693",
    pubchemCid = "16850",
    chebiId = "31624",
    wikidataId = "Q410922",
    formula = "C20H12O5",
    M = 0.332311,
    logP = 3.4);
  annotation (Documentation(info = "<html><body><p>Fluorescein is a fluorescent dye used in eye examinations as a diagnostic colouring agent and contrast agent to help visualise structures of the eye. It is an approved diagnostic ophthalmological agent and is widely used in eye care, with some investigational uses as well.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q410922&quot;>Wikidata Q410922</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>fluorescein</td></tr><tr><td>ATC codes:</td><td>S01JA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00693&quot;>DB00693</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/16850&quot;>16850</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31624&quot;>31624</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q410922&quot;>Q410922</a></td></tr><tr><td>formula:</td><td>C20H12O5</td></tr><tr><td>molar mass:</td><td>332.311 g/mol (PubChem)</td></tr></table></body></html>"));
end Fluorescein;
