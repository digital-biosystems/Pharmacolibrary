within Pharmacolibrary.Drugs.Substances;
package Ethacridine "Ethacridine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "Ethacridine",
    atcCodes = {"B05CA08", "D08AA01"},
    drugbankId = "DB13190",
    pubchemCid = "2017",
    wikidataId = "Q426220",
    formula = "C15H15N3O",
    M = 0.253305);
  annotation (Documentation(info = "<html><body><p>Ethacridine is an acridine antiseptic used to disinfect skin and wounds and as an irrigating solution. It is not an approved medicine in the European Union and is considered investigational, though it remains known as a topical antiseptic in some countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q426220\">Wikidata Q426220</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Ethacridine</td></tr><tr><td>ATC codes:</td><td>B05CA08, D08AA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13190\">DB13190</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2017\">2017</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q426220\">Q426220</a></td></tr><tr><td>formula:</td><td>C15H15N3O</td></tr><tr><td>molar mass:</td><td>253.305 g/mol (PubChem CID 2017)</td></tr></table></body></html>"));
end Ethacridine;
