  annotation (Documentation(info = "<html><body><p>Levoverbenone, the levorotatory form of verbenone, was classified as an expectorant for cough and cold preparations. It is listed only as an experimental compound and is not an established marketed medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6535827\">Wikidata Q6535827</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>levoverbenone</td></tr><tr><td>ATC codes:</td><td>R05CA11</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13391\">DB13391</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/92874\">92874</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:78316\">78316</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6535827\">Q6535827</a></td></tr><tr><td>formula:</td><td>C10H14O</td></tr><tr><td>molar mass:</td><td>150.221 g/mol (PubChem CID 92874)</td></tr><tr><td>logP:</td><td>1.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
