    M = 0.510058);
  annotation (Documentation(info = "<html><body><p>Diodone is an iodinated, water-soluble X-ray contrast medium, formerly used in imaging of the urinary tract. It is now considered an experimental compound and is not in routine clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5279100\">Wikidata Q5279100</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>diodone</td></tr><tr><td>ATC codes:</td><td>V08AA10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13568\">DB13568</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5284574\">5284574</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5279100\">Q5279100</a></td></tr><tr><td>formula:</td><td>C11H16I2N2O5</td></tr><tr><td>molar mass:</td><td>510.058 g/mol (PubChem CID 5284574)</td></tr></table></body></html>"));
end Diodone;
