  annotation (Documentation(info = "<html><body><p>Diodone (iodopyracet) is an iodinated, water-soluble X-ray contrast medium formerly used in imaging examinations. It is no longer in routine clinical use and is regarded today as an experimental compound.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27295882&quot;>Wikidata Q27295882</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>diodone</td></tr><tr><td>ATC codes:</td><td>V08AA10</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13568&quot;>DB13568</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5284574&quot;>5284574</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27295882&quot;>Q27295882</a></td></tr><tr><td>formula:</td><td>C11H16I2N2O5</td></tr><tr><td>molar mass:</td><td>510.058 g/mol (PubChem)</td></tr></table></body></html>"));
end Diodone;
