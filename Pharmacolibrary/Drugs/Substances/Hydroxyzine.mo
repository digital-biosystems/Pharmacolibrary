  annotation (Documentation(info = "<html><body><p>Hydroxyzine is an antihistamine medicine used to treat anxiety and anxiety disorders, and also to relieve itching and vomiting. It is an approved medication, classified as an anxiolytic, and remains in general use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q421937\">Wikidata Q421937</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>hydroxyzine</td></tr><tr><td>ATC codes:</td><td>N05BB01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00557\">DB00557</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3658\">3658</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:5818\">5818</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q421937\">Q421937</a></td></tr><tr><td>formula:</td><td>C21H27ClN2O2</td></tr><tr><td>molar mass:</td><td>374.909 g/mol (PubChem CID 3658)</td></tr><tr><td>logP:</td><td>3.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
