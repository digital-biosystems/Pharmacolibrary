    logP = 3.2);
  annotation (Documentation(info = "<html><body><p>Mizolastine is a non-sedating antihistamine used to relieve symptoms of allergic conditions such as allergic rhinitis and hives. It is an approved medicine that has been used mainly in European countries, though it is not authorised across the whole European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q417830\">Wikidata Q417830</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mizolastine</td></tr><tr><td>ATC codes:</td><td>R06AX25</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12523\">DB12523</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/65906\">65906</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31857\">31857</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q417830\">Q417830</a></td></tr><tr><td>formula:</td><td>C24H25FN6O</td></tr><tr><td>molar mass:</td><td>432.503 g/mol (PubChem CID 65906)</td></tr><tr><td>logP:</td><td>3.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Mizolastine;
