  annotation (Documentation(info = "<html><body><p>Micafungin is an antifungal medicine used to treat fungal infections such as candidiasis and aspergillosis. It is authorised in the European Union for candidiasis and is an approved drug.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6827850\">Wikidata Q6827850</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>micafungin</td></tr><tr><td>ATC codes:</td><td>J02AX05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01141\">DB01141</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/477468\">477468</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:600520\">600520</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6827850\">Q6827850</a></td></tr><tr><td>formula:</td><td>C56H71N9O23S</td></tr><tr><td>molar mass:</td><td>1270.28 g/mol (PubChem CID 477468)</td></tr><tr><td>logP:</td><td>-1.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
