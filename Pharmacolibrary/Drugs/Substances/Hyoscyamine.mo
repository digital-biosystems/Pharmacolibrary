within Pharmacolibrary.Drugs.Substances;
package Hyoscyamine "hyoscyamine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "hyoscyamine",
    atcCodes = {"A03BA03"},
    drugbankId = "DB00424",
    pubchemCid = "154417",
    chebiId = "17486",
    wikidataId = "Q413762",
    formula = "C17H23NO3",
    M = 0.289375,
    logP = 1.8);
  annotation (Documentation(info = "<html><body><p>Hyoscyamine, a belladonna alkaloid, is used to treat spasms and related gut problems such as irritable bowel syndrome, colic, peptic ulcer disease, and also conditions like hypersalivation and neurogenic bladder. It is an approved medicine and is used, alone or in combination products, mainly for functional gastrointestinal disorders.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q413762\">Wikidata Q413762</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>hyoscyamine</td></tr><tr><td>ATC codes:</td><td>A03BA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00424\">DB00424</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/154417\">154417</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:17486\">17486</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q413762\">Q413762</a></td></tr><tr><td>formula:</td><td>C17H23NO3</td></tr><tr><td>molar mass:</td><td>289.375 g/mol (PubChem CID 154417)</td></tr><tr><td>logP:</td><td>1.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Hyoscyamine;
