within Pharmacolibrary.Drugs.Substances;
package Cerivastatin "cerivastatin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "cerivastatin",
    atcCodes = {"C10AA06"},
    drugbankId = "DB00439",
    pubchemCid = "446156",
    chebiId = "3558",
    wikidataId = "Q423439",
