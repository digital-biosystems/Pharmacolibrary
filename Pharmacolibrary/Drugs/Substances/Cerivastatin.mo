    logP = 3.6);
  annotation (Documentation(info = "<html><body><p>Cerivastatin is a statin that was used to lower blood lipids in conditions such as hyperlipidemia and related cardiovascular disease. It was withdrawn from the market after being linked to serious muscle damage, including fatal rhabdomyolysis, and is no longer used.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q423439\">Wikidata Q423439</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cerivastatin</td></tr><tr><td>ATC codes:</td><td>C10AA06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00439\">DB00439</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/446156\">446156</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3558\">3558</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q423439\">Q423439</a></td></tr><tr><td>formula:</td><td>C26H34FNO5</td></tr><tr><td>molar mass:</td><td>459.558 g/mol (PubChem CID 446156)</td></tr><tr><td>logP:</td><td>3.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Cerivastatin;
