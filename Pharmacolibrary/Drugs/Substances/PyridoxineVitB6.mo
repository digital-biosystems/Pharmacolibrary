  annotation (Documentation(info = "<html><body><p>Pyridoxine (vitamin B6) is a vitamin used as a supplement, and has been used for conditions such as visual epilepsy. It is widely used, appears on the WHO essential medicines list, is approved for human and veterinary use, and is also considered a nutraceutical.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q423746\">Wikidata Q423746</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pyridoxine (vit B6)</td></tr><tr><td>ATC codes:</td><td>A11HA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00165\">DB00165</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/1054\">1054</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:16709\">16709</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q423746\">Q423746</a></td></tr><tr><td>formula:</td><td>C8H11NO3</td></tr><tr><td>molar mass:</td><td>169.18 g/mol (PubChem CID 1054)</td></tr><tr><td>logP:</td><td>-0.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
