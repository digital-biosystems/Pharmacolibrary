  annotation (Documentation(info = "<html><body><p>Ethyl loflazepate is a benzodiazepine derivative that has been used as an anxiolytic to treat anxiety. It is not an authorised medicine in the European Union and appears to be little used or unavailable today.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5404460&quot;>Wikidata Q5404460</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ethyl loflazepate</td></tr><tr><td>ATC codes:</td><td>N05BA18</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01545&quot;>DB01545</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3299&quot;>3299</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31573&quot;>31573</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5404460&quot;>Q5404460</a></td></tr><tr><td>formula:</td><td>C18H14ClFN2O3</td></tr><tr><td>molar mass:</td><td>360.769 g/mol (PubChem)</td></tr></table></body></html>"));
