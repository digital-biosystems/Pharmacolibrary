  annotation (Documentation(info = "<html><body><p>Sodium fluoride labelled with fluorine-18 is a diagnostic radiopharmaceutical used to detect tumours through PET imaging of bone and tumour uptake. It is an approved imaging agent, used in nuclear medicine centres for tumour detection.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27260079&quot;>Wikidata Q27260079</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sodium fluoride (18F)</td></tr><tr><td>ATC codes:</td><td>V09IX06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09398&quot;>DB09398</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/23690531&quot;>23690531</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27260079&quot;>Q27260079</a></td></tr><tr><td>formula:</td><td>FNa</td></tr><tr><td>molar mass:</td><td>41.988 g/mol (PubChem)</td></tr></table></body></html>"));
