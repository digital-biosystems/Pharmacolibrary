    M = 0.041988);
  annotation (Documentation(info = "<html><body><p>Sodium fluoride labelled with fluorine-18 is a diagnostic radiopharmaceutical used to detect tumours through PET imaging of bone and tumour uptake. It is an approved imaging agent, used in nuclear medicine centres for tumour detection.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27260079\">Wikidata Q27260079</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sodium fluoride (18F)</td></tr><tr><td>ATC codes:</td><td>V09IX06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09398\">DB09398</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/23690531\">23690531</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27260079\">Q27260079</a></td></tr><tr><td>formula:</td><td>FNa</td></tr><tr><td>molar mass:</td><td>41.988 g/mol (PubChem CID 23690531)</td></tr></table><p><small>Drugs.Common 25.09 gave 40.991 g/mol (-2.4 %); replaced by the value above</small></p></body></html>"));
end SodiumFluoride18F;
