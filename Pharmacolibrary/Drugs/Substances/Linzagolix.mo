  annotation (Documentation(info = "<html><body><p>Linzagolix is an anti-gonadotropin-releasing hormone medicine, approved for treating hormone-related conditions such as uterine fibroids. It is an approved medicine and is marketed in some countries, though not centrally authorised in the European Union.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>linzagolix</td></tr><tr><td>ATC codes:</td><td>H01CC04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB17083&quot;>DB17083</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/16656889&quot;>16656889</a></td></tr><tr><td>formula:</td><td>C22H15F3N2O7S</td></tr><tr><td>molar mass:</td><td>508.423 g/mol (PubChem)</td></tr></table></body></html>"));
