    M = 1330);
  annotation (Documentation(info = "<html><body><p>Voretigene neparvovec is a gene therapy used to treat inherited retinal dystrophies, including Leber congenital amaurosis and retinitis pigmentosa. It is authorised in the European Union and is a specialised treatment, so its use remains limited.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>voretigene neparvovec</td></tr><tr><td>ATC codes:</td><td>S01XA27</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13932\">DB13932</a></td></tr><tr><td>molar mass:</td><td>1.33e+06 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end VoretigeneNeparvovec;
