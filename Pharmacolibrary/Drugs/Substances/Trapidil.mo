  annotation (Documentation(info = "<html><body><p>Trapidil is a vasodilator and platelet aggregation inhibitor that was classified for cardiac therapy as a vasodilator used in heart disease. It is currently considered experimental and does not appear to be an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2449982\">Wikidata Q2449982</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>trapidil</td></tr><tr><td>ATC codes:</td><td>C01DX11</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09283\">DB09283</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5531\">5531</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32254\">32254</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2449982\">Q2449982</a></td></tr><tr><td>formula:</td><td>C10H15N5</td></tr><tr><td>molar mass:</td><td>205.265 g/mol (PubChem CID 5531)</td></tr><tr><td>logP:</td><td>1.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
