  annotation (Documentation(info = "<html><body><p>Flosequinan is a vasodilator that was used to treat heart failure. It has been withdrawn from the market and is no longer used, reportedly because of safety concerns in patients with heart failure.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q592947\">Wikidata Q592947</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>flosequinan</td></tr><tr><td>ATC codes:</td><td>C01DB01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13228\">DB13228</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4474062\">4474062</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134972\">134972</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q592947\">Q592947</a></td></tr><tr><td>formula:</td><td>C11H10FNO2S</td></tr><tr><td>molar mass:</td><td>239.264 g/mol (PubChem CID 4474062)</td></tr><tr><td>logP:</td><td>1.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Flosequinan;
