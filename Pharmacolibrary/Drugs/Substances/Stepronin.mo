    logP = 1.7);
  annotation (Documentation(info = "<html><body><p>Stepronin is a mucolytic (mucokinetic) agent that was used to loosen mucus in cough and cold preparations, and has also been described as an immunosuppressive and antiviral agent. It is currently considered experimental and does not appear to be an approved medicine in major markets such as the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7611141\">Wikidata Q7611141</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>stepronin</td></tr><tr><td>ATC codes:</td><td>R05CB11</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01423\">DB01423</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/54120\">54120</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135129\">135129</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7611141\">Q7611141</a></td></tr><tr><td>formula:</td><td>C10H11NO4S2</td></tr><tr><td>molar mass:</td><td>273.321 g/mol (PubChem CID 54120)</td></tr><tr><td>logP:</td><td>1.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Stepronin;
