  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "stepronin",
    atcCodes = {"R05CB11"},
    drugbankId = "DB01423",
    pubchemCid = "54120",
    chebiId = "135129",
    wikidataId = "Q7611141",
