    logP = 1.1);
  annotation (Documentation(info = "<html><body><p>Pilocarpine is a muscarinic agonist used to treat glaucoma, including angle-closure glaucoma, and dryness in head and neck cancer patients. It remains an approved medicine and is listed as a WHO essential medicine, used mainly in ophthalmology as an antiglaucoma miotic.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q411461\">Wikidata Q411461</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pilocarpine</td></tr><tr><td>ATC codes:</td><td>N07AX01, S01EB01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01085\">DB01085</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5910\">5910</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8207\">8207</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q411461\">Q411461</a></td></tr><tr><td>formula:</td><td>C11H16N2O2</td></tr><tr><td>molar mass:</td><td>208.261 g/mol (PubChem CID 5910)</td></tr><tr><td>logP:</td><td>1.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Pilocarpine;
