within Pharmacolibrary.Drugs.Substances;
package Pilocarpine "pilocarpine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "pilocarpine",
    atcCodes = {"N07AX01", "S01EB01"},
    drugbankId = "DB01085",
    pubchemCid = "5910",
    chebiId = "8207",
    wikidataId = "Q411461",
    formula = "C11H16N2O2",
