within Pharmacolibrary.Drugs.Substances;
package CoagulationFactorIX "coagulation factor IX"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "coagulation factor IX",
    atcCodes = {"B02BD04"},
    drugbankId = "DB13152",
    wikidataId = "Q20801778",
    M = 46.5482);
  annotation (Documentation(info = "<html><body><p>Coagulation factor IX is a blood-clotting protein medicine used to treat or prevent bleeding in people with hemophilia B (factor IX deficiency). It is an approved treatment, given by infusion, and is used widely for hemophilia B care.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q20801778\">Wikidata Q20801778</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>coagulation factor IX</td></tr><tr><td>ATC codes:</td><td>B02BD04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13152\">DB13152</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q20801778\">Q20801778</a></td></tr><tr><td>molar mass:</td><td>46548.2 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end CoagulationFactorIX;
