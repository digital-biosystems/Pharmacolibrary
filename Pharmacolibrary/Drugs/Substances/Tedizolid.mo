  annotation (Documentation(info = "<html><body><p>Tedizolid is an oxazolidinone antibiotic used to treat bacterial infections of the skin and soft tissues. It is approved and authorised in the European Union for these infections.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7825683&quot;>Wikidata Q7825683</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>tedizolid</td></tr><tr><td>ATC codes:</td><td>J01XX11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB14569&quot;>DB14569</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/11234049&quot;>11234049</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:82717&quot;>82717</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7825683&quot;>Q7825683</a></td></tr><tr><td>formula:</td><td>C17H15FN6O3</td></tr><tr><td>molar mass:</td><td>370.344 g/mol (PubChem)</td></tr></table></body></html>"));
