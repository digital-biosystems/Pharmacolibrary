within Pharmacolibrary.Drugs.Substances;
package Cobicistat "cobicistat"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "cobicistat",
    atcCodes = {"V03AX03"},
    drugbankId = "DB09065",
    pubchemCid = "25151504",
    chebiId = "72291",
    wikidataId = "Q5138908",
    formula = "C40H53N7O5S2",
    M = 0.776028,
    logP = 5.7);
  annotation (Documentation(info = "<html><body><p>Cobicistat is an anti-HIV medicine used in the treatment of HIV infection, where it acts as a booster that inhibits the CYP3A enzyme to raise levels of other antiviral drugs. It is authorised in the European Union and is used in combination antiviral products for HIV.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5138908&quot;>Wikidata Q5138908</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>cobicistat</td></tr><tr><td>ATC codes:</td><td>V03AX03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09065&quot;>DB09065</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/25151504&quot;>25151504</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:72291&quot;>72291</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5138908&quot;>Q5138908</a></td></tr><tr><td>formula:</td><td>C40H53N7O5S2</td></tr><tr><td>molar mass:</td><td>776.028 g/mol (PubChem)</td></tr></table></body></html>"));
end Cobicistat;
