  annotation (Documentation(info = "<html><body><p>Sodium oxybate is used to treat narcolepsy, including cataplexy, and has also been studied for conditions such as fibromyalgia, hypersomnia, insomnia, and chronic fatigue syndrome. It is authorised in the European Union and approved elsewhere, but is a controlled medicine carrying a boxed warning, so its use is tightly regulated.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7553347&quot;>Wikidata Q7553347</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>sodium oxybate</td></tr><tr><td>ATC codes:</td><td>N01AX11, N07XX04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09072&quot;>DB09072</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/23663870&quot;>23663870</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7553347&quot;>Q7553347</a></td></tr><tr><td>formula:</td><td>C4H7NaO3</td></tr><tr><td>molar mass:</td><td>126.087 g/mol (PubChem)</td></tr></table></body></html>"));
end SodiumOxybate;
