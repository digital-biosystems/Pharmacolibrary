  annotation (Documentation(info = "<html><body><p>Isoconazole is an antifungal drug used topically to treat fungal skin infections and vaginal fungal infections. It is an approved medicine, used mainly as a topical dermatological and gynecological antiinfective.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q262210\">Wikidata Q262210</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>isoconazole</td></tr><tr><td>ATC codes:</td><td>D01AC05, G01AF07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08943\">DB08943</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3760\">3760</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:83667\">83667</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q262210\">Q262210</a></td></tr><tr><td>formula:</td><td>C18H14Cl4N2O</td></tr><tr><td>molar mass:</td><td>416.123 g/mol (PubChem CID 3760)</td></tr><tr><td>logP:</td><td>5.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Isoconazole;
