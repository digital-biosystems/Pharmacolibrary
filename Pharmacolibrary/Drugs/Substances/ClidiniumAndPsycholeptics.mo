  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "clidinium and psycholeptics",
    atcCodes = {"A03CA02"},
    drugbankId = "DB00771",
    pubchemCid = "2784",
    chebiId = "3743",
    wikidataId = "Q5132472",
