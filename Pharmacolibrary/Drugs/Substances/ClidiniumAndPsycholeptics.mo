    M = 0.352454,
    logP = -1.1);
  annotation (Documentation(info = "<html><body><p>Clidinium, combined with psycholeptics, is an anticholinergic (muscarinic antagonist) used to treat peptic ulcer disease and inflammatory bowel diseases. It is an approved drug, available as a combination antispasmodic with psycholeptics for functional gastrointestinal disorders.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5132472&quot;>Wikidata Q5132472</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>clidinium and psycholeptics</td></tr><tr><td>ATC codes:</td><td>A03CA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00771&quot;>DB00771</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2784&quot;>2784</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3743&quot;>3743</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5132472&quot;>Q5132472</a></td></tr><tr><td>formula:</td><td>C22H26NO3+</td></tr><tr><td>molar mass:</td><td>352.454 g/mol (PubChem)</td></tr></table></body></html>"));
end ClidiniumAndPsycholeptics;
