  annotation (Documentation(info = "<html><body><p>Chlorprothixene is a thioxanthene antipsychotic used to treat psychotic disorders such as schizophrenia. It remains an approved medicine and is used in some countries, though not authorised centrally in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q63395672\">Wikidata Q63395672</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>chlorprothixene</td></tr><tr><td>ATC codes:</td><td>N05AF03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01239\">DB01239</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/667466\">667466</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:50931\">50931</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q63395672\">Q63395672</a></td></tr><tr><td>formula:</td><td>C18H18ClNS</td></tr><tr><td>molar mass:</td><td>315.859 g/mol (PubChem CID 667466)</td></tr><tr><td>logP:</td><td>5.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
