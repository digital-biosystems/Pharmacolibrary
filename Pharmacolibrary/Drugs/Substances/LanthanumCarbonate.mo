  annotation (Documentation(info = "<html><body><p>Lanthanum carbonate is used to treat hyperphosphatemia in people with chronic renal insufficiency, binding phosphate in the gut. It is an approved medicine and is widely used for this purpose.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q421317&quot;>Wikidata Q421317</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>lanthanum carbonate</td></tr><tr><td>ATC codes:</td><td>V03AE03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06792&quot;>DB06792</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/168924&quot;>168924</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q421317&quot;>Q421317</a></td></tr><tr><td>formula:</td><td>C3La2O9</td></tr><tr><td>molar mass:</td><td>457.844 g/mol (PubChem)</td></tr></table></body></html>"));
