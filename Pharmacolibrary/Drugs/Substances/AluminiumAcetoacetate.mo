  annotation (Documentation(info = "<html><body><p>Aluminium acetoacetate is an aluminium compound that has been used as an antacid for acid-related digestive disorders. It is currently regarded as experimental, with no established marketing authorisation, so it does not appear to be in widespread clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q26979\">Wikidata Q26979</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>aluminium acetoacetate</td></tr><tr><td>ATC codes:</td><td>A02AB05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13280\">DB13280</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:138819\">138819</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q26979\">Q26979</a></td></tr><tr><td>formula:</td><td>C12H15AlO9</td></tr><tr><td>molar mass:</td><td>330.225 g/mol (knowledgebase (DrugBank calculated))</td></tr></table></body></html>"));
