  annotation (Documentation(info = "<html><body><p>Sulprostone is a prostaglandin uterotonic that has been studied for inducing abortion and menstruation. It remains an investigational drug and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q410556&quot;>Wikidata Q410556</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sulprostone</td></tr><tr><td>ATC codes:</td><td>G02AD05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12708&quot;>DB12708</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5312153&quot;>5312153</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135755&quot;>135755</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q410556&quot;>Q410556</a></td></tr><tr><td>formula:</td><td>C23H31NO7S</td></tr><tr><td>molar mass:</td><td>465.561 g/mol (PubChem)</td></tr></table></body></html>"));
