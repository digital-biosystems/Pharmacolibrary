  annotation (Documentation(info = "<html><body><p>Sulfanilamide is an antibiotic sulfonamide that was used to treat bacterial infections, including vulvovaginal candidiasis. It is no longer in general use, having been withdrawn, though it remains approved for topical dermatological use in some settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q423423\">Wikidata Q423423</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sulfanilamide</td></tr><tr><td>ATC codes:</td><td>D06BA05, J01EB06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00259\">DB00259</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5333\">5333</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:45373\">45373</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q423423\">Q423423</a></td></tr><tr><td>formula:</td><td>C6H8N2O2S</td></tr><tr><td>molar mass:</td><td>172.202 g/mol (PubChem CID 5333)</td></tr><tr><td>logP:</td><td>-0.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
