    logP = 2);
  annotation (Documentation(info = "<html><body><p>Naftazone is a capillary-stabilizing vasoprotective drug used as an antihemorrhagic agent to reduce bleeding from fragile capillaries. It is an approved medicine, but it is not widely used and does not appear to be authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q10335363&quot;>Wikidata Q10335363</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>naftazone</td></tr><tr><td>ATC codes:</td><td>C05CX02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13680&quot;>DB13680</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/71688&quot;>71688</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134890&quot;>134890</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q10335363&quot;>Q10335363</a></td></tr><tr><td>formula:</td><td>C11H9N3O2</td></tr><tr><td>molar mass:</td><td>215.212 g/mol (PubChem)</td></tr></table></body></html>"));
end Naftazone;
