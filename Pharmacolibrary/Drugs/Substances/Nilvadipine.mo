  annotation (Documentation(info = "<html><body><p>Nilvadipine is a calcium channel blocker used to treat high blood pressure (essential hypertension). It is an approved antihypertensive drug, though not authorised in the European Union, and has also been investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7037489\">Wikidata Q7037489</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nilvadipine</td></tr><tr><td>ATC codes:</td><td>C08CA10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06712\">DB06712</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4494\">4494</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31911\">31911</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7037489\">Q7037489</a></td></tr><tr><td>formula:</td><td>C19H19N3O6</td></tr><tr><td>molar mass:</td><td>385.376 g/mol (PubChem CID 4494)</td></tr><tr><td>logP:</td><td>2.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
