  annotation (Documentation(info = "<html><body><p>Oxyfedrine is a cardiotonic and vasodilator drug, a beta-adrenergic agonist that was used in cardiac diseases such as coronary insufficiency. It is currently considered experimental and does not appear to be an approved medicine today.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7115929&quot;>Wikidata Q7115929</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>oxyfedrine</td></tr><tr><td>ATC codes:</td><td>C01DX03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13398&quot;>DB13398</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5489013&quot;>5489013</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135343&quot;>135343</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7115929&quot;>Q7115929</a></td></tr><tr><td>formula:</td><td>C19H23NO3</td></tr><tr><td>molar mass:</td><td>313.397 g/mol (PubChem)</td></tr></table></body></html>"));
