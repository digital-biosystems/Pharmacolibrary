  annotation (Documentation(info = "<html><body><p>Gedocarnil is an anxiolytic drug, meaning it was developed to treat anxiety. It has only been studied experimentally and does not appear to be an approved medicine anywhere.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5529721&quot;>Wikidata Q5529721</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>gedocarnil</td></tr><tr><td>ATC codes:</td><td>N05BX02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13534&quot;>DB13534</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/219095&quot;>219095</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5529721&quot;>Q5529721</a></td></tr><tr><td>formula:</td><td>C23H21ClN2O4</td></tr><tr><td>molar mass:</td><td>424.881 g/mol (PubChem)</td></tr></table></body></html>"));
