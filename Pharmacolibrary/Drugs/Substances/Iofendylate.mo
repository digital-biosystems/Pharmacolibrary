  annotation (Documentation(info = "<html><body><p>Iofendylate is an iodinated, non-water-soluble X-ray contrast medium. It has approved status in DrugBank, but there is no European Union authorisation, so its current use appears limited.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q81976226&quot;>Wikidata Q81976226</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>iofendylate</td></tr><tr><td>ATC codes:</td><td>V08AD04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01187&quot;>DB01187</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/7458&quot;>7458</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q81976226&quot;>Q81976226</a></td></tr><tr><td>formula:</td><td>C19H29IO2</td></tr><tr><td>molar mass:</td><td>416.339 g/mol (PubChem)</td></tr></table></body></html>"));
end Iofendylate;
