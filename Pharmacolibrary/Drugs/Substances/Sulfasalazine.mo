  annotation (Documentation(info = "<html><body><p>Sulfasalazine is an intestinal anti-inflammatory drug used to treat ulcerative colitis and rheumatic conditions such as rheumatoid arthritis, including juvenile forms. It is an approved medicine and is included on the WHO list of essential medicines, so it remains in widespread use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q420035&quot;>Wikidata Q420035</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sulfasalazine</td></tr><tr><td>ATC codes:</td><td>A07EC01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00795&quot;>DB00795</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5359476&quot;>5359476</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9334&quot;>9334</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q420035&quot;>Q420035</a></td></tr><tr><td>formula:</td><td>C18H14N4O5S</td></tr><tr><td>molar mass:</td><td>398.393 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
