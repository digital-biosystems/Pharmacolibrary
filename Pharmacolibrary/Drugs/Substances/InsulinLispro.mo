within Pharmacolibrary.Drugs.Substances;
package InsulinLispro "insulin lispro"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "insulin lispro",
    atcCodes = {"A10AB04", "A10AB04;A10AD04", "A10AC04", "A10AD04"},
