  annotation (Documentation(info = "<html><body><p>Nepafenac is a non-steroidal anti-inflammatory eye drop used to treat pain and inflammation after eye surgery. It is an approved medicine, authorised in the European Union, and is used in ophthalmology.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q684379&quot;>Wikidata Q684379</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>nepafenac</td></tr><tr><td>ATC codes:</td><td>S01BC10</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06802&quot;>DB06802</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/151075&quot;>151075</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:75922&quot;>75922</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q684379&quot;>Q684379</a></td></tr><tr><td>formula:</td><td>C15H14N2O2</td></tr><tr><td>molar mass:</td><td>254.289 g/mol (PubChem)</td></tr></table></body></html>"));
