within Pharmacolibrary.Drugs.Substances;
package Methylscopolamine "methylscopolamine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "methylscopolamine",
    atcCodes = {"A03BB03", "S01FA03"},
    drugbankId = "DB11315",
    pubchemCid = "71183",
    chebiId = "135361",
    wikidataId = "Q27087955",
    formula = "C18H24NO4+",
    M = 0.318393,
    logP = 1.3);
  annotation (Documentation(info = "<html><body><p>Methylscopolamine is a semisynthetic belladonna alkaloid with parasympatholytic (anticholinergic) action, used for functional gastrointestinal disorders such as spasms, and as an ophthalmological anticholinergic mydriatic. It is an approved drug, but no European Union marketing authorisation is recorded, so it appears to be used only in some countries rather than widely.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27087955&quot;>Wikidata Q27087955</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>methylscopolamine</td></tr><tr><td>ATC codes:</td><td>A03BB03, S01FA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11315&quot;>DB11315</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/71183&quot;>71183</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135361&quot;>135361</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27087955&quot;>Q27087955</a></td></tr><tr><td>formula:</td><td>C18H24NO4+</td></tr><tr><td>molar mass:</td><td>318.393 g/mol (PubChem)</td></tr></table></body></html>"));
end Methylscopolamine;
