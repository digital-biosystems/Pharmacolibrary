  annotation (Documentation(info = "<html><body><p>Triamterene is a potassium-sparing diuretic used to treat high blood pressure, fluid buildup, and low potassium levels. It is an approved medicine, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q221520\">Wikidata Q221520</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>triamterene</td></tr><tr><td>ATC codes:</td><td>C03DB02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00384\">DB00384</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5546\">5546</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9671\">9671</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q221520\">Q221520</a></td></tr><tr><td>formula:</td><td>C12H11N7</td></tr><tr><td>molar mass:</td><td>253.269 g/mol (PubChem CID 5546)</td></tr><tr><td>logP:</td><td>1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
