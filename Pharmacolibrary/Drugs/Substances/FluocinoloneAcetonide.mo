within Pharmacolibrary.Drugs.Substances;
package FluocinoloneAcetonide "fluocinolone acetonide"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "fluocinolone acetonide",
    atcCodes = {"C05AA10", "D07AC04", "S01BA15", "S02BA08"},
    drugbankId = "DB00591",
    pubchemCid = "6215",
    chebiId = "31623",
    wikidataId = "Q924467",
    formula = "C24H30F2O6",
