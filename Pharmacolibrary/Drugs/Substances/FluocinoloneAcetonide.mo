    logP = 2.5);
  annotation (Documentation(info = "<html><body><p>Fluocinolone acetonide is a potent corticosteroid used to reduce inflammation and itching, mainly in skin conditions, and also in preparations for haemorrhoids, eye and ear inflammation. It is an approved medicine, used in topical dermatological, rectal, ophthalmic and otological products, and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q924467\">Wikidata Q924467</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>fluocinolone acetonide</td></tr><tr><td>ATC codes:</td><td>C05AA10, D07AC04, S01BA15, S02BA08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00591\">DB00591</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6215\">6215</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31623\">31623</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q924467\">Q924467</a></td></tr><tr><td>formula:</td><td>C24H30F2O6</td></tr><tr><td>molar mass:</td><td>452.494 g/mol (PubChem CID 6215)</td></tr><tr><td>logP:</td><td>2.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end FluocinoloneAcetonide;
