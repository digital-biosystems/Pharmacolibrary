  annotation (Documentation(info = "<html><body><p>Norethisterone is a progestogen used in hormonal contraceptives, alone or combined with an estrogen, and in other progestogen–estrogen preparations. It is an approved medicine and appears on the WHO essential medicines list, so it is widely used worldwide.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q17004476&quot;>Wikidata Q17004476</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>norethisterone</td></tr><tr><td>ATC codes:</td><td>G03AC01, G03DC02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00717&quot;>DB00717</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6230&quot;>6230</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q17004476&quot;>Q17004476</a></td></tr><tr><td>formula:</td><td>C20H26O2</td></tr><tr><td>molar mass:</td><td>298.426 g/mol (PubChem)</td></tr></table></body></html>"));
end Norethisterone;
