within Pharmacolibrary.Drugs.Substances;
package Norethisterone "norethisterone"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "norethisterone",
    atcCodes = {"G03AC01", "G03DC02"},
    drugbankId = "DB00717",
    pubchemCid = "6230",
    wikidataId = "Q421352",
    formula = "C20H26O2",
    M = 0.298426,
    logP = 3);
  annotation (Documentation(info = "<html><body><p>Norethisterone is a synthetic progestogen used in hormonal contraception and for conditions such as endometriosis, endometrial hyperplasia, acne, and hypogonadism. It is widely used, appearing in many combined and progestogen-only contraceptive preparations, and is also approved for other investigational uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q421352\">Wikidata Q421352</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>norethisterone</td></tr><tr><td>ATC codes:</td><td>G03AC01, G03DC02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00717\">DB00717</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6230\">6230</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q421352\">Q421352</a></td></tr><tr><td>formula:</td><td>C20H26O2</td></tr><tr><td>molar mass:</td><td>298.426 g/mol (PubChem CID 6230)</td></tr><tr><td>logP:</td><td>3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Norethisterone;
