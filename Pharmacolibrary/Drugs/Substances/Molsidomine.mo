  annotation (Documentation(info = "<html><body><p>Molsidomine is a vasodilator drug that was used to treat heart conditions such as angina. It was once approved but has been withdrawn from use in many places, and is no longer authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q408132\">Wikidata Q408132</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>molsidomine</td></tr><tr><td>ATC codes:</td><td>C01DX12</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09282\">DB09282</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5353788\">5353788</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31861\">31861</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q408132\">Q408132</a></td></tr><tr><td>formula:</td><td>C9H14N4O4</td></tr><tr><td>molar mass:</td><td>242.235 g/mol (PubChem CID 5353788)</td></tr><tr><td>logP:</td><td>2.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
