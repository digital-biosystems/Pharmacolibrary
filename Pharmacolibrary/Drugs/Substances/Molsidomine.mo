  annotation (Documentation(info = "<html><body><p>Molsidomine is a vasodilator that was used to treat heart conditions such as angina. It was approved at one time but has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q106041750&quot;>Wikidata Q106041750</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>molsidomine</td></tr><tr><td>ATC codes:</td><td>C01DX12</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09282&quot;>DB09282</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5353788&quot;>5353788</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31861&quot;>31861</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q106041750&quot;>Q106041750</a></td></tr><tr><td>formula:</td><td>C9H14N4O4</td></tr><tr><td>molar mass:</td><td>242.235 g/mol (PubChem)</td></tr></table></body></html>"));
