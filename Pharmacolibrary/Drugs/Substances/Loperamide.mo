    logP = 5);
  annotation (Documentation(info = "<html><body><p>Loperamide is an antidiarrhoeal medicine used to treat diarrhoea, including in conditions such as shigellosis and irritable bowel syndrome. It is widely used and appears on the WHO list of essential medicines, and is also being investigated for other uses such as managing withdrawal symptoms.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q423751&quot;>Wikidata Q423751</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>loperamide</td></tr><tr><td>ATC codes:</td><td>A07DA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00836&quot;>DB00836</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3955&quot;>3955</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6532&quot;>6532</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q423751&quot;>Q423751</a></td></tr><tr><td>formula:</td><td>C29H33ClN2O2</td></tr><tr><td>molar mass:</td><td>477.045 g/mol (PubChem)</td></tr></table></body></html>"));
end Loperamide;
