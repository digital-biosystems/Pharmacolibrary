  annotation (Documentation(info = "<html><body><p>Tenidap is a non-steroidal anti-inflammatory and antirheumatic drug that was developed for inflammatory conditions such as arthritis. It is not an approved medicine today and remains only an experimental compound, with no authorisation in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q114811218&quot;>Wikidata Q114811218</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tenidap</td></tr><tr><td>ATC codes:</td><td>M01AX23</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13481&quot;>DB13481</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/60712&quot;>60712</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:35847&quot;>35847</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q114811218&quot;>Q114811218</a></td></tr><tr><td>formula:</td><td>C14H9ClN2O3S</td></tr><tr><td>molar mass:</td><td>320.747 g/mol (PubChem)</td></tr></table></body></html>"));
