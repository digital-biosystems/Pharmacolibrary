  annotation (Documentation(info = "<html><body><p>Tenidap is a non-steroidal anti-inflammatory drug that was developed to treat inflammatory and rheumatic conditions. It is currently listed only as an experimental compound and does not appear to be an approved medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7699849\">Wikidata Q7699849</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tenidap</td></tr><tr><td>ATC codes:</td><td>M01AX23</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13481\">DB13481</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/60712\">60712</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:35847\">35847</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7699849\">Q7699849</a></td></tr><tr><td>formula:</td><td>C14H9ClN2O3S</td></tr><tr><td>molar mass:</td><td>320.747 g/mol (PubChem CID 60712)</td></tr><tr><td>logP:</td><td>3.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
