  annotation (Documentation(info = "<html><body><p>Deptropine is an antihistamine (H1 antagonist) for systemic use, used for allergic and respiratory conditions. It is considered experimental and does not appear to be an approved medicine today.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5260984\">Wikidata Q5260984</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>deptropine</td></tr><tr><td>ATC codes:</td><td>R06AX16</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13466\">DB13466</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/203911\">203911</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:50189\">50189</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5260984\">Q5260984</a></td></tr><tr><td>formula:</td><td>C23H27NO</td></tr><tr><td>molar mass:</td><td>333.475 g/mol (PubChem CID 203911)</td></tr><tr><td>logP:</td><td>4.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
