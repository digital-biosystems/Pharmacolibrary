  annotation (Documentation(info = "<html><body><p>Lamotrigine is an anticonvulsant used to treat epilepsy and bipolar disorder, and has also been used for other neurological and psychiatric conditions. It is widely used and is included on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q410346&quot;>Wikidata Q410346</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>lamotrigine</td></tr><tr><td>ATC codes:</td><td>N03AX09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00555&quot;>DB00555</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3878&quot;>3878</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6367&quot;>6367</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q410346&quot;>Q410346</a></td></tr><tr><td>formula:</td><td>C9H7Cl2N5</td></tr><tr><td>molar mass:</td><td>256.09 g/mol (PubChem)</td></tr></table></body></html>"));
