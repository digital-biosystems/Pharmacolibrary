within Pharmacolibrary.Drugs.Substances;
package Trifluridine "trifluridine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "trifluridine",
    atcCodes = {"S01AD02"},
    drugbankId = "DB00432",
    pubchemCid = "6256",
    wikidataId = "Q2359590",
    formula = "C10H11F3N2O5",
    M = 0.296201,
    logP = -0.5);
  annotation (Documentation(info = "<html><body><p>Trifluridine is an antiviral eye medicine used to treat herpes simplex keratitis, an eye infection caused by the herpes simplex virus. It is an approved drug used mainly as an ophthalmological antiviral, and it is also being investigated as an anticancer treatment for colorectal and related cancers.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2359590&quot;>Wikidata Q2359590</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>trifluridine</td></tr><tr><td>ATC codes:</td><td>S01AD02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00432&quot;>DB00432</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6256&quot;>6256</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2359590&quot;>Q2359590</a></td></tr><tr><td>formula:</td><td>C10H11F3N2O5</td></tr><tr><td>molar mass:</td><td>296.201 g/mol (PubChem)</td></tr></table></body></html>"));
end Trifluridine;
