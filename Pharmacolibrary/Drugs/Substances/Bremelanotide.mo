  annotation (Documentation(info = "<html><body><p>Bremelanotide is a medicine used to treat low sexual desire in premenopausal women (hypoactive sexual desire disorder). It is an approved drug, used mainly in the United States, where it is given as an injection before anticipated sexual activity.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q415353\">Wikidata Q415353</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bremelanotide</td></tr><tr><td>ATC codes:</td><td>G02CX05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11653\">DB11653</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9941379\">9941379</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:177849\">177849</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q415353\">Q415353</a></td></tr><tr><td>molar mass:</td><td>1025.2 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>0.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
