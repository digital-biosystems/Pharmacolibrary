  annotation (Documentation(info = "<html><body><p>Resorcinol is a topical agent used to treat acne, and is also classified as an ophthalmological antiinfective. It remains an approved drug, used mainly in topical skin preparations.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q408865&quot;>Wikidata Q408865</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>resorcinol</td></tr><tr><td>ATC codes:</td><td>D10AX02, S01AX06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11085&quot;>DB11085</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5054&quot;>5054</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:27810&quot;>27810</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q408865&quot;>Q408865</a></td></tr><tr><td>formula:</td><td>C6H6O2</td></tr><tr><td>molar mass:</td><td>110.112 g/mol (PubChem)</td></tr></table></body></html>"));
