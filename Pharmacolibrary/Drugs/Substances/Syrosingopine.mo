    M = 0.666724);
  annotation (Documentation(info = "<html><body><p>Syrosingopine is a Rauwolfia alkaloid that was used to lower blood pressure in people with hypertension, typically combined with a diuretic. It has been withdrawn and is no longer in clinical use.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Syrosingopine</td></tr><tr><td>ATC codes:</td><td>C02LA09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB19379&quot;>DB19379</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6769&quot;>6769</a></td></tr><tr><td>formula:</td><td>C35H42N2O11</td></tr><tr><td>molar mass:</td><td>666.724 g/mol (PubChem)</td></tr></table></body></html>"));
end Syrosingopine;
