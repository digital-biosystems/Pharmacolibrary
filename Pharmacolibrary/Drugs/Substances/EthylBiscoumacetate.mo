  annotation (Documentation(info = "<html><body><p>Ethyl biscoumacetate is a vitamin K antagonist anticoagulant that was used to prevent blood clots. It has been withdrawn and is no longer in clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q426269&quot;>Wikidata Q426269</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ethyl biscoumacetate</td></tr><tr><td>ATC codes:</td><td>B01AA08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08794&quot;>DB08794</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/54685524&quot;>54685524</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135659&quot;>135659</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q426269&quot;>Q426269</a></td></tr><tr><td>formula:</td><td>C22H16O8</td></tr><tr><td>molar mass:</td><td>408.362 g/mol (PubChem)</td></tr></table></body></html>"));
