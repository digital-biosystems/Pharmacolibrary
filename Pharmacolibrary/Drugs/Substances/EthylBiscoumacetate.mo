  annotation (Documentation(info = "<html><body><p>Ethyl biscoumacetate is a vitamin K antagonist that was used as an anticoagulant to prevent or treat blood clots. It is no longer used, as it was withdrawn from the market.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q106042078\">Wikidata Q106042078</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ethyl biscoumacetate</td></tr><tr><td>ATC codes:</td><td>B01AA08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08794\">DB08794</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/54685524\">54685524</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135659\">135659</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q106042078\">Q106042078</a></td></tr><tr><td>formula:</td><td>C22H16O8</td></tr><tr><td>molar mass:</td><td>408.362 g/mol (PubChem CID 54685524)</td></tr><tr><td>logP:</td><td>2.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end EthylBiscoumacetate;
