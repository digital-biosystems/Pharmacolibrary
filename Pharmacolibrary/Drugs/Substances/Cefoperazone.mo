  annotation (Documentation(info = "<html><body><p>Cefoperazone is a third-generation cephalosporin antibiotic used to treat bacterial infections, including urinary, respiratory, and Pseudomonas infections. It has been withdrawn from the market in many places and is no longer widely available.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2325775\">Wikidata Q2325775</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cefoperazone</td></tr><tr><td>ATC codes:</td><td>J01DD12</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01329\">DB01329</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/44185\">44185</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3493\">3493</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2325775\">Q2325775</a></td></tr><tr><td>formula:</td><td>C25H27N9O8S2</td></tr><tr><td>molar mass:</td><td>645.666 g/mol (PubChem CID 44185)</td></tr><tr><td>logP:</td><td>-0.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
