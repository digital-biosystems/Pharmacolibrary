within Pharmacolibrary.Drugs.Substances;
package Zinc "zinc"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "zinc",
    atcCodes = {"A12CB01", "A16AX05", "B05XA18", "C05AX04"},
    drugbankId = "DB01593",
    pubchemCid = "23994",
    wikidataId = "Q204639",
    formula = "Zn",
    M = 0.06538,
    logP = 0);
  annotation (Documentation(info = "<html><body><p>Zinc is a mineral used as a dietary supplement and, as zinc acetate, for treating the inherited copper-overload disorder hepatolenticular degeneration (Wilson's disease). It is widely used as a supplement, and a zinc acetate product is authorised in the European Union for Wilson's disease.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q204639&quot;>Wikidata Q204639</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>zinc</td></tr><tr><td>ATC codes:</td><td>A12CB01, A16AX05, B05XA18, C05AX04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01593&quot;>DB01593</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/23994&quot;>23994</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q204639&quot;>Q204639</a></td></tr><tr><td>formula:</td><td>Zn</td></tr><tr><td>molar mass:</td><td>65.38 g/mol (PubChem)</td></tr></table></body></html>"));
end Zinc;
