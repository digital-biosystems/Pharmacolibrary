within Pharmacolibrary.Drugs.Substances;
package Viltolarsen "viltolarsen"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "viltolarsen",
    atcCodes = {"M09AX12"},
    drugbankId = "DB15005",
    wikidataId = "Q98523702");
  annotation (Documentation(info = "<html><body><p>Viltolarsen is an antisense oligonucleotide medication used for disorders of the musculo-skeletal system. It is approved for use in some countries, though not authorised in the European Union, and remains partly investigational.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q98523702\">Wikidata Q98523702</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>viltolarsen</td></tr><tr><td>ATC codes:</td><td>M09AX12</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB15005\">DB15005</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q98523702\">Q98523702</a></td></tr></table></body></html>"));
end Viltolarsen;
