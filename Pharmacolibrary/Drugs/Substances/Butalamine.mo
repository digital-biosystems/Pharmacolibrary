  annotation (Documentation(info = "<html><body><p>Butalamine is a vasodilator drug classified as a peripheral vasodilator, used for circulatory conditions involving poor blood flow. It appears to be no longer in routine clinical use and is considered experimental, with no current marketing authorisation in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5002340\">Wikidata Q5002340</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>butalamine</td></tr><tr><td>ATC codes:</td><td>C04AX23</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13681\">DB13681</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/30949\">30949</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135354\">135354</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5002340\">Q5002340</a></td></tr><tr><td>formula:</td><td>C18H28N4O</td></tr><tr><td>molar mass:</td><td>316.449 g/mol (PubChem CID 30949)</td></tr><tr><td>logP:</td><td>4.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
