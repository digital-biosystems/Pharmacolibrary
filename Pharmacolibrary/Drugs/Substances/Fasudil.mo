  annotation (Documentation(info = "<html><body><p>Fasudil is a vasodilator and protein kinase inhibitor that has been investigated for treating cardiovascular conditions involving poor blood flow. It is considered investigational and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5437132\">Wikidata Q5437132</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>fasudil</td></tr><tr><td>ATC codes:</td><td>C04AX32</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08162\">DB08162</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3547\">3547</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5437132\">Q5437132</a></td></tr><tr><td>formula:</td><td>C14H17N3O2S</td></tr><tr><td>molar mass:</td><td>291.369 g/mol (PubChem CID 3547)</td></tr><tr><td>logP:</td><td>1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
