  annotation (Documentation(info = "<html><body><p>Phenylmercuric nitrate is an organomercury compound with strong antiseptic and antifungal activity, and it has been classified for use in medicated dressings with antiinfectives. It is currently regarded as an experimental substance rather than an established marketed medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1861514\">Wikidata Q1861514</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>phenylmercuric nitrate</td></tr><tr><td>ATC codes:</td><td>D09AA04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13388\">DB13388</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:136021\">136021</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1861514\">Q1861514</a></td></tr><tr><td>formula:</td><td>C6H5HgNO3</td></tr><tr><td>molar mass:</td><td>339.7 g/mol (knowledgebase (DrugBank calculated))</td></tr></table></body></html>"));
end PhenylmercuricNitrate;
