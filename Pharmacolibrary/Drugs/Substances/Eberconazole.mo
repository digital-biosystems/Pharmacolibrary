  annotation (Documentation(info = "<html><body><p>Eberconazole is a topical antifungal drug of the imidazole/triazole class, investigated for treating fungal skin infections. It is not an approved medicine and remains investigational, with no authorisation in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27156976&quot;>Wikidata Q27156976</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>eberconazole</td></tr><tr><td>ATC codes:</td><td>D01AC17</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13656&quot;>DB13656</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/72051&quot;>72051</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:83584&quot;>83584</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27156976&quot;>Q27156976</a></td></tr><tr><td>formula:</td><td>C18H14Cl2N2</td></tr><tr><td>molar mass:</td><td>329.224 g/mol (PubChem)</td></tr></table></body></html>"));
