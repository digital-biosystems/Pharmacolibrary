within Pharmacolibrary.Drugs.Substances;
package Clofibrate "clofibrate"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "clofibrate",
    atcCodes = {"C10AB01"},
    drugbankId = "DB00636",
    pubchemCid = "2796",
    chebiId = "3750",
    wikidataId = "Q2701912",
    formula = "C12H15ClO3",
    M = 0.242699,
    logP = 3.3);
  annotation (Documentation(info = "<html><body><p>Clofibrate is a fibrate lipid-lowering drug that was used to treat high blood lipid levels such as hypertriglyceridemia and familial hyperlipidemia, as well as related conditions like arteriosclerosis and coronary artery disease. It has been withdrawn from the market, largely because of concerns about lack of benefit and safety issues including cancer-causing potential.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2701912&quot;>Wikidata Q2701912</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>clofibrate</td></tr><tr><td>ATC codes:</td><td>C10AB01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00636&quot;>DB00636</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2796&quot;>2796</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3750&quot;>3750</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2701912&quot;>Q2701912</a></td></tr><tr><td>formula:</td><td>C12H15ClO3</td></tr><tr><td>molar mass:</td><td>242.699 g/mol (PubChem)</td></tr></table></body></html>"));
end Clofibrate;
