  annotation (Documentation(info = "<html><body><p>Fremanezumab is a monoclonal antibody used to prevent migraine, including migraine with and without aura. It is an approved CGRP-antagonist medicine authorised in the European Union for migraine prevention.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q39048381\">Wikidata Q39048381</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>fremanezumab</td></tr><tr><td>ATC codes:</td><td>N02CD03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB14041\">DB14041</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q39048381\">Q39048381</a></td></tr><tr><td>molar mass:</td><td>148000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Fremanezumab;
