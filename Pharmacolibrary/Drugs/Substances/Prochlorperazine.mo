    logP = 4.9);
  annotation (Documentation(info = "<html><body><p>Prochlorperazine is a phenothiazine antipsychotic and antiemetic used for conditions such as schizophrenia, anxiety, vomiting, and dementia-related symptoms. It is an approved medicine, also approved for veterinary use, though it carries a boxed warning and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2359690\">Wikidata Q2359690</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>prochlorperazine</td></tr><tr><td>ATC codes:</td><td>N05AB04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00433\">DB00433</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4917\">4917</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8435\">8435</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2359690\">Q2359690</a></td></tr><tr><td>formula:</td><td>C20H24ClN3S</td></tr><tr><td>molar mass:</td><td>373.943 g/mol (PubChem CID 4917)</td></tr><tr><td>logP:</td><td>4.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Prochlorperazine;
