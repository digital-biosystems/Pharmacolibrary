  annotation (Documentation(info = "<html><body><p>Niclosamide is an anticestodal drug used to treat tapeworm infections (parasitic helminthiasis). It is an approved human and veterinary medicine, and is also being investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q418523\">Wikidata Q418523</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>niclosamide</td></tr><tr><td>ATC codes:</td><td>P02DA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06803\">DB06803</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4477\">4477</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7553\">7553</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q418523\">Q418523</a></td></tr><tr><td>formula:</td><td>C13H8Cl2N2O4</td></tr><tr><td>molar mass:</td><td>327.117 g/mol (PubChem CID 4477)</td></tr><tr><td>logP:</td><td>4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
