    logP = 3.8);
  annotation (Documentation(info = "<html><body><p>Tiotixene (thiothixene) is a thioxanthene antipsychotic used to treat schizophrenia and schizophreniform disorder. It is an approved antipsychotic, though it does not appear to have centralised European Union authorisation and is not among the most widely used antipsychotics.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2608288\">Wikidata Q2608288</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tiotixene</td></tr><tr><td>ATC codes:</td><td>N05AF04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01623\">DB01623</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/941651\">941651</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9571\">9571</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2608288\">Q2608288</a></td></tr><tr><td>formula:</td><td>C23H29N3O2S2</td></tr><tr><td>molar mass:</td><td>443.624 g/mol (PubChem CID 941651)</td></tr><tr><td>logP:</td><td>3.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Tiotixene;
