  annotation (Documentation(info = "<html><body><p>Hymecromone is a coumarin compound used as a bile-therapy drug for biliary and liver-related conditions. It is not authorised in the European Union and is currently considered investigational.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q904431&quot;>Wikidata Q904431</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>hymecromone</td></tr><tr><td>ATC codes:</td><td>A05AX02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB07118&quot;>DB07118</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5280567&quot;>5280567</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:17224&quot;>17224</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q904431&quot;>Q904431</a></td></tr><tr><td>formula:</td><td>C10H8O3</td></tr><tr><td>molar mass:</td><td>176.171 g/mol (PubChem)</td></tr></table></body></html>"));
