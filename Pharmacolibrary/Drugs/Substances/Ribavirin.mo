within Pharmacolibrary.Drugs.Substances;
package Ribavirin "ribavirin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "ribavirin",
    atcCodes = {"J05AB04", "J05AP01"},
    drugbankId = "DB00811",
    pubchemCid = "37542",
    chebiId = "63580",
    wikidataId = "Q421862",
    formula = "C8H12N4O5",
    M = 0.244207,
    logP = -1.8);
  annotation (Documentation(info = "<html><body><p>Ribavirin is an antiviral nucleoside analogue used against viral infections such as hepatitis C, hepatitis E, and respiratory syncytial virus infection. It is included on the WHO essential medicines list and remains in use, though several European marketing authorisations have been withdrawn or lapsed; it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q421862\">Wikidata Q421862</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>ribavirin</td></tr><tr><td>ATC codes:</td><td>J05AB04, J05AP01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00811\">DB00811</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/37542\">37542</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:63580\">63580</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q421862\">Q421862</a></td></tr><tr><td>formula:</td><td>C8H12N4O5</td></tr><tr><td>molar mass:</td><td>244.207 g/mol (PubChem CID 37542)</td></tr><tr><td>logP:</td><td>-1.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Ribavirin;
