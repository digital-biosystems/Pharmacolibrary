  annotation (Documentation(info = "<html><body><p>Vitamin A (retinol) is an essential nutrient used to treat or prevent vitamin A deficiency, and it also serves as a test for fat absorption. It is widely used in human medicine and is included on the WHO list of essential medicines; it is also approved in veterinary use and available as a supplement.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q424976&quot;>Wikidata Q424976</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Vitamin A</td></tr><tr><td>ATC codes:</td><td>V04CB01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00162&quot;>DB00162</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/445354&quot;>445354</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:17336&quot;>17336</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q424976&quot;>Q424976</a></td></tr><tr><td>formula:</td><td>C20H30O</td></tr><tr><td>molar mass:</td><td>286.459 g/mol (PubChem)</td></tr></table></body></html>"));
end VitaminA;
