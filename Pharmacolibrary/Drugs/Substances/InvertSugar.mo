    logP = 0);
  annotation (Documentation(info = "<html><body><p>Invert sugar, a mixture of glucose and fructose made from sucrose, has been classified as a sclerosing agent for local injection in the treatment of varicose veins. It is better known as an edible sweetener, but as a medicine it remains experimental and is not an established treatment.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q412082&quot;>Wikidata Q412082</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>invert sugar</td></tr><tr><td>ATC codes:</td><td>C05BB03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09344&quot;>DB09344</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q412082&quot;>Q412082</a></td></tr><tr><td>molar mass:</td><td>360.31 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end InvertSugar;
