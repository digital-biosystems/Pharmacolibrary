    logP = 2.6);
  annotation (Documentation(info = "<html><body><p>Dicoumarol is an anticoagulant of the vitamin K antagonist class, historically used to treat and prevent blood clots such as pulmonary embolism. It is an approved drug, though it has largely been replaced by newer anticoagulants and is now rarely used in practice.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q420886&quot;>Wikidata Q420886</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dicoumarol</td></tr><tr><td>ATC codes:</td><td>B01AA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00266&quot;>DB00266</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/54676038&quot;>54676038</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4513&quot;>4513</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q420886&quot;>Q420886</a></td></tr><tr><td>formula:</td><td>C19H12O6</td></tr><tr><td>molar mass:</td><td>336.299 g/mol (PubChem)</td></tr></table></body></html>"));
end Dicoumarol;
