within Pharmacolibrary.Drugs.Substances;
package Apixaban "apixaban"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "apixaban",
    atcCodes = {"B01AF02"},
    drugbankId = "DB06605",
    pubchemCid = "10182969",
    chebiId = "72296",
    wikidataId = "Q414462",
    formula = "C25H25N5O4",
    M = 0.459506,
    logP = 2.2);
  annotation (Documentation(info = "<html><body><p>Apixaban is an anticoagulant that blocks factor Xa and is used to prevent or treat blood clots, including venous thromboembolism, pulmonary embolism, thrombosis, stroke, and clot risk in atrial fibrillation or flutter and heart disease. It is an approved medicine, authorised in the European Union, and widely used for these conditions.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q414462\">Wikidata Q414462</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>apixaban</td></tr><tr><td>ATC codes:</td><td>B01AF02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06605\">DB06605</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/10182969\">10182969</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:72296\">72296</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q414462\">Q414462</a></td></tr><tr><td>formula:</td><td>C25H25N5O4</td></tr><tr><td>molar mass:</td><td>459.506 g/mol (PubChem CID 10182969)</td></tr><tr><td>logP:</td><td>2.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Apixaban;
