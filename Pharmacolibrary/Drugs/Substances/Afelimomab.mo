within Pharmacolibrary.Drugs.Substances;
package Afelimomab "afelimomab"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "afelimomab",
    atcCodes = {"L04AB03"},
    drugbankId = "DB04956",
    wikidataId = "Q3606143");
  annotation (Documentation(info = "<html><body><p>Afelimomab is a monoclonal antibody that blocks tumor necrosis factor alpha and was investigated as a treatment for severe infection with widespread inflammation (sepsis). It remains experimental and was never approved for routine medical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3606143&quot;>Wikidata Q3606143</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>afelimomab</td></tr><tr><td>ATC codes:</td><td>L04AB03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB04956&quot;>DB04956</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3606143&quot;>Q3606143</a></td></tr></table></body></html>"));
end Afelimomab;
