  annotation (Documentation(info = "<html><body><p>Boric acid is an antiseptic used against infections, including ear infections. It remains in use as an approved medicine, mainly in ear-drop preparations for the ear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q72451064\">Wikidata Q72451064</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>boric acid</td></tr><tr><td>ATC codes:</td><td>S02AA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11326\">DB11326</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/7628\">7628</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:33118\">33118</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q72451064\">Q72451064</a></td></tr><tr><td>formula:</td><td>BH3O3</td></tr><tr><td>molar mass:</td><td>61.831 g/mol (PubChem CID 7628)</td></tr></table></body></html>"));
