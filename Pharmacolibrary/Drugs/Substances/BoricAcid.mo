  annotation (Documentation(info = "<html><body><p>Boric acid is a mild antiseptic used, among other things, to treat ear infections. It remains an approved medicine and is also being studied for other uses, though it is not an EMA-authorised product.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q187045&quot;>Wikidata Q187045</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>boric acid</td></tr><tr><td>ATC codes:</td><td>S02AA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11326&quot;>DB11326</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/7628&quot;>7628</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:33118&quot;>33118</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q187045&quot;>Q187045</a></td></tr><tr><td>formula:</td><td>BH3O3</td></tr><tr><td>molar mass:</td><td>61.831 g/mol (PubChem)</td></tr></table></body></html>"));
