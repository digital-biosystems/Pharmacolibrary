  annotation (Documentation(info = "<html><body><p>Potassium acetate is used to treat low potassium levels in the blood (hypokalemia). It is an approved intravenous electrolyte solution additive, used in clinical settings to replenish potassium.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q409199&quot;>Wikidata Q409199</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>potassium acetate</td></tr><tr><td>ATC codes:</td><td>B05XA17</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB14498&quot;>DB14498</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32029&quot;>32029</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q409199&quot;>Q409199</a></td></tr><tr><td>formula:</td><td>C2H3KO2</td></tr><tr><td>molar mass:</td><td>98.1423 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end PotassiumAcetate;
