  annotation (Documentation(info = "<html><body><p>Vildagliptin is a DPP-4 inhibitor used to lower blood glucose in adults with type 2 diabetes. It is authorised in the European Union and widely used as an oral diabetes medicine, often in combination products.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q421042&quot;>Wikidata Q421042</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>vildagliptin</td></tr><tr><td>ATC codes:</td><td>A10BH02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB04876&quot;>DB04876</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6918537&quot;>6918537</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135285&quot;>135285</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q421042&quot;>Q421042</a></td></tr><tr><td>formula:</td><td>C17H25N3O2</td></tr><tr><td>molar mass:</td><td>303.406 g/mol (PubChem)</td></tr></table></body></html>"));
