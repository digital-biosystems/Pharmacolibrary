  annotation (Documentation(info = "<html><body><p>Mercuric amidochloride is a mercurial antiseptic that was used on the skin to treat infections. It is now considered an experimental compound and is not in routine medical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q415897\">Wikidata Q415897</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mercuric amidochloride</td></tr><tr><td>ATC codes:</td><td>D08AK01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13344\">DB13344</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134744\">134744</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q415897\">Q415897</a></td></tr><tr><td>formula:</td><td>ClH2HgN</td></tr><tr><td>molar mass:</td><td>252.06 g/mol (knowledgebase (DrugBank calculated))</td></tr></table></body></html>"));
