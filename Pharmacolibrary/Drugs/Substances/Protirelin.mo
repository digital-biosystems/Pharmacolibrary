  annotation (Documentation(info = "<html><body><p>Protirelin (thyrotropin-releasing hormone) is a diagnostic agent used in tests of thyroid function. It is an approved drug, though not authorised centrally in the European Union, and is used only in specialised diagnostic settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q12910980\">Wikidata Q12910980</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>protirelin</td></tr><tr><td>ATC codes:</td><td>V04CJ02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09421\">DB09421</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/638678\">638678</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:35940\">35940</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q12910980\">Q12910980</a></td></tr><tr><td>formula:</td><td>C16H22N6O4</td></tr><tr><td>molar mass:</td><td>362.39 g/mol (PubChem CID 638678)</td></tr><tr><td>logP:</td><td>-2.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
