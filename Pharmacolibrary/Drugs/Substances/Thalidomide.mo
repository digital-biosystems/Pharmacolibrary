within Pharmacolibrary.Drugs.Substances;
package Thalidomide "thalidomide"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "thalidomide",
    atcCodes = {"L04AX02"},
    drugbankId = "DB01041",
    pubchemCid = "5426",
    chebiId = "74947",
    wikidataId = "Q203174",
    formula = "C13H10N2O4",
    M = 0.258233,
    logP = 0.3);
  annotation (Documentation(info = "<html><body><p>Thalidomide is an immunomodulatory drug used for conditions such as multiple myeloma and leprosy, among several other immune and blood disorders. It remains authorised in the European Union for multiple myeloma, but its use is tightly controlled because it causes severe birth defects, and it was famously withdrawn from use as a sedative for this reason.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q203174\">Wikidata Q203174</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>thalidomide</td></tr><tr><td>ATC codes:</td><td>L04AX02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01041\">DB01041</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5426\">5426</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:74947\">74947</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q203174\">Q203174</a></td></tr><tr><td>formula:</td><td>C13H10N2O4</td></tr><tr><td>molar mass:</td><td>258.233 g/mol (PubChem CID 5426)</td></tr><tr><td>logP:</td><td>0.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Thalidomide;
