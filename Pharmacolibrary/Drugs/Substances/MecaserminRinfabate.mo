within Pharmacolibrary.Drugs.Substances;
package MecaserminRinfabate "mecasermin rinfabate"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "mecasermin rinfabate",
    atcCodes = {"H01AC05"},
    drugbankId = "DB14751",
    wikidataId = "Q6804391");
  annotation (Documentation(info = "<html><body><p>Mecasermin rinfabate, a combination of insulin-like growth factor-I and its binding protein, was developed as a growth-related treatment for pituitary dwarfism. Its marketing application in the European Union was withdrawn, and it remains listed as approved and investigational elsewhere.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6804391\">Wikidata Q6804391</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>mecasermin rinfabate</td></tr><tr><td>ATC codes:</td><td>H01AC05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB14751\">DB14751</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6804391\">Q6804391</a></td></tr></table></body></html>"));
end MecaserminRinfabate;
