  annotation (Documentation(info = "<html><body><p>Aluminium glycinate is an aluminium-based antacid used for acid-related disorders of the stomach. It is not an approved medicine today and is considered investigational, so it is not in widespread clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q72437511\">Wikidata Q72437511</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>aluminium glycinate</td></tr><tr><td>ATC codes:</td><td>A02AB07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13626\">DB13626</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q72437511\">Q72437511</a></td></tr><tr><td>formula:</td><td>C2H8AlNO5</td></tr><tr><td>molar mass:</td><td>153.07 g/mol (knowledgebase (DrugBank calculated))</td></tr></table></body></html>"));
end AluminiumGlycinate;
