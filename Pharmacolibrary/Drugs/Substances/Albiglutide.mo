  annotation (Documentation(info = "<html><body><p>Albiglutide is a GLP-1 analogue blood glucose lowering drug that was used to treat type 2 diabetes. It is no longer used: its European marketing authorisation has been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4712362&quot;>Wikidata Q4712362</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>albiglutide</td></tr><tr><td>ATC codes:</td><td>A10BJ04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09043&quot;>DB09043</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/122173812&quot;>122173812</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4712362&quot;>Q4712362</a></td></tr><tr><td>formula:</td><td>C148H223N39O46</td></tr><tr><td>molar mass:</td><td>3284.64 g/mol (PubChem)</td></tr></table></body></html>"));
