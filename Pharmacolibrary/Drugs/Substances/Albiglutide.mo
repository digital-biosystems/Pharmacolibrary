  annotation (Documentation(info = "<html><body><p>Albiglutide is a GLP-1 analogue blood glucose lowering drug that was used to treat type 2 diabetes. It is no longer used: its European marketing authorisation has been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4712362\">Wikidata Q4712362</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>albiglutide</td></tr><tr><td>ATC codes:</td><td>A10BJ04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09043\">DB09043</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4712362\">Q4712362</a></td></tr><tr><td>molar mass:</td><td>3284.6 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>-14 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
