  annotation (Documentation(info = "<html><body><p>Tiratricol is a thyroid hormone preparation used for thyroid conditions such as thyrotoxicosis and thyroid cancer. It is approved and appears to be only narrowly available, with a single authorised product in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7809151&quot;>Wikidata Q7809151</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>tiratricol</td></tr><tr><td>ATC codes:</td><td>D11AX08, H03AA04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB03604&quot;>DB03604</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5803&quot;>5803</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7809151&quot;>Q7809151</a></td></tr><tr><td>formula:</td><td>C14H9I3O4</td></tr><tr><td>molar mass:</td><td>621.922 g/mol (PubChem)</td></tr></table></body></html>"));
