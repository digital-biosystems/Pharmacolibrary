  annotation (Documentation(info = "<html><body><p>Carbenoxolone is an anti-ulcer drug that was used to treat peptic ulcers and other acid-related stomach disorders. It is now considered an experimental drug and is not in routine clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q752861&quot;>Wikidata Q752861</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>carbenoxolone</td></tr><tr><td>ATC codes:</td><td>A02BX01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB02329&quot;>DB02329</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/636403&quot;>636403</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q752861&quot;>Q752861</a></td></tr><tr><td>formula:</td><td>C34H50O7</td></tr><tr><td>molar mass:</td><td>570.767 g/mol (PubChem)</td></tr></table></body></html>"));
end Carbenoxolone;
