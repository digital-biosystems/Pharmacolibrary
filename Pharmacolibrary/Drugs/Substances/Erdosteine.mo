  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "erdosteine",
    atcCodes = {"R05CB15"},
    drugbankId = "DB05057",
    pubchemCid = "65632",
    chebiId = "135014",
    wikidataId = "Q3731252",
