  annotation (Documentation(info = "<html><body><p>Ferrous glycine sulfate is an oral bivalent iron preparation used to treat iron-deficiency anaemia. It is an approved medicine and is used as an oral iron supplement.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27261422&quot;>Wikidata Q27261422</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ferrous glycine sulfate</td></tr><tr><td>ATC codes:</td><td>B03AA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB14501&quot;>DB14501</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/167159&quot;>167159</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27261422&quot;>Q27261422</a></td></tr><tr><td>formula:</td><td>C4H10FeN2O8S</td></tr><tr><td>molar mass:</td><td>302.035 g/mol (PubChem)</td></tr></table></body></html>"));
end FerrousGlycineSulfate;
