within Pharmacolibrary.Drugs.Substances;
package Teniposide "teniposide"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "teniposide",
    atcCodes = {"L01CB02"},
    drugbankId = "DB00444",
    pubchemCid = "452548",
    chebiId = "75988",
    wikidataId = "Q417555",
    formula = "C32H32O13S",
    M = 0.656655,
    logP = 1.2);
  annotation (Documentation(info = "<html><body><p>Teniposide is an anticancer drug used to treat acute lymphocytic leukemia and other lymphoblastic leukemias, as well as small cell lung cancer. It is an approved antineoplastic agent, a podophyllotoxin derivative that acts as a topoisomerase II inhibitor, but it is not authorised in the European Union and is used only in limited settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q417555\">Wikidata Q417555</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>teniposide</td></tr><tr><td>ATC codes:</td><td>L01CB02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00444\">DB00444</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/452548\">452548</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:75988\">75988</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q417555\">Q417555</a></td></tr><tr><td>formula:</td><td>C32H32O13S</td></tr><tr><td>molar mass:</td><td>656.655 g/mol (PubChem CID 452548)</td></tr><tr><td>logP:</td><td>1.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Teniposide;
