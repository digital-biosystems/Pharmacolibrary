  annotation (Documentation(info = "<html><body><p>Gamolenic acid, an omega-6 fatty acid, was used as a dermatological treatment, notably for atopic eczema. It has been withdrawn from the market and is no longer in clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q415885&quot;>Wikidata Q415885</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>gamolenic acid</td></tr><tr><td>ATC codes:</td><td>D11AX02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13854&quot;>DB13854</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:28661&quot;>28661</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q415885&quot;>Q415885</a></td></tr><tr><td>formula:</td><td>C18H30O2</td></tr><tr><td>molar mass:</td><td>278.43 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
