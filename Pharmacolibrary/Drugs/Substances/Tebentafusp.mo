  annotation (Documentation(info = "<html><body><p>Tebentafusp is an anticancer medicine, a fusion protein, used to treat uveal melanoma (cancer of the eye). It is authorised in the European Union and is also being investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q110757700\">Wikidata Q110757700</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>tebentafusp</td></tr><tr><td>ATC codes:</td><td>L01XX75</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB15283\">DB15283</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q110757700\">Q110757700</a></td></tr><tr><td>molar mass:</td><td>77000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
