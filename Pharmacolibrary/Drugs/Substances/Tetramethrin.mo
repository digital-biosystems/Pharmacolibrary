    logP = 4.7);
  annotation (Documentation(info = "<html><body><p>Tetramethrin is a pyrethroid insecticide used to kill insects and other ectoparasites. It is not an approved human medicine; DrugBank lists it only as an experimental compound, so its use appears limited to non-therapeutic insecticide applications.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3234577&quot;>Wikidata Q3234577</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tetramethrin</td></tr><tr><td>ATC codes:</td><td>P03BA04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13752&quot;>DB13752</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/83975&quot;>83975</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:39397&quot;>39397</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3234577&quot;>Q3234577</a></td></tr><tr><td>formula:</td><td>C19H25NO4</td></tr><tr><td>molar mass:</td><td>331.412 g/mol (PubChem)</td></tr></table></body></html>"));
end Tetramethrin;
