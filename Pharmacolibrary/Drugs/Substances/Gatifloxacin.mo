  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "gatifloxacin",
    atcCodes = {"J01MA16", "S01AE06"},
    drugbankId = "DB01044",
    pubchemCid = "5379",
    chebiId = "5280",
    wikidataId = "Q2365016",
