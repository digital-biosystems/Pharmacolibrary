    logP = -0.7);
  annotation (Documentation(info = "<html><body><p>Gatifloxacin is a fluoroquinolone antibiotic used against bacterial infections such as pneumonia, sinusitis, urinary tract infections, gonorrhea, and conjunctivitis. It has been withdrawn for systemic use because of serious side effects, though ophthalmic preparations may still be available in some countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2365016\">Wikidata Q2365016</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>gatifloxacin</td></tr><tr><td>ATC codes:</td><td>J01MA16, S01AE06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01044\">DB01044</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5379\">5379</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:5280\">5280</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2365016\">Q2365016</a></td></tr><tr><td>formula:</td><td>C19H22FN3O4</td></tr><tr><td>molar mass:</td><td>375.4 g/mol (PubChem CID 5379)</td></tr><tr><td>logP:</td><td>-0.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Gatifloxacin;
