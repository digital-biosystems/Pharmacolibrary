  annotation (Documentation(info = "<html><body><p>Mebeverine is an antispasmodic used to relieve symptoms of irritable bowel syndrome and other functional gastrointestinal disorders. It remains in use and is available in several countries, though it is not authorised centrally in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q418167\">Wikidata Q418167</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mebeverine</td></tr><tr><td>ATC codes:</td><td>A03AA04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12554\">DB12554</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4031\">4031</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:91514\">91514</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q418167\">Q418167</a></td></tr><tr><td>formula:</td><td>C25H35NO5</td></tr><tr><td>molar mass:</td><td>429.557 g/mol (PubChem CID 4031)</td></tr><tr><td>logP:</td><td>5.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
