  annotation (Documentation(info = "<html><body><p>Bucladesine is a cardiac stimulant, classified as a phosphodiesterase inhibitor, that has been used in cardiac therapy. It is considered experimental and there is no evidence it is an approved medicine in the European Union or elsewhere.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4983616&quot;>Wikidata Q4983616</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bucladesine</td></tr><tr><td>ATC codes:</td><td>C01CE04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13242&quot;>DB13242</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/9687&quot;>9687</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:50095&quot;>50095</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4983616&quot;>Q4983616</a></td></tr><tr><td>formula:</td><td>C18H24N5O8P</td></tr><tr><td>molar mass:</td><td>469.391 g/mol (PubChem)</td></tr></table></body></html>"));
