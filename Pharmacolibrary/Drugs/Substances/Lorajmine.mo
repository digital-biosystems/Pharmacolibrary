  annotation (Documentation(info = "<html><body><p>Lorajmine is a chemical compound with antiarrhythmic activity, classified as a class Ia antiarrhythmic used for heart rhythm disorders. It is considered experimental and does not appear to be an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6678756&quot;>Wikidata Q6678756</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>lorajmine</td></tr><tr><td>ATC codes:</td><td>C01BA12</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13651&quot;>DB13651</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/76957773&quot;>76957773</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135646&quot;>135646</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6678756&quot;>Q6678756</a></td></tr><tr><td>formula:</td><td>C22H27ClN2O3</td></tr><tr><td>molar mass:</td><td>402.919 g/mol (PubChem)</td></tr></table></body></html>"));
