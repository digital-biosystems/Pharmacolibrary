  annotation (Documentation(info = "<html><body><p>Brotizolam is a benzodiazepine-type sedative that was used as a hypnotic for sleep problems. It was approved in some countries but has been withdrawn and is no longer in general use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q850074&quot;>Wikidata Q850074</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>brotizolam</td></tr><tr><td>ATC codes:</td><td>N05CD09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09017&quot;>DB09017</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2451&quot;>2451</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31308&quot;>31308</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q850074&quot;>Q850074</a></td></tr><tr><td>formula:</td><td>C15H10BrClN4S</td></tr><tr><td>molar mass:</td><td>393.687 g/mol (PubChem)</td></tr></table></body></html>"));
