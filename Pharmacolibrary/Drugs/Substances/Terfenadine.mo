    logP = 6.6);
  annotation (Documentation(info = "<html><body><p>Terfenadine was a non-sedating antihistamine used to relieve allergy symptoms such as hay fever. It has been withdrawn from the market because it could cause serious heart rhythm problems, and safer alternatives such as its active metabolite are now used instead.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q417909\">Wikidata Q417909</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>terfenadine</td></tr><tr><td>ATC codes:</td><td>R06AX12</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00342\">DB00342</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5405\">5405</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9453\">9453</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q417909\">Q417909</a></td></tr><tr><td>formula:</td><td>C32H41NO2</td></tr><tr><td>molar mass:</td><td>471.685 g/mol (PubChem CID 5405)</td></tr><tr><td>logP:</td><td>6.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Terfenadine;
