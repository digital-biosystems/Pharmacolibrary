within Pharmacolibrary.Drugs.Substances;
package Diosmin "diosmin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "diosmin",
    atcCodes = {"C05CA03"},
    drugbankId = "DB08995",
    pubchemCid = "5281613",
    chebiId = "4631",
    wikidataId = "Q2607865",
    formula = "C28H32O15",
    M = 0.608549,
    logP = -0.8);
  annotation (Documentation(info = "<html><body><p>Diosmin is a bioflavonoid used as a capillary-stabilizing and vasoprotective medicine, mainly for vein and circulation problems such as haemorrhoids and chronic venous disease. It is approved and used in many countries, particularly in Europe, often in combination with hesperidin; it is not authorised centrally in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2607865&quot;>Wikidata Q2607865</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>diosmin</td></tr><tr><td>ATC codes:</td><td>C05CA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08995&quot;>DB08995</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5281613&quot;>5281613</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4631&quot;>4631</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2607865&quot;>Q2607865</a></td></tr><tr><td>formula:</td><td>C28H32O15</td></tr><tr><td>molar mass:</td><td>608.549 g/mol (PubChem)</td></tr></table></body></html>"));
end Diosmin;
