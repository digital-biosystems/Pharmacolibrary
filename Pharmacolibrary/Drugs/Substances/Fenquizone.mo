    logP = 1.8);
  annotation (Documentation(info = "<html><body><p>Fenquizone is a diuretic, a type of drug that increases urine production and is used to treat conditions involving fluid retention such as swelling and high blood pressure. It is considered investigational and does not appear to be an approved medicine in major markets such as the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3742488\">Wikidata Q3742488</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>fenquizone</td></tr><tr><td>ATC codes:</td><td>C03BA13</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13708\">DB13708</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/68548\">68548</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135435\">135435</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3742488\">Q3742488</a></td></tr><tr><td>formula:</td><td>C14H12ClN3O3S</td></tr><tr><td>molar mass:</td><td>337.778 g/mol (PubChem CID 68548)</td></tr><tr><td>logP:</td><td>1.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Fenquizone;
