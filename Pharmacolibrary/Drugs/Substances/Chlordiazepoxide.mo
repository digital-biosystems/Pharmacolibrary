  annotation (Documentation(info = "<html><body><p>Chlordiazepoxide is a benzodiazepine sedative used to treat anxiety disorders and in the management of alcohol abuse. It is an approved medicine, widely used as an anxiolytic, though it also has some illicit use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q178566\">Wikidata Q178566</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>chlordiazepoxide</td></tr><tr><td>ATC codes:</td><td>N05BA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00475\">DB00475</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2712\">2712</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3611\">3611</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q178566\">Q178566</a></td></tr><tr><td>formula:</td><td>C16H14ClN3O</td></tr><tr><td>molar mass:</td><td>299.758 g/mol (PubChem CID 2712)</td></tr><tr><td>logP:</td><td>2.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
