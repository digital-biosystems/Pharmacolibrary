  annotation (Documentation(info = "<html><body><p>Ziprasidone is an antipsychotic used to treat schizophrenia and related psychotic conditions such as schizoaffective disorder, and has also been used for anxiety and Tourette syndrome. It is an approved medicine used in routine psychiatric care, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q205517&quot;>Wikidata Q205517</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ziprasidone</td></tr><tr><td>ATC codes:</td><td>N05AE04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00246&quot;>DB00246</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/60854&quot;>60854</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:10119&quot;>10119</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q205517&quot;>Q205517</a></td></tr><tr><td>formula:</td><td>C21H21ClN4OS</td></tr><tr><td>molar mass:</td><td>412.936 g/mol (PubChem)</td></tr></table></body></html>"));
