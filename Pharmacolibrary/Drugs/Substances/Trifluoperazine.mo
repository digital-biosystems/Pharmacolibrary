  annotation (Documentation(info = "<html><body><p>Trifluoperazine is a phenothiazine antipsychotic used to treat schizophrenia and schizophreniform disorder, and it also has antiemetic effects. It remains an approved medicine, though it carries a boxed warning and is not authorised centrally in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1752915\">Wikidata Q1752915</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>trifluoperazine</td></tr><tr><td>ATC codes:</td><td>N05AB06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00831\">DB00831</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5566\">5566</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:45951\">45951</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1752915\">Q1752915</a></td></tr><tr><td>formula:</td><td>C21H24F3N3S</td></tr><tr><td>molar mass:</td><td>407.498 g/mol (PubChem CID 5566)</td></tr><tr><td>logP:</td><td>5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
