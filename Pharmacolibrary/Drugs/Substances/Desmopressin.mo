  annotation (Documentation(info = "<html><body><p>Desmopressin, a synthetic vasopressin analogue, is used to treat diabetes insipidus, bedwetting, hemophilia A, von Willebrand disease, and high blood urea levels. It is an approved medicine, appears on the WHO essential medicines list, and is widely used.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q241006&quot;>Wikidata Q241006</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>desmopressin</td></tr><tr><td>ATC codes:</td><td>H01BA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00035&quot;>DB00035</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5311065&quot;>5311065</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4450&quot;>4450</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q241006&quot;>Q241006</a></td></tr><tr><td>formula:</td><td>C46H64N14O12S2</td></tr><tr><td>molar mass:</td><td>1069.22 g/mol (PubChem)</td></tr></table></body></html>"));
