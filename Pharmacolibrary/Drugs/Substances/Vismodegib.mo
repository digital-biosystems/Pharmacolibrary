  annotation (Documentation(info = "<html><body><p>Vismodegib is an anticancer medicine used to treat basal-cell carcinoma, a type of skin cancer. It is authorised in the European Union and carries a boxed warning because it can harm reproduction and fetal development.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2070286&quot;>Wikidata Q2070286</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>vismodegib</td></tr><tr><td>ATC codes:</td><td>L01XJ01, L01XX43</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08828&quot;>DB08828</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/24776445&quot;>24776445</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:66903&quot;>66903</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2070286&quot;>Q2070286</a></td></tr><tr><td>formula:</td><td>C19H14Cl2N2O3S</td></tr><tr><td>molar mass:</td><td>421.292 g/mol (PubChem)</td></tr></table></body></html>"));
