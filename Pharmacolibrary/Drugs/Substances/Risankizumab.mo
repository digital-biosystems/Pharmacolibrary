  annotation (Documentation(info = "<html><body><p>Risankizumab is a monoclonal antibody used to treat psoriasis, psoriatic arthritis, ulcerative colitis, and Crohn's disease. It is an approved interleukin inhibitor and is authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q25112466\">Wikidata Q25112466</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>risankizumab</td></tr><tr><td>ATC codes:</td><td>L04AC18</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB14762\">DB14762</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q25112466\">Q25112466</a></td></tr><tr><td>molar mass:</td><td>149000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Risankizumab;
