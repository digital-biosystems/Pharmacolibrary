within Pharmacolibrary.Drugs.Substances;
package Tenecteplase "tenecteplase"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "tenecteplase",
    atcCodes = {"B01AD11"},
    drugbankId = "DB00031",
    wikidataId = "Q1644947",
    M = 58.9512);
  annotation (Documentation(info = "<html><body><p>Tenecteplase is a fibrinolytic (clot-dissolving) drug used to treat acute myocardial infarction, and has also been used for coronary thrombosis and ischemic stroke. It is an approved medicine, authorised in the European Union, and is widely used as a thrombolytic, mainly in hospital settings for heart attacks.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1644947\">Wikidata Q1644947</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>tenecteplase</td></tr><tr><td>ATC codes:</td><td>B01AD11</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00031\">DB00031</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1644947\">Q1644947</a></td></tr><tr><td>molar mass:</td><td>58951.2 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Tenecteplase;
