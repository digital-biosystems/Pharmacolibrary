  annotation (Documentation(info = "<html><body><p>Ademetionine (S-adenosylmethionine) is an amino-acid derivative used as a dietary supplement and medicine, mainly for liver and joint complaints. It is approved and sold as a nutraceutical in several countries, though it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27135598&quot;>Wikidata Q27135598</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ademetionine</td></tr><tr><td>ATC codes:</td><td>A16AA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00118&quot;>DB00118</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/34755&quot;>34755</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:67040&quot;>67040</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27135598&quot;>Q27135598</a></td></tr><tr><td>formula:</td><td>C15H22N6O5S</td></tr><tr><td>molar mass:</td><td>398.438 g/mol (PubChem)</td></tr></table></body></html>"));
