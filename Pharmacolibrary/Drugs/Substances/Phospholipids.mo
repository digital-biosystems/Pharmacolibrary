within Pharmacolibrary.Drugs.Substances;
package Phospholipids "phospholipids"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "phospholipids",
    atcCodes = {"A05BA10"},
    drugbankId = "DB11133");
  annotation (Documentation(info = "<html><body><p>Phospholipids, also known as omega fatty acids, are used in liver therapy as lipotropic agents. They are approved and also available as nutraceuticals, with some investigational uses.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>phospholipids</td></tr><tr><td>ATC codes:</td><td>A05BA10</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11133&quot;>DB11133</a></td></tr></table></body></html>"));
end Phospholipids;
