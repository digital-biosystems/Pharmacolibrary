  annotation (Documentation(info = "<html><body><p>Etofylline nicotinate is a purine-derivative compound classified as a peripheral vasodilator, indicating use for circulatory problems in the limbs. It appears only as an experimental drug and is not an approved medicine in the European Union, so its current use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q15408405&quot;>Wikidata Q15408405</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>etofylline nicotinate</td></tr><tr><td>ATC codes:</td><td>C04AD04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13842&quot;>DB13842</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135405&quot;>135405</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q15408405&quot;>Q15408405</a></td></tr><tr><td>formula:</td><td>C15H15N5O4</td></tr><tr><td>molar mass:</td><td>329.316 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end EtofyllineNicotinate;
