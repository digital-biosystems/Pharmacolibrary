  annotation (Documentation(info = "<html><body><p>Daprodustat is an antianemic medicine used to treat anemia, including anemia associated with chronic kidney disease. It is an approved drug, though one marketing application in the European Union was withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27076986&quot;>Wikidata Q27076986</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>daprodustat</td></tr><tr><td>ATC codes:</td><td>B03XA07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11682&quot;>DB11682</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/91617630&quot;>91617630</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27076986&quot;>Q27076986</a></td></tr><tr><td>formula:</td><td>C19H27N3O6</td></tr><tr><td>molar mass:</td><td>393.44 g/mol (PubChem)</td></tr></table></body></html>"));
