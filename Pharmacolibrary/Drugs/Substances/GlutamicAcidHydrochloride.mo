  annotation (Documentation(info = "<html><body><p>Glutamic acid hydrochloride is an acid preparation used as a digestive aid, and the amino acid itself also serves as a nutritional supplement. It is an approved, nutraceutical-type product that is not authorised in the European Union and is used only to a limited extent.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q26995161\">Wikidata Q26995161</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>glutamic acid hydrochloride</td></tr><tr><td>ATC codes:</td><td>A09AB01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00142\">DB00142</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/33032\">33032</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:16015\">16015</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q26995161\">Q26995161</a></td></tr><tr><td>formula:</td><td>C5H9NO4</td></tr><tr><td>molar mass:</td><td>147.13 g/mol (PubChem CID 33032)</td></tr></table><p><small>Drugs.Common 25.09 gave 183.59 g/mol (+24.8 %); replaced by the value above</small></p></body></html>"));
