  annotation (Documentation(info = "<html><body><p>Xamoterol is a beta-1 adrenergic receptor agonist used as a cardiac stimulant in heart conditions. It has been approved as a medicine, though it is not widely used today.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4021708\">Wikidata Q4021708</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>xamoterol</td></tr><tr><td>ATC codes:</td><td>C01CX07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13781\">DB13781</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/155774\">155774</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:10055\">10055</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4021708\">Q4021708</a></td></tr><tr><td>formula:</td><td>C16H25N3O5</td></tr><tr><td>molar mass:</td><td>339.392 g/mol (PubChem CID 155774)</td></tr><tr><td>logP:</td><td>-0.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
