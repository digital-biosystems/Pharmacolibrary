  annotation (Documentation(info = "<html><body><p>Sultamicillin is an oral antibiotic combining a penicillin with a beta-lactamase inhibitor, used to treat bacterial infections. It was approved at one time but has been withdrawn from the market and is no longer in general use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q617686\">Wikidata Q617686</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sultamicillin</td></tr><tr><td>ATC codes:</td><td>J01CR04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12127\">DB12127</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/444022\">444022</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:51770\">51770</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q617686\">Q617686</a></td></tr><tr><td>formula:</td><td>C25H30N4O9S2</td></tr><tr><td>molar mass:</td><td>594.654 g/mol (PubChem CID 444022)</td></tr><tr><td>logP:</td><td>0.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
