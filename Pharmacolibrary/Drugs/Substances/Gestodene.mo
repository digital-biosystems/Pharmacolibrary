  annotation (Documentation(info = "<html><body><p>Gestodene is a synthetic progestin used in combination hormonal contraceptives for preventing pregnancy. It is listed as investigational in DrugBank and has no EMA authorisation, so its current availability appears limited.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q408289\">Wikidata Q408289</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Gestodene</td></tr><tr><td>ATC codes:</td><td>G03AA10, G03AB06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06730\">DB06730</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3033968\">3033968</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135323\">135323</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q408289\">Q408289</a></td></tr><tr><td>formula:</td><td>C21H26O2</td></tr><tr><td>molar mass:</td><td>310.437 g/mol (PubChem CID 3033968)</td></tr></table></body></html>"));
end Gestodene;
