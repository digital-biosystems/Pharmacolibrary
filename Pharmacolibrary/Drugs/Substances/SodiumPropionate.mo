    M = 0.074079);
  annotation (Documentation(info = "<html><body><p>Sodium propionate is an antiinfective agent used to treat eye infections, and is also known as a preservative that prevents microbial growth. It is an approved medicine and also approved for veterinary use, though some products containing it have been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q420130\">Wikidata Q420130</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sodium propionate</td></tr><tr><td>ATC codes:</td><td>S01AX10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB03766\">DB03766</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/1032\">1032</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:30768\">30768</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q420130\">Q420130</a></td></tr><tr><td>formula:</td><td>C3H6O2</td></tr><tr><td>molar mass:</td><td>74.079 g/mol (PubChem CID 1032)</td></tr></table><p><small>Drugs.Common 25.09 gave 96.06 g/mol (+29.7 %); replaced by the value above</small></p></body></html>"));
end SodiumPropionate;
