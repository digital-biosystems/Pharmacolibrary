  annotation (Documentation(info = "<html><body><p>Sodium propionate (propionic acid) is a short-chain fatty acid used as an antiinfective, including in ophthalmological preparations. It has been approved for human and veterinary use, though some uses have been withdrawn; it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q422956&quot;>Wikidata Q422956</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sodium propionate</td></tr><tr><td>ATC codes:</td><td>S01AX10</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB03766&quot;>DB03766</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/1032&quot;>1032</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:30768&quot;>30768</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q422956&quot;>Q422956</a></td></tr><tr><td>formula:</td><td>C3H6O2</td></tr><tr><td>molar mass:</td><td>74.079 g/mol (PubChem)</td></tr></table></body></html>"));
