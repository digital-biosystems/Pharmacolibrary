within Pharmacolibrary.Drugs.Substances;
package HyaluronicAcid "hyaluronic acid"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "hyaluronic acid",
    atcCodes = {"D03AX05", "M09AX01", "R01AX09", "S01KA01"},
    drugbankId = "DB08818",
    pubchemCid = "24759",
    wikidataId = "Q337231",
    formula = "C28H44N2O23",
    M = 0.776651,
    logP = -8.2);
  annotation (Documentation(info = "<html><body><p>Hyaluronic acid is a naturally occurring polysaccharide used to help wound healing, as a viscoelastic aid in eye surgery, in nasal preparations, and for joint (viscosupplement) treatment. It is widely used, with approved human and veterinary products, and is also being investigated for further uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q337231&quot;>Wikidata Q337231</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>hyaluronic acid</td></tr><tr><td>ATC codes:</td><td>D03AX05, M09AX01, R01AX09, S01KA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08818&quot;>DB08818</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/24759&quot;>24759</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q337231&quot;>Q337231</a></td></tr><tr><td>formula:</td><td>C28H44N2O23</td></tr><tr><td>molar mass:</td><td>776.651 g/mol (PubChem)</td></tr></table></body></html>"));
end HyaluronicAcid;
