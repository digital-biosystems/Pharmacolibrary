within Pharmacolibrary.Drugs.Substances;
package Clobetasol "clobetasol"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "clobetasol",
    atcCodes = {"D07AD01", "S01BA17"},
    drugbankId = "DB11750",
    pubchemCid = "5311051",
    chebiId = "205919",
    wikidataId = "Q4224007",
    formula = "C22H28ClFO4",
    M = 0.41091,
    logP = 2.5);
  annotation (Documentation(info = "<html><body><p>Clobetasol is a very potent topical corticosteroid used to treat inflammatory skin conditions such as various forms of dermatitis, including on the face, scalp, legs, and hands. It is an approved medicine, widely used in dermatology, and is also available in combination with antibiotics for skin use and as an ophthalmic anti-inflammatory agent.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4224007\">Wikidata Q4224007</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>clobetasol</td></tr><tr><td>ATC codes:</td><td>D07AD01, S01BA17</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11750\">DB11750</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5311051\">5311051</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:205919\">205919</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4224007\">Q4224007</a></td></tr><tr><td>formula:</td><td>C22H28ClFO4</td></tr><tr><td>molar mass:</td><td>410.91 g/mol (PubChem CID 5311051)</td></tr><tr><td>logP:</td><td>2.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Clobetasol;
