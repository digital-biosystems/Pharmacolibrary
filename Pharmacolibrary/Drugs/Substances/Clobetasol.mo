    logP = 2.5);
  annotation (Documentation(info = "<html><body><p>Clobetasol is a very potent topical corticosteroid used to treat inflammatory skin conditions such as dermatitis and various dermatoses of the skin, scalp, and face. It is an approved medicine, widely used in dermatological practice, and is also available in combination with antibiotics.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4224007&quot;>Wikidata Q4224007</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>clobetasol</td></tr><tr><td>ATC codes:</td><td>D07AD01, S01BA17</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11750&quot;>DB11750</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5311051&quot;>5311051</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:205919&quot;>205919</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4224007&quot;>Q4224007</a></td></tr><tr><td>formula:</td><td>C22H28ClFO4</td></tr><tr><td>molar mass:</td><td>410.91 g/mol (PubChem)</td></tr></table></body></html>"));
