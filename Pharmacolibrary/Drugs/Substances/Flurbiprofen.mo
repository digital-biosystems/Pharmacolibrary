    logP = 4.2);
  annotation (Documentation(info = "<html><body><p>Flurbiprofen is a non-steroidal anti-inflammatory drug used to treat pain and inflammation in conditions such as osteoarthritis and rheumatoid arthritis, and is also applied topically for joint, muscular, throat, and eye problems. It is an approved medicine used in several forms, including tablets, topical preparations, throat lozenges, and eye drops, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q419890\">Wikidata Q419890</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>flurbiprofen</td></tr><tr><td>ATC codes:</td><td>M01AE09, M02AA19, R02AX01, S01BC04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00712\">DB00712</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3394\">3394</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:5130\">5130</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q419890\">Q419890</a></td></tr><tr><td>formula:</td><td>C15H13FO2</td></tr><tr><td>molar mass:</td><td>244.265 g/mol (PubChem CID 3394)</td></tr><tr><td>logP:</td><td>4.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Flurbiprofen;
