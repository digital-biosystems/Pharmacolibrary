within Pharmacolibrary.Drugs.Substances;
package Flurbiprofen "flurbiprofen"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "flurbiprofen",
    atcCodes = {"M01AE09", "M02AA19", "R02AX01", "S01BC04"},
    drugbankId = "DB00712",
    pubchemCid = "3394",
    chebiId = "5130",
    wikidataId = "Q419890",
