  annotation (Documentation(info = "<html><body><p>Estetrol is an estrogen used in fixed combination hormonal contraceptives and for the treatment of menopause symptoms. It is approved and authorised in the European Union, where it is marketed for menopausal use, and remains under investigation for other purposes.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5401078\">Wikidata Q5401078</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>estetrol</td></tr><tr><td>ATC codes:</td><td>G03CA10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12235\">DB12235</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/27125\">27125</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:142773\">142773</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5401078\">Q5401078</a></td></tr><tr><td>formula:</td><td>C18H24O4</td></tr><tr><td>molar mass:</td><td>304.386 g/mol (PubChem CID 27125)</td></tr></table></body></html>"));
end Estetrol;
