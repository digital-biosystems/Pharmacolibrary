  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "tranexamic acid",
    atcCodes = {"B02AA02"},
    drugbankId = "DB00302",
    pubchemCid = "5526",
    chebiId = "48669",
    wikidataId = "Q418666",
