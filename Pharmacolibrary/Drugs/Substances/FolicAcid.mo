within Pharmacolibrary.Drugs.Substances;
package FolicAcid "folic acid"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "folic acid",
    atcCodes = {"B03BB01", "V04CX02"},
    drugbankId = "DB00158",
    pubchemCid = "6037",
    chebiId = "27470",
    wikidataId = "Q127060",
    formula = "C19H19N7O6",
    M = 0.441404,
    logP = -1.1);
  annotation (Documentation(info = "<html><body><p>Folic acid, a form of vitamin B9, is used to treat anaemias such as macrocytic and megaloblastic anaemia, often combined with iron. It is widely used, appears on the WHO essential medicines list, and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q127060&quot;>Wikidata Q127060</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>folic acid</td></tr><tr><td>ATC codes:</td><td>B03BB01, V04CX02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00158&quot;>DB00158</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6037&quot;>6037</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:27470&quot;>27470</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q127060&quot;>Q127060</a></td></tr><tr><td>formula:</td><td>C19H19N7O6</td></tr><tr><td>molar mass:</td><td>441.404 g/mol (PubChem)</td></tr></table></body></html>"));
end FolicAcid;
