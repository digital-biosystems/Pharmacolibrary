  annotation (Documentation(info = "<html><body><p>Beef (bovine) insulin is an insulin product used to treat diabetes mellitus. It is an approved insulin, though largely replaced by human and analogue insulins in modern practice.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>insulin (beef)</td></tr><tr><td>ATC codes:</td><td>A10AB02, A10AC02, A10AD02, A10AE02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09456\">DB09456</a></td></tr><tr><td>molar mass:</td><td>5734 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>-12.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
