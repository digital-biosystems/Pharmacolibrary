  annotation (Documentation(info = "<html><body><p>Histrelin is a gonadotropin-releasing hormone analogue used in endocrine therapy, notably for prostate cancer and for central precocious puberty. It remains an approved drug, though it has been withdrawn in some markets and is also investigational for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5871149&quot;>Wikidata Q5871149</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>histrelin</td></tr><tr><td>ATC codes:</td><td>L02AE05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06788&quot;>DB06788</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/56927879&quot;>56927879</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:63530&quot;>63530</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5871149&quot;>Q5871149</a></td></tr><tr><td>formula:</td><td>C70H94N18O16</td></tr><tr><td>molar mass:</td><td>1443.63 g/mol (PubChem)</td></tr></table></body></html>"));
