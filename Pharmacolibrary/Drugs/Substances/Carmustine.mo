  annotation (Documentation(info = "<html><body><p>Carmustine is an alkylating anticancer drug used to treat cancers such as Hodgkin disease and non-Hodgkin lymphoma. It remains an approved medicine, with an authorised product in the European Union, and carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q415869&quot;>Wikidata Q415869</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>carmustine</td></tr><tr><td>ATC codes:</td><td>L01AD01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00262&quot;>DB00262</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2578&quot;>2578</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3423&quot;>3423</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q415869&quot;>Q415869</a></td></tr><tr><td>formula:</td><td>C5H9Cl2N3O2</td></tr><tr><td>molar mass:</td><td>214.046 g/mol (PubChem)</td></tr></table></body></html>"));
