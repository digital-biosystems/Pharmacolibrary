    wikidataId = "Q158289");
  annotation (Documentation(info = "<html><body><p>St John's wort (Hypericum perforatum) flowering tops are used as a herbal antidepressant for mild to moderate depression. It is widely available as an over-the-counter herbal remedy and nutraceutical, and is approved in several countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q158289\">Wikidata Q158289</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Hyperici herba</td></tr><tr><td>ATC codes:</td><td>N06AX25</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01323\">DB01323</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q158289\">Q158289</a></td></tr></table></body></html>"));
end HypericiHerba;
