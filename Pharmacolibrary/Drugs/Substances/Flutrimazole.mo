    logP = 4.6);
  annotation (Documentation(info = "<html><body><p>Flutrimazole is an antifungal drug used to treat fungal skin infections, including pityriasis versicolor. It is applied topically to the skin or in gynecological use, and is considered investigational rather than an approved medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5462984\">Wikidata Q5462984</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>flutrimazole</td></tr><tr><td>ATC codes:</td><td>D01AC16, G01AF18</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13425\">DB13425</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3401\">3401</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:82864\">82864</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5462984\">Q5462984</a></td></tr><tr><td>formula:</td><td>C22H16F2N2</td></tr><tr><td>molar mass:</td><td>346.38 g/mol (PubChem CID 3401)</td></tr><tr><td>logP:</td><td>4.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
