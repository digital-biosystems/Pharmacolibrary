  annotation (Documentation(info = "<html><body><p>Palopegteriparatide (TransCon PTH) is a long-acting parathyroid hormone analogue used to treat hypoparathyroidism. It is authorised in the European Union and is also under investigation for other uses.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>palopegteriparatide</td></tr><tr><td>ATC codes:</td><td>H05AA05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB18676\">DB18676</a></td></tr><tr><td>molar mass:</td><td>474000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Palopegteriparatide;
