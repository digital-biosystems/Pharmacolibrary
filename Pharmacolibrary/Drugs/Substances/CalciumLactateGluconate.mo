  annotation (Documentation(info = "<html><body><p>Calcium lactate gluconate is a calcium salt that has been used as a calcium supplement to treat or prevent low calcium levels. It is listed as investigational, so it does not appear to be an approved medicine in major markets.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q414151&quot;>Wikidata Q414151</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>calcium lactate gluconate</td></tr><tr><td>ATC codes:</td><td>A12AA06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13365&quot;>DB13365</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q414151&quot;>Q414151</a></td></tr><tr><td>molar mass:</td><td>1551.4 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end CalciumLactateGluconate;
