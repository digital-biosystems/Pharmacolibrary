  annotation (Documentation(info = "<html><body><p>Emetine is an isoquinoline alkaloid that has been used against protozoal infections such as amebiasis and fascioloidiasis. It is currently considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3050386&quot;>Wikidata Q3050386</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>emetine</td></tr><tr><td>ATC codes:</td><td>P01AX02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13393&quot;>DB13393</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/10219&quot;>10219</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4781&quot;>4781</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3050386&quot;>Q3050386</a></td></tr><tr><td>formula:</td><td>C29H40N2O4</td></tr><tr><td>molar mass:</td><td>480.649 g/mol (PubChem)</td></tr></table></body></html>"));
