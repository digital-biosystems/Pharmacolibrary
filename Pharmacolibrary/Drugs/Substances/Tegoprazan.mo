    logP = 3.2);
  annotation (Documentation(info = "<html><body><p>Tegoprazan is a potassium-competitive acid blocker investigated for acid-related digestive disorders such as gastro-oesophageal reflux disease and peptic ulcer. It is not authorised in the European Union and remains investigational according to DrugBank, though it has been marketed in some Asian countries under the name K-CAB.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27292116&quot;>Wikidata Q27292116</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tegoprazan</td></tr><tr><td>ATC codes:</td><td>A02BC09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB16690&quot;>DB16690</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/23582846&quot;>23582846</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27292116&quot;>Q27292116</a></td></tr><tr><td>formula:</td><td>C20H19F2N3O3</td></tr><tr><td>molar mass:</td><td>387.386 g/mol (PubChem)</td></tr></table></body></html>"));
end Tegoprazan;
