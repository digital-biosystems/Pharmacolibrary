  annotation (Documentation(info = "<html><body><p>Eosin is a red dye classified as a dermatological antiseptic and disinfectant, and it is also used as a stain in laboratory work. It is not an approved medicine; databases list it as investigational, so it is not in routine clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q422637\">Wikidata Q422637</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>eosin</td></tr><tr><td>ATC codes:</td><td>D08AX02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13706\">DB13706</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/11048\">11048</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:52053\">52053</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q422637\">Q422637</a></td></tr><tr><td>formula:</td><td>C20H6Br4Na2O5</td></tr><tr><td>molar mass:</td><td>691.859 g/mol (PubChem CID 11048)</td></tr></table></body></html>"));
end Eosin;
