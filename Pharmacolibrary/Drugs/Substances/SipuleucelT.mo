  annotation (Documentation(info = "<html><body><p>Sipuleucel-T is an immunostimulant used to treat prostate cancer. It is an approved medicine, mainly used in the United States, but its marketing authorisation in the European Union has been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q424057\">Wikidata Q424057</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>sipuleucel-T</td></tr><tr><td>ATC codes:</td><td>L03AX17</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06688\">DB06688</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q424057\">Q424057</a></td></tr></table></body></html>"));
