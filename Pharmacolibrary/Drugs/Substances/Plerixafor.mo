    logP = 0);
  annotation (Documentation(info = "<html><body><p>Plerixafor is an immunostimulant used to help mobilise stem cells for transplantation in conditions such as multiple myeloma and lymphoma. It is authorised in the European Union and used in hospital settings for stem cell mobilisation before transplantation.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q905835&quot;>Wikidata Q905835</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>plerixafor</td></tr><tr><td>ATC codes:</td><td>L03AX16</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06809&quot;>DB06809</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/65015&quot;>65015</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:125354&quot;>125354</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q905835&quot;>Q905835</a></td></tr><tr><td>formula:</td><td>C28H54N8</td></tr><tr><td>molar mass:</td><td>502.796 g/mol (PubChem)</td></tr></table></body></html>"));
end Plerixafor;
