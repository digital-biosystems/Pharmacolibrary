  annotation (Documentation(info = "<html><body><p>Flutemetamol (18F) is a diagnostic radiopharmaceutical used in radionuclide imaging of the brain in Alzheimer's disease. It is authorised in the European Union and is used in specialist imaging settings to help detect amyloid plaques.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q18355673\">Wikidata Q18355673</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>flutemetamol (18F)</td></tr><tr><td>ATC codes:</td><td>V09AX04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09151\">DB09151</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/15950376\">15950376</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:76611\">76611</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q18355673\">Q18355673</a></td></tr><tr><td>formula:</td><td>C14H11FN2OS</td></tr><tr><td>molar mass:</td><td>274.313 g/mol (PubChem CID 15950376)</td></tr><tr><td>logP:</td><td>3.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
