  annotation (Documentation(info = "<html><body><p>Apraclonidine is an alpha-2 adrenergic agonist eye drop used to treat glaucoma and ocular hypertension. It is an approved ophthalmological medicine, used in glaucoma therapy.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4781812&quot;>Wikidata Q4781812</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>apraclonidine</td></tr><tr><td>ATC codes:</td><td>S01EA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00964&quot;>DB00964</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2216&quot;>2216</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:2788&quot;>2788</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4781812&quot;>Q4781812</a></td></tr><tr><td>formula:</td><td>C9H10Cl2N4</td></tr><tr><td>molar mass:</td><td>245.107 g/mol (PubChem)</td></tr></table></body></html>"));
