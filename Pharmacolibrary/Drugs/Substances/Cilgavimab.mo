  annotation (Documentation(info = "<html><body><p>It is given by injection, usually together with another antibody called tixagevimab, and its use has declined as coronavirus variants emerged that the antibodies do not neutralise well.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Cilgavimab</td></tr><tr><td>ATC codes:</td><td>J06BD03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB16393&quot;>DB16393</a></td></tr><tr><td>molar mass:</td><td>152000 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Cilgavimab;
