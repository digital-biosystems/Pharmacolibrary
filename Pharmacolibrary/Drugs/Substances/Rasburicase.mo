    M = 34.1095);
  annotation (Documentation(info = "<html><body><p>Rasburicase is used to treat hyperuricemia, particularly as a detoxifying agent during antineoplastic treatment. It is authorised in the European Union and is mainly used in hospital settings for chemotherapy-related hyperuricemia.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3088229&quot;>Wikidata Q3088229</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>rasburicase</td></tr><tr><td>ATC codes:</td><td>V03AF07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00049&quot;>DB00049</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3088229&quot;>Q3088229</a></td></tr><tr><td>molar mass:</td><td>34109.5 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Rasburicase;
