  annotation (Documentation(info = "<html><body><p>Midostaurin is a protein kinase inhibitor used to treat acute myeloid leukemia and, in the European Union, also mastocytosis. It is an approved anticancer medicine authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6842945&quot;>Wikidata Q6842945</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>midostaurin</td></tr><tr><td>ATC codes:</td><td>L01EX10, L01XE</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06595&quot;>DB06595</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/9829523&quot;>9829523</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:63452&quot;>63452</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6842945&quot;>Q6842945</a></td></tr><tr><td>formula:</td><td>C35H30N4O4</td></tr><tr><td>molar mass:</td><td>570.649 g/mol (PubChem)</td></tr></table></body></html>"));
end Midostaurin;
