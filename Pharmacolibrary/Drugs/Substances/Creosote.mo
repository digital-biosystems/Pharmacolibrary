within Pharmacolibrary.Drugs.Substances;
package Creosote "creosote"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "creosote",
    atcCodes = {"R05CA08"},
    drugbankId = "DB13271",
    wikidataId = "Q909808");
  annotation (Documentation(info = "<html><body><p>Creosote, a tar distillation byproduct, has been classified as an expectorant for cough and cold preparations. It is considered an investigational substance rather than an approved medicine, and it is a known carcinogen mainly used as a wood preservative.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q909808\">Wikidata Q909808</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>creosote</td></tr><tr><td>ATC codes:</td><td>R05CA08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13271\">DB13271</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q909808\">Q909808</a></td></tr></table></body></html>"));
end Creosote;
