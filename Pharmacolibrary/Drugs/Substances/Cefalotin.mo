  annotation (Documentation(info = "<html><body><p>Cefalotin is a first-generation cephalosporin antibiotic used to treat bacterial infections such as staphylococcal, urinary tract, and upper respiratory tract infections. It has been withdrawn from use, though it was once approved for human and veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2736126&quot;>Wikidata Q2736126</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cefalotin</td></tr><tr><td>ATC codes:</td><td>J01DB03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00456&quot;>DB00456</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6024&quot;>6024</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:124991&quot;>124991</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2736126&quot;>Q2736126</a></td></tr><tr><td>formula:</td><td>C16H16N2O6S2</td></tr><tr><td>molar mass:</td><td>396.432 g/mol (PubChem)</td></tr></table></body></html>"));
