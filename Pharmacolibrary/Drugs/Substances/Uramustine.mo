within Pharmacolibrary.Drugs.Substances;
package Uramustine "uramustine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "uramustine",
    atcCodes = {"L01AD08"},
    drugbankId = "DB00791",
    pubchemCid = "6194",
    chebiId = "9884",
    wikidataId = "Q15211075",
    formula = "C8H11Cl2N3O2",
    M = 0.252095,
    logP = 0.5);
  annotation (Documentation(info = "<html><body><p>Uramustine (uracil mustard) is an alkylating anticancer drug that has been used to treat cancers such as ovarian cancer, chronic leukemias, lymphosarcoma, mycosis fungoides, and polycythemia vera. It is listed as an approved antineoplastic agent, but it has no European Union marketing authorisation and its current availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q15211075\">Wikidata Q15211075</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>uramustine</td></tr><tr><td>ATC codes:</td><td>L01AD08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00791\">DB00791</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6194\">6194</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9884\">9884</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q15211075\">Q15211075</a></td></tr><tr><td>formula:</td><td>C8H11Cl2N3O2</td></tr><tr><td>molar mass:</td><td>252.095 g/mol (PubChem CID 6194)</td></tr><tr><td>logP:</td><td>0.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Uramustine;
