  annotation (Documentation(info = "<html><body><p>Nilotinib is a BCR-ABL tyrosine kinase inhibitor used to treat certain leukemias, notably chronic myelogenous leukemia that is BCR-ABL positive. It is authorised in the European Union and is an approved medicine, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q412327&quot;>Wikidata Q412327</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>nilotinib</td></tr><tr><td>ATC codes:</td><td>L01EA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB04868&quot;>DB04868</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/644241&quot;>644241</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:52172&quot;>52172</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q412327&quot;>Q412327</a></td></tr><tr><td>formula:</td><td>C28H22F3N7O</td></tr><tr><td>molar mass:</td><td>529.526 g/mol (PubChem)</td></tr></table></body></html>"));
end Nilotinib;
