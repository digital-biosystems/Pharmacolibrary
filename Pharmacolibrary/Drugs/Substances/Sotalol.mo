    logP = 0.2);
  annotation (Documentation(info = "<html><body><p>Sotalol is a non-selective beta blocker with additional antiarrhythmic activity, used to treat heart rhythm problems such as atrial fibrillation, ventricular fibrillation, and supraventricular tachycardia. It is an approved medicine that remains in use, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q413591\">Wikidata Q413591</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sotalol</td></tr><tr><td>ATC codes:</td><td>C07AA07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00489\">DB00489</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5253\">5253</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:63622\">63622</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q413591\">Q413591</a></td></tr><tr><td>formula:</td><td>C12H20N2O3S</td></tr><tr><td>molar mass:</td><td>272.363 g/mol (PubChem CID 5253)</td></tr><tr><td>logP:</td><td>0.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Sotalol;
