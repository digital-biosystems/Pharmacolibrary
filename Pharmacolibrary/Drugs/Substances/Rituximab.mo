within Pharmacolibrary.Drugs.Substances;
package Rituximab "rituximab"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "rituximab",
    atcCodes = {"L01FA01", "L01XC02"},
    drugbankId = "DB00073",
    wikidataId = "Q412323",
    M = 143.86);
  annotation (Documentation(info = "<html><body><p>Rituximab is a monoclonal antibody used to treat B-cell blood cancers such as non-Hodgkin and chronic lymphocytic leukemia and many autoimmune conditions including rheumatoid arthritis, vasculitis, and pemphigus. It is widely used and appears on the WHO essential medicines list, with several products authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q412323\">Wikidata Q412323</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>rituximab</td></tr><tr><td>ATC codes:</td><td>L01FA01, L01XC02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00073\">DB00073</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q412323\">Q412323</a></td></tr><tr><td>molar mass:</td><td>143860 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Rituximab;
