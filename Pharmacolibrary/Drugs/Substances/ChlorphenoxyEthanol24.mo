  annotation (Documentation(info = "<html><body><p>2-(4-Chlorophenoxy)ethanol is an antifungal agent used topically against fungal skin infections. It is classified as experimental, so it does not appear to be in routine clinical use today.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5103142\">Wikidata Q5103142</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>2-(4-chlorphenoxy)-ethanol</td></tr><tr><td>ATC codes:</td><td>D01AE06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11368\">DB11368</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5103142\">Q5103142</a></td></tr><tr><td>molar mass:</td><td>172.61 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>1.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
