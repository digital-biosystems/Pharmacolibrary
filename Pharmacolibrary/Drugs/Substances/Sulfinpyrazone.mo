  annotation (Documentation(info = "<html><body><p>Sulfinpyrazone is a uricosuric drug used to treat gout, and has also been used in heart conditions such as myocardial infarction, angina pectoris, and coronary artery disease. It is an approved medicine, though it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3790542&quot;>Wikidata Q3790542</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sulfinpyrazone</td></tr><tr><td>ATC codes:</td><td>M04AB02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01138&quot;>DB01138</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5342&quot;>5342</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9342&quot;>9342</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3790542&quot;>Q3790542</a></td></tr><tr><td>formula:</td><td>C23H20N2O3S</td></tr><tr><td>molar mass:</td><td>404.484 g/mol (PubChem)</td></tr></table></body></html>"));
