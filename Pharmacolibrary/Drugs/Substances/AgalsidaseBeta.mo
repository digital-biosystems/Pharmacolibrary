  annotation (Documentation(info = "<html><body><p>Agalsidase beta is an enzyme therapy used to treat Fabry disease, a lipid storage disorder. It is authorised in the European Union and remains in clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q20801779\">Wikidata Q20801779</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>agalsidase beta</td></tr><tr><td>ATC codes:</td><td>A16AB04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00103\">DB00103</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q20801779\">Q20801779</a></td></tr><tr><td>molar mass:</td><td>45351.6 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
