  annotation (Documentation(info = "<html><body><p>Golodirsen is a drug used to treat Duchenne muscular dystrophy. It is approved in the United States and remains investigational for some uses; it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q85763967\">Wikidata Q85763967</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>golodirsen</td></tr><tr><td>ATC codes:</td><td>M09AX08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB15593\">DB15593</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q85763967\">Q85763967</a></td></tr></table></body></html>"));
end Golodirsen;
