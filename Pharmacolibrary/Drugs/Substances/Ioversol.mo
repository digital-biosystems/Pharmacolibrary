    logP = -3);
  annotation (Documentation(info = "<html><body><p>Ioversol is an iodinated, low-osmolar X-ray contrast agent used to make body structures visible during imaging examinations. It is an approved contrast medium, sold as Optiray, and is used in medical imaging settings; it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6064187\">Wikidata Q6064187</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ioversol</td></tr><tr><td>ATC codes:</td><td>V08AB07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09134\">DB09134</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3741\">3741</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31717\">31717</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6064187\">Q6064187</a></td></tr><tr><td>formula:</td><td>C18H24I3N3O9</td></tr><tr><td>molar mass:</td><td>807.102 g/mol (PubChem CID 3741)</td></tr><tr><td>logP:</td><td>-3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Ioversol;
