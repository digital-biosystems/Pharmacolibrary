  annotation (Documentation(info = "<html><body><p>Nateglinide is an anti-diabetic medicine used to lower blood sugar in type 2 diabetes. It is an approved drug, though some European marketing authorisations have been withdrawn or lapsed.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2254797\">Wikidata Q2254797</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>nateglinide</td></tr><tr><td>ATC codes:</td><td>A10BX03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00731\">DB00731</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5311309\">5311309</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31897\">31897</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2254797\">Q2254797</a></td></tr><tr><td>formula:</td><td>C19H27NO3</td></tr><tr><td>molar mass:</td><td>317.429 g/mol (PubChem CID 5311309)</td></tr><tr><td>logP:</td><td>3.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
