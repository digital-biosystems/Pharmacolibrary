within Pharmacolibrary.Drugs.Substances;
package EtacrynicAcid "etacrynic acid"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "etacrynic acid",
    atcCodes = {"C03CC01"},
    drugbankId = "DB00903",
    pubchemCid = "3278",
    chebiId = "4876",
    wikidataId = "Q418571",
    formula = "C13H12Cl2O4",
    M = 0.303135,
    logP = 3.8);
  annotation (Documentation(info = "<html><body><p>Ethacrynic acid is a loop diuretic used to treat fluid retention and swelling caused by conditions such as congestive heart failure, pulmonary edema, nephrotic syndrome, liver cirrhosis, and arterial hypertension. It is an approved drug, though it is now used far less often than other loop diuretics, mainly when they cannot be used because of sulfa allergy.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q418571&quot;>Wikidata Q418571</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>etacrynic acid</td></tr><tr><td>ATC codes:</td><td>C03CC01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00903&quot;>DB00903</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3278&quot;>3278</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4876&quot;>4876</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q418571&quot;>Q418571</a></td></tr><tr><td>formula:</td><td>C13H12Cl2O4</td></tr><tr><td>molar mass:</td><td>303.135 g/mol (PubChem)</td></tr></table></body></html>"));
end EtacrynicAcid;
