within Pharmacolibrary.Drugs.Substances;
package Prasterone "prasterone"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "prasterone",
    atcCodes = {"A14AA07", "G03XX01"},
    drugbankId = "DB01708",
    pubchemCid = "5881",
    chebiId = "28689",
    wikidataId = "Q55630367",
    formula = "C19H28O2",
    M = 0.288431,
    logP = 3.2);
  annotation (Documentation(info = "<html><body><p>Prasterone (dehydroepiandrosterone) is a steroid hormone used as an anabolic agent and sex hormone, and in the European Union it is authorised for treating vaginal dryness and discomfort after menopause. It is approved in the European Union for postmenopausal use, and is also sold as a nutraceutical with some investigational uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q55630367\">Wikidata Q55630367</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>prasterone</td></tr><tr><td>ATC codes:</td><td>A14AA07, G03XX01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01708\">DB01708</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5881\">5881</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:28689\">28689</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q55630367\">Q55630367</a></td></tr><tr><td>formula:</td><td>C19H28O2</td></tr><tr><td>molar mass:</td><td>288.431 g/mol (PubChem CID 5881)</td></tr><tr><td>logP:</td><td>3.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Prasterone;
