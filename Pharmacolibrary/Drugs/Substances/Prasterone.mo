    logP = 3.2);
  annotation (Documentation(info = "<html><body><p>Prasterone (dehydroepiandrosterone) is a steroid hormone used as an anabolic agent and sex hormone, and in the European Union it is authorised for treating menopausal complaints after menopause. It is approved and also sold as a nutraceutical supplement, with some investigational uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q408376&quot;>Wikidata Q408376</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>prasterone</td></tr><tr><td>ATC codes:</td><td>A14AA07, G03XX01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01708&quot;>DB01708</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5881&quot;>5881</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:28689&quot;>28689</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q408376&quot;>Q408376</a></td></tr><tr><td>formula:</td><td>C19H28O2</td></tr><tr><td>molar mass:</td><td>288.431 g/mol (PubChem)</td></tr></table></body></html>"));
end Prasterone;
