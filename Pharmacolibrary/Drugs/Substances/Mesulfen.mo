  annotation (Documentation(info = "<html><body><p>Mesulfen is a sulfur-containing compound classified for topical anti-acne use and as a scabicide/ectoparasiticide. It appears only as an experimental drug, with no marketing authorisation information available, so its current use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q99434197\">Wikidata Q99434197</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mesulfen</td></tr><tr><td>ATC codes:</td><td>D10AB05, P03AA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13356\">DB13356</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/667491\">667491</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134995\">134995</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q99434197\">Q99434197</a></td></tr><tr><td>formula:</td><td>C14H12S2</td></tr><tr><td>molar mass:</td><td>244.37 g/mol (PubChem CID 667491)</td></tr><tr><td>logP:</td><td>4.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
