within Pharmacolibrary.Drugs.Substances;
package Indometacin "indometacin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "indometacin",
    atcCodes = {"C01EB03", "M01AB01", "M02AA23", "S01BC01"},
    drugbankId = "DB00328",
    pubchemCid = "3715",
    wikidataId = "Q409231",
    formula = "C19H16ClNO4",
    M = 0.35779,
    logP = 4.3);
  annotation (Documentation(info = "<html><body><p>Indometacin is a non-steroidal anti-inflammatory drug used to treat pain and inflammation in conditions such as osteoarthritis, rheumatoid arthritis, gout attacks, bursitis, enthesopathy, and to close a patent ductus arteriosus. It is an approved medicine, available in oral and topical forms for joint and muscular pain as well as eye use, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q409231&quot;>Wikidata Q409231</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>indometacin</td></tr><tr><td>ATC codes:</td><td>C01EB03, M01AB01, M02AA23, S01BC01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00328&quot;>DB00328</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3715&quot;>3715</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q409231&quot;>Q409231</a></td></tr><tr><td>formula:</td><td>C19H16ClNO4</td></tr><tr><td>molar mass:</td><td>357.79 g/mol (PubChem)</td></tr></table></body></html>"));
end Indometacin;
