  annotation (Documentation(info = "<html><body><p>Monomethyl fumarate is an immunosuppressant used to treat multiple sclerosis. It is an approved drug and remains in use, though it has also been studied investigationally.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27087639\">Wikidata Q27087639</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>monomethyl fumarate</td></tr><tr><td>ATC codes:</td><td>L04AX11</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB14219\">DB14219</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27087639\">Q27087639</a></td></tr><tr><td>formula:</td><td>C5H6O4</td></tr><tr><td>molar mass:</td><td>130.099 g/mol (knowledgebase (DrugBank calculated))</td></tr></table></body></html>"));
