  annotation (Documentation(info = "<html><body><p>Daridorexant is a hypnotic used to treat insomnia, helping people fall asleep and stay asleep. It is authorised in the European Union and is an approved medicine, though also still under investigation for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q55112806&quot;>Wikidata Q55112806</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>daridorexant</td></tr><tr><td>ATC codes:</td><td>N05CJ03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB15031&quot;>DB15031</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/91801202&quot;>91801202</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q55112806&quot;>Q55112806</a></td></tr><tr><td>formula:</td><td>C23H23ClN6O2</td></tr><tr><td>molar mass:</td><td>450.927 g/mol (PubChem)</td></tr></table></body></html>"));
end Daridorexant;
