  annotation (Documentation(info = "<html><body><p>Ferrous chloride is an oral bivalent iron preparation classified as an antianemic, used to treat iron deficiency anaemia. It is considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q407867&quot;>Wikidata Q407867</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ferrous chloride</td></tr><tr><td>ATC codes:</td><td>B03AA05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13569&quot;>DB13569</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:30812&quot;>30812</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q407867&quot;>Q407867</a></td></tr><tr><td>formula:</td><td>Cl2Fe</td></tr><tr><td>molar mass:</td><td>126.75 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end FerrousChloride;
