  annotation (Documentation(info = "<html><body><p>Methyltestosterone is an androgen steroid used for conditions such as hypogonadism, erectile dysfunction, and breast cancer. It is an approved drug, though its use today is limited, and it has also been studied for other investigational purposes.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q421768\">Wikidata Q421768</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>methyltestosterone</td></tr><tr><td>ATC codes:</td><td>G03BA02, G03EK01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06710\">DB06710</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6010\">6010</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:27436\">27436</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q421768\">Q421768</a></td></tr><tr><td>formula:</td><td>C20H30O2</td></tr><tr><td>molar mass:</td><td>302.458 g/mol (PubChem CID 6010)</td></tr><tr><td>logP:</td><td>3.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
