  annotation (Documentation(info = "<html><body><p>Bephenium is an antinematodal agent, historically used as an anthelmintic against roundworm infections. It is currently classed as experimental and does not appear to be an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4890905\">Wikidata Q4890905</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bephenium</td></tr><tr><td>ATC codes:</td><td>P02CX02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13462\">DB13462</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/19667\">19667</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135055\">135055</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4890905\">Q4890905</a></td></tr><tr><td>formula:</td><td>C17H22NO+</td></tr><tr><td>molar mass:</td><td>256.369 g/mol (PubChem CID 19667)</td></tr><tr><td>logP:</td><td>3.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
