  annotation (Documentation(info = "<html><body><p>Aciclovir is an antiviral drug used to treat infections such as chickenpox, shingles, herpes simplex including genital herpes, and related viral conditions. It is widely used and appears on the WHO list of essential medicines, available as topical, eye, and systemic antiviral preparations.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q147101\">Wikidata Q147101</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>aciclovir</td></tr><tr><td>ATC codes:</td><td>D06BB03, J05AB01, S01AD03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00787\">DB00787</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/135398513\">135398513</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q147101\">Q147101</a></td></tr><tr><td>formula:</td><td>C8H11N5O3</td></tr><tr><td>molar mass:</td><td>225.208 g/mol (PubChem CID 135398513)</td></tr><tr><td>logP:</td><td>-1.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Aciclovir;
