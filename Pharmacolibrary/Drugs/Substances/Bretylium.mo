  annotation (Documentation(info = "<html><body><p>Bretylium is a class III antiarrhythmic agent used to treat ventricular fibrillation and heart conduction disease. It is an approved drug, though it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q420026&quot;>Wikidata Q420026</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Bretylium</td></tr><tr><td>ATC codes:</td><td>C01BD02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01158&quot;>DB01158</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2431&quot;>2431</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q420026&quot;>Q420026</a></td></tr><tr><td>formula:</td><td>C11H17BrN+</td></tr><tr><td>molar mass:</td><td>243.168 g/mol (PubChem)</td></tr></table></body></html>"));
