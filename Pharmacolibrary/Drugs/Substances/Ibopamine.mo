    logP = 2.9);
  annotation (Documentation(info = "<html><body><p>Ibopamine is a dopamine agonist that has been used as a cardiotonic agent for heart conditions and as a mydriatic eye drop to dilate the pupil. It is currently considered an experimental drug and does not appear to have an authorised marketing status in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5984366\">Wikidata Q5984366</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ibopamine</td></tr><tr><td>ATC codes:</td><td>C01CA16, S01FB03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13316\">DB13316</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/68555\">68555</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135306\">135306</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5984366\">Q5984366</a></td></tr><tr><td>formula:</td><td>C17H25NO4</td></tr><tr><td>molar mass:</td><td>307.39 g/mol (PubChem CID 68555)</td></tr><tr><td>logP:</td><td>2.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Ibopamine;
