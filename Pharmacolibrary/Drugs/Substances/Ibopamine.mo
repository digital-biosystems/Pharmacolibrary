  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "ibopamine",
    atcCodes = {"C01CA16", "S01FB03"},
    drugbankId = "DB13316",
    pubchemCid = "68555",
    chebiId = "135306",
    wikidataId = "Q5984366",
