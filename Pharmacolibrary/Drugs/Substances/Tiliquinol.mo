  annotation (Documentation(info = "<html><body><p>Tiliquinol is a hydroxyquinoline derivative classified as an antiprotozoal agent against amoebiasis and other protozoal diseases. It is currently listed only as an experimental compound, with no marketing authorisation from the European Medicines Agency, so its present clinical use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27269198&quot;>Wikidata Q27269198</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Tiliquinol</td></tr><tr><td>ATC codes:</td><td>P01AA30</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB20266&quot;>DB20266</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/71208&quot;>71208</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134789&quot;>134789</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27269198&quot;>Q27269198</a></td></tr><tr><td>formula:</td><td>C10H9NO</td></tr><tr><td>molar mass:</td><td>159.188 g/mol (PubChem)</td></tr></table></body></html>"));
