  annotation (Documentation(info = "<html><body><p>Blinatumomab is a monoclonal antibody anticancer medicine used to treat a form of lymphoblastic leukaemia-lymphoma. It is authorised in the European Union and is also being studied for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q410189\">Wikidata Q410189</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>blinatumomab</td></tr><tr><td>ATC codes:</td><td>L01FX07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09052\">DB09052</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q410189\">Q410189</a></td></tr><tr><td>molar mass:</td><td>54100 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
