within Pharmacolibrary.Drugs.Substances;
package EthylEstersOfIodisedFattyAcids "ethyl esters of iodised fatty acids"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "ethyl esters of iodised fatty acids",
    atcCodes = {"V08AD01"},
    drugbankId = "DB00965",
    wikidataId = "Q4205889");
  annotation (Documentation(info = "<html><body><p>Ethiodized oil is an iodine-containing oil used as an X-ray contrast medium and also to treat iodine deficiency. It remains an approved medicine and is included on the WHO list of essential medicines, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4205889&quot;>Wikidata Q4205889</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ethyl esters of iodised fatty acids</td></tr><tr><td>ATC codes:</td><td>V08AD01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00965&quot;>DB00965</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4205889&quot;>Q4205889</a></td></tr></table></body></html>"));
end EthylEstersOfIodisedFattyAcids;
