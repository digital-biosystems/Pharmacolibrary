  annotation (Documentation(info = "<html><body><p>Flibanserin is a drug used to treat low sexual desire in premenopausal women. It is approved in the United States but not authorised in the European Union, and it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q415996&quot;>Wikidata Q415996</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>flibanserin</td></tr><tr><td>ATC codes:</td><td>G02CX02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB04908&quot;>DB04908</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6918248&quot;>6918248</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:90865&quot;>90865</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q415996&quot;>Q415996</a></td></tr><tr><td>formula:</td><td>C20H21F3N4O</td></tr><tr><td>molar mass:</td><td>390.409 g/mol (PubChem)</td></tr></table></body></html>"));
