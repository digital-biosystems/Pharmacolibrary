  annotation (Documentation(info = "<html><body><p>Anileridine is a synthetic opioid that was used as a painkiller and as an opioid anesthetic during surgery. It is no longer in use; it has been withdrawn from the market and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q742266&quot;>Wikidata Q742266</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>anileridine</td></tr><tr><td>ATC codes:</td><td>N01AH05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00913&quot;>DB00913</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/8944&quot;>8944</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:61203&quot;>61203</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q742266&quot;>Q742266</a></td></tr><tr><td>formula:</td><td>C22H28N2O2</td></tr><tr><td>molar mass:</td><td>352.478 g/mol (PubChem)</td></tr></table></body></html>"));
