    wikidataId = "Q582356");
  annotation (Documentation(info = "<html><body><p>Interferon gamma-1b is an immunostimulating protein that has been investigated for treating chronic granulomatous disease, osteopetrosis, and certain bacterial infections. It is considered investigational and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q582356&quot;>Wikidata Q582356</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>interferon gamma</td></tr><tr><td>ATC codes:</td><td>L03AB03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB15753&quot;>DB15753</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q582356&quot;>Q582356</a></td></tr></table></body></html>"));
end InterferonGamma;
