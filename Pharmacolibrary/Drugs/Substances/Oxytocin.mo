  annotation (Documentation(info = "<html><body><p>Oxytocin is a peptide hormone used as a uterotonic drug to induce or support labour and manage bleeding after childbirth. It is widely used in human medicine, appears on the WHO essential medicines list, and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q169960\">Wikidata Q169960</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>oxytocin</td></tr><tr><td>ATC codes:</td><td>H01BB02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00107\">DB00107</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q169960\">Q169960</a></td></tr><tr><td>molar mass:</td><td>1007.2 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>-2.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Oxytocin;
