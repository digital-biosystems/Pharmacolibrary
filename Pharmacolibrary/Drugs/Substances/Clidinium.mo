within Pharmacolibrary.Drugs.Substances;
package Clidinium "Clidinium"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "Clidinium",
    atcCodes = {"A03CA02"},
    drugbankId = "DB00771",
    pubchemCid = "2784",
    formula = "C22H26NO3+",
    M = 0.352454);
  annotation (Documentation(info = "<html><body><p>Clidinium is a synthetic anticholinergic antispasmodic used for functional gastrointestinal disorders, typically combined with a psycholeptic to relieve spasms and related symptoms. It is an approved medicine, though it is not authorised centrally in the European Union and is used mainly in other markets.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Clidinium</td></tr><tr><td>ATC codes:</td><td>A03CA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00771\">DB00771</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2784\">2784</a></td></tr><tr><td>formula:</td><td>C22H26NO3+</td></tr><tr><td>molar mass:</td><td>352.454 g/mol (PubChem CID 2784)</td></tr></table></body></html>"));
end Clidinium;
