within Pharmacolibrary.Drugs.Substances;
package MandelicAcid "mandelic acid"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "mandelic acid",
    atcCodes = {"B05CA06", "J01XX06"},
    drugbankId = "DB13218",
    chebiId = "35825",
    wikidataId = "Q72488153",
    formula = "C8H8O3",
    M = 0.152149,
    logP = 0.6);
  annotation (Documentation(info = "<html><body><p>Mandelic acid is an antibacterial agent that has been used, notably as a urinary antiseptic and in irrigating solutions, to treat or prevent bacterial infections. It remains an approved medicine and is used mainly as an ingredient in antibacterial irrigating solutions and other antibacterial preparations, rather than as a widely prescribed systemic antibiotic.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q72488153\">Wikidata Q72488153</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mandelic acid</td></tr><tr><td>ATC codes:</td><td>B05CA06, J01XX06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13218\">DB13218</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:35825\">35825</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q72488153\">Q72488153</a></td></tr><tr><td>formula:</td><td>C8H8O3</td></tr><tr><td>molar mass:</td><td>152.149 g/mol (knowledgebase (DrugBank calculated))</td></tr><tr><td>logP:</td><td>0.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end MandelicAcid;
