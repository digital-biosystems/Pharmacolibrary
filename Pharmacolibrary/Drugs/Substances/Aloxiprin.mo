within Pharmacolibrary.Drugs.Substances;
package Aloxiprin "aloxiprin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "aloxiprin",
    atcCodes = {"B01AC15", "N02BA02"},
    drugbankId = "DB13509",
    pubchemCid = "71586929",
    wikidataId = "Q27888708",
    formula = "C9H8Al2O7",
    M = 0.28212);
  annotation (Documentation(info = "<html><body><p>Aloxiprin, a polycondensate of aspirin and aluminium oxide, is a salicylic acid derivative classified as a platelet aggregation inhibitor and analgesic, suggesting use against pain and thrombosis. It is not an approved medicine in major databases, being listed only as experimental, so its current availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27888708\">Wikidata Q27888708</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>aloxiprin</td></tr><tr><td>ATC codes:</td><td>B01AC15, N02BA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13509\">DB13509</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/71586929\">71586929</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27888708\">Q27888708</a></td></tr><tr><td>formula:</td><td>C9H8Al2O7</td></tr><tr><td>molar mass:</td><td>282.12 g/mol (PubChem CID 71586929)</td></tr></table></body></html>"));
end Aloxiprin;
