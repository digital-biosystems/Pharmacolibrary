  annotation (Documentation(info = "<html><body><p>Ioxilan is a low-osmolar, water-soluble iodinated X-ray contrast agent used to improve imaging in radiographic examinations. It was approved but has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6064819&quot;>Wikidata Q6064819</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ioxilan</td></tr><tr><td>ATC codes:</td><td>V08AB12</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09135&quot;>DB09135</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3743&quot;>3743</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135884&quot;>135884</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6064819&quot;>Q6064819</a></td></tr><tr><td>formula:</td><td>C18H24I3N3O8</td></tr><tr><td>molar mass:</td><td>791.103 g/mol (PubChem)</td></tr></table></body></html>"));
