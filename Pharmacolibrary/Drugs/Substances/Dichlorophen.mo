within Pharmacolibrary.Drugs.Substances;
package Dichlorophen "dichlorophen"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "dichlorophen",
    atcCodes = {"P02DX02"},
    drugbankId = "DB11396",
    pubchemCid = "3037",
    chebiId = "34689",
    wikidataId = "Q377552",
