    M = 0.269121,
    logP = 4.3);
  annotation (Documentation(info = "<html><body><p>Dichlorophen is an anticestodal drug used to treat tapeworm infections, and it also has antifungal and antiprotozoal activity. It is approved for veterinary use, while human use remains investigational.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q377552\">Wikidata Q377552</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dichlorophen</td></tr><tr><td>ATC codes:</td><td>P02DX02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11396\">DB11396</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3037\">3037</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:34689\">34689</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q377552\">Q377552</a></td></tr><tr><td>formula:</td><td>C13H10Cl2O2</td></tr><tr><td>molar mass:</td><td>269.121 g/mol (PubChem CID 3037)</td></tr><tr><td>logP:</td><td>4.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Dichlorophen;
