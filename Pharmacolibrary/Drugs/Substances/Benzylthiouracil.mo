  annotation (Documentation(info = "<html><body><p>Benzylthiouracil is a thiouracil antithyroid drug used to treat overactive thyroid conditions. It is currently classed as experimental, with no authorised marketing identified in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4890823\">Wikidata Q4890823</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>benzylthiouracil</td></tr><tr><td>ATC codes:</td><td>H03BA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13804\">DB13804</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/685814\">685814</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134902\">134902</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4890823\">Q4890823</a></td></tr><tr><td>formula:</td><td>C11H10N2OS</td></tr><tr><td>molar mass:</td><td>218.274 g/mol (PubChem CID 685814)</td></tr><tr><td>logP:</td><td>1.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
