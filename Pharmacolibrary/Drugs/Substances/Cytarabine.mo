    logP = -2.1);
  annotation (Documentation(info = "<html><body><p>Cytarabine is an antineoplastic antimetabolite used to treat blood cancers such as acute myeloid leukemia, other leukemias, and several lymphomas, as well as myelodysplastic syndrome and meningeal tumors. It is an approved medicine, appears on the WHO essential medicines list, and is widely used in cancer care, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q180983&quot;>Wikidata Q180983</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>cytarabine</td></tr><tr><td>ATC codes:</td><td>L01BC01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00987&quot;>DB00987</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6253&quot;>6253</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:28680&quot;>28680</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q180983&quot;>Q180983</a></td></tr><tr><td>formula:</td><td>C9H13N3O5</td></tr><tr><td>molar mass:</td><td>243.219 g/mol (PubChem)</td></tr></table></body></html>"));
end Cytarabine;
