    logP = -3.1);
  annotation (Documentation(info = "<html><body><p>Carbocisteine is a mucolytic used for respiratory conditions such as chronic obstructive pulmonary disease, where it helps loosen mucus. It is an approved medicine, used mainly in cough and cold preparations as an expectorant/mucolytic.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q423408\">Wikidata Q423408</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>carbocisteine</td></tr><tr><td>ATC codes:</td><td>R05CB03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB04339\">DB04339</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/193653\">193653</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:16163\">16163</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q423408\">Q423408</a></td></tr><tr><td>formula:</td><td>C5H9NO4S</td></tr><tr><td>molar mass:</td><td>179.19 g/mol (PubChem CID 193653)</td></tr><tr><td>logP:</td><td>-3.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Carbocisteine;
