  annotation (Documentation(info = "<html><body><p>Lomitapide is a lipid-modifying medicine used to treat hypercholesterolaemia. It is authorised in the European Union, where one product is on the market, and is used only in a limited way for this rare condition.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1268941\">Wikidata Q1268941</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>lomitapide</td></tr><tr><td>ATC codes:</td><td>C10AX12</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08827\">DB08827</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9853053\">9853053</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:72297\">72297</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1268941\">Q1268941</a></td></tr><tr><td>formula:</td><td>C39H37F6N3O2</td></tr><tr><td>molar mass:</td><td>693.732 g/mol (PubChem CID 9853053)</td></tr><tr><td>logP:</td><td>8.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
