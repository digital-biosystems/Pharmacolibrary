  annotation (Documentation(info = "<html><body><p>Hexylresorcinol is an antiseptic used in throat preparations for sore throat, and has also been used as an anthelmintic. It is an approved drug, used mainly in throat lozenges and similar products.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q229969\">Wikidata Q229969</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>hexylresorcinol</td></tr><tr><td>ATC codes:</td><td>R02AA12</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11254\">DB11254</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3610\">3610</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:93749\">93749</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q229969\">Q229969</a></td></tr><tr><td>formula:</td><td>C12H18O2</td></tr><tr><td>molar mass:</td><td>194.274 g/mol (PubChem CID 3610)</td></tr><tr><td>logP:</td><td>3.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Hexylresorcinol;
