  annotation (Documentation(info = "<html><body><p>Tuaminoheptane is a sympathomimetic amine classified as a nasal decongestant for topical use. It is currently considered experimental, and its present availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4000097\">Wikidata Q4000097</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tuaminoheptane</td></tr><tr><td>ATC codes:</td><td>R01AA11, R01AB08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13238\">DB13238</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5603\">5603</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134753\">134753</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4000097\">Q4000097</a></td></tr><tr><td>formula:</td><td>C7H17N</td></tr><tr><td>molar mass:</td><td>115.22 g/mol (PubChem CID 5603)</td></tr><tr><td>logP:</td><td>2.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
