  annotation (Documentation(info = "<html><body><p>Bifemelane is an antidepressant that has also been described as a nootropic. It is not authorised in the European Union and is currently regarded as an experimental drug, so its present clinical use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4904728&quot;>Wikidata Q4904728</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bifemelane</td></tr><tr><td>ATC codes:</td><td>N06AX08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13550&quot;>DB13550</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2377&quot;>2377</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:92338&quot;>92338</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4904728&quot;>Q4904728</a></td></tr><tr><td>formula:</td><td>C18H23NO</td></tr><tr><td>molar mass:</td><td>269.388 g/mol (PubChem)</td></tr></table></body></html>"));
