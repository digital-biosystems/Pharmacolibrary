  annotation (Documentation(info = "<html><body><p>Bacitracin is an antibiotic used to treat bacterial infections, including staphylococcal infections, skin infections, and pseudomembranous colitis. It is an approved drug used mainly as a topical treatment for skin conditions, and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q424319\">Wikidata Q424319</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bacitracin</td></tr><tr><td>ATC codes:</td><td>D06AX05, J01XX10, R02AB04, S01AA32</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00626\">DB00626</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/10909430\">10909430</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:184381\">184381</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q424319\">Q424319</a></td></tr><tr><td>formula:</td><td>C66H103N17O16S</td></tr><tr><td>molar mass:</td><td>1422.71 g/mol (PubChem CID 10909430)</td></tr><tr><td>logP:</td><td>-4.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
