  annotation (Documentation(info = "<html><body><p>Orphenadrine chloride is an anticholinergic drug used to treat Parkinson's disease. It is an approved medicine, though not authorised in the European Union, and has also been investigated for other uses.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>orphenadrine (chloride)</td></tr><tr><td>ATC codes:</td><td>N04AB02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01173\">DB01173</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4601\">4601</a></td></tr><tr><td>formula:</td><td>C18H23NO</td></tr><tr><td>molar mass:</td><td>269.388 g/mol (PubChem CID 4601)</td></tr></table><p><small>Drugs.Common 25.09 gave 305.8 g/mol (+13.5 %); replaced by the value above</small></p></body></html>"));
end OrphenadrineChloride;
