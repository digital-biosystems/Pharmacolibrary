    logP = 6.5);
  annotation (Documentation(info = "<html><body><p>Cannabidiol is an antiepileptic medicine used to treat certain epilepsy syndromes, including Lennox–Gastaut syndrome and myoclonic epilepsies. It is an approved medicine with an authorised product in the European Union, and is also being studied for other investigational uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q422917&quot;>Wikidata Q422917</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>cannabidiol</td></tr><tr><td>ATC codes:</td><td>N03AX24</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09061&quot;>DB09061</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/644019&quot;>644019</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:69478&quot;>69478</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q422917&quot;>Q422917</a></td></tr><tr><td>formula:</td><td>C21H30O2</td></tr><tr><td>molar mass:</td><td>314.469 g/mol (PubChem)</td></tr></table></body></html>"));
end Cannabidiol;
