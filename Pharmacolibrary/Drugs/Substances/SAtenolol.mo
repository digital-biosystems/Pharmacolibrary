  annotation (Documentation(info = "<html><body><p>Esatenolol, the S-enantiomer of atenolol, is a selective beta blocker studied for treating myocardial infarction and arterial hypertension. It remains an experimental compound and is not an established marketed medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q24255323&quot;>Wikidata Q24255323</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>s-atenolol</td></tr><tr><td>ATC codes:</td><td>C07AB11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13443&quot;>DB13443</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/175540&quot;>175540</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31556&quot;>31556</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q24255323&quot;>Q24255323</a></td></tr><tr><td>formula:</td><td>C14H22N2O3</td></tr><tr><td>molar mass:</td><td>266.341 g/mol (PubChem)</td></tr></table></body></html>"));
