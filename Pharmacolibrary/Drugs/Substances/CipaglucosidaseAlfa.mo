  annotation (Documentation(info = "<html><body><p>Cipaglucosidase alfa is an enzyme therapy used to treat glycogen storage disease type II (Pompe disease). It is authorised in the European Union.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>cipaglucosidase alfa</td></tr><tr><td>ATC codes:</td><td>A16AB23</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB16708&quot;>DB16708</a></td></tr><tr><td>molar mass:</td><td>99400 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
