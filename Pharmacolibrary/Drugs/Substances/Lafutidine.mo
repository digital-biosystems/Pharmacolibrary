  annotation (Documentation(info = "<html><body><p>Lafutidine is an H2-receptor antagonist developed as an anti-ulcer drug for acid-related disorders such as peptic ulcer and gastro-oesophageal reflux disease. It is considered investigational and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q582556&quot;>Wikidata Q582556</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>lafutidine</td></tr><tr><td>ATC codes:</td><td>A02BA08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12770&quot;>DB12770</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5282136&quot;>5282136</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31759&quot;>31759</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q582556&quot;>Q582556</a></td></tr><tr><td>formula:</td><td>C22H29N3O4S</td></tr><tr><td>molar mass:</td><td>431.551 g/mol (PubChem)</td></tr></table></body></html>"));
