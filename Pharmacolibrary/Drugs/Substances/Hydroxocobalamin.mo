within Pharmacolibrary.Drugs.Substances;
package Hydroxocobalamin "hydroxocobalamin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "hydroxocobalamin",
    atcCodes = {"B03BA03", "V03AB33"},
    drugbankId = "DB00200",
    pubchemCid = "70678542",
    chebiId = "27786",
    wikidataId = "Q73972",
    formula = "C62H90CoN13O15P-2",
    M = 1.34739);
  annotation (Documentation(info = "<html><body><p>Hydroxocobalamin, a vitamin B12 preparation, is used to treat vitamin B12 deficiency such as pernicious anemia and certain neuropathies, and also serves as an antidote for poisoning. It is an approved medicine included on the WHO essential medicines list, and an EMA-authorised product is available in the European Union for treating poisoning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q73972\">Wikidata Q73972</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>hydroxocobalamin</td></tr><tr><td>ATC codes:</td><td>B03BA03, V03AB33</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00200\">DB00200</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/70678542\">70678542</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:27786\">27786</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q73972\">Q73972</a></td></tr><tr><td>formula:</td><td>C62H90CoN13O15P-2</td></tr><tr><td>molar mass:</td><td>1347.38 g/mol (PubChem CID 70678542)</td></tr></table></body></html>"));
end Hydroxocobalamin;
