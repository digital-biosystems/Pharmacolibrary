  annotation (Documentation(info = "<html><body><p>Efalizumab, a monoclonal antibody immunosuppressant, was used to treat psoriasis. It was withdrawn from the market, including in the European Union, and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q418270\">Wikidata Q418270</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>efalizumab</td></tr><tr><td>ATC codes:</td><td>L04AA21, L04AG02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00095\">DB00095</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q418270\">Q418270</a></td></tr></table></body></html>"));
end Efalizumab;
