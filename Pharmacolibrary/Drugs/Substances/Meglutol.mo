  annotation (Documentation(info = "<html><body><p>Meglutol is a lipid-lowering agent classified among other lipid modifying agents, used to lower cholesterol. It appears only as an experimental drug, with no marketing authorisation from the European Medicines Agency, so its current availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q524670\">Wikidata Q524670</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>meglutol</td></tr><tr><td>ATC codes:</td><td>C10AX05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB04377\">DB04377</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/1662\">1662</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:16831\">16831</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q524670\">Q524670</a></td></tr><tr><td>formula:</td><td>C6H10O5</td></tr><tr><td>molar mass:</td><td>162.141 g/mol (PubChem CID 1662)</td></tr><tr><td>logP:</td><td>-1.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Meglutol;
