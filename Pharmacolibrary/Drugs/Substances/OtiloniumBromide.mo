  annotation (Documentation(info = "<html><body><p>Otilonium bromide is an antispasmodic drug used for functional gastrointestinal disorders such as irritable bowel syndrome. It is not approved in the United States and remains investigational there, though it has been used in some other countries.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27263551&quot;>Wikidata Q27263551</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>otilonium bromide</td></tr><tr><td>ATC codes:</td><td>A03AB06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13500&quot;>DB13500</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/72093&quot;>72093</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135780&quot;>135780</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27263551&quot;>Q27263551</a></td></tr><tr><td>formula:</td><td>C29H43N2O4+</td></tr><tr><td>molar mass:</td><td>483.673 g/mol (PubChem)</td></tr></table></body></html>"));
