  annotation (Documentation(info = "<html><body><p>Otilonium bromide is an antispasmodic drug used for functional gastrointestinal disorders such as irritable bowel syndrome. It is not approved in the United States and remains investigational there, though it has been used in some other countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27263551\">Wikidata Q27263551</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>otilonium bromide</td></tr><tr><td>ATC codes:</td><td>A03AB06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13500\">DB13500</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/72093\">72093</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135780\">135780</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27263551\">Q27263551</a></td></tr><tr><td>formula:</td><td>C29H43N2O4+</td></tr><tr><td>molar mass:</td><td>483.673 g/mol (PubChem CID 72093)</td></tr></table><p><small>Drugs.Common 25.09 gave 563.6 g/mol (+16.5 %); replaced by the value above</small></p></body></html>"));
end OtiloniumBromide;
