  annotation (Documentation(info = "<html><body><p>Samarium (153Sm) lexidronam is a radiopharmaceutical used to relieve pain from cancer that has spread to the bones. It is an approved medicine, with one product authorised in the European Union, and is used for bone pain palliation.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q20817238&quot;>Wikidata Q20817238</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>samarium (153Sm) lexidronam</td></tr><tr><td>ATC codes:</td><td>V10BX02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB05273&quot;>DB05273</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q20817238&quot;>Q20817238</a></td></tr><tr><td>molar mass:</td><td>586.02 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
