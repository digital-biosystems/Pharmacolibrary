within Pharmacolibrary.Drugs.Substances;
package Tinidazole "tinidazole"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "tinidazole",
    atcCodes = {"G01AF21", "J01XD02", "P01AB02"},
    drugbankId = "DB00911",
    pubchemCid = "5479",
    chebiId = "63627",
    wikidataId = "Q1321320",
    formula = "C8H13N3O4S",
    M = 0.247269,
    logP = -0.4);
  annotation (Documentation(info = "<html><body><p>Tinidazole is a nitroimidazole antimicrobial used to treat protozoal infections such as giardiasis and amebiasis, and also as an antibacterial, including in combination regimens for eradicating Helicobacter pylori. It is an approved medicine, used in various countries, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1321320\">Wikidata Q1321320</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tinidazole</td></tr><tr><td>ATC codes:</td><td>G01AF21, J01XD02, P01AB02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00911\">DB00911</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5479\">5479</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:63627\">63627</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1321320\">Q1321320</a></td></tr><tr><td>formula:</td><td>C8H13N3O4S</td></tr><tr><td>molar mass:</td><td>247.269 g/mol (PubChem CID 5479)</td></tr><tr><td>logP:</td><td>-0.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Tinidazole;
