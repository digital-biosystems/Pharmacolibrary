  annotation (Documentation(info = "<html><body><p>Trypan blue is a dye used in eye surgery, where it helps surgeons visualise tissue during procedures such as cataract surgery. It is an approved medicine and is used in ophthalmology as a surgical aid.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q419642&quot;>Wikidata Q419642</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>trypan blue</td></tr><tr><td>ATC codes:</td><td>S01KX02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09158&quot;>DB09158</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/9562061&quot;>9562061</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:78900&quot;>78900</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q419642&quot;>Q419642</a></td></tr><tr><td>formula:</td><td>C34H24N6Na4O14S4</td></tr><tr><td>molar mass:</td><td>960.794 g/mol (PubChem)</td></tr></table></body></html>"));
end TrypanBlue;
