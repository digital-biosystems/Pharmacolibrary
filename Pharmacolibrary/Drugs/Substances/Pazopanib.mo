    logP = 3.1);
  annotation (Documentation(info = "<html><body><p>Pazopanib is a protein kinase inhibitor used to treat kidney cancer, especially renal cell carcinoma, and other tumours such as gastrointestinal stromal tumours and soft-tissue sarcomas. It is an approved anticancer medicine authorised in the European Union for renal cell carcinoma.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7157043&quot;>Wikidata Q7157043</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>pazopanib</td></tr><tr><td>ATC codes:</td><td>L01EX03, L01XE11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06589&quot;>DB06589</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/10113978&quot;>10113978</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:71219&quot;>71219</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7157043&quot;>Q7157043</a></td></tr><tr><td>formula:</td><td>C21H23N7O2S</td></tr><tr><td>molar mass:</td><td>437.522 g/mol (PubChem)</td></tr></table></body></html>"));
end Pazopanib;
