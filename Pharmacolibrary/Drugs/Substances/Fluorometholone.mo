  annotation (Documentation(info = "<html><body><p>Fluorometholone is a corticosteroid used to treat inflammation, including inflammatory eye conditions and skin disorders. It is an approved medicine, applied topically to the eye or skin, and is available in many combination products.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q607349\">Wikidata Q607349</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>fluorometholone</td></tr><tr><td>ATC codes:</td><td>C05AA06, D07AB06, D07XB04, D10AA01, S01BA07, S01CB05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00324\">DB00324</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9878\">9878</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31625\">31625</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q607349\">Q607349</a></td></tr><tr><td>formula:</td><td>C22H29FO4</td></tr><tr><td>molar mass:</td><td>376.468 g/mol (PubChem CID 9878)</td></tr><tr><td>logP:</td><td>2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
