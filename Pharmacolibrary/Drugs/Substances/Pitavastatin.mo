  annotation (Documentation(info = "<html><body><p>Pitavastatin is a statin (HMG CoA reductase inhibitor) used to treat dyslipidemia, including rare forms of dyslipidemia. It is an approved medicine and is used in lipid-lowering therapy, both alone and in combination products with other lipid-modifying agents.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q412677\">Wikidata Q412677</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pitavastatin</td></tr><tr><td>ATC codes:</td><td>C10AA08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08860\">DB08860</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5282452\">5282452</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32020\">32020</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q412677\">Q412677</a></td></tr><tr><td>formula:</td><td>C25H24FNO4</td></tr><tr><td>molar mass:</td><td>421.468 g/mol (PubChem CID 5282452)</td></tr><tr><td>logP:</td><td>3.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
