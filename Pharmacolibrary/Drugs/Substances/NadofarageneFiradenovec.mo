  annotation (Documentation(info = "<html><body><p>Nadofaragene firadenovec is a gene-therapy anticancer medicine used to treat non-muscle invasive bladder cancer. It is approved and authorised in the European Union, though it remains a specialised, recently introduced treatment rather than a widely used one.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>nadofaragene firadenovec</td></tr><tr><td>ATC codes:</td><td>L01XL10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB17381\">DB17381</a></td></tr></table></body></html>"));
