  annotation (Documentation(info = "<html><body><p>Desoxycortone (deoxycorticosterone) is a mineralocorticoid steroid, a corticosteroid acting on salt and water balance. It is classified as an experimental drug, so it does not appear to be in routine clinical use today.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q948846&quot;>Wikidata Q948846</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>desoxycortone</td></tr><tr><td>ATC codes:</td><td>H02AA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB15972&quot;>DB15972</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6166&quot;>6166</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q948846&quot;>Q948846</a></td></tr><tr><td>formula:</td><td>C21H30O3</td></tr><tr><td>molar mass:</td><td>330.468 g/mol (PubChem)</td></tr></table></body></html>"));
