    M = 142.612);
  annotation (Documentation(info = "<html><body><p>Daclizumab, a monoclonal antibody immunosuppressant, was used to treat multiple sclerosis and to prevent graft rejection in kidney transplantation. It has been withdrawn from the market, including its authorised products in the European Union, and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q412920\">Wikidata Q412920</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>daclizumab</td></tr><tr><td>ATC codes:</td><td>L04AA08, L04AC01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00111\">DB00111</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q412920\">Q412920</a></td></tr><tr><td>molar mass:</td><td>142612 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Daclizumab;
