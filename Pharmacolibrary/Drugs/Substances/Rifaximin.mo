    logP = 6.9);
  annotation (Documentation(info = "<html><body><p>Rifaximin is an antibiotic used for intestinal conditions such as liver cirrhosis with encephalopathy, irritable bowel syndrome, and other liver disease. It is an approved medicine, given by mouth as an intestinal anti-infective and also used topically on the skin.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q416073&quot;>Wikidata Q416073</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>rifaximin</td></tr><tr><td>ATC codes:</td><td>A07AA11, D06AX11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01220&quot;>DB01220</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6436173&quot;>6436173</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:75246&quot;>75246</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q416073&quot;>Q416073</a></td></tr><tr><td>formula:</td><td>C43H51N3O11</td></tr><tr><td>molar mass:</td><td>785.891 g/mol (PubChem)</td></tr></table></body></html>"));
end Rifaximin;
