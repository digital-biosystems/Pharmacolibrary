    M = 0.095205);
  annotation (Documentation(info = "<html><body><p>Magnesium chloride is a magnesium salt used as a mineral supplement to treat or prevent magnesium deficiency, and as an additive in intravenous electrolyte solutions. It is an approved medicine, widely available as a supplement, and also used in hospital settings for infusion solutions.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q265414\">Wikidata Q265414</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>magnesium chloride</td></tr><tr><td>ATC codes:</td><td>A12CC01, B05XA11</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09407\">DB09407</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5360315\">5360315</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6636\">6636</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q265414\">Q265414</a></td></tr><tr><td>formula:</td><td>Cl2Mg</td></tr><tr><td>molar mass:</td><td>95.205 g/mol (PubChem CID 5360315)</td></tr></table></body></html>"));
end MagnesiumChloride;
