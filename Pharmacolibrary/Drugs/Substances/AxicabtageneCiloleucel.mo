within Pharmacolibrary.Drugs.Substances;
package AxicabtageneCiloleucel "axicabtagene ciloleucel"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "axicabtagene ciloleucel",
    atcCodes = {"L01XL03", "L01XX70"},
    drugbankId = "DB13915");
  annotation (Documentation(info = "<html><body><p>Axicabtagene ciloleucel is a cell and gene therapy anticancer medicine used to treat certain lymphomas, including diffuse large B-cell lymphoma and follicular lymphoma. It is authorised in the European Union and used in specialist care for these blood cancers.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>axicabtagene ciloleucel</td></tr><tr><td>ATC codes:</td><td>L01XL03, L01XX70</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13915\">DB13915</a></td></tr></table></body></html>"));
end AxicabtageneCiloleucel;
