  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "tolperisone",
    atcCodes = {"M02AX06", "M03BX04"},
    drugbankId = "DB06264",
    pubchemCid = "5511",
    chebiId = "93835",
    wikidataId = "Q369648",
    formula = "C16H23NO",
    M = 0.245366,
    logP = 3.4);
  annotation (Documentation(info = "<html><body><p>Tolperisone is a centrally acting muscle relaxant used for painful muscle spasms and musculoskeletal conditions. It is not authorised in the European Union and is considered investigational; it is used mainly in some countries outside the EU.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q369648&quot;>Wikidata Q369648</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tolperisone</td></tr><tr><td>ATC codes:</td><td>M02AX06, M03BX04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06264&quot;>DB06264</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5511&quot;>5511</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:93835&quot;>93835</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q369648&quot;>Q369648</a></td></tr><tr><td>formula:</td><td>C16H23NO</td></tr><tr><td>molar mass:</td><td>245.366 g/mol (PubChem)</td></tr></table></body></html>"));
end Tolperisone;
