  annotation (Documentation(info = "<html><body><p>Nebivolol is a selective beta blocker used to treat high blood pressure (arterial hypertension). It is an approved medicine, available alone and in fixed combinations with thiazides, calcium channel blockers, ACE inhibitors, ARBs, or lipid-lowering drugs.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q418130&quot;>Wikidata Q418130</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nebivolol</td></tr><tr><td>ATC codes:</td><td>C07AB12</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB04861&quot;>DB04861</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/71301&quot;>71301</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:64019&quot;>64019</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q418130&quot;>Q418130</a></td></tr><tr><td>formula:</td><td>C22H25F2NO4</td></tr><tr><td>molar mass:</td><td>405.441 g/mol (PubChem)</td></tr></table></body></html>"));
