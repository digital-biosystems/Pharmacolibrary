    drugbankId = "DB16784");
  annotation (Documentation(info = "<html><body><p>Rebisufligene etisparvovec is an investigational gene therapy being studied for mucopolysaccharidosis type IIIA (Sanfilippo syndrome type A), a rare inherited metabolic disorder. It is not yet approved; it remains in clinical development and is not authorised for routine use.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>rebisufligene etisparvovec</td></tr><tr><td>ATC codes:</td><td>A16AB29</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB16784&quot;>DB16784</a></td></tr></table></body></html>"));
end RebisufligeneEtisparvovec;
