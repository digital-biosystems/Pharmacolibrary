  annotation (Documentation(info = "<html><body><p>Carumonam is a monobactam antibiotic intended to treat bacterial infections. It remains experimental and is not widely used or authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5047478&quot;>Wikidata Q5047478</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>carumonam</td></tr><tr><td>ATC codes:</td><td>J01DF02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13553&quot;>DB13553</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6540466&quot;>6540466</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:55486&quot;>55486</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5047478&quot;>Q5047478</a></td></tr><tr><td>formula:</td><td>C12H14N6O10S2</td></tr><tr><td>molar mass:</td><td>466.396 g/mol (PubChem)</td></tr></table></body></html>"));
