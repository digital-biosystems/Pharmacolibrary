  annotation (Documentation(info = "<html><body><p>Arimoclomol is a nervous system drug developed for Niemann-Pick disease type C. Although it has been approved as a medicine, a marketing application for it in the European Union was withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4790694\">Wikidata Q4790694</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>arimoclomol</td></tr><tr><td>ATC codes:</td><td>N07XX17</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB05025\">DB05025</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/208924\">208924</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4790694\">Q4790694</a></td></tr><tr><td>formula:</td><td>C14H20ClN3O3</td></tr><tr><td>molar mass:</td><td>313.782 g/mol (PubChem CID 208924)</td></tr><tr><td>logP:</td><td>1.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
