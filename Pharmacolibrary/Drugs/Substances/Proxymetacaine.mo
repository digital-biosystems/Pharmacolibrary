  annotation (Documentation(info = "<html><body><p>Proxymetacaine (also known as proparacaine) is a local anesthetic used in ophthalmology to numb the eye. It is an approved medicine, including veterinary use, and is commonly used as an eye drop for short procedures and examinations.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q600867\">Wikidata Q600867</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>proxymetacaine</td></tr><tr><td>ATC codes:</td><td>S01HA04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00807\">DB00807</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4935\">4935</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8485\">8485</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q600867\">Q600867</a></td></tr><tr><td>formula:</td><td>C16H26N2O3</td></tr><tr><td>molar mass:</td><td>294.395 g/mol (PubChem CID 4935)</td></tr><tr><td>logP:</td><td>2.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
