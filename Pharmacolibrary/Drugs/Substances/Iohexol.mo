  annotation (Documentation(info = "<html><body><p>Iohexol is an iodinated X-ray contrast agent used to visualise tissues and blood vessels during imaging procedures. It is widely used in medical imaging and is included on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q410683\">Wikidata Q410683</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>iohexol</td></tr><tr><td>ATC codes:</td><td>V08AB02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01362\">DB01362</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3730\">3730</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31709\">31709</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q410683\">Q410683</a></td></tr><tr><td>formula:</td><td>C19H26I3N3O9</td></tr><tr><td>molar mass:</td><td>821.129 g/mol (PubChem CID 3730)</td></tr><tr><td>logP:</td><td>-3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
