within Pharmacolibrary.Drugs.Substances;
package Panitumumab "panitumumab"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "panitumumab",
    atcCodes = {"L01FE02", "L01XC08"},
    drugbankId = "DB01269",
    wikidataId = "Q417775");
  annotation (Documentation(info = "<html><body><p>Panitumumab is a monoclonal antibody that blocks EGFR and is used to treat colorectal cancers, including colon and rectal cancer. It is authorised in the European Union for colorectal cancer and is an approved drug, though it also remains under investigation for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q417775&quot;>Wikidata Q417775</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>panitumumab</td></tr><tr><td>ATC codes:</td><td>L01FE02, L01XC08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01269&quot;>DB01269</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q417775&quot;>Q417775</a></td></tr></table></body></html>"));
end Panitumumab;
