  annotation (Documentation(info = "<html><body><p>Colestilan is a phosphate binder that was used to treat hyperphosphatemia. It is no longer used; its European Union marketing authorisation was withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4117076\">Wikidata Q4117076</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>colestilan</td></tr><tr><td>ATC codes:</td><td>V03AE06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11634\">DB11634</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/65840\">65840</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4117076\">Q4117076</a></td></tr><tr><td>formula:</td><td>C7H11ClN2O</td></tr><tr><td>molar mass:</td><td>174.628 g/mol (PubChem CID 65840)</td></tr></table></body></html>"));
