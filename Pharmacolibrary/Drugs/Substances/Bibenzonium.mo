  annotation (Documentation(info = "<html><body><p>Bibenzonium is a cough suppressant that has been used to relieve coughing. It is not an established marketed medicine today; it appears only as an experimental compound, with no authorisation in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4902992&quot;>Wikidata Q4902992</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Bibenzonium</td></tr><tr><td>ATC codes:</td><td>R05DB12</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13630&quot;>DB13630</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/71954&quot;>71954</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4902992&quot;>Q4902992</a></td></tr><tr><td>formula:</td><td>C19H26NO+</td></tr><tr><td>molar mass:</td><td>284.423 g/mol (PubChem)</td></tr></table></body></html>"));
