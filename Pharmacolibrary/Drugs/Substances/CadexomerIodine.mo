  annotation (Documentation(info = "<html><body><p>Cadexomer iodine is a local anti-infective agent used in preparations for treating wounds and ulcers to help them heal. It is classified as investigational in DrugBank, so it does not appear to be an approved, widely used medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3649449&quot;>Wikidata Q3649449</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cadexomer iodine</td></tr><tr><td>ATC codes:</td><td>D03AX01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB16572&quot;>DB16572</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3649449&quot;>Q3649449</a></td></tr></table></body></html>"));
end CadexomerIodine;
