    logP = 0.4);
  annotation (Documentation(info = "<html><body><p>Pipobroman is an alkylating anticancer drug used to treat leukemia, especially chronic myeloid leukemia, and polycythemia vera. It is an approved medicine, but it is not authorised in the European Union and appears to be only rarely used.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q15366704\">Wikidata Q15366704</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pipobroman</td></tr><tr><td>ATC codes:</td><td>L01AX02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00236\">DB00236</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4842\">4842</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8242\">8242</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q15366704\">Q15366704</a></td></tr><tr><td>formula:</td><td>C10H16Br2N2O2</td></tr><tr><td>molar mass:</td><td>356.058 g/mol (PubChem CID 4842)</td></tr><tr><td>logP:</td><td>0.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
