  annotation (Documentation(info = "<html><body><p>Avelumab is a fully human anti-PD-L1 monoclonal antibody used as cancer immunotherapy, studied for tumours including Merkel cell carcinoma, bladder, ovarian, stomach, kidney, head and neck, and lung cancers, and mesothelioma. It is an approved anticancer medicine, with additional uses still under investigation.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q21083261\">Wikidata Q21083261</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>avelumab</td></tr><tr><td>ATC codes:</td><td>L01FF04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11945\">DB11945</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q21083261\">Q21083261</a></td></tr><tr><td>molar mass:</td><td>147000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Avelumab;
