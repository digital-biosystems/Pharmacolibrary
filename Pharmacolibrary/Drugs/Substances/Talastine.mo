  annotation (Documentation(info = "<html><body><p>Talastine is a substituted alkylamine antihistamine for systemic use, intended for allergic and respiratory conditions. It is considered an experimental compound and does not appear to be an approved medicine today, so its current availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6578658&quot;>Wikidata Q6578658</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>talastine</td></tr><tr><td>ATC codes:</td><td>R06AB07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13349&quot;>DB13349</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/65624&quot;>65624</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135308&quot;>135308</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6578658&quot;>Q6578658</a></td></tr><tr><td>formula:</td><td>C19H21N3O</td></tr><tr><td>molar mass:</td><td>307.397 g/mol (PubChem)</td></tr></table></body></html>"));
