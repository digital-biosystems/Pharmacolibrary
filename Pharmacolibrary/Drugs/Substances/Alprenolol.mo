  annotation (Documentation(info = "<html><body><p>Alprenolol is a non-selective beta blocker that was used to treat high blood pressure, unstable angina, and heart attack, and also acted against rhythm disturbances. It has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q201370\">Wikidata Q201370</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>alprenolol</td></tr><tr><td>ATC codes:</td><td>C07AA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00866\">DB00866</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2119\">2119</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:51211\">51211</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q201370\">Q201370</a></td></tr><tr><td>formula:</td><td>C15H23NO2</td></tr><tr><td>molar mass:</td><td>249.354 g/mol (PubChem CID 2119)</td></tr><tr><td>logP:</td><td>3.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
