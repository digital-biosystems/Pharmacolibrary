  annotation (Documentation(info = "<html><body><p>Cefmenoxime is a third-generation cephalosporin antibiotic used to treat bacterial infections. It is an approved antibiotic, available for systemic use as well as in eye and ear preparations.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4921166&quot;>Wikidata Q4921166</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cefmenoxime</td></tr><tr><td>ATC codes:</td><td>J01DD05, S01AA31, S02AA18</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00267&quot;>DB00267</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/9570757&quot;>9570757</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:55490&quot;>55490</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4921166&quot;>Q4921166</a></td></tr><tr><td>formula:</td><td>C16H17N9O5S3</td></tr><tr><td>molar mass:</td><td>511.55 g/mol (PubChem)</td></tr></table></body></html>"));
