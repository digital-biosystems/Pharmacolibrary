  annotation (Documentation(info = "<html><body><p>Iptacopan is a complement inhibitor used to treat paroxysmal nocturnal hemoglobinuria. It is an approved medicine authorised in the European Union, with further uses still under investigation.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q76803684\">Wikidata Q76803684</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>iptacopan</td></tr><tr><td>ATC codes:</td><td>L04AJ08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB16200\">DB16200</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/90467622\">90467622</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q76803684\">Q76803684</a></td></tr><tr><td>formula:</td><td>C25H30N2O4</td></tr><tr><td>molar mass:</td><td>422.525 g/mol (PubChem CID 90467622)</td></tr><tr><td>logP:</td><td>1.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
