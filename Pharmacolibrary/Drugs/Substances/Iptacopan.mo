  annotation (Documentation(info = "<html><body><p>Iptacopan is a complement inhibitor used to treat paroxysmal nocturnal hemoglobinuria. It is an approved medicine authorised in the European Union, with further uses still under investigation.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q76803684&quot;>Wikidata Q76803684</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>iptacopan</td></tr><tr><td>ATC codes:</td><td>L04AJ08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB16200&quot;>DB16200</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/90467622&quot;>90467622</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q76803684&quot;>Q76803684</a></td></tr><tr><td>formula:</td><td>C25H30N2O4</td></tr><tr><td>molar mass:</td><td>422.525 g/mol (PubChem)</td></tr></table></body></html>"));
