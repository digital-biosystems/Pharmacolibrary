    logP = -5.8);
  annotation (Documentation(info = "<html><body><p>Terlipressin, a vasopressin analogue, is used to treat hepatorenal syndrome and bleeding esophageal varices. It is an approved drug used in hospital settings for these serious liver-related conditions, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q324147&quot;>Wikidata Q324147</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>terlipressin</td></tr><tr><td>ATC codes:</td><td>H01BA04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB02638&quot;>DB02638</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/72081&quot;>72081</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135905&quot;>135905</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q324147&quot;>Q324147</a></td></tr><tr><td>formula:</td><td>C52H74N16O15S2</td></tr><tr><td>molar mass:</td><td>1227.38 g/mol (PubChem)</td></tr></table></body></html>"));
end Terlipressin;
