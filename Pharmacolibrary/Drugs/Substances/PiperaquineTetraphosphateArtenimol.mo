  annotation (Documentation(info = "<html><body><p>This fixed-dose combination of piperaquine and artenimol (dihydroartemisinin) is used to treat malaria. It is an approved antimalarial medicine used in several countries, though not authorised across the whole European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q115970631\">Wikidata Q115970631</a>; not checked by a person.</small></p><table><tr><td>name:</td><td>piperaquine tetraphosphate;artenimol</td></tr><tr><td>ATC codes:</td><td>—</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11638\">DB11638</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135921\">135921</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q115970631\">Q115970631</a></td></tr><tr><td>formula:</td><td>C15H24O5</td></tr><tr><td>molar mass:</td><td>284.352 g/mol (knowledgebase (DrugBank calculated))</td></tr></table></body></html>"));
