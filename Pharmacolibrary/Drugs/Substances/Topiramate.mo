    logP = -0.8);
  annotation (Documentation(info = "<html><body><p>Topiramate is an anticonvulsant used to treat epilepsy and seizures, and also migraine; it has additionally been used for pain, bipolar disorder, and other conditions. It is an approved medicine used widely for epilepsy and migraine prevention, and is also classed as a centrally acting antiobesity product.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q221174\">Wikidata Q221174</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>topiramate</td></tr><tr><td>ATC codes:</td><td>N03AX11</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00273\">DB00273</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5284627\">5284627</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:63631\">63631</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q221174\">Q221174</a></td></tr><tr><td>formula:</td><td>C12H21NO8S</td></tr><tr><td>molar mass:</td><td>339.359 g/mol (PubChem CID 5284627)</td></tr><tr><td>logP:</td><td>-0.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Topiramate;
