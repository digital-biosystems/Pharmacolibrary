  annotation (Documentation(info = "<html><body><p>Clopenthixol is a thioxanthene antipsychotic and dopamine antagonist used in the treatment of psychotic disorders such as schizophrenia. It is not an approved medicine in major markets and is currently considered investigational.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q413000\">Wikidata Q413000</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>clopenthixol</td></tr><tr><td>ATC codes:</td><td>N05AF02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13841\">DB13841</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/12454\">12454</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:59115\">59115</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q413000\">Q413000</a></td></tr><tr><td>formula:</td><td>C22H25ClN2OS</td></tr><tr><td>molar mass:</td><td>400.965 g/mol (PubChem CID 12454)</td></tr><tr><td>logP:</td><td>4.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
