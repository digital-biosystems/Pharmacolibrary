  annotation (Documentation(info = "<html><body><p>Dicycloverine (dicyclomine) is an anticholinergic drug used to treat irritable bowel syndrome and other functional gastrointestinal disorders. It is an approved medicine and remains in use for these conditions.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2662662\">Wikidata Q2662662</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dicycloverine</td></tr><tr><td>ATC codes:</td><td>A03AA07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00804\">DB00804</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3042\">3042</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4514\">4514</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2662662\">Q2662662</a></td></tr><tr><td>formula:</td><td>C19H35NO2</td></tr><tr><td>molar mass:</td><td>309.494 g/mol (PubChem CID 3042)</td></tr><tr><td>logP:</td><td>5.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
