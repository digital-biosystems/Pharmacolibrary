    logP = 1.2);
  annotation (Documentation(info = "<html><body><p>Chlorphenesin is a muscle relaxant used for pain, muscle spasm and cramps, and is also applied topically as an antifungal and antibacterial agent. It remains an approved drug, used mainly in topical dermatological preparations for skin fungal infections.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5103226&quot;>Wikidata Q5103226</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>chlorphenesin</td></tr><tr><td>ATC codes:</td><td>D01AE07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00856&quot;>DB00856</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/7697&quot;>7697</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3642&quot;>3642</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5103226&quot;>Q5103226</a></td></tr><tr><td>formula:</td><td>C9H11ClO3</td></tr><tr><td>molar mass:</td><td>202.634 g/mol (PubChem)</td></tr></table></body></html>"));
