  annotation (Documentation(info = "<html><body><p>Ibudilast is a phosphodiesterase inhibitor with bronchodilator and anti-platelet actions, studied as a treatment for obstructive airway diseases. It is considered investigational and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q261167\">Wikidata Q261167</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ibudilast</td></tr><tr><td>ATC codes:</td><td>R03DC04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB05266\">DB05266</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3671\">3671</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31684\">31684</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q261167\">Q261167</a></td></tr><tr><td>formula:</td><td>C14H18N2O</td></tr><tr><td>molar mass:</td><td>230.311 g/mol (PubChem CID 3671)</td></tr><tr><td>logP:</td><td>3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Ibudilast;
