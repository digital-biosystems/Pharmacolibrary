  annotation (Documentation(info = "<html><body><p>Bisoprolol is a selective beta blocker used for conditions such as high blood pressure, angina, heart failure, and after a heart attack. It is widely used and appears on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q412515\">Wikidata Q412515</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bisoprolol</td></tr><tr><td>ATC codes:</td><td>C07AB07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00612\">DB00612</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2405\">2405</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3127\">3127</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q412515\">Q412515</a></td></tr><tr><td>formula:</td><td>C18H31NO4</td></tr><tr><td>molar mass:</td><td>325.449 g/mol (PubChem CID 2405)</td></tr><tr><td>logP:</td><td>1.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
