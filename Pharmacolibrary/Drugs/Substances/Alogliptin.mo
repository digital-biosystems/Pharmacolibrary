  annotation (Documentation(info = "<html><body><p>Alogliptin is a DPP-4 inhibitor used to lower blood glucose in adults with type 2 diabetes. It is authorised in the European Union and used as an oral anti-diabetic medicine, including in fixed-dose combinations with other glucose-lowering drugs.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4734170&quot;>Wikidata Q4734170</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>alogliptin</td></tr><tr><td>ATC codes:</td><td>A10BH04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06203&quot;>DB06203</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/11450633&quot;>11450633</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:72323&quot;>72323</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4734170&quot;>Q4734170</a></td></tr><tr><td>formula:</td><td>C18H21N5O2</td></tr><tr><td>molar mass:</td><td>339.399 g/mol (PubChem)</td></tr></table></body></html>"));
end Alogliptin;
