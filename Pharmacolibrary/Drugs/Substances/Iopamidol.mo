    logP = -2.4);
  annotation (Documentation(info = "<html><body><p>Iopamidol is an iodinated, low-osmolar X-ray contrast agent used to improve visibility of body structures during imaging examinations. It is an approved contrast medium that is widely used in medical imaging, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q424788&quot;>Wikidata Q424788</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>iopamidol</td></tr><tr><td>ATC codes:</td><td>V08AB04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08947&quot;>DB08947</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/65492&quot;>65492</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31711&quot;>31711</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q424788&quot;>Q424788</a></td></tr><tr><td>formula:</td><td>C17H22I3N3O8</td></tr><tr><td>molar mass:</td><td>777.076 g/mol (PubChem)</td></tr></table></body></html>"));
