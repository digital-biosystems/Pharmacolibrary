  annotation (Documentation(info = "<html><body><p>Technetium (99mTc) pyrophosphate is a diagnostic radiopharmaceutical used for bone (skeleton) imaging. It is an approved imaging agent, used in nuclear medicine for skeletal scintigraphy.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>technetium (99mTc) pyrophosphate</td></tr><tr><td>ATC codes:</td><td>V09BA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09165\">DB09165</a></td></tr><tr><td>molar mass:</td><td>272.85 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Technetium99mTcPyrophosphate;
