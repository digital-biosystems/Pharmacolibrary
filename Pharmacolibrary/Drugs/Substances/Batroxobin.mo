within Pharmacolibrary.Drugs.Substances;
package Batroxobin "batroxobin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "batroxobin",
    atcCodes = {"B02BX03"},
    drugbankId = "DB09005",
    wikidataId = "Q993771");
  annotation (Documentation(info = "<html><body><p>Batroxobin, an enzyme derived from snake venom, acts as a hemostatic agent and has been studied for controlling bleeding. It is not an approved medicine in major markets such as the European Union and remains investigational.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q993771\">Wikidata Q993771</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>batroxobin</td></tr><tr><td>ATC codes:</td><td>B02BX03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09005\">DB09005</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q993771\">Q993771</a></td></tr></table></body></html>"));
end Batroxobin;
