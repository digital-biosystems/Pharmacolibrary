within Pharmacolibrary.Drugs.Substances;
package Benzydamine "benzydamine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "benzydamine",
    atcCodes = {"A01AD02", "G02CC03", "M01AX07", "M02AA05", "R02AX03"},
