within Pharmacolibrary.Drugs.Substances;
package Voclosporin "voclosporin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "voclosporin",
    atcCodes = {"L04AD03"},
    drugbankId = "DB11693",
    pubchemCid = "6918486",
    chebiId = "135957",
    wikidataId = "Q7939256",
    formula = "C63H111N11O12",
    M = 1.21465,
    logP = 7.9);
  annotation (Documentation(info = "<html><body><p>Voclosporin is an immunosuppressive calcineurin inhibitor used to treat lupus nephritis and has also been studied for uveitis. It is approved and authorised in the European Union for lupus nephritis, though it remains investigational for some other uses and carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7939256\">Wikidata Q7939256</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>voclosporin</td></tr><tr><td>ATC codes:</td><td>L04AD03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11693\">DB11693</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6918486\">6918486</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135957\">135957</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7939256\">Q7939256</a></td></tr><tr><td>formula:</td><td>C63H111N11O12</td></tr><tr><td>molar mass:</td><td>1214.65 g/mol (PubChem CID 6918486)</td></tr><tr><td>logP:</td><td>7.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Voclosporin;
