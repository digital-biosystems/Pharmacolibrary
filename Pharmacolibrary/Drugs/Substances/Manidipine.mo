  annotation (Documentation(info = "<html><body><p>Manidipine is a dihydropyridine calcium channel blocker used as an antihypertensive drug to treat high blood pressure. It is used mainly in some countries, often in combination with an ACE inhibitor, but it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q921133&quot;>Wikidata Q921133</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>manidipine</td></tr><tr><td>ATC codes:</td><td>C08CA11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09238&quot;>DB09238</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4008&quot;>4008</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135849&quot;>135849</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q921133&quot;>Q921133</a></td></tr><tr><td>formula:</td><td>C35H38N4O6</td></tr><tr><td>molar mass:</td><td>610.711 g/mol (PubChem)</td></tr></table></body></html>"));
end Manidipine;
