  annotation (Documentation(info = "<html><body><p>Acotiamide is a gastrointestinal agent and acetylcholinesterase inhibitor developed as a propulsive drug for functional gastrointestinal disorders. It is considered investigational and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4674598\">Wikidata Q4674598</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>acotiamide</td></tr><tr><td>ATC codes:</td><td>A03FA10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12482\">DB12482</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5282338\">5282338</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:34523\">34523</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4674598\">Q4674598</a></td></tr><tr><td>formula:</td><td>C21H30N4O5S</td></tr><tr><td>molar mass:</td><td>450.554 g/mol (PubChem CID 5282338)</td></tr><tr><td>logP:</td><td>3.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
