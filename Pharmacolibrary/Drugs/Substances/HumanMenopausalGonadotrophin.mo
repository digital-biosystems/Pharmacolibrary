  annotation (Documentation(info = "<html><body><p>Menotropin (human menopausal gonadotrophin) is a gonadotropin preparation used as a female fertility agent to stimulate ovulation. It is an approved medication, classified under sex hormones and ovulation stimulants, and remains in clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q416821\">Wikidata Q416821</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>human menopausal gonadotrophin</td></tr><tr><td>ATC codes:</td><td>G03GA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00032\">DB00032</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q416821\">Q416821</a></td></tr><tr><td>molar mass:</td><td>142.24 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end HumanMenopausalGonadotrophin;
