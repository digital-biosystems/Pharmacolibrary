  annotation (Documentation(info = "<html><body><p>Menotropin (human menopausal gonadotrophin) is a gonadotropin preparation used as a female fertility agent to stimulate ovulation. It is an approved medication, classified under sex hormones and ovulation stimulants, and remains in clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q416821&quot;>Wikidata Q416821</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>human menopausal gonadotrophin</td></tr><tr><td>ATC codes:</td><td>G03GA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00032&quot;>DB00032</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/1662&quot;>1662</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q416821&quot;>Q416821</a></td></tr><tr><td>formula:</td><td>C6H10O5</td></tr><tr><td>molar mass:</td><td>162.141 g/mol (PubChem)</td></tr></table></body></html>"));
end HumanMenopausalGonadotrophin;
