  annotation (Documentation(info = "<html><body><p>Melagatran is a direct thrombin inhibitor that was investigated as an antithrombotic drug for preventing or treating blood clots. It remained an investigational compound and was never authorised for general use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27084209&quot;>Wikidata Q27084209</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>melagatran</td></tr><tr><td>ATC codes:</td><td>B01AE04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13616&quot;>DB13616</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/183797&quot;>183797</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:43966&quot;>43966</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27084209&quot;>Q27084209</a></td></tr><tr><td>formula:</td><td>C22H31N5O4</td></tr><tr><td>molar mass:</td><td>429.521 g/mol (PubChem)</td></tr></table></body></html>"));
