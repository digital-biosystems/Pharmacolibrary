within Pharmacolibrary.Drugs.Substances;
package Pegademase "pegademase"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "pegademase",
    atcCodes = {"L03AX04"},
    drugbankId = "DB00061",
    wikidataId = "Q20801767",
    M = 40.7882);
  annotation (Documentation(info = "<html><body><p>Pegademase bovine, a modified bovine adenosine deaminase, was used as an enzyme-replacement immunostimulant to treat adenosine deaminase deficiency, a form of severe combined immunodeficiency (bare lymphocyte syndrome type 2). It was approved but has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q20801767&quot;>Wikidata Q20801767</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pegademase</td></tr><tr><td>ATC codes:</td><td>L03AX04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00061&quot;>DB00061</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q20801767&quot;>Q20801767</a></td></tr><tr><td>molar mass:</td><td>40788.2 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Pegademase;
