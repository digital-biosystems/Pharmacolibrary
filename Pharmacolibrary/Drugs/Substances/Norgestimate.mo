  annotation (Documentation(info = "<html><body><p>Norgestimate is a progestogen used in hormonal contraceptives, combined with an estrogen. It is an approved medicine, available in fixed and sequential progestogen–estrogen combination products.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Norgestimate</td></tr><tr><td>ATC codes:</td><td>G03AA11, G03AB09, G03FA13</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00957\">DB00957</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6540478\">6540478</a></td></tr><tr><td>formula:</td><td>C23H31NO3</td></tr><tr><td>molar mass:</td><td>369.505 g/mol (PubChem CID 6540478)</td></tr></table></body></html>"));
