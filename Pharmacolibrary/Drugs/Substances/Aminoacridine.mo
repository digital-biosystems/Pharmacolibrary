    logP = 2.8);
  annotation (Documentation(info = "<html><body><p>Aminoacridine (aminacrine) is an acridine-derivative antiseptic used topically on the skin to prevent or treat local infection. It is classified as investigational in DrugBank, so its current clinical use appears limited or uncertain.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q513937\">Wikidata Q513937</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>aminoacridine</td></tr><tr><td>ATC codes:</td><td>D08AA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11561\">DB11561</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/7019\">7019</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:74789\">74789</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q513937\">Q513937</a></td></tr><tr><td>formula:</td><td>C13H10N2</td></tr><tr><td>molar mass:</td><td>194.237 g/mol (PubChem CID 7019)</td></tr><tr><td>logP:</td><td>2.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Aminoacridine;
