  annotation (Documentation(info = "<html><body><p>Ozanimod is an immunosuppressant used to treat relapsing-remitting multiple sclerosis and ulcerative colitis. It is an approved medicine authorised in the European Union, and is also being investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q21098986\">Wikidata Q21098986</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>ozanimod</td></tr><tr><td>ATC codes:</td><td>L04AA38, L04AE02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12612\">DB12612</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/52938427\">52938427</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q21098986\">Q21098986</a></td></tr><tr><td>formula:</td><td>C23H24N4O3</td></tr><tr><td>molar mass:</td><td>404.47 g/mol (PubChem CID 52938427)</td></tr><tr><td>logP:</td><td>3.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
