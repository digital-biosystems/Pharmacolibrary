  annotation (Documentation(info = "<html><body><p>Calcium lactate is a calcium salt used as a mineral supplement to treat or prevent calcium deficiency. It is an approved medicine and also approved for veterinary use, and is additionally used as a food additive.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q419693\">Wikidata Q419693</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>calcium lactate</td></tr><tr><td>ATC codes:</td><td>A12AA05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13231\">DB13231</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/13144\">13144</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q419693\">Q419693</a></td></tr><tr><td>formula:</td><td>C6H10CaO6</td></tr><tr><td>molar mass:</td><td>218.218 g/mol (PubChem CID 13144)</td></tr></table></body></html>"));
end CalciumLactate;
