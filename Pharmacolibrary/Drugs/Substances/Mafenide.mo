  annotation (Documentation(info = "<html><body><p>Mafenide is a topical sulfonamide anti-infective used to treat bacterial infections of the skin, notably burn wounds. It has been withdrawn from human use, though it remains approved for veterinary purposes.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3843044\">Wikidata Q3843044</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mafenide</td></tr><tr><td>ATC codes:</td><td>D06BA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06795\">DB06795</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3998\">3998</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6633\">6633</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3843044\">Q3843044</a></td></tr><tr><td>formula:</td><td>C7H10N2O2S</td></tr><tr><td>molar mass:</td><td>186.229 g/mol (PubChem CID 3998)</td></tr><tr><td>logP:</td><td>-0.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Mafenide;
