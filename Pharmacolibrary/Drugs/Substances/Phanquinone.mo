  annotation (Documentation(info = "<html><body><p>Phanquinone is an antiprotozoal agent classified for use against amoebiasis and other protozoal diseases. It is not authorised in the European Union and appears only as an experimental compound, so its current availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7180497\">Wikidata Q7180497</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>phanquinone</td></tr><tr><td>ATC codes:</td><td>P01AX04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13469\">DB13469</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6764\">6764</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:59141\">59141</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7180497\">Q7180497</a></td></tr><tr><td>formula:</td><td>C12H6N2O2</td></tr><tr><td>molar mass:</td><td>210.192 g/mol (PubChem CID 6764)</td></tr><tr><td>logP:</td><td>1.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
