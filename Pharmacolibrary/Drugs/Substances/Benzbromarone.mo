    logP = 5.7);
  annotation (Documentation(info = "<html><body><p>Benzbromarone is a uricosuric medicine used to treat gout by helping the body excrete uric acid. It was withdrawn from some markets, reportedly over safety concerns including liver damage, though it remains available in a few countries.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q410435&quot;>Wikidata Q410435</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>benzbromarone</td></tr><tr><td>ATC codes:</td><td>M04AB03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12319&quot;>DB12319</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2333&quot;>2333</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3023&quot;>3023</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q410435&quot;>Q410435</a></td></tr><tr><td>formula:</td><td>C17H12Br2O3</td></tr><tr><td>molar mass:</td><td>424.088 g/mol (PubChem)</td></tr></table></body></html>"));
end Benzbromarone;
