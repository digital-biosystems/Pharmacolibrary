  annotation (Documentation(info = "<html><body><p>Bazedoxifene is a selective estrogen receptor modulator used to treat postmenopausal osteoporosis. It remains authorised in the European Union, though one marketing application there was withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4875166\">Wikidata Q4875166</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>bazedoxifene</td></tr><tr><td>ATC codes:</td><td>G03XC02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06401\">DB06401</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/154257\">154257</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135947\">135947</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4875166\">Q4875166</a></td></tr><tr><td>formula:</td><td>C30H34N2O3</td></tr><tr><td>molar mass:</td><td>470.613 g/mol (PubChem CID 154257)</td></tr><tr><td>logP:</td><td>6.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
