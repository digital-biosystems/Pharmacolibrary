  annotation (Documentation(info = "<html><body><p>Cefazolin is a first-generation cephalosporin antibiotic used to treat bacterial infections such as staphylococcal and urinary tract infections. It is an approved medicine and appears on the WHO list of essential medicines, so it is widely used around the world.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q415739&quot;>Wikidata Q415739</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cefazolin</td></tr><tr><td>ATC codes:</td><td>J01DB04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01327&quot;>DB01327</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/33255&quot;>33255</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:474053&quot;>474053</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q415739&quot;>Q415739</a></td></tr><tr><td>formula:</td><td>C14H14N8O4S3</td></tr><tr><td>molar mass:</td><td>454.498 g/mol (PubChem)</td></tr></table></body></html>"));
