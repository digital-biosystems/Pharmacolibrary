  annotation (Documentation(info = "<html><body><p>Tedisamil is an antiarrhythmic agent, a class III heart-rhythm drug investigated for treating cardiac arrhythmias. It remains experimental and is not an approved medicine; no marketing authorisation is recorded.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3982536\">Wikidata Q3982536</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tedisamil</td></tr><tr><td>ATC codes:</td><td>C01BD06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06200\">DB06200</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/65825\">65825</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3982536\">Q3982536</a></td></tr><tr><td>formula:</td><td>C19H32N2</td></tr><tr><td>molar mass:</td><td>288.479 g/mol (PubChem CID 65825)</td></tr><tr><td>logP:</td><td>3.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
