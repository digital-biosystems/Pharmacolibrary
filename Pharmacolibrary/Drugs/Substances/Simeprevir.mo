  annotation (Documentation(info = "<html><body><p>Simeprevir is an antiviral protease inhibitor that was used to treat chronic hepatitis C infection. It is no longer available in the European Union, where its marketing authorisation has been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7517689\">Wikidata Q7517689</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>simeprevir</td></tr><tr><td>ATC codes:</td><td>J05AE14, J05AP05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06290\">DB06290</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/24873435\">24873435</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134743\">134743</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7517689\">Q7517689</a></td></tr><tr><td>formula:</td><td>C38H47N5O7S2</td></tr><tr><td>molar mass:</td><td>749.942 g/mol (PubChem CID 24873435)</td></tr><tr><td>logP:</td><td>4.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
