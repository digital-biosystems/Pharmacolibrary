    logP = 0.7);
  annotation (Documentation(info = "<html><body><p>Sitagliptin is a DPP-4 inhibitor used to lower blood glucose in people with diabetes, including type 2 diabetes and, according to Wikidata, type 1 diabetes and maturity-onset diabetes of the young type 2. It is widely used and authorised in the European Union, available both alone and in combination products with other oral glucose-lowering drugs.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q419832&quot;>Wikidata Q419832</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>sitagliptin</td></tr><tr><td>ATC codes:</td><td>A10BH01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01261&quot;>DB01261</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4369359&quot;>4369359</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:40237&quot;>40237</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q419832&quot;>Q419832</a></td></tr><tr><td>formula:</td><td>C16H15F6N5O</td></tr><tr><td>molar mass:</td><td>407.318 g/mol (PubChem)</td></tr></table></body></html>"));
end Sitagliptin;
