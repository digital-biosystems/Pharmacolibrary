  annotation (Documentation(info = "<html><body><p>Brompheniramine is an antihistamine used to relieve allergy symptoms such as vasomotor rhinitis. It is an approved, older first-generation antihistamine, available mainly in over-the-counter cold and allergy medicines, though not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2606497\">Wikidata Q2606497</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>brompheniramine</td></tr><tr><td>ATC codes:</td><td>R06AB01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00835\">DB00835</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6834\">6834</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3183\">3183</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2606497\">Q2606497</a></td></tr><tr><td>formula:</td><td>C16H19BrN2</td></tr><tr><td>molar mass:</td><td>319.246 g/mol (PubChem CID 6834)</td></tr><tr><td>logP:</td><td>3.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Brompheniramine;
