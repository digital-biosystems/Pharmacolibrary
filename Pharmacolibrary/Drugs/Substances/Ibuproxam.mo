  annotation (Documentation(info = "<html><body><p>Ibuproxam is a propionic acid derivative that was used as a non-steroidal anti-inflammatory drug for painful inflammatory and rheumatic conditions. It has been withdrawn and is no longer on the market.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3791611\">Wikidata Q3791611</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ibuproxam</td></tr><tr><td>ATC codes:</td><td>M01AE13</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08955\">DB08955</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/68704\">68704</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:76160\">76160</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3791611\">Q3791611</a></td></tr><tr><td>formula:</td><td>C13H19NO2</td></tr><tr><td>molar mass:</td><td>221.3 g/mol (PubChem CID 68704)</td></tr><tr><td>logP:</td><td>2.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
