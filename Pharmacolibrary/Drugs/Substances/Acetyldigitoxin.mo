  annotation (Documentation(info = "<html><body><p>Acetyldigitoxin is a digitalis glycoside used as a cardiotonic and antiarrhythmic agent for heart conditions. It is an approved pharmaceutical drug, though it appears to be little used today and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4673299\">Wikidata Q4673299</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>acetyldigitoxin</td></tr><tr><td>ATC codes:</td><td>C01AA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00511\">DB00511</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5284512\">5284512</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:53773\">53773</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4673299\">Q4673299</a></td></tr><tr><td>formula:</td><td>C43H66O14</td></tr><tr><td>molar mass:</td><td>806.987 g/mol (PubChem CID 5284512)</td></tr><tr><td>logP:</td><td>2.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
