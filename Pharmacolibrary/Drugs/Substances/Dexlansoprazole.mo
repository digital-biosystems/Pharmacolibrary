  annotation (Documentation(info = "<html><body><p>Dexlansoprazole is a proton-pump inhibitor used to treat acid-related conditions such as gastroesophageal reflux disease, esophagitis, gastritis, and indigestion. It is an approved medicine, used mainly for peptic ulcer and reflux disorders, and carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5268339&quot;>Wikidata Q5268339</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dexlansoprazole</td></tr><tr><td>ATC codes:</td><td>A02BC06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB05351&quot;>DB05351</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/9578005&quot;>9578005</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135931&quot;>135931</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5268339&quot;>Q5268339</a></td></tr><tr><td>formula:</td><td>C16H14F3N3O2S</td></tr><tr><td>molar mass:</td><td>369.361 g/mol (PubChem)</td></tr></table></body></html>"));
