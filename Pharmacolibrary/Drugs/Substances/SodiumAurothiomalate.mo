    logP = 0);
  annotation (Documentation(info = "<html><body><p>Sodium aurothiomalate is a gold preparation that was used as an injectable disease-modifying treatment for rheumatoid arthritis. It is no longer in use; it has been withdrawn, largely because safer and better-tolerated modern antirheumatic drugs replaced gold therapy.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q20885557&quot;>Wikidata Q20885557</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sodium aurothiomalate</td></tr><tr><td>ATC codes:</td><td>M01CB01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09276&quot;>DB09276</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/16760302&quot;>16760302</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:35864&quot;>35864</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q20885557&quot;>Q20885557</a></td></tr><tr><td>formula:</td><td>C4H4AuNaO4S</td></tr><tr><td>molar mass:</td><td>368.092 g/mol (PubChem)</td></tr></table></body></html>"));
end SodiumAurothiomalate;
