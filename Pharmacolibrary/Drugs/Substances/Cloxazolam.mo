    logP = 3.2);
  annotation (Documentation(info = "<html><body><p>Cloxazolam is a benzodiazepine derivative used as a sedative and anxiolytic for anxiety and related conditions. It is not authorised in the European Union and appears to be available only in a limited number of countries, mainly in Asia and Latin America.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4385221\">Wikidata Q4385221</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cloxazolam</td></tr><tr><td>ATC codes:</td><td>N05BA22</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01553\">DB01553</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2816\">2816</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31426\">31426</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4385221\">Q4385221</a></td></tr><tr><td>formula:</td><td>C17H14Cl2N2O2</td></tr><tr><td>molar mass:</td><td>349.211 g/mol (PubChem CID 2816)</td></tr><tr><td>logP:</td><td>3.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
