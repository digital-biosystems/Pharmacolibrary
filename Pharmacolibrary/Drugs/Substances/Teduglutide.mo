  annotation (Documentation(info = "<html><body><p>Teduglutide is a glucagon-like peptide-2 analogue used to treat short bowel syndrome. It is authorised in the European Union for short bowel syndrome and related malabsorption conditions.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7694156&quot;>Wikidata Q7694156</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>teduglutide</td></tr><tr><td>ATC codes:</td><td>A16AX08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08900&quot;>DB08900</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/16139605&quot;>16139605</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:72305&quot;>72305</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7694156&quot;>Q7694156</a></td></tr><tr><td>formula:</td><td>C164H252N44O55S</td></tr><tr><td>molar mass:</td><td>3752.13 g/mol (PubChem)</td></tr></table></body></html>"));
