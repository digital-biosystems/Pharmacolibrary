  annotation (Documentation(info = "<html><body><p>Teduglutide is a glucagon-like peptide-2 analogue used to treat short bowel syndrome. It is authorised in the European Union for short bowel syndrome and related malabsorption conditions.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7694156\">Wikidata Q7694156</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>teduglutide</td></tr><tr><td>ATC codes:</td><td>A16AX08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08900\">DB08900</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:72305\">72305</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7694156\">Q7694156</a></td></tr><tr><td>molar mass:</td><td>3752.1 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>-15.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
