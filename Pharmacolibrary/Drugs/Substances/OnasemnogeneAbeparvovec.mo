  annotation (Documentation(info = "<html><body><p>Onasemnogene abeparvovec is a gene therapy used to treat spinal muscular atrophy. It is authorised in the European Union and is also being studied for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q56934130&quot;>Wikidata Q56934130</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>onasemnogene abeparvovec</td></tr><tr><td>ATC codes:</td><td>M09AX09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB15528&quot;>DB15528</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q56934130&quot;>Q56934130</a></td></tr></table></body></html>"));
