  annotation (Documentation(info = "<html><body><p>Odronextamab is a monoclonal antibody used to treat follicular lymphoma. It is authorised in the European Union and remains investigational for other uses.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>odronextamab</td></tr><tr><td>ATC codes:</td><td>L01FX34, Not yet assigned</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB16684\">DB16684</a></td></tr></table></body></html>"));
