within Pharmacolibrary.Drugs.Substances;
package Tyrothricin "tyrothricin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "tyrothricin",
    atcCodes = {"D06AX08", "R02AB02", "S01AA05"},
    drugbankId = "DB13503",
    pubchemCid = "452550",
    wikidataId = "Q419421",
    formula = "C65H85N11O13",
