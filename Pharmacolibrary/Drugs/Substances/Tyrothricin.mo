    logP = 1.9);
  annotation (Documentation(info = "<html><body><p>Tyrothricin is an antibiotic mixture used as a local anti-infective, applied topically to the skin, throat, and eyes. It remains in use mainly in topical preparations such as throat lozenges and skin treatments, though some products have been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q419421\">Wikidata Q419421</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tyrothricin</td></tr><tr><td>ATC codes:</td><td>D06AX08, R02AB02, S01AA05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13503\">DB13503</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/452550\">452550</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q419421\">Q419421</a></td></tr><tr><td>formula:</td><td>C65H85N11O13</td></tr><tr><td>molar mass:</td><td>1228.46 g/mol (PubChem CID 452550)</td></tr><tr><td>logP:</td><td>1.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Tyrothricin;
