  annotation (Documentation(info = "<html><body><p>Bamifylline is a xanthine drug that acts as a bronchodilator, and has also been described as an analgesic and vasodilator, used for obstructive airway diseases. It is considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4853500\">Wikidata Q4853500</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bamifylline</td></tr><tr><td>ATC codes:</td><td>R03DA08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13203\">DB13203</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/16229\">16229</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135605\">135605</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4853500\">Q4853500</a></td></tr><tr><td>formula:</td><td>C20H27N5O3</td></tr><tr><td>molar mass:</td><td>385.468 g/mol (PubChem CID 16229)</td></tr><tr><td>logP:</td><td>1.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
