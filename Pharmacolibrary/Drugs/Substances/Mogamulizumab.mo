within Pharmacolibrary.Drugs.Substances;
package Mogamulizumab "mogamulizumab"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "mogamulizumab",
    atcCodes = {"L01FX09", "L01XC25"},
    drugbankId = "DB12498",
    wikidataId = "Q6890447");
  annotation (Documentation(info = "<html><body><p>Mogamulizumab is a monoclonal antibody used as an anticancer treatment for cutaneous T-cell lymphomas, namely mycosis fungoides and Sézary syndrome. It is authorised in the European Union and is used mainly in specialist care for these rare blood cancers.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6890447\">Wikidata Q6890447</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>mogamulizumab</td></tr><tr><td>ATC codes:</td><td>L01FX09, L01XC25</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12498\">DB12498</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6890447\">Q6890447</a></td></tr></table></body></html>"));
end Mogamulizumab;
