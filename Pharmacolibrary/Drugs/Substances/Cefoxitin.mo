  annotation (Documentation(info = "<html><body><p>Cefoxitin is a second-generation cephalosporin antibiotic used to treat bacterial infections such as staphylococcal infections, abscesses, sepsis, urinary tract infections, and peritonitis. It is an approved antibiotic used for systemic treatment of bacterial infections, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2353907&quot;>Wikidata Q2353907</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cefoxitin</td></tr><tr><td>ATC codes:</td><td>J01DC01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01331&quot;>DB01331</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/441199&quot;>441199</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:209807&quot;>209807</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2353907&quot;>Q2353907</a></td></tr><tr><td>formula:</td><td>C16H17N3O7S2</td></tr><tr><td>molar mass:</td><td>427.446 g/mol (PubChem)</td></tr></table></body></html>"));
