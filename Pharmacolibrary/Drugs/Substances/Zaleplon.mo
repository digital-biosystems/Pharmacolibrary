  annotation (Documentation(info = "<html><body><p>Zaleplon is a hypnotic and sedative drug used to treat insomnia. It is an approved medicine, though its European Union products have been withdrawn, and it is also used illicitly.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q145052&quot;>Wikidata Q145052</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>zaleplon</td></tr><tr><td>ATC codes:</td><td>N05CF03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00962&quot;>DB00962</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5719&quot;>5719</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:10102&quot;>10102</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q145052&quot;>Q145052</a></td></tr><tr><td>formula:</td><td>C17H15N5O</td></tr><tr><td>molar mass:</td><td>305.341 g/mol (PubChem)</td></tr></table></body></html>"));
