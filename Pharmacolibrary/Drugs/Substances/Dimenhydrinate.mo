    logP = 0);
  annotation (Documentation(info = "<html><body><p>Dimenhydrinate is an antihistamine and antiemetic used to treat motion sickness, vomiting, and vertigo of central origin. It is an approved medicine, available over the counter in many countries, though not authorised centrally in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q420439&quot;>Wikidata Q420439</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dimenhydrinate</td></tr><tr><td>ATC codes:</td><td>R06AA11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00985&quot;>DB00985</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/441281&quot;>441281</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:94848&quot;>94848</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q420439&quot;>Q420439</a></td></tr><tr><td>formula:</td><td>C24H28ClN5O3</td></tr><tr><td>molar mass:</td><td>469.97 g/mol (PubChem)</td></tr></table></body></html>"));
end Dimenhydrinate;
