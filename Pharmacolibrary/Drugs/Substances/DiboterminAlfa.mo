within Pharmacolibrary.Drugs.Substances;
package DiboterminAlfa "dibotermin alfa"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "dibotermin alfa",
    atcCodes = {"M05BC01"},
    drugbankId = "DB11639",
    wikidataId = "Q28852431");
  annotation (Documentation(info = "<html><body><p>Dibotermin alfa, a recombinant bone morphogenetic protein, is used to help bone healing in tibial fractures and spinal fusion surgery. It is authorised in the European Union and used in hospital settings for fracture repair.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q28852431\">Wikidata Q28852431</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>dibotermin alfa</td></tr><tr><td>ATC codes:</td><td>M05BC01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11639\">DB11639</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q28852431\">Q28852431</a></td></tr></table></body></html>"));
end DiboterminAlfa;
