  annotation (Documentation(info = "<html><body><p>Suvorexant is a hypnotic, an orexin receptor antagonist, used to treat insomnia and sleep-wake disorder. It is an approved medicine, but it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7650517\">Wikidata Q7650517</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>suvorexant</td></tr><tr><td>ATC codes:</td><td>N05CJ01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09034\">DB09034</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/24965990\">24965990</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:82698\">82698</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7650517\">Q7650517</a></td></tr><tr><td>formula:</td><td>C23H23ClN6O2</td></tr><tr><td>molar mass:</td><td>450.927 g/mol (PubChem CID 24965990)</td></tr><tr><td>logP:</td><td>4.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
