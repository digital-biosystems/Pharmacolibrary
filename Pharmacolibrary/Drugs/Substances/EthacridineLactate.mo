within Pharmacolibrary.Drugs.Substances;
package EthacridineLactate "ethacridine lactate"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "ethacridine lactate",
    atcCodes = {"B05CA08", "D08AA01"},
    drugbankId = "DB13190",
    pubchemCid = "2017",
    chebiId = "135032",
    wikidataId = "Q27292662",
    formula = "C15H15N3O",
    M = 0.253305);
  annotation (Documentation(info = "<html><body><p>Ethacridine lactate is an acridine-derived antiseptic used against bacterial infections, mainly as a local anti-infective and in irrigating solutions. It is not an approved medicine in the EU and is currently classed as investigational, though it remains known as a topical antiseptic.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27292662\">Wikidata Q27292662</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ethacridine lactate</td></tr><tr><td>ATC codes:</td><td>B05CA08, D08AA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13190\">DB13190</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2017\">2017</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135032\">135032</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27292662\">Q27292662</a></td></tr><tr><td>formula:</td><td>C15H15N3O</td></tr><tr><td>molar mass:</td><td>253.305 g/mol (PubChem CID 2017)</td></tr></table><p><small>Drugs.Common 25.09 gave 343.4 g/mol (+35.6 %); replaced by the value above</small></p></body></html>"));
end EthacridineLactate;
