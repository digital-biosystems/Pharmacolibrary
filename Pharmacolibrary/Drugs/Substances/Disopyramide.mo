  annotation (Documentation(info = "<html><body><p>Disopyramide is a class Ia antiarrhythmic used to treat heart rhythm problems such as atrial fibrillation. It is an approved medicine, though not authorised in the European Union, and is used relatively little today.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q425120&quot;>Wikidata Q425120</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>disopyramide</td></tr><tr><td>ATC codes:</td><td>C01BA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00280&quot;>DB00280</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3114&quot;>3114</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4657&quot;>4657</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q425120&quot;>Q425120</a></td></tr><tr><td>formula:</td><td>C21H29N3O</td></tr><tr><td>molar mass:</td><td>339.483 g/mol (PubChem)</td></tr></table></body></html>"));
