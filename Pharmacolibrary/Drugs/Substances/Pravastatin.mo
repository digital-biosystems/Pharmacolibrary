  annotation (Documentation(info = "<html><body><p>Pravastatin is a statin used to lower cholesterol and treat lipid disorders such as hyperlipidemia, as well as conditions like coronary artery disease and arteriosclerosis. It is an approved medicine, widely used in clinical practice, and is also available in fixed combinations with other lipid-modifying agents.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q1240093&quot;>Wikidata Q1240093</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pravastatin</td></tr><tr><td>ATC codes:</td><td>C10AA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00175&quot;>DB00175</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/54687&quot;>54687</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:63618&quot;>63618</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q1240093&quot;>Q1240093</a></td></tr><tr><td>formula:</td><td>C23H36O7</td></tr><tr><td>molar mass:</td><td>424.534 g/mol (PubChem)</td></tr></table></body></html>"));
