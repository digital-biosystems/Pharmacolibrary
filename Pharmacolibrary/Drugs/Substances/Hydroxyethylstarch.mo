  annotation (Documentation(info = "<html><body><p>Hydroxyethyl starch is a modified starch used as a blood substitute and plasma volume expander. It remains approved but carries a boxed warning, so its use is restricted to carefully selected patients.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q415775&quot;>Wikidata Q415775</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>hydroxyethylstarch</td></tr><tr><td>ATC codes:</td><td>B05AA07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09106&quot;>DB09106</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/16213095&quot;>16213095</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q415775&quot;>Q415775</a></td></tr><tr><td>formula:</td><td>C22H44O17</td></tr><tr><td>molar mass:</td><td>580.577 g/mol (PubChem)</td></tr></table></body></html>"));
end Hydroxyethylstarch;
