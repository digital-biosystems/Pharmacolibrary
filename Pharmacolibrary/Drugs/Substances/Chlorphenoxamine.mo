  annotation (Documentation(info = "<html><body><p>Chlorphenoxamine is an antihistamine (also with anticholinergic effects) used to relieve allergy symptoms and itching, including in topical skin preparations. It has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5103225&quot;>Wikidata Q5103225</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>chlorphenoxamine</td></tr><tr><td>ATC codes:</td><td>D04AA34, R06AA06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09007&quot;>DB09007</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6475&quot;>6475</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135288&quot;>135288</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5103225&quot;>Q5103225</a></td></tr><tr><td>formula:</td><td>C18H22ClNO</td></tr><tr><td>molar mass:</td><td>303.83 g/mol (PubChem)</td></tr></table></body></html>"));
