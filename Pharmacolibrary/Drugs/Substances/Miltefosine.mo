    logP = 6.7);
  annotation (Documentation(info = "<html><body><p>Miltefosine is a phospholipid drug used as an antiprotozoal agent against leishmaniasis and trypanosomiasis, and it also has antifungal, antibacterial and anticancer activity. It is an approved medicine, included on the WHO essential medicines list, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q411787\">Wikidata Q411787</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>miltefosine</td></tr><tr><td>ATC codes:</td><td>P01CX04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09031\">DB09031</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3599\">3599</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:75283\">75283</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q411787\">Q411787</a></td></tr><tr><td>formula:</td><td>C21H46NO4P</td></tr><tr><td>molar mass:</td><td>407.576 g/mol (PubChem CID 3599)</td></tr><tr><td>logP:</td><td>6.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Miltefosine;
