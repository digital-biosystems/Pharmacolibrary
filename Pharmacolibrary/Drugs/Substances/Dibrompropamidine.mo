  annotation (Documentation(info = "<html><body><p>Dibrompropamidine is an antiseptic and anti-infective agent used to treat skin infections and eye infections. It appears to be only experimental today, with no marketing authorisation recorded in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5272294&quot;>Wikidata Q5272294</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dibrompropamidine</td></tr><tr><td>ATC codes:</td><td>D08AC01, S01AX14</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13548&quot;>DB13548</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/11974&quot;>11974</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135760&quot;>135760</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5272294&quot;>Q5272294</a></td></tr><tr><td>formula:</td><td>C17H18Br2N4O2</td></tr><tr><td>molar mass:</td><td>470.165 g/mol (PubChem)</td></tr></table></body></html>"));
end Dibrompropamidine;
