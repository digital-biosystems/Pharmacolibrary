  annotation (Documentation(info = "<html><body><p>Enfortumab vedotin, an antibody-drug conjugate, is used to treat urothelial (transitional cell) carcinoma. It is authorised in the European Union and is an approved cancer medicine, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q19904068\">Wikidata Q19904068</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>enfortumab vedotin</td></tr><tr><td>ATC codes:</td><td>L01FX13</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13007\">DB13007</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q19904068\">Q19904068</a></td></tr><tr><td>molar mass:</td><td>152000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
