  annotation (Documentation(info = "<html><body><p>Alendronic acid is a bisphosphonate used to treat osteoporosis and other bone diseases. It is an approved medicine, widely used for bone conditions, and has also been studied for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q420057\">Wikidata Q420057</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>alendronic acid</td></tr><tr><td>ATC codes:</td><td>M05BA04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00630\">DB00630</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2088\">2088</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:2567\">2567</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q420057\">Q420057</a></td></tr><tr><td>formula:</td><td>C4H13NO7P2</td></tr><tr><td>molar mass:</td><td>249.096 g/mol (PubChem CID 2088)</td></tr><tr><td>logP:</td><td>-6.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
