  annotation (Documentation(info = "<html><body><p>Itramin tosilate (aminoethyl nitrate) is a nitrate vasodilator classified for use in cardiac diseases, such as angina. It is considered experimental and is not an approved medicine today, so it is no longer in routine clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27288448&quot;>Wikidata Q27288448</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>itramin tosilate</td></tr><tr><td>ATC codes:</td><td>C01DX01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13585&quot;>DB13585</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/26001&quot;>26001</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:136001&quot;>136001</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27288448&quot;>Q27288448</a></td></tr><tr><td>formula:</td><td>C2H6N2O3</td></tr><tr><td>molar mass:</td><td>106.081 g/mol (PubChem)</td></tr></table></body></html>"));
