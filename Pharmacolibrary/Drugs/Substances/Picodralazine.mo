    M = 0.251293);
  annotation (Documentation(info = "<html><body><p>Picodralazine is a hydrazinophthalazine derivative classified as an antihypertensive, used in combination with diuretics to treat high blood pressure. It is considered experimental and there is no evidence of current authorised use.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Picodralazine</td></tr><tr><td>ATC codes:</td><td>C02LG03, C02LG73</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB21022\">DB21022</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/71890\">71890</a></td></tr><tr><td>formula:</td><td>C14H13N5</td></tr><tr><td>molar mass:</td><td>251.293 g/mol (PubChem CID 71890)</td></tr></table></body></html>"));
end Picodralazine;
