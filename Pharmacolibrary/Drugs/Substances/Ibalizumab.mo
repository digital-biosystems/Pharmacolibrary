within Pharmacolibrary.Drugs.Substances;
package Ibalizumab "ibalizumab"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "ibalizumab",
    atcCodes = {"J05AX23"},
    drugbankId = "DB12698",
    wikidataId = "Q3791531");
  annotation (Documentation(info = "<html><body><p>Ibalizumab is a monoclonal antibody used as an antiviral treatment for HIV infections. It is an approved drug, though its marketing authorisation in the European Union has been withdrawn, so its use is now mainly elsewhere.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3791531\">Wikidata Q3791531</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>ibalizumab</td></tr><tr><td>ATC codes:</td><td>J05AX23</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12698\">DB12698</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3791531\">Q3791531</a></td></tr></table></body></html>"));
end Ibalizumab;
