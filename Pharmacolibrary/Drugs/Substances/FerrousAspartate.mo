  annotation (Documentation(info = "<html><body><p>Ferrous aspartate is an oral iron preparation belonging to the bivalent iron class of antianemic medicines, used to treat iron deficiency anaemia. It is listed as an experimental drug, and no authorisation or marketing information is available, so its current use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27295012&quot;>Wikidata Q27295012</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ferrous aspartate</td></tr><tr><td>ATC codes:</td><td>B03AA09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13220&quot;>DB13220</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27295012&quot;>Q27295012</a></td></tr><tr><td>formula:</td><td>C4H5FeNO4</td></tr><tr><td>molar mass:</td><td>186.932 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end FerrousAspartate;
