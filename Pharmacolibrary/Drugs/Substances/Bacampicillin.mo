  annotation (Documentation(info = "<html><body><p>Bacampicillin is a penicillin antibiotic used to treat infections such as gonorrhea, listeriosis, urinary tract and upper respiratory tract infections. It has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2878140\">Wikidata Q2878140</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bacampicillin</td></tr><tr><td>ATC codes:</td><td>J01CA06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01602\">DB01602</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/441397\">441397</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:2968\">2968</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2878140\">Q2878140</a></td></tr><tr><td>formula:</td><td>C21H27N3O7S</td></tr><tr><td>molar mass:</td><td>465.521 g/mol (PubChem CID 441397)</td></tr><tr><td>logP:</td><td>2.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
