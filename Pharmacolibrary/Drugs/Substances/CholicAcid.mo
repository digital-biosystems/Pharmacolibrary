    logP = 3.6);
  annotation (Documentation(info = "<html><body><p>Cholic acid, a naturally occurring bile acid, is used to treat certain inborn errors of metabolism, including peroxisomal disorders. It is authorised in the European Union as a bile therapy medicine, though one related product has been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q287415&quot;>Wikidata Q287415</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>cholic acid</td></tr><tr><td>ATC codes:</td><td>A05AA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB02659&quot;>DB02659</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/221493&quot;>221493</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:16359&quot;>16359</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q287415&quot;>Q287415</a></td></tr><tr><td>formula:</td><td>C24H40O5</td></tr><tr><td>molar mass:</td><td>408.579 g/mol (PubChem)</td></tr></table></body></html>"));
end CholicAcid;
