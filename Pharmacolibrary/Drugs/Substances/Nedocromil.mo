within Pharmacolibrary.Drugs.Substances;
package Nedocromil "nedocromil"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "nedocromil",
    atcCodes = {"R01AC07", "R03BC03", "S01GX04"},
    drugbankId = "DB00716",
    pubchemCid = "50294",
    chebiId = "7492",
    wikidataId = "Q416706",
    formula = "C19H17NO7",
    M = 0.371345,
    logP = 2.2);
  annotation (Documentation(info = "<html><body><p>Nedocromil is an anti-allergic, anti-inflammatory drug used for allergic conditions such as asthma, allergic rhinitis, and eye allergies including giant papillary conjunctivitis. It is an approved medicine given as nasal, inhaled, and eye-drop preparations, though it is not authorised by the European Medicines Agency and is now only rarely used.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q416706&quot;>Wikidata Q416706</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nedocromil</td></tr><tr><td>ATC codes:</td><td>R01AC07, R03BC03, S01GX04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00716&quot;>DB00716</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/50294&quot;>50294</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7492&quot;>7492</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q416706&quot;>Q416706</a></td></tr><tr><td>formula:</td><td>C19H17NO7</td></tr><tr><td>molar mass:</td><td>371.345 g/mol (PubChem)</td></tr></table></body></html>"));
end Nedocromil;
