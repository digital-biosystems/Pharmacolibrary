  annotation (Documentation(info = "<html><body><p>Medazepam is a benzodiazepine with calming, sleep-inducing, muscle-relaxing and anticonvulsant effects, used as an anxiolytic for anxiety. It is considered investigational and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q572796\">Wikidata Q572796</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>medazepam</td></tr><tr><td>ATC codes:</td><td>N05BA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13437\">DB13437</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4041\">4041</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31807\">31807</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q572796\">Q572796</a></td></tr><tr><td>formula:</td><td>C16H15ClN2</td></tr><tr><td>molar mass:</td><td>270.76 g/mol (PubChem CID 4041)</td></tr><tr><td>logP:</td><td>4.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
