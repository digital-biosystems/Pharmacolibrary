  annotation (Documentation(info = "<html><body><p>Susoctocog alfa is a porcine recombinant form of antihemophilic factor (factor VIII), a blood coagulation factor used to treat bleeding in clotting factor deficiency. It is an approved medicine, listed for blood coagulation disorders, though its exact authorised regions are not specified in the available facts.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q84976438\">Wikidata Q84976438</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>susoctocog alfa</td></tr><tr><td>ATC codes:</td><td>B02BD14</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11606\">DB11606</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q84976438\">Q84976438</a></td></tr><tr><td>molar mass:</td><td>170000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end SusoctocogAlfa;
