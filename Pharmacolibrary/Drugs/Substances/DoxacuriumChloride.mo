  annotation (Documentation(info = "<html><body><p>Doxacurium chloride is a peripherally acting muscle relaxant, formerly approved for use as a neuromuscular blocking agent during surgery. It is no longer available, having been withdrawn from the market.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5303681&quot;>Wikidata Q5303681</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>doxacurium chloride</td></tr><tr><td>ATC codes:</td><td>M03AC07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01135&quot;>DB01135</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5284551&quot;>5284551</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:59819&quot;>59819</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5303681&quot;>Q5303681</a></td></tr><tr><td>formula:</td><td>C56H78Cl2N2O16</td></tr><tr><td>molar mass:</td><td>1106.14 g/mol (PubChem)</td></tr></table></body></html>"));
