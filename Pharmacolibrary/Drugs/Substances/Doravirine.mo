  annotation (Documentation(info = "<html><body><p>Doravirine is an antiviral medicine used to treat HIV infections, acting as a non-nucleoside reverse transcriptase inhibitor. It is authorised in the European Union and is used in combination antiviral treatment for HIV.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6885419&quot;>Wikidata Q6885419</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>doravirine</td></tr><tr><td>ATC codes:</td><td>J05AG06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12301&quot;>DB12301</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/58460047&quot;>58460047</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6885419&quot;>Q6885419</a></td></tr><tr><td>formula:</td><td>C17H11ClF3N5O3</td></tr><tr><td>molar mass:</td><td>425.751 g/mol (PubChem)</td></tr></table></body></html>"));
end Doravirine;
