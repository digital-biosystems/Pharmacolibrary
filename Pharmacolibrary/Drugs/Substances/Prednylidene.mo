  annotation (Documentation(info = "<html><body><p>Prednylidene is a synthetic glucocorticoid, a corticosteroid for systemic use, a class of drugs used to treat inflammatory and immune-related conditions. It appears to be only an experimental compound and is not an established marketed medicine; no authorised uses are known.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7239696\">Wikidata Q7239696</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>prednylidene</td></tr><tr><td>ATC codes:</td><td>H02AB11</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13208\">DB13208</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/20055008\">20055008</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135572\">135572</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7239696\">Q7239696</a></td></tr><tr><td>formula:</td><td>C22H28O5</td></tr><tr><td>molar mass:</td><td>372.461 g/mol (PubChem CID 20055008)</td></tr><tr><td>logP:</td><td>1.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
