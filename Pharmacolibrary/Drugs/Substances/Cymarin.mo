  annotation (Documentation(info = "<html><body><p>Cymarin is a Strophanthus cardiac glycoside with cardiotonic and antiarrhythmic activity, historically used for heart conditions. It is currently considered experimental and does not appear to be an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5199357\">Wikidata Q5199357</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cymarin</td></tr><tr><td>ATC codes:</td><td>C01AC03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13240\">DB13240</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/441853\">441853</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4037\">4037</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5199357\">Q5199357</a></td></tr><tr><td>formula:</td><td>C30H44O9</td></tr><tr><td>molar mass:</td><td>548.673 g/mol (PubChem CID 441853)</td></tr><tr><td>logP:</td><td>0.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
