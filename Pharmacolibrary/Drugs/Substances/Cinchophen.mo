  annotation (Documentation(info = "<html><body><p>Cinchophen is an antigout medicine, classified as a preparation with no effect on uric acid metabolism. It is currently listed only as an experimental drug, so it does not appear to be in routine clinical use today.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5120196&quot;>Wikidata Q5120196</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cinchophen</td></tr><tr><td>ATC codes:</td><td>M04AC02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13551&quot;>DB13551</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/8593&quot;>8593</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:114195&quot;>114195</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5120196&quot;>Q5120196</a></td></tr><tr><td>formula:</td><td>C16H11NO2</td></tr><tr><td>molar mass:</td><td>249.269 g/mol (PubChem)</td></tr></table></body></html>"));
