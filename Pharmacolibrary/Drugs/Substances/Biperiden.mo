    logP = 4.3);
  annotation (Documentation(info = "<html><body><p>Biperiden is an anticholinergic drug used to treat Parkinson's disease and lingual-facial-buccal dyskinesia. It remains in clinical use, is listed among WHO essential medicines, and is approved though also marked investigational and withdrawn in some contexts.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q414914\">Wikidata Q414914</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>biperiden</td></tr><tr><td>ATC codes:</td><td>N04AA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00810\">DB00810</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2381\">2381</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3112\">3112</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q414914\">Q414914</a></td></tr><tr><td>formula:</td><td>C21H29NO</td></tr><tr><td>molar mass:</td><td>311.469 g/mol (PubChem CID 2381)</td></tr><tr><td>logP:</td><td>4.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Biperiden;
