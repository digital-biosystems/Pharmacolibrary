  annotation (Documentation(info = "<html><body><p>Lefamulin is an antibacterial used to treat bacterial pneumonia, including community-acquired infections. It is approved and authorised in the European Union, though it is not among the most widely used antibiotics.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q24890013\">Wikidata Q24890013</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>lefamulin</td></tr><tr><td>ATC codes:</td><td>J01XX12</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12825\">DB12825</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/25185057\">25185057</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q24890013\">Q24890013</a></td></tr><tr><td>formula:</td><td>C28H45NO5S</td></tr><tr><td>molar mass:</td><td>507.73 g/mol (PubChem CID 25185057)</td></tr><tr><td>logP:</td><td>4.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
