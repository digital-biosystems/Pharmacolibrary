    logP = 2.9);
  annotation (Documentation(info = "<html><body><p>Carboprost is a prostaglandin used as a uterotonic and abortifacient, for example to induce abortion or control bleeding after childbirth. It is an approved drug, though it does not appear to have central European Union authorisation.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5038067&quot;>Wikidata Q5038067</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>carboprost</td></tr><tr><td>ATC codes:</td><td>G02AD04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB19356&quot;>DB19356</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5281075&quot;>5281075</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3403&quot;>3403</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5038067&quot;>Q5038067</a></td></tr><tr><td>formula:</td><td>C21H36O5</td></tr><tr><td>molar mass:</td><td>368.514 g/mol (PubChem)</td></tr></table></body></html>"));
