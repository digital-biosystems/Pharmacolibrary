  annotation (Documentation(info = "<html><body><p>Moxestrol is a synthetic estrogen, a sex hormone that was studied as an estrogenic drug. It is classed as experimental and does not appear to be an approved medicine today.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q10858994\">Wikidata Q10858994</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>moxestrol</td></tr><tr><td>ATC codes:</td><td>G03CB04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13418\">DB13418</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/11954041\">11954041</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:34857\">34857</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q10858994\">Q10858994</a></td></tr><tr><td>formula:</td><td>C21H26O3</td></tr><tr><td>molar mass:</td><td>326.436 g/mol (PubChem CID 11954041)</td></tr><tr><td>logP:</td><td>3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
