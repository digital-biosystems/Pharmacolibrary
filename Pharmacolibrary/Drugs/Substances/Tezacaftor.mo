  annotation (Documentation(info = "<html><body><p>Tezacaftor is a CFTR corrector used, in combination with other cystic fibrosis drugs, to treat cystic fibrosis. It is an approved medicine used in combination therapy for eligible patients with cystic fibrosis, mainly in the United States and Europe.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27270940&quot;>Wikidata Q27270940</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Tezacaftor</td></tr><tr><td>ATC codes:</td><td>R07AX31, R07AX32, R07AX33</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11712&quot;>DB11712</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/46199646&quot;>46199646</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27270940&quot;>Q27270940</a></td></tr><tr><td>formula:</td><td>C26H27F3N2O6</td></tr><tr><td>molar mass:</td><td>520.504 g/mol (PubChem)</td></tr></table></body></html>"));
