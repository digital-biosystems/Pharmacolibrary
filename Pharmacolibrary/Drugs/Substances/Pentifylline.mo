    logP = 2.3);
  annotation (Documentation(info = "<html><body><p>Pentifylline is a purine-derivative peripheral vasodilator that has been used for circulatory problems affecting the limbs. It is not an approved medicine today and is considered experimental, so it is not in routine clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7165191&quot;>Wikidata Q7165191</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pentifylline</td></tr><tr><td>ATC codes:</td><td>C04AD01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13634&quot;>DB13634</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/70569&quot;>70569</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135091&quot;>135091</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7165191&quot;>Q7165191</a></td></tr><tr><td>formula:</td><td>C13H20N4O2</td></tr><tr><td>molar mass:</td><td>264.329 g/mol (PubChem)</td></tr></table></body></html>"));
end Pentifylline;
