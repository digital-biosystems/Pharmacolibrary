within Pharmacolibrary.Drugs.Substances;
package Benoxaprofen "benoxaprofen"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "benoxaprofen",
    atcCodes = {"M01AE06"},
    drugbankId = "DB04812",
    pubchemCid = "39941",
    chebiId = "76114",
    wikidataId = "Q420082",
