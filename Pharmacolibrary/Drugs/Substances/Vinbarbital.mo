  annotation (Documentation(info = "<html><body><p>Vinbarbital is a barbiturate that was classified as a hypnotic and sedative for use in nervous system disorders. It is now considered only an experimental compound and does not appear to be an approved medicine today.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q409579&quot;>Wikidata Q409579</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>vinbarbital</td></tr><tr><td>ATC codes:</td><td>N05CA09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13377&quot;>DB13377</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5284636&quot;>5284636</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q409579&quot;>Q409579</a></td></tr><tr><td>formula:</td><td>C11H16N2O3</td></tr><tr><td>molar mass:</td><td>224.26 g/mol (PubChem)</td></tr></table></body></html>"));
