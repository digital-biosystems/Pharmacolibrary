    logP = 5.4);
  annotation (Documentation(info = "<html><body><p>Cetiedil is a vasodilator that has also been studied as an antisickling agent, and it was classified as a peripheral vasodilator for cardiovascular use. It is considered experimental and there is no evidence of current authorised use in major markets such as the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5065661\">Wikidata Q5065661</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cetiedil</td></tr><tr><td>ATC codes:</td><td>C04AX26</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13753\">DB13753</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/66384\">66384</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:34619\">34619</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5065661\">Q5065661</a></td></tr><tr><td>formula:</td><td>C20H31NO2S</td></tr><tr><td>molar mass:</td><td>349.533 g/mol (PubChem CID 66384)</td></tr><tr><td>logP:</td><td>5.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Cetiedil;
