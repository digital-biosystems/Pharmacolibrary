    logP = 6);
  annotation (Documentation(info = "<html><body><p>Astemizole is a non-sedating antihistamine that was used to treat allergic conditions such as urticaria and giant papillary conjunctivitis. It has been withdrawn from the market because it could cause serious heart rhythm problems, including QT prolongation.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q423437&quot;>Wikidata Q423437</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>astemizole</td></tr><tr><td>ATC codes:</td><td>R06AX11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00637&quot;>DB00637</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2247&quot;>2247</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:2896&quot;>2896</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q423437&quot;>Q423437</a></td></tr><tr><td>formula:</td><td>C28H31FN4O</td></tr><tr><td>molar mass:</td><td>458.581 g/mol (PubChem)</td></tr></table></body></html>"));
end Astemizole;
