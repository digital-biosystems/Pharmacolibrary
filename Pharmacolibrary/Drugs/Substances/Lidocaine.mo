    logP = 2.3);
  annotation (Documentation(info = "<html><body><p>Lidocaine is a local anesthetic used to numb pain, for example on skin, in the mouth and throat, and for burns, and it is also used as an antiarrhythmic for heart rhythm problems such as ventricular fibrillation and tachycardia. It is widely used worldwide, is listed among WHO essential medicines, and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q216935&quot;>Wikidata Q216935</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>lidocaine</td></tr><tr><td>ATC codes:</td><td>C01BB01, C05AD01, D04AB01, N01BB02, R02AD02, S01HA07, S02DA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00281&quot;>DB00281</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3676&quot;>3676</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6456&quot;>6456</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q216935&quot;>Q216935</a></td></tr><tr><td>formula:</td><td>C14H22N2O</td></tr><tr><td>molar mass:</td><td>234.343 g/mol (PubChem)</td></tr></table></body></html>"));
end Lidocaine;
