    logP = 1.8);
  annotation (Documentation(info = "<html><body><p>Metildigoxin is a digitalis cardiac glycoside with cardiotonic and antiarrhythmic activity, studied for heart conditions such as heart failure and rhythm disorders. It is considered investigational and does not appear to have an authorised marketing authorisation in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q550017\">Wikidata Q550017</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>metildigoxin</td></tr><tr><td>ATC codes:</td><td>C01AA08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13401\">DB13401</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/443946\">443946</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135885\">135885</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q550017\">Q550017</a></td></tr><tr><td>formula:</td><td>C42H66O14</td></tr><tr><td>molar mass:</td><td>794.976 g/mol (PubChem CID 443946)</td></tr><tr><td>logP:</td><td>1.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Metildigoxin;
