  annotation (Documentation(info = "<html><body><p>Pimecrolimus is a non-steroidal calcineurin inhibitor used to treat atopic dermatitis. It is an approved dermatological medicine, applied to the skin, and carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q417489&quot;>Wikidata Q417489</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pimecrolimus</td></tr><tr><td>ATC codes:</td><td>D11AH02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00337&quot;>DB00337</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6509979&quot;>6509979</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135888&quot;>135888</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q417489&quot;>Q417489</a></td></tr><tr><td>formula:</td><td>C43H68ClNO11</td></tr><tr><td>molar mass:</td><td>810.463 g/mol (PubChem)</td></tr></table></body></html>"));
