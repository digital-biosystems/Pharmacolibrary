within Pharmacolibrary.Drugs.Substances;
package Nedosiran "nedosiran"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "nedosiran",
    atcCodes = {"A16AX25"},
    drugbankId = "DB17635",
    wikidataId = "Q123420884");
  annotation (Documentation(info = "<html><body><p>Nedosiran is a small interfering RNA medication used to treat primary hyperoxaluria. It is an approved prescription drug, though it does not appear to be authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q123420884\">Wikidata Q123420884</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nedosiran</td></tr><tr><td>ATC codes:</td><td>A16AX25</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB17635\">DB17635</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q123420884\">Q123420884</a></td></tr></table></body></html>"));
end Nedosiran;
