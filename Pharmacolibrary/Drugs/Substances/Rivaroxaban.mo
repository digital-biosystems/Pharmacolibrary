within Pharmacolibrary.Drugs.Substances;
package Rivaroxaban "rivaroxaban"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "rivaroxaban",
    atcCodes = {"B01AF01"},
    drugbankId = "DB06228",
    pubchemCid = "9875401",
    chebiId = "68579",
    wikidataId = "Q420262",
