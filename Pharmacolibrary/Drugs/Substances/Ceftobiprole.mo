  annotation (Documentation(info = "<html><body><p>Ceftobiprole is an antibiotic (a beta-lactam antibacterial) developed for treating bacterial infections. It is listed as having been withdrawn, so it is no longer in general use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5057301&quot;>Wikidata Q5057301</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ceftobiprole</td></tr><tr><td>ATC codes:</td><td>J01DI01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB04918&quot;>DB04918</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/12993649&quot;>12993649</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:140407&quot;>140407</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5057301&quot;>Q5057301</a></td></tr><tr><td>formula:</td><td>C20H22N8O6S2</td></tr><tr><td>molar mass:</td><td>534.57 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
