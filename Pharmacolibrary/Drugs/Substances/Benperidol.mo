  annotation (Documentation(info = "<html><body><p>Benperidol is a butyrophenone antipsychotic that acts as a dopamine antagonist and was used to treat psychotic conditions such as schizophrenia. It is no longer in general use, as it is recorded as a withdrawn drug.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q424412\">Wikidata Q424412</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>benperidol</td></tr><tr><td>ATC codes:</td><td>N05AD07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12867\">DB12867</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/16363\">16363</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:93403\">93403</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q424412\">Q424412</a></td></tr><tr><td>formula:</td><td>C22H24FN3O2</td></tr><tr><td>molar mass:</td><td>381.451 g/mol (PubChem CID 16363)</td></tr><tr><td>logP:</td><td>3.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
