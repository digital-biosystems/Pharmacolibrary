    logP = 3.5);
  annotation (Documentation(info = "<html><body><p>Aliskiren is a direct renin inhibitor used to treat high blood pressure (arterial hypertension). It is authorised in the European Union for hypertension, though several EU products have been withdrawn, and it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q414904\">Wikidata Q414904</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>aliskiren</td></tr><tr><td>ATC codes:</td><td>C09XA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09026\">DB09026</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5493444\">5493444</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:601027\">601027</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q414904\">Q414904</a></td></tr><tr><td>formula:</td><td>C30H53N3O6</td></tr><tr><td>molar mass:</td><td>551.769 g/mol (PubChem CID 5493444)</td></tr><tr><td>logP:</td><td>3.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Aliskiren;
