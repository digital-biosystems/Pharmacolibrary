  annotation (Documentation(info = "<html><body><p>Pipemidic acid is a quinolone antibiotic that has been used as a urinary anti-infective to treat bacterial infections of the urinary tract. It is not an approved medicine in major markets today and is considered investigational, having largely fallen out of clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q754986\">Wikidata Q754986</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pipemidic acid</td></tr><tr><td>ATC codes:</td><td>J01MB04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13823\">DB13823</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:75250\">75250</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q754986\">Q754986</a></td></tr><tr><td>formula:</td><td>C14H17N5O3</td></tr><tr><td>molar mass:</td><td>303.317 g/mol (knowledgebase (DrugBank calculated))</td></tr><tr><td>logP:</td><td>-2.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
