  annotation (Documentation(info = "<html><body><p>Oxymorphone is an opioid painkiller used to treat moderate to severe pain. It is an approved medicine, also approved for veterinary use, and is used mainly in North America rather than the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q423380\">Wikidata Q423380</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>oxymorphone</td></tr><tr><td>ATC codes:</td><td>N02AA11</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01192\">DB01192</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5284604\">5284604</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7865\">7865</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q423380\">Q423380</a></td></tr><tr><td>formula:</td><td>C17H19NO4</td></tr><tr><td>molar mass:</td><td>301.342 g/mol (PubChem CID 5284604)</td></tr><tr><td>logP:</td><td>0.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
