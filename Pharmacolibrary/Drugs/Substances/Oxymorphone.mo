  annotation (Documentation(info = "<html><body><p>Oxymorphone is an opioid painkiller used to treat moderate to severe pain. It is an approved medicine, also approved for veterinary use, and is used mainly in North America rather than the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q423380&quot;>Wikidata Q423380</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>oxymorphone</td></tr><tr><td>ATC codes:</td><td>N02AA11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01192&quot;>DB01192</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5284604&quot;>5284604</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7865&quot;>7865</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q423380&quot;>Q423380</a></td></tr><tr><td>formula:</td><td>C17H19NO4</td></tr><tr><td>molar mass:</td><td>301.342 g/mol (PubChem)</td></tr></table></body></html>"));
