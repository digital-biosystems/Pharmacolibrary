  annotation (Documentation(info = "<html><body><p>Rhenium Re-186 sulfide colloid is a therapeutic radiopharmaceutical classified as an antiinflammatory radioactive agent. It appears to be experimental, with no evidence of current marketing authorisation, so its present use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27272832\">Wikidata Q27272832</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>rhenium (186Re) sulfide colloid</td></tr><tr><td>ATC codes:</td><td>V10AX05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13847\">DB13847</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27272832\">Q27272832</a></td></tr><tr><td>molar mass:</td><td>596.4 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
