  annotation (Documentation(info = "<html><body><p>Mecobalamin is a vitamin B12 analogue used as an antianemic medicine to treat vitamin B12 deficiency and related anaemias. It is an approved drug and is also being studied for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q250442&quot;>Wikidata Q250442</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mecobalamin</td></tr><tr><td>ATC codes:</td><td>B03BA05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB03614&quot;>DB03614</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/71306319&quot;>71306319</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:28115&quot;>28115</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q250442&quot;>Q250442</a></td></tr><tr><td>formula:</td><td>C63H91CoN13O14P-3</td></tr><tr><td>molar mass:</td><td>1344.4 g/mol (PubChem)</td></tr></table></body></html>"));
