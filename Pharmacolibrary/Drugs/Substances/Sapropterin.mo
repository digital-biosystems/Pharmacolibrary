  annotation (Documentation(info = "<html><body><p>Sapropterin is used to treat phenylketonuria, a metabolic disorder. It is authorised in the European Union and is an approved medicine, though it has also been studied for other investigational uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q419808&quot;>Wikidata Q419808</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>sapropterin</td></tr><tr><td>ATC codes:</td><td>A16AX07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00360&quot;>DB00360</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/44257&quot;>44257</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:59560&quot;>59560</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q419808&quot;>Q419808</a></td></tr><tr><td>formula:</td><td>C9H15N5O3</td></tr><tr><td>molar mass:</td><td>241.247 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
