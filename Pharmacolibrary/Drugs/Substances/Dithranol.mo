  annotation (Documentation(info = "<html><body><p>Dithranol (anthralin) is a topical antipsoriatic drug used to treat psoriasis, including acropustulosis. It remains an approved dermatological medicine, applied topically to the skin.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q419397\">Wikidata Q419397</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dithranol</td></tr><tr><td>ATC codes:</td><td>D05AC01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11157\">DB11157</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2202\">2202</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:37510\">37510</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q419397\">Q419397</a></td></tr><tr><td>formula:</td><td>C14H10O3</td></tr><tr><td>molar mass:</td><td>226.231 g/mol (PubChem CID 2202)</td></tr><tr><td>logP:</td><td>3.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
