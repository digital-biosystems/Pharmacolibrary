    logP = 0.9);
  annotation (Documentation(info = "<html><body><p>Bethanidine is a peripherally acting antiadrenergic (sympatholytic) drug that has been used to treat arterial hypertension. It is an approved guanidine-derivative antihypertensive, though this older medicine is now only rarely used in practice.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q794152&quot;>Wikidata Q794152</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>betanidine</td></tr><tr><td>ATC codes:</td><td>C02CC01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00217&quot;>DB00217</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/135449343&quot;>135449343</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q794152&quot;>Q794152</a></td></tr><tr><td>formula:</td><td>C18H16N2O8</td></tr><tr><td>molar mass:</td><td>388.332 g/mol (PubChem)</td></tr></table></body></html>"));
end Betanidine;
