    logP = 0.9);
  annotation (Documentation(info = "<html><body><p>Bethanidine is a peripherally acting antiadrenergic (sympatholytic) drug that has been used to treat arterial hypertension. It is an approved guanidine-derivative antihypertensive, though this older medicine is now only rarely used in practice.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q794152\">Wikidata Q794152</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>betanidine</td></tr><tr><td>ATC codes:</td><td>C02CC01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00217\">DB00217</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/135449343\">135449343</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q794152\">Q794152</a></td></tr><tr><td>formula:</td><td>C18H16N2O8</td></tr><tr><td>molar mass:</td><td>388.332 g/mol (PubChem CID 135449343)</td></tr><tr><td>logP:</td><td>0.9 (Drugs.Common 25.09, not verified)</td></tr></table><p><small>Drugs.Common 25.09 gave 177.25 g/mol (-54.4 %); replaced by the value above</small></p></body></html>"));
end Betanidine;
