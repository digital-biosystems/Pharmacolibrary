  annotation (Documentation(info = "<html><body><p>Fumagillin is an antibiotic-like compound with antiprotozoal and angiogenesis-inhibiting activity, studied against protozoal infections. It is not an established marketed medicine; DrugBank classifies it as experimental, so its use remains investigational.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q120199\">Wikidata Q120199</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>fumagillin</td></tr><tr><td>ATC codes:</td><td>P01AX10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB02640\">DB02640</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6917655\">6917655</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:48635\">48635</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q120199\">Q120199</a></td></tr><tr><td>formula:</td><td>C26H34O7</td></tr><tr><td>molar mass:</td><td>458.551 g/mol (PubChem CID 6917655)</td></tr><tr><td>logP:</td><td>4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
