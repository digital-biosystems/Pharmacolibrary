  annotation (Documentation(info = "<html><body><p>Govorestat was developed as a treatment for galactosemia. It remains investigational; its marketing authorisation application in the European Union was withdrawn, so it is not approved there.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q123481136&quot;>Wikidata Q123481136</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>govorestat</td></tr><tr><td>ATC codes:</td><td>A16AX24</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB16707&quot;>DB16707</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/132260161&quot;>132260161</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q123481136&quot;>Q123481136</a></td></tr><tr><td>formula:</td><td>C17H10F3N3O3S2</td></tr><tr><td>molar mass:</td><td>425.399 g/mol (PubChem)</td></tr></table></body></html>"));
