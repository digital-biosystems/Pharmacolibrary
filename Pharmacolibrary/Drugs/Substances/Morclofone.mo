  annotation (Documentation(info = "<html><body><p>Morclofone is classified as an other cough suppressant, so it has been used to treat cough. It appears to be only an experimental compound, with no established marketing authorisation, so its current availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6909555&quot;>Wikidata Q6909555</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>morclofone</td></tr><tr><td>ATC codes:</td><td>R05DB25</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13558&quot;>DB13558</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/35949&quot;>35949</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135657&quot;>135657</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6909555&quot;>Q6909555</a></td></tr><tr><td>formula:</td><td>C21H24ClNO5</td></tr><tr><td>molar mass:</td><td>405.875 g/mol (PubChem)</td></tr></table></body></html>"));
