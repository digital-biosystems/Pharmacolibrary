  annotation (Documentation(info = "<html><body><p>Pancrelipase, a mixture of pancreatic enzymes including lipase and protease, is a digestive enzyme preparation used as a gastrointestinal agent to aid digestion. It is an approved medicine, available as a digestive enzyme product, though it is not authorised centrally in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7130425&quot;>Wikidata Q7130425</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>multienzymes (lipase, protease etc.)</td></tr><tr><td>ATC codes:</td><td>A09AA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00085&quot;>DB00085</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7130425&quot;>Q7130425</a></td></tr><tr><td>molar mass:</td><td>131000 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end MultienzymesLipaseProteaseEtc;
