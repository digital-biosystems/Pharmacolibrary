  annotation (Documentation(info = "<html><body><p>Tilbroquinol is an antiprotozoal drug used to treat amebiasis. It is an approved hydroxyquinoline antiprotozoal, though it is not widely used today.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7802069\">Wikidata Q7802069</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tilbroquinol</td></tr><tr><td>ATC codes:</td><td>P01AA05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13222\">DB13222</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/65592\">65592</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134965\">134965</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7802069\">Q7802069</a></td></tr><tr><td>formula:</td><td>C10H8BrNO</td></tr><tr><td>molar mass:</td><td>238.084 g/mol (PubChem CID 65592)</td></tr><tr><td>logP:</td><td>3.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
