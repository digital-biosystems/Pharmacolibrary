  annotation (Documentation(info = "<html><body><p>Iopentol is an iodinated, low-osmolar contrast agent used as an X-ray imaging contrast medium. It remains experimental and is not an established marketed medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6063892\">Wikidata Q6063892</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>iopentol</td></tr><tr><td>ATC codes:</td><td>V08AB08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13861\">DB13861</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/56016\">56016</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135893\">135893</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6063892\">Q6063892</a></td></tr><tr><td>formula:</td><td>C20H28I3N3O9</td></tr><tr><td>molar mass:</td><td>835.156 g/mol (PubChem CID 56016)</td></tr><tr><td>logP:</td><td>-2.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
