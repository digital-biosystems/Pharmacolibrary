    logP = -3.1);
  annotation (Documentation(info = "<html><body><p>Sorbitol is an osmotic laxative used to treat constipation, and has also been used in end stage renal failure. It remains in use, mainly as a laxative taken by mouth or as an enema, and also serves in irrigating solutions and as an excipient.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q245280&quot;>Wikidata Q245280</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sorbitol</td></tr><tr><td>ATC codes:</td><td>A06AD18, A06AG07, B05CX02, V04CC01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01638&quot;>DB01638</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5780&quot;>5780</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:17924&quot;>17924</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q245280&quot;>Q245280</a></td></tr><tr><td>formula:</td><td>C6H14O6</td></tr><tr><td>molar mass:</td><td>182.172 g/mol (PubChem)</td></tr></table></body></html>"));
end Sorbitol;
