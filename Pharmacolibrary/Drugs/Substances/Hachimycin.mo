  annotation (Documentation(info = "<html><body><p>Hachimycin is an antibiotic antifungal agent, classified for topical dermatological, gynecological, and systemic use against fungal infections. It appears to be an experimental drug with no confirmed current marketing authorisation, so its present availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5637062&quot;>Wikidata Q5637062</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>hachimycin</td></tr><tr><td>ATC codes:</td><td>D01AA03, G01AA06, J02AA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13302&quot;>DB13302</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/24883860&quot;>24883860</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5637062&quot;>Q5637062</a></td></tr><tr><td>formula:</td><td>C116H168N4O36</td></tr><tr><td>molar mass:</td><td>2194.61 g/mol (PubChem)</td></tr></table></body></html>"));
