    logP = 2.9);
  annotation (Documentation(info = "<html><body><p>Yohimbine is an alpha-2 blocker used for erectile dysfunction and hypoactive sexual desire disorder. It is classified for erectile dysfunction in urological drug groups and has approved and veterinary-approved status, though some products have been withdrawn; it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q412226\">Wikidata Q412226</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>yohimbine</td></tr><tr><td>ATC codes:</td><td>G04BE04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01392\">DB01392</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/8969\">8969</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:10093\">10093</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q412226\">Q412226</a></td></tr><tr><td>formula:</td><td>C21H26N2O3</td></tr><tr><td>molar mass:</td><td>354.45 g/mol (PubChem CID 8969)</td></tr><tr><td>logP:</td><td>2.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Yohimbine;
