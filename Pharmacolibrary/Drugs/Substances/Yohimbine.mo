  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "yohimbine",
    atcCodes = {"G04BE04"},
    drugbankId = "DB01392",
    pubchemCid = "8969",
    chebiId = "10093",
    wikidataId = "Q412226",
