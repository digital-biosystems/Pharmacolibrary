  annotation (Documentation(info = "<html><body><p>Tiotropium bromide is an inhaled anticholinergic bronchodilator used for obstructive airway and other lung diseases. It is an approved medicine and is widely used as a maintenance inhalation treatment for breathing disorders.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q424316&quot;>Wikidata Q424316</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tiotropium bromide</td></tr><tr><td>ATC codes:</td><td>R03BB04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01409&quot;>DB01409</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5487427&quot;>5487427</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:90960&quot;>90960</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q424316&quot;>Q424316</a></td></tr><tr><td>formula:</td><td>C19H22NO4S2+</td></tr><tr><td>molar mass:</td><td>392.508 g/mol (PubChem)</td></tr></table></body></html>"));
