within Pharmacolibrary.Drugs.Substances;
package MedicalAir "medical air"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "medical air",
    atcCodes = {"V03AN05"},
    drugbankId = "DB09337",
    wikidataId = "Q84810530");
  annotation (Documentation(info = "<html><body><p>Medical air is a breathing gas used as a medical gas, for example to support patients' breathing. It is an approved medicinal product, also approved for veterinary use, and is widely available as a medical gas.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q84810530\">Wikidata Q84810530</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>medical air</td></tr><tr><td>ATC codes:</td><td>V03AN05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09337\">DB09337</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q84810530\">Q84810530</a></td></tr></table></body></html>"));
end MedicalAir;
