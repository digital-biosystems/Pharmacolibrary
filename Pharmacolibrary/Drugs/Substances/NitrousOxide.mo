    logP = 0.5);
  annotation (Documentation(info = "<html><body><p>Nitrous oxide is an inhalational general anaesthetic and non-opioid analgesic used for pain relief and sedation, including in situations such as respiratory distress. It is an approved medicine that is widely used, and it is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q905750\">Wikidata Q905750</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nitrous oxide</td></tr><tr><td>ATC codes:</td><td>N01AX13</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06690\">DB06690</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/948\">948</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:17045\">17045</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q905750\">Q905750</a></td></tr><tr><td>formula:</td><td>N2O</td></tr><tr><td>molar mass:</td><td>44.013 g/mol (PubChem CID 948)</td></tr><tr><td>logP:</td><td>0.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end NitrousOxide;
