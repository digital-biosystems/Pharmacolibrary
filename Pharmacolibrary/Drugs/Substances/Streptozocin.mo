    logP = -1.4);
  annotation (Documentation(info = "<html><body><p>Streptozocin is a nitrosourea antibiotic used to treat cancers, mainly pancreatic cancer, and also colorectal cancer and Hodgkin's lymphoma. It is an approved anticancer drug, though not authorised centrally in the European Union, and is used mainly in specialised cancer treatment.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q257331\">Wikidata Q257331</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>streptozocin</td></tr><tr><td>ATC codes:</td><td>L01AD04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00428\">DB00428</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/29327\">29327</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9288\">9288</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q257331\">Q257331</a></td></tr><tr><td>formula:</td><td>C8H15N3O7</td></tr><tr><td>molar mass:</td><td>265.222 g/mol (PubChem CID 29327)</td></tr><tr><td>logP:</td><td>-1.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
