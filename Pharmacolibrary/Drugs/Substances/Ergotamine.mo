  annotation (Documentation(info = "<html><body><p>Ergotamine is an ergot alkaloid used to treat migraine attacks. It is an approved antimigraine medicine, though its use is limited by safety concerns and it is generally not a first-choice treatment.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q419186&quot;>Wikidata Q419186</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ergotamine</td></tr><tr><td>ATC codes:</td><td>N02CA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00696&quot;>DB00696</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/8223&quot;>8223</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:64318&quot;>64318</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q419186&quot;>Q419186</a></td></tr><tr><td>formula:</td><td>C33H35N5O5</td></tr><tr><td>molar mass:</td><td>581.673 g/mol (PubChem)</td></tr></table></body></html>"));
