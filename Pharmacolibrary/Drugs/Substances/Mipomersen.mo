  annotation (Documentation(info = "<html><body><p>Mipomersen is an antisense medicine that acts as a lipid-modifying agent to lower blood lipids. It has approved drug status and is grouped with other lipid-modifying agents, though it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3315722&quot;>Wikidata Q3315722</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mipomersen</td></tr><tr><td>ATC codes:</td><td>C10AX11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB05528&quot;>DB05528</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/131704297&quot;>131704297</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3315722&quot;>Q3315722</a></td></tr><tr><td>formula:</td><td>C230H324N67O122P19S19</td></tr><tr><td>molar mass:</td><td>7177.11 g/mol (PubChem)</td></tr></table></body></html>"));
