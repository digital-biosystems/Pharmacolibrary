    wikidataId = "Q27086456");
  annotation (Documentation(info = "<html><body><p>Mipomersen is a lipid-modifying medicine used to lower cholesterol in people with a severe inherited form of high cholesterol. It is an approved drug, used mainly in the United States for this rare condition.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27086456\">Wikidata Q27086456</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mipomersen</td></tr><tr><td>ATC codes:</td><td>C10AX11</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB05528\">DB05528</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/131704297\">131704297</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27086456\">Q27086456</a></td></tr></table></body></html>"));
end Mipomersen;
