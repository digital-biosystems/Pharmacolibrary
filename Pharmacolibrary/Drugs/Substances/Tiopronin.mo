  annotation (Documentation(info = "<html><body><p>Tiopronin is a urological medicine used to treat cystinuria, a condition causing recurring kidney stones. It is an approved drug and is used in several countries, mainly as a second-line option when other measures are not enough.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q414456\">Wikidata Q414456</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tiopronin</td></tr><tr><td>ATC codes:</td><td>G04BX16</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06823\">DB06823</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5483\">5483</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32229\">32229</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q414456\">Q414456</a></td></tr><tr><td>formula:</td><td>C5H9NO3S</td></tr><tr><td>molar mass:</td><td>163.191 g/mol (PubChem CID 5483)</td></tr><tr><td>logP:</td><td>-0.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
