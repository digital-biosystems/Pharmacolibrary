    logP = 1.4);
  annotation (Documentation(info = "<html><body><p>Nalidixic acid is a quinolone antibiotic that was used to treat urinary tract infections, including those caused by Escherichia coli. It has been withdrawn from use, so it is no longer available for treating patients.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q281082&quot;>Wikidata Q281082</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nalidixic acid</td></tr><tr><td>ATC codes:</td><td>J01MB02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00779&quot;>DB00779</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4421&quot;>4421</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:100147&quot;>100147</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q281082&quot;>Q281082</a></td></tr><tr><td>formula:</td><td>C12H12N2O3</td></tr><tr><td>molar mass:</td><td>232.239 g/mol (PubChem)</td></tr></table></body></html>"));
