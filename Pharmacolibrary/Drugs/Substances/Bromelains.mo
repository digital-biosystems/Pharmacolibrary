within Pharmacolibrary.Drugs.Substances;
package Bromelains "bromelains"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "bromelains",
    atcCodes = {"D03BA03", "M09AB03"},
    drugbankId = "DB13281",
    wikidataId = "Q19903607");
  annotation (Documentation(info = "<html><body><p>Bromelains, a mixture of proteolytic enzymes from pineapple, is used to help clean dead tissue from wounds and ulcers (debridement) and in preparations for musculoskeletal disorders. It remains in use, with one product authorised in the European Union for wound debridement, and is also being investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q19903607\">Wikidata Q19903607</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>bromelains</td></tr><tr><td>ATC codes:</td><td>D03BA03, M09AB03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13281\">DB13281</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q19903607\">Q19903607</a></td></tr></table></body></html>"));
end Bromelains;
