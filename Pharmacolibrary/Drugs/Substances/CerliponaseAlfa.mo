  annotation (Documentation(info = "<html><body><p>Cerliponase alfa is an enzyme medication used to treat neuronal ceroid-lipofuscinosis, a rare metabolic disease. It is authorised in the European Union and is used only in specialised care for this very rare condition.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q33626059&quot;>Wikidata Q33626059</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>cerliponase alfa</td></tr><tr><td>ATC codes:</td><td>A16AB17</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13173&quot;>DB13173</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q33626059&quot;>Q33626059</a></td></tr><tr><td>molar mass:</td><td>59000 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end CerliponaseAlfa;
