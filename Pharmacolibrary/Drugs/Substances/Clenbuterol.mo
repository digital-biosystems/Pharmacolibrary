within Pharmacolibrary.Drugs.Substances;
package Clenbuterol "clenbuterol"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "clenbuterol",
    atcCodes = {"R03AC14", "R03CC13"},
    drugbankId = "DB01407",
    pubchemCid = "2783",
    chebiId = "174690",
    wikidataId = "Q223412",
    formula = "C12H18Cl2N2O",
    M = 0.277189,
    logP = 2.2);
  annotation (Documentation(info = "<html><body><p>Clenbuterol is a beta-2 agonist bronchodilator used to treat breathing problems such as asthma and chronic obstructive pulmonary disease. It is not authorised in the European Union for people and is mainly used in veterinary medicine, with human availability limited to a few countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q223412\">Wikidata Q223412</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>clenbuterol</td></tr><tr><td>ATC codes:</td><td>R03AC14, R03CC13</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01407\">DB01407</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2783\">2783</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:174690\">174690</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q223412\">Q223412</a></td></tr><tr><td>formula:</td><td>C12H18Cl2N2O</td></tr><tr><td>molar mass:</td><td>277.189 g/mol (PubChem CID 2783)</td></tr><tr><td>logP:</td><td>2.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Clenbuterol;
