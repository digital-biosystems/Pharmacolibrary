  annotation (Documentation(info = "<html><body><p>Indoprofen is a non-steroidal anti-inflammatory drug of the propionic acid class, used to treat pain and inflammation in musculoskeletal and rheumatic conditions. It was approved at one time but has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3798358\">Wikidata Q3798358</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>indoprofen</td></tr><tr><td>ATC codes:</td><td>M01AE10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08951\">DB08951</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3718\">3718</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:76162\">76162</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3798358\">Q3798358</a></td></tr><tr><td>formula:</td><td>C17H15NO3</td></tr><tr><td>molar mass:</td><td>281.311 g/mol (PubChem CID 3718)</td></tr><tr><td>logP:</td><td>2.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Indoprofen;
