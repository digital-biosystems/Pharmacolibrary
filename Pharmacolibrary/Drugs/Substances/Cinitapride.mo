  annotation (Documentation(info = "<html><body><p>Cinitapride is a propulsive drug for functional gastrointestinal disorders and has been described as an anti-ulcer agent. It is considered investigational and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5121012\">Wikidata Q5121012</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cinitapride</td></tr><tr><td>ATC codes:</td><td>A03FA08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08810\">DB08810</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/68867\">68867</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135642\">135642</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5121012\">Q5121012</a></td></tr><tr><td>formula:</td><td>C21H30N4O4</td></tr><tr><td>molar mass:</td><td>402.495 g/mol (PubChem CID 68867)</td></tr><tr><td>logP:</td><td>3.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
