  annotation (Documentation(info = "<html><body><p>Aminophenazone is a pyrazolone drug that was used as an analgesic and antipyretic to relieve pain and fever. It has been withdrawn from use, reportedly because of the risk of serious blood disorders such as agranulocytosis.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q416503\">Wikidata Q416503</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>aminophenazone</td></tr><tr><td>ATC codes:</td><td>N02BB03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01424\">DB01424</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6009\">6009</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:160246\">160246</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q416503\">Q416503</a></td></tr><tr><td>formula:</td><td>C13H17N3O</td></tr><tr><td>molar mass:</td><td>231.299 g/mol (PubChem CID 6009)</td></tr><tr><td>logP:</td><td>1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
