  annotation (Documentation(info = "<html><body><p>Phenoperidine is an opioid used as an analgesic component of general anesthesia. It is used only in hospital settings during anesthesia and is available in only a few countries, mainly France.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7181394&quot;>Wikidata Q7181394</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>phenoperidine</td></tr><tr><td>ATC codes:</td><td>N01AH04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13605&quot;>DB13605</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/11226&quot;>11226</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135550&quot;>135550</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7181394&quot;>Q7181394</a></td></tr><tr><td>formula:</td><td>C23H29NO3</td></tr><tr><td>molar mass:</td><td>367.489 g/mol (PubChem)</td></tr></table></body></html>"));
