  annotation (Documentation(info = "<html><body><p>Quifenadine is an antihistamine for systemic use, acting as a histamine antagonist. It is listed as an experimental drug, and there is no evidence it is currently authorised or widely used.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4497981\">Wikidata Q4497981</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>quifenadine</td></tr><tr><td>ATC codes:</td><td>R06AX31</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13713\">DB13713</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/65600\">65600</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134746\">134746</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4497981\">Q4497981</a></td></tr><tr><td>formula:</td><td>C20H23NO</td></tr><tr><td>molar mass:</td><td>293.41 g/mol (PubChem CID 65600)</td></tr><tr><td>logP:</td><td>3.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
