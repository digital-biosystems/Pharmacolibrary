within Pharmacolibrary.Drugs.Substances;
package DimethylFumarate "dimethyl fumarate"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "dimethyl fumarate",
    atcCodes = {"L04AX07"},
    drugbankId = "DB08908",
    pubchemCid = "637568",
    chebiId = "76004",
    wikidataId = "Q418123",
    formula = "C6H8O4",
    M = 0.144126,
    logP = 0.7);
  annotation (Documentation(info = "<html><body><p>Dimethyl fumarate is an immunosuppressive drug used to treat multiple sclerosis, including relapsing-remitting and secondary progressive forms, and has also been used for psoriasis. It is an approved medicine, authorised in the European Union for multiple sclerosis and psoriasis, and is used fairly widely.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q418123\">Wikidata Q418123</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>dimethyl fumarate</td></tr><tr><td>ATC codes:</td><td>L04AX07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08908\">DB08908</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/637568\">637568</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:76004\">76004</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q418123\">Q418123</a></td></tr><tr><td>formula:</td><td>C6H8O4</td></tr><tr><td>molar mass:</td><td>144.126 g/mol (PubChem CID 637568)</td></tr><tr><td>logP:</td><td>0.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end DimethylFumarate;
