  annotation (Documentation(info = "<html><body><p>Peramivir is an antiviral drug used to treat influenza. It is an approved neuraminidase inhibitor, though one product has been withdrawn from the European Union market.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q412734\">Wikidata Q412734</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>peramivir</td></tr><tr><td>ATC codes:</td><td>J05AH03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06614\">DB06614</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/154234\">154234</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:85202\">85202</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q412734\">Q412734</a></td></tr><tr><td>formula:</td><td>C15H28N4O4</td></tr><tr><td>molar mass:</td><td>328.413 g/mol (PubChem CID 154234)</td></tr></table></body></html>"));
