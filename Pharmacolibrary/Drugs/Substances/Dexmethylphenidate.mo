  annotation (Documentation(info = "<html><body><p>Dexmethylphenidate is a stimulant medicine used to treat attention deficit hyperactivity disorder. It is an approved drug, related to methylphenidate, and is used in the treatment of ADHD, though it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1207210\">Wikidata Q1207210</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dexmethylphenidate</td></tr><tr><td>ATC codes:</td><td>N06BA11</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06701\">DB06701</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/154101\">154101</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:51860\">51860</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1207210\">Q1207210</a></td></tr><tr><td>formula:</td><td>C14H19NO2</td></tr><tr><td>molar mass:</td><td>233.311 g/mol (PubChem CID 154101)</td></tr><tr><td>logP:</td><td>0.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
