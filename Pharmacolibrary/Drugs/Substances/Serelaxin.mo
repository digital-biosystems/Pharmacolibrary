  annotation (Documentation(info = "<html><body><p>Serelaxin, a recombinant form of human relaxin, was investigated as a treatment for heart failure. It remains investigational; a marketing application in the European Union was refused, so it is not authorised there.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7453086&quot;>Wikidata Q7453086</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>serelaxin</td></tr><tr><td>ATC codes:</td><td>C01DX21</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB05794&quot;>DB05794</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/71300755&quot;>71300755</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7453086&quot;>Q7453086</a></td></tr><tr><td>formula:</td><td>C256H408N74O74S8</td></tr><tr><td>molar mass:</td><td>5963 g/mol (PubChem)</td></tr></table></body></html>"));
