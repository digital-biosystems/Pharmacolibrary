  annotation (Documentation(info = "<html><body><p>Cefalexin is a first-generation cephalosporin antibiotic used to treat bacterial infections such as urinary tract infections, skin infections like cellulitis, pharyngitis, respiratory infections, and pneumonia. It is widely used in human medicine and is also approved for veterinary use, and it appears on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q411417&quot;>Wikidata Q411417</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cefalexin</td></tr><tr><td>ATC codes:</td><td>J01DB01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00567&quot;>DB00567</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/27447&quot;>27447</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q411417&quot;>Q411417</a></td></tr><tr><td>formula:</td><td>C16H17N3O4S</td></tr><tr><td>molar mass:</td><td>347.389 g/mol (PubChem)</td></tr></table></body></html>"));
end Cefalexin;
