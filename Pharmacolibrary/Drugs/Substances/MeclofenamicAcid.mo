  annotation (Documentation(info = "<html><body><p>Meclofenamic acid is a non-steroidal anti-inflammatory drug used to treat pain, inflammation, and arthritis. It is an approved medicine, also approved for veterinary use, and is available as topical products for joint and muscular pain.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2823284&quot;>Wikidata Q2823284</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>meclofenamic acid</td></tr><tr><td>ATC codes:</td><td>M01AG04, M02AA18</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00939&quot;>DB00939</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4037&quot;>4037</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6710&quot;>6710</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2823284&quot;>Q2823284</a></td></tr><tr><td>formula:</td><td>C14H11Cl2NO2</td></tr><tr><td>molar mass:</td><td>296.147 g/mol (PubChem)</td></tr></table></body></html>"));
