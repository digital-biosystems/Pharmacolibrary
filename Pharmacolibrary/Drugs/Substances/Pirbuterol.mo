    logP = -0.1);
  annotation (Documentation(info = "<html><body><p>Pirbuterol is a selective beta-2 adrenergic agonist that was used as a bronchodilator to treat asthma. It is no longer in use; it was withdrawn and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1236526\">Wikidata Q1236526</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pirbuterol</td></tr><tr><td>ATC codes:</td><td>R03AC08, R03CC07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01291\">DB01291</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4845\">4845</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8245\">8245</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1236526\">Q1236526</a></td></tr><tr><td>formula:</td><td>C12H20N2O3</td></tr><tr><td>molar mass:</td><td>240.303 g/mol (PubChem CID 4845)</td></tr><tr><td>logP:</td><td>-0.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Pirbuterol;
