  annotation (Documentation(info = "<html><body><p>Xenysalate (biphenamine) is a dermatological agent classified for use in medicated shampoos. It appears to be only experimental, with no evidence of authorised marketing in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27263918\">Wikidata Q27263918</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>xenysalate</td></tr><tr><td>ATC codes:</td><td>D11AC09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13815\">DB13815</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/21720\">21720</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135341\">135341</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27263918\">Q27263918</a></td></tr><tr><td>formula:</td><td>C19H23NO3</td></tr><tr><td>molar mass:</td><td>313.397 g/mol (PubChem CID 21720)</td></tr><tr><td>logP:</td><td>4.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
