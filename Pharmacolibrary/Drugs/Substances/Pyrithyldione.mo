  annotation (Documentation(info = "<html><body><p>Pyrithyldione is a piperidinedione derivative that was classified as a hypnotic and sedative medicine for the nervous system. It is currently listed only as an investigational compound, with no marketing authorisation on record, so its present availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q408959\">Wikidata Q408959</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pyrithyldione</td></tr><tr><td>ATC codes:</td><td>N05CE03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13331\">DB13331</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4994\">4994</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:94590\">94590</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q408959\">Q408959</a></td></tr><tr><td>formula:</td><td>C9H13NO2</td></tr><tr><td>molar mass:</td><td>167.208 g/mol (PubChem CID 4994)</td></tr><tr><td>logP:</td><td>1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
