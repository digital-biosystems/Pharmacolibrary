  annotation (Documentation(info = "<html><body><p>Alglucosidase alfa is an enzyme medication used to treat glycogen storage disease type II (Pompe disease). It is an approved enzyme therapy and has also been studied investigationally.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2919537&quot;>Wikidata Q2919537</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>alglucosidase alfa</td></tr><tr><td>ATC codes:</td><td>A16AB07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01272&quot;>DB01272</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2919537&quot;>Q2919537</a></td></tr><tr><td>molar mass:</td><td>105271 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
