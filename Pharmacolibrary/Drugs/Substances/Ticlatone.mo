  annotation (Documentation(info = "<html><body><p>Ticlatone is an antifungal agent that was classified for topical use against fungal skin infections. It is now considered experimental and does not appear to be an established marketed medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7800731&quot;>Wikidata Q7800731</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ticlatone</td></tr><tr><td>ATC codes:</td><td>D01AE08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13613&quot;>DB13613</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6258&quot;>6258</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:136026&quot;>136026</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7800731&quot;>Q7800731</a></td></tr><tr><td>formula:</td><td>C7H4ClNOS</td></tr><tr><td>molar mass:</td><td>185.625 g/mol (PubChem)</td></tr></table></body></html>"));
