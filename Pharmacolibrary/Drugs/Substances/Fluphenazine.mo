  annotation (Documentation(info = "<html><body><p>Fluphenazine is an antipsychotic used to treat schizophrenia and schizophreniform disorder. It remains an approved medicine and is included on the WHO list of essential medicines, so it is used fairly widely.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q58376\">Wikidata Q58376</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>fluphenazine</td></tr><tr><td>ATC codes:</td><td>N05AB02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00623\">DB00623</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3372\">3372</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:5123\">5123</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q58376\">Q58376</a></td></tr><tr><td>formula:</td><td>C22H26F3N3OS</td></tr><tr><td>molar mass:</td><td>437.524 g/mol (PubChem CID 3372)</td></tr><tr><td>logP:</td><td>4.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
