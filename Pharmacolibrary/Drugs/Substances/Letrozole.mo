  annotation (Documentation(info = "<html><body><p>Letrozole is an aromatase inhibitor used to treat breast cancer, including invasive ductal carcinoma and low-grade serous carcinoma. It is an approved medicine and is widely used as endocrine therapy for cancer.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q194974&quot;>Wikidata Q194974</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>letrozole</td></tr><tr><td>ATC codes:</td><td>L02BG04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01006&quot;>DB01006</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3902&quot;>3902</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6413&quot;>6413</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q194974&quot;>Q194974</a></td></tr><tr><td>formula:</td><td>C17H11N5</td></tr><tr><td>molar mass:</td><td>285.31 g/mol (PubChem)</td></tr></table></body></html>"));
