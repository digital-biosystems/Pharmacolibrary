    M = 0.367445);
  annotation (Documentation(info = "<html><body><p>Pitofenone is a synthetic anticholinergic antispasmodic used in combination with analgesics for functional gastrointestinal disorders. It is considered investigational and is not an approved medicine in the European Union.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Pitofenone</td></tr><tr><td>ATC codes:</td><td>A03DA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB15947\">DB15947</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/121098\">121098</a></td></tr><tr><td>formula:</td><td>C22H25NO4</td></tr><tr><td>molar mass:</td><td>367.445 g/mol (PubChem CID 121098)</td></tr></table></body></html>"));
end Pitofenone;
