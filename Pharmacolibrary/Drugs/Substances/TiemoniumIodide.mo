  annotation (Documentation(info = "<html><body><p>Tiemonium iodide is a synthetic anticholinergic (quaternary ammonium) antispasmodic used for functional gastrointestinal disorders, alone or combined with analgesics. It appears to be only an experimental drug, with no confirmed marketing authorisation in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7801007\">Wikidata Q7801007</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tiemonium iodide</td></tr><tr><td>ATC codes:</td><td>A03AB17</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13666\">DB13666</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32224\">32224</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7801007\">Q7801007</a></td></tr><tr><td>formula:</td><td>C18H24INO2S</td></tr><tr><td>molar mass:</td><td>445.36 g/mol (knowledgebase (DrugBank calculated))</td></tr></table></body></html>"));
