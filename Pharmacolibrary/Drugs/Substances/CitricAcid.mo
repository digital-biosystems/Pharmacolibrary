    logP = -1.7);
  annotation (Documentation(info = "<html><body><p>Citric acid is a weak organic acid used as a digestive acid preparation and, thanks to its calcium-chelating properties, as an anticoagulant. It is widely used in human and veterinary medicine and is also considered a nutraceutical.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q159683&quot;>Wikidata Q159683</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>citric acid</td></tr><tr><td>ATC codes:</td><td>A09AB04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB04272&quot;>DB04272</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/311&quot;>311</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:30769&quot;>30769</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q159683&quot;>Q159683</a></td></tr><tr><td>formula:</td><td>C6H8O7</td></tr><tr><td>molar mass:</td><td>192.123 g/mol (PubChem)</td></tr></table></body></html>"));
end CitricAcid;
