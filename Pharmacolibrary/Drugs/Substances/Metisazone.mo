  annotation (Documentation(info = "<html><body><p>Metisazone is a thiosemicarbazone antiviral agent that was investigated for treating viral infections. It is considered an experimental drug and is not an authorised medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4562049\">Wikidata Q4562049</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>metisazone</td></tr><tr><td>ATC codes:</td><td>J05AA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13641\">DB13641</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/667492\">667492</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4562049\">Q4562049</a></td></tr><tr><td>formula:</td><td>C10H10N4OS</td></tr><tr><td>molar mass:</td><td>234.277 g/mol (PubChem CID 667492)</td></tr><tr><td>logP:</td><td>2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
