  annotation (Documentation(info = "<html><body><p>Dihydroergocryptine is a dopamine agonist that has been used to treat Parkinson's disease. It is currently considered investigational and is not an approved medicine in the European Union.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Dihydroergocryptine</td></tr><tr><td>ATC codes:</td><td>N04BC03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13385&quot;>DB13385</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/114948&quot;>114948</a></td></tr><tr><td>formula:</td><td>C32H43N5O5</td></tr><tr><td>molar mass:</td><td>577.726 g/mol (PubChem)</td></tr></table></body></html>"));
