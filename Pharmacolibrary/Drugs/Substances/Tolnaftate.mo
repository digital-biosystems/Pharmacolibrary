    logP = 5.5);
  annotation (Documentation(info = "<html><body><p>Tolnaftate is a topical antifungal used to treat fungal skin infections such as tinea, tinea pedis (athlete's foot), and pityriasis versicolor. It is an approved medicine, available over the counter in many countries as a widely used topical antifungal, and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q415238&quot;>Wikidata Q415238</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tolnaftate</td></tr><tr><td>ATC codes:</td><td>D01AE18</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00525&quot;>DB00525</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5510&quot;>5510</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9620&quot;>9620</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q415238&quot;>Q415238</a></td></tr><tr><td>formula:</td><td>C19H17NOS</td></tr><tr><td>molar mass:</td><td>307.411 g/mol (PubChem)</td></tr></table></body></html>"));
