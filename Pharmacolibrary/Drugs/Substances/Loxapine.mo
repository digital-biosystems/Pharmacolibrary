  annotation (Documentation(info = "<html><body><p>Loxapine is an antipsychotic used to treat schizophrenia and related psychotic conditions such as schizophreniform disorder. It remains in use, with an authorised product in the European Union, and is mainly used for schizophrenia and bipolar disorder.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q58614\">Wikidata Q58614</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>loxapine</td></tr><tr><td>ATC codes:</td><td>N05AH01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00408\">DB00408</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3964\">3964</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:50841\">50841</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q58614\">Q58614</a></td></tr><tr><td>formula:</td><td>C18H18ClN3O</td></tr><tr><td>molar mass:</td><td>327.812 g/mol (PubChem CID 3964)</td></tr><tr><td>logP:</td><td>3.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
