  annotation (Documentation(info = "<html><body><p>Levoketoconazole is an anticorticosteroid, an antiadrenal medicine used to lower cortisol production in hormone-related disorders. It is an approved medicine, but it is not authorised in the European Union and carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27120779\">Wikidata Q27120779</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>levoketoconazole</td></tr><tr><td>ATC codes:</td><td>H02CA04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB05667\">DB05667</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:47518\">47518</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27120779\">Q27120779</a></td></tr><tr><td>formula:</td><td>C26H28Cl2N4O4</td></tr><tr><td>molar mass:</td><td>531.431 g/mol (knowledgebase (DrugBank calculated))</td></tr><tr><td>logP:</td><td>4.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
