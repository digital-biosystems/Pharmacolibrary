  annotation (Documentation(info = "<html><body><p>Sodium monofluorophosphate is a fluoride compound used to prevent tooth decay and as a fluoride supplement. It is an approved drug, widely used in stomatological (dental) products such as toothpastes.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3498849\">Wikidata Q3498849</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sodium monofluorophosphate</td></tr><tr><td>ATC codes:</td><td>A01AA02, A12CD02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09484\">DB09484</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/65241\">65241</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:86431\">86431</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3498849\">Q3498849</a></td></tr><tr><td>formula:</td><td>FO3P-2</td></tr><tr><td>molar mass:</td><td>97.969 g/mol (PubChem CID 65241)</td></tr></table><p><small>Drugs.Common 25.09 gave 143.95 g/mol (+46.9 %); replaced by the value above</small></p></body></html>"));
end SodiumMonofluorophosphate;
