  annotation (Documentation(info = "<html><body><p>Tolvaptan is a vasopressin antagonist diuretic used to treat autosomal dominant polycystic kidney disease and inappropriate ADH syndrome. It is authorised in the European Union, where several products are on the market.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q82096700&quot;>Wikidata Q82096700</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>tolvaptan</td></tr><tr><td>ATC codes:</td><td>C03XA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06212&quot;>DB06212</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/443894&quot;>443894</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q82096700&quot;>Q82096700</a></td></tr><tr><td>formula:</td><td>C26H25ClN2O3</td></tr><tr><td>molar mass:</td><td>448.947 g/mol (PubChem)</td></tr></table></body></html>"));
