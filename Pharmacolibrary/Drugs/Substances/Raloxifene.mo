    logP = 6.1);
  annotation (Documentation(info = "<html><body><p>Raloxifene, a selective estrogen receptor modulator, is used to treat osteoporosis in postmenopausal women. It is authorised in the European Union and remains an approved medicine, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q425223\">Wikidata Q425223</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>raloxifene</td></tr><tr><td>ATC codes:</td><td>G03XC01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00481\">DB00481</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5035\">5035</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8772\">8772</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q425223\">Q425223</a></td></tr><tr><td>formula:</td><td>C28H27NO4S</td></tr><tr><td>molar mass:</td><td>473.587 g/mol (PubChem CID 5035)</td></tr><tr><td>logP:</td><td>6.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Raloxifene;
