  annotation (Documentation(info = "<html><body><p>Dinoprost (prostaglandin F2α) is a prostaglandin used as a uterotonic and abortifacient to induce labour or terminate pregnancy. It has been withdrawn from human use, though related prostaglandins remain in gynecological practice.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q421375&quot;>Wikidata Q421375</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dinoprost</td></tr><tr><td>ATC codes:</td><td>G02AD01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12789&quot;>DB12789</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5280363&quot;>5280363</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:15553&quot;>15553</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q421375&quot;>Q421375</a></td></tr><tr><td>formula:</td><td>C20H34O5</td></tr><tr><td>molar mass:</td><td>354.487 g/mol (PubChem)</td></tr></table></body></html>"));
