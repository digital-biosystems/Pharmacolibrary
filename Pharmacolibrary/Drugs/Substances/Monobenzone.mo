within Pharmacolibrary.Drugs.Substances;
package Monobenzone "monobenzone"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "monobenzone",
    atcCodes = {"D11AX13"},
    drugbankId = "DB00600",
    pubchemCid = "7638",
    chebiId = "34380",
    wikidataId = "Q2768526",
    formula = "C13H12O2",
    M = 0.200237,
    logP = 3.4);
  annotation (Documentation(info = "<html><body><p>Monobenzone is a skin-lightening agent used to treat vitiligo and other pigmentation disorders by permanently removing remaining skin pigment. It is no longer in general use; it was withdrawn from the market, reportedly because it caused permanent depigmentation and skin irritation.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2768526\">Wikidata Q2768526</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>monobenzone</td></tr><tr><td>ATC codes:</td><td>D11AX13</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00600\">DB00600</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/7638\">7638</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:34380\">34380</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2768526\">Q2768526</a></td></tr><tr><td>formula:</td><td>C13H12O2</td></tr><tr><td>molar mass:</td><td>200.237 g/mol (PubChem CID 7638)</td></tr><tr><td>logP:</td><td>3.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Monobenzone;
