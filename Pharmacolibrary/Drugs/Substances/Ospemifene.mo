    logP = 6.5);
  annotation (Documentation(info = "<html><body><p>Ospemifene is a selective estrogen receptor modulator used to treat dyspareunia (painful intercourse) in postmenopausal women. It is an approved medicine with one product authorised in the European Union, and it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7107372\">Wikidata Q7107372</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>ospemifene</td></tr><tr><td>ATC codes:</td><td>G03XC05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB04938\">DB04938</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3036505\">3036505</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:73275\">73275</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7107372\">Q7107372</a></td></tr><tr><td>formula:</td><td>C24H23ClO2</td></tr><tr><td>molar mass:</td><td>378.896 g/mol (PubChem CID 3036505)</td></tr><tr><td>logP:</td><td>6.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Ospemifene;
