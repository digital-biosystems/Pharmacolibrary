  annotation (Documentation(info = "<html><body><p>Etidronic acid is a bisphosphonate used to treat bone conditions such as hypercalcemia and to help conserve bone density. It is an approved medicine, available alone and in combination products for the treatment of bone diseases.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2758338\">Wikidata Q2758338</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>etidronic acid</td></tr><tr><td>ATC codes:</td><td>M05BA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01077\">DB01077</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3305\">3305</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4907\">4907</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2758338\">Q2758338</a></td></tr><tr><td>formula:</td><td>C2H8O7P2</td></tr><tr><td>molar mass:</td><td>206.027 g/mol (PubChem CID 3305)</td></tr><tr><td>logP:</td><td>-3.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
