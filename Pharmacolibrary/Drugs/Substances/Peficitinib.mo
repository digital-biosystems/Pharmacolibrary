  annotation (Documentation(info = "<html><body><p>Peficitinib is a JAK inhibitor developed for the treatment of rheumatoid arthritis. It is not authorised in the European Union or the United States and remains investigational there; it has been approved only in Japan.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27088288&quot;>Wikidata Q27088288</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>peficitinib</td></tr><tr><td>ATC codes:</td><td>L04AF06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11708&quot;>DB11708</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/57928403&quot;>57928403</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27088288&quot;>Q27088288</a></td></tr><tr><td>formula:</td><td>C18H22N4O2</td></tr><tr><td>molar mass:</td><td>326.4 g/mol (PubChem)</td></tr></table></body></html>"));
