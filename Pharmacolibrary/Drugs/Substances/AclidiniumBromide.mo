  annotation (Documentation(info = "<html><body><p>Aclidinium bromide is an inhaled muscarinic antagonist used to treat obstructive airway diseases such as chronic obstructive pulmonary disease. It is an approved medicine, available as an inhalant alone and in combination with adrenergic bronchodilators.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q521173&quot;>Wikidata Q521173</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>aclidinium bromide</td></tr><tr><td>ATC codes:</td><td>R03BB05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08897&quot;>DB08897</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/11434515&quot;>11434515</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:65346&quot;>65346</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q521173&quot;>Q521173</a></td></tr><tr><td>formula:</td><td>C26H30NO4S2+</td></tr><tr><td>molar mass:</td><td>484.649 g/mol (PubChem)</td></tr></table></body></html>"));
