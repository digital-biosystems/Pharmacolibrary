  annotation (Documentation(info = "<html><body><p>Reserpine, a Rauwolfia alkaloid, was used to treat high blood pressure and schizophrenia. It is now largely withdrawn from human use, though it may still be found in some countries.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q407841&quot;>Wikidata Q407841</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>reserpine</td></tr><tr><td>ATC codes:</td><td>C02AA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00206&quot;>DB00206</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5770&quot;>5770</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:28487&quot;>28487</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q407841&quot;>Q407841</a></td></tr><tr><td>formula:</td><td>C33H40N2O9</td></tr><tr><td>molar mass:</td><td>608.688 g/mol (PubChem)</td></tr></table></body></html>"));
