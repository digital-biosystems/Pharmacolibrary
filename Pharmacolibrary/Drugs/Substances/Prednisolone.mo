  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "prednisolone",
    atcCodes = {"A01AC04", "A07EA01", "C05AA04", "D07AA03", "D07XA02", "H02AB06", "R01AD02", "S01BA04", "S01CB02", "S02BA03", "S03BA02"},
