  annotation (Documentation(info = "<html><body><p>Prednisolone is a glucocorticoid steroid used to treat inflammatory and autoimmune conditions such as ulcerative colitis, myasthenia gravis, nephrotic syndrome, and various eye, skin, and blood disorders. It is widely used in human medicine, appears on the WHO essential medicines list, and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q11426176\">Wikidata Q11426176</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>prednisolone</td></tr><tr><td>ATC codes:</td><td>A01AC04, A07EA01, C05AA04, D07AA03, D07XA02, H02AB06, R01AD02, S01BA04, S01CB02, S02BA03, S03BA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00860\">DB00860</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5755\">5755</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8378\">8378</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q11426176\">Q11426176</a></td></tr><tr><td>formula:</td><td>C21H28O5</td></tr><tr><td>molar mass:</td><td>360.45 g/mol (PubChem CID 5755)</td></tr><tr><td>logP:</td><td>1.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
