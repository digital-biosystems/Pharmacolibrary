  annotation (Documentation(info = "<html><body><p>Telbivudine is a nucleoside analogue antiviral that was used to treat chronic hepatitis B. It is no longer available in the European Union, where its marketing authorisation has been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q413621\">Wikidata Q413621</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>telbivudine</td></tr><tr><td>ATC codes:</td><td>J05AF11</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01265\">DB01265</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/159269\">159269</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:63624\">63624</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q413621\">Q413621</a></td></tr><tr><td>formula:</td><td>C10H14N2O5</td></tr><tr><td>molar mass:</td><td>242.231 g/mol (PubChem CID 159269)</td></tr><tr><td>logP:</td><td>-1.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
