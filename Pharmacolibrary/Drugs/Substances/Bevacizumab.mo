within Pharmacolibrary.Drugs.Substances;
package Bevacizumab "bevacizumab"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "bevacizumab",
    atcCodes = {"L01FG01", "L01XC07", "S01LA08"},
    drugbankId = "DB00112",
    wikidataId = "Q413299",
    M = 149);
  annotation (Documentation(info = "<html><body><p>Bevacizumab is a monoclonal antibody that blocks tumour blood vessel growth and is used to treat many cancers, including colorectal, breast, lung, kidney, cervical and ovarian cancers, as well as certain eye conditions such as wet macular degeneration. It is widely used and authorised in the European Union, appears on the WHO list of essential medicines, and is also used off-label in ophthalmology.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q413299&quot;>Wikidata Q413299</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>bevacizumab</td></tr><tr><td>ATC codes:</td><td>L01FG01, L01XC07, S01LA08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00112&quot;>DB00112</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q413299&quot;>Q413299</a></td></tr><tr><td>molar mass:</td><td>149000 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Bevacizumab;
