  annotation (Documentation(info = "<html><body><p>Depreotide is a radiolabelled imaging agent used to detect tumours, especially in the lungs. It was once approved but has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27284812&quot;>Wikidata Q27284812</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>depreotide</td></tr><tr><td>ATC codes:</td><td>V09IA05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11628&quot;>DB11628</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/9898619&quot;>9898619</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135908&quot;>135908</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27284812&quot;>Q27284812</a></td></tr><tr><td>formula:</td><td>C65H96N16O12S2</td></tr><tr><td>molar mass:</td><td>1357.7 g/mol (PubChem)</td></tr></table></body></html>"));
