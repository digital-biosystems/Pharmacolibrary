    logP = -0.9);
  annotation (Documentation(info = "<html><body><p>Dexpanthenol is a vitamin-derived agent used to help heal wounds and skin damage, and also as an eye preparation and vitamin supplement. It is an approved medicine, sold under brand names such as Bepanthen, and is widely used in topical skin-care products.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q47495755&quot;>Wikidata Q47495755</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dexpanthenol</td></tr><tr><td>ATC codes:</td><td>A11HA30, D03AX03, S01XA12</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09357&quot;>DB09357</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/131204&quot;>131204</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q47495755&quot;>Q47495755</a></td></tr><tr><td>formula:</td><td>C9H19NO4</td></tr><tr><td>molar mass:</td><td>205.254 g/mol (PubChem)</td></tr></table></body></html>"));
end Dexpanthenol;
