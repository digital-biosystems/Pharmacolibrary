  annotation (Documentation(info = "<html><body><p>Sodium tetradecyl sulfate is a sclerosing agent used to treat varicose veins by injection. It is an approved medicine, classified for antivaricose therapy as a sclerosing agent for local injection.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7553377&quot;>Wikidata Q7553377</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sodium tetradecyl sulfate</td></tr><tr><td>ATC codes:</td><td>C05BB04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00464&quot;>DB00464</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/23665772&quot;>23665772</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:75273&quot;>75273</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7553377&quot;>Q7553377</a></td></tr><tr><td>formula:</td><td>C14H29NaO4S</td></tr><tr><td>molar mass:</td><td>316.432 g/mol (PubChem)</td></tr></table></body></html>"));
