  annotation (Documentation(info = "<html><body><p>Alprostadil, a prostaglandin vasodilator, is used to treat erectile dysfunction and to maintain the ductus open in certain congenital heart defects. It is an approved medicine, included on the WHO list of essential medicines, and is used worldwide.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q579348\">Wikidata Q579348</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>alprostadil</td></tr><tr><td>ATC codes:</td><td>C01EA01, G04BE01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00770\">DB00770</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/149351\">149351</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:15544\">15544</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q579348\">Q579348</a></td></tr><tr><td>formula:</td><td>C20H34O5</td></tr><tr><td>molar mass:</td><td>354.487 g/mol (PubChem CID 149351)</td></tr><tr><td>logP:</td><td>3.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
