within Pharmacolibrary.Drugs.Substances;
package AntilymphocyteImmunoglobulinHorse "antilymphocyte immunoglobulin (horse)"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "antilymphocyte immunoglobulin (horse)",
    atcCodes = {"L04AA03"},
    drugbankId = "DB09312",
    wikidataId = "Q22075917");
  annotation (Documentation(info = "<html><body><p>Antilymphocyte immunoglobulin (horse), also called equine anti-thymocyte globulin, is an immunosuppressant used to suppress the immune system, for example in transplant-related settings. It is an approved medicine, though it carries a boxed warning, and its use is typically confined to specialised hospital care.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q22075917&quot;>Wikidata Q22075917</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>antilymphocyte immunoglobulin (horse)</td></tr><tr><td>ATC codes:</td><td>L04AA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09312&quot;>DB09312</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q22075917&quot;>Q22075917</a></td></tr></table></body></html>"));
end AntilymphocyteImmunoglobulinHorse;
