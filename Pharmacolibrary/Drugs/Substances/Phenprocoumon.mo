  annotation (Documentation(info = "<html><body><p>Phenprocoumon is a vitamin K antagonist anticoagulant used to treat and prevent blood clots such as pulmonary embolism. It is an approved anticoagulant, used mainly in some European countries, though it has also been withdrawn in some markets.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q267896&quot;>Wikidata Q267896</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>phenprocoumon</td></tr><tr><td>ATC codes:</td><td>B01AA04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00946&quot;>DB00946</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/54680692&quot;>54680692</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:50438&quot;>50438</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q267896&quot;>Q267896</a></td></tr><tr><td>formula:</td><td>C18H16O3</td></tr><tr><td>molar mass:</td><td>280.323 g/mol (PubChem)</td></tr></table></body></html>"));
