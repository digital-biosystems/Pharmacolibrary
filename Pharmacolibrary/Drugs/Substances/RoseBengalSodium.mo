  annotation (Documentation(info = "<html><body><p>Rose bengal sodium is a dye used as a diagnostic colouring agent in ophthalmology, for example to stain damaged cells on the eye surface. It is an approved ophthalmic diagnostic agent and is also being investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27088610&quot;>Wikidata Q27088610</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>rose bengal sodium</td></tr><tr><td>ATC codes:</td><td>S01JA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11182&quot;>DB11182</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:87202&quot;>87202</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27088610&quot;>Q27088610</a></td></tr><tr><td>formula:</td><td>C20H4Cl4I4O5</td></tr><tr><td>molar mass:</td><td>973.673 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
