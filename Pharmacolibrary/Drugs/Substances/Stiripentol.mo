  annotation (Documentation(info = "<html><body><p>Stiripentol is an anticonvulsant drug used to treat epilepsy, notably juvenile myoclonic epilepsy. It is authorised in the European Union and is also under investigation for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q412182&quot;>Wikidata Q412182</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>stiripentol</td></tr><tr><td>ATC codes:</td><td>N03AX17</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09118&quot;>DB09118</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5311454&quot;>5311454</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q412182&quot;>Q412182</a></td></tr><tr><td>formula:</td><td>C14H18O3</td></tr><tr><td>molar mass:</td><td>234.295 g/mol (PubChem)</td></tr></table></body></html>"));
