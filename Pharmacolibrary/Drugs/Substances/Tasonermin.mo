    M = 17.724);
  annotation (Documentation(info = "<html><body><p>Tasonermin is an immunostimulant anticancer medicine used to treat sarcoma. It is authorised in the European Union and is restricted to hospital use, where it is given by isolated limb perfusion for sarcoma in a limb.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q28852342&quot;>Wikidata Q28852342</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>tasonermin</td></tr><tr><td>ATC codes:</td><td>L03AX11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11626&quot;>DB11626</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q28852342&quot;>Q28852342</a></td></tr><tr><td>molar mass:</td><td>17724 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Tasonermin;
