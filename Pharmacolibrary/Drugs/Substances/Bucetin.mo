    logP = 1.8);
  annotation (Documentation(info = "<html><body><p>Bucetin is an anilide analgesic and antipyretic that was used to relieve pain and fever. It has been withdrawn from the market, largely because of concerns about kidney damage and cancer risk.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4982520\">Wikidata Q4982520</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bucetin</td></tr><tr><td>ATC codes:</td><td>N02BE04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13278\">DB13278</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/14130\">14130</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31311\">31311</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4982520\">Q4982520</a></td></tr><tr><td>formula:</td><td>C12H17NO3</td></tr><tr><td>molar mass:</td><td>223.272 g/mol (PubChem CID 14130)</td></tr><tr><td>logP:</td><td>1.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Bucetin;
