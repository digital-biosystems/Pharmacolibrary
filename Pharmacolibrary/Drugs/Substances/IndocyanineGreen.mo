    M = 0.77497);
  annotation (Documentation(info = "<html><body><p>Indocyanine green is a diagnostic dye used to assess liver function and cardiac output and in angiography. It has been withdrawn from use, though it remains approved for some purposes.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q905662\">Wikidata Q905662</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>indocyanine green</td></tr><tr><td>ATC codes:</td><td>V04CX01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB16024\">DB16024</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q905662\">Q905662</a></td></tr><tr><td>formula:</td><td>C43H47N2NaO6S2</td></tr><tr><td>molar mass:</td><td>774.97 g/mol (knowledgebase (DrugBank calculated))</td></tr></table></body></html>"));
end IndocyanineGreen;
