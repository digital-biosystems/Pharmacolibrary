  annotation (Documentation(info = "<html><body><p>Pegvisomant is a medicine used to treat acromegaly, a hormonal condition caused by excess growth hormone. It is authorised in the European Union and is used there, mainly under specialist care for this condition.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q409697&quot;>Wikidata Q409697</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>pegvisomant</td></tr><tr><td>ATC codes:</td><td>H01AX01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00082&quot;>DB00082</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q409697&quot;>Q409697</a></td></tr><tr><td>molar mass:</td><td>22129 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
