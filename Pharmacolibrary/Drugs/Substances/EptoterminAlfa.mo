    wikidataId = "Q28852415");
  annotation (Documentation(info = "<html><body><p>Eptotermin alfa, a bone morphogenetic protein, was used to help heal tibial fractures and in spondylolisthesis. Its European Union products have been withdrawn, so it is no longer marketed there.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q28852415&quot;>Wikidata Q28852415</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>eptotermin alfa</td></tr><tr><td>ATC codes:</td><td>M05BC02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11631&quot;>DB11631</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q28852415&quot;>Q28852415</a></td></tr></table></body></html>"));
end EptoterminAlfa;
