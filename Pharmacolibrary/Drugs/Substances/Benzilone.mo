  annotation (Documentation(info = "<html><body><p>Benzilone is a synthetic anticholinergic (quaternary ammonium compound) classified for the treatment of functional gastrointestinal disorders. It appears to be an experimental compound with no current marketing authorisation, and its present use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4890770\">Wikidata Q4890770</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>benzilone</td></tr><tr><td>ATC codes:</td><td>A03AB01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13369\">DB13369</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/66248\">66248</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135496\">135496</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4890770\">Q4890770</a></td></tr><tr><td>formula:</td><td>C22H28NO3+</td></tr><tr><td>molar mass:</td><td>354.47 g/mol (PubChem CID 66248)</td></tr><tr><td>logP:</td><td>3.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
