within Pharmacolibrary.Drugs.Substances;
package Chymotrypsin "chymotrypsin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "chymotrypsin",
    atcCodes = {"B06AA04", "S01KX01"},
    drugbankId = "DB09375",
    wikidataId = "Q383836");
  annotation (Documentation(info = "<html><body><p>Chymotrypsin is a protein-digesting enzyme used as a surgical aid in eye procedures and as an enzyme preparation affecting blood-related conditions. It is an approved medicine, also approved for veterinary use, though some products have been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q383836&quot;>Wikidata Q383836</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>chymotrypsin</td></tr><tr><td>ATC codes:</td><td>B06AA04, S01KX01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09375&quot;>DB09375</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q383836&quot;>Q383836</a></td></tr></table></body></html>"));
end Chymotrypsin;
