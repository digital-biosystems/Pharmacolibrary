    logP = 5);
  annotation (Documentation(info = "<html><body><p>Vemurafenib is a BRAF inhibitor used to treat melanoma, including metastatic melanoma, and has also been used for skin cancer, hairy cell leukemia, and Erdheim-Chester disease. It is an approved medicine, authorised in the European Union for melanoma, and is also being investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q423111\">Wikidata Q423111</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>vemurafenib</td></tr><tr><td>ATC codes:</td><td>L01EC01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08881\">DB08881</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/42611257\">42611257</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:63637\">63637</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q423111\">Q423111</a></td></tr><tr><td>formula:</td><td>C23H18ClF2N3O3S</td></tr><tr><td>molar mass:</td><td>489.921 g/mol (PubChem CID 42611257)</td></tr><tr><td>logP:</td><td>5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Vemurafenib;
