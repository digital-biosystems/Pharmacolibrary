  annotation (Documentation(info = "<html><body><p>Carbon dioxide is a medical gas used in healthcare, for example to stimulate breathing and as a vasodilator. It is an approved medical gas and is also approved for veterinary use, with some investigational applications.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1997\">Wikidata Q1997</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>carbon dioxide</td></tr><tr><td>ATC codes:</td><td>V03AN02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09157\">DB09157</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/280\">280</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:16526\">16526</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1997\">Q1997</a></td></tr><tr><td>formula:</td><td>CO2</td></tr><tr><td>molar mass:</td><td>44.009 g/mol (PubChem CID 280)</td></tr><tr><td>logP:</td><td>0.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
