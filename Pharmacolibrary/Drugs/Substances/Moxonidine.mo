  annotation (Documentation(info = "<html><body><p>Moxonidine is an antihypertensive drug used to treat high blood pressure. It is an approved medicine, used mainly in Europe, and is also available in combination with a diuretic.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q419944\">Wikidata Q419944</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>moxonidine</td></tr><tr><td>ATC codes:</td><td>C02AC05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09242\">DB09242</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4810\">4810</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7009\">7009</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q419944\">Q419944</a></td></tr><tr><td>formula:</td><td>C9H12ClN5O</td></tr><tr><td>molar mass:</td><td>241.679 g/mol (PubChem CID 4810)</td></tr><tr><td>logP:</td><td>0.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
