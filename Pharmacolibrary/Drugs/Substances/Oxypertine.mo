  annotation (Documentation(info = "<html><body><p>Oxypertine is an indole-derivative antipsychotic drug once used to treat psychotic disorders. It is currently regarded as experimental and does not appear to be an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7116102\">Wikidata Q7116102</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>oxypertine</td></tr><tr><td>ATC codes:</td><td>N05AE01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13403\">DB13403</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4640\">4640</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31952\">31952</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7116102\">Q7116102</a></td></tr><tr><td>formula:</td><td>C23H29N3O2</td></tr><tr><td>molar mass:</td><td>379.504 g/mol (PubChem CID 4640)</td></tr><tr><td>logP:</td><td>4.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
