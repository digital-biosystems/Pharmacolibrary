within Pharmacolibrary.Drugs.Substances;
package Hydrochlorothiazide "hydrochlorothiazide"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "hydrochlorothiazide",
    atcCodes = {"C03AA03"},
    drugbankId = "DB00999",
    pubchemCid = "3639",
    chebiId = "5778",
    wikidataId = "Q423930",
