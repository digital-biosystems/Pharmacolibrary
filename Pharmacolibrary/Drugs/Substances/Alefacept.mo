  annotation (Documentation(info = "<html><body><p>Alefacept is an immunosuppressant fusion protein used as a dermatologic drug, notably for the skin condition acropustulosis. The drug was approved but has since been withdrawn and is no longer available.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3609421&quot;>Wikidata Q3609421</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>alefacept</td></tr><tr><td>ATC codes:</td><td>L04AA15</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00092&quot;>DB00092</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3609421&quot;>Q3609421</a></td></tr><tr><td>molar mass:</td><td>51801.1 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Alefacept;
