  annotation (Documentation(info = "<html><body><p>Bromhexine is a mucolytic medicine used to treat cough by helping clear mucus from the airways. It is an approved drug, available in cough and cold preparations, though it is not authorised centrally in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q239778\">Wikidata Q239778</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bromhexine</td></tr><tr><td>ATC codes:</td><td>R05CB02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09019\">DB09019</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2442\">2442</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:77032\">77032</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q239778\">Q239778</a></td></tr><tr><td>formula:</td><td>C14H20Br2N2</td></tr><tr><td>molar mass:</td><td>376.136 g/mol (PubChem CID 2442)</td></tr><tr><td>logP:</td><td>4.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Bromhexine;
