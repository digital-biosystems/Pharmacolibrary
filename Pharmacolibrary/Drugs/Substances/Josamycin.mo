  annotation (Documentation(info = "<html><body><p>Josamycin is a macrolide antibiotic used against infections such as bronchitis, boutonneuse fever, and Mycoplasma pneumonia. It is considered investigational and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q423369&quot;>Wikidata Q423369</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>josamycin</td></tr><tr><td>ATC codes:</td><td>J01FA07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01321&quot;>DB01321</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5282165&quot;>5282165</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31739&quot;>31739</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q423369&quot;>Q423369</a></td></tr><tr><td>formula:</td><td>C42H69NO15</td></tr><tr><td>molar mass:</td><td>828.006 g/mol (PubChem)</td></tr></table></body></html>"));
end Josamycin;
