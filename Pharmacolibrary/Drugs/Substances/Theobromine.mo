    logP = -0.8);
  annotation (Documentation(info = "<html><body><p>Theobromine, a dimethylxanthine related to caffeine, has been used as a diuretic and bronchodilator for conditions such as obstructive airway disease. It is currently considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q206844\">Wikidata Q206844</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>theobromine</td></tr><tr><td>ATC codes:</td><td>C03BD01, R03DA07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01412\">DB01412</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5429\">5429</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:28946\">28946</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q206844\">Q206844</a></td></tr><tr><td>formula:</td><td>C7H8N4O2</td></tr><tr><td>molar mass:</td><td>180.167 g/mol (PubChem CID 5429)</td></tr><tr><td>logP:</td><td>-0.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
