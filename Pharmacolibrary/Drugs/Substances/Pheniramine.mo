  annotation (Documentation(info = "<html><body><p>Pheniramine is an antihistamine used to treat allergic conditions such as urticaria and itching. It is an approved medicine, used both topically on the skin and systemically for allergies, and remains in general use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q656259\">Wikidata Q656259</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pheniramine</td></tr><tr><td>ATC codes:</td><td>D04AA16, R06AB05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01620\">DB01620</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4761\">4761</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:91591\">91591</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q656259\">Q656259</a></td></tr><tr><td>formula:</td><td>C16H20N2</td></tr><tr><td>molar mass:</td><td>240.35 g/mol (PubChem CID 4761)</td></tr><tr><td>logP:</td><td>2.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
