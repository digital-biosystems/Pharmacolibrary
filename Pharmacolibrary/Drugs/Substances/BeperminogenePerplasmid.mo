  annotation (Documentation(info = "<html><body><p>Beperminogene perplasmid is an investigational DNA-based therapy studied as a vasoprotective treatment for poor blood circulation in the limbs.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>beperminogene perplasmid</td></tr><tr><td>ATC codes:</td><td>C05XX01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB19236\">DB19236</a></td></tr></table></body></html>"));
