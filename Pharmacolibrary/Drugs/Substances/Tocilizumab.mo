within Pharmacolibrary.Drugs.Substances;
package Tocilizumab "tocilizumab"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "tocilizumab",
    atcCodes = {"L04AC07"},
    drugbankId = "DB06273",
    wikidataId = "Q425154",
    M = 148);
  annotation (Documentation(info = "<html><body><p>Tocilizumab, a monoclonal antibody that blocks interleukin signalling, is used to treat rheumatoid and juvenile idiopathic arthritis, giant cell arteritis, cytokine release syndrome, and COVID-19. It is authorised in the European Union and widely used for these inflammatory conditions.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q425154\">Wikidata Q425154</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>tocilizumab</td></tr><tr><td>ATC codes:</td><td>L04AC07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06273\">DB06273</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q425154\">Q425154</a></td></tr><tr><td>molar mass:</td><td>148000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Tocilizumab;
