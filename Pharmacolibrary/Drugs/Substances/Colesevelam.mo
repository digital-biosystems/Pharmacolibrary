within Pharmacolibrary.Drugs.Substances;
package Colesevelam "colesevelam"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "colesevelam",
    atcCodes = {"C10AC04"},
    drugbankId = "DB00930",
    wikidataId = "Q899036");
  annotation (Documentation(info = "<html><body><p>Colesevelam is a bile acid sequestrant used to lower cholesterol, mainly in hypercholesterolemia and related lipid disorders. It is an approved medicine, with one product authorised in the European Union for hypercholesterolemia.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q899036\">Wikidata Q899036</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>colesevelam</td></tr><tr><td>ATC codes:</td><td>C10AC04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00930\">DB00930</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q899036\">Q899036</a></td></tr></table></body></html>"));
end Colesevelam;
