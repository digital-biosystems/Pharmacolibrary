  annotation (Documentation(info = "<html><body><p>Prenalterol is a sympathomimetic, beta-1 adrenergic agonist that was investigated as a cardiotonic agent for heart conditions. It is considered experimental and does not appear to be an approved medicine today.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7240518\">Wikidata Q7240518</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>prenalterol</td></tr><tr><td>ATC codes:</td><td>C01CA13</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13777\">DB13777</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/42396\">42396</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8391\">8391</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7240518\">Q7240518</a></td></tr><tr><td>formula:</td><td>C12H19NO3</td></tr><tr><td>molar mass:</td><td>225.288 g/mol (PubChem CID 42396)</td></tr><tr><td>logP:</td><td>1.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
