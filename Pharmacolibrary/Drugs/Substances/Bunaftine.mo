  annotation (Documentation(info = "<html><body><p>Bunaftine is an antiarrhythmic agent, a class III drug used to treat heart rhythm disorders. It appears to be only experimental, with no marketing authorisation in the European Union, so it is not in routine clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q851942&quot;>Wikidata Q851942</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bunaftine</td></tr><tr><td>ATC codes:</td><td>C01BD03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13652&quot;>DB13652</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/36131&quot;>36131</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135392&quot;>135392</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q851942&quot;>Q851942</a></td></tr><tr><td>formula:</td><td>C21H30N2O</td></tr><tr><td>molar mass:</td><td>326.484 g/mol (PubChem)</td></tr></table></body></html>"));
