    logP = 1.7);
  annotation (Documentation(info = "<html><body><p>Chlorambucil is an alkylating anticancer drug used to treat cancers such as chronic lymphocytic leukemia, Hodgkin lymphoma, and other lymphoid malignancies. It remains an approved medicine and has been included on the WHO list of essential medicines, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q415939\">Wikidata Q415939</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>chlorambucil</td></tr><tr><td>ATC codes:</td><td>L01AA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00291\">DB00291</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2708\">2708</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:28830\">28830</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q415939\">Q415939</a></td></tr><tr><td>formula:</td><td>C14H19Cl2NO2</td></tr><tr><td>molar mass:</td><td>304.211 g/mol (PubChem CID 2708)</td></tr><tr><td>logP:</td><td>1.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Chlorambucil;
