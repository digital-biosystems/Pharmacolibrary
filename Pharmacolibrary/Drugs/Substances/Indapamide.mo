  annotation (Documentation(info = "<html><body><p>Indapamide is a diuretic and antihypertensive medicine used to treat arterial hypertension, congestive heart failure, nephrotic syndrome and anasarka. It is an approved drug, widely used in cardiovascular care, and is also available in fixed combinations with ACE inhibitors and lipid-lowering agents.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q1078392&quot;>Wikidata Q1078392</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>indapamide</td></tr><tr><td>ATC codes:</td><td>C03BA11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00808&quot;>DB00808</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3702&quot;>3702</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:5893&quot;>5893</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q1078392&quot;>Q1078392</a></td></tr><tr><td>formula:</td><td>C16H16ClN3O3S</td></tr><tr><td>molar mass:</td><td>365.832 g/mol (PubChem)</td></tr></table></body></html>"));
