within Pharmacolibrary.Drugs.Substances;
package Trilostane "trilostane"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "trilostane",
    atcCodes = {"H02CA01"},
    drugbankId = "DB01108",
    pubchemCid = "656583",
    chebiId = "32260",
    wikidataId = "Q907313",
    formula = "C20H27NO3",
    M = 0.32944,
    logP = 2.9);
  annotation (Documentation(info = "<html><body><p>Trilostane is an anticorticosteroid drug that blocks adrenal steroid production and was used to treat Cushing's syndrome and other conditions of excess cortisol. It was withdrawn from human use but remains approved for veterinary use, mainly in dogs with Cushing's disease.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q907313&quot;>Wikidata Q907313</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>trilostane</td></tr><tr><td>ATC codes:</td><td>H02CA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01108&quot;>DB01108</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/656583&quot;>656583</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32260&quot;>32260</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q907313&quot;>Q907313</a></td></tr><tr><td>formula:</td><td>C20H27NO3</td></tr><tr><td>molar mass:</td><td>329.44 g/mol (PubChem)</td></tr></table></body></html>"));
end Trilostane;
