  annotation (Documentation(info = "<html><body><p>Florbetapir (18F) is a diagnostic radiopharmaceutical used as an imaging agent for the central nervous system. It is authorised in the European Union for radionuclide imaging.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5460495\">Wikidata Q5460495</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>florbetapir (18F)</td></tr><tr><td>ATC codes:</td><td>V09AX05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09149\">DB09149</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5460495\">Q5460495</a></td></tr><tr><td>molar mass:</td><td>359.4 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>3.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
