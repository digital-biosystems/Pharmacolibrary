  annotation (Documentation(info = "<html><body><p>Azidocillin is a penicillin antibiotic belonging to the beta-lactamase sensitive penicillins, used to treat bacterial infections. It is not an established marketed medicine today; it appears only as an experimental compound and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4832566\">Wikidata Q4832566</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>azidocillin</td></tr><tr><td>ATC codes:</td><td>J01CE04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08795\">DB08795</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/15574941\">15574941</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:51758\">51758</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4832566\">Q4832566</a></td></tr><tr><td>formula:</td><td>C16H17N5O4S</td></tr><tr><td>molar mass:</td><td>375.403 g/mol (PubChem CID 15574941)</td></tr><tr><td>logP:</td><td>2.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
