  annotation (Documentation(info = "<html><body><p>Selpercatinib is a protein kinase inhibitor used to treat medullary thyroid cancer and non-small-cell lung cancer. It is approved and authorised in the European Union for these cancers.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q96405266&quot;>Wikidata Q96405266</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>selpercatinib</td></tr><tr><td>ATC codes:</td><td>L01EX22</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB15685&quot;>DB15685</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/134436906&quot;>134436906</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q96405266&quot;>Q96405266</a></td></tr><tr><td>formula:</td><td>C29H31N7O3</td></tr><tr><td>molar mass:</td><td>525.613 g/mol (PubChem)</td></tr></table></body></html>"));
