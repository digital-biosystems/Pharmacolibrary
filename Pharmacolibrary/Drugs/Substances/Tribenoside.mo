within Pharmacolibrary.Drugs.Substances;
package Tribenoside "tribenoside"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "tribenoside",
    atcCodes = {"C05AX05", "C05CX01"},
    drugbankId = "DB13227",
    pubchemCid = "196122",
    chebiId = "91780",
    wikidataId = "Q533119",
    formula = "C29H34O6",
