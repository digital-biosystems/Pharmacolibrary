    logP = 3.9);
  annotation (Documentation(info = "<html><body><p>Tribenoside is a non-steroidal anti-inflammatory drug that has been used topically to treat haemorrhoids and anal fissures, and as a capillary stabilising agent. It is not an approved medicine today and is considered investigational, with no authorisation by the European Medicines Agency.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q533119\">Wikidata Q533119</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tribenoside</td></tr><tr><td>ATC codes:</td><td>C05AX05, C05CX01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13227\">DB13227</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/196122\">196122</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:91780\">91780</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q533119\">Q533119</a></td></tr><tr><td>formula:</td><td>C29H34O6</td></tr><tr><td>molar mass:</td><td>478.585 g/mol (PubChem CID 196122)</td></tr><tr><td>logP:</td><td>3.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Tribenoside;
