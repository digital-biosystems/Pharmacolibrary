  annotation (Documentation(info = "<html><body><p>Salicylamide is a salicylic acid derivative used as an analgesic and antipyretic to treat pain and fever. It is an approved drug, but it is not widely used today and has largely been replaced by other salicylate painkillers.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2496906\">Wikidata Q2496906</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>salicylamide</td></tr><tr><td>ATC codes:</td><td>N02BA05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08797\">DB08797</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5147\">5147</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32114\">32114</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2496906\">Q2496906</a></td></tr><tr><td>formula:</td><td>C7H7NO2</td></tr><tr><td>molar mass:</td><td>137.138 g/mol (PubChem CID 5147)</td></tr><tr><td>logP:</td><td>1.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
