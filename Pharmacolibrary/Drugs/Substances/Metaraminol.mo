    logP = -0.4);
  annotation (Documentation(info = "<html><body><p>Metaraminol is a sympathomimetic vasopressor used to treat hypotension, including in neurogenic shock. It is an approved adrenergic cardiac stimulant, used mainly in hospital settings to raise blood pressure during anesthesia or shock.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q409981\">Wikidata Q409981</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>metaraminol</td></tr><tr><td>ATC codes:</td><td>C01CA09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00610\">DB00610</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5906\">5906</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6794\">6794</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q409981\">Q409981</a></td></tr><tr><td>formula:</td><td>C9H13NO2</td></tr><tr><td>molar mass:</td><td>167.208 g/mol (PubChem CID 5906)</td></tr><tr><td>logP:</td><td>-0.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Metaraminol;
