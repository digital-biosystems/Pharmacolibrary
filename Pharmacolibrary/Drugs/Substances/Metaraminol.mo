  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "metaraminol",
    atcCodes = {"C01CA09"},
    drugbankId = "DB00610",
    pubchemCid = "5906",
    chebiId = "6794",
    wikidataId = "Q409981",
