  annotation (Documentation(info = "<html><body><p>Pizotifen is an antimigraine medicine used to prevent migraine headaches, acting as a serotonin antagonist. It is an approved drug, though not authorised centrally in the European Union, and is used in various countries for migraine prevention.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q413784&quot;>Wikidata Q413784</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pizotifen</td></tr><tr><td>ATC codes:</td><td>N02CX01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06153&quot;>DB06153</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/27400&quot;>27400</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:50212&quot;>50212</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q413784&quot;>Q413784</a></td></tr><tr><td>formula:</td><td>C19H21NS</td></tr><tr><td>molar mass:</td><td>295.444 g/mol (PubChem)</td></tr></table></body></html>"));
