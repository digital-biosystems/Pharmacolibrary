  annotation (Documentation(info = "<html><body><p>Artenimol (dihydroartemisinin), an artemisinin derivative, is used to treat malaria, often in combination with piperaquine. It is on the WHO essential medicines list and is used widely in malaria-endemic regions.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q17048104&quot;>Wikidata Q17048104</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>artenimol</td></tr><tr><td>ATC codes:</td><td>P01BE05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11638&quot;>DB11638</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3000518&quot;>3000518</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q17048104&quot;>Q17048104</a></td></tr><tr><td>formula:</td><td>C15H24O5</td></tr><tr><td>molar mass:</td><td>284.352 g/mol (PubChem)</td></tr></table></body></html>"));
