  annotation (Documentation(info = "<html><body><p>Prednimustine is an alkylating antineoplastic agent, a nitrogen mustard analogue that has been investigated as a cancer treatment. It is considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7239694\">Wikidata Q7239694</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>prednimustine</td></tr><tr><td>ATC codes:</td><td>L01AA08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12832\">DB12832</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/34457\">34457</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:82524\">82524</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7239694\">Q7239694</a></td></tr><tr><td>formula:</td><td>C35H45Cl2NO6</td></tr><tr><td>molar mass:</td><td>646.646 g/mol (PubChem CID 34457)</td></tr><tr><td>logP:</td><td>6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
