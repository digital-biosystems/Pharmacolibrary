  annotation (Documentation(info = "<html><body><p>Dichloralphenazone is a sedative-hypnotic, a combination of a chloral derivative with an analgesic, used to promote sleep and relieve pain. It is an approved drug but is not authorised in the European Union and is now only rarely used.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5272471&quot;>Wikidata Q5272471</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dichloralphenazone</td></tr><tr><td>ATC codes:</td><td>N05CC04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01495&quot;>DB01495</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/10188&quot;>10188</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5272471&quot;>Q5272471</a></td></tr><tr><td>formula:</td><td>C15H18Cl6N2O5</td></tr><tr><td>molar mass:</td><td>519.018 g/mol (PubChem)</td></tr></table></body></html>"));
end Dichloralphenazone;
