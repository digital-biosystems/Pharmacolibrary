  annotation (Documentation(info = "<html><body><p>Thioacetazone is an antituberculous drug used to treat tuberculosis. It is no longer in routine use and is considered investigational; it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7784646&quot;>Wikidata Q7784646</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>thioacetazone</td></tr><tr><td>ATC codes:</td><td>J04AK07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12829&quot;>DB12829</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/9568512&quot;>9568512</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7784646&quot;>Q7784646</a></td></tr><tr><td>formula:</td><td>C10H12N4OS</td></tr><tr><td>molar mass:</td><td>236.293 g/mol (PubChem)</td></tr></table></body></html>"));
