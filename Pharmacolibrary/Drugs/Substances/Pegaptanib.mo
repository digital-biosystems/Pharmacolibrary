  annotation (Documentation(info = "<html><body><p>Pegaptanib is an eye injection that was used to treat wet age-related macular degeneration. It is no longer available, as its marketing authorisation in the European Union has been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q409935&quot;>Wikidata Q409935</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>pegaptanib</td></tr><tr><td>ATC codes:</td><td>S01LA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB04895&quot;>DB04895</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q409935&quot;>Q409935</a></td></tr><tr><td>molar mass:</td><td>50000 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Pegaptanib;
