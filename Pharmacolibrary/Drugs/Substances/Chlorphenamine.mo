  annotation (Documentation(info = "<html><body><p>Chlorphenamine is an antihistamine used to treat allergic conditions such as urticaria, relieving itching and allergy symptoms. It is an approved, widely available over-the-counter medicine used in many countries for allergy relief.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q420133\">Wikidata Q420133</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>chlorphenamine</td></tr><tr><td>ATC codes:</td><td>R06AB04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01114\">DB01114</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2725\">2725</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q420133\">Q420133</a></td></tr><tr><td>formula:</td><td>C16H19ClN2</td></tr><tr><td>molar mass:</td><td>274.792 g/mol (PubChem CID 2725)</td></tr><tr><td>logP:</td><td>3.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
