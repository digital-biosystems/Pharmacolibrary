within Pharmacolibrary.Drugs.Substances;
package Dalteparin "dalteparin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "dalteparin",
    atcCodes = {"B01AB04"},
    drugbankId = "DB06779",
    wikidataId = "Q1851701");
  annotation (Documentation(info = "<html><body><p>Dalteparin is a low molecular weight heparin anticoagulant used to treat and prevent blood clots, including in myocardial infarction, unstable angina, pulmonary embolism, thrombophlebitis, and after surgery. It is an approved medicine and is widely used as an antithrombotic agent.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1851701\">Wikidata Q1851701</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dalteparin</td></tr><tr><td>ATC codes:</td><td>B01AB04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06779\">DB06779</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1851701\">Q1851701</a></td></tr></table></body></html>"));
end Dalteparin;
