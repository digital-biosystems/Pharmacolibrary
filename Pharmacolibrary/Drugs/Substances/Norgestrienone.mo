  annotation (Documentation(info = "<html><body><p>Norgestrienone is a synthetic progestogen that was used as an oral hormonal contraceptive. It appears to be only experimental today, with no current marketing authorisation known.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7051184\">Wikidata Q7051184</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>norgestrienone</td></tr><tr><td>ATC codes:</td><td>G03AC07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13563\">DB13563</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/13313\">13313</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135231\">135231</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7051184\">Q7051184</a></td></tr><tr><td>formula:</td><td>C20H22O2</td></tr><tr><td>molar mass:</td><td>294.394 g/mol (PubChem CID 13313)</td></tr><tr><td>logP:</td><td>1.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
