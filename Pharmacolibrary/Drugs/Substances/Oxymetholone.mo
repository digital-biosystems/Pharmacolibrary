  annotation (Documentation(info = "<html><body><p>Oxymetholone is an androgenic anabolic steroid used to treat anemia. It is an approved medicine, though it is also used illicitly, and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q420864&quot;>Wikidata Q420864</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>oxymetholone</td></tr><tr><td>ATC codes:</td><td>A14AA05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06412&quot;>DB06412</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5281034&quot;>5281034</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7864&quot;>7864</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q420864&quot;>Q420864</a></td></tr><tr><td>formula:</td><td>C21H32O3</td></tr><tr><td>molar mass:</td><td>332.484 g/mol (PubChem)</td></tr></table></body></html>"));
