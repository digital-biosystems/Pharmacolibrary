    logP = 2.1);
  annotation (Documentation(info = "<html><body><p>Mexiletine is an antiarrhythmic (class Ib) drug used for heart rhythm problems such as ventricular fibrillation, and also for diabetic nerve pain and myotonic disorders. It remains in use, with one product authorised in the European Union, where it is indicated for myotonic disorders.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q420377&quot;>Wikidata Q420377</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>mexiletine</td></tr><tr><td>ATC codes:</td><td>C01BB02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00379&quot;>DB00379</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4178&quot;>4178</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6916&quot;>6916</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q420377&quot;>Q420377</a></td></tr><tr><td>formula:</td><td>C11H17NO</td></tr><tr><td>molar mass:</td><td>179.263 g/mol (PubChem)</td></tr></table></body></html>"));
end Mexiletine;
