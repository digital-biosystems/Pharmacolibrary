  annotation (Documentation(info = "<html><body><p>Temafloxacin is a fluoroquinolone antibiotic that was used to treat bacterial infections. It was withdrawn from the market shortly after its introduction because of serious adverse reactions reported in patients taking the drug.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3983082\">Wikidata Q3983082</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>temafloxacin</td></tr><tr><td>ATC codes:</td><td>J01MA05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01405\">DB01405</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/60021\">60021</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:77796\">77796</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3983082\">Q3983082</a></td></tr><tr><td>formula:</td><td>C21H18F3N3O3</td></tr><tr><td>molar mass:</td><td>417.387 g/mol (PubChem CID 60021)</td></tr><tr><td>logP:</td><td>0.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
