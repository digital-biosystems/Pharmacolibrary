  annotation (Documentation(info = "<html><body><p>Diphenoxylate is an opioid drug used to treat diarrhea. It is an approved antidiarrheal medicine, though it is not authorised in the European Union and can be subject to misuse.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q416431&quot;>Wikidata Q416431</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>diphenoxylate</td></tr><tr><td>ATC codes:</td><td>A07DA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01081&quot;>DB01081</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/13505&quot;>13505</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4639&quot;>4639</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q416431&quot;>Q416431</a></td></tr><tr><td>formula:</td><td>C30H32N2O2</td></tr><tr><td>molar mass:</td><td>452.598 g/mol (PubChem)</td></tr></table></body></html>"));
