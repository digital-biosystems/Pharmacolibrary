  annotation (Documentation(info = "<html><body><p>Nadroparin is an anticoagulant of the heparin group used to prevent and treat blood clots. It is an approved medicine and is used in clinical practice, mainly in Europe.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q20817257&quot;>Wikidata Q20817257</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nadroparin</td></tr><tr><td>ATC codes:</td><td>B01AB06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08813&quot;>DB08813</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q20817257&quot;>Q20817257</a></td></tr></table></body></html>"));
