  annotation (Documentation(info = "<html><body><p>Niridazole is an antitrematodal drug that was used to treat schistosomiasis (schistosome infections). It is now considered an experimental compound and is not in routine medical use; it is also classified as a carcinogen.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7039974\">Wikidata Q7039974</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>niridazole</td></tr><tr><td>ATC codes:</td><td>P02BX02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13661\">DB13661</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6093\">6093</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:82349\">82349</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7039974\">Q7039974</a></td></tr><tr><td>formula:</td><td>C6H6N4O3S</td></tr><tr><td>molar mass:</td><td>214.199 g/mol (PubChem CID 6093)</td></tr><tr><td>logP:</td><td>0.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
