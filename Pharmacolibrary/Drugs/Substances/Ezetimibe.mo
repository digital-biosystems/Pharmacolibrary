  annotation (Documentation(info = "<html><body><p>Ezetimibe is a lipid-lowering medicine used to treat high cholesterol, including familial hypercholesterolemia and other dyslipidemias. It is widely used, available alone and in fixed combinations with other lipid-modifying agents, and is an approved drug.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q417997&quot;>Wikidata Q417997</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ezetimibe</td></tr><tr><td>ATC codes:</td><td>C10AX09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00973&quot;>DB00973</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/150311&quot;>150311</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:49040&quot;>49040</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q417997&quot;>Q417997</a></td></tr><tr><td>formula:</td><td>C24H21F2NO3</td></tr><tr><td>molar mass:</td><td>409.432 g/mol (PubChem)</td></tr></table></body></html>"));
