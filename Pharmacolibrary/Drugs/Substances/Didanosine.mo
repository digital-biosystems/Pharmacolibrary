  annotation (Documentation(info = "<html><body><p>Didanosine is an antiviral nucleoside analogue used to treat HIV infection and AIDS. It is an approved medicine and has been included on the WHO list of essential medicines, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q422606&quot;>Wikidata Q422606</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>didanosine</td></tr><tr><td>ATC codes:</td><td>J05AF02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00900&quot;>DB00900</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/50599&quot;>50599</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:490877&quot;>490877</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q422606&quot;>Q422606</a></td></tr><tr><td>formula:</td><td>C10H12N4O3</td></tr><tr><td>molar mass:</td><td>236.227 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
