  annotation (Documentation(info = "<html><body><p>Cinepazet is a vasodilator that was classified for use in cardiac diseases. It is currently regarded as an experimental compound and does not appear to be an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5120862\">Wikidata Q5120862</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cinepazet</td></tr><tr><td>ATC codes:</td><td>C01DX14</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13342\">DB13342</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6434395\">6434395</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135617\">135617</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5120862\">Q5120862</a></td></tr><tr><td>formula:</td><td>C20H28N2O6</td></tr><tr><td>molar mass:</td><td>392.452 g/mol (PubChem CID 6434395)</td></tr><tr><td>logP:</td><td>1.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
