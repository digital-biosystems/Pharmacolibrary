  annotation (Documentation(info = "<html><body><p>Etozolin is a loop (high-ceiling) diuretic that has been used as a diuretic and antihypertensive drug. It is currently listed only as an experimental drug and does not appear to be in widespread clinical use today.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5404861&quot;>Wikidata Q5404861</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>etozolin</td></tr><tr><td>ATC codes:</td><td>C03CX01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08982&quot;>DB08982</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3038220&quot;>3038220</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5404861&quot;>Q5404861</a></td></tr><tr><td>formula:</td><td>C13H20N2O3S</td></tr><tr><td>molar mass:</td><td>284.374 g/mol (PubChem)</td></tr></table></body></html>"));
