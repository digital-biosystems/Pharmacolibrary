  annotation (Documentation(info = "<html><body><p>Silodosin is an alpha-blocker used to treat urinary symptoms caused by benign prostatic hyperplasia. It is an approved medicine, authorised in the European Union for prostatic hyperplasia, and is also being investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q411770\">Wikidata Q411770</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>silodosin</td></tr><tr><td>ATC codes:</td><td>G04CA04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06207\">DB06207</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5312125\">5312125</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135929\">135929</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q411770\">Q411770</a></td></tr><tr><td>formula:</td><td>C25H32F3N3O4</td></tr><tr><td>molar mass:</td><td>495.542 g/mol (PubChem CID 5312125)</td></tr><tr><td>logP:</td><td>3.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
