within Pharmacolibrary.Drugs.Substances;
package Ornidazole "ornidazole"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "ornidazole",
    atcCodes = {"G01AF06", "J01XD03", "P01AB03"},
    drugbankId = "DB13026",
    pubchemCid = "28061",
    chebiId = "75176",
    wikidataId = "Q2358146",
    formula = "C7H10ClN3O3",
    M = 0.219625,
    logP = 0.6);
  annotation (Documentation(info = "<html><body><p>Ornidazole is a nitroimidazole antimicrobial used against protozoal and anaerobic bacterial infections such as giardiasis, amoebiasis and trichomoniasis. It is considered investigational in major databases and is not authorised in the European Union; it is used mainly in countries outside Europe.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2358146&quot;>Wikidata Q2358146</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ornidazole</td></tr><tr><td>ATC codes:</td><td>G01AF06, J01XD03, P01AB03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13026&quot;>DB13026</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/28061&quot;>28061</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:75176&quot;>75176</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2358146&quot;>Q2358146</a></td></tr><tr><td>formula:</td><td>C7H10ClN3O3</td></tr><tr><td>molar mass:</td><td>219.625 g/mol (PubChem)</td></tr></table></body></html>"));
end Ornidazole;
