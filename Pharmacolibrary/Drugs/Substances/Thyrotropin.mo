  annotation (Documentation(info = "<html><body><p>Thyrotropin (thyroid-stimulating hormone) is a hormone used as a diagnostic agent in tests of thyroid function. It is classed as investigational and is not an approved therapeutic drug.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q211544\">Wikidata Q211544</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>thyrotropin</td></tr><tr><td>ATC codes:</td><td>V04CJ01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB15263\">DB15263</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q211544\">Q211544</a></td></tr></table></body></html>"));
end Thyrotropin;
