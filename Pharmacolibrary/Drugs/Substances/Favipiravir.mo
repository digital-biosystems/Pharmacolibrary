  annotation (Documentation(info = "<html><body><p>Favipiravir is an antiviral drug investigated for treating infections caused by RNA viruses. It is not authorised in the European Union and remains an investigational drug, though it has been approved in some places.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q16934561&quot;>Wikidata Q16934561</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>favipiravir</td></tr><tr><td>ATC codes:</td><td>J05AX27</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12466&quot;>DB12466</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/492405&quot;>492405</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134722&quot;>134722</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q16934561&quot;>Q16934561</a></td></tr><tr><td>formula:</td><td>C5H4FN3O2</td></tr><tr><td>molar mass:</td><td>157.104 g/mol (PubChem)</td></tr></table></body></html>"));
