  annotation (Documentation(info = "<html><body><p>Bromochlorosalicylanilide is an antifungal compound used topically on the skin for fungal infections. It is currently considered experimental and does not appear to be an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4973727&quot;>Wikidata Q4973727</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bromochlorosalicylanilide</td></tr><tr><td>ATC codes:</td><td>D01AE01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13696&quot;>DB13696</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/77254&quot;>77254</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135394&quot;>135394</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4973727&quot;>Q4973727</a></td></tr><tr><td>formula:</td><td>C13H9BrClNO2</td></tr><tr><td>molar mass:</td><td>326.574 g/mol (PubChem)</td></tr></table></body></html>"));
