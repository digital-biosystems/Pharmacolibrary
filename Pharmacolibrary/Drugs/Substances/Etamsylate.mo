  annotation (Documentation(info = "<html><body><p>Etamsylate (ethamsylate) is a chemical compound used as an antihemorrhagic, a systemic hemostatic medicine to reduce bleeding. It is not authorised in the European Union and is considered investigational in major drug databases, though it remains known as a hemostatic agent.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2000876\">Wikidata Q2000876</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>etamsylate</td></tr><tr><td>ATC codes:</td><td>B02BX01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13483\">DB13483</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/17506\">17506</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31563\">31563</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2000876\">Q2000876</a></td></tr><tr><td>formula:</td><td>C10H17NO5S</td></tr><tr><td>molar mass:</td><td>263.308 g/mol (PubChem CID 17506)</td></tr></table></body></html>"));
end Etamsylate;
