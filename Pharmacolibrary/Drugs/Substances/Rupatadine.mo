  annotation (Documentation(info = "<html><body><p>Rupatadine is an antihistamine used to relieve symptoms of allergic conditions such as allergic rhinitis and urticaria. It is approved and used in several countries, though it is not authorised by the European Medicines Agency.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q423450\">Wikidata Q423450</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>rupatadine</td></tr><tr><td>ATC codes:</td><td>R06AX28</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11614\">DB11614</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/133017\">133017</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135673\">135673</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q423450\">Q423450</a></td></tr><tr><td>formula:</td><td>C26H26ClN3</td></tr><tr><td>molar mass:</td><td>415.965 g/mol (PubChem CID 133017)</td></tr><tr><td>logP:</td><td>5.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
