  annotation (Documentation(info = "<html><body><p>Benzoxonium chloride is a quaternary ammonium antiseptic used for local oral treatment and as a skin antiseptic/disinfectant. It appears to be only an experimental agent, with no EU authorisation recorded.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27276265\">Wikidata Q27276265</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>benzoxonium chloride</td></tr><tr><td>ATC codes:</td><td>A01AB14, D08AJ05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13565\">DB13565</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/29564\">29564</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135537\">135537</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27276265\">Q27276265</a></td></tr><tr><td>formula:</td><td>C23H42NO2+</td></tr><tr><td>molar mass:</td><td>364.594 g/mol (PubChem CID 29564)</td></tr></table><p><small>Drugs.Common 25.09 gave 400 g/mol (+9.7 %); replaced by the value above</small></p></body></html>"));
end BenzoxoniumChloride;
