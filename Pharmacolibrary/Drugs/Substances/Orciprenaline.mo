  annotation (Documentation(info = "<html><body><p>Orciprenaline (metaproterenol) is a bronchodilator used to treat asthma and other obstructive lung diseases. It is an approved drug, available as an inhalant and for systemic use, though it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q416473\">Wikidata Q416473</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>orciprenaline</td></tr><tr><td>ATC codes:</td><td>R03AB03, R03CB03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00816\">DB00816</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4086\">4086</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6792\">6792</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q416473\">Q416473</a></td></tr><tr><td>formula:</td><td>C11H17NO3</td></tr><tr><td>molar mass:</td><td>211.261 g/mol (PubChem CID 4086)</td></tr><tr><td>logP:</td><td>0.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
