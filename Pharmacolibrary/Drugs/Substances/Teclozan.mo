  annotation (Documentation(info = "<html><body><p>Teclozan is a dichloroacetamide antiprotozoal agent intended for use against amoebiasis and other protozoal diseases. It is considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7692717\">Wikidata Q7692717</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>teclozan</td></tr><tr><td>ATC codes:</td><td>P01AC04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13205\">DB13205</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/21723\">21723</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135803\">135803</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7692717\">Q7692717</a></td></tr><tr><td>formula:</td><td>C20H28Cl4N2O4</td></tr><tr><td>molar mass:</td><td>502.254 g/mol (PubChem CID 21723)</td></tr><tr><td>logP:</td><td>3.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
