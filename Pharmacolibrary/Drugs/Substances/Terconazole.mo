    logP = 4.8);
  annotation (Documentation(info = "<html><body><p>Terconazole is an antifungal drug used to treat vulvovaginal candidiasis, a yeast infection of the vagina. It is an approved medicine, given as a gynecological antiinfective, and is used for this vaginal infection in countries where it is marketed.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7701687&quot;>Wikidata Q7701687</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>terconazole</td></tr><tr><td>ATC codes:</td><td>G01AG02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00251&quot;>DB00251</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/441383&quot;>441383</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:82981&quot;>82981</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7701687&quot;>Q7701687</a></td></tr><tr><td>formula:</td><td>C26H31Cl2N5O3</td></tr><tr><td>molar mass:</td><td>532.466 g/mol (PubChem)</td></tr></table></body></html>"));
end Terconazole;
