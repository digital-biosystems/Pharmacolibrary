    logP = 5.8);
  annotation (Documentation(info = "<html><body><p>Sonidegib is a hedgehog pathway inhibitor used to treat basal-cell carcinoma of the skin. It is authorised in the European Union and is an approved cancer medicine, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q22075856\">Wikidata Q22075856</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>sonidegib</td></tr><tr><td>ATC codes:</td><td>L01XJ02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09143\">DB09143</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/24775005\">24775005</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:90863\">90863</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q22075856\">Q22075856</a></td></tr><tr><td>formula:</td><td>C26H26F3N3O3</td></tr><tr><td>molar mass:</td><td>485.506 g/mol (PubChem CID 24775005)</td></tr><tr><td>logP:</td><td>5.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Sonidegib;
