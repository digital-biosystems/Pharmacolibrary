  annotation (Documentation(info = "<html><body><p>Ceftriaxone is a third-generation cephalosporin antibiotic used to treat many bacterial infections, including pneumonia, meningitis, gonorrhea, sepsis, and urinary tract infections. It is an approved medicine and is listed by the WHO as an essential medicine, so it is widely used around the world.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q421713\">Wikidata Q421713</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ceftriaxone</td></tr><tr><td>ATC codes:</td><td>J01DD04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01212\">DB01212</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5479530\">5479530</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:29007\">29007</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q421713\">Q421713</a></td></tr><tr><td>formula:</td><td>C18H18N8O7S3</td></tr><tr><td>molar mass:</td><td>554.571 g/mol (PubChem CID 5479530)</td></tr><tr><td>logP:</td><td>-1.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Ceftriaxone;
