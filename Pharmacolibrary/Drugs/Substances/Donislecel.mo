  annotation (Documentation(info = "<html><body><p>Donislecel, a cellular therapy made from donor pancreatic islet cells, is used to treat diabetes. It is an approved medicine, though details of where it is authorised are not given in the facts.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>donislecel</td></tr><tr><td>ATC codes:</td><td>A10XX02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB17961&quot;>DB17961</a></td></tr></table></body></html>"));
