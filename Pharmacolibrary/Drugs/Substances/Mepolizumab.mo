  annotation (Documentation(info = "<html><body><p>Mepolizumab, a monoclonal antibody, is used to treat asthma, hypereosinophilic syndrome, and Churg-Strauss syndrome. It is authorised in the European Union and is also being investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3306175\">Wikidata Q3306175</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>mepolizumab</td></tr><tr><td>ATC codes:</td><td>R03DX09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06612\">DB06612</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3306175\">Q3306175</a></td></tr><tr><td>molar mass:</td><td>149000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Mepolizumab;
