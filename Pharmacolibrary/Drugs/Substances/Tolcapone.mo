    logP = 3.3);
  annotation (Documentation(info = "<html><body><p>Tolcapone is a catechol-O-methyltransferase inhibitor used as an add-on treatment for Parkinson's disease. It remains authorised in the European Union, but its use is restricted because of a boxed warning linked to serious liver safety concerns.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q413840\">Wikidata Q413840</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>tolcapone</td></tr><tr><td>ATC codes:</td><td>N04BX01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00323\">DB00323</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4659569\">4659569</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:63630\">63630</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q413840\">Q413840</a></td></tr><tr><td>formula:</td><td>C14H11NO5</td></tr><tr><td>molar mass:</td><td>273.244 g/mol (PubChem CID 4659569)</td></tr><tr><td>logP:</td><td>3.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Tolcapone;
