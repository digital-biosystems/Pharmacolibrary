  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "tolcapone",
    atcCodes = {"N04BX01"},
    drugbankId = "DB00323",
    pubchemCid = "4659569",
    chebiId = "63630",
    wikidataId = "Q413840",
