  annotation (Documentation(info = "<html><body><p>Risedronic acid is a bisphosphonate used to treat osteoporosis and other bone diseases. It is an approved medicine, widely used for bone conditions, and is also available in combination products.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q408724&quot;>Wikidata Q408724</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>risedronic acid</td></tr><tr><td>ATC codes:</td><td>M05BA07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00884&quot;>DB00884</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5245&quot;>5245</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8869&quot;>8869</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q408724&quot;>Q408724</a></td></tr><tr><td>formula:</td><td>C7H11NO7P2</td></tr><tr><td>molar mass:</td><td>283.113 g/mol (PubChem)</td></tr></table></body></html>"));
