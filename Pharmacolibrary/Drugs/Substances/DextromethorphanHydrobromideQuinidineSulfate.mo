within Pharmacolibrary.Drugs.Substances;
package DextromethorphanHydrobromideQuinidineSulfate "dextromethorphan hydrobromide;quinidine sulfate"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "dextromethorphan hydrobromide;quinidine sulfate",
    atcCodes = fill("", 0),
    drugbankId = "DB00514",
    pubchemCid = "5360696",
    chebiId = "4470",
    wikidataId = "Q407781",
    formula = "C18H25NO",
    M = 0.271404);
  annotation (Documentation(info = "<html><body><p>This combination of dextromethorphan with quinidine is an approved medicine used to treat pseudobulbar affect, a condition of uncontrollable laughing or crying, while dextromethorphan itself is an antitussive for cough. It is an approved drug that remains in use, mainly in the United States, and is also being studied for other investigational uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q407781\">Wikidata Q407781</a>; not checked by a person.</small></p><table><tr><td>name:</td><td>dextromethorphan hydrobromide;quinidine sulfate</td></tr><tr><td>ATC codes:</td><td>—</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00514\">DB00514</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5360696\">5360696</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4470\">4470</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q407781\">Q407781</a></td></tr><tr><td>formula:</td><td>C18H25NO</td></tr><tr><td>molar mass:</td><td>271.404 g/mol (PubChem CID 5360696)</td></tr></table></body></html>"));
end DextromethorphanHydrobromideQuinidineSulfate;
