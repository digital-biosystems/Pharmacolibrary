  annotation (Documentation(info = "<html><body><p>Satraplatin is a platinum-based anticancer drug that was investigated for treating prostate cancer. It remains investigational; its marketing application in the European Union was withdrawn, so it is not approved for use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2226212&quot;>Wikidata Q2226212</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>satraplatin</td></tr><tr><td>ATC codes:</td><td>L01XA04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB04996&quot;>DB04996</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/123974&quot;>123974</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:85609&quot;>85609</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2226212&quot;>Q2226212</a></td></tr><tr><td>formula:</td><td>C10H22Cl2N2O4Pt</td></tr><tr><td>molar mass:</td><td>500.276 g/mol (PubChem)</td></tr></table></body></html>"));
