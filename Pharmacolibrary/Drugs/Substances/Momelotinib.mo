  annotation (Documentation(info = "<html><body><p>Momelotinib is a kinase inhibitor used to treat myelofibrosis. It is authorised in the European Union for myeloproliferative disorders such as splenomegaly.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q252602\">Wikidata Q252602</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>momelotinib</td></tr><tr><td>ATC codes:</td><td>L01EJ04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11763\">DB11763</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/25062766\">25062766</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:91407\">91407</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q252602\">Q252602</a></td></tr><tr><td>formula:</td><td>C23H22N6O2</td></tr><tr><td>molar mass:</td><td>414.469 g/mol (PubChem CID 25062766)</td></tr><tr><td>logP:</td><td>2.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
