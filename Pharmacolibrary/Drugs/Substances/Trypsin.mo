  annotation (Documentation(info = "<html><body><p>Trypsin is a digestive enzyme used to help clean wounds and ulcers, and in other hematological treatments. It is an approved medicine, also approved for veterinary use, with some investigational applications.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q127450&quot;>Wikidata Q127450</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>trypsin</td></tr><tr><td>ATC codes:</td><td>B06AA07, D03BA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11237&quot;>DB11237</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q127450&quot;>Q127450</a></td></tr></table></body></html>"));
end Trypsin;
