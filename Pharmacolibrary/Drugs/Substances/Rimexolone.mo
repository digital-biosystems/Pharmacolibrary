  annotation (Documentation(info = "<html><body><p>Rimexolone is a glucocorticoid used to treat inflammation, especially anterior uveitis, in eye drops. It has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7334443\">Wikidata Q7334443</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>rimexolone</td></tr><tr><td>ATC codes:</td><td>H02AB12, S01BA13</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00896\">DB00896</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5311412\">5311412</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135566\">135566</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7334443\">Q7334443</a></td></tr><tr><td>formula:</td><td>C24H34O3</td></tr><tr><td>molar mass:</td><td>370.533 g/mol (PubChem CID 5311412)</td></tr><tr><td>logP:</td><td>3.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
