  annotation (Documentation(info = "<html><body><p>Choline salicylate is a salicylic acid derivative used as an analgesic and antipyretic, typically for pain relief in the mouth and throat. It is an approved medicine, available in some countries mainly in topical oral preparations such as gels for teething and mouth ulcers.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4499058&quot;>Wikidata Q4499058</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>choline salicylate</td></tr><tr><td>ATC codes:</td><td>N02BA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB14006&quot;>DB14006</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/54675850&quot;>54675850</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3668&quot;>3668</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4499058&quot;>Q4499058</a></td></tr><tr><td>formula:</td><td>C7H5O3-</td></tr><tr><td>molar mass:</td><td>137.114 g/mol (PubChem)</td></tr></table></body></html>"));
