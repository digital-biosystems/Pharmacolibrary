    logP = 2.4);
  annotation (Documentation(info = "<html><body><p>Tibolone is a synthetic steroid hormone medicine used to treat symptoms of menopause and to help prevent osteoporosis in postmenopausal women. It is approved and used in several countries, mainly in Europe and elsewhere outside the United States, where it has not been authorised.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q413805\">Wikidata Q413805</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tibolone</td></tr><tr><td>ATC codes:</td><td>G03CX01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09070\">DB09070</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/444008\">444008</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32223\">32223</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q413805\">Q413805</a></td></tr><tr><td>formula:</td><td>C21H28O2</td></tr><tr><td>molar mass:</td><td>312.453 g/mol (PubChem CID 444008)</td></tr><tr><td>logP:</td><td>2.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Tibolone;
