    logP = 6.3);
  annotation (Documentation(info = "<html><body><p>Isotretinoin is a retinoid used to treat acne, and has also been used for conditions such as rosacea, leukemia, and neuroblastoma. It is an approved medicine, widely used for severe acne, but carries a boxed warning because it is a known teratogen.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q287029\">Wikidata Q287029</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>isotretinoin</td></tr><tr><td>ATC codes:</td><td>D10AD04, D10BA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00982\">DB00982</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5282379\">5282379</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6067\">6067</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q287029\">Q287029</a></td></tr><tr><td>formula:</td><td>C20H28O2</td></tr><tr><td>molar mass:</td><td>300.442 g/mol (PubChem CID 5282379)</td></tr><tr><td>logP:</td><td>6.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Isotretinoin;
