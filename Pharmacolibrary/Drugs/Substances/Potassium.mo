  annotation (Documentation(info = "<html><body><p>Potassium is used to treat or prevent low potassium levels in the blood, often in combination products with diuretics such as thiazides. It is an approved, widely used medicine, available in combination formulations with diuretics.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q703\">Wikidata Q703</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Potassium</td></tr><tr><td>ATC codes:</td><td>C03AB01, C03AB02, C03AB03, C03AB04, C03AB05, C03AB06, C03AB07, C03AB08, C03AB09, C03BB02, C03BB03, C03BB04, C03BB05, C03BB07, C03CB01, C03CB02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB14500\">DB14500</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5462222\">5462222</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32589\">32589</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q703\">Q703</a></td></tr><tr><td>formula:</td><td>K</td></tr><tr><td>molar mass:</td><td>39.098 g/mol (PubChem CID 5462222)</td></tr></table></body></html>"));
