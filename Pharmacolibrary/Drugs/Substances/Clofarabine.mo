within Pharmacolibrary.Drugs.Substances;
package Clofarabine "clofarabine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "clofarabine",
    atcCodes = {"L01BB06"},
    drugbankId = "DB00631",
    pubchemCid = "119182",
    chebiId = "681569",
    wikidataId = "Q5134875",
