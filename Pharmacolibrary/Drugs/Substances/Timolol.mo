    logP = 1.8);
  annotation (Documentation(info = "<html><body><p>Timolol is a non-selective beta blocker used for high blood pressure, angina, after a heart attack, and as eye drops for glaucoma and raised eye pressure. It is an approved medicine and is listed as a WHO essential medicine, so it is widely used worldwide.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q413994&quot;>Wikidata Q413994</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>timolol</td></tr><tr><td>ATC codes:</td><td>C07AA06, S01ED01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00373&quot;>DB00373</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/33624&quot;>33624</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9599&quot;>9599</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q413994&quot;>Q413994</a></td></tr><tr><td>formula:</td><td>C13H24N4O3S</td></tr><tr><td>molar mass:</td><td>316.42 g/mol (PubChem)</td></tr></table></body></html>"));
end Timolol;
