  annotation (Documentation(info = "<html><body><p>Centhaquine is an adrenergic agent classified under cardiac therapy, suggesting use as a cardiac stimulant in cardiovascular conditions. It remains investigational and is not an approved medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q83080535\">Wikidata Q83080535</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>centhaquine</td></tr><tr><td>ATC codes:</td><td>C01CA28</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB16122\">DB16122</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/162163\">162163</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q83080535\">Q83080535</a></td></tr><tr><td>formula:</td><td>C22H25N3</td></tr><tr><td>molar mass:</td><td>331.463 g/mol (PubChem CID 162163)</td></tr><tr><td>logP:</td><td>4.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
