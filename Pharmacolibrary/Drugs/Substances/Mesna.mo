    logP = 0);
  annotation (Documentation(info = "<html><body><p>Mesna is used to protect the bladder from damage caused by certain anticancer drugs, and is also classed as a mucolytic for respiratory conditions. It is an approved medicine used widely in cancer care, typically given alongside chemotherapy in hospital settings.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27102715&quot;>Wikidata Q27102715</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mesna</td></tr><tr><td>ATC codes:</td><td>R05CB05, V03AF01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09110&quot;>DB09110</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/598&quot;>598</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:17905&quot;>17905</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27102715&quot;>Q27102715</a></td></tr><tr><td>formula:</td><td>C2H6O3S2</td></tr><tr><td>molar mass:</td><td>142.187 g/mol (PubChem)</td></tr></table></body></html>"));
end Mesna;
