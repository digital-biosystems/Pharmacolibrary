  annotation (Documentation(info = "<html><body><p>Elapegademase is an enzyme replacement therapy used to treat adenosine deaminase deficiency causing severe combined immunodeficiency. It is an approved medicine, used as an injectable immunostimulant therapy for this rare immune disorder.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q65087024&quot;>Wikidata Q65087024</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>elapegademase</td></tr><tr><td>ATC codes:</td><td>L03AX21</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB14712&quot;>DB14712</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/121488177&quot;>121488177</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q65087024&quot;>Q65087024</a></td></tr><tr><td>formula:</td><td>C10H20N2O5</td></tr><tr><td>molar mass:</td><td>248.279 g/mol (PubChem)</td></tr></table></body></html>"));
