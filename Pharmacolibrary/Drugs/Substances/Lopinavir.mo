  annotation (Documentation(info = "<html><body><p>Lopinavir is an antiviral protease inhibitor used to treat HIV infection and HIV/AIDS. It is a WHO essential medicine and is used widely, typically in combination with other antiretroviral drugs.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q422585\">Wikidata Q422585</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Lopinavir</td></tr><tr><td>ATC codes:</td><td>J05AR10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01601\">DB01601</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/92727\">92727</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31781\">31781</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q422585\">Q422585</a></td></tr><tr><td>formula:</td><td>C37H48N4O5</td></tr><tr><td>molar mass:</td><td>628.814 g/mol (PubChem CID 92727)</td></tr></table></body></html>"));
