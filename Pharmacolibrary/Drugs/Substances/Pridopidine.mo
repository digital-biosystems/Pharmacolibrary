  annotation (Documentation(info = "<html><body><p>Pridopidine is an investigational nervous-system drug studied for Huntington's disease. It is not an approved medicine; a marketing application in the European Union was withdrawn, so its use remains limited to research settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7242858\">Wikidata Q7242858</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>pridopidine</td></tr><tr><td>ATC codes:</td><td>N07XX26</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11947\">DB11947</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9795739\">9795739</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7242858\">Q7242858</a></td></tr><tr><td>formula:</td><td>C15H23NO2S</td></tr><tr><td>molar mass:</td><td>281.414 g/mol (PubChem CID 9795739)</td></tr></table></body></html>"));
