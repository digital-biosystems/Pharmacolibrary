  annotation (Documentation(info = "<html><body><p>Milrinone is a phosphodiesterase inhibitor used as a cardiotonic and vasodilator for congestive heart failure. It is an approved drug, used mainly in hospital settings for acute cardiac support.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q847399\">Wikidata Q847399</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>milrinone</td></tr><tr><td>ATC codes:</td><td>C01CE02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00235\">DB00235</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4197\">4197</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:50693\">50693</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q847399\">Q847399</a></td></tr><tr><td>formula:</td><td>C12H9N3O</td></tr><tr><td>molar mass:</td><td>211.224 g/mol (PubChem CID 4197)</td></tr></table></body></html>"));
