  annotation (Documentation(info = "<html><body><p>Meticillin is a penicillin antibiotic used against staphylococcal infections, including osteomyelitis and bacterial pneumonia. It is classified as a beta-lactamase-resistant penicillin and is listed as an approved antibacterial for systemic use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q409262&quot;>Wikidata Q409262</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>meticillin</td></tr><tr><td>ATC codes:</td><td>J01CF03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01603&quot;>DB01603</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6087&quot;>6087</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6827&quot;>6827</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q409262&quot;>Q409262</a></td></tr><tr><td>formula:</td><td>C17H20N2O6S</td></tr><tr><td>molar mass:</td><td>380.415 g/mol (PubChem)</td></tr></table></body></html>"));
