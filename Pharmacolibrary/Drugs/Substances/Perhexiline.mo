    logP = 6.8);
  annotation (Documentation(info = "<html><body><p>Perhexiline is a calcium channel blocker and vasodilator used as a cardiovascular drug, mainly for angina. It is considered approved, though it is not authorised in the European Union and is used only in a few countries such as Australia and New Zealand.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q1232737&quot;>Wikidata Q1232737</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>perhexiline</td></tr><tr><td>ATC codes:</td><td>C08EX02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01074&quot;>DB01074</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4746&quot;>4746</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:35553&quot;>35553</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q1232737&quot;>Q1232737</a></td></tr><tr><td>formula:</td><td>C19H35N</td></tr><tr><td>molar mass:</td><td>277.496 g/mol (PubChem)</td></tr></table></body></html>"));
