  annotation (Documentation(info = "<html><body><p>Ganaxolone is an antiepileptic medicine used to treat epileptic syndromes, including infantile spasms. It is authorised in the European Union and is also being investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3758034&quot;>Wikidata Q3758034</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>ganaxolone</td></tr><tr><td>ATC codes:</td><td>N03AX27</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB05087&quot;>DB05087</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6918305&quot;>6918305</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:177658&quot;>177658</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3758034&quot;>Q3758034</a></td></tr><tr><td>formula:</td><td>C22H36O2</td></tr><tr><td>molar mass:</td><td>332.528 g/mol (PubChem)</td></tr></table></body></html>"));
