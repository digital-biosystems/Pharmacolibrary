  annotation (Documentation(info = "<html><body><p>Etomidate is an intravenous general anesthetic and sedative-hypnotic, used to induce anesthesia and studied for conditions such as status epilepticus and brain ischemia. It is an approved medicine, used mainly in hospital settings for anesthesia induction.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q418445&quot;>Wikidata Q418445</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>etomidate</td></tr><tr><td>ATC codes:</td><td>N01AX07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00292&quot;>DB00292</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/667484&quot;>667484</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4910&quot;>4910</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q418445&quot;>Q418445</a></td></tr><tr><td>formula:</td><td>C14H16N2O2</td></tr><tr><td>molar mass:</td><td>244.294 g/mol (PubChem)</td></tr></table></body></html>"));
