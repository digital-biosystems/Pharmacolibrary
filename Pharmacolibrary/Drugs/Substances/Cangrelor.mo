    logP = -1);
  annotation (Documentation(info = "<html><body><p>Cangrelor is a platelet aggregation inhibitor used to prevent blood clots in patients with acute coronary syndrome or undergoing vascular surgical procedures. It is an approved medicine with an authorised product in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3655338\">Wikidata Q3655338</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>cangrelor</td></tr><tr><td>ATC codes:</td><td>B01AC25</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06441\">DB06441</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9854012\">9854012</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:90841\">90841</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3655338\">Q3655338</a></td></tr><tr><td>formula:</td><td>C17H25Cl2F3N5O12P3S2</td></tr><tr><td>molar mass:</td><td>776.346 g/mol (PubChem CID 9854012)</td></tr><tr><td>logP:</td><td>-1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
