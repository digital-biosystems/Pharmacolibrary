  annotation (Documentation(info = "<html><body><p>Sodium edetate is a chelating agent that has been investigated for removing toxic metals from the body and has ophthalmological use as an eye preparation. It is considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27284152&quot;>Wikidata Q27284152</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sodium edetate</td></tr><tr><td>ATC codes:</td><td>S01XA05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13404&quot;>DB13404</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27284152&quot;>Q27284152</a></td></tr><tr><td>formula:</td><td>C10H12N2Na4O8</td></tr><tr><td>molar mass:</td><td>380.17 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
