  annotation (Documentation(info = "<html><body><p>Vindesine is a vinca alkaloid that was used as an anticancer (antineoplastic) drug. It is no longer in use, having been withdrawn, and it was never authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q416660\">Wikidata Q416660</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>vindesine</td></tr><tr><td>ATC codes:</td><td>L01CA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00309\">DB00309</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/40839\">40839</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:36373\">36373</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q416660\">Q416660</a></td></tr><tr><td>formula:</td><td>C43H55N5O7</td></tr><tr><td>molar mass:</td><td>753.941 g/mol (PubChem CID 40839)</td></tr><tr><td>logP:</td><td>2.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
