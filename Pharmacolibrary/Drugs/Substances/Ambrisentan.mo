  annotation (Documentation(info = "<html><body><p>Ambrisentan is an antihypertensive drug used to treat pulmonary arterial hypertension. It is authorised in the European Union and is also used for related conditions such as portal and chronic pulmonary hypertension.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q410789&quot;>Wikidata Q410789</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>ambrisentan</td></tr><tr><td>ATC codes:</td><td>C02KX02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06403&quot;>DB06403</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6918493&quot;>6918493</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135949&quot;>135949</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q410789&quot;>Q410789</a></td></tr><tr><td>formula:</td><td>C22H22N2O4</td></tr><tr><td>molar mass:</td><td>378.428 g/mol (PubChem)</td></tr></table></body></html>"));
