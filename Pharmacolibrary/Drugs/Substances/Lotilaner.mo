within Pharmacolibrary.Drugs.Substances;
package Lotilaner "lotilaner"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "lotilaner",
    atcCodes = {"S01AX25"},
    drugbankId = "DB17992",
    pubchemCid = "76959255",
    wikidataId = "Q27279888",
    formula = "C20H14Cl3F6N3O3S",
    M = 0.596748);
  annotation (Documentation(info = "<html><body><p>Lotilaner is an antiparasitic drug sold as Credelio, used mainly to treat flea and tick infestations in dogs and cats, and is also being studied as an eye treatment for parasitic eyelid disease. It is an approved veterinary medicine, and an ophthalmic use is still investigational.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27279888\">Wikidata Q27279888</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>lotilaner</td></tr><tr><td>ATC codes:</td><td>S01AX25</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB17992\">DB17992</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/76959255\">76959255</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27279888\">Q27279888</a></td></tr><tr><td>formula:</td><td>C20H14Cl3F6N3O3S</td></tr><tr><td>molar mass:</td><td>596.748 g/mol (PubChem CID 76959255)</td></tr></table></body></html>"));
end Lotilaner;
