    logP = 5.7);
  annotation (Documentation(info = "<html><body><p>Conivaptan is a vasopressin antagonist used to treat hyponatremia (low blood sodium). It is given by infusion and restricted to hospital use, mainly in the United States; it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5161126&quot;>Wikidata Q5161126</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>conivaptan</td></tr><tr><td>ATC codes:</td><td>C03XA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00872&quot;>DB00872</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/151171&quot;>151171</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:681850&quot;>681850</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5161126&quot;>Q5161126</a></td></tr><tr><td>formula:</td><td>C32H26N4O2</td></tr><tr><td>molar mass:</td><td>498.586 g/mol (PubChem)</td></tr></table></body></html>"));
end Conivaptan;
