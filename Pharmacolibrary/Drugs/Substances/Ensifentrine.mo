  annotation (Documentation(info = "<html><body><p>Ensifentrine is an inhaled drug for chronic obstructive pulmonary disease. It is approved and used for obstructive airway disease, although a marketing application in the European Union was withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q135257708\">Wikidata Q135257708</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>ensifentrine</td></tr><tr><td>ATC codes:</td><td>R03BX02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB16157\">DB16157</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9934746\">9934746</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q135257708\">Q135257708</a></td></tr><tr><td>formula:</td><td>C26H31N5O4</td></tr><tr><td>molar mass:</td><td>477.565 g/mol (PubChem CID 9934746)</td></tr></table></body></html>"));
