  annotation (Documentation(info = "<html><body><p>Isopropamide is a synthetic anticholinergic (quaternary ammonium) drug used for functional gastrointestinal disorders, and also in combination with psycholeptics as an antispasmodic. It has been withdrawn from human use, though it remains approved in veterinary medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3803303&quot;>Wikidata Q3803303</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>isopropamide</td></tr><tr><td>ATC codes:</td><td>A03AB09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01625&quot;>DB01625</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3775&quot;>3775</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6043&quot;>6043</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3803303&quot;>Q3803303</a></td></tr><tr><td>formula:</td><td>C23H33N2O+</td></tr><tr><td>molar mass:</td><td>353.53 g/mol (PubChem)</td></tr></table></body></html>"));
