within Pharmacolibrary.Drugs.Substances;
package Racecadotril "racecadotril"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "racecadotril",
    atcCodes = {"A07XA04"},
    drugbankId = "DB11696",
    pubchemCid = "107751",
    chebiId = "91508",
    wikidataId = "Q416677",
    formula = "C21H23NO4S",
    M = 0.385478,
    logP = 3.3);
  annotation (Documentation(info = "<html><body><p>Racecadotril is an antidiarrhoeal drug, an enkephalinase-inhibiting protease inhibitor used to treat acute diarrhoea. It is not approved in the United States, where it remains investigational, but it is used in several other countries, mainly in Europe and parts of Asia and Latin America, often for children.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q416677\">Wikidata Q416677</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>racecadotril</td></tr><tr><td>ATC codes:</td><td>A07XA04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11696\">DB11696</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/107751\">107751</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:91508\">91508</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q416677\">Q416677</a></td></tr><tr><td>formula:</td><td>C21H23NO4S</td></tr><tr><td>molar mass:</td><td>385.478 g/mol (PubChem CID 107751)</td></tr><tr><td>logP:</td><td>3.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Racecadotril;
