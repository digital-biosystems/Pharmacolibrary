    logP = 2.9);
  annotation (Documentation(info = "<html><body><p>Ulipristal is a hormonal modulator used for emergency contraception and for treating uterine fibroids (leiomyoma). It is authorised in the European Union and is included on the WHO essential medicines list, though some EU products have been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27264992&quot;>Wikidata Q27264992</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>ulipristal</td></tr><tr><td>ATC codes:</td><td>G03AD02, G03XB02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08867&quot;>DB08867</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/13559281&quot;>13559281</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:177631&quot;>177631</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27264992&quot;>Q27264992</a></td></tr><tr><td>formula:</td><td>C28H35NO3</td></tr><tr><td>molar mass:</td><td>433.592 g/mol (PubChem)</td></tr></table></body></html>"));
end Ulipristal;
