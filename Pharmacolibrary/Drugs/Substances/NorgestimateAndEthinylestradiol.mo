    logP = 4.11);
  annotation (Documentation(info = "<html><body><p>Norgestimate combined with ethinylestradiol is a hormonal contraceptive used to prevent pregnancy, and has also been used for amenorrhea. It is an approved, widely used oral contraceptive, available as fixed and sequential progestogen–estrogen combinations.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7051181&quot;>Wikidata Q7051181</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>norgestimate and ethinylestradiol</td></tr><tr><td>ATC codes:</td><td>G03AA11, G03AB09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00957&quot;>DB00957</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6540478&quot;>6540478</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:50815&quot;>50815</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7051181&quot;>Q7051181</a></td></tr><tr><td>formula:</td><td>C23H31NO3</td></tr><tr><td>molar mass:</td><td>369.505 g/mol (PubChem)</td></tr></table></body></html>"));
end NorgestimateAndEthinylestradiol;
