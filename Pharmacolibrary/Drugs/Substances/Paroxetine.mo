  annotation (Documentation(info = "<html><body><p>Paroxetine is a selective serotonin reuptake inhibitor antidepressant used for conditions such as depression, anxiety disorders, panic disorder, obsessive-compulsive disorder, and post-traumatic stress disorder. It is an approved medicine in widespread clinical use, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q408471&quot;>Wikidata Q408471</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>paroxetine</td></tr><tr><td>ATC codes:</td><td>N06AB05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00715&quot;>DB00715</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/43815&quot;>43815</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7936&quot;>7936</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q408471&quot;>Q408471</a></td></tr><tr><td>formula:</td><td>C19H20FNO3</td></tr><tr><td>molar mass:</td><td>329.371 g/mol (PubChem)</td></tr></table></body></html>"));
