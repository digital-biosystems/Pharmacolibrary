  annotation (Documentation(info = "<html><body><p>Naphthoquine is an antimalarial drug used in combination with artemisinin derivatives to treat malaria. It is considered investigational and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27290230&quot;>Wikidata Q27290230</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Naphthoquine</td></tr><tr><td>ATC codes:</td><td>P01BF08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB16249&quot;>DB16249</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/9851775&quot;>9851775</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27290230&quot;>Q27290230</a></td></tr><tr><td>formula:</td><td>C24H28ClN3O</td></tr><tr><td>molar mass:</td><td>409.958 g/mol (PubChem)</td></tr></table></body></html>"));
