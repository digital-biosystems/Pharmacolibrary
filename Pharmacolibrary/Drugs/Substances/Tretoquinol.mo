    logP = 2.5);
  annotation (Documentation(info = "<html><body><p>Tretoquinol is a selective beta-2 adrenergic agonist that acts as a bronchodilator, intended for use in obstructive airway diseases such as asthma. It is considered investigational and does not appear to be an approved medicine in major markets such as the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7838878&quot;>Wikidata Q7838878</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tretoquinol</td></tr><tr><td>ATC codes:</td><td>R03AC09, R03CC09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13692&quot;>DB13692</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/65772&quot;>65772</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135461&quot;>135461</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7838878&quot;>Q7838878</a></td></tr><tr><td>formula:</td><td>C19H23NO5</td></tr><tr><td>molar mass:</td><td>345.395 g/mol (PubChem)</td></tr></table></body></html>"));
end Tretoquinol;
