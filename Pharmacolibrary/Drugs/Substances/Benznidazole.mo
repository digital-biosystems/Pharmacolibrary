  annotation (Documentation(info = "<html><body><p>Benznidazole is an antiparasitic medicine used to treat trypanosomiasis (Chagas disease). It is on the WHO list of essential medicines and is used mainly in regions where Chagas disease occurs.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q425300\">Wikidata Q425300</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>benznidazole</td></tr><tr><td>ATC codes:</td><td>P01CA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11989\">DB11989</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/31593\">31593</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:133833\">133833</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q425300\">Q425300</a></td></tr><tr><td>formula:</td><td>C12H12N4O3</td></tr><tr><td>molar mass:</td><td>260.253 g/mol (PubChem CID 31593)</td></tr><tr><td>logP:</td><td>0.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
