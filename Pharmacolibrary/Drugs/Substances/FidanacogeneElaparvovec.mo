  annotation (Documentation(info = "<html><body><p>Fidanacogene elaparvovec is a gene therapy used to treat hemophilia B. It is an approved medicine, although the product that had been authorised in the European Union was later withdrawn there.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>fidanacogene elaparvovec</td></tr><tr><td>ATC codes:</td><td>B02BD17</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB16783\">DB16783</a></td></tr></table></body></html>"));
