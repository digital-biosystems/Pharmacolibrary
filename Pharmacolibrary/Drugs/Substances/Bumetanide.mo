within Pharmacolibrary.Drugs.Substances;
package Bumetanide "bumetanide"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "bumetanide",
    atcCodes = {"C03CA02"},
    drugbankId = "DB00887",
    pubchemCid = "2471",
    chebiId = "3213",
    wikidataId = "Q275926",
    formula = "C17H20N2O5S",
    M = 0.364416,
    logP = 2.8);
  annotation (Documentation(info = "<html><body><p>Bumetanide is a loop (high-ceiling) diuretic used to treat fluid retention and swelling in conditions such as congestive heart failure, pulmonary edema, nephrotic syndrome, liver cirrhosis, and arterial hypertension. It is an approved medicine that is widely used in clinical practice, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q275926\">Wikidata Q275926</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bumetanide</td></tr><tr><td>ATC codes:</td><td>C03CA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00887\">DB00887</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2471\">2471</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3213\">3213</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q275926\">Q275926</a></td></tr><tr><td>formula:</td><td>C17H20N2O5S</td></tr><tr><td>molar mass:</td><td>364.416 g/mol (PubChem CID 2471)</td></tr><tr><td>logP:</td><td>2.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Bumetanide;
