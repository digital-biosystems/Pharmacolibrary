    logP = 0.1);
  annotation (Documentation(info = "<html><body><p>Methazolamide is a carbonic anhydrase inhibitor used to treat glaucoma, including open-angle and angle-closure forms. It is an approved eye medicine, classified among antiglaucoma preparations for ophthalmic use, though it is not authorised centrally in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1149099\">Wikidata Q1149099</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>methazolamide</td></tr><tr><td>ATC codes:</td><td>S01EC05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00703\">DB00703</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4100\">4100</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6822\">6822</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1149099\">Q1149099</a></td></tr><tr><td>formula:</td><td>C5H8N4O3S2</td></tr><tr><td>molar mass:</td><td>236.264 g/mol (PubChem CID 4100)</td></tr><tr><td>logP:</td><td>0.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
