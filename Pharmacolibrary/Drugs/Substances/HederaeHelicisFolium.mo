within Pharmacolibrary.Drugs.Substances;
package HederaeHelicisFolium "Hederae helicis folium"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "Hederae helicis folium",
    atcCodes = {"R05CA12"},
    drugbankId = "DB13194");
  annotation (Documentation(info = "<html><body><p>Hederae helicis folium (ivy leaf extract) is a herbal expectorant used to relieve cough associated with colds and respiratory conditions. It is not an approved medicine in major regulatory databases and remains investigational, though ivy leaf preparations are traditionally used as cough remedies in some countries.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Hederae helicis folium</td></tr><tr><td>ATC codes:</td><td>R05CA12</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13194\">DB13194</a></td></tr></table></body></html>"));
end HederaeHelicisFolium;
