  annotation (Documentation(info = "<html><body><p>Furosemide is a loop diuretic used to treat fluid build-up caused by heart failure, liver cirrhosis, or kidney disease, and is also used for high blood pressure. It is widely used in human medicine, appears on the WHO essential medicines list, and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q388801&quot;>Wikidata Q388801</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>furosemide</td></tr><tr><td>ATC codes:</td><td>C03CA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00695&quot;>DB00695</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3440&quot;>3440</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:47426&quot;>47426</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q388801&quot;>Q388801</a></td></tr><tr><td>formula:</td><td>C12H11ClN2O5S</td></tr><tr><td>molar mass:</td><td>330.739 g/mol (PubChem)</td></tr></table></body></html>"));
