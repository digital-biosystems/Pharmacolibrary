  annotation (Documentation(info = "<html><body><p>Methylnaltrexone bromide is a peripheral opioid receptor antagonist used to treat constipation, particularly opioid-induced constipation. It is an approved medicine, though its use is also being investigated for other purposes.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q59904170\">Wikidata Q59904170</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>methylnaltrexone bromide</td></tr><tr><td>ATC codes:</td><td>A06AH01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06800\">DB06800</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/16089915\">16089915</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q59904170\">Q59904170</a></td></tr><tr><td>formula:</td><td>C21H26NO4+</td></tr><tr><td>molar mass:</td><td>356.442 g/mol (PubChem CID 16089915)</td></tr></table><p><small>Drugs.Common 25.09 gave 436.3 g/mol (+22.4 %); replaced by the value above</small></p></body></html>"));
