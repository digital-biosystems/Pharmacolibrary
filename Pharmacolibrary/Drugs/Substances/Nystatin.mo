    logP = -0.3);
  annotation (Documentation(info = "<html><body><p>Nystatin is an antifungal antibiotic used to treat candidiasis, including oral, vulvovaginal, cutaneous, and chronic mucocutaneous forms. It is widely used, appears on the WHO essential medicines list, and is applied topically to the skin, mouth, gut, and vagina; it is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q251005&quot;>Wikidata Q251005</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nystatin</td></tr><tr><td>ATC codes:</td><td>A07AA02, D01AA01, G01AA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00646&quot;>DB00646</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/11953884&quot;>11953884</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:473992&quot;>473992</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q251005&quot;>Q251005</a></td></tr><tr><td>formula:</td><td>C47H75NO17</td></tr><tr><td>molar mass:</td><td>926.107 g/mol (PubChem)</td></tr></table></body></html>"));
