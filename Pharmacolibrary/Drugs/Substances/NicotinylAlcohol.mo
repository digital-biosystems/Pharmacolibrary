within Pharmacolibrary.Drugs.Substances;
package NicotinylAlcohol "Nicotinyl alcohol"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "Nicotinyl alcohol",
    atcCodes = {"C04AC02", "C10AD05"},
    drugbankId = "DB04145",
    pubchemCid = "7510",
    wikidataId = "Q411732",
    formula = "C6H7NO",
    M = 0.109128);
  annotation (Documentation(info = "<html><body><p>Nicotinyl alcohol is a nicotinic acid derivative that acts as a vasodilator and has been classified for peripheral vasodilation and lipid modification. It appears only as an experimental agent in drug databases, with no EU authorisation, so it is not in routine clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q411732\">Wikidata Q411732</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Nicotinyl alcohol</td></tr><tr><td>ATC codes:</td><td>C04AC02, C10AD05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB04145\">DB04145</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/7510\">7510</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q411732\">Q411732</a></td></tr><tr><td>formula:</td><td>C6H7NO</td></tr><tr><td>molar mass:</td><td>109.128 g/mol (PubChem CID 7510)</td></tr></table></body></html>"));
end NicotinylAlcohol;
