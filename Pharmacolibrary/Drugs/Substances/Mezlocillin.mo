  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "mezlocillin",
    atcCodes = {"J01CA10"},
    drugbankId = "DB00948",
    pubchemCid = "656511",
    chebiId = "6919",
    wikidataId = "Q3307752",
    formula = "C21H25N5O8S2",
    M = 0.539578,
    logP = -0.2);
  annotation (Documentation(info = "<html><body><p>Mezlocillin is an extended-spectrum penicillin antibiotic used to treat bacterial infections such as sepsis, urinary tract, skin, and respiratory infections, including Pseudomonas and other gram-negative infections. It is an approved antibacterial, though it is not authorised in the European Union and is now used only in a limited number of countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3307752\">Wikidata Q3307752</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mezlocillin</td></tr><tr><td>ATC codes:</td><td>J01CA10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00948\">DB00948</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/656511\">656511</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6919\">6919</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3307752\">Q3307752</a></td></tr><tr><td>formula:</td><td>C21H25N5O8S2</td></tr><tr><td>molar mass:</td><td>539.578 g/mol (PubChem CID 656511)</td></tr><tr><td>logP:</td><td>-0.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Mezlocillin;
