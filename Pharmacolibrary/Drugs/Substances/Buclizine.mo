  annotation (Documentation(info = "<html><body><p>Buclizine is an antihistamine used to treat vomiting and vertigo of central nervous system origin. It is an approved piperazine antihistamine for systemic use, though it does not appear to have European Union authorisation.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4859329&quot;>Wikidata Q4859329</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>buclizine</td></tr><tr><td>ATC codes:</td><td>R06AE01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00354&quot;>DB00354</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6729&quot;>6729</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3205&quot;>3205</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4859329&quot;>Q4859329</a></td></tr><tr><td>formula:</td><td>C28H33ClN2</td></tr><tr><td>molar mass:</td><td>433.036 g/mol (PubChem)</td></tr></table></body></html>"));
