  annotation (Documentation(info = "<html><body><p>Oxyquinoline is an antiseptic used against local infections in the mouth, on the skin, in the genital area, and in the throat. It is an approved drug, also approved for veterinary use, and some uses remain investigational.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q270162\">Wikidata Q270162</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>oxyquinoline</td></tr><tr><td>ATC codes:</td><td>A01AB07, D08AH03, G01AC30, R02AA14</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11145\">DB11145</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/1923\">1923</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:48981\">48981</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q270162\">Q270162</a></td></tr><tr><td>formula:</td><td>C9H7NO</td></tr><tr><td>molar mass:</td><td>145.161 g/mol (PubChem CID 1923)</td></tr><tr><td>logP:</td><td>2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
