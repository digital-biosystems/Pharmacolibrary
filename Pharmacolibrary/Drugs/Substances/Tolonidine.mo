  annotation (Documentation(info = "<html><body><p>Tolonidine is a centrally acting antihypertensive agent, an imidazoline receptor agonist used to lower blood pressure. It appears to be only experimental, with no authorised marketing found in the FACTS.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6590380&quot;>Wikidata Q6590380</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tolonidine</td></tr><tr><td>ATC codes:</td><td>C02AC04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13429&quot;>DB13429</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/72138&quot;>72138</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134879&quot;>134879</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6590380&quot;>Q6590380</a></td></tr><tr><td>formula:</td><td>C10H12ClN3</td></tr><tr><td>molar mass:</td><td>209.677 g/mol (PubChem)</td></tr></table></body></html>"));
