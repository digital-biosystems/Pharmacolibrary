  annotation (Documentation(info = "<html><body><p>Citiolone is a compound classified for liver therapy, suggesting it was used as a liver-protective agent. It appears only as an experimental drug and is not an approved medicine today, so its current use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q15408416\">Wikidata Q15408416</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>citiolone</td></tr><tr><td>ATC codes:</td><td>A05BA04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13442\">DB13442</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/14520\">14520</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:94403\">94403</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q15408416\">Q15408416</a></td></tr><tr><td>formula:</td><td>C6H9NO2S</td></tr><tr><td>molar mass:</td><td>159.203 g/mol (PubChem CID 14520)</td></tr><tr><td>logP:</td><td>-0.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
