  annotation (Documentation(info = "<html><body><p>Zomepirac is a non-steroidal anti-inflammatory drug that was used to relieve pain and inflammation. It was withdrawn from the market after reports of severe allergic reactions in patients taking it.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4024685\">Wikidata Q4024685</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>zomepirac</td></tr><tr><td>ATC codes:</td><td>M01AB04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB04828\">DB04828</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5733\">5733</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:35859\">35859</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4024685\">Q4024685</a></td></tr><tr><td>formula:</td><td>C15H14ClNO3</td></tr><tr><td>molar mass:</td><td>291.731 g/mol (PubChem CID 5733)</td></tr><tr><td>logP:</td><td>2.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
