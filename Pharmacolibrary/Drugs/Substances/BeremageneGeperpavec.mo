  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "beremagene geperpavec",
    atcCodes = {"D03AX16"},
    drugbankId = "DB17831");
  annotation (Documentation(info = "<html><body><p>Beremagene geperpavec is a gene therapy used to treat dystrophic epidermolysis bullosa, a condition causing fragile skin and wounds. It is authorised in the European Union and applied topically as a wound-healing (cicatrizant) treatment.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>beremagene geperpavec</td></tr><tr><td>ATC codes:</td><td>D03AX16</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB17831&quot;>DB17831</a></td></tr></table></body></html>"));
end BeremageneGeperpavec;
