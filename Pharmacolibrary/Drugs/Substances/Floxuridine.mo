  annotation (Documentation(info = "<html><body><p>Floxuridine is an antimetabolite cancer drug used to treat cancers of the stomach and large intestine. It is an approved anticancer medicine, but it is not authorised in the European Union and carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5462356\">Wikidata Q5462356</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>floxuridine</td></tr><tr><td>ATC codes:</td><td>L01BC09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00322\">DB00322</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5790\">5790</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:60761\">60761</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5462356\">Q5462356</a></td></tr><tr><td>formula:</td><td>C9H11FN2O5</td></tr><tr><td>molar mass:</td><td>246.194 g/mol (PubChem CID 5790)</td></tr><tr><td>logP:</td><td>-1.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
