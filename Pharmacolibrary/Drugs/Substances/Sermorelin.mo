within Pharmacolibrary.Drugs.Substances;
package Sermorelin "sermorelin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "sermorelin",
    atcCodes = {"H01AC04", "V04CD03"},
    drugbankId = "DB00010",
    pubchemCid = "16132413",
    wikidataId = "Q7455005",
    formula = "C149H246N44O42S",
    M = 3.35793,
    logP = -12.1);
  annotation (Documentation(info = "<html><body><p>Sermorelin is a growth hormone-releasing analogue that was used to test pituitary function and to treat growth hormone deficiency, and has also been linked to infertility treatment. It has been withdrawn and is no longer available for routine use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7455005&quot;>Wikidata Q7455005</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sermorelin</td></tr><tr><td>ATC codes:</td><td>H01AC04, V04CD03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00010&quot;>DB00010</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/16132413&quot;>16132413</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7455005&quot;>Q7455005</a></td></tr><tr><td>formula:</td><td>C149H246N44O42S</td></tr><tr><td>molar mass:</td><td>3357.93 g/mol (PubChem)</td></tr></table></body></html>"));
end Sermorelin;
