  annotation (Documentation(info = "<html><body><p>Diethyl ether is an inhalational anaesthetic that has also been used for hiccups, pain, and status asthmaticus. It is no longer widely used as a general anaesthetic in modern practice, having been replaced by safer agents.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q202218&quot;>Wikidata Q202218</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>diethyl ether</td></tr><tr><td>ATC codes:</td><td>N01AA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13598&quot;>DB13598</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3283&quot;>3283</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:35702&quot;>35702</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q202218&quot;>Q202218</a></td></tr><tr><td>formula:</td><td>C4H10O</td></tr><tr><td>molar mass:</td><td>74.123 g/mol (PubChem)</td></tr></table></body></html>"));
