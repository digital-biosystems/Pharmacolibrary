within Pharmacolibrary.Drugs.Substances;
package IbandronicAcid "ibandronic acid"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "ibandronic acid",
    atcCodes = {"M05BA06"},
    drugbankId = "DB00710",
    pubchemCid = "60852",
    wikidataId = "Q166825",
    formula = "C9H23NO7P2",
    M = 0.319231,
    logP = -4.1);
  annotation (Documentation(info = "<html><body><p>Ibandronic acid is a bisphosphonate used to treat postmenopausal osteoporosis and other bone diseases, and to prevent bone complications from breast cancer. It is an approved medicine with several products still authorised in the European Union, though some EU marketing authorisations have lapsed or been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q166825\">Wikidata Q166825</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>ibandronic acid</td></tr><tr><td>ATC codes:</td><td>M05BA06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00710\">DB00710</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/60852\">60852</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q166825\">Q166825</a></td></tr><tr><td>formula:</td><td>C9H23NO7P2</td></tr><tr><td>molar mass:</td><td>319.231 g/mol (PubChem CID 60852)</td></tr><tr><td>logP:</td><td>-4.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end IbandronicAcid;
