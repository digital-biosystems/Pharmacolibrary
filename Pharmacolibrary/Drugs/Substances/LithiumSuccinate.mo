  annotation (Documentation(info = "<html><body><p>Lithium succinate is a dermatological preparation that has been used topically, notably for skin conditions such as seborrheic dermatitis. It is not an established marketed medicine today; drug sources classify it as experimental, and no authorisation by the European Medicines Agency is recorded.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6647965&quot;>Wikidata Q6647965</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>lithium succinate</td></tr><tr><td>ATC codes:</td><td>D11AX04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB14508&quot;>DB14508</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6647965&quot;>Q6647965</a></td></tr><tr><td>formula:</td><td>C4H4Li2O4</td></tr><tr><td>molar mass:</td><td>129.95 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end LithiumSuccinate;
