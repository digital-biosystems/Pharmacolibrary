  annotation (Documentation(info = "<html><body><p>Lithium succinate is a dermatological preparation classified under other dermatologicals, historically used for skin conditions such as seborrhoeic dermatitis. It is currently considered experimental and does not appear to be an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q81988374\">Wikidata Q81988374</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>lithium succinate</td></tr><tr><td>ATC codes:</td><td>D11AX04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB14508\">DB14508</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q81988374\">Q81988374</a></td></tr><tr><td>formula:</td><td>C4H4Li2O4</td></tr><tr><td>molar mass:</td><td>129.95 g/mol (knowledgebase (DrugBank calculated))</td></tr></table></body></html>"));
end LithiumSuccinate;
