within Pharmacolibrary.Drugs.Substances;
package Fampridine "fampridine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "fampridine",
    atcCodes = {"N07XX07"},
    drugbankId = "DB06637",
    pubchemCid = "1727",
    chebiId = "34385",
    wikidataId = "Q372539",
    formula = "C5H6N2",
    M = 0.094117,
    logP = 0.3);
  annotation (Documentation(info = "<html><body><p>Fampridine (dalfampridine), a potassium channel blocker, is used to improve walking in people with multiple sclerosis, including its progressive and relapsing-remitting forms. It is authorised in the European Union for multiple sclerosis and is also being investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q372539\">Wikidata Q372539</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>fampridine</td></tr><tr><td>ATC codes:</td><td>N07XX07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06637\">DB06637</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/1727\">1727</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:34385\">34385</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q372539\">Q372539</a></td></tr><tr><td>formula:</td><td>C5H6N2</td></tr><tr><td>molar mass:</td><td>94.117 g/mol (PubChem CID 1727)</td></tr><tr><td>logP:</td><td>0.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Fampridine;
