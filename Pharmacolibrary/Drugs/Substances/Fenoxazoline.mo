  annotation (Documentation(info = "<html><body><p>Fenoxazoline is a nasal decongestant of the sympathomimetic class, used topically to relieve nasal congestion. It is not an approved medicine in major databases, where it is listed only as experimental, so its current availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5443567\">Wikidata Q5443567</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>fenoxazoline</td></tr><tr><td>ATC codes:</td><td>R01AA12</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13736\">DB13736</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/71899\">71899</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134903\">134903</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5443567\">Q5443567</a></td></tr><tr><td>formula:</td><td>C13H18N2O</td></tr><tr><td>molar mass:</td><td>218.3 g/mol (PubChem CID 71899)</td></tr><tr><td>logP:</td><td>2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
