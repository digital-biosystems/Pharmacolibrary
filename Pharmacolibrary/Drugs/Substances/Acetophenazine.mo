  annotation (Documentation(info = "<html><body><p>Acetophenazine is a phenothiazine antipsychotic used to treat schizophrenia and schizophreniform disorder. It is an approved antipsychotic, but it is not widely used today and has no European Union authorisation.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4673284\">Wikidata Q4673284</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>acetophenazine</td></tr><tr><td>ATC codes:</td><td>N05AB07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01063\">DB01063</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/17676\">17676</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:2401\">2401</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4673284\">Q4673284</a></td></tr><tr><td>formula:</td><td>C23H29N3O2S</td></tr><tr><td>molar mass:</td><td>411.564 g/mol (PubChem CID 17676)</td></tr><tr><td>logP:</td><td>2.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
