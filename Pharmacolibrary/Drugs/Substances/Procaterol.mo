    logP = 1.5);
  annotation (Documentation(info = "<html><body><p>Procaterol is a selective beta-2 agonist used to treat obstructive airway diseases such as asthma. It was approved at one point but has been withdrawn in some markets, and is not authorised in the European Union; it remains available mainly in a few countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7247120\">Wikidata Q7247120</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>procaterol</td></tr><tr><td>ATC codes:</td><td>R03AC16, R03CC08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01366\">DB01366</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/688561\">688561</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135209\">135209</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7247120\">Q7247120</a></td></tr><tr><td>formula:</td><td>C16H22N2O3</td></tr><tr><td>molar mass:</td><td>290.363 g/mol (PubChem CID 688561)</td></tr><tr><td>logP:</td><td>1.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Procaterol;
