  annotation (Documentation(info = "<html><body><p>Niaprazine is a sedative drug classified among other hypnotics and sedatives, historically used for its calming and sleep-promoting effects. It is considered investigational and does not appear to have an established authorised use in major markets such as the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q631457\">Wikidata Q631457</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>niaprazine</td></tr><tr><td>ATC codes:</td><td>N05CM16</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13687\">DB13687</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/71919\">71919</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135505\">135505</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q631457\">Q631457</a></td></tr><tr><td>formula:</td><td>C20H25FN4O</td></tr><tr><td>molar mass:</td><td>356.445 g/mol (PubChem CID 71919)</td></tr><tr><td>logP:</td><td>2.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
