    logP = 0);
  annotation (Documentation(info = "<html><body><p>Pyrithione (as zinc pyrithione) is used to treat seborrhoeic dermatitis and other scalp skin conditions, acting as a keratolytic agent. It is an approved dermatological medicine, widely used in over-the-counter anti-dandruff shampoos and skin preparations.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q204602&quot;>Wikidata Q204602</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Pyrithione</td></tr><tr><td>ATC codes:</td><td>D11AX12</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06815&quot;>DB06815</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/1570&quot;>1570</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q204602&quot;>Q204602</a></td></tr><tr><td>formula:</td><td>C5H5NOS</td></tr><tr><td>molar mass:</td><td>127.161 g/mol (PubChem)</td></tr></table></body></html>"));
end Pyrithione;
