    M = 6.38026);
  annotation (Documentation(info = "<html><body><p>Insulin icodec is an ultralong-acting basal insulin analogue used to treat diabetes, mainly type 2 diabetes. It is authorised in the European Union and is an approved, once-weekly injectable insulin for diabetes care.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q111982305\">Wikidata Q111982305</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>insulin icodec</td></tr><tr><td>ATC codes:</td><td>A10AE07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB16693\">DB16693</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q111982305\">Q111982305</a></td></tr><tr><td>molar mass:</td><td>6380.26 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end InsulinIcodec;
