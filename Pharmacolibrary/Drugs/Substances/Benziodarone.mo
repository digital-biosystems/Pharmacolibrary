  annotation (Documentation(info = "<html><body><p>Benziodarone is a vasodilator that was used in cardiac therapy and also acts as a uricosuric agent. It has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4890775&quot;>Wikidata Q4890775</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>benziodarone</td></tr><tr><td>ATC codes:</td><td>C01DX04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13277&quot;>DB13277</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6237&quot;>6237</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135814&quot;>135814</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4890775&quot;>Q4890775</a></td></tr><tr><td>formula:</td><td>C17H12I2O3</td></tr><tr><td>molar mass:</td><td>518.08 g/mol (PubChem)</td></tr></table></body></html>"));
