  annotation (Documentation(info = "<html><body><p>Proguanil is an antimalarial drug used to treat and prevent malaria, especially falciparum malaria. It is widely used, often combined with other antimalarials, and is included on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q420607&quot;>Wikidata Q420607</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>proguanil</td></tr><tr><td>ATC codes:</td><td>P01BB01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01131&quot;>DB01131</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4923&quot;>4923</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8455&quot;>8455</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q420607&quot;>Q420607</a></td></tr><tr><td>formula:</td><td>C11H16ClN5</td></tr><tr><td>molar mass:</td><td>253.734 g/mol (PubChem)</td></tr></table></body></html>"));
