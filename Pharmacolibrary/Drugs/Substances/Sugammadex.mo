    M = 2.00212,
    logP = -10.5);
  annotation (Documentation(info = "<html><body><p>Sugammadex is an antidote used to reverse neuromuscular blockade caused by muscle relaxants during anaesthesia. It is approved and authorised in the European Union, where several sugammadex products are on the market.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q81987842\">Wikidata Q81987842</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>sugammadex</td></tr><tr><td>ATC codes:</td><td>V03AB35</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06206\">DB06206</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6918585\">6918585</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:90953\">90953</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q81987842\">Q81987842</a></td></tr><tr><td>formula:</td><td>C72H112O48S8</td></tr><tr><td>molar mass:</td><td>2002.12 g/mol (PubChem CID 6918585)</td></tr><tr><td>logP:</td><td>-10.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Sugammadex;
