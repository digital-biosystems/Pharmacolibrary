within Pharmacolibrary.Drugs.Substances;
package Sugammadex "sugammadex"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "sugammadex",
    atcCodes = {"V03AB35"},
    drugbankId = "DB06206",
    pubchemCid = "6918585",
    chebiId = "90953",
    wikidataId = "Q81987842",
