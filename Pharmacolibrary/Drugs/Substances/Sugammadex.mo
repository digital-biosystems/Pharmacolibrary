within Pharmacolibrary.Drugs.Substances;
package Sugammadex "sugammadex"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "sugammadex",
    atcCodes = {"V03AB35"},
    drugbankId = "DB06206",
    pubchemCid = "6918585",
    chebiId = "90953",
    wikidataId = "Q420857",
    formula = "C72H112O48S8",
    M = 2.00212,
    logP = -10.5);
  annotation (Documentation(info = "<html><body><p>Sugammadex is an antidote used to reverse neuromuscular blockade caused by muscle relaxants during anaesthesia. It is authorised in the European Union and is widely used in anaesthetic practice.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q420857&quot;>Wikidata Q420857</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>sugammadex</td></tr><tr><td>ATC codes:</td><td>V03AB35</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06206&quot;>DB06206</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6918585&quot;>6918585</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:90953&quot;>90953</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q420857&quot;>Q420857</a></td></tr><tr><td>formula:</td><td>C72H112O48S8</td></tr><tr><td>molar mass:</td><td>2002.12 g/mol (PubChem)</td></tr></table></body></html>"));
end Sugammadex;
