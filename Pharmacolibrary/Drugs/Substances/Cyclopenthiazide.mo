  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "cyclopenthiazide",
    atcCodes = {"C03AA07"},
    drugbankId = "DB13532",
    pubchemCid = "2904",
    chebiId = "91686",
    wikidataId = "Q3676519",
    formula = "C13H18ClN3O4S2",
