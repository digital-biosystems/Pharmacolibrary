  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "clindamycin",
    atcCodes = {"D10AF01", "G01AA10", "J01FF01"},
    drugbankId = "DB01190",
    pubchemCid = "446598",
    chebiId = "3745",
    wikidataId = "Q422273",
    formula = "C18H33ClN2O5S",
