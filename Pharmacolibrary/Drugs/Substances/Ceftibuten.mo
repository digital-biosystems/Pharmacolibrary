  annotation (Documentation(info = "<html><body><p>Ceftibuten is a third-generation cephalosporin antibiotic used to treat bacterial infections such as tonsillitis, pharyngitis, otitis media, acute bronchitis, and urinary tract infections. It is an approved oral antibiotic, used in various countries for these common infections.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q419521\">Wikidata Q419521</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ceftibuten</td></tr><tr><td>ATC codes:</td><td>J01DD14</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01415\">DB01415</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5282242\">5282242</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3510\">3510</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q419521\">Q419521</a></td></tr><tr><td>formula:</td><td>C15H14N4O6S2</td></tr><tr><td>molar mass:</td><td>410.419 g/mol (PubChem CID 5282242)</td></tr><tr><td>logP:</td><td>-0.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
