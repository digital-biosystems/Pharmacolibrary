  annotation (Documentation(info = "<html><body><p>Thiocolchicoside is a centrally acting muscle relaxant used for painful muscle spasms and other musculoskeletal conditions. It is considered investigational in DrugBank, and no marketing authorisation is recorded in the provided facts.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q106055287\">Wikidata Q106055287</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>thiocolchicoside</td></tr><tr><td>ATC codes:</td><td>M03BX05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11582\">DB11582</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9915886\">9915886</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:94557\">94557</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q106055287\">Q106055287</a></td></tr><tr><td>formula:</td><td>C27H33NO10S</td></tr><tr><td>molar mass:</td><td>563.618 g/mol (PubChem CID 9915886)</td></tr><tr><td>logP:</td><td>-0.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
