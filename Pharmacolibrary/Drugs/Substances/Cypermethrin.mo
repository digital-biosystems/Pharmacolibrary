    M = 0.416298,
    logP = 6);
  annotation (Documentation(info = "<html><body><p>Cypermethrin is a pyrethroid insecticide used to kill ectoparasites such as lice and mites. It is not an approved human medicine; DrugBank lists it as investigational, and it is mainly used as an insecticide in agriculture and veterinary settings.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q412024&quot;>Wikidata Q412024</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cypermethrin</td></tr><tr><td>ATC codes:</td><td>P03BA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13721&quot;>DB13721</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2912&quot;>2912</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4042&quot;>4042</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q412024&quot;>Q412024</a></td></tr><tr><td>formula:</td><td>C22H19Cl2NO3</td></tr><tr><td>molar mass:</td><td>416.298 g/mol (PubChem)</td></tr></table></body></html>"));
end Cypermethrin;
