within Pharmacolibrary.Drugs.Substances;
package Cypermethrin "cypermethrin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "cypermethrin",
    atcCodes = {"P03BA02"},
    drugbankId = "DB13721",
    pubchemCid = "2912",
    chebiId = "4042",
    wikidataId = "Q412024",
