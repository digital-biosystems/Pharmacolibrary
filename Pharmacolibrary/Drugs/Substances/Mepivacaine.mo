  annotation (Documentation(info = "<html><body><p>Mepivacaine is a local anesthetic of the amide type used to prevent or relieve pain. It is an approved medicine, also approved for veterinary use, and is used fairly widely in dental and other local anesthesia.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q416760\">Wikidata Q416760</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mepivacaine</td></tr><tr><td>ATC codes:</td><td>N01BB03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00961\">DB00961</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4062\">4062</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6759\">6759</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q416760\">Q416760</a></td></tr><tr><td>formula:</td><td>C15H22N2O</td></tr><tr><td>molar mass:</td><td>246.354 g/mol (PubChem CID 4062)</td></tr><tr><td>logP:</td><td>1.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
