within Pharmacolibrary.Drugs.Substances;
package ProteinC "protein C"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "protein C",
    atcCodes = {"B01AD12"},
    drugbankId = "DB11312",
    wikidataId = "Q28852357");
  annotation (Documentation(info = "<html><body><p>Protein C concentrate is used to treat purpura fulminans and protein C deficiency, acting as an antithrombotic agent. It is authorised in the European Union but appears to be a niche product, used only in these rare conditions.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q28852357&quot;>Wikidata Q28852357</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>protein C</td></tr><tr><td>ATC codes:</td><td>B01AD12</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11312&quot;>DB11312</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q28852357&quot;>Q28852357</a></td></tr></table></body></html>"));
end ProteinC;
