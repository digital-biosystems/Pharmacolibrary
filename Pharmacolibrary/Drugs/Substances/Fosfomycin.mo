    logP = -1.4);
  annotation (Documentation(info = "<html><body><p>Fosfomycin is an antibiotic used to treat urinary tract infections, including cystitis caused by Escherichia coli. It is an approved antibacterial, given systemically and also as an ear (otological) antiinfective, though it is not authorised centrally in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q183554&quot;>Wikidata Q183554</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>fosfomycin</td></tr><tr><td>ATC codes:</td><td>J01XX01, S02AA17</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00828&quot;>DB00828</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/446987&quot;>446987</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:28915&quot;>28915</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q183554&quot;>Q183554</a></td></tr><tr><td>formula:</td><td>C3H7O4P</td></tr><tr><td>molar mass:</td><td>138.059 g/mol (PubChem)</td></tr></table></body></html>"));
end Fosfomycin;
