  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "perphenazine",
    atcCodes = {"N05AB03"},
    drugbankId = "DB00850",
    pubchemCid = "4748",
    chebiId = "8028",
    wikidataId = "Q423520",
