  annotation (Documentation(info = "<html><body><p>Kaolin is an intestinal adsorbent used as an antidiarrhoeal medicine to treat diarrhoea. It is an approved medication, classified for the alimentary tract as an intestinal adsorbent, and is used as an antidiarrhoeal agent.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q20817222\">Wikidata Q20817222</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>kaolin</td></tr><tr><td>ATC codes:</td><td>A07BC02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01575\">DB01575</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/92024769\">92024769</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q20817222\">Q20817222</a></td></tr><tr><td>formula:</td><td>Al2H4O9Si2</td></tr><tr><td>molar mass:</td><td>258.157 g/mol (PubChem CID 92024769)</td></tr><tr><td>logP:</td><td>-3.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
