  annotation (Documentation(info = "<html><body><p>Methenamine is a urinary antibacterial used to treat or prevent urinary tract infections, including cystitis and bacteriuria. It remains an approved medicine, used as a urological and systemic antibacterial agent, and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q71969&quot;>Wikidata Q71969</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>methenamine</td></tr><tr><td>ATC codes:</td><td>J01XX05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06799&quot;>DB06799</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4101&quot;>4101</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6824&quot;>6824</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q71969&quot;>Q71969</a></td></tr><tr><td>formula:</td><td>C6H12N4</td></tr><tr><td>molar mass:</td><td>140.19 g/mol (PubChem)</td></tr></table></body></html>"));
