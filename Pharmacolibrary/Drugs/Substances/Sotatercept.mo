  annotation (Documentation(info = "<html><body><p>Sotatercept is a fusion-protein medication used to treat pulmonary arterial hypertension. It is an approved drug and is used for pulmonary hypertension, classified among antihypertensives for pulmonary arterial hypertension.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q103815273&quot;>Wikidata Q103815273</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sotatercept</td></tr><tr><td>ATC codes:</td><td>C02KX06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12118&quot;>DB12118</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q103815273&quot;>Q103815273</a></td></tr></table></body></html>"));
end Sotatercept;
