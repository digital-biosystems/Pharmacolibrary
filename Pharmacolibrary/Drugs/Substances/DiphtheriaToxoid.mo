within Pharmacolibrary.Drugs.Substances;
package DiphtheriaToxoid "diphtheria toxoid"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "diphtheria toxoid",
    atcCodes = {"J07AF01"},
    drugbankId = "DB10584");
  annotation (Documentation(info = "<html><body><p>Diphtheria toxoid is a vaccine used to protect against diphtheria. It is an approved bacterial diphtheria vaccine and is widely used in routine immunisation programmes, typically given as an adsorbed formulation.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>diphtheria toxoid</td></tr><tr><td>ATC codes:</td><td>J07AF01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB10584\">DB10584</a></td></tr></table></body></html>"));
end DiphtheriaToxoid;
