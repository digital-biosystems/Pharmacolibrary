    logP = 2.2);
  annotation (Documentation(info = "<html><body><p>Metizoline is a sympathomimetic decongestant used topically in nasal preparations to relieve nasal congestion. It is not an authorised medicine in the European Union and appears only as an experimental compound, so its current availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6824158&quot;>Wikidata Q6824158</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>metizoline</td></tr><tr><td>ATC codes:</td><td>R01AA10</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13614&quot;>DB13614</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/28688&quot;>28688</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:136017&quot;>136017</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6824158&quot;>Q6824158</a></td></tr><tr><td>formula:</td><td>C13H14N2S</td></tr><tr><td>molar mass:</td><td>230.329 g/mol (PubChem)</td></tr></table></body></html>"));
end Metizoline;
