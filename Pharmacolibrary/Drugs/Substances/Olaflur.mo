  annotation (Documentation(info = "<html><body><p>Olaflur is a fluoride-containing cariostatic agent used to help prevent tooth decay. It is classified as investigational and is not an authorised medicine in the European Union, though it is known as an ingredient in dental care products.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q263284&quot;>Wikidata Q263284</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>olaflur</td></tr><tr><td>ATC codes:</td><td>A01AA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13290&quot;>DB13290</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/23257&quot;>23257</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q263284&quot;>Q263284</a></td></tr><tr><td>formula:</td><td>C27H60F2N2O3</td></tr><tr><td>molar mass:</td><td>498.784 g/mol (PubChem)</td></tr></table></body></html>"));
