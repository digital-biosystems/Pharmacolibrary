  annotation (Documentation(info = "<html><body><p>Selenium se-75 norcholesterol is a diagnostic radiopharmaceutical, a labelled cholesterol analogue used in imaging of the adrenal glands. It is classed as experimental and does not appear to be an approved medicine today.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27294031\">Wikidata Q27294031</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>selenium (75Se) norcholesterol</td></tr><tr><td>ATC codes:</td><td>V09XX03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13622\">DB13622</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27294031\">Q27294031</a></td></tr><tr><td>formula:</td><td>C28H48OSe</td></tr><tr><td>molar mass:</td><td>475.614 g/mol (knowledgebase (DrugBank calculated))</td></tr></table></body></html>"));
