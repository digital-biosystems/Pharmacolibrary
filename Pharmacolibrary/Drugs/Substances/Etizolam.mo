  annotation (Documentation(info = "<html><body><p>Etizolam is a thienodiazepine-type tranquilizer used as an anxiolytic to treat anxiety and related conditions. It is not authorised in the European Union and is considered investigational in major drug databases, though it is used in some countries where it is marketed.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q409966\">Wikidata Q409966</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>etizolam</td></tr><tr><td>ATC codes:</td><td>N05BA19</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09166\">DB09166</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3307\">3307</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31583\">31583</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q409966\">Q409966</a></td></tr><tr><td>formula:</td><td>C17H15ClN4S</td></tr><tr><td>molar mass:</td><td>342.845 g/mol (PubChem CID 3307)</td></tr><tr><td>logP:</td><td>2.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
