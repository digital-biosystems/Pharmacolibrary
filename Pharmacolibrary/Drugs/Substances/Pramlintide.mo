  annotation (Documentation(info = "<html><body><p>Pramlintide is an anti-diabetic medication used to lower blood glucose in people with type-1 diabetes and maturity-onset diabetes of the young type 2. It is an approved drug, but it is not authorised in the European Union and appears to be used mainly in the United States.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2062094\">Wikidata Q2062094</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pramlintide</td></tr><tr><td>ATC codes:</td><td>A10BX05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01278\">DB01278</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/70691388\">70691388</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135922\">135922</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2062094\">Q2062094</a></td></tr><tr><td>formula:</td><td>C171H267N51O53S2</td></tr><tr><td>molar mass:</td><td>3949.44 g/mol (PubChem CID 70691388)</td></tr><tr><td>logP:</td><td>-15.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Pramlintide;
