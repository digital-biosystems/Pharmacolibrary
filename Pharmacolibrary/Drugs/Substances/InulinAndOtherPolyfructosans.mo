  annotation (Documentation(info = "<html><body><p>Inulin is a soluble dietary fiber (a fructan) used as a diagnostic agent in tests of kidney function and ureteral injuries. It remains in use, also marketed as a nutraceutical dietary supplement.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q201552\">Wikidata Q201552</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>inulin and other polyfructosans</td></tr><tr><td>ATC codes:</td><td>V04CH01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00638\">DB00638</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/24763\">24763</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:15443\">15443</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q201552\">Q201552</a></td></tr></table></body></html>"));
end InulinAndOtherPolyfructosans;
