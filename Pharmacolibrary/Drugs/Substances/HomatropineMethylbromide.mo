  annotation (Documentation(info = "<html><body><p>Homatropine methylbromide is a semisynthetic belladonna alkaloid used as an antispasmodic for functional gastrointestinal disorders. It is an approved drug, used mainly for digestive tract spasms, sometimes in combination with psycholeptics.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2605497&quot;>Wikidata Q2605497</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>homatropine methylbromide</td></tr><tr><td>ATC codes:</td><td>A03BB06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00725&quot;>DB00725</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6646&quot;>6646</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:50373&quot;>50373</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2605497&quot;>Q2605497</a></td></tr><tr><td>formula:</td><td>C17H24BrNO3</td></tr><tr><td>molar mass:</td><td>370.287 g/mol (PubChem)</td></tr></table></body></html>"));
