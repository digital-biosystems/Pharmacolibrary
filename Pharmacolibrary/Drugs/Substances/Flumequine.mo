  annotation (Documentation(info = "<html><body><p>Flumequine is a quinolone antibacterial that was used to treat bacterial infections, particularly urinary tract infections. It has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3074500\">Wikidata Q3074500</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>flumequine</td></tr><tr><td>ATC codes:</td><td>J01MB07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08972\">DB08972</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3374\">3374</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:85269\">85269</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3074500\">Q3074500</a></td></tr><tr><td>formula:</td><td>C14H12FNO3</td></tr><tr><td>molar mass:</td><td>261.252 g/mol (PubChem CID 3374)</td></tr><tr><td>logP:</td><td>2.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
