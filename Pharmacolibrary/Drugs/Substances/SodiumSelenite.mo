  annotation (Documentation(info = "<html><body><p>Sodium selenite is a selenium supplement used to treat or prevent selenium deficiency. It is an approved mineral supplement and can also be added to intravenous electrolyte solutions.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q413722&quot;>Wikidata Q413722</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sodium selenite</td></tr><tr><td>ATC codes:</td><td>A12CE02, B05XA20</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11127&quot;>DB11127</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/1091&quot;>1091</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:26642&quot;>26642</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q413722&quot;>Q413722</a></td></tr><tr><td>formula:</td><td>H2O3Se</td></tr><tr><td>molar mass:</td><td>128.984 g/mol (PubChem)</td></tr></table></body></html>"));
