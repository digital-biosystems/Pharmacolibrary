    logP = 2.5);
  annotation (Documentation(info = "<html><body><p>Clocortolone is a moderately potent topical corticosteroid used to treat inflammation and dermatoses of the face, scalp, legs, and hands. It is an approved medicine, but it does not appear to be authorised in the European Union and is used only in a limited number of countries.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5134843&quot;>Wikidata Q5134843</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>clocortolone</td></tr><tr><td>ATC codes:</td><td>D07AB21</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00838&quot;>DB00838</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5311052&quot;>5311052</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:59582&quot;>59582</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5134843&quot;>Q5134843</a></td></tr><tr><td>formula:</td><td>C22H28ClFO4</td></tr><tr><td>molar mass:</td><td>410.91 g/mol (PubChem)</td></tr></table></body></html>"));
end Clocortolone;
