within Pharmacolibrary.Drugs.Substances;
package AntithymocyteImmunoglobulinRabbit "antithymocyte immunoglobulin (rabbit)"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "antithymocyte immunoglobulin (rabbit)",
    atcCodes = {"L04AA04"},
    drugbankId = "DB00098",
    wikidataId = "Q20801777");
  annotation (Documentation(info = "<html><body><p>Rabbit anti-thymocyte globulin is an immunosuppressant antibody medicine used to suppress T cells, for example in transplant settings. It is an approved medicine, though it carries a boxed warning and is also being studied for further uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q20801777\">Wikidata Q20801777</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>antithymocyte immunoglobulin (rabbit)</td></tr><tr><td>ATC codes:</td><td>L04AA04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00098\">DB00098</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q20801777\">Q20801777</a></td></tr></table></body></html>"));
end AntithymocyteImmunoglobulinRabbit;
