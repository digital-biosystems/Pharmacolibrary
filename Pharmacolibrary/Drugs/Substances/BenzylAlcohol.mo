  annotation (Documentation(info = "<html><body><p>Benzyl alcohol is used as an ectoparasiticide, for example against lice, and also acts as a local anesthetic. It is an approved drug and remains in use, though it is not specifically authorised by the European Medicines Agency.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q52353&quot;>Wikidata Q52353</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>benzyl alcohol</td></tr><tr><td>ATC codes:</td><td>P03AX06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06770&quot;>DB06770</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/244&quot;>244</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:17987&quot;>17987</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q52353&quot;>Q52353</a></td></tr><tr><td>formula:</td><td>C7H8O</td></tr><tr><td>molar mass:</td><td>108.14 g/mol (PubChem)</td></tr></table></body></html>"));
