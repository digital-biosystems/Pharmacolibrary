  annotation (Documentation(info = "<html><body><p>Padeliporfin is a photosensitising anticancer agent used in photodynamic therapy for prostate cancer. It is authorised in the European Union, with one approved product, and remains investigational for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27277134&quot;>Wikidata Q27277134</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>padeliporfin</td></tr><tr><td>ATC codes:</td><td>L01XD07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB15575&quot;>DB15575</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/171041442&quot;>171041442</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27277134&quot;>Q27277134</a></td></tr><tr><td>formula:</td><td>C37H43N5O9PdS</td></tr><tr><td>molar mass:</td><td>840.257 g/mol (PubChem)</td></tr></table></body></html>"));
