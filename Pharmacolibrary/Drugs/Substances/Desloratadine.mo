  annotation (Documentation(info = "<html><body><p>Desloratadine is a non-sedating antihistamine used to treat allergic rhinitis and urticaria. It is approved and widely used, with several products authorised in the European Union for these allergies.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q418060\">Wikidata Q418060</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>desloratadine</td></tr><tr><td>ATC codes:</td><td>R06AX27</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00967\">DB00967</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/124087\">124087</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:291342\">291342</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q418060\">Q418060</a></td></tr><tr><td>formula:</td><td>C19H19ClN2</td></tr><tr><td>molar mass:</td><td>310.825 g/mol (PubChem CID 124087)</td></tr><tr><td>logP:</td><td>4.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
