    wikidataId = "Q3798313");
  annotation (Documentation(info = "<html><body><p>Capromab pendetide is a radiolabelled monoclonal antibody that was used as an imaging agent to detect tumours, particularly prostate cancer. It has been withdrawn and is no longer marketed.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3798313&quot;>Wikidata Q3798313</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Capromab pendetide</td></tr><tr><td>ATC codes:</td><td>V09IB04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00089&quot;>DB00089</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3798313&quot;>Q3798313</a></td></tr></table></body></html>"));
end CapromabPendetide;
