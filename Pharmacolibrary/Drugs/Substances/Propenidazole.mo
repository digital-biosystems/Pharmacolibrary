  annotation (Documentation(info = "<html><body><p>Propenidazole is a nitroimidazole-type compound classified as a gynecological antiinfective and antiprotozoal agent, suggesting use against protozoal and vaginal infections. It appears only as an experimental drug, with no evidence of marketing approval in the European Union or elsewhere.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7250158&quot;>Wikidata Q7250158</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>propenidazole</td></tr><tr><td>ATC codes:</td><td>G01AF14, P01AB05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13319&quot;>DB13319</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6446788&quot;>6446788</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135098&quot;>135098</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7250158&quot;>Q7250158</a></td></tr><tr><td>formula:</td><td>C11H13N3O5</td></tr><tr><td>molar mass:</td><td>267.241 g/mol (PubChem)</td></tr></table></body></html>"));
