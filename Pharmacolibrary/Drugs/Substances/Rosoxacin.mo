  annotation (Documentation(info = "<html><body><p>Rosoxacin is a quinolone antibacterial used to treat bacterial infections, notably gonorrhoea. It has been marketed under the name Acrosoxacin but is now little used and not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q754690\">Wikidata Q754690</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>rosoxacin</td></tr><tr><td>ATC codes:</td><td>J01MB01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00817\">DB00817</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/287180\">287180</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:131715\">131715</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q754690\">Q754690</a></td></tr><tr><td>formula:</td><td>C17H14N2O3</td></tr><tr><td>molar mass:</td><td>294.31 g/mol (PubChem CID 287180)</td></tr><tr><td>logP:</td><td>0.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
