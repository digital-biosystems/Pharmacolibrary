  annotation (Documentation(info = "<html><body><p>Zorubicin is an anthracycline-related cytotoxic antibiotic that was investigated as an anticancer (antineoplastic) agent. It appears to be only experimental; there is no evidence of current marketing approval, and it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q8074531&quot;>Wikidata Q8074531</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>zorubicin</td></tr><tr><td>ATC codes:</td><td>L01DB05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11618&quot;>DB11618</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/9595290&quot;>9595290</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135863&quot;>135863</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q8074531&quot;>Q8074531</a></td></tr><tr><td>formula:</td><td>C34H35N3O10</td></tr><tr><td>molar mass:</td><td>645.665 g/mol (PubChem)</td></tr></table></body></html>"));
