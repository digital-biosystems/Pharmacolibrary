  annotation (Documentation(info = "<html><body><p>Monoxerutin is a bioflavonoid classified as a capillary-stabilizing vasoprotective agent, intended for conditions involving fragile capillaries and veins. It appears to be experimental rather than an established marketed medicine, with no European Union authorisation recorded.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6902068&quot;>Wikidata Q6902068</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>monoxerutin</td></tr><tr><td>ATC codes:</td><td>C05CA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13764&quot;>DB13764</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/9852585&quot;>9852585</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134704&quot;>134704</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6902068&quot;>Q6902068</a></td></tr><tr><td>formula:</td><td>C29H34O17</td></tr><tr><td>molar mass:</td><td>654.574 g/mol (PubChem)</td></tr></table></body></html>"));
