  annotation (Documentation(info = "<html><body><p>Etafenone is a vasodilator once classified for use in cardiac diseases. It is considered experimental and does not appear to be an approved medicine today.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5402380&quot;>Wikidata Q5402380</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>etafenone</td></tr><tr><td>ATC codes:</td><td>C01DX07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13845&quot;>DB13845</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3275&quot;>3275</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135389&quot;>135389</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5402380&quot;>Q5402380</a></td></tr><tr><td>formula:</td><td>C21H27NO2</td></tr><tr><td>molar mass:</td><td>325.452 g/mol (PubChem)</td></tr></table></body></html>"));
