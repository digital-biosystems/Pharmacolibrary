  annotation (Documentation(info = "<html><body><p>Pentobarbital is a barbiturate sedative-hypnotic used as a hypnotic and sedative, and to treat status epilepticus. It remains an approved medicine and is also approved for veterinary use, though it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q409632&quot;>Wikidata Q409632</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pentobarbital</td></tr><tr><td>ATC codes:</td><td>N05CA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00312&quot;>DB00312</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4737&quot;>4737</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7983&quot;>7983</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q409632&quot;>Q409632</a></td></tr><tr><td>formula:</td><td>C11H18N2O3</td></tr><tr><td>molar mass:</td><td>226.276 g/mol (PubChem)</td></tr></table></body></html>"));
