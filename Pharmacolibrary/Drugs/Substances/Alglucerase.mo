within Pharmacolibrary.Drugs.Substances;
package Alglucerase "alglucerase"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "alglucerase",
    atcCodes = {"A16AB01"},
    drugbankId = "DB00088",
    wikidataId = "Q4724257",
    M = 55.5974);
  annotation (Documentation(info = "<html><body><p>Alglucerase is an enzyme replacement therapy that was used to treat Gaucher disease, a condition involving liver and spleen enlargement. It has been withdrawn from the market, having been superseded by a newer version of the enzyme produced by recombinant DNA technology.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4724257&quot;>Wikidata Q4724257</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>alglucerase</td></tr><tr><td>ATC codes:</td><td>A16AB01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00088&quot;>DB00088</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4724257&quot;>Q4724257</a></td></tr><tr><td>molar mass:</td><td>55597.4 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Alglucerase;
