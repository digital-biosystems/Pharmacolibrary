within Pharmacolibrary.Drugs.Substances;
package AmmoniumChloride "ammonium chloride"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "ammonium chloride",
    atcCodes = {"B05XA04", "G04BA01"},
    drugbankId = "DB06767",
    pubchemCid = "25517",
    chebiId = "31206",
    wikidataId = "Q188543",
    formula = "ClH4N",
    M = 0.053489);
  annotation (Documentation(info = "<html><body><p>Ammonium chloride is used as a urinary acidifier and as an electrolyte additive in intravenous solutions to help correct low chloride or metabolic alkalosis. It is an approved medicine and also approved for veterinary use, though it is not authorised centrally in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q188543\">Wikidata Q188543</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ammonium chloride</td></tr><tr><td>ATC codes:</td><td>B05XA04, G04BA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06767\">DB06767</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/25517\">25517</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31206\">31206</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q188543\">Q188543</a></td></tr><tr><td>formula:</td><td>ClH4N</td></tr><tr><td>molar mass:</td><td>53.489 g/mol (PubChem CID 25517)</td></tr></table></body></html>"));
end AmmoniumChloride;
