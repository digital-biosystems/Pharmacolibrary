  annotation (Documentation(info = "<html><body><p>Glipizide is a sulfonylurea blood-glucose-lowering medicine used to treat diabetes, including a rare inherited form called maturity-onset diabetes of the young type 2. It is an approved anti-diabetic medication, widely used for lowering blood sugar in people with diabetes.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3108899&quot;>Wikidata Q3108899</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>glipizide</td></tr><tr><td>ATC codes:</td><td>A10BB07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01067&quot;>DB01067</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3478&quot;>3478</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:5384&quot;>5384</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3108899&quot;>Q3108899</a></td></tr><tr><td>formula:</td><td>C21H27N5O4S</td></tr><tr><td>molar mass:</td><td>445.538 g/mol (PubChem)</td></tr></table></body></html>"));
