    M = 0.143091);
  annotation (Documentation(info = "<html><body><p>Selenium sulfide is a topical antifungal used to treat seborrhoeic dermatitis, pityriasis versicolor, and other scalp skin conditions. It is an approved medicine and appears on the WHO essential medicines list, so it is widely available for topical skin use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q419375\">Wikidata Q419375</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>selenium sulfide</td></tr><tr><td>ATC codes:</td><td>D01AE13</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00971\">DB00971</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/24087\">24087</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135934\">135934</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q419375\">Q419375</a></td></tr><tr><td>formula:</td><td>S2Se</td></tr><tr><td>molar mass:</td><td>143.091 g/mol (PubChem CID 24087)</td></tr></table><p><small>Drugs.Common 25.09 gave 111.04 g/mol (-22.4 %); replaced by the value above</small></p></body></html>"));
end SeleniumSulfide;
