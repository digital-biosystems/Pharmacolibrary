  annotation (Documentation(info = "<html><body><p>Brivudine is an antiviral drug used to treat herpesvirus infections, mainly shingles caused by varicella-zoster virus. It is approved and used in some European countries, but is not available everywhere.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q904107\">Wikidata Q904107</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>brivudine</td></tr><tr><td>ATC codes:</td><td>J05AB15</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB03312\">DB03312</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/446727\">446727</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q904107\">Q904107</a></td></tr><tr><td>formula:</td><td>C11H13BrN2O5</td></tr><tr><td>molar mass:</td><td>333.138 g/mol (PubChem CID 446727)</td></tr><tr><td>logP:</td><td>-0.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Brivudine;
