  annotation (Documentation(info = "<html><body><p>Dienogest is a progestogen used in hormonal contraceptives, typically combined with an estrogen. It is an approved medicine, used in oral contraceptive preparations, and has also been investigated for other uses such as male contraception.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q139160\">Wikidata Q139160</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dienogest</td></tr><tr><td>ATC codes:</td><td>G03DB08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09123\">DB09123</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/68861\">68861</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:70708\">70708</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q139160\">Q139160</a></td></tr><tr><td>formula:</td><td>C20H25NO2</td></tr><tr><td>molar mass:</td><td>311.425 g/mol (PubChem CID 68861)</td></tr><tr><td>logP:</td><td>1.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
