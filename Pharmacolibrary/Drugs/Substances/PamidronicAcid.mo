    logP = -6.9);
  annotation (Documentation(info = "<html><body><p>Pamidronic acid is a bisphosphonate used to treat bone conditions such as osteoporosis, hypercalcemia, osteolysis, and mammary Paget's disease. It is an approved drug, given by infusion, and is used in many countries for bone-related disorders.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q627499&quot;>Wikidata Q627499</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pamidronic acid</td></tr><tr><td>ATC codes:</td><td>M05BA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00282&quot;>DB00282</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4674&quot;>4674</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7903&quot;>7903</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q627499&quot;>Q627499</a></td></tr><tr><td>formula:</td><td>C3H11NO7P2</td></tr><tr><td>molar mass:</td><td>235.069 g/mol (PubChem)</td></tr></table></body></html>"));
end PamidronicAcid;
