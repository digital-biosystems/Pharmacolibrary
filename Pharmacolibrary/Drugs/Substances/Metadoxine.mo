  annotation (Documentation(info = "<html><body><p>Metadoxine, a combination of pyridoxine and pyrrolidonecarboxylic acid, has been studied as a liver therapy, particularly for alcohol-related liver problems. It is considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q18344013&quot;>Wikidata Q18344013</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>metadoxine</td></tr><tr><td>ATC codes:</td><td>A05BA09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB16554&quot;>DB16554</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/115198&quot;>115198</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q18344013&quot;>Q18344013</a></td></tr><tr><td>formula:</td><td>C13H18N2O6</td></tr><tr><td>molar mass:</td><td>298.295 g/mol (PubChem)</td></tr></table></body></html>"));
