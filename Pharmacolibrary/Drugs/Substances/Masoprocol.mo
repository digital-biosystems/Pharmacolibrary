  annotation (Documentation(info = "<html><body><p>Masoprocol, also known as nordihydroguaiaretic acid, is an antineoplastic agent that has been studied for treating keratosis. It is not an approved medicine and remains an investigational drug, with no authorisation in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6783851&quot;>Wikidata Q6783851</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>masoprocol</td></tr><tr><td>ATC codes:</td><td>L01XX10</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00179&quot;>DB00179</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/71398&quot;>71398</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:73468&quot;>73468</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6783851&quot;>Q6783851</a></td></tr><tr><td>formula:</td><td>C18H22O4</td></tr><tr><td>molar mass:</td><td>302.37 g/mol (PubChem)</td></tr></table></body></html>"));
