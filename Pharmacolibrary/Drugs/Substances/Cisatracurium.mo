  annotation (Documentation(info = "<html><body><p>Cisatracurium is a peripherally acting muscle relaxant, related to atracurium, used to relax muscles during surgical procedures and mechanical ventilation. It is an approved medicine in widespread clinical use, mainly in anaesthesia and intensive care settings.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q81978749&quot;>Wikidata Q81978749</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cisatracurium</td></tr><tr><td>ATC codes:</td><td>M03AC11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00565&quot;>DB00565</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/62886&quot;>62886</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:140621&quot;>140621</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q81978749&quot;>Q81978749</a></td></tr><tr><td>formula:</td><td>C65H82N2O18S2</td></tr><tr><td>molar mass:</td><td>1243.49 g/mol (PubChem)</td></tr></table></body></html>"));
