within Pharmacolibrary.Drugs.Substances;
package Oxymetazoline "oxymetazoline"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "oxymetazoline",
    atcCodes = {"D11AX27", "R01AA05", "R01AB07", "S01GA04"},
    drugbankId = "DB00935",
    pubchemCid = "4636",
    chebiId = "7862",
    wikidataId = "Q417813",
    formula = "C16H24N2O",
    M = 0.260381,
    logP = 2.9);
  annotation (Documentation(info = "<html><body><p>Oxymetazoline is a topical decongestant used for nasal congestion from rhinitis or nasopharyngitis, eye redness in conjunctivitis, and the skin condition rosacea. It is widely available over the counter as nasal sprays, eye drops, and skin creams, and is also an approved dermatological treatment.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q417813\">Wikidata Q417813</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>oxymetazoline</td></tr><tr><td>ATC codes:</td><td>D11AX27, R01AA05, R01AB07, S01GA04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00935\">DB00935</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4636\">4636</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7862\">7862</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q417813\">Q417813</a></td></tr><tr><td>formula:</td><td>C16H24N2O</td></tr><tr><td>molar mass:</td><td>260.381 g/mol (PubChem CID 4636)</td></tr><tr><td>logP:</td><td>2.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Oxymetazoline;
