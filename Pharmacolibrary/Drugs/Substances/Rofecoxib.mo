  annotation (Documentation(info = "<html><body><p>Rofecoxib is a COX-2 inhibitor painkiller that was used to treat osteoarthritis and pain. It was withdrawn from the market after approval, mainly because of cardiovascular safety concerns.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q411412&quot;>Wikidata Q411412</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>rofecoxib</td></tr><tr><td>ATC codes:</td><td>M01AH02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00533&quot;>DB00533</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5090&quot;>5090</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8887&quot;>8887</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q411412&quot;>Q411412</a></td></tr><tr><td>formula:</td><td>C17H14O4S</td></tr><tr><td>molar mass:</td><td>314.355 g/mol (PubChem)</td></tr></table></body></html>"));
