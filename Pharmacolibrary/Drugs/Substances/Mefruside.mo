  annotation (Documentation(info = "<html><body><p>Mefruside is a sulfonamide diuretic that has been used to treat arterial hypertension. It is no longer in practical use and is regarded as an experimental drug, with no marketing authorisation recorded in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6807947&quot;>Wikidata Q6807947</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mefruside</td></tr><tr><td>ATC codes:</td><td>C03BA05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13405&quot;>DB13405</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4047&quot;>4047</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31809&quot;>31809</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6807947&quot;>Q6807947</a></td></tr><tr><td>formula:</td><td>C13H19ClN2O5S2</td></tr><tr><td>molar mass:</td><td>382.874 g/mol (PubChem)</td></tr></table></body></html>"));
