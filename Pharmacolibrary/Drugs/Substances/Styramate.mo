  annotation (Documentation(info = "<html><body><p>Styramate is a centrally acting muscle relaxant of the carbamate class, studied for relieving muscle spasm. It remained experimental and does not appear to be an approved or marketed medicine today.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q1300243&quot;>Wikidata Q1300243</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>styramate</td></tr><tr><td>ATC codes:</td><td>M03BA04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13357&quot;>DB13357</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/7186&quot;>7186</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134820&quot;>134820</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q1300243&quot;>Q1300243</a></td></tr><tr><td>formula:</td><td>C9H11NO3</td></tr><tr><td>molar mass:</td><td>181.191 g/mol (PubChem)</td></tr></table></body></html>"));
