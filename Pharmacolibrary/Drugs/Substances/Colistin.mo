within Pharmacolibrary.Drugs.Substances;
package Colistin "colistin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "colistin",
    atcCodes = {"A07AA10", "J01XB01"},
    drugbankId = "DB00803",
    pubchemCid = "131704173",
    wikidataId = "Q418946",
    formula = "C52H98N16O13",
    M = 1.15545,
    logP = -3.3);
  annotation (Documentation(info = "<html><body><p>Colistin is a polymyxin antibiotic used to treat serious infections caused by resistant Gram-negative bacteria, and also as an intestinal antiinfective for gut decontamination. It remains in clinical use but is generally reserved for hospital treatment of multidrug-resistant infections when other antibiotics are not suitable.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q418946&quot;>Wikidata Q418946</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>colistin</td></tr><tr><td>ATC codes:</td><td>A07AA10, J01XB01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00803&quot;>DB00803</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/131704173&quot;>131704173</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q418946&quot;>Q418946</a></td></tr><tr><td>formula:</td><td>C52H98N16O13</td></tr><tr><td>molar mass:</td><td>1155.45 g/mol (PubChem)</td></tr></table></body></html>"));
end Colistin;
