  annotation (Documentation(info = "<html><body><p>Folinic acid is used as a detoxifying agent to protect healthy cells during cancer chemotherapy, and is also given to counteract folate deficiency. It is an approved medicine, used widely in clinical practice alongside certain anticancer drugs.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q45435667&quot;>Wikidata Q45435667</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sodium folinate</td></tr><tr><td>ATC codes:</td><td>V03AF06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00650&quot;>DB00650</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6006&quot;>6006</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:15640&quot;>15640</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q45435667&quot;>Q45435667</a></td></tr><tr><td>formula:</td><td>C20H23N7O7</td></tr><tr><td>molar mass:</td><td>473.446 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
