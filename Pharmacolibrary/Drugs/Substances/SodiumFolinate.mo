  annotation (Documentation(info = "<html><body><p>Sodium folinate (folinic acid) is used as a detoxifying agent to counteract the harmful effects of anticancer treatment, and is also being studied for other uses. It is an approved medicine, though it is not authorised centrally in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27155238\">Wikidata Q27155238</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sodium folinate</td></tr><tr><td>ATC codes:</td><td>V03AF06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00650\">DB00650</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6006\">6006</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:15640\">15640</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27155238\">Q27155238</a></td></tr><tr><td>formula:</td><td>C20H23N7O7</td></tr><tr><td>molar mass:</td><td>473.446 g/mol (knowledgebase (DrugBank calculated))</td></tr></table><p><small>Drugs.Common 25.09 gave 517.4 g/mol (+9.3 %); replaced by the value above</small></p></body></html>"));
