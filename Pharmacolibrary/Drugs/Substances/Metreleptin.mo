  annotation (Documentation(info = "<html><body><p>Metreleptin is a protein drug used to treat lipodystrophy, including acquired and familial partial forms. It is authorised in the European Union, but carries a boxed warning, so its use is limited.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q17143468\">Wikidata Q17143468</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>metreleptin</td></tr><tr><td>ATC codes:</td><td>A16AA07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09046\">DB09046</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q17143468\">Q17143468</a></td></tr><tr><td>molar mass:</td><td>16155.4 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Metreleptin;
