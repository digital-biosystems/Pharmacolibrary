    logP = 5.3);
  annotation (Documentation(info = "<html><body><p>Econazole is a topical antifungal medicine used to treat skin fungal infections such as tinea, tinea pedis, pityriasis versicolor, and cutaneous candidiasis. It is an approved drug, applied topically to the skin and also available as a gynecological antiinfective.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q417141\">Wikidata Q417141</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>econazole</td></tr><tr><td>ATC codes:</td><td>D01AC03, G01AF05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01127\">DB01127</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3198\">3198</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:82873\">82873</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q417141\">Q417141</a></td></tr><tr><td>formula:</td><td>C18H15Cl3N2O</td></tr><tr><td>molar mass:</td><td>381.681 g/mol (PubChem CID 3198)</td></tr><tr><td>logP:</td><td>5.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Econazole;
