    logP = 1.4);
  annotation (Documentation(info = "<html><body><p>Guaifenesin is an expectorant used to relieve cough associated with conditions such as the common cold, bronchitis, sinusitis, and pharyngitis. It is widely available as an approved medicine for people and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q420682&quot;>Wikidata Q420682</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>guaifenesin</td></tr><tr><td>ATC codes:</td><td>R05CA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00874&quot;>DB00874</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3516&quot;>3516</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:5551&quot;>5551</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q420682&quot;>Q420682</a></td></tr><tr><td>formula:</td><td>C10H14O4</td></tr><tr><td>molar mass:</td><td>198.218 g/mol (PubChem)</td></tr></table></body></html>"));
end Guaifenesin;
