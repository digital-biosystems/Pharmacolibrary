within Pharmacolibrary.Drugs.Substances;
package Resminostat "resminostat"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "resminostat",
    atcCodes = {"L01XH07"},
    drugbankId = "DB12392",
    pubchemCid = "11609955",
