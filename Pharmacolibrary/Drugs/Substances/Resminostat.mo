    formula = "C16H19N3O4S",
    M = 0.349405);
  annotation (Documentation(info = "<html><body><p>Resminostat is an investigational anticancer drug, a histone deacetylase inhibitor studied for treating cutaneous T-cell lymphomas such as mycosis fungoides and Sézary syndrome. It is not an approved medicine; in the European Union it has only reached the opinion stage of regulatory assessment.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q18394103\">Wikidata Q18394103</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>resminostat</td></tr><tr><td>ATC codes:</td><td>L01XH07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12392\">DB12392</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/11609955\">11609955</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q18394103\">Q18394103</a></td></tr><tr><td>formula:</td><td>C16H19N3O4S</td></tr><tr><td>molar mass:</td><td>349.405 g/mol (PubChem CID 11609955)</td></tr></table></body></html>"));
end Resminostat;
