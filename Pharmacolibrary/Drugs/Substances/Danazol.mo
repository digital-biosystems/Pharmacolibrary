    logP = 3.8);
  annotation (Documentation(info = "<html><body><p>Danazol is a steroid drug with antigonadotropic (estrogen-antagonist) action, used mainly to treat endometriosis and also studied for other conditions such as anasarca. It remains an approved medicine, though its use is limited by a boxed warning, and it is not authorised centrally in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q419652\">Wikidata Q419652</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>danazol</td></tr><tr><td>ATC codes:</td><td>G03XA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01406\">DB01406</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/28417\">28417</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4315\">4315</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q419652\">Q419652</a></td></tr><tr><td>formula:</td><td>C22H27NO2</td></tr><tr><td>molar mass:</td><td>337.463 g/mol (PubChem CID 28417)</td></tr><tr><td>logP:</td><td>3.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Danazol;
