  annotation (Documentation(info = "<html><body><p>Danazol is a steroid drug with antigonadotropic (estrogen-antagonist) action, used mainly to treat endometriosis and also studied for other conditions such as anasarca. It remains an approved medicine, though its use is limited by a boxed warning, and it is not authorised centrally in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q419652&quot;>Wikidata Q419652</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>danazol</td></tr><tr><td>ATC codes:</td><td>G03XA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01406&quot;>DB01406</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/28417&quot;>28417</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4315&quot;>4315</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q419652&quot;>Q419652</a></td></tr><tr><td>formula:</td><td>C22H27NO2</td></tr><tr><td>molar mass:</td><td>337.463 g/mol (PubChem)</td></tr></table></body></html>"));
end Danazol;
