  annotation (Documentation(info = "<html><body><p>Amlodipine is a calcium channel blocker used to treat high blood pressure and angina. It is widely used worldwide and is included on the WHO list of essential medicines, available alone and in many fixed-dose combination products.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q411347&quot;>Wikidata Q411347</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>amlodipine</td></tr><tr><td>ATC codes:</td><td>C08CA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00381&quot;>DB00381</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2162&quot;>2162</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:2668&quot;>2668</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q411347&quot;>Q411347</a></td></tr><tr><td>formula:</td><td>C20H25ClN2O5</td></tr><tr><td>molar mass:</td><td>408.879 g/mol (PubChem)</td></tr></table></body></html>"));
