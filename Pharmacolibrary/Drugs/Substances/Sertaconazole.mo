  annotation (Documentation(info = "<html><body><p>Sertaconazole is an antifungal medicine used to treat fungal skin and vaginal infections. It is an approved topical drug, applied to the skin or used gynaecologically, though it is not an EU-wide centrally authorised medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3479994&quot;>Wikidata Q3479994</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sertaconazole</td></tr><tr><td>ATC codes:</td><td>D01AC14, G01AF19</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01153&quot;>DB01153</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/65863&quot;>65863</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:83682&quot;>83682</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3479994&quot;>Q3479994</a></td></tr><tr><td>formula:</td><td>C20H15Cl3N2OS</td></tr><tr><td>molar mass:</td><td>437.763 g/mol (PubChem)</td></tr></table></body></html>"));
