    logP = 5.4);
  annotation (Documentation(info = "<html><body><p>Eltrombopag is a medicine used to raise low platelet counts in conditions such as immune thrombocytopenic purpura and aplastic anemia. It is an approved drug authorised in the European Union, where it is used for these platelet disorders.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q411588\">Wikidata Q411588</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>eltrombopag</td></tr><tr><td>ATC codes:</td><td>B02BX05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06210\">DB06210</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9846180\">9846180</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:85010\">85010</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q411588\">Q411588</a></td></tr><tr><td>formula:</td><td>C25H22N4O4</td></tr><tr><td>molar mass:</td><td>442.467 g/mol (knowledgebase (DrugBank calculated))</td></tr><tr><td>logP:</td><td>5.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Eltrombopag;
