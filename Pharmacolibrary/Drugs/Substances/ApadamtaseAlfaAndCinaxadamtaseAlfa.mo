  annotation (Documentation(info = "<html><body><p>Apadamtase alfa and cinaxadamtase alfa are enzyme replacement therapy medications used as antithrombotic enzymes affecting blood clotting. They are approved drugs, though their use appears limited and investigational in some settings.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q123807646&quot;>Wikidata Q123807646</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>apadamtase alfa and cinaxadamtase alfa</td></tr><tr><td>ATC codes:</td><td>B01AD13</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB15164&quot;>DB15164</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q123807646&quot;>Q123807646</a></td></tr></table></body></html>"));
