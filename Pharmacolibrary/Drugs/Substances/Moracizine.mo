  annotation (Documentation(info = "<html><body><p>Moracizine is a class I antiarrhythmic that was used to treat heart rhythm disorders, including ventricular arrhythmias. It is no longer available, having been withdrawn from the market.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q904071&quot;>Wikidata Q904071</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>moracizine</td></tr><tr><td>ATC codes:</td><td>C01BG01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00680&quot;>DB00680</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/34633&quot;>34633</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q904071&quot;>Q904071</a></td></tr><tr><td>formula:</td><td>C22H25N3O4S</td></tr><tr><td>molar mass:</td><td>427.519 g/mol (PubChem)</td></tr></table></body></html>"));
