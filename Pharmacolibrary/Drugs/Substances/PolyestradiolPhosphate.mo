  annotation (Documentation(info = "<html><body><p>Polyestradiol phosphate is an estrogen hormone therapy used as an anticancer treatment, mainly for prostate cancer. It is an approved medicine, but it is not widely used today and is available only in a limited number of countries.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7226308&quot;>Wikidata Q7226308</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>polyestradiol phosphate</td></tr><tr><td>ATC codes:</td><td>L02AA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09369&quot;>DB09369</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7226308&quot;>Q7226308</a></td></tr></table></body></html>"));
end PolyestradiolPhosphate;
