    logP = 2.1);
  annotation (Documentation(info = "<html><body><p>Mirabegron is a urological drug used to treat overactive bladder and related urination disorders such as neurogenic bladder. It is authorised in the European Union and is an approved, widely used treatment for urinary frequency and incontinence.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3702534\">Wikidata Q3702534</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>mirabegron</td></tr><tr><td>ATC codes:</td><td>G04BD12</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08893\">DB08893</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9865528\">9865528</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:65349\">65349</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3702534\">Q3702534</a></td></tr><tr><td>formula:</td><td>C21H24N4O2S</td></tr><tr><td>molar mass:</td><td>396.509 g/mol (PubChem CID 9865528)</td></tr><tr><td>logP:</td><td>2.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Mirabegron;
