  annotation (Documentation(info = "<html><body><p>Tabelecleucel is a cell therapy used to treat Epstein–Barr virus–related lymphoproliferative disorders. It is authorised in the European Union and remains under investigation for other uses.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>tabelecleucel</td></tr><tr><td>ATC codes:</td><td>L01XL09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB17072&quot;>DB17072</a></td></tr></table></body></html>"));
