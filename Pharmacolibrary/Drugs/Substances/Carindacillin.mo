  annotation (Documentation(info = "<html><body><p>Carindacillin is an antibiotic, a penicillin with extended spectrum, that was used to treat urinary tract infections and prostatitis. It has been withdrawn and is no longer used.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27123095&quot;>Wikidata Q27123095</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>carindacillin</td></tr><tr><td>ATC codes:</td><td>J01CA05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09319&quot;>DB09319</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/93184&quot;>93184</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:52015&quot;>52015</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27123095&quot;>Q27123095</a></td></tr><tr><td>formula:</td><td>C26H26N2O6S</td></tr><tr><td>molar mass:</td><td>494.562 g/mol (PubChem)</td></tr></table></body></html>"));
