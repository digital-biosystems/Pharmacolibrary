  annotation (Documentation(info = "<html><body><p>Maralixibat is a bile therapy drug used for liver-related conditions involving impaired bile flow. It is approved for human use and remains under investigation for further indications.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27291331\">Wikidata Q27291331</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>maralixibat chloride</td></tr><tr><td>ATC codes:</td><td>A05AX04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB16226\">DB16226</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9831643\">9831643</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27291331\">Q27291331</a></td></tr><tr><td>formula:</td><td>C40H56N3O4S+</td></tr><tr><td>molar mass:</td><td>674.965 g/mol (PubChem CID 9831643)</td></tr></table><p><small>Drugs.Common 25.09 gave 710.4 g/mol (+5.2 %); replaced by the value above</small></p></body></html>"));
