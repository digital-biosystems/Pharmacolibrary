  annotation (Documentation(info = "<html><body><p>Streptomycin is an aminoglycoside antibiotic used to treat infections such as tuberculosis, plague, tularemia, brucellosis, anthrax, and infective endocarditis. It remains an approved medicine and is on the WHO list of essential medicines, and it is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q192717&quot;>Wikidata Q192717</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>streptomycin</td></tr><tr><td>ATC codes:</td><td>A07AA04, J01GA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01082&quot;>DB01082</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/19649&quot;>19649</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:17076&quot;>17076</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q192717&quot;>Q192717</a></td></tr><tr><td>formula:</td><td>C21H39N7O12</td></tr><tr><td>molar mass:</td><td>581.58 g/mol (PubChem)</td></tr></table></body></html>"));
end Streptomycin;
