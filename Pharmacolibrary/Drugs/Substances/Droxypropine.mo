  annotation (Documentation(info = "<html><body><p>Droxypropine is a cough suppressant, classified under other cough suppressants for cough and cold preparations. It appears only as an experimental compound, with no evidence of approved or widespread use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5308700\">Wikidata Q5308700</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>droxypropine</td></tr><tr><td>ATC codes:</td><td>R05DB17</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13436\">DB13436</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/208903\">208903</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135979\">135979</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5308700\">Q5308700</a></td></tr><tr><td>formula:</td><td>C18H27NO3</td></tr><tr><td>molar mass:</td><td>305.418 g/mol (PubChem CID 208903)</td></tr><tr><td>logP:</td><td>1.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
