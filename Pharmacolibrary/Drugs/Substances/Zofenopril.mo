  annotation (Documentation(info = "<html><body><p>Zofenopril is an ACE inhibitor used to treat arterial hypertension and acute myocardial infarction. It is an approved medicine, though not authorised centrally in the European Union, and is used mainly in some European countries such as Italy.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q218284\">Wikidata Q218284</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>zofenopril</td></tr><tr><td>ATC codes:</td><td>C09AA15</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13166\">DB13166</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/92400\">92400</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:78539\">78539</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q218284\">Q218284</a></td></tr><tr><td>formula:</td><td>C22H23NO4S2</td></tr><tr><td>molar mass:</td><td>429.549 g/mol (PubChem CID 92400)</td></tr><tr><td>logP:</td><td>4.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
