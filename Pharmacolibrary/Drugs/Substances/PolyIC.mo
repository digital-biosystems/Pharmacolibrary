  annotation (Documentation(info = "<html><body><p>Poly I:C is a synthetic double-stranded RNA immunostimulant that has been investigated as an experimental anticancer and immune-stimulating therapy. It is not an approved medicine and remains investigational, with no marketing authorisation in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7226506&quot;>Wikidata Q7226506</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>poly I:C</td></tr><tr><td>ATC codes:</td><td>L03AX07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB16467&quot;>DB16467</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7226506&quot;>Q7226506</a></td></tr></table></body></html>"));
end PolyIC;
