  annotation (Documentation(info = "<html><body><p>Hydroxychloroquine is used to treat and prevent malaria and to manage autoimmune conditions such as systemic lupus erythematosus, rheumatoid arthritis, Sjögren's syndrome, and certain skin diseases. It is widely used and is included on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q421094&quot;>Wikidata Q421094</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>hydroxychloroquine</td></tr><tr><td>ATC codes:</td><td>P01BA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01611&quot;>DB01611</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3652&quot;>3652</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:5801&quot;>5801</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q421094&quot;>Q421094</a></td></tr><tr><td>formula:</td><td>C18H26ClN3O</td></tr><tr><td>molar mass:</td><td>335.876 g/mol (PubChem)</td></tr></table></body></html>"));
