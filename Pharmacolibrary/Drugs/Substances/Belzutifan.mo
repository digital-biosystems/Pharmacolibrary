  annotation (Documentation(info = "<html><body><p>Belzutifan is an anticancer medicine used to treat von Hippel-Lindau disease, including kidney cancer associated with it. It is authorised in the European Union and is also under investigation for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27456641\">Wikidata Q27456641</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>belzutifan</td></tr><tr><td>ATC codes:</td><td>L01XX74</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB15463\">DB15463</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/117947097\">117947097</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27456641\">Q27456641</a></td></tr><tr><td>formula:</td><td>C17H12F3NO4S</td></tr><tr><td>molar mass:</td><td>383.34 g/mol (PubChem CID 117947097)</td></tr><tr><td>logP:</td><td>2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
