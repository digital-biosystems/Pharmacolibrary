  annotation (Documentation(info = "<html><body><p>Alipogene tiparvovec (Glybera) is a gene therapy that was used to treat a rare inherited disorder causing very high blood fat levels, known as type I hyperlipoproteinemia.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5572516&quot;>Wikidata Q5572516</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>alipogene tiparvovec</td></tr><tr><td>ATC codes:</td><td>C10AX10</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13521&quot;>DB13521</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5572516&quot;>Q5572516</a></td></tr></table></body></html>"));
end AlipogeneTiparvovec;
