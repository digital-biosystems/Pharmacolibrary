  annotation (Documentation(info = "<html><body><p>Bromazine (bromodiphenhydramine) is an antihistamine used for conditions such as urticaria, motion sickness, anxiety, and insomnia. It is an approved first-generation antihistamine for systemic use, though it is not widely used today.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4926102\">Wikidata Q4926102</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bromazine</td></tr><tr><td>ATC codes:</td><td>R06AA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01237\">DB01237</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2444\">2444</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4926102\">Q4926102</a></td></tr><tr><td>formula:</td><td>C17H20BrNO</td></tr><tr><td>molar mass:</td><td>334.257 g/mol (PubChem CID 2444)</td></tr><tr><td>logP:</td><td>4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
