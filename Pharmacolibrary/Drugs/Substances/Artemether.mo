within Pharmacolibrary.Drugs.Substances;
package Artemether "artemether"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "artemether",
    atcCodes = {"P01BE02"},
    drugbankId = "DB06697",
    pubchemCid = "68911",
    chebiId = "195280",
    wikidataId = "Q416199",
