  annotation (Documentation(info = "<html><body><p>Adipiodone (iodipamide) is an iodinated, water-soluble X-ray contrast medium used to visualise the bile ducts and gallbladder. It has been withdrawn and is no longer in clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4682934&quot;>Wikidata Q4682934</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>adipiodone</td></tr><tr><td>ATC codes:</td><td>V08AC04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB04711&quot;>DB04711</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3739&quot;>3739</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4682934&quot;>Q4682934</a></td></tr><tr><td>formula:</td><td>C20H14I6N2O6</td></tr><tr><td>molar mass:</td><td>1139.74 g/mol (PubChem)</td></tr></table></body></html>"));
