within Pharmacolibrary.Drugs.Substances;
package Ipecacuanha "ipecacuanha"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "ipecacuanha",
    atcCodes = {"R05CA04", "V03AB01"},
    drugbankId = "DB13293",
    wikidataId = "Q2755412");
  annotation (Documentation(info = "<html><body><p>Ipecacuanha syrup was used as an expectorant for coughs in low doses and, at higher doses, to induce vomiting, for example after poisoning. It is no longer recommended and has been withdrawn from routine use, mainly because inducing vomiting after poisoning fell out of favour.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2755412&quot;>Wikidata Q2755412</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ipecacuanha</td></tr><tr><td>ATC codes:</td><td>R05CA04, V03AB01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13293&quot;>DB13293</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2755412&quot;>Q2755412</a></td></tr></table></body></html>"));
end Ipecacuanha;
