within Pharmacolibrary.Drugs.Substances;
package Ipecacuanha "ipecacuanha"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "ipecacuanha",
    atcCodes = {"R05CA04", "V03AB01"},
    drugbankId = "DB13293",
    wikidataId = "Q17044588");
  annotation (Documentation(info = "<html><body><p>Ipecacuanha (ipecac syrup) was used as an expectorant for coughs and, more notably, as an antidote to induce vomiting after poisoning. It is no longer used in routine medical practice, having been withdrawn from use as its benefits in poisoning were questioned and safer alternatives became preferred.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q17044588\">Wikidata Q17044588</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ipecacuanha</td></tr><tr><td>ATC codes:</td><td>R05CA04, V03AB01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13293\">DB13293</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q17044588\">Q17044588</a></td></tr></table></body></html>"));
end Ipecacuanha;
