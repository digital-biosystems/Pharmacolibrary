  annotation (Documentation(info = "<html><body><p>Quinbolone is an anabolic steroid of the androstan derivative class, developed as an anabolic agent for systemic use. It is regarded as an experimental compound and is not an established marketed medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7272085\">Wikidata Q7272085</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>quinbolone</td></tr><tr><td>ATC codes:</td><td>A14AA06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13484\">DB13484</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/10360683\">10360683</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135488\">135488</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7272085\">Q7272085</a></td></tr><tr><td>formula:</td><td>C24H32O2</td></tr><tr><td>molar mass:</td><td>352.518 g/mol (PubChem CID 10360683)</td></tr><tr><td>logP:</td><td>5.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
