within Pharmacolibrary.Drugs.Substances;
package Fenfluramine "fenfluramine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "fenfluramine",
    atcCodes = {"A08AA02", "N03AX26"},
    drugbankId = "DB00574",
    pubchemCid = "3337",
    chebiId = "5000",
    wikidataId = "Q418928",
    formula = "C12H16F3N",
    M = 0.231261,
    logP = 3.4);
  annotation (Documentation(info = "<html><body><p>Fenfluramine is a serotonergic medicine that was once used as a centrally acting antiobesity drug and is now used as an antiepileptic for certain epilepsies. Its antiobesity use was withdrawn because it caused heart valve damage, but it remains authorised in the European Union for epilepsy, with use restricted to specialist care.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q418928&quot;>Wikidata Q418928</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>fenfluramine</td></tr><tr><td>ATC codes:</td><td>A08AA02, N03AX26</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00574&quot;>DB00574</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3337&quot;>3337</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:5000&quot;>5000</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q418928&quot;>Q418928</a></td></tr><tr><td>formula:</td><td>C12H16F3N</td></tr><tr><td>molar mass:</td><td>231.261 g/mol (PubChem)</td></tr></table></body></html>"));
end Fenfluramine;
