  annotation (Documentation(info = "<html><body><p>Paromomycin is an antibiotic used to treat intestinal infections such as amebiasis and cryptosporidiosis. It is an approved medicine and appears on the WHO list of essential medicines, used mainly as an intestinal antiinfective.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q415625\">Wikidata Q415625</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>paromomycin</td></tr><tr><td>ATC codes:</td><td>A07AA06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01421\">DB01421</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/165580\">165580</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7934\">7934</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q415625\">Q415625</a></td></tr><tr><td>formula:</td><td>C23H45N5O14</td></tr><tr><td>molar mass:</td><td>615.634 g/mol (PubChem CID 165580)</td></tr><tr><td>logP:</td><td>-8.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
