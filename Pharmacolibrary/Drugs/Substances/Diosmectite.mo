    M = 0.36031);
  annotation (Documentation(info = "<html><body><p>Diosmectite, a natural aluminium–magnesium silicate, is an intestinal adsorbent used against several gastrointestinal diseases, notably diarrhoea. It is not an approved medicine in major databases and is currently classed as investigational, though it remains available in some countries as an antidiarrhoeal.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4162027\">Wikidata Q4162027</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>diosmectite</td></tr><tr><td>ATC codes:</td><td>A07BC05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13654\">DB13654</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4162027\">Q4162027</a></td></tr><tr><td>molar mass:</td><td>360.31 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Diosmectite;
