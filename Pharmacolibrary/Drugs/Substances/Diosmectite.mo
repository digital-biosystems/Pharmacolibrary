  annotation (Documentation(info = "<html><body><p>Diosmectite (smectite, a montmorillonite clay mineral) is an intestinal adsorbent used as an antidiarrheal agent. It is listed as investigational in DrugBank and has no EMA authorisation, so it is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q422131&quot;>Wikidata Q422131</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>diosmectite</td></tr><tr><td>ATC codes:</td><td>A07BC05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13654&quot;>DB13654</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q422131&quot;>Q422131</a></td></tr><tr><td>molar mass:</td><td>360.31 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Diosmectite;
