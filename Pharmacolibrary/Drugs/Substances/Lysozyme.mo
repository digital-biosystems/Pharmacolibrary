  annotation (Documentation(info = "<html><body><p>Lysozyme is an enzyme classified in ATC as a topical and systemic antiviral, but it is considered investigational rather than an established medicine. It is not an approved drug; no marketing authorisation is listed, so it remains in the investigational stage.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q72487897\">Wikidata Q72487897</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>lysozyme</td></tr><tr><td>ATC codes:</td><td>D06BB07, J05AX02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13260\">DB13260</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q72487897\">Q72487897</a></td></tr><tr><td>molar mass:</td><td>2235.6 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>-7.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Lysozyme;
