  annotation (Documentation(info = "<html><body><p>Lysozyme is an enzyme classified in ATC as a topical and systemic antiviral, but it is considered investigational rather than an established medicine. It is not an approved drug; no marketing authorisation is listed, so it remains in the investigational stage.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q72487897&quot;>Wikidata Q72487897</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>lysozyme</td></tr><tr><td>ATC codes:</td><td>D06BB07, J05AX02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13260&quot;>DB13260</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/91976556&quot;>91976556</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q72487897&quot;>Q72487897</a></td></tr><tr><td>formula:</td><td>C99H159N37O23</td></tr><tr><td>molar mass:</td><td>2235.6 g/mol (PubChem)</td></tr></table></body></html>"));
end Lysozyme;
