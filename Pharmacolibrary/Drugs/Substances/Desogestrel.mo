  annotation (Documentation(info = "<html><body><p>Desogestrel is a synthetic progestogen used in hormonal contraceptives, and has also been used for conditions such as acne and endometriosis. It is an approved medicine, available in fixed-combination, sequential, and progestogen-only contraceptive products, and is widely used for birth control.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q415304\">Wikidata Q415304</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>desogestrel</td></tr><tr><td>ATC codes:</td><td>G03AC09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00304\">DB00304</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/40973\">40973</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4453\">4453</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q415304\">Q415304</a></td></tr><tr><td>formula:</td><td>C22H30O</td></tr><tr><td>molar mass:</td><td>310.481 g/mol (PubChem CID 40973)</td></tr><tr><td>logP:</td><td>4.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
