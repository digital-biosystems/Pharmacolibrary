  annotation (Documentation(info = "<html><body><p>Bretylium tosilate is a class III antiarrhythmic used to treat ventricular fibrillation and heart conduction disease. It is an approved drug, though it is no longer widely used in many countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q420026\">Wikidata Q420026</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bretylium tosilate</td></tr><tr><td>ATC codes:</td><td>C01BD02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01158\">DB01158</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2431\">2431</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3172\">3172</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q420026\">Q420026</a></td></tr><tr><td>formula:</td><td>C11H17BrN+</td></tr><tr><td>molar mass:</td><td>243.168 g/mol (PubChem CID 2431)</td></tr></table><p><small>Drugs.Common 25.09 gave 414.4 g/mol (+70.4 %); replaced by the value above</small></p></body></html>"));
