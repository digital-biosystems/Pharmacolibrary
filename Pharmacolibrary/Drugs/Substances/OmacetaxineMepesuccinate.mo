  annotation (Documentation(info = "<html><body><p>Omacetaxine mepesuccinate is an antineoplastic agent used in cancer treatment. It is approved but not authorised in the European Union, and its use appears limited, with some investigational and withdrawn status records.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7089373\">Wikidata Q7089373</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>omacetaxine mepesuccinate</td></tr><tr><td>ATC codes:</td><td>L01XX40</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB04865\">DB04865</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/285033\">285033</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:71019\">71019</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7089373\">Q7089373</a></td></tr><tr><td>formula:</td><td>C29H39NO9</td></tr><tr><td>molar mass:</td><td>545.629 g/mol (PubChem CID 285033)</td></tr><tr><td>logP:</td><td>0.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
