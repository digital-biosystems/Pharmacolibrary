  annotation (Documentation(info = "<html><body><p>Efaproxiral is an investigational drug studied as a radiosensitizer to enhance cancer radiation therapy, and it has also been explored as an antisickling agent. It has never reached approved, widespread use and remains investigational.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5347186\">Wikidata Q5347186</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>efaproxiral</td></tr><tr><td>ATC codes:</td><td>L01XD06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08486\">DB08486</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/122335\">122335</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5347186\">Q5347186</a></td></tr><tr><td>formula:</td><td>C20H23NO4</td></tr><tr><td>molar mass:</td><td>341.407 g/mol (PubChem CID 122335)</td></tr><tr><td>logP:</td><td>3.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
