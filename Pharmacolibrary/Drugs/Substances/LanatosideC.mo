  annotation (Documentation(info = "<html><body><p>Lanatoside C is a cardiac glycoside, a class of drugs used for heart conditions such as heart failure and certain rhythm disturbances. It is considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6482953&quot;>Wikidata Q6482953</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>lanatoside C</td></tr><tr><td>ATC codes:</td><td>C01AA06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13467&quot;>DB13467</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6482953&quot;>Q6482953</a></td></tr><tr><td>formula:</td><td>C49H76O20</td></tr><tr><td>molar mass:</td><td>985.127 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
