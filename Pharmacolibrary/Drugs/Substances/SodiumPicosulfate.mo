  annotation (Documentation(info = "<html><body><p>Sodium picosulfate is a contact laxative used to treat constipation. It is an approved medicine, available in various countries, though not authorised centrally in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q410265\">Wikidata Q410265</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sodium picosulfate</td></tr><tr><td>ATC codes:</td><td>A06AB08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09268\">DB09268</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5243\">5243</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q410265\">Q410265</a></td></tr><tr><td>formula:</td><td>C18H15NO8S2</td></tr><tr><td>molar mass:</td><td>437.437 g/mol (PubChem CID 5243)</td></tr></table><p><small>Drugs.Common 25.09 gave 481.4 g/mol (+10.1 %); replaced by the value above</small></p></body></html>"));
