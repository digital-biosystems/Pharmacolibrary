  annotation (Documentation(info = "<html><body><p>Acefylline piperazine is a xanthine derivative that has been used for breathing problems such as asthma, bronchitis, pulmonary emphysema, and bronchospasm. It is classified as experimental and does not appear to be an approved medicine today, so its current use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4673059\">Wikidata Q4673059</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>acefylline piperazine</td></tr><tr><td>ATC codes:</td><td>R03DA09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13573\">DB13573</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:94615\">94615</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4673059\">Q4673059</a></td></tr><tr><td>formula:</td><td>C9H10N4O4</td></tr><tr><td>molar mass:</td><td>238.203 g/mol (knowledgebase (DrugBank calculated))</td></tr></table><p><small>Drugs.Common 25.09 gave 2508.6 g/mol (+953.1 %); replaced by the value above</small></p></body></html>"));
