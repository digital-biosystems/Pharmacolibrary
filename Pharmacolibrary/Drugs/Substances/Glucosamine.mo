  annotation (Documentation(info = "<html><body><p>Glucosamine is used to treat osteoarthritis. It is an approved antiinflammatory and antirheumatic agent, classified among other non-steroidal agents for the musculo-skeletal system, and is widely available as a supplement and medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q327506&quot;>Wikidata Q327506</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>glucosamine</td></tr><tr><td>ATC codes:</td><td>M01AX05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01296&quot;>DB01296</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/439213&quot;>439213</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:47977&quot;>47977</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q327506&quot;>Q327506</a></td></tr><tr><td>formula:</td><td>C6H13NO5</td></tr><tr><td>molar mass:</td><td>179.172 g/mol (PubChem)</td></tr></table></body></html>"));
