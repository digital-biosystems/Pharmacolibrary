  annotation (Documentation(info = "<html><body><p>Ritonavir is an antiviral protease inhibitor used to treat HIV infection and, in combination, hepatitis C. It is widely used, is included on the WHO essential medicines list, and is authorised in the European Union for HIV infections.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q422618\">Wikidata Q422618</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>ritonavir</td></tr><tr><td>ATC codes:</td><td>J05AE03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00503\">DB00503</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/392622\">392622</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:45409\">45409</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q422618\">Q422618</a></td></tr><tr><td>formula:</td><td>C37H48N6O5S2</td></tr><tr><td>molar mass:</td><td>720.948 g/mol (PubChem CID 392622)</td></tr><tr><td>logP:</td><td>6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
