  annotation (Documentation(info = "<html><body><p>Estrone is a natural estrogen used for menopausal and postmenopausal disorders and has been used in endometrial carcinoma. It is an approved drug, classified among natural and semisynthetic estrogens.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q414986\">Wikidata Q414986</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>estrone</td></tr><tr><td>ATC codes:</td><td>G03CA07, G03CC04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00655\">DB00655</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5870\">5870</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:17263\">17263</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q414986\">Q414986</a></td></tr><tr><td>formula:</td><td>C18H22O2</td></tr><tr><td>molar mass:</td><td>270.372 g/mol (PubChem CID 5870)</td></tr><tr><td>logP:</td><td>3.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
