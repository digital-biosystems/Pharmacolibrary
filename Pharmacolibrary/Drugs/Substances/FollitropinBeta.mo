  annotation (Documentation(info = "<html><body><p>Follitropin beta is a follicle-stimulating hormone medicine used to treat infertility. It is an approved gonadotropin, used in fertility care, and has also been investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q78151521\">Wikidata Q78151521</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>follitropin beta</td></tr><tr><td>ATC codes:</td><td>G03GA06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00066\">DB00066</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q78151521\">Q78151521</a></td></tr><tr><td>molar mass:</td><td>22672.9 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
