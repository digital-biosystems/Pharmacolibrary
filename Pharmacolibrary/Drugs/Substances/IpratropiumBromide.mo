  annotation (Documentation(info = "<html><body><p>Ipratropium bromide is an inhaled anticholinergic medicine used to treat obstructive airway diseases such as COPD, and is also given as a nasal preparation. It is an approved medicine, appears on the WHO list of essential medicines, and is widely used, including in combination inhalers with adrenergic drugs.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q424294&quot;>Wikidata Q424294</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ipratropium bromide</td></tr><tr><td>ATC codes:</td><td>R01AX03, R03BB01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00332&quot;>DB00332</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/657308&quot;>657308</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:46659&quot;>46659</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q424294&quot;>Q424294</a></td></tr><tr><td>formula:</td><td>C20H30BrNO3</td></tr><tr><td>molar mass:</td><td>412.368 g/mol (PubChem)</td></tr></table></body></html>"));
