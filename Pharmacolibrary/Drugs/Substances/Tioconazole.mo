  annotation (Documentation(info = "<html><body><p>Tioconazole is an antifungal drug used to treat fungal skin infections and vulvovaginal candidiasis. It is an approved medicine, applied topically to the skin or vagina.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q260326&quot;>Wikidata Q260326</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tioconazole</td></tr><tr><td>ATC codes:</td><td>D01AC07, G01AF08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01007&quot;>DB01007</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5482&quot;>5482</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:77898&quot;>77898</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q260326&quot;>Q260326</a></td></tr><tr><td>formula:</td><td>C16H13Cl3N2OS</td></tr><tr><td>molar mass:</td><td>387.703 g/mol (PubChem)</td></tr></table></body></html>"));
end Tioconazole;
