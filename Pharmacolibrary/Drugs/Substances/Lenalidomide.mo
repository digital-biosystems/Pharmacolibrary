within Pharmacolibrary.Drugs.Substances;
package Lenalidomide "lenalidomide"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "lenalidomide",
    atcCodes = {"L04AX04"},
    drugbankId = "DB00480",
    pubchemCid = "216326",
    chebiId = "63791",
    wikidataId = "Q425681",
    formula = "C13H13N3O3",
    M = 0.259265,
    logP = -0.5);
  annotation (Documentation(info = "<html><body><p>Lenalidomide is an immunomodulating and anti-angiogenic drug used to treat blood cancers and related disorders, including multiple myeloma, myelodysplastic syndromes, and several types of lymphoma and leukemia. It is approved and widely used, with several authorised products in the European Union, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q425681\">Wikidata Q425681</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>lenalidomide</td></tr><tr><td>ATC codes:</td><td>L04AX04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00480\">DB00480</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/216326\">216326</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:63791\">63791</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q425681\">Q425681</a></td></tr><tr><td>formula:</td><td>C13H13N3O3</td></tr><tr><td>molar mass:</td><td>259.265 g/mol (PubChem CID 216326)</td></tr><tr><td>logP:</td><td>-0.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Lenalidomide;
