  annotation (Documentation(info = "<html><body><p>Lonapegsomatropin is a long-acting growth hormone preparation used to treat growth disorders in children. It is approved and authorised in the European Union for growth and development indications.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q108291908\">Wikidata Q108291908</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>lonapegsomatropin</td></tr><tr><td>ATC codes:</td><td>H01AC09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB16220\">DB16220</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q108291908\">Q108291908</a></td></tr><tr><td>molar mass:</td><td>63000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
