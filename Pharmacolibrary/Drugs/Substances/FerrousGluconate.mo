    logP = 0);
  annotation (Documentation(info = "<html><body><p>Ferrous gluconate is an oral iron preparation used to treat iron deficiency anaemia, and is also available combined with folic acid. It is an approved medicine that is widely used as a dietary iron supplement.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q72478236&quot;>Wikidata Q72478236</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ferrous gluconate</td></tr><tr><td>ATC codes:</td><td>B03AA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB14488&quot;>DB14488</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/9291&quot;>9291</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q72478236&quot;>Q72478236</a></td></tr><tr><td>formula:</td><td>C12H24FeO14</td></tr><tr><td>molar mass:</td><td>448.155 g/mol (PubChem)</td></tr></table></body></html>"));
end FerrousGluconate;
