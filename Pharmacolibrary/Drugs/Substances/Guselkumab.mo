  annotation (Documentation(info = "<html><body><p>Guselkumab is a monoclonal antibody that acts as an interleukin inhibitor, belonging to the immunosuppressant class of medicines. It is an approved medicine and has also been investigated for further uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q15708315\">Wikidata Q15708315</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>guselkumab</td></tr><tr><td>ATC codes:</td><td>L04AC16</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11834\">DB11834</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q15708315\">Q15708315</a></td></tr><tr><td>molar mass:</td><td>143.6 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
