  annotation (Documentation(info = "<html><body><p>Tilorone is an experimental compound studied as an antiviral and interferon-inducing agent, with additional anti-inflammatory and antineoplastic roles. It is not an approved medicine and remains experimental, with no authorisation in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2028068\">Wikidata Q2028068</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tilorone</td></tr><tr><td>ATC codes:</td><td>J05AX19</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB17965\">DB17965</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5475\">5475</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:147347\">147347</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2028068\">Q2028068</a></td></tr><tr><td>formula:</td><td>C25H34N2O3</td></tr><tr><td>molar mass:</td><td>410.558 g/mol (PubChem CID 5475)</td></tr><tr><td>logP:</td><td>4.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
