    logP = 0.4);
  annotation (Documentation(info = "<html><body><p>Acetylcysteine is a mucolytic used for respiratory conditions with thick mucus such as bronchitis, pneumonia, cystic fibrosis and bronchiectasis, and as an antidote for paracetamol toxicity. It is widely used, appears on the WHO list of essential medicines, and is also approved for some investigational uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q375613&quot;>Wikidata Q375613</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>acetylcysteine</td></tr><tr><td>ATC codes:</td><td>R05CB01, S01XA08, V03AB23</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06151&quot;>DB06151</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/12035&quot;>12035</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:28939&quot;>28939</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q375613&quot;>Q375613</a></td></tr><tr><td>formula:</td><td>C5H9NO3S</td></tr><tr><td>molar mass:</td><td>163.191 g/mol (PubChem)</td></tr></table></body></html>"));
end Acetylcysteine;
