  annotation (Documentation(info = "<html><body><p>Fluvastatin is a statin used to treat high cholesterol and related lipid disorders, including hypercholesterolemia, atherosclerosis, and coronary artery disease. It is an approved medicine and remains in use for lowering blood lipids.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q417942\">Wikidata Q417942</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>fluvastatin</td></tr><tr><td>ATC codes:</td><td>C10AA04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01095\">DB01095</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/1548972\">1548972</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:38562\">38562</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q417942\">Q417942</a></td></tr><tr><td>formula:</td><td>C24H26FNO4</td></tr><tr><td>molar mass:</td><td>411.473 g/mol (PubChem CID 1548972)</td></tr><tr><td>logP:</td><td>3.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
