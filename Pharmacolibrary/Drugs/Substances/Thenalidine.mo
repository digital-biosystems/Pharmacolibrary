    logP = 3.8);
  annotation (Documentation(info = "<html><body><p>Thenalidine is an antihistamine that was used, both by mouth and on the skin, to treat allergic conditions such as itching. It has been withdrawn from the market because of serious blood side effects, and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6578796\">Wikidata Q6578796</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>thenalidine</td></tr><tr><td>ATC codes:</td><td>D04AA03, R06AX03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB04826\">DB04826</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/27901\">27901</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135187\">135187</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6578796\">Q6578796</a></td></tr><tr><td>formula:</td><td>C17H22N2S</td></tr><tr><td>molar mass:</td><td>286.437 g/mol (PubChem CID 27901)</td></tr><tr><td>logP:</td><td>3.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Thenalidine;
