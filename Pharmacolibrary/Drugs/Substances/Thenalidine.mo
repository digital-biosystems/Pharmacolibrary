within Pharmacolibrary.Drugs.Substances;
package Thenalidine "thenalidine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "thenalidine",
    atcCodes = {"D04AA03", "R06AX03"},
    drugbankId = "DB04826",
    pubchemCid = "27901",
    chebiId = "135187",
    wikidataId = "Q6578796",
    formula = "C17H22N2S",
