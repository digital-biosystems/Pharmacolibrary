  annotation (Documentation(info = "<html><body><p>Fludiazepam is a benzodiazepine derivative with anxiolytic, anticonvulsant, and muscle-relaxant effects, developed for conditions such as anxiety. It is not an approved medicine; it is considered investigational and has appeared as an illicit substance, so it is not in routine medical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3486981\">Wikidata Q3486981</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>fludiazepam</td></tr><tr><td>ATC codes:</td><td>N05BA17</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01567\">DB01567</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3369\">3369</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31618\">31618</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3486981\">Q3486981</a></td></tr><tr><td>formula:</td><td>C16H12ClFN2O</td></tr><tr><td>molar mass:</td><td>302.733 g/mol (PubChem CID 3369)</td></tr><tr><td>logP:</td><td>2.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
