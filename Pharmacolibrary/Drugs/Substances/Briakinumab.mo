  annotation (Documentation(info = "<html><body><p>Briakinumab, a monoclonal antibody that blocks interleukin signalling, was investigated as a treatment for psoriasis. It was never marketed; the marketing application in the European Union was withdrawn, and it remains an investigational drug.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3644426\">Wikidata Q3644426</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>briakinumab</td></tr><tr><td>ATC codes:</td><td>L04AC09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB05459\">DB05459</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3644426\">Q3644426</a></td></tr><tr><td>molar mass:</td><td>146500 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Briakinumab;
