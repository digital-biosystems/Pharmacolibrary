  annotation (Documentation(info = "<html><body><p>Bromperidol is a butyrophenone antipsychotic used to treat psychotic disorders such as schizophrenia. It was approved at one time but has been withdrawn and is no longer in general use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4973749\">Wikidata Q4973749</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bromperidol</td></tr><tr><td>ATC codes:</td><td>N05AD06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12401\">DB12401</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2448\">2448</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31305\">31305</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4973749\">Q4973749</a></td></tr><tr><td>formula:</td><td>C21H23BrFNO2</td></tr><tr><td>molar mass:</td><td>420.322 g/mol (PubChem CID 2448)</td></tr><tr><td>logP:</td><td>3.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
