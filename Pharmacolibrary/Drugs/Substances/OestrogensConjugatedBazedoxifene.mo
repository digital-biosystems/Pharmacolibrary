within Pharmacolibrary.Drugs.Substances;
package OestrogensConjugatedBazedoxifene "oestrogens conjugated;bazedoxifene"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "oestrogens conjugated;bazedoxifene",
    atcCodes = fill("", 0),
    drugbankId = "DB00286",
    chebiId = "8389",
    wikidataId = "Q4118295");
  annotation (Documentation(info = "<html><body><p>This combination of conjugated estrogens with bazedoxifene is a hormone therapy used to treat menopausal symptoms such as hot flushes and to help prevent bone loss after menopause. It is an approved medicine used in some countries, mainly the United States, for postmenopausal women, and carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4118295\">Wikidata Q4118295</a>; not checked by a person.</small></p><table><tr><td>name:</td><td>oestrogens conjugated;bazedoxifene</td></tr><tr><td>ATC codes:</td><td>—</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00286\">DB00286</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8389\">8389</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4118295\">Q4118295</a></td></tr></table></body></html>"));
end OestrogensConjugatedBazedoxifene;
