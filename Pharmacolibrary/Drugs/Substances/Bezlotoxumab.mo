  annotation (Documentation(info = "<html><body><p>Bezlotoxumab, a monoclonal antibody, is used to help prevent recurrence of Clostridioides difficile infection (pseudomembranous enterocolitis). It is approved and authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4900370&quot;>Wikidata Q4900370</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>bezlotoxumab</td></tr><tr><td>ATC codes:</td><td>J06BB21, J06BC03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13140&quot;>DB13140</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4900370&quot;>Q4900370</a></td></tr><tr><td>molar mass:</td><td>148200 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Bezlotoxumab;
