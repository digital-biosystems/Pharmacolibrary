  annotation (Documentation(info = "<html><body><p>Pozelimab is a monoclonal antibody that acts as a complement inhibitor, developed as an immunosuppressant medication. It has been approved and is also being studied in clinical trials; it is not an established widely used therapy.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q121708361\">Wikidata Q121708361</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pozelimab</td></tr><tr><td>ATC codes:</td><td>L04AJ11</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB15218\">DB15218</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q121708361\">Q121708361</a></td></tr></table></body></html>"));
end Pozelimab;
