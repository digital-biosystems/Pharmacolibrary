  annotation (Documentation(info = "<html><body><p>Dipivefrine is an eye drop prodrug of adrenaline used to treat glaucoma, open-angle glaucoma, and ocular hypertension. It was approved but has been withdrawn from the market and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q905952\">Wikidata Q905952</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dipivefrine</td></tr><tr><td>ATC codes:</td><td>S01EA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00449\">DB00449</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3105\">3105</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4646\">4646</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q905952\">Q905952</a></td></tr><tr><td>formula:</td><td>C19H29NO5</td></tr><tr><td>molar mass:</td><td>351.443 g/mol (PubChem CID 3105)</td></tr><tr><td>logP:</td><td>2.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Dipivefrine;
