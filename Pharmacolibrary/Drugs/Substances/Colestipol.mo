within Pharmacolibrary.Drugs.Substances;
package Colestipol "colestipol"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "colestipol",
    atcCodes = {"C10AC02"},
    drugbankId = "DB00375",
    pubchemCid = "62816",
    wikidataId = "Q3294635",
    formula = "C11H28ClN5O",
    M = 0.281829);
  annotation (Documentation(info = "<html><body><p>Colestipol is a bile acid sequestrant used to lower blood lipids in conditions such as hyperlipidemia, arteriosclerosis, and coronary artery disease, and it has also been used to bind toxins in pseudomembranous colitis. It remains an approved lipid-lowering medicine, used mainly for high cholesterol and related cardiovascular conditions.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3294635\">Wikidata Q3294635</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>colestipol</td></tr><tr><td>ATC codes:</td><td>C10AC02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00375\">DB00375</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/62816\">62816</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3294635\">Q3294635</a></td></tr><tr><td>formula:</td><td>C11H28ClN5O</td></tr><tr><td>molar mass:</td><td>281.829 g/mol (PubChem CID 62816)</td></tr></table></body></html>"));
end Colestipol;
