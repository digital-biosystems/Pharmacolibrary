  annotation (Documentation(info = "<html><body><p>Paramethasone is a glucocorticoid with anti-inflammatory effects, used as a systemic corticosteroid for inflammatory conditions. It is classified as experimental and does not appear to be an approved medicine today, so its current availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7135218\">Wikidata Q7135218</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>paramethasone</td></tr><tr><td>ATC codes:</td><td>H02AB05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01384\">DB01384</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5875\">5875</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7922\">7922</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7135218\">Q7135218</a></td></tr><tr><td>formula:</td><td>C22H29FO5</td></tr><tr><td>molar mass:</td><td>392.467 g/mol (PubChem CID 5875)</td></tr><tr><td>logP:</td><td>2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
