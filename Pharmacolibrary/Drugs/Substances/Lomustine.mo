  annotation (Documentation(info = "<html><body><p>Lomustine is an alkylating anticancer drug used to treat cancers such as brain cancer, Hodgkin lymphoma, melanoma, and kidney cancer. It is an approved medicine, but carries a boxed warning, so its use requires careful risk management.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q415378&quot;>Wikidata Q415378</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>lomustine</td></tr><tr><td>ATC codes:</td><td>L01AD02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01206&quot;>DB01206</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3950&quot;>3950</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6520&quot;>6520</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q415378&quot;>Q415378</a></td></tr><tr><td>formula:</td><td>C9H16ClN3O2</td></tr><tr><td>molar mass:</td><td>233.696 g/mol (PubChem)</td></tr></table></body></html>"));
