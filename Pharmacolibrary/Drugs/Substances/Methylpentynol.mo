    logP = 0.8);
  annotation (Documentation(info = "<html><body><p>Methylpentynol (meparfynol) is a sedative compound classified among other hypnotics and sedatives, historically used for its calming and sleep-inducing effects. It is currently listed only as an experimental drug, with no authorised marketing records, so it appears to be no longer in routine clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q412090&quot;>Wikidata Q412090</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>methylpentynol</td></tr><tr><td>ATC codes:</td><td>N05CM15</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13733&quot;>DB13733</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6494&quot;>6494</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134752&quot;>134752</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q412090&quot;>Q412090</a></td></tr><tr><td>formula:</td><td>C6H10O</td></tr><tr><td>molar mass:</td><td>98.145 g/mol (PubChem)</td></tr></table></body></html>"));
