  annotation (Documentation(info = "<html><body><p>Glycerol phenylbutyrate is used to treat inherited urea cycle disorders. It is an authorised medicine in the European Union and is also being investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q15322709\">Wikidata Q15322709</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>glycerol phenylbutyrate</td></tr><tr><td>ATC codes:</td><td>A16AX09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08909\">DB08909</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/10482134\">10482134</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134745\">134745</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q15322709\">Q15322709</a></td></tr><tr><td>formula:</td><td>C33H38O6</td></tr><tr><td>molar mass:</td><td>530.661 g/mol (PubChem CID 10482134)</td></tr><tr><td>logP:</td><td>6.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
