  annotation (Documentation(info = "<html><body><p>Zinc chloride is a zinc compound used as an additive in electrolyte solutions given intravenously, and has also been used as a mouthwash and for the common cold. It is an approved ingredient used in various preparations, mainly as a solution additive rather than a standalone medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q204714\">Wikidata Q204714</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>zinc chloride</td></tr><tr><td>ATC codes:</td><td>B05XA12</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB14533\">DB14533</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:49976\">49976</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q204714\">Q204714</a></td></tr><tr><td>formula:</td><td>Cl2Zn</td></tr><tr><td>molar mass:</td><td>136.315 g/mol (knowledgebase (DrugBank calculated))</td></tr></table></body></html>"));
end ZincChloride;
