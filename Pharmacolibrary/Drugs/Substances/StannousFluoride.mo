  annotation (Documentation(info = "<html><body><p>Stannous fluoride is a stomatological preparation used to prevent tooth decay and has been used for periodontal disease. It is an approved ingredient, widely used in dental care products such as toothpastes.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q204962&quot;>Wikidata Q204962</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>stannous fluoride</td></tr><tr><td>ATC codes:</td><td>A01AA04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11092&quot;>DB11092</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/24550&quot;>24550</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135933&quot;>135933</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q204962&quot;>Q204962</a></td></tr><tr><td>formula:</td><td>F2Sn</td></tr><tr><td>molar mass:</td><td>156.706 g/mol (PubChem)</td></tr></table></body></html>"));
