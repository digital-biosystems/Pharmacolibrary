  annotation (Documentation(info = "<html><body><p>Phloroglucinol is classified as a drug for functional gastrointestinal disorders, where it has been used as an antispasmodic to relieve spasmodic pain. It is considered investigational, so it is not an established, widely approved medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q899008&quot;>Wikidata Q899008</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>phloroglucinol</td></tr><tr><td>ATC codes:</td><td>A03AX12</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12944&quot;>DB12944</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/359&quot;>359</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:16204&quot;>16204</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q899008&quot;>Q899008</a></td></tr><tr><td>formula:</td><td>C6H6O3</td></tr><tr><td>molar mass:</td><td>126.111 g/mol (PubChem)</td></tr></table></body></html>"));
