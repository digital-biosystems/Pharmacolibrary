    logP = 2.5);
  annotation (Documentation(info = "<html><body><p>Paclitaxel is a taxane chemotherapy drug used to treat several cancers, including breast, ovarian, lung, and pancreatic cancer, melanoma, and Kaposi's sarcoma. It is widely used worldwide, is included on the WHO essential medicines list, and several paclitaxel products are authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q423762&quot;>Wikidata Q423762</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>paclitaxel</td></tr><tr><td>ATC codes:</td><td>L01CD01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01229&quot;>DB01229</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/36314&quot;>36314</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:45863&quot;>45863</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q423762&quot;>Q423762</a></td></tr><tr><td>formula:</td><td>C47H51NO14</td></tr><tr><td>molar mass:</td><td>853.918 g/mol (PubChem)</td></tr></table></body></html>"));
