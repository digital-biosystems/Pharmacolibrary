within Pharmacolibrary.Drugs.Substances;
package Dantrolene "dantrolene"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "dantrolene",
    atcCodes = {"M03CA01"},
    drugbankId = "DB01219",
    pubchemCid = "6914273",
    chebiId = "4317",
    wikidataId = "Q421274",
    formula = "C14H10N4O5",
    M = 0.314257,
    logP = 1.7);
  annotation (Documentation(info = "<html><body><p>Dantrolene is a muscle relaxant used to treat spasticity from conditions such as multiple sclerosis, spinal cord injury, or stroke, and is also used for malignant hyperthermia and neuroleptic malignant syndrome. It is an approved medicine and remains in clinical use, with some uses still investigational.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q421274\">Wikidata Q421274</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dantrolene</td></tr><tr><td>ATC codes:</td><td>M03CA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01219\">DB01219</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6914273\">6914273</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4317\">4317</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q421274\">Q421274</a></td></tr><tr><td>formula:</td><td>C14H10N4O5</td></tr><tr><td>molar mass:</td><td>314.257 g/mol (PubChem CID 6914273)</td></tr><tr><td>logP:</td><td>1.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Dantrolene;
