  annotation (Documentation(info = "<html><body><p>Dantrolene is a directly acting muscle relaxant used to treat muscle spasticity. It is an approved medicine and is also being studied for other investigational uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q101423457&quot;>Wikidata Q101423457</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dantrolene</td></tr><tr><td>ATC codes:</td><td>M03CA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01219&quot;>DB01219</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6914273&quot;>6914273</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4317&quot;>4317</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q101423457&quot;>Q101423457</a></td></tr><tr><td>formula:</td><td>C14H10N4O5</td></tr><tr><td>molar mass:</td><td>314.257 g/mol (PubChem)</td></tr></table></body></html>"));
