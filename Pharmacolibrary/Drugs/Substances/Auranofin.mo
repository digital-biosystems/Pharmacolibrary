  annotation (Documentation(info = "<html><body><p>Auranofin is a gold-based disease-modifying antirheumatic drug used to treat rheumatoid arthritis, and also psoriatic arthritis and pemphigus. It is an approved medicine, though it carries a boxed warning, and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q421230\">Wikidata Q421230</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>auranofin</td></tr><tr><td>ATC codes:</td><td>M01CB03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00995\">DB00995</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/70788951\">70788951</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:2922\">2922</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q421230\">Q421230</a></td></tr><tr><td>formula:</td><td>C20H35AuO9PS</td></tr><tr><td>molar mass:</td><td>679.495 g/mol (PubChem CID 70788951)</td></tr></table></body></html>"));
