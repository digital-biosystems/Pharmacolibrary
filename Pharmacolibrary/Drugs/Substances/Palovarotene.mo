    logP = 6.8);
  annotation (Documentation(info = "<html><body><p>Palovarotene is a drug for disorders of the musculo-skeletal system, studied for myositis ossificans. It is approved, but a marketing application in the European Union was refused, so it is not authorised there.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q15708269\">Wikidata Q15708269</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>palovarotene</td></tr><tr><td>ATC codes:</td><td>M09AX11</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB05467\">DB05467</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/10295295\">10295295</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:188559\">188559</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q15708269\">Q15708269</a></td></tr><tr><td>formula:</td><td>C27H30N2O2</td></tr><tr><td>molar mass:</td><td>414.549 g/mol (PubChem CID 10295295)</td></tr><tr><td>logP:</td><td>6.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Palovarotene;
