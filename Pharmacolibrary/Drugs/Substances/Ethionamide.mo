  annotation (Documentation(info = "<html><body><p>Ethionamide is an antituberculous drug used to treat tuberculosis. It is a WHO essential medicine and remains in use as part of tuberculosis treatment, though it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q414767&quot;>Wikidata Q414767</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ethionamide</td></tr><tr><td>ATC codes:</td><td>J04AD03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00609&quot;>DB00609</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2761171&quot;>2761171</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4885&quot;>4885</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q414767&quot;>Q414767</a></td></tr><tr><td>formula:</td><td>C8H10N2S</td></tr><tr><td>molar mass:</td><td>166.242 g/mol (PubChem)</td></tr></table></body></html>"));
