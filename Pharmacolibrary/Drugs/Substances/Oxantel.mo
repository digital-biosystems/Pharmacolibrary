  annotation (Documentation(info = "<html><body><p>Oxantel is an antinematodal drug used against trichuriasis, a whipworm infection. It is considered investigational and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q1227207&quot;>Wikidata Q1227207</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>oxantel</td></tr><tr><td>ATC codes:</td><td>P02CC02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13670&quot;>DB13670</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5281087&quot;>5281087</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135610&quot;>135610</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q1227207&quot;>Q1227207</a></td></tr><tr><td>formula:</td><td>C13H16N2O</td></tr><tr><td>molar mass:</td><td>216.284 g/mol (PubChem)</td></tr></table></body></html>"));
