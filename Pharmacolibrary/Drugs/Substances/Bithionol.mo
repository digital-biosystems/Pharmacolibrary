within Pharmacolibrary.Drugs.Substances;
package Bithionol "bithionol"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "bithionol",
    atcCodes = {"D10AB01", "P02BX01"},
    drugbankId = "DB04813",
    pubchemCid = "2406",
    chebiId = "3131",
    wikidataId = "Q4918862",
    formula = "C12H6Cl4O2S",
    M = 0.356038,
    logP = 5.8);
  annotation (Documentation(info = "<html><body><p>Bithionol was used as an antiparasitic drug against fluke (trematode) infections and also as a topical anti-acne and antiseptic agent, including as an additive in soaps. It has been withdrawn from human use, reportedly because of skin reactions such as photoallergic contact dermatitis.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4918862&quot;>Wikidata Q4918862</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bithionol</td></tr><tr><td>ATC codes:</td><td>D10AB01, P02BX01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB04813&quot;>DB04813</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2406&quot;>2406</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3131&quot;>3131</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4918862&quot;>Q4918862</a></td></tr><tr><td>formula:</td><td>C12H6Cl4O2S</td></tr><tr><td>molar mass:</td><td>356.038 g/mol (PubChem)</td></tr></table></body></html>"));
end Bithionol;
