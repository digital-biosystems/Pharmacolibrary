  annotation (Documentation(info = "<html><body><p>Sodium iodohippurate (123I) is a diagnostic radiopharmaceutical used for imaging of the kidneys. It is an approved diagnostic agent, classified for renal system imaging, and is used in nuclear medicine for kidney function tests.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27260255&quot;>Wikidata Q27260255</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sodium iodohippurate (123I)</td></tr><tr><td>ATC codes:</td><td>V09CX01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09448&quot;>DB09448</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27260255&quot;>Q27260255</a></td></tr><tr><td>formula:</td><td>C9H7INNaO3</td></tr><tr><td>molar mass:</td><td>323.054 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
