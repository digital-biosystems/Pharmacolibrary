  annotation (Documentation(info = "<html><body><p>Cibenzoline (cifenline) is an antiarrhythmic agent of class I, developed for treating cardiac rhythm disorders. It is not an approved medicine today; it has investigational status and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q867171&quot;>Wikidata Q867171</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cibenzoline</td></tr><tr><td>ATC codes:</td><td>C01BG07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13358&quot;>DB13358</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2747&quot;>2747</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135083&quot;>135083</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q867171&quot;>Q867171</a></td></tr><tr><td>formula:</td><td>C18H18N2</td></tr><tr><td>molar mass:</td><td>262.356 g/mol (PubChem)</td></tr></table></body></html>"));
