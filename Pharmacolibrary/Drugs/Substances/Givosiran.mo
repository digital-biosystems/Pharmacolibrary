  annotation (Documentation(info = "<html><body><p>Givosiran is a small interfering RNA medicine used to treat hepatic porphyria. It is an approved medicine and is authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q56297041\">Wikidata Q56297041</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>givosiran</td></tr><tr><td>ATC codes:</td><td>A16AX16</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB15066\">DB15066</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q56297041\">Q56297041</a></td></tr><tr><td>molar mass:</td><td>16300 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
