  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "cabergoline",
    atcCodes = {"G02CB03", "N04BC06"},
    drugbankId = "DB00248",
    pubchemCid = "54746",
    chebiId = "3286",
    wikidataId = "Q423308",
