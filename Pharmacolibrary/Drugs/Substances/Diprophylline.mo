  annotation (Documentation(info = "<html><body><p>Diprophylline is a xanthine bronchodilator that was used to treat asthma, bronchitis, and pulmonary emphysema. It is no longer in use, having been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1073333\">Wikidata Q1073333</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>diprophylline</td></tr><tr><td>ATC codes:</td><td>R03DA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00651\">DB00651</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3182\">3182</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1073333\">Q1073333</a></td></tr><tr><td>formula:</td><td>C10H14N4O4</td></tr><tr><td>molar mass:</td><td>254.246 g/mol (PubChem CID 3182)</td></tr><tr><td>logP:</td><td>-1.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
