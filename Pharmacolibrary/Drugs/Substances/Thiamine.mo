within Pharmacolibrary.Drugs.Substances;
package Thiamine "Thiamine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "Thiamine",
    atcCodes = {"A11DA01"},
    drugbankId = "DB00152",
    pubchemCid = "1130",
    wikidataId = "Q83187",
    formula = "C12H17N4OS+",
    M = 0.265355);
  annotation (Documentation(info = "<html><body><p>Thiamine (vitamin B1) is used to treat or prevent thiamine deficiency states such as beriberi, Wernicke encephalopathy, pellagra, and alcoholic neuropathy. It is widely used as a vitamin supplement and is included on the WHO list of essential medicines; it is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q83187\">Wikidata Q83187</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Thiamine</td></tr><tr><td>ATC codes:</td><td>A11DA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00152\">DB00152</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/1130\">1130</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q83187\">Q83187</a></td></tr><tr><td>formula:</td><td>C12H17N4OS+</td></tr><tr><td>molar mass:</td><td>265.355 g/mol (PubChem CID 1130)</td></tr></table></body></html>"));
end Thiamine;
