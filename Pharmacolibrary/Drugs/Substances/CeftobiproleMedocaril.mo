  annotation (Documentation(info = "<html><body><p>Ceftobiprole medocaril is an antibacterial drug, a cephalosporin-type beta-lactam, intended for treating bacterial infections of the skin and soft tissues. It is approved and used in some countries, but marketing authorisation was refused in the European Union, so it is not available there.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27294766\">Wikidata Q27294766</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>ceftobiprole medocaril</td></tr><tr><td>ATC codes:</td><td>J01DI01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB14733\">DB14733</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135968\">135968</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27294766\">Q27294766</a></td></tr><tr><td>formula:</td><td>C26H26N8O11S2</td></tr><tr><td>molar mass:</td><td>690.66 g/mol (knowledgebase (DrugBank calculated))</td></tr><tr><td>logP:</td><td>0.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
