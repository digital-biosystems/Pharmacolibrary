  annotation (Documentation(info = "<html><body><p>Pristinamycin is a streptogramin antibiotic used to treat bacterial infections. It is not an approved medicine in major markets and remains investigational, being used mainly in a few countries such as France.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q423412\">Wikidata Q423412</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pristinamycin</td></tr><tr><td>ATC codes:</td><td>J01FG01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13704\">DB13704</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/11979535\">11979535</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q423412\">Q423412</a></td></tr><tr><td>formula:</td><td>C71H84N10O17</td></tr><tr><td>molar mass:</td><td>1349.51 g/mol (PubChem CID 11979535)</td></tr></table></body></html>"));
end Pristinamycin;
