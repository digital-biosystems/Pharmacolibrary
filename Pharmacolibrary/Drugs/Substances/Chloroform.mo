  annotation (Documentation(info = "<html><body><p>Chloroform is a halogenated hydrocarbon that was once used as a general inhalational anaesthetic. It is no longer used in human medicine because it is toxic and carcinogenic, though it retains some veterinary approval.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q172275&quot;>Wikidata Q172275</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>chloroform</td></tr><tr><td>ATC codes:</td><td>N01AB02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11387&quot;>DB11387</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6212&quot;>6212</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:35255&quot;>35255</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q172275&quot;>Q172275</a></td></tr><tr><td>formula:</td><td>CHCl3</td></tr><tr><td>molar mass:</td><td>119.369 g/mol (PubChem)</td></tr></table></body></html>"));
