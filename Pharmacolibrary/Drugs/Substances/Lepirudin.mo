  annotation (Documentation(info = "<html><body><p>Lepirudin is a direct thrombin inhibitor that was used as an anticoagulant in conditions such as thrombocytopenia and unstable angina. It has been withdrawn and is no longer available, including in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3271949&quot;>Wikidata Q3271949</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>lepirudin</td></tr><tr><td>ATC codes:</td><td>B01AE02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00001&quot;>DB00001</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/118856773&quot;>118856773</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3271949&quot;>Q3271949</a></td></tr><tr><td>formula:</td><td>C287H440N80O111S6</td></tr><tr><td>molar mass:</td><td>6979.49 g/mol (PubChem)</td></tr></table></body></html>"));
