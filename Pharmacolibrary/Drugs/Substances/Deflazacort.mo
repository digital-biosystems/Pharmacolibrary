  annotation (Documentation(info = "<html><body><p>Deflazacort is a glucocorticoid (anti-inflammatory and immunosuppressive) used to treat Duchenne muscular dystrophy. It is an approved medicine and is used in clinical practice, mainly for this condition.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q779118&quot;>Wikidata Q779118</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>deflazacort</td></tr><tr><td>ATC codes:</td><td>H02AB13</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11921&quot;>DB11921</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/189821&quot;>189821</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135720&quot;>135720</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q779118&quot;>Q779118</a></td></tr><tr><td>formula:</td><td>C25H31NO6</td></tr><tr><td>molar mass:</td><td>441.524 g/mol (PubChem)</td></tr></table></body></html>"));
