  annotation (Documentation(info = "<html><body><p>Silver sulfadiazine is a topical sulfonamide antibacterial cream used to treat and prevent infection in burns. It is an approved medicine, also approved for veterinary use, and is included on the WHO list of essential medicines, so it is widely available.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q420984\">Wikidata Q420984</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>silver sulfadiazine</td></tr><tr><td>ATC codes:</td><td>D06BA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB05245\">DB05245</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/441244\">441244</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9142\">9142</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q420984\">Q420984</a></td></tr><tr><td>formula:</td><td>C10H9AgN4O2S</td></tr><tr><td>molar mass:</td><td>357.138 g/mol (PubChem CID 441244)</td></tr></table></body></html>"));
end SilverSulfadiazine;
