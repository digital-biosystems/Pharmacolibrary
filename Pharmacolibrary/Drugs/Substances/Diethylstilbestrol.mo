  annotation (Documentation(info = "<html><body><p>Diethylstilbestrol, a synthetic non-steroidal estrogen, was used to treat cancers such as breast and prostate cancer. It has been withdrawn from human use because it is a carcinogen and reproductive and developmental toxicant.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q423989&quot;>Wikidata Q423989</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>diethylstilbestrol</td></tr><tr><td>ATC codes:</td><td>G03CB02, G03CC05, L02AA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00255&quot;>DB00255</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3054&quot;>3054</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:41922&quot;>41922</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q423989&quot;>Q423989</a></td></tr><tr><td>formula:</td><td>C18H20O2</td></tr><tr><td>molar mass:</td><td>268.356 g/mol (PubChem)</td></tr></table></body></html>"));
