within Pharmacolibrary.Drugs.Substances;
package Imlifidase "imlifidase"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "imlifidase",
    atcCodes = {"L04AA41"},
    drugbankId = "DB15258",
    wikidataId = "Q97353944");
  annotation (Documentation(info = "<html><body><p>Imlifidase is an immunosuppressant used for immunologic desensitization in kidney transplantation. It is authorised in the European Union and remains investigational for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q97353944\">Wikidata Q97353944</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>imlifidase</td></tr><tr><td>ATC codes:</td><td>L04AA41</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB15258\">DB15258</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q97353944\">Q97353944</a></td></tr></table></body></html>"));
end Imlifidase;
