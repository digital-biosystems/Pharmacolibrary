  annotation (Documentation(info = "<html><body><p>Duvelisib is a PI3K inhibitor used to treat chronic lymphocytic leukemia and follicular lymphoma. Its authorisation in the European Union has been withdrawn, but the drug has been approved and used elsewhere.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27077129\">Wikidata Q27077129</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>duvelisib</td></tr><tr><td>ATC codes:</td><td>L01EM04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11952\">DB11952</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/50905713\">50905713</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:131169\">131169</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27077129\">Q27077129</a></td></tr><tr><td>formula:</td><td>C22H17ClN6O</td></tr><tr><td>molar mass:</td><td>416.869 g/mol (PubChem CID 50905713)</td></tr><tr><td>logP:</td><td>4.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
