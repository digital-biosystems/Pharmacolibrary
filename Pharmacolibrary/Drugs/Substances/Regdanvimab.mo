  annotation (Documentation(info = "<html><body><p>Regdanvimab is a monoclonal antibody that was used to treat COVID-19 infection. It was approved in the European Union but has since been withdrawn from use there.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q105687595\">Wikidata Q105687595</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>regdanvimab</td></tr><tr><td>ATC codes:</td><td>J06BD06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB16405\">DB16405</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q105687595\">Q105687595</a></td></tr></table></body></html>"));
end Regdanvimab;
