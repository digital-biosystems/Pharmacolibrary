  annotation (Documentation(info = "<html><body><p>Pentetrazol is a convulsant that acts as a GABA antagonist and was classified as a respiratory stimulant, used to treat breathing problems. It is no longer in use, as it has been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q412391\">Wikidata Q412391</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pentetrazol</td></tr><tr><td>ATC codes:</td><td>R07AB03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13415\">DB13415</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5917\">5917</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:34910\">34910</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q412391\">Q412391</a></td></tr><tr><td>formula:</td><td>C6H10N4</td></tr><tr><td>molar mass:</td><td>138.174 g/mol (PubChem CID 5917)</td></tr><tr><td>logP:</td><td>0.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
