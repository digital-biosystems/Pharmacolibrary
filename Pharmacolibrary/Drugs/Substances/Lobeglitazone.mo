  annotation (Documentation(info = "<html><body><p>Lobeglitazone is a thiazolidinedione, a class of oral blood glucose lowering drugs used in diabetes. It is classified as investigational and has no European Union authorisation.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q18350076\">Wikidata Q18350076</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>lobeglitazone</td></tr><tr><td>ATC codes:</td><td>A10BG04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09198\">DB09198</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9826451\">9826451</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:136052\">136052</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q18350076\">Q18350076</a></td></tr><tr><td>formula:</td><td>C24H24N4O5S</td></tr><tr><td>molar mass:</td><td>480.539 g/mol (PubChem CID 9826451)</td></tr><tr><td>logP:</td><td>4.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
