  annotation (Documentation(info = "<html><body><p>Lansoprazole is a proton-pump inhibitor used to treat acid-related conditions such as peptic ulcer disease, gastroesophageal reflux disease, gastritis, and Zollinger–Ellison syndrome. It is an approved prescription medicine, widely used for these disorders, and carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q254296\">Wikidata Q254296</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>lansoprazole</td></tr><tr><td>ATC codes:</td><td>A02BC03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00448\">DB00448</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3883\">3883</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6375\">6375</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q254296\">Q254296</a></td></tr><tr><td>formula:</td><td>C16H14F3N3O2S</td></tr><tr><td>molar mass:</td><td>369.361 g/mol (PubChem CID 3883)</td></tr><tr><td>logP:</td><td>2.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
