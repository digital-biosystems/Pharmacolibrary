    formula = "C33H54O5(C2H4O)n");
  annotation (Documentation(info = "<html><body><p>Tocofersolan is a water-soluble form of vitamin E used to treat vitamin E deficiency, including deficiency linked to cholestasis. It is an approved vitamin preparation with an authorised product in the European Union, but it remains a niche treatment rather than a widely used medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q172409&quot;>Wikidata Q172409</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>tocofersolan</td></tr><tr><td>ATC codes:</td><td>A11HA08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11635&quot;>DB11635</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q172409&quot;>Q172409</a></td></tr><tr><td>formula:</td><td>C33H54O5(C2H4O)n</td></tr></table></body></html>"));
end Tocofersolan;
