  annotation (Documentation(info = "<html><body><p>Tositumomab is a monoclonal antibody radiopharmaceutical that was used to treat non-Hodgkin lymphoma. It was approved but has since been withdrawn from the market and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3995913\">Wikidata Q3995913</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tositumomab</td></tr><tr><td>ATC codes:</td><td>V10XA53</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00081\">DB00081</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3995913\">Q3995913</a></td></tr></table></body></html>"));
