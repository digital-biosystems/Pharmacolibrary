  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "hexobendine",
    atcCodes = {"C01DX06"},
    drugbankId = "DB13265",
    pubchemCid = "5777",
    chebiId = "135843",
    wikidataId = "Q12745373",
