    logP = 3.9);
  annotation (Documentation(info = "<html><body><p>Hexobendine is a vasodilator used in cardiac therapy, acting on blood vessels to treat heart-related conditions. It is an approved drug, though it appears to be a niche cardiac vasodilator rather than a widely used medicine, and it is not authorised by the European Medicines Agency.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q12745373\">Wikidata Q12745373</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>hexobendine</td></tr><tr><td>ATC codes:</td><td>C01DX06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13265\">DB13265</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5777\">5777</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135843\">135843</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q12745373\">Q12745373</a></td></tr><tr><td>formula:</td><td>C30H44N2O10</td></tr><tr><td>molar mass:</td><td>592.686 g/mol (PubChem CID 5777)</td></tr><tr><td>logP:</td><td>3.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Hexobendine;
