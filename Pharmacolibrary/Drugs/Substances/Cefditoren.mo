    logP = 0.7);
  annotation (Documentation(info = "<html><body><p>Cefditoren is a third-generation cephalosporin antibiotic used to treat bacterial infections such as acute bronchitis, pharyngitis, upper respiratory tract infections, pneumonia, and gram-negative infections. It is an approved oral antibiotic, used mainly for respiratory tract infections, though it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3664175\">Wikidata Q3664175</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cefditoren</td></tr><tr><td>ATC codes:</td><td>J01DD16</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01066\">DB01066</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9870843\">9870843</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:59343\">59343</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3664175\">Q3664175</a></td></tr><tr><td>formula:</td><td>C19H18N6O5S3</td></tr><tr><td>molar mass:</td><td>506.57 g/mol (PubChem CID 9870843)</td></tr><tr><td>logP:</td><td>0.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Cefditoren;
