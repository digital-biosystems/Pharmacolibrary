    M = 146.3);
  annotation (Documentation(info = "<html><body><p>Durvalumab is a monoclonal antibody that blocks the PD-L1 protein and is used to treat non-small-cell lung cancer. It is approved and authorised in the European Union, and is also being studied for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q19904005\">Wikidata Q19904005</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>durvalumab</td></tr><tr><td>ATC codes:</td><td>L01FF03, L01XC28</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11714\">DB11714</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q19904005\">Q19904005</a></td></tr><tr><td>molar mass:</td><td>146300 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Durvalumab;
