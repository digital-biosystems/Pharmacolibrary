    logP = -8.2);
  annotation (Documentation(info = "<html><body><p>Dihydrostreptomycin is an antibiotic related to streptomycin that was used to treat bacterial infections, including in eye preparations. It has been withdrawn from human use, largely because of toxicity to hearing, but remains approved for veterinary purposes.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3707637\">Wikidata Q3707637</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dihydrostreptomycin</td></tr><tr><td>ATC codes:</td><td>S01AA15</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11512\">DB11512</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/439369\">439369</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:38291\">38291</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3707637\">Q3707637</a></td></tr><tr><td>formula:</td><td>C21H41N7O12</td></tr><tr><td>molar mass:</td><td>583.596 g/mol (PubChem CID 439369)</td></tr><tr><td>logP:</td><td>-8.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Dihydrostreptomycin;
