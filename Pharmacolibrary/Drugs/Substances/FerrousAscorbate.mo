    logP = 0);
  annotation (Documentation(info = "<html><body><p>Ferrous ascorbate is an oral bivalent iron preparation that was used as an antianemic medicine to treat iron deficiency anaemia. It is no longer in use, as it has been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27276404&quot;>Wikidata Q27276404</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ferrous ascorbate</td></tr><tr><td>ATC codes:</td><td>B03AA10</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB14490&quot;>DB14490</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/54710214&quot;>54710214</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27276404&quot;>Q27276404</a></td></tr><tr><td>formula:</td><td>C12H16FeO12+2</td></tr><tr><td>molar mass:</td><td>408.093 g/mol (PubChem)</td></tr></table></body></html>"));
end FerrousAscorbate;
