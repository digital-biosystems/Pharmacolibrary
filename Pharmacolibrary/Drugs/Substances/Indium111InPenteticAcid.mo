  annotation (Documentation(info = "<html><body><p>Indium pentetic acid is a radioactive tracer used as a diagnostic radiopharmaceutical in nuclear medicine imaging. It is an approved diagnostic agent, classified among central nervous system diagnostic radiopharmaceuticals.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>indium (111In) pentetic acid</td></tr><tr><td>ATC codes:</td><td>V09AX01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09425\">DB09425</a></td></tr><tr><td>molar mass:</td><td>501.23 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Indium111InPenteticAcid;
