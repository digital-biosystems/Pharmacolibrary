  annotation (Documentation(info = "<html><body><p>Indium-111 satumomab pendetide is a radiolabelled monoclonal antibody that was used as a diagnostic imaging agent to help detect tumours. It has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q20801766&quot;>Wikidata Q20801766</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>indium (111In) satumomab pendetide</td></tr><tr><td>ATC codes:</td><td>V09IB02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00057&quot;>DB00057</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q20801766&quot;>Q20801766</a></td></tr><tr><td>molar mass:</td><td>141479 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
