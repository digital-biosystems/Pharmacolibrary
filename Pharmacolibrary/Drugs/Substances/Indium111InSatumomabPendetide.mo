  annotation (Documentation(info = "<html><body><p>Indium (111In) satumomab pendetide is a radioactive imaging agent that was used to help detect tumours in the body. It is no longer available, as it has been withdrawn from the market.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3798316\">Wikidata Q3798316</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>indium (111In) satumomab pendetide</td></tr><tr><td>ATC codes:</td><td>V09IB02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00057\">DB00057</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3798316\">Q3798316</a></td></tr><tr><td>molar mass:</td><td>141479 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
