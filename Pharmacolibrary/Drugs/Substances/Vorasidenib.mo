  annotation (Documentation(info = "<html><body><p>Vorasidenib is an anticancer medicine, an IDH inhibitor, used to treat glioma, including oligodendroglioma and astrocytoma. It is authorised in the European Union and is also still under investigation for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q122240747&quot;>Wikidata Q122240747</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>vorasidenib</td></tr><tr><td>ATC codes:</td><td>L01XM04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB17097&quot;>DB17097</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/117817422&quot;>117817422</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q122240747&quot;>Q122240747</a></td></tr><tr><td>formula:</td><td>C14H13ClF6N6</td></tr><tr><td>molar mass:</td><td>414.738 g/mol (PubChem)</td></tr></table></body></html>"));
