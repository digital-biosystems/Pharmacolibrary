    logP = 0);
  annotation (Documentation(info = "<html><body><p>Calcium acetate is a calcium salt used to treat hyperphosphatemia, and has also been used in chronic renal insufficiency and osteoporosis. It is an approved medicine, used mainly to lower phosphate levels in patients with kidney disease.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q409251&quot;>Wikidata Q409251</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>calcium acetate</td></tr><tr><td>ATC codes:</td><td>V03AE07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00258&quot;>DB00258</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6116&quot;>6116</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3310&quot;>3310</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q409251&quot;>Q409251</a></td></tr><tr><td>formula:</td><td>C4H6CaO4</td></tr><tr><td>molar mass:</td><td>158.166 g/mol (PubChem)</td></tr></table></body></html>"));
end CalciumAcetate;
