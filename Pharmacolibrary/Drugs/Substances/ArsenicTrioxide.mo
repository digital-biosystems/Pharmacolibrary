  annotation (Documentation(info = "<html><body><p>Arsenic trioxide is an anticancer drug used to treat acute promyelocytic leukemia. It is an approved medicine, with authorised products available in the European Union, and is also being studied for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7739&quot;>Wikidata Q7739</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>arsenic trioxide</td></tr><tr><td>ATC codes:</td><td>L01XX27</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01169&quot;>DB01169</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/261004&quot;>261004</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7739&quot;>Q7739</a></td></tr><tr><td>formula:</td><td>As2O3</td></tr><tr><td>molar mass:</td><td>197.841 g/mol (PubChem)</td></tr></table></body></html>"));
