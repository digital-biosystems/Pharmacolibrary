  annotation (Documentation(info = "<html><body><p>Iocarmic acid is an iodinated, water-soluble X-ray contrast medium intended for imaging procedures. It is considered experimental and does not appear to be an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3604531\">Wikidata Q3604531</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>iocarmic acid</td></tr><tr><td>ATC codes:</td><td>V08AA08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13755\">DB13755</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31702\">31702</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3604531\">Q3604531</a></td></tr><tr><td>formula:</td><td>C24H20I6N4O8</td></tr><tr><td>molar mass:</td><td>1253.87 g/mol (knowledgebase (DrugBank calculated))</td></tr><tr><td>logP:</td><td>4.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
