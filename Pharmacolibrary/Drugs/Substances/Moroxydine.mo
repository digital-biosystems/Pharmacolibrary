  annotation (Documentation(info = "<html><body><p>Moroxydine is an antiviral agent that was developed for the treatment of viral infections. It is not an established medicine today; it is regarded as an experimental antiviral and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q781304&quot;>Wikidata Q781304</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>moroxydine</td></tr><tr><td>ATC codes:</td><td>J05AX01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13597&quot;>DB13597</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/71655&quot;>71655</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:94665&quot;>94665</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q781304&quot;>Q781304</a></td></tr><tr><td>formula:</td><td>C6H13N5O</td></tr><tr><td>molar mass:</td><td>171.204 g/mol (PubChem)</td></tr></table></body></html>"));
