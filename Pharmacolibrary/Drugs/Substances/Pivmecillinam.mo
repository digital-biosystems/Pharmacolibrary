  annotation (Documentation(info = "<html><body><p>Pivmecillinam is a penicillin antibiotic used to treat urinary tract infections. It is an approved antibacterial used mainly as a urinary anti-infective, particularly in northern Europe.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q418086\">Wikidata Q418086</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pivmecillinam</td></tr><tr><td>ATC codes:</td><td>J01CA08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01605\">DB01605</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/115163\">115163</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:51210\">51210</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q418086\">Q418086</a></td></tr><tr><td>formula:</td><td>C21H33N3O5S</td></tr><tr><td>molar mass:</td><td>439.571 g/mol (PubChem CID 115163)</td></tr><tr><td>logP:</td><td>3.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
