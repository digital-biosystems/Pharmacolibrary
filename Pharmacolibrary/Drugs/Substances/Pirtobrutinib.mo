  annotation (Documentation(info = "<html><body><p>Pirtobrutinib is a Bruton's tyrosine kinase inhibitor used to treat mantle cell lymphoma and chronic lymphocytic leukemia. It is an approved medicine and is authorised in the European Union for mantle cell lymphoma.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q116622551&quot;>Wikidata Q116622551</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>pirtobrutinib</td></tr><tr><td>ATC codes:</td><td>L01EL05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB17472&quot;>DB17472</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/129269915&quot;>129269915</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q116622551&quot;>Q116622551</a></td></tr><tr><td>formula:</td><td>C22H21F4N5O3</td></tr><tr><td>molar mass:</td><td>479.434 g/mol (PubChem)</td></tr></table></body></html>"));
