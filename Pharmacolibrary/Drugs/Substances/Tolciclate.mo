  annotation (Documentation(info = "<html><body><p>Tolciclate is an antifungal drug developed for topical treatment of fungal skin infections. It appears to be little used today, being listed only as an experimental agent and not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2253370\">Wikidata Q2253370</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tolciclate</td></tr><tr><td>ATC codes:</td><td>D01AE19</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13360\">DB13360</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/92169693\">92169693</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2253370\">Q2253370</a></td></tr><tr><td>formula:</td><td>C20H21NOS</td></tr><tr><td>molar mass:</td><td>323.454 g/mol (PubChem CID 92169693)</td></tr><tr><td>logP:</td><td>5.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Tolciclate;
