  annotation (Documentation(info = "<html><body><p>Mivacurium chloride is a short-acting non-depolarising neuromuscular blocking agent used to relax muscles during surgery and anaesthesia. It has been withdrawn from the market and is no longer in general clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q413877&quot;>Wikidata Q413877</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mivacurium chloride</td></tr><tr><td>ATC codes:</td><td>M03AC10</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01226&quot;>DB01226</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5281042&quot;>5281042</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6958&quot;>6958</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q413877&quot;>Q413877</a></td></tr><tr><td>formula:</td><td>C58H80N2O14+2</td></tr><tr><td>molar mass:</td><td>1029.28 g/mol (PubChem)</td></tr></table></body></html>"));
end MivacuriumChloride;
