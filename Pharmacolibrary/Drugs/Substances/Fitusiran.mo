within Pharmacolibrary.Drugs.Substances;
package Fitusiran "fitusiran"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "fitusiran",
    atcCodes = {"B02BX12"},
    drugbankId = "DB15002");
  annotation (Documentation(info = "<html><body><p>Fitusiran is a small interfering RNA therapy that lowers antithrombin production and is used to treat bleeding in people with haemophilia. It is an approved antihemorrhagic medicine, though some uses remain under investigation.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>fitusiran</td></tr><tr><td>ATC codes:</td><td>B02BX12</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB15002\">DB15002</a></td></tr></table></body></html>"));
end Fitusiran;
