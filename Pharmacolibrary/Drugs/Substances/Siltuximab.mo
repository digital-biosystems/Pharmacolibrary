  annotation (Documentation(info = "<html><body><p>Siltuximab, a monoclonal antibody, is used to treat Castleman's disease (giant lymph node hyperplasia). It is authorised in the European Union and is also being investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3960572&quot;>Wikidata Q3960572</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>siltuximab</td></tr><tr><td>ATC codes:</td><td>L04AC11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09036&quot;>DB09036</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3960572&quot;>Q3960572</a></td></tr><tr><td>molar mass:</td><td>145000 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
