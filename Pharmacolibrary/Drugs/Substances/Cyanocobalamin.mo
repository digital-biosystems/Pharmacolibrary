    M = 1.35539);
  annotation (Documentation(info = "<html><body><p>Cyanocobalamin, a form of vitamin B12, is used to treat and prevent vitamin B12 deficiency, including pernicious anemia and certain neuropathies. It is an approved medicine and nutraceutical, widely used as a vitamin B12 supplement and antianemic preparation.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q252251\">Wikidata Q252251</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cyanocobalamin</td></tr><tr><td>ATC codes:</td><td>B03BA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00115\">DB00115</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/70678590\">70678590</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:17439\">17439</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q252251\">Q252251</a></td></tr><tr><td>formula:</td><td>C63H88CoN14O14P-3</td></tr><tr><td>molar mass:</td><td>1355.39 g/mol (PubChem CID 70678590)</td></tr></table></body></html>"));
end Cyanocobalamin;
