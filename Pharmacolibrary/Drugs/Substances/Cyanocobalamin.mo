  annotation (Documentation(info = "<html><body><p>Cyanocobalamin is a form of vitamin B12 used to treat and prevent vitamin B12 deficiency and related anaemias. It is an approved, widely used medicine and is also available as a nutritional supplement.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q55167869&quot;>Wikidata Q55167869</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cyanocobalamin</td></tr><tr><td>ATC codes:</td><td>B03BA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00115&quot;>DB00115</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/70678590&quot;>70678590</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:17439&quot;>17439</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q55167869&quot;>Q55167869</a></td></tr><tr><td>formula:</td><td>C63H88CoN14O14P-3</td></tr><tr><td>molar mass:</td><td>1355.39 g/mol (PubChem)</td></tr></table></body></html>"));
