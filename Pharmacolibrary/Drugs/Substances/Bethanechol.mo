  annotation (Documentation(info = "<html><body><p>Bethanechol is a parasympathomimetic (muscarinic agonist) used for urinary retention, neurogenic bladder, and gastroesophageal reflux disease. It remains an approved medicine, though it is not authorised in the European Union and is used relatively little today.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q419059\">Wikidata Q419059</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bethanechol</td></tr><tr><td>ATC codes:</td><td>N07AB02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01019\">DB01019</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2370\">2370</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3084\">3084</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q419059\">Q419059</a></td></tr><tr><td>formula:</td><td>C7H17N2O2+</td></tr><tr><td>molar mass:</td><td>161.225 g/mol (PubChem CID 2370)</td></tr></table></body></html>"));
end Bethanechol;
