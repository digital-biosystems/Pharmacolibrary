within Pharmacolibrary.Drugs.Substances;
package Demeclocycline "demeclocycline"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "demeclocycline",
    atcCodes = {"D06AA01", "J01AA01"},
    drugbankId = "DB00618",
    pubchemCid = "54680690",
    chebiId = "4392",
    wikidataId = "Q2736402",
