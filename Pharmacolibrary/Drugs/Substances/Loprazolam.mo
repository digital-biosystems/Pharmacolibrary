    logP = 2.9);
  annotation (Documentation(info = "<html><body><p>Loprazolam is a benzodiazepine-derivative medicine with sedative and calming effects, used as a hypnotic for sleep problems and as an anxiolytic. It is classed as experimental in drug databases, and no marketing authorisation is recorded, so its current availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q411806\">Wikidata Q411806</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>loprazolam</td></tr><tr><td>ATC codes:</td><td>N05CD11</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13643\">DB13643</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3033860\">3033860</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135754\">135754</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q411806\">Q411806</a></td></tr><tr><td>formula:</td><td>C23H21ClN6O3</td></tr><tr><td>molar mass:</td><td>464.91 g/mol (PubChem CID 3033860)</td></tr><tr><td>logP:</td><td>2.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Loprazolam;
