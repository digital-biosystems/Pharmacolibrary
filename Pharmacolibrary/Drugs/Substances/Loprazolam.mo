  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "loprazolam",
    atcCodes = {"N05CD11"},
    drugbankId = "DB13643",
    pubchemCid = "3033860",
    chebiId = "135754",
    wikidataId = "Q411806",
