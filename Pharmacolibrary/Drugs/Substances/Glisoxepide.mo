  annotation (Documentation(info = "<html><body><p>Glisoxepide is a sulfonylurea, a class of blood glucose lowering drugs used to treat diabetes. It is considered investigational and does not appear to be an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5569932\">Wikidata Q5569932</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>glisoxepide</td></tr><tr><td>ATC codes:</td><td>A10BB11</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01289\">DB01289</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/32778\">32778</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135731\">135731</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5569932\">Q5569932</a></td></tr><tr><td>formula:</td><td>C20H27N5O5S</td></tr><tr><td>molar mass:</td><td>449.526 g/mol (PubChem CID 32778)</td></tr><tr><td>logP:</td><td>2.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
