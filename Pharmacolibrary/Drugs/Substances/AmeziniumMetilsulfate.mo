  annotation (Documentation(info = "<html><body><p>Amezinium metilsulfate is a cardiac stimulant belonging to the adrenergic and dopaminergic agents, a class of drugs used to support cardiovascular function. It is not authorised in the European Union and is currently regarded as an experimental compound, so its present clinical use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q470449&quot;>Wikidata Q470449</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>amezinium metilsulfate</td></tr><tr><td>ATC codes:</td><td>C01CA25</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13330&quot;>DB13330</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31201&quot;>31201</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q470449&quot;>Q470449</a></td></tr><tr><td>formula:</td><td>C12H15N3O5S</td></tr><tr><td>molar mass:</td><td>313.33 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
