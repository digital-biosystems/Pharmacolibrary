within Pharmacolibrary.Drugs.Substances;
package Calcitriol "calcitriol"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "calcitriol",
    atcCodes = {"A11CC04", "D05AX03"},
    drugbankId = "DB00136",
    pubchemCid = "5280453",
    chebiId = "17823",
    wikidataId = "Q139195",
    formula = "C27H44O3",
    M = 0.416646,
    logP = 5.1);
  annotation (Documentation(info = "<html><body><p>Calcitriol, an active form of vitamin D, is used to treat conditions such as rickets, hyperparathyroidism, and hypoparathyroidism, and is also applied topically as an antipsoriatic for skin conditions like acropustulosis. It is an approved medicine, available as a vitamin D analogue for oral use and as a topical antipsoriatic, and is used fairly widely.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q139195&quot;>Wikidata Q139195</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>calcitriol</td></tr><tr><td>ATC codes:</td><td>A11CC04, D05AX03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00136&quot;>DB00136</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5280453&quot;>5280453</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:17823&quot;>17823</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q139195&quot;>Q139195</a></td></tr><tr><td>formula:</td><td>C27H44O3</td></tr><tr><td>molar mass:</td><td>416.646 g/mol (PubChem)</td></tr></table></body></html>"));
end Calcitriol;
