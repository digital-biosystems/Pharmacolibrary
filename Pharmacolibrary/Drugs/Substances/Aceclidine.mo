  annotation (Documentation(info = "<html><body><p>Aceclidine is a parasympathomimetic miotic used to treat glaucoma. It is an approved ophthalmic medicine, used as eye drops for glaucoma, though not widely available globally.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2362603&quot;>Wikidata Q2362603</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>aceclidine</td></tr><tr><td>ATC codes:</td><td>S01EB08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13262&quot;>DB13262</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/1979&quot;>1979</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:93847&quot;>93847</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2362603&quot;>Q2362603</a></td></tr><tr><td>formula:</td><td>C9H15NO2</td></tr><tr><td>molar mass:</td><td>169.224 g/mol (PubChem)</td></tr></table></body></html>"));
