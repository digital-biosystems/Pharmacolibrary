  annotation (Documentation(info = "<html><body><p>Medrysone is a corticosteroid used to treat inflammatory eye conditions such as giant papillary conjunctivitis and episcleritis. It is an approved ophthalmic medicine, used as eye drops for these eye inflammations.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6807292&quot;>Wikidata Q6807292</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>medrysone</td></tr><tr><td>ATC codes:</td><td>S01BA08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00253&quot;>DB00253</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/247839&quot;>247839</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:34829&quot;>34829</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6807292&quot;>Q6807292</a></td></tr><tr><td>formula:</td><td>C22H32O3</td></tr><tr><td>molar mass:</td><td>344.495 g/mol (PubChem)</td></tr></table></body></html>"));
