    formula = "C38H74Cl2N2O4",
    M = 0.69392);
  annotation (Documentation(info = "<html><body><p>Decamethoxine is a quaternary ammonium antiseptic used as a local anti-infective agent to treat skin infections. It appears to be only experimental, with no authorisation recorded in the European Union, so its current use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27269246\">Wikidata Q27269246</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>decamethoxine</td></tr><tr><td>ATC codes:</td><td>D08AJ10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13705\">DB13705</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/118984404\">118984404</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27269246\">Q27269246</a></td></tr><tr><td>formula:</td><td>C38H74Cl2N2O4</td></tr><tr><td>molar mass:</td><td>693.92 g/mol (PubChem CID 118984404)</td></tr></table></body></html>"));
end Decamethoxine;
