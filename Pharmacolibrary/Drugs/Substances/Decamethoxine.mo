within Pharmacolibrary.Drugs.Substances;
package Decamethoxine "decamethoxine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "decamethoxine",
    atcCodes = {"D08AJ10"},
    drugbankId = "DB13705",
    pubchemCid = "118984404",
