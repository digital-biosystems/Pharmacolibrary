  annotation (Documentation(info = "<html><body><p>Remimazolam is a benzodiazepine sedative used to produce conscious sedation during medical procedures. It is approved and authorised in the European Union, though it remains a relatively new agent rather than a widely established one.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7311799&quot;>Wikidata Q7311799</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>remimazolam</td></tr><tr><td>ATC codes:</td><td>N05CD14</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12404&quot;>DB12404</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/9867812&quot;>9867812</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7311799&quot;>Q7311799</a></td></tr><tr><td>formula:</td><td>C21H19BrN4O2</td></tr><tr><td>molar mass:</td><td>439.313 g/mol (PubChem)</td></tr></table></body></html>"));
