  annotation (Documentation(info = "<html><body><p>Ipidacrine is an anticholinesterase that has been used to treat botulism and is classed among anti-dementia drugs. It is considered experimental and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q15409425\">Wikidata Q15409425</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ipidacrine</td></tr><tr><td>ATC codes:</td><td>N06DA05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13668\">DB13668</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/604519\">604519</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:125612\">125612</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q15409425\">Q15409425</a></td></tr><tr><td>formula:</td><td>C12H16N2</td></tr><tr><td>molar mass:</td><td>188.274 g/mol (PubChem CID 604519)</td></tr><tr><td>logP:</td><td>2.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
