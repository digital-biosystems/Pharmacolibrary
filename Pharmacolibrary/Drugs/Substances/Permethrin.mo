  annotation (Documentation(info = "<html><body><p>Permethrin is a pyrethroid insecticide used to treat scabies and lice infestations. It is widely used and appears on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q411635\">Wikidata Q411635</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>permethrin</td></tr><tr><td>ATC codes:</td><td>P03AC04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB04930\">DB04930</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/40326\">40326</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:34911\">34911</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q411635\">Q411635</a></td></tr><tr><td>formula:</td><td>C21H20Cl2O3</td></tr><tr><td>molar mass:</td><td>391.288 g/mol (PubChem CID 40326)</td></tr><tr><td>logP:</td><td>6.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Permethrin;
