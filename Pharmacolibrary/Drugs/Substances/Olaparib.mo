  annotation (Documentation(info = "<html><body><p>Olaparib is a PARP inhibitor anticancer drug used to treat cancers such as ovarian, breast, pancreatic, and castration-resistant prostate cancer. It is approved and authorised in the European Union for these cancer indications.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7083106&quot;>Wikidata Q7083106</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>olaparib</td></tr><tr><td>ATC codes:</td><td>L01XK01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09074&quot;>DB09074</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/23725625&quot;>23725625</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:83766&quot;>83766</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7083106&quot;>Q7083106</a></td></tr><tr><td>formula:</td><td>C24H23FN4O3</td></tr><tr><td>molar mass:</td><td>434.471 g/mol (PubChem)</td></tr></table></body></html>"));
