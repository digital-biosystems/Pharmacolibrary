  annotation (Documentation(info = "<html><body><p>Motavizumab is a monoclonal antibody investigated for preventing serious respiratory syncytial virus infection in infants. It remains investigational and has not been approved for routine clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6917147\">Wikidata Q6917147</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>motavizumab</td></tr><tr><td>ATC codes:</td><td>J06BD02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06310\">DB06310</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6917147\">Q6917147</a></td></tr></table></body></html>"));
end Motavizumab;
