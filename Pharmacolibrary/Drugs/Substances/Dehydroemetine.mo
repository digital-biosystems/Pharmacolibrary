  annotation (Documentation(info = "<html><body><p>Dehydroemetine is an antiprotozoal agent classified for use against amoebiasis and other protozoal diseases. It is not an established marketed medicine and appears only as an experimental drug, so it is not in routine clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5252386\">Wikidata Q5252386</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dehydroemetine</td></tr><tr><td>ATC codes:</td><td>P01AX09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13865\">DB13865</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/21022\">21022</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4363\">4363</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5252386\">Q5252386</a></td></tr><tr><td>formula:</td><td>C29H38N2O4</td></tr><tr><td>molar mass:</td><td>478.633 g/mol (PubChem CID 21022)</td></tr><tr><td>logP:</td><td>3.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
