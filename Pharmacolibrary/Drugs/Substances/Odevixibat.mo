  annotation (Documentation(info = "<html><body><p>Odevixibat is a bile therapy medicine used to treat itching (pruritus) caused by intrahepatic cholestasis, including in Alagille syndrome. It is authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q76415200&quot;>Wikidata Q76415200</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>odevixibat</td></tr><tr><td>ATC codes:</td><td>A05AX05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB16261&quot;>DB16261</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/10153627&quot;>10153627</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q76415200&quot;>Q76415200</a></td></tr><tr><td>formula:</td><td>C37H48N4O8S2</td></tr><tr><td>molar mass:</td><td>740.931 g/mol (PubChem)</td></tr></table></body></html>"));
end Odevixibat;
