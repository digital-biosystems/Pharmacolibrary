  annotation (Documentation(info = "<html><body><p>Prolgolimab is an investigational anti-cancer drug, a monoclonal antibody that blocks the PD-1/PD-L1 immune checkpoint pathway. It is not yet an approved medicine and remains in clinical development.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>prolgolimab</td></tr><tr><td>ATC codes:</td><td>L01FF08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB16740\">DB16740</a></td></tr></table></body></html>"));
