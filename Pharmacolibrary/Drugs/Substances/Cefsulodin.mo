  annotation (Documentation(info = "<html><body><p>Cefsulodin is a third-generation cephalosporin antibiotic used to treat bacterial infections. It is not an approved medicine in major markets and is currently regarded as experimental, so it is not widely used.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2943815&quot;>Wikidata Q2943815</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cefsulodin</td></tr><tr><td>ATC codes:</td><td>J01DD03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13499&quot;>DB13499</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/656575&quot;>656575</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3507&quot;>3507</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2943815&quot;>Q2943815</a></td></tr><tr><td>formula:</td><td>C22H20N4O8S2</td></tr><tr><td>molar mass:</td><td>532.542 g/mol (PubChem)</td></tr></table></body></html>"));
