within Pharmacolibrary.Drugs.Substances;
package Eculizumab "eculizumab"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "eculizumab",
    atcCodes = {"L04AA25", "L04AJ01"},
    drugbankId = "DB01257",
    wikidataId = "Q421617",
    M = 148);
  annotation (Documentation(info = "<html><body><p>Eculizumab, a monoclonal antibody that inhibits complement, is used to treat conditions such as paroxysmal nocturnal hemoglobinuria, myasthenia gravis, and hemolytic-uremic syndrome. It is authorised in the European Union, where it is used for rare blood and immune-related disorders.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q421617\">Wikidata Q421617</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>eculizumab</td></tr><tr><td>ATC codes:</td><td>L04AA25, L04AJ01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01257\">DB01257</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q421617\">Q421617</a></td></tr><tr><td>molar mass:</td><td>148000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Eculizumab;
