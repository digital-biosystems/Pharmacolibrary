    logP = -2.4);
  annotation (Documentation(info = "<html><body><p>Carglumic acid is a drug used to treat metabolic disorders, specifically hyperammonaemia caused by N-acetylglutamate synthase deficiency. It is an approved medicine, authorised in the European Union, and used mainly in specialised care for this rare condition.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q822884&quot;>Wikidata Q822884</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>carglumic acid</td></tr><tr><td>ATC codes:</td><td>A16AA05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06775&quot;>DB06775</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/121396&quot;>121396</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:71028&quot;>71028</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q822884&quot;>Q822884</a></td></tr><tr><td>formula:</td><td>C6H10N2O5</td></tr><tr><td>molar mass:</td><td>190.155 g/mol (PubChem)</td></tr></table></body></html>"));
