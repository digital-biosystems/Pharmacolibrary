  annotation (Documentation(info = "<html><body><p>Gefarnate is an anti-ulcer drug classified for treating peptic ulcer and acid-related gastrointestinal disorders. It is considered investigational and is not an established marketed treatment in major regions such as the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5530013\">Wikidata Q5530013</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>gefarnate</td></tr><tr><td>ATC codes:</td><td>A02BX07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12079\">DB12079</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5282182\">5282182</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31646\">31646</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5530013\">Q5530013</a></td></tr><tr><td>formula:</td><td>C27H44O2</td></tr><tr><td>molar mass:</td><td>400.647 g/mol (PubChem CID 5282182)</td></tr><tr><td>logP:</td><td>9.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
