  annotation (Documentation(info = "<html><body><p>Lincomycin is a lincosamide antibiotic used to treat staphylococcal and pneumococcal infections. It is an approved human and veterinary medicine, though it carries a boxed warning, and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q423428\">Wikidata Q423428</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>lincomycin</td></tr><tr><td>ATC codes:</td><td>J01FF02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01627\">DB01627</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3000540\">3000540</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6472\">6472</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q423428\">Q423428</a></td></tr><tr><td>formula:</td><td>C18H34N2O6S</td></tr><tr><td>molar mass:</td><td>406.538 g/mol (PubChem CID 3000540)</td></tr><tr><td>logP:</td><td>0.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
