within Pharmacolibrary.Drugs.Substances;
package Macrogol "macrogol"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "macrogol",
    atcCodes = {"A06AD15"},
    drugbankId = "DB09287",
    wikidataId = "Q410083");
  annotation (Documentation(info = "<html><body><p>Macrogol (polyethylene glycol) is a polymer used as an osmotic laxative to treat constipation. It is an approved medicine, also has veterinary approval, and is widely used for constipation; it also serves as a solvent and surfactant in other products.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q410083\">Wikidata Q410083</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>macrogol</td></tr><tr><td>ATC codes:</td><td>A06AD15</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09287\">DB09287</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q410083\">Q410083</a></td></tr></table></body></html>"));
end Macrogol;
