  annotation (Documentation(info = "<html><body><p>Evinacumab is a monoclonal antibody used as a lipid-modifying agent for hypercholesterolemia and type I hyperlipoproteinemia. It is authorised in the European Union and is also being investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q19904115&quot;>Wikidata Q19904115</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>evinacumab</td></tr><tr><td>ATC codes:</td><td>C10AX17</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB15354&quot;>DB15354</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q19904115&quot;>Q19904115</a></td></tr><tr><td>molar mass:</td><td>146000 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
