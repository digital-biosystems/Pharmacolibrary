  annotation (Documentation(info = "<html><body><p>Procarbazine is an anticancer drug used to treat cancers such as Hodgkin's lymphoma, non-Hodgkin lymphoma, brain cancer, melanoma, and multiple myeloma. It is an approved medicine and is included on the WHO list of essential medicines, so it remains in clinical use worldwide.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q418656\">Wikidata Q418656</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>procarbazine</td></tr><tr><td>ATC codes:</td><td>L01XB01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01168\">DB01168</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4915\">4915</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:71417\">71417</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q418656\">Q418656</a></td></tr><tr><td>formula:</td><td>C12H19N3O</td></tr><tr><td>molar mass:</td><td>221.304 g/mol (PubChem CID 4915)</td></tr><tr><td>logP:</td><td>0.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
