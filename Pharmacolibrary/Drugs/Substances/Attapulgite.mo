  annotation (Documentation(info = "<html><body><p>Attapulgite is an intestinal adsorbent that was used as an antidiarrheal medicine and also as an antidote. It has been withdrawn from human use, though it remains approved for veterinary purposes.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q20817221\">Wikidata Q20817221</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>attapulgite</td></tr><tr><td>ATC codes:</td><td>A07BC04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01574\">DB01574</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/73415752\">73415752</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q20817221\">Q20817221</a></td></tr><tr><td>formula:</td><td>AlH9MgO15Si4</td></tr><tr><td>molar mass:</td><td>412.684 g/mol (PubChem CID 73415752)</td></tr><tr><td>logP:</td><td>-0.65 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Attapulgite;
