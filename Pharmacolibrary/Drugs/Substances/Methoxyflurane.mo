    logP = 2.2);
  annotation (Documentation(info = "<html><body><p>Methoxyflurane is an inhalational anaesthetic that has also been used at low doses for pain relief. It was largely withdrawn as a general anaesthetic because of kidney toxicity, but a low-dose inhaled formulation remains available for short-term pain relief in some countries such as Australia.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q411594\">Wikidata Q411594</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>methoxyflurane</td></tr><tr><td>ATC codes:</td><td>N02BG09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01028\">DB01028</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4116\">4116</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6843\">6843</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q411594\">Q411594</a></td></tr><tr><td>formula:</td><td>C3H4Cl2F2O</td></tr><tr><td>molar mass:</td><td>164.96 g/mol (PubChem CID 4116)</td></tr><tr><td>logP:</td><td>2.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Methoxyflurane;
