  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "methoxyflurane",
    atcCodes = {"N02BG09"},
    drugbankId = "DB01028",
    pubchemCid = "4116",
    chebiId = "6843",
    wikidataId = "Q411594",
