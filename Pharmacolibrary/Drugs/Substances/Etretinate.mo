within Pharmacolibrary.Drugs.Substances;
package Etretinate "etretinate"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "etretinate",
    atcCodes = {"D05BB01"},
    drugbankId = "DB00926",
    pubchemCid = "3312",
    chebiId = "4913",
    wikidataId = "Q554297",
