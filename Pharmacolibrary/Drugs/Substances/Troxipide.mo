  annotation (Documentation(info = "<html><body><p>Troxipide is a drug used to treat gastric ulcers and chronic gastritis. It is not an approved medicine in major markets such as the European Union and is considered experimental, so its current availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4381806\">Wikidata Q4381806</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>troxipide</td></tr><tr><td>ATC codes:</td><td>A02BX11</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13419\">DB13419</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5597\">5597</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32271\">32271</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4381806\">Q4381806</a></td></tr><tr><td>formula:</td><td>C15H22N2O4</td></tr><tr><td>molar mass:</td><td>294.351 g/mol (PubChem CID 5597)</td></tr><tr><td>logP:</td><td>1.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
