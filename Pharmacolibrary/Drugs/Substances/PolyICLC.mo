  annotation (Documentation(info = "<html><body><p>Poly ICLC (Hiltonol) is an immunostimulant investigated as a treatment for cancer. It remains investigational and is not an approved medicine in the European Union or elsewhere.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7226111\">Wikidata Q7226111</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>poly ICLC</td></tr><tr><td>ATC codes:</td><td>L03AX08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB17293\">DB17293</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7226111\">Q7226111</a></td></tr></table></body></html>"));
