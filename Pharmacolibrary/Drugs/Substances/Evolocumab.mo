  annotation (Documentation(info = "<html><body><p>Evolocumab, a monoclonal antibody that lowers cholesterol, is used to treat dyslipidemias such as hypercholesterolemia and related conditions including coronary artery disease. It is authorised in the European Union and is widely used as a lipid-modifying agent.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q15623825\">Wikidata Q15623825</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>evolocumab</td></tr><tr><td>ATC codes:</td><td>C10AX13</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09303\">DB09303</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q15623825\">Q15623825</a></td></tr><tr><td>molar mass:</td><td>141800 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Evolocumab;
