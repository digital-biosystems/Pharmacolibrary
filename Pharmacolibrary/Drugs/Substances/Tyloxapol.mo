    wikidataId = "Q7860340");
  annotation (Documentation(info = "<html><body><p>Tyloxapol is an expectorant medicine used for respiratory conditions, and has been used to treat pulmonary immaturity. It is an approved drug, though not authorised in the European Union, and is used only to a limited extent.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7860340&quot;>Wikidata Q7860340</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tyloxapol</td></tr><tr><td>ATC codes:</td><td>R05CA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06439&quot;>DB06439</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7860340&quot;>Q7860340</a></td></tr></table></body></html>"));
end Tyloxapol;
