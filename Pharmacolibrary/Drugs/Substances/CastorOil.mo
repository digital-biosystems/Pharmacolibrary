  annotation (Documentation(info = "<html><body><p>Castor oil, pressed from castor seeds, is a contact laxative used to treat constipation. It remains an approved medicine and nutraceutical, and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q337492\">Wikidata Q337492</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>castor oil</td></tr><tr><td>ATC codes:</td><td>A06AB05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11113\">DB11113</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q337492\">Q337492</a></td></tr></table></body></html>"));
end CastorOil;
