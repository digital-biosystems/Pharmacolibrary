  annotation (Documentation(info = "<html><body><p>Trolnitrate is an organic nitrate vasodilator classified for cardiac therapy, historically used in heart conditions such as angina. It is currently regarded as an experimental drug and does not appear to be in routine clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7845303&quot;>Wikidata Q7845303</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>trolnitrate</td></tr><tr><td>ATC codes:</td><td>C01DA09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13719&quot;>DB13719</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/11499&quot;>11499</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135172&quot;>135172</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7845303&quot;>Q7845303</a></td></tr><tr><td>formula:</td><td>C6H12N4O9</td></tr><tr><td>molar mass:</td><td>284.181 g/mol (PubChem)</td></tr></table></body></html>"));
