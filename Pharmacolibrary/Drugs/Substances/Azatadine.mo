  annotation (Documentation(info = "<html><body><p>Azatadine is an antihistamine (H1 blocker) that was used to treat allergic conditions such as urticaria. It is no longer on the market, having been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q599160\">Wikidata Q599160</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>azatadine</td></tr><tr><td>ATC codes:</td><td>R06AX09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00719\">DB00719</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/19861\">19861</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:2946\">2946</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q599160\">Q599160</a></td></tr><tr><td>formula:</td><td>C20H22N2</td></tr><tr><td>molar mass:</td><td>290.41 g/mol (PubChem CID 19861)</td></tr><tr><td>logP:</td><td>3.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
