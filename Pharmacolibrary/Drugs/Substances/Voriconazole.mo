    wikidataId = "Q412236",
    formula = "C16H14F3N5O",
    M = 0.349316,
    logP = 1.5);
  annotation (Documentation(info = "<html><body><p>Voriconazole is an antifungal medicine used to treat serious fungal infections such as aspergillosis, candidiasis, and other systemic mycoses. It is authorised in the European Union and is included on the WHO list of essential medicines, so it is widely used for systemic fungal infections.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q412236&quot;>Wikidata Q412236</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>voriconazole</td></tr><tr><td>ATC codes:</td><td>J02AC03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00582&quot;>DB00582</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/71616&quot;>71616</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:10023&quot;>10023</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q412236&quot;>Q412236</a></td></tr><tr><td>formula:</td><td>C16H14F3N5O</td></tr><tr><td>molar mass:</td><td>349.316 g/mol (PubChem)</td></tr></table></body></html>"));
end Voriconazole;
