  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "naftifine",
    atcCodes = {"D01AE22"},
    drugbankId = "DB00735",
    pubchemCid = "73342",
    chebiId = "7451",
    wikidataId = "Q413586",
    formula = "C21H21N",
    M = 0.287406,
    logP = 5.1);
  annotation (Documentation(info = "<html><body><p>Naftifine is a topical antifungal drug used to treat fungal skin infections such as tinea pedis (athlete's foot). It is an approved medicine applied to the skin, and is used in dermatological practice for ringworm-type infections.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q413586&quot;>Wikidata Q413586</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>naftifine</td></tr><tr><td>ATC codes:</td><td>D01AE22</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00735&quot;>DB00735</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/73342&quot;>73342</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7451&quot;>7451</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q413586&quot;>Q413586</a></td></tr><tr><td>formula:</td><td>C21H21N</td></tr><tr><td>molar mass:</td><td>287.406 g/mol (PubChem)</td></tr></table></body></html>"));
end Naftifine;
