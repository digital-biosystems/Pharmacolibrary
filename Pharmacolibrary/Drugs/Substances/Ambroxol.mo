    logP = 2.6);
  annotation (Documentation(info = "<html><body><p>Ambroxol is a mucolytic medicine used for respiratory conditions such as chronic obstructive pulmonary disease, helping to clear mucus from the airways. It is an approved drug, widely used in cough and cold preparations and other respiratory medicines, and is also being investigated for additional uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q221637&quot;>Wikidata Q221637</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ambroxol</td></tr><tr><td>ATC codes:</td><td>R02AD05, R05CB06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06742&quot;>DB06742</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2132&quot;>2132</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135590&quot;>135590</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q221637&quot;>Q221637</a></td></tr><tr><td>formula:</td><td>C13H18Br2N2O</td></tr><tr><td>molar mass:</td><td>378.108 g/mol (PubChem)</td></tr></table></body></html>"));
end Ambroxol;
