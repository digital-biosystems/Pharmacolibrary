  annotation (Documentation(info = "<html><body><p>Pegloticase is an enzyme-based medicine used to treat gout. It is approved and used for chronic gout that does not respond to standard therapy, mainly in the United States; a product was withdrawn in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7160794&quot;>Wikidata Q7160794</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>pegloticase</td></tr><tr><td>ATC codes:</td><td>M04AX02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09208&quot;>DB09208</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7160794&quot;>Q7160794</a></td></tr><tr><td>molar mass:</td><td>34192.9 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Pegloticase;
