    logP = 0.2);
  annotation (Documentation(info = "<html><body><p>Dimetofrine is an adrenergic cardiac stimulant, a class of drugs used to support heart function in cardiovascular conditions. It is classed as experimental and appears to have no authorised marketing, so its current use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5277352\">Wikidata Q5277352</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dimetofrine</td></tr><tr><td>ATC codes:</td><td>C01CA12</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13494\">DB13494</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/31513\">31513</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134932\">134932</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5277352\">Q5277352</a></td></tr><tr><td>formula:</td><td>C11H17NO4</td></tr><tr><td>molar mass:</td><td>227.26 g/mol (PubChem CID 31513)</td></tr><tr><td>logP:</td><td>0.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
