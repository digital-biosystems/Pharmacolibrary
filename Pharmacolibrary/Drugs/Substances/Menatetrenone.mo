    logP = 8.9);
  annotation (Documentation(info = "<html><body><p>Menatetrenone, a form of menaquinone (vitamin K), has been studied for the treatment of bone disease and also acts as an antihemorrhagic agent. It is considered investigational and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q192354\">Wikidata Q192354</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>menatetrenone</td></tr><tr><td>ATC codes:</td><td>M05BX08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12148\">DB12148</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5282367\">5282367</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:78277\">78277</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q192354\">Q192354</a></td></tr><tr><td>formula:</td><td>C31H40O2</td></tr><tr><td>molar mass:</td><td>444.659 g/mol (PubChem CID 5282367)</td></tr><tr><td>logP:</td><td>8.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
