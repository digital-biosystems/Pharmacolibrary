  annotation (Documentation(info = "<html><body><p>Phenolsulfonphthalein is a diagnostic agent used in tests of kidney function and for detecting ureteral injuries. It is classed as an experimental diagnostic substance and is not an established marketed medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q418719&quot;>Wikidata Q418719</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>phenolsulfonphthalein</td></tr><tr><td>ATC codes:</td><td>V04CH03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13212&quot;>DB13212</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4766&quot;>4766</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31991&quot;>31991</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q418719&quot;>Q418719</a></td></tr><tr><td>formula:</td><td>C19H14O5S</td></tr><tr><td>molar mass:</td><td>354.376 g/mol (PubChem)</td></tr></table></body></html>"));
