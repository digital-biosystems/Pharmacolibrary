  annotation (Documentation(info = "<html><body><p>Edrecolomab is a monoclonal antibody that was investigated as a cancer treatment, mainly for colorectal cancer. It is not an approved medicine today and is considered investigational, with no authorisation in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q749244&quot;>Wikidata Q749244</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>edrecolomab</td></tr><tr><td>ATC codes:</td><td>L01FX01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13375&quot;>DB13375</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q749244&quot;>Q749244</a></td></tr></table></body></html>"));
