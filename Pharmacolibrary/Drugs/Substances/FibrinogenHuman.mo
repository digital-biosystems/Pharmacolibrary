within Pharmacolibrary.Drugs.Substances;
package FibrinogenHuman "fibrinogen, human"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "fibrinogen, human",
    atcCodes = {"B02BB01"},
    drugbankId = "DB09222",
    wikidataId = "Q22075876");
  annotation (Documentation(info = "<html><body><p>Human fibrinogen is a blood clotting factor used to treat bleeding caused by low fibrinogen levels. It is an approved medicine, classified as a hemostatic under the ATC system, and is also being studied for additional uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q22075876&quot;>Wikidata Q22075876</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>fibrinogen, human</td></tr><tr><td>ATC codes:</td><td>B02BB01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09222&quot;>DB09222</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q22075876&quot;>Q22075876</a></td></tr></table></body></html>"));
end FibrinogenHuman;
