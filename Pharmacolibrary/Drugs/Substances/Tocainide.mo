  annotation (Documentation(info = "<html><body><p>Tocainide is a class Ib antiarrhythmic that was used to treat heart arrhythmia and was also studied for trigeminal neuralgia. It has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q757058&quot;>Wikidata Q757058</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tocainide</td></tr><tr><td>ATC codes:</td><td>C01BB03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01056&quot;>DB01056</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/38945&quot;>38945</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9611&quot;>9611</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q757058&quot;>Q757058</a></td></tr><tr><td>formula:</td><td>C11H16N2O</td></tr><tr><td>molar mass:</td><td>192.262 g/mol (PubChem)</td></tr></table></body></html>"));
