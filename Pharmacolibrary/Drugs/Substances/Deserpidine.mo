  annotation (Documentation(info = "<html><body><p>Deserpidine, a Rauwolfia alkaloid, was used to treat high blood pressure and was also given for schizophrenia. It is no longer in use, as it is listed as a withdrawn drug.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5263885&quot;>Wikidata Q5263885</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>deserpidine</td></tr><tr><td>ATC codes:</td><td>C02AA05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01089&quot;>DB01089</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/8550&quot;>8550</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:27478&quot;>27478</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5263885&quot;>Q5263885</a></td></tr><tr><td>formula:</td><td>C32H38N2O8</td></tr><tr><td>molar mass:</td><td>578.662 g/mol (PubChem)</td></tr></table></body></html>"));
