  annotation (Documentation(info = "<html><body><p>Sodium fluoride is a fluoride salt used to prevent tooth decay (dental caries). It is an approved drug, used mainly in stomatological preparations as a caries prophylactic, and also available as a mineral supplement.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q407520&quot;>Wikidata Q407520</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sodium fluoride</td></tr><tr><td>ATC codes:</td><td>A01AA01, A12CD01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09325&quot;>DB09325</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5235&quot;>5235</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:28741&quot;>28741</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q407520&quot;>Q407520</a></td></tr><tr><td>formula:</td><td>FNa</td></tr><tr><td>molar mass:</td><td>41.988 g/mol (PubChem)</td></tr></table></body></html>"));
end SodiumFluoride;
