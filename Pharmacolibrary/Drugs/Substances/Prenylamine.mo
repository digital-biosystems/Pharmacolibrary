  annotation (Documentation(info = "<html><body><p>Prenylamine is a calcium channel blocker and vasodilator that was used as a cardiac therapy for cardiovascular disease. It has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7240579\">Wikidata Q7240579</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>prenylamine</td></tr><tr><td>ATC codes:</td><td>C01DX02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB04825\">DB04825</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9801\">9801</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8397\">8397</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7240579\">Q7240579</a></td></tr><tr><td>formula:</td><td>C24H27N</td></tr><tr><td>molar mass:</td><td>329.487 g/mol (PubChem CID 9801)</td></tr><tr><td>logP:</td><td>6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
