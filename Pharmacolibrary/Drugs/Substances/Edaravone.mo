  annotation (Documentation(info = "<html><body><p>Edaravone is used to treat amyotrophic lateral sclerosis, acting as a free radical scavenger. It is approved in some countries, though a marketing application for it in the European Union was withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q335099\">Wikidata Q335099</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>edaravone</td></tr><tr><td>ATC codes:</td><td>N07XX14</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12243\">DB12243</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4021\">4021</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31530\">31530</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q335099\">Q335099</a></td></tr><tr><td>formula:</td><td>C10H10N2O</td></tr><tr><td>molar mass:</td><td>174.203 g/mol (PubChem CID 4021)</td></tr><tr><td>logP:</td><td>1.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
