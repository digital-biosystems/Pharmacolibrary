    wikidataId = "Q419019");
  annotation (Documentation(info = "<html><body><p>Lentinan is a polysaccharide immunostimulant that has been investigated as an immunologic adjuvant and antineoplastic agent for cancer treatment. It remains investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q419019&quot;>Wikidata Q419019</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>lentinan</td></tr><tr><td>ATC codes:</td><td>L03AX01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13480&quot;>DB13480</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q419019&quot;>Q419019</a></td></tr></table></body></html>"));
end Lentinan;
