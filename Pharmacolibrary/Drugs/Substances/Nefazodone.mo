  annotation (Documentation(info = "<html><body><p>Nefazodone is an antidepressant that was used to treat depression and has also been studied for conditions such as post-traumatic stress disorder and neurotic disorders. It has been withdrawn from the market, mainly because of rare but serious liver injury, and is no longer widely available.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q416632&quot;>Wikidata Q416632</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nefazodone</td></tr><tr><td>ATC codes:</td><td>N06AX06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01149&quot;>DB01149</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4449&quot;>4449</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7494&quot;>7494</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q416632&quot;>Q416632</a></td></tr><tr><td>formula:</td><td>C25H32ClN5O2</td></tr><tr><td>molar mass:</td><td>470.014 g/mol (PubChem)</td></tr></table></body></html>"));
