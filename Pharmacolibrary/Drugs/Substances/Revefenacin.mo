  annotation (Documentation(info = "<html><body><p>Revefenacin is an inhaled anticholinergic medicine used to treat chronic obstructive pulmonary disease. It is an approved drug, but it is not authorised in the European Union; it is used mainly in the United States.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27278649&quot;>Wikidata Q27278649</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>revefenacin</td></tr><tr><td>ATC codes:</td><td>R03BB08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11855&quot;>DB11855</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/11753673&quot;>11753673</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27278649&quot;>Q27278649</a></td></tr><tr><td>formula:</td><td>C35H43N5O4</td></tr><tr><td>molar mass:</td><td>597.76 g/mol (PubChem)</td></tr></table></body></html>"));
