    logP = 2.7);
  annotation (Documentation(info = "<html><body><p>Lisuride is a dopamine agonist used as an antiparkinson agent, a prolactin inhibitor, and an antimigraine ergot alkaloid. It is an approved medicine, though an application for use in restless legs syndrome in the European Union was withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q424446\">Wikidata Q424446</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>lisuride</td></tr><tr><td>ATC codes:</td><td>G02CB02, N02CA07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00589\">DB00589</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/28864\">28864</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:51164\">51164</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q424446\">Q424446</a></td></tr><tr><td>formula:</td><td>C20H26N4O</td></tr><tr><td>molar mass:</td><td>338.455 g/mol (PubChem CID 28864)</td></tr><tr><td>logP:</td><td>2.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Lisuride;
