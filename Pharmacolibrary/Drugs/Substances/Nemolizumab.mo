within Pharmacolibrary.Drugs.Substances;
package Nemolizumab "nemolizumab"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "nemolizumab",
    atcCodes = {"D11AH12"},
    drugbankId = "DB15252",
    M = 144);
  annotation (Documentation(info = "<html><body><p>Nemolizumab is a monoclonal antibody used to treat atopic dermatitis and prurigo. It is authorised in the European Union and is also being investigated for further uses.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>nemolizumab</td></tr><tr><td>ATC codes:</td><td>D11AH12</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB15252\">DB15252</a></td></tr><tr><td>molar mass:</td><td>144000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Nemolizumab;
