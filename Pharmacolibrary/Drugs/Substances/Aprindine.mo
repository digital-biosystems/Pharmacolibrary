  annotation (Documentation(info = "<html><body><p>Aprindine is an antiarrhythmic drug of class Ib, used to treat heart rhythm disorders associated with heart disease. It is considered experimental and is not authorised in the European Union, so its current availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q263612&quot;>Wikidata Q263612</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>aprindine</td></tr><tr><td>ATC codes:</td><td>C01BB04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01429&quot;>DB01429</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2218&quot;>2218</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135370&quot;>135370</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q263612&quot;>Q263612</a></td></tr><tr><td>formula:</td><td>C22H30N2</td></tr><tr><td>molar mass:</td><td>322.496 g/mol (PubChem)</td></tr></table></body></html>"));
