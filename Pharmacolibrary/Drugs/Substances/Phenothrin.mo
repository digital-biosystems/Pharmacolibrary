    logP = 6.2);
  annotation (Documentation(info = "<html><body><p>Phenothrin is a synthetic pyrethroid ectoparasiticide used against lice and other parasites on the body surface. It is not an approved medicine in the European Union and remains investigational, though it is known as an insecticide in some household products.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q999813&quot;>Wikidata Q999813</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>phenothrin</td></tr><tr><td>ATC codes:</td><td>P03AC03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13717&quot;>DB13717</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4767&quot;>4767</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:34916&quot;>34916</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q999813&quot;>Q999813</a></td></tr><tr><td>formula:</td><td>C23H26O3</td></tr><tr><td>molar mass:</td><td>350.458 g/mol (PubChem)</td></tr></table></body></html>"));
end Phenothrin;
