within Pharmacolibrary.Drugs.Substances;
package Sulfacetamide "sulfacetamide"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "sulfacetamide",
    atcCodes = {"D10AF06", "S01AB04"},
    drugbankId = "DB00634",
    pubchemCid = "5320",
    chebiId = "63845",
    wikidataId = "Q2022983",
    formula = "C8H10N2O3S",
    M = 0.214239,
    logP = -1);
  annotation (Documentation(info = "<html><body><p>Sulfacetamide is a sulfonamide antibiotic used as a local anti-infective for bacterial eye infections such as conjunctivitis, corneal ulcer and trachoma, and topically for acne and seborrhoeic dermatitis. It remains an approved drug, used mainly in topical eye and skin preparations.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2022983\">Wikidata Q2022983</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sulfacetamide</td></tr><tr><td>ATC codes:</td><td>D10AF06, S01AB04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00634\">DB00634</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5320\">5320</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:63845\">63845</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2022983\">Q2022983</a></td></tr><tr><td>formula:</td><td>C8H10N2O3S</td></tr><tr><td>molar mass:</td><td>214.239 g/mol (PubChem CID 5320)</td></tr><tr><td>logP:</td><td>-1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Sulfacetamide;
