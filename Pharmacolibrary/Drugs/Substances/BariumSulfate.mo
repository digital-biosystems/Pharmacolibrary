  annotation (Documentation(info = "<html><body><p>Barium sulfate is used as an X-ray contrast medium to help image the digestive tract. It is an approved medicine and is widely used as a diagnostic imaging agent.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Barium sulfate</td></tr><tr><td>ATC codes:</td><td>V08BA01, V08BA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11150&quot;>DB11150</a></td></tr></table></body></html>"));
end BariumSulfate;
