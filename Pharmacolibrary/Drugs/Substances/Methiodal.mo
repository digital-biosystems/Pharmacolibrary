  annotation (Documentation(info = "<html><body><p>Methiodal is an iodinated, water-soluble X-ray contrast medium used to make body structures visible on imaging. It is no longer in routine clinical use and is regarded as an experimental compound.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27279530&quot;>Wikidata Q27279530</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>methiodal</td></tr><tr><td>ATC codes:</td><td>V08AA09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13321&quot;>DB13321</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/31346&quot;>31346</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134912&quot;>134912</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27279530&quot;>Q27279530</a></td></tr><tr><td>formula:</td><td>CH3IO3S</td></tr><tr><td>molar mass:</td><td>221.992 g/mol (PubChem)</td></tr></table></body></html>"));
