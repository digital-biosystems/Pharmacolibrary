  annotation (Documentation(info = "<html><body><p>Recombinant antihemophilic factor (coagulation factor VIII) is used to treat hemophilia A by replacing the missing blood clotting factor. It is an approved medicine, included on the WHO list of essential medicines, and is widely used worldwide for this condition.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4661156&quot;>Wikidata Q4661156</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>coagulation factor VIII</td></tr><tr><td>ATC codes:</td><td>B02BD02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00025&quot;>DB00025</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4661156&quot;>Q4661156</a></td></tr><tr><td>molar mass:</td><td>264726 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end CoagulationFactorVIII;
