within Pharmacolibrary.Drugs.Substances;
package CoagulationFactorVIII "coagulation factor VIII"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "coagulation factor VIII",
    atcCodes = {"B02BD02"},
    drugbankId = "DB00025",
    wikidataId = "Q20801759",
    M = 264.726);
  annotation (Documentation(info = "<html><body><p>Coagulation factor VIII (antihemophilic factor) is a clotting protein used to treat bleeding disorders such as hemophilia A, von Willebrand's disease, and factor VII deficiency. It is an approved medicine, given as replacement therapy to prevent or control bleeding in patients lacking this factor.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q20801759\">Wikidata Q20801759</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>coagulation factor VIII</td></tr><tr><td>ATC codes:</td><td>B02BD02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00025\">DB00025</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q20801759\">Q20801759</a></td></tr><tr><td>molar mass:</td><td>264726 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end CoagulationFactorVIII;
