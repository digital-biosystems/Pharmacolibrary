  annotation (Documentation(info = "<html><body><p>Sodium feredetate is an oral trivalent iron preparation used to treat iron deficiency anaemia. It is an approved medicine and is used as an oral iron supplement, though it is not among the most widely used iron preparations.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q30314945&quot;>Wikidata Q30314945</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sodium feredetate</td></tr><tr><td>ATC codes:</td><td>B03AB03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13381&quot;>DB13381</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:78292&quot;>78292</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q30314945&quot;>Q30314945</a></td></tr><tr><td>formula:</td><td>C10H12FeN2NaO8</td></tr><tr><td>molar mass:</td><td>367.047 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
