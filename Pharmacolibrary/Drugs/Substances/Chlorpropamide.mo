  annotation (Documentation(info = "<html><body><p>Chlorpropamide is a sulfonylurea blood-glucose-lowering drug that was used to treat type 2 diabetes and maturity-onset diabetes of the young type 2. It has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q1075324&quot;>Wikidata Q1075324</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>chlorpropamide</td></tr><tr><td>ATC codes:</td><td>A10BB02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00672&quot;>DB00672</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2727&quot;>2727</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3650&quot;>3650</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q1075324&quot;>Q1075324</a></td></tr><tr><td>formula:</td><td>C10H13ClN2O3S</td></tr><tr><td>molar mass:</td><td>276.735 g/mol (PubChem)</td></tr></table></body></html>"));
