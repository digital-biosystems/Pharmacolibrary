within Pharmacolibrary.Drugs.Substances;
package Necitumumab "necitumumab"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "necitumumab",
    atcCodes = {"L01FE03"},
    drugbankId = "DB09559",
    wikidataId = "Q6985503");
  annotation (Documentation(info = "<html><body><p>Necitumumab is an EGFR-inhibiting monoclonal antibody used as an anticancer drug, notably for non-small-cell lung carcinoma. It is approved in some countries, mainly the United States, but its European Union marketing authorisation has been withdrawn, so it is not available there.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6985503&quot;>Wikidata Q6985503</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>necitumumab</td></tr><tr><td>ATC codes:</td><td>L01FE03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09559&quot;>DB09559</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6985503&quot;>Q6985503</a></td></tr></table></body></html>"));
end Necitumumab;
