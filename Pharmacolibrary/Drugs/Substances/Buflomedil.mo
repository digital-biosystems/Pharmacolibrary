  annotation (Documentation(info = "<html><body><p>Buflomedil is a vasodilator that was used to improve blood flow in peripheral vascular disorders. It is currently classed as an experimental compound, and its marketing status in major regions is unclear from the available information.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q417862&quot;>Wikidata Q417862</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>buflomedil</td></tr><tr><td>ATC codes:</td><td>C04AX20</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13510&quot;>DB13510</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2467&quot;>2467</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:94538&quot;>94538</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q417862&quot;>Q417862</a></td></tr><tr><td>formula:</td><td>C17H25NO4</td></tr><tr><td>molar mass:</td><td>307.39 g/mol (PubChem)</td></tr></table></body></html>"));
