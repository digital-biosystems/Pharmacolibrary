within Pharmacolibrary.Drugs.Substances;
package Denosumab "denosumab"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "denosumab",
    atcCodes = {"M05BX04"},
    drugbankId = "DB06643",
    wikidataId = "Q408283",
    M = 144.7);
  annotation (Documentation(info = "<html><body><p>Denosumab is a monoclonal antibody used to treat bone diseases, especially postmenopausal osteoporosis and bone loss linked to cancer. It is widely used and authorised in the European Union, with products covering osteoporosis, bone resorption, bone tumours, and giant cell tumour of bone.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q408283\">Wikidata Q408283</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>denosumab</td></tr><tr><td>ATC codes:</td><td>M05BX04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06643\">DB06643</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q408283\">Q408283</a></td></tr><tr><td>molar mass:</td><td>144700 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Denosumab;
