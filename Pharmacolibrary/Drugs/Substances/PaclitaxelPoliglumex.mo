  annotation (Documentation(info = "<html><body><p>Paclitaxel poliglumex is an investigational taxane-based anticancer agent developed as a modified form of the chemotherapy drug paclitaxel for treating cancer. It has not been approved and remains investigational, with no authorisation in the European Union or elsewhere.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q72499389\">Wikidata Q72499389</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>paclitaxel poliglumex</td></tr><tr><td>ATC codes:</td><td>L01CD03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13809\">DB13809</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q72499389\">Q72499389</a></td></tr></table></body></html>"));
end PaclitaxelPoliglumex;
