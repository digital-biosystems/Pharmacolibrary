within Pharmacolibrary.Drugs.Substances;
package Mesuximide "mesuximide"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "mesuximide",
    atcCodes = {"N03AD03"},
    drugbankId = "DB05246",
    pubchemCid = "6476",
    wikidataId = "Q906414",
    formula = "C12H13NO2",
    M = 0.203241,
    logP = 1.2);
  annotation (Documentation(info = "<html><body><p>Mesuximide (methsuximide) is a succinimide anticonvulsant used to treat epilepsy, especially childhood absence epilepsy. It is an approved antiepileptic, though it is not widely used and no EU marketing authorisation is recorded.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q906414\">Wikidata Q906414</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mesuximide</td></tr><tr><td>ATC codes:</td><td>N03AD03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB05246\">DB05246</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6476\">6476</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q906414\">Q906414</a></td></tr><tr><td>formula:</td><td>C12H13NO2</td></tr><tr><td>molar mass:</td><td>203.241 g/mol (PubChem CID 6476)</td></tr><tr><td>logP:</td><td>1.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Mesuximide;
