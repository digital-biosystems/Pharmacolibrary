  annotation (Documentation(info = "<html><body><p>Dibutyl phthalate is a phthalate ester classified as an insecticide and repellent, and it has also been used as a plasticizer. It is considered experimental rather than an established medicine, and it is known as a reproductive and developmental toxicant.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q415612&quot;>Wikidata Q415612</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dibutylphthalate</td></tr><tr><td>ATC codes:</td><td>P03BX03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13716&quot;>DB13716</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3026&quot;>3026</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:34687&quot;>34687</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q415612&quot;>Q415612</a></td></tr><tr><td>formula:</td><td>C16H22O4</td></tr><tr><td>molar mass:</td><td>278.348 g/mol (PubChem)</td></tr></table></body></html>"));
