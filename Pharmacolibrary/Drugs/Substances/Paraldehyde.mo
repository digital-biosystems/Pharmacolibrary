  annotation (Documentation(info = "<html><body><p>Paraldehyde is a sedative and anticonvulsant that was used as a hypnotic and to treat conditions such as delirium and epilepsy. It has been withdrawn from use and is no longer a marketed medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q424342\">Wikidata Q424342</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>paraldehyde</td></tr><tr><td>ATC codes:</td><td>N05CC05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09117\">DB09117</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/31264\">31264</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:27909\">27909</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q424342\">Q424342</a></td></tr><tr><td>formula:</td><td>C6H12O3</td></tr><tr><td>molar mass:</td><td>132.159 g/mol (PubChem CID 31264)</td></tr><tr><td>logP:</td><td>0.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
