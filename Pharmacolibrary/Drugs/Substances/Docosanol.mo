    logP = 10.5);
  annotation (Documentation(info = "<html><body><p>Docosanol is a topical antiviral fatty alcohol used to treat herpes simplex infections, such as cold sores. It is an approved drug, available as a dermatological antiviral for topical use, though it is not authorised by the European Medicines Agency.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3033497&quot;>Wikidata Q3033497</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>docosanol</td></tr><tr><td>ATC codes:</td><td>D06BB11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00632&quot;>DB00632</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/12620&quot;>12620</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31000&quot;>31000</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3033497&quot;>Q3033497</a></td></tr><tr><td>formula:</td><td>C22H46O</td></tr><tr><td>molar mass:</td><td>326.609 g/mol (PubChem)</td></tr></table></body></html>"));
end Docosanol;
