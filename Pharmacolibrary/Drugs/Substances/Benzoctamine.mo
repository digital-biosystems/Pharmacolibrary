  annotation (Documentation(info = "<html><body><p>Benzoctamine is classified as an anxiolytic, a drug used to treat anxiety. It appears to be little used today, being listed only as an experimental compound, and it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4890786\">Wikidata Q4890786</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>benzoctamine</td></tr><tr><td>ATC codes:</td><td>N05BD01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09021\">DB09021</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/28425\">28425</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135017\">135017</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4890786\">Q4890786</a></td></tr><tr><td>formula:</td><td>C18H19N</td></tr><tr><td>molar mass:</td><td>249.357 g/mol (PubChem CID 28425)</td></tr><tr><td>logP:</td><td>3.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
