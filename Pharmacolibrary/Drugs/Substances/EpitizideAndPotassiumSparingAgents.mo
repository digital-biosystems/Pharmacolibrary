within Pharmacolibrary.Drugs.Substances;
package EpitizideAndPotassiumSparingAgents "epitizide and potassium-sparing agents"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "epitizide and potassium-sparing agents",
    atcCodes = {"C03EA03"},
    drugbankId = "DB13989",
    chebiId = "135688",
    wikidataId = "Q5383720",
    formula = "C10H11ClF3N3O4S3",
    M = 0.42584,
    logP = 0.88);
  annotation (Documentation(info = "<html><body><p>Epitizide is a thiazide-type diuretic given together with potassium-sparing agents, a combination used to treat high blood pressure and fluid retention. It appears to be little used today, being classed as experimental in drug databases, and no marketing authorisation is recorded in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5383720\">Wikidata Q5383720</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>epitizide and potassium-sparing agents</td></tr><tr><td>ATC codes:</td><td>C03EA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13989\">DB13989</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135688\">135688</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5383720\">Q5383720</a></td></tr><tr><td>formula:</td><td>C10H11ClF3N3O4S3</td></tr><tr><td>molar mass:</td><td>425.84 g/mol (knowledgebase (DrugBank calculated))</td></tr><tr><td>logP:</td><td>0.88 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end EpitizideAndPotassiumSparingAgents;
