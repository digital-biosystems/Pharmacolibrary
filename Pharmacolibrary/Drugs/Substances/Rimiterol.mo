  annotation (Documentation(info = "<html><body><p>Rimiterol is a selective beta-2 adrenergic agonist that was given by inhalation for obstructive airway diseases such as asthma. It is no longer in routine clinical use and is regarded as an experimental drug today.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7334473\">Wikidata Q7334473</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>rimiterol</td></tr><tr><td>ATC codes:</td><td>R03AC05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13559\">DB13559</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/46886609\">46886609</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7334473\">Q7334473</a></td></tr><tr><td>formula:</td><td>C12H17NO3</td></tr><tr><td>molar mass:</td><td>223.272 g/mol (PubChem CID 46886609)</td></tr><tr><td>logP:</td><td>0.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
