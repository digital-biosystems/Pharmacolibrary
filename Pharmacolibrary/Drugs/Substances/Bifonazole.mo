  annotation (Documentation(info = "<html><body><p>Bifonazole is an antifungal medicine applied to the skin to treat fungal skin infections. It is an approved topical antifungal, used mainly in dermatological care.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q421162\">Wikidata Q421162</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bifonazole</td></tr><tr><td>ATC codes:</td><td>D01AC10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB04794\">DB04794</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2378\">2378</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:78692\">78692</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q421162\">Q421162</a></td></tr><tr><td>formula:</td><td>C22H18N2</td></tr><tr><td>molar mass:</td><td>310.4 g/mol (PubChem CID 2378)</td></tr><tr><td>logP:</td><td>4.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
