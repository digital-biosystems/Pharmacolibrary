  annotation (Documentation(info = "<html><body><p>Anistreplase is a fibrinolytic (clot-dissolving) drug that was used to treat myocardial infarction and pulmonary embolism. It has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4765471&quot;>Wikidata Q4765471</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>anistreplase</td></tr><tr><td>ATC codes:</td><td>B01AD03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00029&quot;>DB00029</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4765471&quot;>Q4765471</a></td></tr><tr><td>molar mass:</td><td>59042.3 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Anistreplase;
