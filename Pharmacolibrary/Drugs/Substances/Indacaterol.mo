  annotation (Documentation(info = "<html><body><p>Indacaterol is an inhaled long-acting beta-2 agonist used to treat chronic obstructive pulmonary disease. It is authorised in the European Union, where several products are available, and is used as a single agent and in combination with other respiratory medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q425654\">Wikidata Q425654</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>indacaterol</td></tr><tr><td>ATC codes:</td><td>R03AC18</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB05039\">DB05039</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6918554\">6918554</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:68575\">68575</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q425654\">Q425654</a></td></tr><tr><td>formula:</td><td>C24H28N2O3</td></tr><tr><td>molar mass:</td><td>392.499 g/mol (PubChem CID 6918554)</td></tr><tr><td>logP:</td><td>3.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
