    logP = 4.8);
  annotation (Documentation(info = "<html><body><p>Promethazine is an antihistamine of the phenothiazine class used to treat allergic conditions, itching, motion sickness, vomiting, and pain, and to manage postoperative complications. It is an approved medicine, available for systemic use as an antihistamine and also in topical antipruritic preparations, and is used fairly widely.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q422970\">Wikidata Q422970</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>promethazine</td></tr><tr><td>ATC codes:</td><td>D04AA10, R06AD02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01069\">DB01069</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4927\">4927</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8461\">8461</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q422970\">Q422970</a></td></tr><tr><td>formula:</td><td>C17H20N2S</td></tr><tr><td>molar mass:</td><td>284.421 g/mol (PubChem CID 4927)</td></tr><tr><td>logP:</td><td>4.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Promethazine;
