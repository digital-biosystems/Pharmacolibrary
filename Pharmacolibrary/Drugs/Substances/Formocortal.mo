  annotation (Documentation(info = "<html><body><p>Formocortal is a corticosteroid classified for use as an anti-inflammatory agent in eye conditions. It appears only as an experimental compound, with no evidence of current authorised use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5470216\">Wikidata Q5470216</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>formocortal</td></tr><tr><td>ATC codes:</td><td>S01BA12</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13664\">DB13664</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/289085\">289085</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135834\">135834</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5470216\">Q5470216</a></td></tr><tr><td>formula:</td><td>C29H38ClFO8</td></tr><tr><td>molar mass:</td><td>569.063 g/mol (PubChem CID 289085)</td></tr><tr><td>logP:</td><td>3.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
