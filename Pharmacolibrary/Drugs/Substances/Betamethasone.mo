  annotation (Documentation(info = "<html><body><p>Betamethasone is a corticosteroid used to treat inflammatory conditions such as asthma, dermatitis, allergic rhinitis, ulcerative colitis, and multiple sclerosis. It is widely used in many forms, including skin, eye, ear, nasal, inhaled, and systemic preparations, and is included on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q416132\">Wikidata Q416132</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>betamethasone</td></tr><tr><td>ATC codes:</td><td>A07EA04, C05AA05, D07AC01, D07XC01, H02AB01, R01AD06, R03BA04, S01BA06, S01CB04, S02BA07, S03BA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00443\">DB00443</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9782\">9782</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3077\">3077</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q416132\">Q416132</a></td></tr><tr><td>formula:</td><td>C22H29FO5</td></tr><tr><td>molar mass:</td><td>392.467 g/mol (PubChem CID 9782)</td></tr><tr><td>logP:</td><td>1.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
