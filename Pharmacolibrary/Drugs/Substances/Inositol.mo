  annotation (Documentation(info = "<html><body><p>Inositol is a sugar-like compound that was classified as a vitamin preparation and used as a supplement for metabolic and related conditions. It is no longer marketed as an approved drug, having been withdrawn, though it remains available as a dietary supplement.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3331426&quot;>Wikidata Q3331426</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>inositol</td></tr><tr><td>ATC codes:</td><td>A11HA07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13178&quot;>DB13178</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/892&quot;>892</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:17268&quot;>17268</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3331426&quot;>Q3331426</a></td></tr><tr><td>formula:</td><td>C6H12O6</td></tr><tr><td>molar mass:</td><td>180.156 g/mol (PubChem)</td></tr></table></body></html>"));
