    M = 0.180156,
    logP = -3.7);
  annotation (Documentation(info = "<html><body><p>Inositol is a sugar-like compound once classed as a B vitamin and marketed as a vitamin preparation. It is no longer regarded as an essential vitamin and has been withdrawn as a drug, though it persists as a dietary supplement.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q407997\">Wikidata Q407997</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>inositol</td></tr><tr><td>ATC codes:</td><td>A11HA07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13178\">DB13178</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/892\">892</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:17268\">17268</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q407997\">Q407997</a></td></tr><tr><td>formula:</td><td>C6H12O6</td></tr><tr><td>molar mass:</td><td>180.156 g/mol (PubChem CID 892)</td></tr><tr><td>logP:</td><td>-3.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Inositol;
