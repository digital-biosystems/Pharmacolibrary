  annotation (Documentation(info = "<html><body><p>Rotigotine is a dopamine agonist used to treat Parkinson's disease and restless legs syndrome. It is authorised in the European Union and widely used for these conditions.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q411985&quot;>Wikidata Q411985</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>rotigotine</td></tr><tr><td>ATC codes:</td><td>N04BC09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB05271&quot;>DB05271</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/59227&quot;>59227</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135351&quot;>135351</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q411985&quot;>Q411985</a></td></tr><tr><td>formula:</td><td>C19H25NOS</td></tr><tr><td>molar mass:</td><td>315.475 g/mol (PubChem)</td></tr></table></body></html>"));
