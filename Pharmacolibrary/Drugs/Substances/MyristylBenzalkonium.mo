  annotation (Documentation(info = "<html><body><p>Myristyl benzalkonium is a quaternary ammonium antiseptic classified for throat preparations, suggesting use against throat infections. It is considered investigational and does not appear to have an authorised marketing status in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27280476\">Wikidata Q27280476</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>myristyl-benzalkonium</td></tr><tr><td>ATC codes:</td><td>R02AA10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13774\">DB13774</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/8756\">8756</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27280476\">Q27280476</a></td></tr><tr><td>formula:</td><td>C23H42N+</td></tr><tr><td>molar mass:</td><td>332.596 g/mol (PubChem CID 8756)</td></tr><tr><td>logP:</td><td>8.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
