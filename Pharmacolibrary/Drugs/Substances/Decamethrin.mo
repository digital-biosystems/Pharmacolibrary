within Pharmacolibrary.Drugs.Substances;
package Decamethrin "decamethrin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "decamethrin",
    atcCodes = {"P03BA03"},
    drugbankId = "DB13600",
    pubchemCid = "40585",
    wikidataId = "Q422257",
    formula = "C22H19Br2NO3",
    M = 0.505206,
    logP = 6.2);
  annotation (Documentation(info = "<html><body><p>Decamethrin (deltamethrin) is a pyrethroid insecticide used to kill ectoparasites such as lice, mites, and other insects on humans and animals. It is classified as an experimental compound in DrugBank, meaning it has not received regulatory approval as a medicine and remains investigational rather than an established therapeutic drug.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q422257&quot;>Wikidata Q422257</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>decamethrin</td></tr><tr><td>ATC codes:</td><td>P03BA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13600&quot;>DB13600</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/40585&quot;>40585</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q422257&quot;>Q422257</a></td></tr><tr><td>formula:</td><td>C22H19Br2NO3</td></tr><tr><td>molar mass:</td><td>505.206 g/mol (PubChem)</td></tr></table></body></html>"));
end Decamethrin;
