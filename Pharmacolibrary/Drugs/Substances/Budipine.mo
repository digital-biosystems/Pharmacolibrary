  annotation (Documentation(info = "<html><body><p>Budipine is a dopaminergic antiparkinson drug used to treat Parkinson's disease. It is not an approved medicine today and is considered experimental, so it is not widely used.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q28128\">Wikidata Q28128</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>budipine</td></tr><tr><td>ATC codes:</td><td>N04BX03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13502\">DB13502</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/68778\">68778</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135228\">135228</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q28128\">Q28128</a></td></tr><tr><td>formula:</td><td>C21H27N</td></tr><tr><td>molar mass:</td><td>293.454 g/mol (PubChem CID 68778)</td></tr><tr><td>logP:</td><td>5.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
