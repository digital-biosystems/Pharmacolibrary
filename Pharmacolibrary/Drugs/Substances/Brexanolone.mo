  annotation (Documentation(info = "<html><body><p>Brexanolone is an antidepressant used to treat postpartum depression in adult women. It is approved but restricted to hospital or supervised settings, where patients must be monitored during the infusion, and it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2482223&quot;>Wikidata Q2482223</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>brexanolone</td></tr><tr><td>ATC codes:</td><td>N06AX29</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11859&quot;>DB11859</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/92786&quot;>92786</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:50169&quot;>50169</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2482223&quot;>Q2482223</a></td></tr><tr><td>formula:</td><td>C21H34O2</td></tr><tr><td>molar mass:</td><td>318.501 g/mol (PubChem)</td></tr></table></body></html>"));
