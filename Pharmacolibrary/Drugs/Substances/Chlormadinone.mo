  annotation (Documentation(info = "<html><body><p>Chlormadinone is a progestogen steroid that has been used in hormonal contraceptives and other progestogen–estrogen combination preparations. It is currently considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q905012&quot;>Wikidata Q905012</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>chlormadinone</td></tr><tr><td>ATC codes:</td><td>G03DB06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13528&quot;>DB13528</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5284533&quot;>5284533</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q905012&quot;>Q905012</a></td></tr><tr><td>formula:</td><td>C21H27ClO3</td></tr><tr><td>molar mass:</td><td>362.894 g/mol (PubChem)</td></tr></table></body></html>"));
