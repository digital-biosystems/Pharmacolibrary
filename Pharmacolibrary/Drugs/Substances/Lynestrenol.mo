  annotation (Documentation(info = "<html><body><p>Lynestrenol is a synthetic progestogen steroid that was used in hormonal contraceptives, alone or combined with an estrogen. It has been withdrawn from use, though it was once an approved oral contraceptive.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2071071\">Wikidata Q2071071</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>lynestrenol</td></tr><tr><td>ATC codes:</td><td>G03AC02, G03DC03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12474\">DB12474</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5857\">5857</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31790\">31790</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2071071\">Q2071071</a></td></tr><tr><td>formula:</td><td>C20H28O</td></tr><tr><td>molar mass:</td><td>284.443 g/mol (PubChem CID 5857)</td></tr><tr><td>logP:</td><td>4.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Lynestrenol;
