    M = 0.909892);
  annotation (Documentation(info = "<html><body><p>Sodium stibogluconate is an antiprotozoal medicine used to treat leishmaniasis. It is on the WHO list of essential medicines and remains an approved treatment, though it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2757844\">Wikidata Q2757844</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sodium stibogluconate</td></tr><tr><td>ATC codes:</td><td>P01CB02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB05630\">DB05630</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/56927674\">56927674</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:28148\">28148</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2757844\">Q2757844</a></td></tr><tr><td>formula:</td><td>C12H37Na3O26Sb2</td></tr><tr><td>molar mass:</td><td>909.892 g/mol (PubChem CID 56927674)</td></tr></table></body></html>"));
end SodiumStibogluconate;
