    logP = 0.4);
  annotation (Documentation(info = "<html><body><p>Sulfametoxydiazine is a long-acting sulfonamide antibiotic used to treat bacterial infections, including urinary tract infections and leprosy. It is an approved antibacterial, but it is not widely used today and is mainly found in a few countries rather than being authorised across the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q15410181\">Wikidata Q15410181</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sulfametoxydiazine</td></tr><tr><td>ATC codes:</td><td>J01ED04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06821\">DB06821</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5326\">5326</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:53727\">53727</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q15410181\">Q15410181</a></td></tr><tr><td>formula:</td><td>C11H12N4O3S</td></tr><tr><td>molar mass:</td><td>280.302 g/mol (PubChem CID 5326)</td></tr><tr><td>logP:</td><td>0.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Sulfametoxydiazine;
