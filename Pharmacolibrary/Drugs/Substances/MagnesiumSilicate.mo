  annotation (Documentation(info = "<html><body><p>Magnesium silicate is an antacid, a magnesium compound used for acid-related disorders of the digestive tract. It is no longer in use, as drug records list it as withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q17374115\">Wikidata Q17374115</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>magnesium silicate</td></tr><tr><td>ATC codes:</td><td>A02AA05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13249\">DB13249</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q17374115\">Q17374115</a></td></tr><tr><td>formula:</td><td>MgO3Si</td></tr><tr><td>molar mass:</td><td>100.387 g/mol (knowledgebase (DrugBank calculated))</td></tr></table></body></html>"));
end MagnesiumSilicate;
