  annotation (Documentation(info = "<html><body><p>Cemiplimab is a monoclonal antibody that blocks PD-1 and is used to treat squamous cell carcinoma. It is an approved cancer medicine, authorised in the European Union, and is also being studied for other uses.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>cemiplimab</td></tr><tr><td>ATC codes:</td><td>L01FF06, L01XC33</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB14707&quot;>DB14707</a></td></tr><tr><td>molar mass:</td><td>146000 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Cemiplimab;
