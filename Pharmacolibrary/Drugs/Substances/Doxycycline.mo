    logP = -0.7);
  annotation (Documentation(info = "<html><body><p>Doxycycline is a tetracycline antibiotic used to treat many bacterial infections, including pneumonia, acne, Lyme disease, and chlamydia, and to prevent malaria. It is widely used in human medicine and is also approved for veterinary use, and it appears on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q422442&quot;>Wikidata Q422442</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>doxycycline</td></tr><tr><td>ATC codes:</td><td>A01AB22, J01AA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00254&quot;>DB00254</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/54671203&quot;>54671203</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:50845&quot;>50845</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q422442&quot;>Q422442</a></td></tr><tr><td>formula:</td><td>C22H24N2O8</td></tr><tr><td>molar mass:</td><td>444.44 g/mol (PubChem)</td></tr></table></body></html>"));
end Doxycycline;
