  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "doxycycline",
    atcCodes = {"A01AB22", "J01AA02"},
    drugbankId = "DB00254",
    pubchemCid = "54671203",
    chebiId = "50845",
    wikidataId = "Q422442",
