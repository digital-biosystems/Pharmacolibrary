  annotation (Documentation(info = "<html><body><p>Hexapropymate is a chemical compound classified among other hypnotics and sedatives, suggesting it was used as a sedative sleep aid. It is currently listed only as an experimental drug, and no regulatory approval information is available, so its present availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1036070\">Wikidata Q1036070</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>hexapropymate</td></tr><tr><td>ATC codes:</td><td>N05CM10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13662\">DB13662</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9661\">9661</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134823\">134823</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1036070\">Q1036070</a></td></tr><tr><td>formula:</td><td>C10H15NO2</td></tr><tr><td>molar mass:</td><td>181.235 g/mol (PubChem CID 9661)</td></tr><tr><td>logP:</td><td>1.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
