within Pharmacolibrary.Drugs.Substances;
package Tisagenlecleucel "tisagenlecleucel"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "tisagenlecleucel",
    atcCodes = {"L01XL04"},
    drugbankId = "DB13881");
  annotation (Documentation(info = "<html><body><p>Tisagenlecleucel is a cell and gene therapy used to treat certain B-cell blood cancers, including B-cell acute lymphoblastic leukemia/lymphoma and diffuse large B-cell lymphoma. It is an approved medicine authorised in the European Union, and is also being studied for other uses.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>tisagenlecleucel</td></tr><tr><td>ATC codes:</td><td>L01XL04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13881&quot;>DB13881</a></td></tr></table></body></html>"));
end Tisagenlecleucel;
