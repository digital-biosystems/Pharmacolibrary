  annotation (Documentation(info = "<html><body><p>Nesiritide, a form of human brain natriuretic peptide, was used as a vasodilator to treat congestive heart failure and cardiac asthma. It has been withdrawn and is no longer used in routine care.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6997373&quot;>Wikidata Q6997373</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nesiritide</td></tr><tr><td>ATC codes:</td><td>C01DX19</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB04899&quot;>DB04899</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/71308561&quot;>71308561</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6997373&quot;>Q6997373</a></td></tr><tr><td>formula:</td><td>C143H244N50O42S4</td></tr><tr><td>molar mass:</td><td>3464.07 g/mol (PubChem)</td></tr></table></body></html>"));
