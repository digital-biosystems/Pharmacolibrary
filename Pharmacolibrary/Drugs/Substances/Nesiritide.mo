  annotation (Documentation(info = "<html><body><p>Nesiritide, a form of human brain natriuretic peptide, was used as a vasodilator to treat congestive heart failure and cardiac asthma. It has been withdrawn and is no longer used in routine care.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6997373\">Wikidata Q6997373</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nesiritide</td></tr><tr><td>ATC codes:</td><td>C01DX19</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB04899\">DB04899</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6997373\">Q6997373</a></td></tr><tr><td>molar mass:</td><td>3464 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>-16.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Nesiritide;
