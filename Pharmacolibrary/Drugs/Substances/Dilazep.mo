  annotation (Documentation(info = "<html><body><p>Dilazep is a vasodilator classified among vasodilators used in cardiac diseases. It appears only as an experimental agent in drug databases, with no marketing authorisation recorded, so its current use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5276700&quot;>Wikidata Q5276700</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dilazep</td></tr><tr><td>ATC codes:</td><td>C01DX10</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13715&quot;>DB13715</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3074&quot;>3074</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:92842&quot;>92842</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5276700&quot;>Q5276700</a></td></tr><tr><td>formula:</td><td>C31H44N2O10</td></tr><tr><td>molar mass:</td><td>604.697 g/mol (PubChem)</td></tr></table></body></html>"));
