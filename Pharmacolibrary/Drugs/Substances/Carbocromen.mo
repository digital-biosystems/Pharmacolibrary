  annotation (Documentation(info = "<html><body><p>Carbocromen (chromonar) is a vasodilator that was used to treat coronary artery disease. It has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5037872\">Wikidata Q5037872</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>carbocromen</td></tr><tr><td>ATC codes:</td><td>C01DX05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13279\">DB13279</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/12604\">12604</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135525\">135525</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5037872\">Q5037872</a></td></tr><tr><td>formula:</td><td>C20H27NO5</td></tr><tr><td>molar mass:</td><td>361.438 g/mol (PubChem CID 12604)</td></tr><tr><td>logP:</td><td>3.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
