  annotation (Documentation(info = "<html><body><p>Zafirlukast is a leukotriene receptor antagonist used to treat asthma. It is an approved medicine, though not authorised in the European Union, and is used as a systemic treatment for obstructive airway disease.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q928378&quot;>Wikidata Q928378</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>zafirlukast</td></tr><tr><td>ATC codes:</td><td>R03DC01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00549&quot;>DB00549</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5717&quot;>5717</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:10100&quot;>10100</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q928378&quot;>Q928378</a></td></tr><tr><td>formula:</td><td>C31H33N3O6S</td></tr><tr><td>molar mass:</td><td>575.68 g/mol (PubChem)</td></tr></table></body></html>"));
