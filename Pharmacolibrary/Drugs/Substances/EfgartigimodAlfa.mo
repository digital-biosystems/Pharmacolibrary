  annotation (Documentation(info = "<html><body><p>Efgartigimod alfa is a selective immunosuppressant antibody used to treat myasthenia gravis and chronic inflammatory demyelinating polyradiculoneuropathy. It is authorised in the European Union and is also being investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q110271677&quot;>Wikidata Q110271677</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>efgartigimod alfa</td></tr><tr><td>ATC codes:</td><td>L04AA58, L04AL01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB15270&quot;>DB15270</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q110271677&quot;>Q110271677</a></td></tr><tr><td>molar mass:</td><td>54000 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end EfgartigimodAlfa;
