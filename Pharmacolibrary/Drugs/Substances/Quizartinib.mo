  annotation (Documentation(info = "<html><body><p>Quizartinib is a protein kinase inhibitor used to treat acute myeloid leukemia. It is an approved medicine, authorised in the European Union, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7272714\">Wikidata Q7272714</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>quizartinib</td></tr><tr><td>ATC codes:</td><td>L01EX11, L01XE</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12874\">DB12874</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/24889392\">24889392</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:90217\">90217</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7272714\">Q7272714</a></td></tr><tr><td>formula:</td><td>C29H32N6O4S</td></tr><tr><td>molar mass:</td><td>560.673 g/mol (PubChem CID 24889392)</td></tr><tr><td>logP:</td><td>5.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
