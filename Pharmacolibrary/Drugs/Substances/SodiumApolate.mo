  annotation (Documentation(info = "<html><body><p>Sodium apolate is a heparinoid polymer classified for topical use in antivaricose (vasoprotective) therapy. It appears only as an experimental drug, with no authorisation records, so its current availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7553298&quot;>Wikidata Q7553298</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sodium apolate</td></tr><tr><td>ATC codes:</td><td>C05BA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13477&quot;>DB13477</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7553298&quot;>Q7553298</a></td></tr></table></body></html>"));
end SodiumApolate;
