  annotation (Documentation(info = "<html><body><p>Tosylchloramide (chloramine T) is a chloramine compound classified as an antiseptic and disinfectant for topical skin use. It is considered investigational and is not an authorised medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q420695\">Wikidata Q420695</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Tosylchloramide</td></tr><tr><td>ATC codes:</td><td>D08AX04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB14708\">DB14708</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/31388\">31388</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q420695\">Q420695</a></td></tr><tr><td>formula:</td><td>C7H8ClNO2S</td></tr><tr><td>molar mass:</td><td>205.656 g/mol (PubChem CID 31388)</td></tr></table></body></html>"));
