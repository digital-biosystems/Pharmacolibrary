within Pharmacolibrary.Drugs.Substances;
package CoagulationFactorVII "coagulation factor VII"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "coagulation factor VII",
    atcCodes = {"B02BD05"},
    drugbankId = "DB13150",
    wikidataId = "Q412850");
  annotation (Documentation(info = "<html><body><p>Coagulation factor VII is a blood clotting protein used to treat or prevent bleeding caused by a lack or defect of this factor. It is an approved medicine, given as a blood coagulation factor product, and is also being studied for further uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q412850&quot;>Wikidata Q412850</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>coagulation factor VII</td></tr><tr><td>ATC codes:</td><td>B02BD05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13150&quot;>DB13150</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q412850&quot;>Q412850</a></td></tr></table></body></html>"));
end CoagulationFactorVII;
