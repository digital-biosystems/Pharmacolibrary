  annotation (Documentation(info = "<html><body><p>Nifuroxazide is an intestinal anti-infective that has been used to treat diarrhoea. It is not authorised in the European Union and is considered investigational in major drug databases, though it remains available in some countries as an antidiarrhoeal.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q822929&quot;>Wikidata Q822929</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nifuroxazide</td></tr><tr><td>ATC codes:</td><td>A07AX03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13855&quot;>DB13855</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5337997&quot;>5337997</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135136&quot;>135136</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q822929&quot;>Q822929</a></td></tr><tr><td>formula:</td><td>C12H9N3O5</td></tr><tr><td>molar mass:</td><td>275.22 g/mol (PubChem)</td></tr></table></body></html>"));
end Nifuroxazide;
