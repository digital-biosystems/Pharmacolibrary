    logP = -2.1);
  annotation (Documentation(info = "<html><body><p>Meldonium is a cardiac therapy agent developed for heart-related conditions such as coronary heart disease. It is considered investigational in major Western databases and is not authorised in the European Union; it is used mainly in Eastern Europe and Russia.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4289752&quot;>Wikidata Q4289752</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>meldonium</td></tr><tr><td>ATC codes:</td><td>C01EB22</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13723&quot;>DB13723</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/123868&quot;>123868</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:131843&quot;>131843</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4289752&quot;>Q4289752</a></td></tr><tr><td>formula:</td><td>C6H14N2O2</td></tr><tr><td>molar mass:</td><td>146.19 g/mol (PubChem)</td></tr></table></body></html>"));
end Meldonium;
