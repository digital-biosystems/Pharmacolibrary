within Pharmacolibrary.Drugs.Substances;
package VonWillebrandFactor "von Willebrand factor"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "von Willebrand factor",
    atcCodes = {"B02BD10"},
    drugbankId = "DB13133",
    wikidataId = "Q412310");
  annotation (Documentation(info = "<html><body><p>Von Willebrand factor is a blood protein used as a medicine to treat bleeding problems, particularly von Willebrand disease. It is an approved treatment, given as a blood coagulation factor product, though its use remains limited to specialised care.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q412310\">Wikidata Q412310</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>von Willebrand factor</td></tr><tr><td>ATC codes:</td><td>B02BD10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13133\">DB13133</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q412310\">Q412310</a></td></tr></table></body></html>"));
end VonWillebrandFactor;
