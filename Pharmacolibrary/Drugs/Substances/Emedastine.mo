  annotation (Documentation(info = "<html><body><p>Emedastine is an antihistamine eye medicine used to treat allergic conjunctivitis. It is authorised in the European Union as an ophthalmic anti-allergic treatment, though its use is limited to eye conditions.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5370305&quot;>Wikidata Q5370305</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>emedastine</td></tr><tr><td>ATC codes:</td><td>S01GX06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01084&quot;>DB01084</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3219&quot;>3219</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4779&quot;>4779</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5370305&quot;>Q5370305</a></td></tr><tr><td>formula:</td><td>C17H26N4O</td></tr><tr><td>molar mass:</td><td>302.422 g/mol (PubChem)</td></tr></table></body></html>"));
