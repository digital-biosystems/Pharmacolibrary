  annotation (Documentation(info = "<html><body><p>Bosentan is used to treat pulmonary arterial hypertension, including that associated with systemic sclerosis. It is authorised in the European Union and widely used, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q419769&quot;>Wikidata Q419769</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>bosentan</td></tr><tr><td>ATC codes:</td><td>C02KX01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00559&quot;>DB00559</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/104865&quot;>104865</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:51450&quot;>51450</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q419769&quot;>Q419769</a></td></tr><tr><td>formula:</td><td>C27H29N5O6S</td></tr><tr><td>molar mass:</td><td>551.618 g/mol (PubChem)</td></tr></table></body></html>"));
