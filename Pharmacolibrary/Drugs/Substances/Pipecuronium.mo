within Pharmacolibrary.Drugs.Substances;
package Pipecuronium "Pipecuronium"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "Pipecuronium",
    atcCodes = {"M03AC06"},
    drugbankId = "DB01338",
    pubchemCid = "50192",
    wikidataId = "Q4363210",
    formula = "C35H62N4O4+2",
    M = 0.602905);
  annotation (Documentation(info = "<html><body><p>Pipecuronium is a peripheral muscle relaxant of the quaternary ammonium type, used to relax muscles during surgery and anaesthesia. It has been withdrawn from use in some countries, though it was approved for a time and has also been studied investigationally.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4363210\">Wikidata Q4363210</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Pipecuronium</td></tr><tr><td>ATC codes:</td><td>M03AC06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01338\">DB01338</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/50192\">50192</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4363210\">Q4363210</a></td></tr><tr><td>formula:</td><td>C35H62N4O4+2</td></tr><tr><td>molar mass:</td><td>602.905 g/mol (PubChem CID 50192)</td></tr></table></body></html>"));
end Pipecuronium;
