  annotation (Documentation(info = "<html><body><p>Fludroxycortide is a potent topical corticosteroid used to treat inflammatory skin conditions such as dermatitis affecting the face, hands, and legs. It is an approved medicine, available in topical skin preparations, sometimes combined with antibiotics.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5462632&quot;>Wikidata Q5462632</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>fludroxycortide</td></tr><tr><td>ATC codes:</td><td>D07AC07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00846&quot;>DB00846</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/15209&quot;>15209</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5462632&quot;>Q5462632</a></td></tr><tr><td>formula:</td><td>C24H33FO6</td></tr><tr><td>molar mass:</td><td>436.52 g/mol (PubChem)</td></tr></table></body></html>"));
