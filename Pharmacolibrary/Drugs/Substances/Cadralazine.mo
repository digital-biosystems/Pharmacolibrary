  annotation (Documentation(info = "<html><body><p>Cadralazine is a hydrazinophthalazine vasodilator that was used as an antihypertensive drug to lower high blood pressure. It is no longer in routine clinical use and is considered an experimental compound today.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3649490\">Wikidata Q3649490</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cadralazine</td></tr><tr><td>ATC codes:</td><td>C02DB04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13452\">DB13452</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2515\">2515</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31331\">31331</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3649490\">Q3649490</a></td></tr><tr><td>formula:</td><td>C12H21N5O3</td></tr><tr><td>molar mass:</td><td>283.332 g/mol (PubChem CID 2515)</td></tr><tr><td>logP:</td><td>1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
