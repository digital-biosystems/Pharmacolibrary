  annotation (Documentation(info = "<html><body><p>Vimseltinib is a protein kinase inhibitor used to treat giant cell tumour of the tendon sheath. It is an approved anticancer medicine authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q106440798\">Wikidata Q106440798</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>vimseltinib</td></tr><tr><td>ATC codes:</td><td>L01EX29</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB17520\">DB17520</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/86267612\">86267612</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q106440798\">Q106440798</a></td></tr><tr><td>formula:</td><td>C23H25N7O2</td></tr><tr><td>molar mass:</td><td>431.5 g/mol (PubChem CID 86267612)</td></tr></table></body></html>"));
