  annotation (Documentation(info = "<html><body><p>Vapreotide is a somatostatin analogue that has been investigated as an analgesic and antineoplastic drug. It remains investigational and is not an approved medicine in the European Union or elsewhere.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4008670\">Wikidata Q4008670</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>vapreotide</td></tr><tr><td>ATC codes:</td><td>H01CB04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB04894\">DB04894</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6918026\">6918026</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4008670\">Q4008670</a></td></tr><tr><td>molar mass:</td><td>1131.4 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>3.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
