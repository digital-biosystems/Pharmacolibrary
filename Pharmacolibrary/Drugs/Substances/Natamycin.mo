    logP = -1.3);
  annotation (Documentation(info = "<html><body><p>Natamycin is an antifungal antibiotic used to treat fungal infections, including eye infections such as conjunctivitis, keratitis and blepharitis, and various fungal diseases like candidiasis and aspergillosis. It is an approved medicine, appears on the WHO essential medicines list, and is used topically in several areas including the mouth, gut, skin, gynecological and ophthalmological applications.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q248466\">Wikidata Q248466</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>natamycin</td></tr><tr><td>ATC codes:</td><td>A01AB10, A07AA03, D01AA02, G01AA02, S01AA10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00826\">DB00826</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5284447\">5284447</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7488\">7488</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q248466\">Q248466</a></td></tr><tr><td>formula:</td><td>C33H47NO13</td></tr><tr><td>molar mass:</td><td>665.733 g/mol (PubChem CID 5284447)</td></tr><tr><td>logP:</td><td>-1.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Natamycin;
