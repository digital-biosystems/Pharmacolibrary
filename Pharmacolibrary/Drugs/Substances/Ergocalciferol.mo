  annotation (Documentation(info = "<html><body><p>Ergocalciferol, a form of vitamin D, is used to treat rickets and hypoparathyroidism. It is an approved medicine and nutraceutical, included on the WHO list of essential medicines, and is widely used as a vitamin D supplement.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q139200&quot;>Wikidata Q139200</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ergocalciferol</td></tr><tr><td>ATC codes:</td><td>A11CC01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00153&quot;>DB00153</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5280793&quot;>5280793</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:28934&quot;>28934</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q139200&quot;>Q139200</a></td></tr><tr><td>formula:</td><td>C28H44O</td></tr><tr><td>molar mass:</td><td>396.659 g/mol (PubChem)</td></tr></table></body></html>"));
