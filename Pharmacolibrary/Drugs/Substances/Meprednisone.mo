  annotation (Documentation(info = "<html><body><p>Meprednisone is a systemic glucocorticoid (corticosteroid) used to treat conditions that respond to anti-inflammatory or immunosuppressive steroid therapy. It is an approved drug, but detailed information on where and how widely it is used is not available.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6817833&quot;>Wikidata Q6817833</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>meprednisone</td></tr><tr><td>ATC codes:</td><td>H02AB15</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09383&quot;>DB09383</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5284587&quot;>5284587</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135573&quot;>135573</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6817833&quot;>Q6817833</a></td></tr><tr><td>formula:</td><td>C22H28O5</td></tr><tr><td>molar mass:</td><td>372.461 g/mol (PubChem)</td></tr></table></body></html>"));
