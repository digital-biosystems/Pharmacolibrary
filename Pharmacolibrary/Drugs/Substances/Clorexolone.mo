within Pharmacolibrary.Drugs.Substances;
package Clorexolone "clorexolone"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "clorexolone",
    atcCodes = {"C03BA12"},
    drugbankId = "DB13617",
    pubchemCid = "16473",
    chebiId = "31421",
    wikidataId = "Q5135140",
    formula = "C14H17ClN2O3S",
    M = 0.328811,
    logP = 2);
  annotation (Documentation(info = "<html><body><p>Clorexolone is a sulfonamide diuretic, a low-ceiling diuretic related to the thiazides, and as such would be used to promote fluid removal in conditions like edema or high blood pressure. It is classed as an experimental drug and is not an established marketed medicine today, so its current availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5135140\">Wikidata Q5135140</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>clorexolone</td></tr><tr><td>ATC codes:</td><td>C03BA12</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13617\">DB13617</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/16473\">16473</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31421\">31421</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5135140\">Q5135140</a></td></tr><tr><td>formula:</td><td>C14H17ClN2O3S</td></tr><tr><td>molar mass:</td><td>328.811 g/mol (PubChem CID 16473)</td></tr><tr><td>logP:</td><td>2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Clorexolone;
