  annotation (Documentation(info = "<html><body><p>Iomeprol is an iodinated, low-osmolar X-ray contrast agent used to improve imaging of body structures during radiological examinations. It is an approved contrast medium and remains in clinical use, mainly in hospital imaging settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6062808\">Wikidata Q6062808</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>iomeprol</td></tr><tr><td>ATC codes:</td><td>V08AB10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11705\">DB11705</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3731\">3731</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31710\">31710</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6062808\">Q6062808</a></td></tr><tr><td>formula:</td><td>C17H22I3N3O8</td></tr><tr><td>molar mass:</td><td>777.076 g/mol (PubChem CID 3731)</td></tr><tr><td>logP:</td><td>-2.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
