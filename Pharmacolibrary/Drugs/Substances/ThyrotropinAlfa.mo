    M = 22.6729);
  annotation (Documentation(info = "<html><body><p>Thyrotropin alfa is a recombinant version of thyroid-stimulating hormone used in the diagnosis and management of thyroid cancer. It is authorised in the European Union and is also approved for veterinary use, with some investigational applications.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q20816877\">Wikidata Q20816877</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>thyrotropin alfa</td></tr><tr><td>ATC codes:</td><td>H01AB01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00024\">DB00024</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q20816877\">Q20816877</a></td></tr><tr><td>molar mass:</td><td>22672.9 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end ThyrotropinAlfa;
