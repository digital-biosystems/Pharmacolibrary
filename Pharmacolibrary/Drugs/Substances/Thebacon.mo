  annotation (Documentation(info = "<html><body><p>Thebacon is an opium-alkaloid derivative classified as a cough suppressant for respiratory cough and cold preparations. It is regarded as an experimental compound and is not in routine clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2787672\">Wikidata Q2787672</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>thebacon</td></tr><tr><td>ATC codes:</td><td>R05DA10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13458\">DB13458</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/11508377\">11508377</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135449\">135449</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2787672\">Q2787672</a></td></tr><tr><td>formula:</td><td>C20H23NO4</td></tr><tr><td>molar mass:</td><td>341.407 g/mol (PubChem CID 11508377)</td></tr><tr><td>logP:</td><td>2.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
