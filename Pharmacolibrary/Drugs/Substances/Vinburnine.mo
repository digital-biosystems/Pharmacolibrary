  annotation (Documentation(info = "<html><body><p>Vinburnine is a peripheral vasodilator, a drug class used to widen blood vessels in conditions of poor circulation. It is not an approved medicine; it is classed as experimental, so it has been studied rather than widely used in routine care.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2526386&quot;>Wikidata Q2526386</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>vinburnine</td></tr><tr><td>ATC codes:</td><td>C04AX17</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13793&quot;>DB13793</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/71203&quot;>71203</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4740&quot;>4740</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2526386&quot;>Q2526386</a></td></tr><tr><td>formula:</td><td>C19H22N2O</td></tr><tr><td>molar mass:</td><td>294.398 g/mol (PubChem)</td></tr></table></body></html>"));
