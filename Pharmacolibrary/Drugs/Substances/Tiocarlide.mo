  annotation (Documentation(info = "<html><body><p>Tiocarlide is a thiocarbamide derivative that was used as a drug for the treatment of tuberculosis. It is currently considered experimental and does not appear to be an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7784652&quot;>Wikidata Q7784652</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tiocarlide</td></tr><tr><td>ATC codes:</td><td>J04AD02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13608&quot;>DB13608</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3001386&quot;>3001386</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135637&quot;>135637</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7784652&quot;>Q7784652</a></td></tr><tr><td>formula:</td><td>C23H32N2O2S</td></tr><tr><td>molar mass:</td><td>400.581 g/mol (PubChem)</td></tr></table></body></html>"));
