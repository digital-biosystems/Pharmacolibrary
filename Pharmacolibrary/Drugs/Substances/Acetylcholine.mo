  annotation (Documentation(info = "<html><body><p>Acetylcholine, a naturally occurring neurotransmitter and cholinergic agonist, is used as a miotic eye medicine in the treatment of glaucoma. It is approved but used only in a narrow ophthalmological setting, mainly in eye surgery, rather than as a widely prescribed drug.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q180623&quot;>Wikidata Q180623</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>acetylcholine</td></tr><tr><td>ATC codes:</td><td>S01EB09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB03128&quot;>DB03128</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/187&quot;>187</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:15355&quot;>15355</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q180623&quot;>Q180623</a></td></tr><tr><td>formula:</td><td>C7H16NO2+</td></tr><tr><td>molar mass:</td><td>146.21 g/mol (PubChem)</td></tr></table></body></html>"));
