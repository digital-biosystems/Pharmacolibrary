  annotation (Documentation(info = "<html><body><p>Sulbactam is an antibiotic that works as a beta-lactamase inhibitor, used in combination with other antibacterials to treat bacterial infections. It is an approved medicine and is used in clinical practice, though it is not an authorised EU medicine via the EMA.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q423393&quot;>Wikidata Q423393</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sulbactam</td></tr><tr><td>ATC codes:</td><td>J01CG01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09324&quot;>DB09324</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/130313&quot;>130313</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9321&quot;>9321</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q423393&quot;>Q423393</a></td></tr><tr><td>formula:</td><td>C8H11NO5S</td></tr><tr><td>molar mass:</td><td>233.238 g/mol (PubChem)</td></tr></table></body></html>"));
