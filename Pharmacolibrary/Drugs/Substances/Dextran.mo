  annotation (Documentation(info = "<html><body><p>Dextran, a glucose polymer, is used as a plasma substitute and as an anticoagulant. It is an approved medicine, also approved for veterinary use, and some forms remain investigational.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q423123\">Wikidata Q423123</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dextran</td></tr><tr><td>ATC codes:</td><td>B05AA05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09255\">DB09255</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q423123\">Q423123</a></td></tr></table></body></html>"));
end Dextran;
