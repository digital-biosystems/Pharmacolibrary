    M = 150.511);
  annotation (Documentation(info = "<html><body><p>Catumaxomab is a monoclonal antibody anticancer drug that was used to treat ascites caused by cancer. It was authorised in the European Union but its marketing authorisation was later withdrawn, so it is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q408155\">Wikidata Q408155</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>catumaxomab</td></tr><tr><td>ATC codes:</td><td>L01FX03, L01XC09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06607\">DB06607</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q408155\">Q408155</a></td></tr><tr><td>molar mass:</td><td>150511 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Catumaxomab;
