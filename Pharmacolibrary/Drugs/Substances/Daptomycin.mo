    logP = -5.1);
  annotation (Documentation(info = "<html><body><p>Daptomycin is an antibiotic used to treat serious bacterial infections, mainly those caused by gram-positive bacteria such as staphylococci, including skin infections, bacteremia, and infective endocarditis. It is an approved medicine authorised in the European Union and is generally used in hospital settings for severe infections.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q418747&quot;>Wikidata Q418747</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>daptomycin</td></tr><tr><td>ATC codes:</td><td>J01XX09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00080&quot;>DB00080</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/16134395&quot;>16134395</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:600103&quot;>600103</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q418747&quot;>Q418747</a></td></tr><tr><td>formula:</td><td>C72H101N17O26</td></tr><tr><td>molar mass:</td><td>1620.69 g/mol (PubChem)</td></tr></table></body></html>"));
end Daptomycin;
