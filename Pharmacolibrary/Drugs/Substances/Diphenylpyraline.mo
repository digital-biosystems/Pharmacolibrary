  annotation (Documentation(info = "<html><body><p>Diphenylpyraline is an antihistamine used to relieve allergy symptoms such as those affecting the respiratory system. It is an approved medicine, but it is not widely used and does not appear to be authorised across the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q411150\">Wikidata Q411150</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>diphenylpyraline</td></tr><tr><td>ATC codes:</td><td>R06AA07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01146\">DB01146</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3103\">3103</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:59788\">59788</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q411150\">Q411150</a></td></tr><tr><td>formula:</td><td>C19H23NO</td></tr><tr><td>molar mass:</td><td>281.399 g/mol (PubChem CID 3103)</td></tr><tr><td>logP:</td><td>3.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
