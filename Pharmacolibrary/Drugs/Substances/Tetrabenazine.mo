    logP = 2.9);
  annotation (Documentation(info = "<html><body><p>Tetrabenazine is a nervous system drug used to treat movement disorders such as Huntington's disease, Tourette syndrome, tardive dyskinesia, and choreic movements. It is an approved medicine, though not authorised by the European Medicines Agency, and is used mainly in specialist care for these conditions.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q413050&quot;>Wikidata Q413050</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tetrabenazine</td></tr><tr><td>ATC codes:</td><td>N07XX06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB04844&quot;>DB04844</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6018&quot;>6018</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:64028&quot;>64028</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q413050&quot;>Q413050</a></td></tr><tr><td>formula:</td><td>C19H27NO3</td></tr><tr><td>molar mass:</td><td>317.429 g/mol (PubChem)</td></tr></table></body></html>"));
end Tetrabenazine;
