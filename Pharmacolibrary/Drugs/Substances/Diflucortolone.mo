  annotation (Documentation(info = "<html><body><p>Diflucortolone is a potent topical corticosteroid used to treat inflammatory skin diseases. It has been withdrawn from use in some markets, though it was once approved as a dermatological preparation.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5275453&quot;>Wikidata Q5275453</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>diflucortolone</td></tr><tr><td>ATC codes:</td><td>D07AC06, D07XC04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09095&quot;>DB09095</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/11954369&quot;>11954369</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5275453&quot;>Q5275453</a></td></tr><tr><td>formula:</td><td>C22H28F2O4</td></tr><tr><td>molar mass:</td><td>394.458 g/mol (PubChem)</td></tr></table></body></html>"));
end Diflucortolone;
