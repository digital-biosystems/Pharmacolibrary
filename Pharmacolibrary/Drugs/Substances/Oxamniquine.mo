  annotation (Documentation(info = "<html><body><p>Oxamniquine is an anthelmintic used to treat schistosomiasis, particularly the intestinal form of the disease. It is an approved medicine and has been included on the WHO list of essential medicines, though it is used less widely than praziquantel.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q682497&quot;>Wikidata Q682497</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>oxamniquine</td></tr><tr><td>ATC codes:</td><td>P02BA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01096&quot;>DB01096</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4612&quot;>4612</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:78416&quot;>78416</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q682497&quot;>Q682497</a></td></tr><tr><td>formula:</td><td>C14H21N3O3</td></tr><tr><td>molar mass:</td><td>279.34 g/mol (PubChem)</td></tr></table></body></html>"));
end Oxamniquine;
