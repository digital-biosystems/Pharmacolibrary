  annotation (Documentation(info = "<html><body><p>Indigo carmine is a blue dye used as a diagnostic agent in tests for kidney function and ureteral injuries. It is an approved drug and is also being studied for investigational uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27162327\">Wikidata Q27162327</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>indigo carmine</td></tr><tr><td>ATC codes:</td><td>V04CH02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11577\">DB11577</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27162327\">Q27162327</a></td></tr><tr><td>molar mass:</td><td>466.4 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end IndigoCarmine;
