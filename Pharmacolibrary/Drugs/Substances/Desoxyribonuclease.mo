within Pharmacolibrary.Drugs.Substances;
package Desoxyribonuclease "desoxyribonuclease"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "desoxyribonuclease",
    atcCodes = {"B06AA10"},
    drugbankId = "DB09551",
    wikidataId = "Q420690");
  annotation (Documentation(info = "<html><body><p>Desoxyribonuclease is an enzyme that breaks down DNA and is used as a hematological agent, for example to help dissolve thickened secretions. It is an approved drug, though its use appears limited rather than widespread.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q420690\">Wikidata Q420690</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>desoxyribonuclease</td></tr><tr><td>ATC codes:</td><td>B06AA10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09551\">DB09551</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q420690\">Q420690</a></td></tr></table></body></html>"));
end Desoxyribonuclease;
