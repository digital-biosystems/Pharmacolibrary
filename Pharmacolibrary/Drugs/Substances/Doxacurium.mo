  annotation (Documentation(info = "<html><body><p>Doxacurium is a peripherally acting muscle relaxant, a long-acting neuromuscular blocking agent used to relax muscles during surgery. It was approved but has been withdrawn and is no longer marketed.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5303681\">Wikidata Q5303681</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Doxacurium</td></tr><tr><td>ATC codes:</td><td>M03AC07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01135\">DB01135</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/60169\">60169</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5303681\">Q5303681</a></td></tr><tr><td>formula:</td><td>C56H78N2O16+2</td></tr><tr><td>molar mass:</td><td>1035.24 g/mol (PubChem CID 60169)</td></tr></table></body></html>"));
end Doxacurium;
