  annotation (Documentation(info = "<html><body><p>Sulfamethizole is a sulfonamide antibiotic used to treat urinary tract infections and other gram-negative bacterial infections. It is an approved medicine, also approved for veterinary use, and appears in products for systemic, topical, eye, and irrigating use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3976824&quot;>Wikidata Q3976824</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sulfamethizole</td></tr><tr><td>ATC codes:</td><td>B05CA04, D06BA04, J01EB02, S01AB01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00576&quot;>DB00576</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5328&quot;>5328</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9331&quot;>9331</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3976824&quot;>Q3976824</a></td></tr><tr><td>formula:</td><td>C9H10N4O2S2</td></tr><tr><td>molar mass:</td><td>270.325 g/mol (PubChem)</td></tr></table></body></html>"));
