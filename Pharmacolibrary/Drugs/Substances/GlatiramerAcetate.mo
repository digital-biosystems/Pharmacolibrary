  annotation (Documentation(info = "<html><body><p>Glatiramer acetate is an immunostimulating medicine used to treat multiple sclerosis. It is an approved drug and remains in use, mainly in North America and other countries outside the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q83053564\">Wikidata Q83053564</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>glatiramer acetate</td></tr><tr><td>ATC codes:</td><td>L03AX13</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB05259\">DB05259</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q83053564\">Q83053564</a></td></tr><tr><td>molar mass:</td><td>7000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
