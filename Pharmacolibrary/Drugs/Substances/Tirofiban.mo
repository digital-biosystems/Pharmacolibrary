  annotation (Documentation(info = "<html><body><p>Tirofiban is a platelet aggregation inhibitor used to treat heart conditions such as myocardial infarction, unstable angina, and coronary artery disease. It is an approved medicine, given by infusion, and is generally restricted to hospital settings for acute cardiac care.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q415366&quot;>Wikidata Q415366</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tirofiban</td></tr><tr><td>ATC codes:</td><td>B01AC17</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00775&quot;>DB00775</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/60947&quot;>60947</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9605&quot;>9605</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q415366&quot;>Q415366</a></td></tr><tr><td>formula:</td><td>C22H36N2O5S</td></tr><tr><td>molar mass:</td><td>440.599 g/mol (PubChem)</td></tr></table></body></html>"));
