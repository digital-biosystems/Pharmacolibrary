  annotation (Documentation(info = "<html><body><p>Primidone is an anticonvulsant drug used to treat epilepsy and tremor. It is an approved medicine, also approved for veterinary use, and remains in use, though it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q420383\">Wikidata Q420383</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>primidone</td></tr><tr><td>ATC codes:</td><td>N03AA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00794\">DB00794</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4909\">4909</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8412\">8412</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q420383\">Q420383</a></td></tr><tr><td>formula:</td><td>C12H14N2O2</td></tr><tr><td>molar mass:</td><td>218.256 g/mol (PubChem CID 4909)</td></tr><tr><td>logP:</td><td>0.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
