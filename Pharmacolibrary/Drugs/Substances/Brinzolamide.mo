  annotation (Documentation(info = "<html><body><p>Brinzolamide is a carbonic anhydrase inhibitor used to treat glaucoma, especially open-angle glaucoma, and ocular hypertension. It is an approved eye medicine, authorised in the European Union for lowering pressure in the eye.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q411517&quot;>Wikidata Q411517</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>brinzolamide</td></tr><tr><td>ATC codes:</td><td>S01EC04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01194&quot;>DB01194</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/68844&quot;>68844</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3176&quot;>3176</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q411517&quot;>Q411517</a></td></tr><tr><td>formula:</td><td>C12H21N3O5S3</td></tr><tr><td>molar mass:</td><td>383.496 g/mol (PubChem)</td></tr></table></body></html>"));
end Brinzolamide;
