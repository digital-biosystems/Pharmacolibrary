within Pharmacolibrary.Drugs.Substances;
package Sacrosidase "sacrosidase"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "sacrosidase",
    atcCodes = {"A16AB06"},
    drugbankId = "DB06760",
    wikidataId = "Q7397389");
  annotation (Documentation(info = "<html><body><p>Sacrosidase is an enzyme medication used to treat sucrase deficiency, a digestive problem in which the body cannot properly break down sucrose. It is an approved medicine, available as an oral enzyme preparation taken with meals.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7397389&quot;>Wikidata Q7397389</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sacrosidase</td></tr><tr><td>ATC codes:</td><td>A16AB06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06760&quot;>DB06760</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7397389&quot;>Q7397389</a></td></tr></table></body></html>"));
end Sacrosidase;
