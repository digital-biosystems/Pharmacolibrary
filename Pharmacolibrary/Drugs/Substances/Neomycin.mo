    logP = -9);
  annotation (Documentation(info = "<html><body><p>Neomycin is an aminoglycoside antibiotic used to treat bacterial infections, applied topically on skin, eyes, and ears, and also in oral intestinal preparations. It is an approved medicine, including veterinary approval, and is used in many topical and local treatment forms.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q423098&quot;>Wikidata Q423098</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>neomycin</td></tr><tr><td>ATC codes:</td><td>A01AB08, A07AA01, B05CA09, D06AX04, J01GB05, R02AB01, S01AA03, S02AA07, S03AA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00994&quot;>DB00994</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/8378&quot;>8378</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7507&quot;>7507</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q423098&quot;>Q423098</a></td></tr><tr><td>formula:</td><td>C23H46N6O13</td></tr><tr><td>molar mass:</td><td>614.65 g/mol (PubChem)</td></tr></table></body></html>"));
