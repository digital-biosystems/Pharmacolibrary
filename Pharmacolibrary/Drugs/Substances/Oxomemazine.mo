  annotation (Documentation(info = "<html><body><p>Oxomemazine is a phenothiazine antihistamine used for allergic and respiratory conditions such as coughs and allergies. It is not an approved medicine today and is considered investigational, with no authorisation in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3359071\">Wikidata Q3359071</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>oxomemazine</td></tr><tr><td>ATC codes:</td><td>R06AD08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13820\">DB13820</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/19396\">19396</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135408\">135408</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3359071\">Q3359071</a></td></tr><tr><td>formula:</td><td>C18H22N2O2S</td></tr><tr><td>molar mass:</td><td>330.446 g/mol (PubChem CID 19396)</td></tr><tr><td>logP:</td><td>3.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
