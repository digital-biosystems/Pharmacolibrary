  annotation (Documentation(info = "<html><body><p>Dichlorobenzyl alcohol is an antiseptic used to relieve sore throat and mouth infections. It is an approved drug, widely available over the counter in throat lozenges and sprays in many countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q209202\">Wikidata Q209202</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dichlorobenzyl alcohol</td></tr><tr><td>ATC codes:</td><td>R02AA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13269\">DB13269</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:48220\">48220</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q209202\">Q209202</a></td></tr><tr><td>formula:</td><td>C7H6Cl2O</td></tr><tr><td>molar mass:</td><td>177.02 g/mol (knowledgebase (DrugBank calculated))</td></tr><tr><td>logP:</td><td>2.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
