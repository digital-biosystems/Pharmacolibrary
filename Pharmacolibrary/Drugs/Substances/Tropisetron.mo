  annotation (Documentation(info = "<html><body><p>Tropisetron is a serotonin antagonist antiemetic used to treat nausea and vomiting caused by chemotherapy. It has been approved in some countries but is no longer available in several markets, and its use is now limited.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q29428\">Wikidata Q29428</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tropisetron</td></tr><tr><td>ATC codes:</td><td>A04AA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11699\">DB11699</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/656665\">656665</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32269\">32269</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q29428\">Q29428</a></td></tr><tr><td>formula:</td><td>C17H20N2O2</td></tr><tr><td>molar mass:</td><td>284.359 g/mol (PubChem CID 656665)</td></tr><tr><td>logP:</td><td>3.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Tropisetron;
