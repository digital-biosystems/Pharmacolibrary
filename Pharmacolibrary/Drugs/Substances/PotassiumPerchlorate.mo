  annotation (Documentation(info = "<html><body><p>Potassium perchlorate is an antithyroid drug used to treat overactive thyroid conditions. It has been withdrawn from use, largely because of serious safety concerns including blood disorders.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q422434\">Wikidata Q422434</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>potassium perchlorate</td></tr><tr><td>ATC codes:</td><td>H03BC01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09418\">DB09418</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/516900\">516900</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q422434\">Q422434</a></td></tr><tr><td>formula:</td><td>ClKO4</td></tr><tr><td>molar mass:</td><td>138.544 g/mol (PubChem CID 516900)</td></tr></table></body></html>"));
end PotassiumPerchlorate;
