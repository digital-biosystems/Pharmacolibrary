  annotation (Documentation(info = "<html><body><p>Aurothioglucose is a gold-based antirheumatic drug that was used to treat rheumatoid arthritis, including juvenile and psoriatic forms, as well as pemphigus. It has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4072449\">Wikidata Q4072449</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>aurothioglucose</td></tr><tr><td>ATC codes:</td><td>M01CB04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09121\">DB09121</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6104\">6104</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:2930\">2930</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4072449\">Q4072449</a></td></tr><tr><td>formula:</td><td>C6H11AuO5S</td></tr><tr><td>molar mass:</td><td>392.179 g/mol (PubChem CID 6104)</td></tr></table></body></html>"));
end Aurothioglucose;
