    M = 2.15955);
  annotation (Documentation(info = "<html><body><p>Motixafortide is an immunostimulant medicine used to help mobilise stem cells from the bone marrow into the blood for collection in cancer patients. It is an approved drug, though it does not appear to be authorised across the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27276305&quot;>Wikidata Q27276305</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>motixafortide</td></tr><tr><td>ATC codes:</td><td>L03AX23</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB14939&quot;>DB14939</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/91865076&quot;>91865076</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:145536&quot;>145536</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27276305&quot;>Q27276305</a></td></tr><tr><td>formula:</td><td>C97H144FN33O19S2</td></tr><tr><td>molar mass:</td><td>2159.55 g/mol (PubChem)</td></tr></table></body></html>"));
end Motixafortide;
