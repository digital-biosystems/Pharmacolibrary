within Pharmacolibrary.Drugs.Substances;
package Melarsoprol "melarsoprol"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "melarsoprol",
    atcCodes = {"P01CD01"},
    drugbankId = "DB12864",
    pubchemCid = "10311",
    chebiId = "6729",
    wikidataId = "Q419753",
    formula = "C12H15AsN6OS2",
    M = 0.398335);
  annotation (Documentation(info = "<html><body><p>Melarsoprol is an arsenic-based antiparasitic drug used to treat sleeping sickness (African trypanosomiasis). It has been listed among WHO essential medicines as a trypanocidal agent, but DrugBank currently classifies it as investigational, so its availability today appears limited.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q419753\">Wikidata Q419753</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>melarsoprol</td></tr><tr><td>ATC codes:</td><td>P01CD01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12864\">DB12864</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/10311\">10311</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6729\">6729</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q419753\">Q419753</a></td></tr><tr><td>formula:</td><td>C12H15AsN6OS2</td></tr><tr><td>molar mass:</td><td>398.335 g/mol (PubChem CID 10311)</td></tr></table></body></html>"));
end Melarsoprol;
