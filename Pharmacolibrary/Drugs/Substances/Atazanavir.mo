  annotation (Documentation(info = "<html><body><p>Atazanavir is an antiviral protease inhibitor used to treat HIV infections. It is an approved medicine, authorised in the European Union, and appears on the WHO essential medicines list, so it is used widely.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q423467\">Wikidata Q423467</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>atazanavir</td></tr><tr><td>ATC codes:</td><td>J05AE08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01072\">DB01072</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/148192\">148192</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:37924\">37924</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q423467\">Q423467</a></td></tr><tr><td>formula:</td><td>C38H52N6O7</td></tr><tr><td>molar mass:</td><td>704.869 g/mol (PubChem CID 148192)</td></tr><tr><td>logP:</td><td>5.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
