  annotation (Documentation(info = "<html><body><p>Sodium sulfate is used as an osmotically acting laxative for constipation and as a sodium-containing mineral supplement. It is an approved drug and also has veterinary approval, though it appears not to be authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q211737&quot;>Wikidata Q211737</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sodium sulfate</td></tr><tr><td>ATC codes:</td><td>A06AD13, A12CA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09472&quot;>DB09472</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/24436&quot;>24436</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32149&quot;>32149</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q211737&quot;>Q211737</a></td></tr><tr><td>formula:</td><td>Na2O4S</td></tr><tr><td>molar mass:</td><td>142.036 g/mol (PubChem)</td></tr></table></body></html>"));
