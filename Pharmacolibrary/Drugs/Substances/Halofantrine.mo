within Pharmacolibrary.Drugs.Substances;
package Halofantrine "halofantrine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "halofantrine",
    atcCodes = {"P01BX01"},
    drugbankId = "DB01218",
    pubchemCid = "37393",
    chebiId = "94392",
    wikidataId = "Q947595",
    formula = "C26H30Cl2F3NO",
    M = 0.500426,
    logP = 8.6);
  annotation (Documentation(info = "<html><body><p>Halofantrine is an antimalarial drug used to treat malaria caused by Plasmodium falciparum and Plasmodium vivax. It is no longer in general use, having been withdrawn, largely because of safety concerns about heart rhythm disturbances.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q947595&quot;>Wikidata Q947595</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>halofantrine</td></tr><tr><td>ATC codes:</td><td>P01BX01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01218&quot;>DB01218</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/37393&quot;>37393</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:94392&quot;>94392</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q947595&quot;>Q947595</a></td></tr><tr><td>formula:</td><td>C26H30Cl2F3NO</td></tr><tr><td>molar mass:</td><td>500.426 g/mol (PubChem)</td></tr></table></body></html>"));
end Halofantrine;
