  annotation (Documentation(info = "<html><body><p>Ceftizoxime is a third-generation cephalosporin antibiotic used to treat bacterial infections such as sepsis, gonorrhea, urinary tract infections, pneumonia, and other gram-negative infections. It has been withdrawn from use in some markets, though it remains approved elsewhere.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1082945\">Wikidata Q1082945</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ceftizoxime</td></tr><tr><td>ATC codes:</td><td>J01DD07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01332\">DB01332</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6533629\">6533629</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:553473\">553473</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1082945\">Q1082945</a></td></tr><tr><td>formula:</td><td>C13H13N5O5S2</td></tr><tr><td>molar mass:</td><td>383.397 g/mol (PubChem CID 6533629)</td></tr></table></body></html>"));
