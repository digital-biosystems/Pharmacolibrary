    logP = 3.8);
  annotation (Documentation(info = "<html><body><p>Deferasirox is an iron chelating agent used to treat iron overload, for example in patients with thalassemia and other anemias requiring repeated transfusions. It is an approved medicine authorised in the European Union, where it is widely used for iron overload, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5251502&quot;>Wikidata Q5251502</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>deferasirox</td></tr><tr><td>ATC codes:</td><td>V03AC03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01609&quot;>DB01609</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5493381&quot;>5493381</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:49005&quot;>49005</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5251502&quot;>Q5251502</a></td></tr><tr><td>formula:</td><td>C21H15N3O4</td></tr><tr><td>molar mass:</td><td>373.361 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Deferasirox;
