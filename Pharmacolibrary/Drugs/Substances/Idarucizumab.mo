    wikidataId = "Q17630273");
  annotation (Documentation(info = "<html><body><p>Idarucizumab is an antidote used to treat haemorrhage in patients taking dabigatran. It is approved and authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q17630273\">Wikidata Q17630273</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>idarucizumab</td></tr><tr><td>ATC codes:</td><td>V03AB37</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09264\">DB09264</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q17630273\">Q17630273</a></td></tr></table></body></html>"));
end Idarucizumab;
