  annotation (Documentation(info = "<html><body><p>Ponatinib is a tyrosine-kinase inhibitor used to treat certain leukemias, including myeloid and lymphoid forms. It is authorised in the European Union and is also being investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q198728&quot;>Wikidata Q198728</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>ponatinib</td></tr><tr><td>ATC codes:</td><td>L01EA05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08901&quot;>DB08901</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/24826799&quot;>24826799</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:78543&quot;>78543</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q198728&quot;>Q198728</a></td></tr><tr><td>formula:</td><td>C29H27F3N6O</td></tr><tr><td>molar mass:</td><td>532.57 g/mol (PubChem)</td></tr></table></body></html>"));
