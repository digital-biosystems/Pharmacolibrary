    M = 0.232239,
    logP = 1.5);
  annotation (Documentation(info = "<html><body><p>Phenobarbital is a barbiturate anticonvulsant used to treat epilepsy and seizures, including status epilepticus and neonatal seizures, and has also been used for sleep problems and anxiety. It remains in use, is listed as an essential medicine by the WHO, and is approved, though today it is used relatively sparingly for epilepsy.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q407241&quot;>Wikidata Q407241</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>phenobarbital</td></tr><tr><td>ATC codes:</td><td>N03AA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01174&quot;>DB01174</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4763&quot;>4763</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8069&quot;>8069</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q407241&quot;>Q407241</a></td></tr><tr><td>formula:</td><td>C12H12N2O3</td></tr><tr><td>molar mass:</td><td>232.239 g/mol (PubChem)</td></tr></table></body></html>"));
end Phenobarbital;
