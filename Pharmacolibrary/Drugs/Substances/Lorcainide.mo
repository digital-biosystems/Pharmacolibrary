  annotation (Documentation(info = "<html><body><p>Lorcainide is a class Ic antiarrhythmic agent developed for treating heart rhythm disorders. It is no longer in routine clinical use and is regarded as an experimental drug.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6678811\">Wikidata Q6678811</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>lorcainide</td></tr><tr><td>ATC codes:</td><td>C01BC07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13653\">DB13653</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/42884\">42884</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135568\">135568</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6678811\">Q6678811</a></td></tr><tr><td>formula:</td><td>C22H27ClN2O</td></tr><tr><td>molar mass:</td><td>370.921 g/mol (PubChem CID 42884)</td></tr><tr><td>logP:</td><td>4.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
