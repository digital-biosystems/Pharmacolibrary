  annotation (Documentation(info = "<html><body><p>Sulfatolamide is a sulfonamide antiinfective classified for gynecological use, as an antiinfective and antiseptic for the genital area. It appears only as an experimental compound, with no evidence of current marketing approval, so its present availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7636191&quot;>Wikidata Q7636191</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sulfatolamide</td></tr><tr><td>ATC codes:</td><td>G01AE01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13547&quot;>DB13547</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3034019&quot;>3034019</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32165&quot;>32165</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7636191&quot;>Q7636191</a></td></tr><tr><td>formula:</td><td>C14H19N5O4S3</td></tr><tr><td>molar mass:</td><td>417.517 g/mol (PubChem)</td></tr></table></body></html>"));
