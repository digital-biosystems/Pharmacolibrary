  annotation (Documentation(info = "<html><body><p>Peginterferon alfa-2b is an antiviral immunostimulant used to treat chronic hepatitis C and melanoma. It has been an approved medicine and is listed among WHO essential medicines, although some of its European marketing authorisations have been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7160789\">Wikidata Q7160789</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>peginterferon alfa-2b</td></tr><tr><td>ATC codes:</td><td>L03AB10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00022\">DB00022</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7160789\">Q7160789</a></td></tr><tr><td>molar mass:</td><td>31000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end PeginterferonAlfa2b;
