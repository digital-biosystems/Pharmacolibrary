within Pharmacolibrary.Drugs.Substances;
package Methoxsalen "methoxsalen"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "methoxsalen",
    atcCodes = {"D05AD02", "D05BA02"},
    drugbankId = "DB00553",
    pubchemCid = "4114",
    chebiId = "18358",
    wikidataId = "Q408570",
    formula = "C12H8O4",
    M = 0.216192,
    logP = 1.9);
  annotation (Documentation(info = "<html><body><p>Methoxsalen is a psoralen used to treat skin conditions such as vitiligo, mycosis fungoides, cutaneous T cell lymphoma, graft-versus-host disease, and acropustulosis. It is an approved drug available in topical and systemic antipsoriatic preparations, and is also being studied for other uses; it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q408570\">Wikidata Q408570</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>methoxsalen</td></tr><tr><td>ATC codes:</td><td>D05AD02, D05BA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00553\">DB00553</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4114\">4114</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:18358\">18358</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q408570\">Q408570</a></td></tr><tr><td>formula:</td><td>C12H8O4</td></tr><tr><td>molar mass:</td><td>216.192 g/mol (PubChem CID 4114)</td></tr><tr><td>logP:</td><td>1.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Methoxsalen;
