  annotation (Documentation(info = "<html><body><p>Golimumab is a monoclonal antibody that blocks tumour necrosis factor alpha and is used to treat inflammatory conditions such as rheumatoid and psoriatic arthritis, ankylosing spondylitis, and ulcerative colitis. It is an approved medicine, authorised in the European Union, and is widely used for these immune-mediated diseases.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q413879&quot;>Wikidata Q413879</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>golimumab</td></tr><tr><td>ATC codes:</td><td>L04AB06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06674&quot;>DB06674</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q413879&quot;>Q413879</a></td></tr><tr><td>molar mass:</td><td>146943 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Golimumab;
