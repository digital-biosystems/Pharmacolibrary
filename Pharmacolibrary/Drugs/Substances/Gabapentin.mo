  annotation (Documentation(info = "<html><body><p>Gabapentin is an anticonvulsant and pain-relieving medicine used for epilepsy and various types of pain and neurological conditions, such as neuropathy, restless legs syndrome, and fibromyalgia. It is an approved medicine in widespread clinical use, and has also been studied for other conditions.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q410352\">Wikidata Q410352</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>gabapentin</td></tr><tr><td>ATC codes:</td><td>N02BF01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00996\">DB00996</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3446\">3446</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:42797\">42797</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q410352\">Q410352</a></td></tr><tr><td>formula:</td><td>C9H17NO2</td></tr><tr><td>molar mass:</td><td>171.24 g/mol (PubChem CID 3446)</td></tr><tr><td>logP:</td><td>-1.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
