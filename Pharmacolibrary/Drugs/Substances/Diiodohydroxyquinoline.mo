  annotation (Documentation(info = "<html><body><p>Diiodohydroxyquinoline (iodoquinol) is an anti-infective drug used against amoebic dysentery and, according to some sources, cystinuria. It remains an approved medicine, classified as a gynecological anti-infective and antiseptic, and is used in various countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5276473\">Wikidata Q5276473</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>diiodohydroxyquinoline</td></tr><tr><td>ATC codes:</td><td>G01AC01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09115\">DB09115</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3728\">3728</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:5950\">5950</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5276473\">Q5276473</a></td></tr><tr><td>formula:</td><td>C9H5I2NO</td></tr><tr><td>molar mass:</td><td>396.945 g/mol (PubChem CID 3728)</td></tr><tr><td>logP:</td><td>3.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
