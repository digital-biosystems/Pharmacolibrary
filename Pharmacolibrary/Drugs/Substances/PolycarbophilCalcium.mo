  annotation (Documentation(info = "<html><body><p>Calcium polycarbophil is a bulk-forming laxative used to treat constipation. It is an approved medicine, available as an over-the-counter remedy for constipation.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q72461273&quot;>Wikidata Q72461273</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>polycarbophil calcium</td></tr><tr><td>ATC codes:</td><td>A06AC08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB14684&quot;>DB14684</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q72461273&quot;>Q72461273</a></td></tr></table></body></html>"));
