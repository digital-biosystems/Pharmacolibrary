    logP = -0.6);
  annotation (Documentation(info = "<html><body><p>Miglustat is a medicine used to treat Gaucher's disease and, in the European Union, is also authorised for Niemann-Pick diseases and glycogen storage disease type II. It is authorised in the European Union and is an approved drug, though it is also being studied for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q425911\">Wikidata Q425911</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>miglustat</td></tr><tr><td>ATC codes:</td><td>A16AX06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00419\">DB00419</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/51634\">51634</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:50381\">50381</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q425911\">Q425911</a></td></tr><tr><td>formula:</td><td>C10H21NO4</td></tr><tr><td>molar mass:</td><td>219.281 g/mol (PubChem CID 51634)</td></tr><tr><td>logP:</td><td>-0.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Miglustat;
