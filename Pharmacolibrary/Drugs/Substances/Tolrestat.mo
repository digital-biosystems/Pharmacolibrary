    logP = 3.7);
  annotation (Documentation(info = "<html><body><p>Tolrestat is an aldose reductase inhibitor that was developed to treat complications of diabetes. It was withdrawn from the market and is no longer used, reportedly because it showed liver toxicity and limited effectiveness.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7814620\">Wikidata Q7814620</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tolrestat</td></tr><tr><td>ATC codes:</td><td>A10XA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB02383\">DB02383</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/53359\">53359</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:48549\">48549</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7814620\">Q7814620</a></td></tr><tr><td>formula:</td><td>C16H14F3NO3S</td></tr><tr><td>molar mass:</td><td>357.346 g/mol (PubChem CID 53359)</td></tr><tr><td>logP:</td><td>3.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Tolrestat;
