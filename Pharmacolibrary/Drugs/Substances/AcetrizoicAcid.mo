    logP = 2.6);
  annotation (Documentation(info = "<html><body><p>Acetrizoic acid is an iodinated, water-soluble X-ray contrast agent that was used to visualise the urinary tract. It has been withdrawn and is no longer used, having been replaced by newer contrast media.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3604494\">Wikidata Q3604494</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>acetrizoic acid</td></tr><tr><td>ATC codes:</td><td>V08AA07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09347\">DB09347</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6806\">6806</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:34521\">34521</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3604494\">Q3604494</a></td></tr><tr><td>formula:</td><td>C9H6I3NO3</td></tr><tr><td>molar mass:</td><td>556.851 g/mol (PubChem CID 6806)</td></tr><tr><td>logP:</td><td>2.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end AcetrizoicAcid;
