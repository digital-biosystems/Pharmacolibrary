  annotation (Documentation(info = "<html><body><p>Iotrolan is an iodinated, water-soluble X-ray contrast medium that was used as a contrast agent in medical imaging. It has been withdrawn and is no longer in clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6064149\">Wikidata Q6064149</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>iotrolan</td></tr><tr><td>ATC codes:</td><td>V08AB06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09487\">DB09487</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3738\">3738</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31715\">31715</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6064149\">Q6064149</a></td></tr><tr><td>formula:</td><td>C37H48I6N6O18</td></tr><tr><td>molar mass:</td><td>1626.21 g/mol (PubChem CID 3738)</td></tr><tr><td>logP:</td><td>-4.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
