within Pharmacolibrary.Drugs.Substances;
package Homatropine "homatropine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "homatropine",
    atcCodes = {"S01FA05"},
    drugbankId = "DB11181",
    pubchemCid = "688024",
    chebiId = "5747",
    wikidataId = "Q1038115",
    formula = "C16H21NO3",
    M = 0.275348,
    logP = 1.9);
  annotation (Documentation(info = "<html><body><p>Homatropine is an anticholinergic eye medicine used to dilate the pupil and temporarily paralyse the eye's focusing muscle, for example during eye examinations and in certain eye conditions. It remains an approved medication and is used in ophthalmic practice, mainly as eye drops in eye-care settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1038115\">Wikidata Q1038115</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>homatropine</td></tr><tr><td>ATC codes:</td><td>S01FA05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11181\">DB11181</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/688024\">688024</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:5747\">5747</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1038115\">Q1038115</a></td></tr><tr><td>formula:</td><td>C16H21NO3</td></tr><tr><td>molar mass:</td><td>275.348 g/mol (PubChem CID 688024)</td></tr><tr><td>logP:</td><td>1.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Homatropine;
