within Pharmacolibrary.Drugs.Substances;
package Homatropine "homatropine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "homatropine",
    atcCodes = {"S01FA05"},
    drugbankId = "DB11181",
    pubchemCid = "688024",
    chebiId = "5747",
    wikidataId = "Q106039245",
    formula = "C16H21NO3",
    M = 0.275348,
    logP = 1.9);
  annotation (Documentation(info = "<html><body><p>Homatropine is an anticholinergic eye medicine used to dilate the pupil and temporarily paralyse the focusing muscle of the eye, for example before eye examinations or treatment of certain eye conditions. It is an approved ophthalmological medicine and is used in eye care, mainly as eye drops in clinical and ophthalmic practice.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q106039245&quot;>Wikidata Q106039245</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>homatropine</td></tr><tr><td>ATC codes:</td><td>S01FA05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11181&quot;>DB11181</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/688024&quot;>688024</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:5747&quot;>5747</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q106039245&quot;>Q106039245</a></td></tr><tr><td>formula:</td><td>C16H21NO3</td></tr><tr><td>molar mass:</td><td>275.348 g/mol (PubChem)</td></tr></table></body></html>"));
end Homatropine;
