  annotation (Documentation(info = "<html><body><p>Gramicidin is an antibiotic used as a local anti-infective, mainly in preparations for the throat. It is an approved medication, typically applied topically rather than taken systemically.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q418980\">Wikidata Q418980</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>gramicidin</td></tr><tr><td>ATC codes:</td><td>R02AB30</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00027\">DB00027</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/45267103\">45267103</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q418980\">Q418980</a></td></tr><tr><td>formula:</td><td>C96H135N19O16</td></tr><tr><td>molar mass:</td><td>1811.25 g/mol (PubChem CID 45267103)</td></tr><tr><td>logP:</td><td>10.7 (Drugs.Common 25.09, not verified)</td></tr></table><p><small>Drugs.Common 25.09 gave 1882.3 g/mol (+3.9 %); replaced by the value above</small></p></body></html>"));
