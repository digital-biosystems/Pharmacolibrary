  annotation (Documentation(info = "<html><body><p>Oxytetracycline is a broad-spectrum tetracycline antibiotic used to treat bacterial infections such as acne, gonorrhea, chlamydia infection, rickettsiosis, and gram-negative bacterial infections. It remains in use for humans and is also veterinary-approved, given by mouth or applied topically to the skin, mouth, eye, or genital area.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q411646\">Wikidata Q411646</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>oxytetracycline</td></tr><tr><td>ATC codes:</td><td>A01AB25, D06AA03, G01AA07, J01AA06, S01AA04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00595\">DB00595</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/54675779\">54675779</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:27701\">27701</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q411646\">Q411646</a></td></tr><tr><td>formula:</td><td>C22H24N2O9</td></tr><tr><td>molar mass:</td><td>460.439 g/mol (PubChem CID 54675779)</td></tr><tr><td>logP:</td><td>-1.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
