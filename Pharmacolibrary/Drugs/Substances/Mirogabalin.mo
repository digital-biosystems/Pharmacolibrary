  annotation (Documentation(info = "<html><body><p>Mirogabalin is a gabapentinoid drug developed as an analgesic for neuropathic pain. It is not authorised in the European Union and is still considered investigational in major drug databases, though it has been approved for use in Japan.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q20706932&quot;>Wikidata Q20706932</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mirogabalin</td></tr><tr><td>ATC codes:</td><td>N02BF03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11825&quot;>DB11825</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/59509752&quot;>59509752</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q20706932&quot;>Q20706932</a></td></tr><tr><td>formula:</td><td>C12H19NO2</td></tr><tr><td>molar mass:</td><td>209.289 g/mol (PubChem)</td></tr></table></body></html>"));
