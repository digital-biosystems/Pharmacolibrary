  annotation (Documentation(info = "<html><body><p>Dopamine is a catecholamine used as a drug to treat conditions such as bradycardia, kidney disease, and neurogenic shock. It is an approved cardiac stimulant, given mainly in hospital settings for circulatory support.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q170304\">Wikidata Q170304</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dopamine</td></tr><tr><td>ATC codes:</td><td>C01CA04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00988\">DB00988</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/681\">681</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:18243\">18243</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q170304\">Q170304</a></td></tr><tr><td>formula:</td><td>C8H11NO2</td></tr><tr><td>molar mass:</td><td>153.181 g/mol (PubChem CID 681)</td></tr><tr><td>logP:</td><td>-1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
