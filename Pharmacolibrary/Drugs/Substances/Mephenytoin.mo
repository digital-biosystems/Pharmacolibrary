    logP = 1.5);
  annotation (Documentation(info = "<html><body><p>Mephenytoin is a hydantoin anticonvulsant that was used to treat temporal lobe epilepsy and tonic–clonic seizures. It has been withdrawn and is no longer in clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1175385\">Wikidata Q1175385</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mephenytoin</td></tr><tr><td>ATC codes:</td><td>N03AB04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00532\">DB00532</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4060\">4060</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6757\">6757</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1175385\">Q1175385</a></td></tr><tr><td>formula:</td><td>C12H14N2O2</td></tr><tr><td>molar mass:</td><td>218.256 g/mol (PubChem CID 4060)</td></tr><tr><td>logP:</td><td>1.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Mephenytoin;
