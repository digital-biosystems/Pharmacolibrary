    logP = -1);
  annotation (Documentation(info = "<html><body><p>Idoxuridine is an antiviral nucleoside analogue that was used to treat herpes simplex virus keratitis, an eye infection. It has been withdrawn from use, having been superseded by newer antiviral eye treatments.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q409765&quot;>Wikidata Q409765</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>idoxuridine</td></tr><tr><td>ATC codes:</td><td>D06BB01, J05AB02, S01AD01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00249&quot;>DB00249</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5905&quot;>5905</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:147675&quot;>147675</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q409765&quot;>Q409765</a></td></tr><tr><td>formula:</td><td>C9H11IN2O5</td></tr><tr><td>molar mass:</td><td>354.096 g/mol (PubChem)</td></tr></table></body></html>"));
end Idoxuridine;
