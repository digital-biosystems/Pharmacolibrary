  annotation (Documentation(info = "<html><body><p>Inebilizumab is a monoclonal antibody used to treat neuromyelitis optica. It is an approved immunosuppressant authorised in the European Union, though not yet widely used.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q25326696\">Wikidata Q25326696</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>inebilizumab</td></tr><tr><td>ATC codes:</td><td>L04AG10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12530\">DB12530</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q25326696\">Q25326696</a></td></tr><tr><td>molar mass:</td><td>149000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
