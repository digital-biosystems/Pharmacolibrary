within Pharmacolibrary.Drugs.Substances;
package Dydrogesterone "dydrogesterone"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "dydrogesterone",
    atcCodes = {"G03DB01"},
    drugbankId = "DB00378",
    pubchemCid = "9051",
    chebiId = "31527",
    wikidataId = "Q4161380",
    formula = "C21H28O2",
    M = 0.312453,
    logP = 3.8);
  annotation (Documentation(info = "<html><body><p>Dydrogesterone is a progestogen (a synthetic progesterone-like hormone) used for conditions related to progesterone deficiency, such as menstrual and gynaecological disorders, and in combination with estrogens for hormone therapy. It remains an approved medicine and is used in many countries, mainly in Europe and elsewhere outside the United States, both alone and in fixed or sequential combinations with estrogens.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4161380&quot;>Wikidata Q4161380</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dydrogesterone</td></tr><tr><td>ATC codes:</td><td>G03DB01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00378&quot;>DB00378</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/9051&quot;>9051</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31527&quot;>31527</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4161380&quot;>Q4161380</a></td></tr><tr><td>formula:</td><td>C21H28O2</td></tr><tr><td>molar mass:</td><td>312.453 g/mol (PubChem)</td></tr></table></body></html>"));
end Dydrogesterone;
