  annotation (Documentation(info = "<html><body><p>Propafenone is an antiarrhythmic medicine used to treat heart rhythm problems such as atrial fibrillation and supraventricular tachycardia. It is an approved medication and remains in use for these cardiac arrhythmias.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q662511&quot;>Wikidata Q662511</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>propafenone</td></tr><tr><td>ATC codes:</td><td>C01BC03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01182&quot;>DB01182</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4932&quot;>4932</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:63619&quot;>63619</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q662511&quot;>Q662511</a></td></tr><tr><td>formula:</td><td>C21H27NO3</td></tr><tr><td>molar mass:</td><td>341.451 g/mol (PubChem)</td></tr></table></body></html>"));
