  annotation (Documentation(info = "<html><body><p>Sequifenadine is an antihistamine for systemic use, historically used to treat allergic conditions. It is considered experimental and does not appear to be authorised in the European Union; its current availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4418107&quot;>Wikidata Q4418107</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sequifenadine</td></tr><tr><td>ATC codes:</td><td>R06AX32</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13566&quot;>DB13566</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/42553&quot;>42553</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4418107&quot;>Q4418107</a></td></tr><tr><td>formula:</td><td>C22H27NO</td></tr><tr><td>molar mass:</td><td>321.464 g/mol (PubChem)</td></tr></table></body></html>"));
