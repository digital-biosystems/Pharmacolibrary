  annotation (Documentation(info = "<html><body><p>Kebuzone is a non-steroidal anti-inflammatory drug of the butylpyrazolidine group, developed for inflammatory and rheumatic conditions. It is not an established marketed medicine today; it is listed as investigational, with no authorisation by the European Medicines Agency.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1105900\">Wikidata Q1105900</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>kebuzone</td></tr><tr><td>ATC codes:</td><td>M01AA06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08940\">DB08940</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3824\">3824</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31749\">31749</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1105900\">Q1105900</a></td></tr><tr><td>formula:</td><td>C19H18N2O3</td></tr><tr><td>molar mass:</td><td>322.364 g/mol (PubChem CID 3824)</td></tr><tr><td>logP:</td><td>1.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
