  annotation (Documentation(info = "<html><body><p>Piroxicam is a non-steroidal anti-inflammatory drug used to treat inflammatory and rheumatic conditions such as osteoarthritis, rheumatoid arthritis, and ankylosing spondylitis. It is an approved medicine, available in oral and topical forms for joint and muscular pain, and it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q408676\">Wikidata Q408676</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>piroxicam</td></tr><tr><td>ATC codes:</td><td>M01AC01, M02AA07, S01BC06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00554\">DB00554</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/54676228\">54676228</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8249\">8249</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q408676\">Q408676</a></td></tr><tr><td>formula:</td><td>C15H13N3O4S</td></tr><tr><td>molar mass:</td><td>331.346 g/mol (PubChem CID 54676228)</td></tr><tr><td>logP:</td><td>3.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
