    M = 9.0461);
  annotation (Documentation(info = "<html><body><p>Eplontersen is an antisense oligonucleotide used to treat familial amyloid polyneuropathy, a hereditary form of nerve damage. It is authorised in the European Union and is a newer medicine, so it is not yet widely used.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q123663227&quot;>Wikidata Q123663227</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>eplontersen</td></tr><tr><td>ATC codes:</td><td>N07XX21</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB16199&quot;>DB16199</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q123663227&quot;>Q123663227</a></td></tr><tr><td>molar mass:</td><td>9046.1 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Eplontersen;
