    logP = 1.2);
  annotation (Documentation(info = "<html><body><p>Triamcinolone is a glucocorticoid used to treat inflammation and related conditions such as dermatoses, keloids, joint problems, and macular edema. It is widely used in many forms, including skin, oral, nasal, inhaled, eye, and systemic preparations, and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1074056\">Wikidata Q1074056</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>triamcinolone</td></tr><tr><td>ATC codes:</td><td>A01AC01, C05AA12, D07AB09, D07XB02, H02AB08, R01AD11, R03BA06, S01BA05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00620\">DB00620</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/31307\">31307</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9667\">9667</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1074056\">Q1074056</a></td></tr><tr><td>formula:</td><td>C21H27FO6</td></tr><tr><td>molar mass:</td><td>394.439 g/mol (PubChem CID 31307)</td></tr><tr><td>logP:</td><td>1.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
