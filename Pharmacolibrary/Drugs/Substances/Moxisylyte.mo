    logP = 3.2);
  annotation (Documentation(info = "<html><body><p>Moxisylyte (thymoxamine) is an alpha-blocking vasodilator used to improve peripheral blood flow and to treat erectile dysfunction. It is an approved medicine, though not authorised in the European Union, and is used only in a limited number of countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q646045\">Wikidata Q646045</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>moxisylyte</td></tr><tr><td>ATC codes:</td><td>C04AX10, G04BE06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09205\">DB09205</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4260\">4260</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:94754\">94754</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q646045\">Q646045</a></td></tr><tr><td>formula:</td><td>C16H25NO3</td></tr><tr><td>molar mass:</td><td>279.38 g/mol (PubChem CID 4260)</td></tr><tr><td>logP:</td><td>3.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Moxisylyte;
