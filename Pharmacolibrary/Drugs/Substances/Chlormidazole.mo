  annotation (Documentation(info = "<html><body><p>Chlormidazole is an imidazole antifungal drug that was used topically to treat fungal skin infections. It is no longer in routine use and is considered an experimental compound.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5102982\">Wikidata Q5102982</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>chlormidazole</td></tr><tr><td>ATC codes:</td><td>D01AC04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13611\">DB13611</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/71821\">71821</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135058\">135058</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5102982\">Q5102982</a></td></tr><tr><td>formula:</td><td>C15H13ClN2</td></tr><tr><td>molar mass:</td><td>256.733 g/mol (PubChem CID 71821)</td></tr><tr><td>logP:</td><td>4.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
