  annotation (Documentation(info = "<html><body><p>Mibefradil is a calcium channel blocker that was used to treat high blood pressure and angina. It has been withdrawn from the market because it caused dangerous interactions with other medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6827783&quot;>Wikidata Q6827783</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mibefradil</td></tr><tr><td>ATC codes:</td><td>C08CX01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01388&quot;>DB01388</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/60663&quot;>60663</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6920&quot;>6920</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6827783&quot;>Q6827783</a></td></tr><tr><td>formula:</td><td>C29H38FN3O3</td></tr><tr><td>molar mass:</td><td>495.639 g/mol (PubChem)</td></tr></table></body></html>"));
