  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "azithromycin",
    atcCodes = {"J01FA10", "S01AA26"},
    drugbankId = "DB00207",
    pubchemCid = "447043",
    chebiId = "2955",
    wikidataId = "Q165399",
