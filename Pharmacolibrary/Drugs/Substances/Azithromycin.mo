    logP = 4);
  annotation (Documentation(info = "<html><body><p>Azithromycin is a macrolide antibiotic used to treat many bacterial infections, including pneumonia, bronchitis, sinusitis, otitis media, chlamydia infection, and skin infections. It is widely used around the world and appears on the WHO list of essential medicines; it is also available as an eye drop for eye infections.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q165399\">Wikidata Q165399</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>azithromycin</td></tr><tr><td>ATC codes:</td><td>J01FA10, S01AA26</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00207\">DB00207</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/447043\">447043</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:2955\">2955</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q165399\">Q165399</a></td></tr><tr><td>formula:</td><td>C38H72N2O12</td></tr><tr><td>molar mass:</td><td>748.996 g/mol (PubChem CID 447043)</td></tr><tr><td>logP:</td><td>4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
