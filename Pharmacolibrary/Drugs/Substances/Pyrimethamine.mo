  annotation (Documentation(info = "<html><body><p>Pyrimethamine is an antiprotozoal medicine used to treat malaria, including falciparum malaria, and toxoplasmosis. It is an approved medicine, also approved for veterinary use, and appears on the WHO essential medicines list, so it remains in use worldwide.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q421072&quot;>Wikidata Q421072</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pyrimethamine</td></tr><tr><td>ATC codes:</td><td>P01BD01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00205&quot;>DB00205</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4993&quot;>4993</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8673&quot;>8673</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q421072&quot;>Q421072</a></td></tr><tr><td>formula:</td><td>C12H13ClN4</td></tr><tr><td>molar mass:</td><td>248.714 g/mol (PubChem)</td></tr></table></body></html>"));
