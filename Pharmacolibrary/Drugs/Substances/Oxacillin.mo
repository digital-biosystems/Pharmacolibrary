    logP = 2.4);
  annotation (Documentation(info = "<html><body><p>Oxacillin is a penicillin antibiotic used to treat staphylococcal infections, including sepsis, urinary tract infections, cellulitis, osteomyelitis, infective endocarditis, and bacterial meningitis. It is an approved beta-lactamase–resistant penicillin, though it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q418725&quot;>Wikidata Q418725</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>oxacillin</td></tr><tr><td>ATC codes:</td><td>J01CF04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00713&quot;>DB00713</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6196&quot;>6196</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7809&quot;>7809</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q418725&quot;>Q418725</a></td></tr><tr><td>formula:</td><td>C19H19N3O5S</td></tr><tr><td>molar mass:</td><td>401.437 g/mol (PubChem)</td></tr></table></body></html>"));
