  annotation (Documentation(info = "<html><body><p>Flupentixol is a thioxanthene antipsychotic used to treat schizophrenia and depression. It remains an approved medicine and is used in psychiatric care, though not authorised by the European Medicines Agency.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q420350&quot;>Wikidata Q420350</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>flupentixol</td></tr><tr><td>ATC codes:</td><td>N05AF01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00875&quot;>DB00875</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5281881&quot;>5281881</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:10454&quot;>10454</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q420350&quot;>Q420350</a></td></tr><tr><td>formula:</td><td>C23H25F3N2OS</td></tr><tr><td>molar mass:</td><td>434.52 g/mol (PubChem)</td></tr></table></body></html>"));
