  annotation (Documentation(info = "<html><body><p>Flupentixol is an antipsychotic of the thioxanthene class used to treat psychotic disorders such as schizophrenia. It remains an approved medicine and is used in many countries, though it has not been authorised centrally in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27164953\">Wikidata Q27164953</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>flupentixol</td></tr><tr><td>ATC codes:</td><td>N05AF01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00875\">DB00875</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5281881\">5281881</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:10454\">10454</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27164953\">Q27164953</a></td></tr><tr><td>formula:</td><td>C23H25F3N2OS</td></tr><tr><td>molar mass:</td><td>434.52 g/mol (PubChem CID 5281881)</td></tr><tr><td>logP:</td><td>4.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
