  annotation (Documentation(info = "<html><body><p>Rabeprazole is a proton-pump inhibitor used to treat acid-related conditions such as gastroesophageal reflux disease, duodenal ulcer, and Zollinger–Ellison syndrome. It is an approved medication and remains in use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3515&quot;>Wikidata Q3515</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>rabeprazole</td></tr><tr><td>ATC codes:</td><td>A02BC04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01129&quot;>DB01129</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5029&quot;>5029</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8768&quot;>8768</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3515&quot;>Q3515</a></td></tr><tr><td>formula:</td><td>C18H21N3O3S</td></tr><tr><td>molar mass:</td><td>359.444 g/mol (PubChem)</td></tr></table></body></html>"));
