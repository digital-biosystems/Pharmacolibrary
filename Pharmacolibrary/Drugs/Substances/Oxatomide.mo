  annotation (Documentation(info = "<html><body><p>Oxatomide is an antihistamine (H1 antagonist) with anti-allergic activity, used to treat allergic conditions such as asthma and allergy-related disorders. It is an approved medicine, but it is not authorised in the European Union and appears to be used only in a limited number of countries.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2071515&quot;>Wikidata Q2071515</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>oxatomide</td></tr><tr><td>ATC codes:</td><td>R06AE06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12877&quot;>DB12877</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4615&quot;>4615</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31943&quot;>31943</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2071515&quot;>Q2071515</a></td></tr><tr><td>formula:</td><td>C27H30N4O</td></tr><tr><td>molar mass:</td><td>426.564 g/mol (PubChem)</td></tr></table></body></html>"));
end Oxatomide;
