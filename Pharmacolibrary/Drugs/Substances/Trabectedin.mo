  annotation (Documentation(info = "<html><body><p>Trabectedin is an alkylating anticancer medicine used to treat sarcoma and ovarian cancer. It is authorised in the European Union and is used in cancer treatment, though one related marketing application was refused.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2637746\">Wikidata Q2637746</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>trabectedin</td></tr><tr><td>ATC codes:</td><td>L01CX01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB05109\">DB05109</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/108150\">108150</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:84050\">84050</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2637746\">Q2637746</a></td></tr><tr><td>formula:</td><td>C39H43N3O11S</td></tr><tr><td>molar mass:</td><td>761.843 g/mol (PubChem CID 108150)</td></tr><tr><td>logP:</td><td>3.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Trabectedin;
