  annotation (Documentation(info = "<html><body><p>Tripelennamine is an antihistamine used to treat allergic conditions such as urticaria. It is an approved drug, used both systemically for allergies and topically on the skin to relieve itching, and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q415203&quot;>Wikidata Q415203</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tripelennamine</td></tr><tr><td>ATC codes:</td><td>D04AA04, R06AC04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00792&quot;>DB00792</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5587&quot;>5587</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9741&quot;>9741</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q415203&quot;>Q415203</a></td></tr><tr><td>formula:</td><td>C16H21N3</td></tr><tr><td>molar mass:</td><td>255.365 g/mol (PubChem)</td></tr></table></body></html>"));
