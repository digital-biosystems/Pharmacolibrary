    logP = -1.5);
  annotation (Documentation(info = "<html><body><p>Goserelin is a synthetic hormone analogue used to treat endometriosis and, as a hormonal antineoplastic agent, certain hormone-dependent cancers. It is an approved medicine, given as endocrine therapy, and is also being studied for further investigational uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1992653\">Wikidata Q1992653</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>goserelin</td></tr><tr><td>ATC codes:</td><td>L02AE03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00014\">DB00014</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5311128\">5311128</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:5523\">5523</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1992653\">Q1992653</a></td></tr><tr><td>formula:</td><td>C59H84N18O14</td></tr><tr><td>molar mass:</td><td>1269.43 g/mol (PubChem CID 5311128)</td></tr><tr><td>logP:</td><td>-1.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Goserelin;
