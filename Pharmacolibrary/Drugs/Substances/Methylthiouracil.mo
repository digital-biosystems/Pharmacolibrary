  annotation (Documentation(info = "<html><body><p>Methylthiouracil is an antithyroid drug of the thiouracil class that has been used to treat thyrotoxicosis. It is currently regarded as an experimental compound and is not an established marketed medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6824062&quot;>Wikidata Q6824062</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>methylthiouracil</td></tr><tr><td>ATC codes:</td><td>H03BA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13644&quot;>DB13644</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/667493&quot;>667493</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:82346&quot;>82346</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6824062&quot;>Q6824062</a></td></tr><tr><td>formula:</td><td>C5H6N2OS</td></tr><tr><td>molar mass:</td><td>142.176 g/mol (PubChem)</td></tr></table></body></html>"));
