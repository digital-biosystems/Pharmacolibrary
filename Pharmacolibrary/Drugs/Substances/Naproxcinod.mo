  annotation (Documentation(info = "<html><body><p>Naproxcinod, a nitric oxide–donating derivative of naproxen, was developed as a non-steroidal anti-inflammatory drug for treating inflammatory and rheumatic conditions. It remained investigational and was never marketed; its marketing application in the European Union was withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3335996&quot;>Wikidata Q3335996</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>naproxcinod</td></tr><tr><td>ATC codes:</td><td>M01AE18</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06682&quot;>DB06682</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/9884642&quot;>9884642</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:76254&quot;>76254</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3335996&quot;>Q3335996</a></td></tr><tr><td>formula:</td><td>C18H21NO6</td></tr><tr><td>molar mass:</td><td>347.367 g/mol (PubChem)</td></tr></table></body></html>"));
