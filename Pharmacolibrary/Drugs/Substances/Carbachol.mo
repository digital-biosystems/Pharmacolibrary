    M = 0.182648);
  annotation (Documentation(info = "<html><body><p>Carbachol is a cholinergic (parasympathomimetic) drug used to treat glaucoma, acting as a miotic in eye drops. It is an approved medicine, used mainly in ophthalmology for glaucoma, and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q419401\">Wikidata Q419401</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>carbachol</td></tr><tr><td>ATC codes:</td><td>N07AB01, S01EB02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00411\">DB00411</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5831\">5831</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q419401\">Q419401</a></td></tr><tr><td>formula:</td><td>C6H15ClN2O2</td></tr><tr><td>molar mass:</td><td>182.648 g/mol (PubChem CID 5831)</td></tr></table></body></html>"));
end Carbachol;
