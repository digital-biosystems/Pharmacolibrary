within Pharmacolibrary.Drugs.Substances;
package Carbachol "carbachol"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "carbachol",
    atcCodes = {"N07AB01", "S01EB02"},
    drugbankId = "DB00411",
    pubchemCid = "5831",
