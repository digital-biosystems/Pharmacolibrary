  annotation (Documentation(info = "<html><body><p>Etoposide is a chemotherapy drug used to treat many cancers, including testicular cancer, lung small cell carcinoma, lymphomas, leukemias, and several other tumors. It is an approved medicine and appears on the WHO essential medicines list, so it is widely used in cancer care, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q418817\">Wikidata Q418817</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>etoposide</td></tr><tr><td>ATC codes:</td><td>L01CB01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00773\">DB00773</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/36462\">36462</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4911\">4911</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q418817\">Q418817</a></td></tr><tr><td>formula:</td><td>C29H32O13</td></tr><tr><td>molar mass:</td><td>588.562 g/mol (PubChem CID 36462)</td></tr><tr><td>logP:</td><td>0.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
