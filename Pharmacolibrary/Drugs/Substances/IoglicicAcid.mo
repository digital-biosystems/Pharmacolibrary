    logP = 1.2);
  annotation (Documentation(info = "<html><body><p>Ioglicic acid is an iodinated, water-soluble, high-osmolar X-ray contrast medium used to improve visibility of body structures on imaging scans. It appears to be only experimental and is not an established marketed medicine; its current availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6062355\">Wikidata Q6062355</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ioglicic acid</td></tr><tr><td>ATC codes:</td><td>V08AA06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13701\">DB13701</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135999\">135999</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6062355\">Q6062355</a></td></tr><tr><td>formula:</td><td>C13H12I3N3O5</td></tr><tr><td>molar mass:</td><td>670.968 g/mol (knowledgebase (DrugBank calculated))</td></tr><tr><td>logP:</td><td>1.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end IoglicicAcid;
