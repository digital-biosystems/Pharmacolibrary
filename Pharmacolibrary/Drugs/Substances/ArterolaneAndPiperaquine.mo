within Pharmacolibrary.Drugs.Substances;
package ArterolaneAndPiperaquine "arterolane and piperaquine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "arterolane and piperaquine",
    atcCodes = {"P01BX02"},
    drugbankId = "DB13941",
    logP = 5.27);
  annotation (Documentation(info = "<html><body><p>This fixed-dose combination of arterolane and piperaquine is an antimalarial medicine used to treat malaria. It is approved and used in some countries where malaria is endemic, notably India, though it is not authorised in the European Union.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>arterolane and piperaquine</td></tr><tr><td>ATC codes:</td><td>P01BX02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13941&quot;>DB13941</a></td></tr></table></body></html>"));
end ArterolaneAndPiperaquine;
