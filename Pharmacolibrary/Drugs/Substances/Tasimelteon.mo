    logP = 2.2);
  annotation (Documentation(info = "<html><body><p>Tasimelteon is a melatonin receptor agonist used to treat circadian rhythm sleep disorders. It is authorised in the European Union and is not widely used, being a niche treatment for sleep disorders.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7687250\">Wikidata Q7687250</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>tasimelteon</td></tr><tr><td>ATC codes:</td><td>N05CH03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09071\">DB09071</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/10220503\">10220503</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:79042\">79042</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7687250\">Q7687250</a></td></tr><tr><td>formula:</td><td>C15H19NO2</td></tr><tr><td>molar mass:</td><td>245.322 g/mol (PubChem CID 10220503)</td></tr><tr><td>logP:</td><td>2.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Tasimelteon;
