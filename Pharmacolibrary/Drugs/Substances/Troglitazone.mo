  annotation (Documentation(info = "<html><body><p>Troglitazone is a thiazolidinedione anti-diabetic medicine that was used to lower blood sugar in people with diabetes. It has been withdrawn from the market because it caused serious liver damage in some patients.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7844989&quot;>Wikidata Q7844989</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>troglitazone</td></tr><tr><td>ATC codes:</td><td>A10BG01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00197&quot;>DB00197</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5591&quot;>5591</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9753&quot;>9753</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7844989&quot;>Q7844989</a></td></tr><tr><td>formula:</td><td>C24H27NO5S</td></tr><tr><td>molar mass:</td><td>441.542 g/mol (PubChem)</td></tr></table></body></html>"));
