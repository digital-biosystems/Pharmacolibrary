  annotation (Documentation(info = "<html><body><p>Sterculia (karaya gum) is a bulk-forming laxative used to treat constipation. It is an approved drug, though it appears to be a niche product rather than a widely marketed medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q421167&quot;>Wikidata Q421167</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sterculia</td></tr><tr><td>ATC codes:</td><td>A06AC03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB10535&quot;>DB10535</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q421167&quot;>Q421167</a></td></tr></table></body></html>"));
end Sterculia;
