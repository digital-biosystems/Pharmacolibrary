  annotation (Documentation(info = "<html><body><p>Pranoprofen is a non-steroidal anti-inflammatory drug used as an ophthalmological antiinflammatory agent, mainly in eye care. It is considered investigational in DrugBank and has no European Union authorisation, though it is used in some countries as eye drops.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7238394\">Wikidata Q7238394</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pranoprofen</td></tr><tr><td>ATC codes:</td><td>S01BC09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13514\">DB13514</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4888\">4888</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32040\">32040</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7238394\">Q7238394</a></td></tr><tr><td>formula:</td><td>C15H13NO3</td></tr><tr><td>molar mass:</td><td>255.273 g/mol (PubChem CID 4888)</td></tr><tr><td>logP:</td><td>2.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
