  annotation (Documentation(info = "<html><body><p>Pecilocin is an antifungal antibiotic used topically against dermatomycosis (fungal skin infections). It is not an established marketed medicine and remains at an experimental stage of development.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1231814\">Wikidata Q1231814</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pecilocin</td></tr><tr><td>ATC codes:</td><td>D01AA04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13459\">DB13459</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5282176\">5282176</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32289\">32289</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1231814\">Q1231814</a></td></tr><tr><td>formula:</td><td>C17H25NO3</td></tr><tr><td>molar mass:</td><td>291.391 g/mol (PubChem CID 5282176)</td></tr><tr><td>logP:</td><td>2.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
