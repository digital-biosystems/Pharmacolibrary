    M = 0.700791,
    logP = 4.6);
  annotation (Documentation(info = "<html><body><p>Posaconazole is an antifungal drug used to treat fungal infections such as aspergillosis and other mycoses, including candidiasis and coccidioidomycosis. It is an approved medicine with authorised products in the European Union, and is also veterinary-approved and investigated for additional uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q906453\">Wikidata Q906453</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>posaconazole</td></tr><tr><td>ATC codes:</td><td>J02AC04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01263\">DB01263</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/468595\">468595</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:64355\">64355</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q906453\">Q906453</a></td></tr><tr><td>formula:</td><td>C37H42F2N8O4</td></tr><tr><td>molar mass:</td><td>700.791 g/mol (PubChem CID 468595)</td></tr><tr><td>logP:</td><td>4.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Posaconazole;
