  annotation (Documentation(info = "<html><body><p>Protionamide is an antituberculous drug used to treat tuberculosis. It is classified for treatment of tuberculosis, both alone and in combination products, though some sources also list it as withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q866657\">Wikidata Q866657</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>protionamide</td></tr><tr><td>ATC codes:</td><td>J04AD01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12667\">DB12667</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/666418\">666418</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32066\">32066</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q866657\">Q866657</a></td></tr><tr><td>formula:</td><td>C9H12N2S</td></tr><tr><td>molar mass:</td><td>180.269 g/mol (PubChem CID 666418)</td></tr><tr><td>logP:</td><td>1.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
