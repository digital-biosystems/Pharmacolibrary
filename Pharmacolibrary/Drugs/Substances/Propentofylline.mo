  annotation (Documentation(info = "<html><body><p>Propentofylline is a xanthine-derivative compound studied as a neuroprotective agent for nervous-system disorders. It remains experimental and is not an approved medicine; no marketing authorisation is recorded in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2888695\">Wikidata Q2888695</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>propentofylline</td></tr><tr><td>ATC codes:</td><td>N06BC02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06479\">DB06479</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4938\">4938</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32061\">32061</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2888695\">Q2888695</a></td></tr><tr><td>formula:</td><td>C15H22N4O3</td></tr><tr><td>molar mass:</td><td>306.366 g/mol (PubChem CID 4938)</td></tr><tr><td>logP:</td><td>0.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
