  annotation (Documentation(info = "<html><body><p>Orgotein (bovine superoxide dismutase) is an antiinflammatory drug used for inflammatory and rheumatic conditions. It is not approved for human use and is used mainly in veterinary medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3885767\">Wikidata Q3885767</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>orgotein</td></tr><tr><td>ATC codes:</td><td>M01AX14</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11444\">DB11444</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3885767\">Q3885767</a></td></tr><tr><td>molar mass:</td><td>515.7 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Orgotein;
