within Pharmacolibrary.Drugs.Substances;
package InsulinAspart "insulin aspart"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "insulin aspart",
    atcCodes = {"A10AB05", "A10AD05"},
    drugbankId = "DB01306",
    wikidataId = "Q2754775",
    M = 5.832);
  annotation (Documentation(info = "<html><body><p>Insulin aspart is a fast-acting insulin analogue used to treat diabetes, including type-1 diabetes and high blood sugar. It is widely used and authorised in the European Union, available both alone and in combination with longer-acting insulins.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2754775\">Wikidata Q2754775</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>insulin aspart</td></tr><tr><td>ATC codes:</td><td>A10AB05, A10AD05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01306\">DB01306</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2754775\">Q2754775</a></td></tr><tr><td>molar mass:</td><td>5832 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end InsulinAspart;
