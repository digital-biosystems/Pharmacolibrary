  annotation (Documentation(info = "<html><body><p>Insulin aspart is a fast-acting insulin analogue used to treat diabetes mellitus. It is widely used, with several products authorised in the European Union, both alone and in combination with longer-acting insulins.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q16252338&quot;>Wikidata Q16252338</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>insulin aspart</td></tr><tr><td>ATC codes:</td><td>A10AB05, A10AD05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01306&quot;>DB01306</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/16132418&quot;>16132418</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q16252338&quot;>Q16252338</a></td></tr><tr><td>formula:</td><td>C256H387N65O79S6</td></tr><tr><td>molar mass:</td><td>5831.65 g/mol (PubChem)</td></tr></table></body></html>"));
