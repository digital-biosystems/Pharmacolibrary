within Pharmacolibrary.Drugs.Substances;
package Dimeticone "dimeticone"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "dimeticone",
    atcCodes = {"P03AX05"},
    drugbankId = "DB11074",
    wikidataId = "Q411955");
  annotation (Documentation(info = "<html><body><p>Dimeticone, a silicone polymer, is used as an ectoparasiticide, for example to treat head lice infestations. It is an approved medicine and remains in use, generally applied topically to the skin or hair.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q411955&quot;>Wikidata Q411955</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dimeticone</td></tr><tr><td>ATC codes:</td><td>P03AX05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11074&quot;>DB11074</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q411955&quot;>Q411955</a></td></tr></table></body></html>"));
end Dimeticone;
