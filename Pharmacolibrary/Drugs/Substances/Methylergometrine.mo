within Pharmacolibrary.Drugs.Substances;
package Methylergometrine "methylergometrine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "methylergometrine",
    atcCodes = {"G02AB01"},
    drugbankId = "DB00353",
    pubchemCid = "8226",
    chebiId = "92607",
    wikidataId = "Q424477",
    formula = "C20H25N3O2",
    M = 0.339439,
    logP = 2.3);
  annotation (Documentation(info = "<html><body><p>Methylergometrine is a uterotonic ergot alkaloid used to prevent and treat excessive bleeding after childbirth by making the uterus contract. It is an approved medicine, used mainly in obstetric care for postpartum haemorrhage, and is also available combined with oxytocin.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q424477&quot;>Wikidata Q424477</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>methylergometrine</td></tr><tr><td>ATC codes:</td><td>G02AB01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00353&quot;>DB00353</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/8226&quot;>8226</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:92607&quot;>92607</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q424477&quot;>Q424477</a></td></tr><tr><td>formula:</td><td>C20H25N3O2</td></tr><tr><td>molar mass:</td><td>339.439 g/mol (PubChem)</td></tr></table></body></html>"));
end Methylergometrine;
