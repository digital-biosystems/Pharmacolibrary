    logP = 2.8);
  annotation (Documentation(info = "<html><body><p>Mebendazole is an anthelmintic used to treat intestinal worm infections such as ascariasis, enterobiasis, trichuriasis, and hookworm disease. It is widely used and appears on the WHO list of essential medicines, and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q422194\">Wikidata Q422194</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mebendazole</td></tr><tr><td>ATC codes:</td><td>P02CA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00643\">DB00643</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4030\">4030</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6704\">6704</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q422194\">Q422194</a></td></tr><tr><td>formula:</td><td>C16H13N3O3</td></tr><tr><td>molar mass:</td><td>295.298 g/mol (PubChem CID 4030)</td></tr><tr><td>logP:</td><td>2.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Mebendazole;
