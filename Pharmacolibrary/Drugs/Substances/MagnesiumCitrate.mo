  annotation (Documentation(info = "<html><body><p>Magnesium citrate is used as a laxative for constipation and as a magnesium supplement. It is widely available as an approved medicine, and is also used as an irrigating solution.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4177438&quot;>Wikidata Q4177438</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>magnesium citrate</td></tr><tr><td>ATC codes:</td><td>A06AD19, A12CC04, B05CB03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11110&quot;>DB11110</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6099959&quot;>6099959</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:131391&quot;>131391</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4177438&quot;>Q4177438</a></td></tr><tr><td>formula:</td><td>C12H10Mg3O14</td></tr><tr><td>molar mass:</td><td>451.113 g/mol (PubChem)</td></tr></table></body></html>"));
