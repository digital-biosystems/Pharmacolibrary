within Pharmacolibrary.Drugs.Substances;
package MagnesiumCitrate "magnesium citrate"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "magnesium citrate",
    atcCodes = {"A06AD19", "A12CC04", "B05CB03"},
    drugbankId = "DB11110",
    pubchemCid = "6099959",
    chebiId = "131391",
    wikidataId = "Q45044",
    formula = "C12H10Mg3O14",
    M = 0.451113);
  annotation (Documentation(info = "<html><body><p>Magnesium citrate is used as an osmotic laxative for constipation, as a magnesium mineral supplement, and as an irrigating salt solution. It is an approved medicine and is generally widely available, though it has not been centrally authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q45044\">Wikidata Q45044</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>magnesium citrate</td></tr><tr><td>ATC codes:</td><td>A06AD19, A12CC04, B05CB03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11110\">DB11110</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6099959\">6099959</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:131391\">131391</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q45044\">Q45044</a></td></tr><tr><td>formula:</td><td>C12H10Mg3O14</td></tr><tr><td>molar mass:</td><td>451.113 g/mol (PubChem CID 6099959)</td></tr></table></body></html>"));
end MagnesiumCitrate;
