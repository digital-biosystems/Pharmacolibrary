  annotation (Documentation(info = "<html><body><p>Vanzacaftor is a CFTR corrector used, in combination with other medicines, to treat cystic fibrosis. It has been approved and is used for cystic fibrosis, though it is a recently introduced option.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Vanzacaftor</td></tr><tr><td>ATC codes:</td><td>R07AX33</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB18373&quot;>DB18373</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/139399801&quot;>139399801</a></td></tr><tr><td>formula:</td><td>C32H39N7O4S</td></tr><tr><td>molar mass:</td><td>617.769 g/mol (PubChem)</td></tr></table></body></html>"));
