    logP = 2.6);
  annotation (Documentation(info = "<html><body><p>Phentolamine is an alpha-blocking vasodilator used to treat high blood pressure, including hypertensive emergencies, and to manage tissue damage from extravasation. It remains an approved medicine, used in specialised settings such as hospitals rather than widely in routine care.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q420360\">Wikidata Q420360</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>phentolamine</td></tr><tr><td>ATC codes:</td><td>C04AB01, V03AB36</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00692\">DB00692</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5775\">5775</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8081\">8081</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q420360\">Q420360</a></td></tr><tr><td>formula:</td><td>C17H19N3O</td></tr><tr><td>molar mass:</td><td>281.359 g/mol (PubChem CID 5775)</td></tr><tr><td>logP:</td><td>2.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Phentolamine;
