  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "phentolamine",
    atcCodes = {"C04AB01", "V03AB36"},
    drugbankId = "DB00692",
    pubchemCid = "5775",
    chebiId = "8081",
    wikidataId = "Q420360",
