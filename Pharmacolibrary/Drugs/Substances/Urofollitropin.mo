  annotation (Documentation(info = "<html><body><p>Urofollitropin is a gonadotropin used to treat ovarian disease, including polyendocrine metabolic ovarian syndrome, by stimulating ovulation. It was approved for human and veterinary use but has been withdrawn and is no longer available.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4006490\">Wikidata Q4006490</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>urofollitropin</td></tr><tr><td>ATC codes:</td><td>G03GA04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00094\">DB00094</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4006490\">Q4006490</a></td></tr><tr><td>molar mass:</td><td>980.2 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>-1.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
