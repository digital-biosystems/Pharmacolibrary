  annotation (Documentation(info = "<html><body><p>Urofollitropin is a gonadotropin (follicle-stimulating hormone preparation) used to stimulate ovulation in the treatment of infertility. It has been withdrawn from use, having previously been an approved medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q72515910&quot;>Wikidata Q72515910</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>urofollitropin</td></tr><tr><td>ATC codes:</td><td>G03GA04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00094&quot;>DB00094</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q72515910&quot;>Q72515910</a></td></tr><tr><td>molar mass:</td><td>980.2 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
