within Pharmacolibrary.Drugs.Substances;
package GinkgoFolium "Ginkgo folium"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "Ginkgo folium",
    atcCodes = {"N06DX02"},
    drugbankId = "DB01381",
    wikidataId = "Q104444041");
  annotation (Documentation(info = "<html><body><p>Ginkgo biloba leaf extract is a herbal medicine used for dementia and other cognitive disorders. It is widely available as a nutraceutical and approved product, used mainly in Europe for memory and circulation problems.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q104444041\">Wikidata Q104444041</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Ginkgo folium</td></tr><tr><td>ATC codes:</td><td>N06DX02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01381\">DB01381</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q104444041\">Q104444041</a></td></tr></table></body></html>"));
end GinkgoFolium;
