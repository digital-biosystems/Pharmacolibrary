  annotation (Documentation(info = "<html><body><p>Aluminium chlorohydrate is used in medicated dressings with anti-infective properties and in drugs affecting bone structure and mineralisation. It is an approved drug, though no European Union authorisation is recorded.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q138227\">Wikidata Q138227</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>aluminium chlorohydrate</td></tr><tr><td>ATC codes:</td><td>D09AA08, M05BX02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11573\">DB11573</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/71586946\">71586946</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q138227\">Q138227</a></td></tr><tr><td>formula:</td><td>Al2ClH7O6</td></tr><tr><td>molar mass:</td><td>192.464 g/mol (PubChem CID 71586946)</td></tr><tr><td>logP:</td><td>-0.65 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end AluminiumChlorohydrate;
