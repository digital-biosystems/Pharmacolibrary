  annotation (Documentation(info = "<html><body><p>Ubrogepant is a CGRP receptor antagonist used for the acute treatment of migraine headache. It is an approved medicine, mainly used in the United States; it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27273878&quot;>Wikidata Q27273878</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ubrogepant</td></tr><tr><td>ATC codes:</td><td>N02CD04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB15328&quot;>DB15328</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/68748835&quot;>68748835</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27273878&quot;>Q27273878</a></td></tr><tr><td>formula:</td><td>C29H26F3N5O3</td></tr><tr><td>molar mass:</td><td>549.553 g/mol (PubChem)</td></tr></table></body></html>"));
