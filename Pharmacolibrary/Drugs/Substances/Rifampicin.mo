    logP = 4.9);
  annotation (Documentation(info = "<html><body><p>Rifampicin is an antibiotic used to treat tuberculosis, including pulmonary and miliary disease and tuberculous meningitis, as well as leprosy and some staphylococcal infections. It is widely used worldwide and appears on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q422652\">Wikidata Q422652</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>rifampicin</td></tr><tr><td>ATC codes:</td><td>J04AB02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01045\">DB01045</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/135398735\">135398735</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q422652\">Q422652</a></td></tr><tr><td>formula:</td><td>C43H58N4O12</td></tr><tr><td>molar mass:</td><td>822.953 g/mol (PubChem CID 135398735)</td></tr><tr><td>logP:</td><td>4.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
