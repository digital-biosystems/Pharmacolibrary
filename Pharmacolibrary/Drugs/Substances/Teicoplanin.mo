  annotation (Documentation(info = "<html><body><p>Teicoplanin is a glycopeptide antibiotic used to treat serious infections caused by gram-positive bacteria. It is an approved medicine used mainly in Europe and some other countries, typically given by injection, often in hospital settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2731762\">Wikidata Q2731762</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>teicoplanin</td></tr><tr><td>ATC codes:</td><td>J01XA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06149\">DB06149</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/133065662\">133065662</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:29687\">29687</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2731762\">Q2731762</a></td></tr><tr><td>formula:</td><td>C88H97Cl2N9O33</td></tr><tr><td>molar mass:</td><td>1879.67 g/mol (PubChem CID 133065662)</td></tr><tr><td>logP:</td><td>0.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
