  annotation (Documentation(info = "<html><body><p>Alirocumab is a monoclonal antibody used to treat dyslipidemias, including conditions such as hyperlipoproteinemia type V and arteriosclerosis. It is authorised in the European Union and is used as a lipid-modifying agent.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4726914\">Wikidata Q4726914</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>alirocumab</td></tr><tr><td>ATC codes:</td><td>C10AX14</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09302\">DB09302</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4726914\">Q4726914</a></td></tr><tr><td>molar mass:</td><td>146000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Alirocumab;
