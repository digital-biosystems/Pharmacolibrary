  annotation (Documentation(info = "<html><body><p>Alirocumab is a monoclonal antibody used to treat dyslipidemias, including conditions such as hyperlipoproteinemia type V and arteriosclerosis. It is authorised in the European Union and is used as a lipid-modifying agent.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4726914&quot;>Wikidata Q4726914</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>alirocumab</td></tr><tr><td>ATC codes:</td><td>C10AX14</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09302&quot;>DB09302</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/88214187&quot;>88214187</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4726914&quot;>Q4726914</a></td></tr><tr><td>formula:</td><td>C3H9Na2O6P</td></tr><tr><td>molar mass:</td><td>218.053 g/mol (PubChem)</td></tr></table></body></html>"));
