  annotation (Documentation(info = "<html><body><p>Acrivastine is a non-sedating antihistamine used to treat urticaria and other allergic conditions. It is an approved medicine, available in some countries such as the United Kingdom, typically as an over-the-counter allergy remedy.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q342745&quot;>Wikidata Q342745</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>acrivastine</td></tr><tr><td>ATC codes:</td><td>R06AX18</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09488&quot;>DB09488</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5284514&quot;>5284514</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:83168&quot;>83168</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q342745&quot;>Q342745</a></td></tr><tr><td>formula:</td><td>C22H24N2O2</td></tr><tr><td>molar mass:</td><td>348.446 g/mol (PubChem)</td></tr></table></body></html>"));
