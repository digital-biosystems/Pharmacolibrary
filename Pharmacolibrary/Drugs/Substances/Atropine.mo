    logP = 1.8);
  annotation (Documentation(info = "<html><body><p>Atropine is a belladonna alkaloid used for conditions such as bradycardia and cardiac arrest, uveitis, gastric ulcer, and as a mydriatic in eye care. It is widely used, appears on the WHO essential medicines list, is approved for human and veterinary use, and is authorised in the European Union for myopia.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q26272\">Wikidata Q26272</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>atropine</td></tr><tr><td>ATC codes:</td><td>A03BA01, S01FA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00572\">DB00572</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/174174\">174174</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:78734\">78734</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q26272\">Q26272</a></td></tr><tr><td>formula:</td><td>C17H23NO3</td></tr><tr><td>molar mass:</td><td>289.375 g/mol (PubChem CID 174174)</td></tr><tr><td>logP:</td><td>1.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Atropine;
