    wikidataId = "Q408014");
  annotation (Documentation(info = "<html><body><p>Chondroitin sulfate is a sulfated glycosaminoglycan used as a medication, mainly for joint problems such as osteoarthritis. It is approved and widely available, often sold as a dietary supplement, and is also being studied for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q408014\">Wikidata Q408014</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>chondroitin sulfate</td></tr><tr><td>ATC codes:</td><td>M01AX25</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09301\">DB09301</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q408014\">Q408014</a></td></tr></table></body></html>"));
end ChondroitinSulfate;
