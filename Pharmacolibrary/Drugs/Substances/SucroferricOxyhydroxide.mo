  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "sucroferric oxyhydroxide",
    atcCodes = {"V03AE05"},
    drugbankId = "DB09146",
    pubchemCid = "91663255",
    wikidataId = "Q27888379",
    formula = "C12H29Fe5Na2O23",
    M = 0.866546,
    logP = 0);
  annotation (Documentation(info = "<html><body><p>Sucroferric oxyhydroxide is used to treat hyperphosphatemia, high phosphate levels in the blood, typically in people on dialysis. It is an approved medicine and is used in clinical practice, though the available facts do not specify the regions where it is authorised.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27888379&quot;>Wikidata Q27888379</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sucroferric oxyhydroxide</td></tr><tr><td>ATC codes:</td><td>V03AE05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09146&quot;>DB09146</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/91663255&quot;>91663255</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27888379&quot;>Q27888379</a></td></tr><tr><td>formula:</td><td>C12H29Fe5Na2O23</td></tr><tr><td>molar mass:</td><td>866.546 g/mol (PubChem)</td></tr></table></body></html>"));
end SucroferricOxyhydroxide;
