  annotation (Documentation(info = "<html><body><p>Sucroferric oxyhydroxide is a medicine used to lower high phosphate levels in the blood (hyperphosphatemia). It is an approved drug, though detailed information on where and how widely it is used is not available in the given facts.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q18386075\">Wikidata Q18386075</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sucroferric oxyhydroxide</td></tr><tr><td>ATC codes:</td><td>V03AE05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09146\">DB09146</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/91663255\">91663255</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q18386075\">Q18386075</a></td></tr><tr><td>formula:</td><td>C12H29Fe5Na2O23</td></tr><tr><td>molar mass:</td><td>866.546 g/mol (PubChem CID 91663255)</td></tr></table></body></html>"));
end SucroferricOxyhydroxide;
