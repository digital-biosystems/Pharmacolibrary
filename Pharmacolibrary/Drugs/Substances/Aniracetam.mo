  annotation (Documentation(info = "<html><body><p>Aniracetam is a nootropic compound that has been studied as a cognitive enhancer and for depression. It remains investigational and is not an approved medicine in the European Union, though it is sold as a dietary supplement in some places.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q417630&quot;>Wikidata Q417630</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>aniracetam</td></tr><tr><td>ATC codes:</td><td>N06BX11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB04599&quot;>DB04599</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2196&quot;>2196</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:47943&quot;>47943</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q417630&quot;>Q417630</a></td></tr><tr><td>formula:</td><td>C12H13NO3</td></tr><tr><td>molar mass:</td><td>219.24 g/mol (PubChem)</td></tr></table></body></html>"));
