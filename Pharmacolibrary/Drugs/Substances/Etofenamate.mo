  annotation (Documentation(info = "<html><body><p>Etofenamate is a non-steroidal anti-inflammatory drug used topically for joint and muscular pain. It is applied to the skin as a topical anti-inflammatory preparation; its current availability is unclear, as it is listed as investigational and has no European Union authorisation.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q414378\">Wikidata Q414378</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>etofenamate</td></tr><tr><td>ATC codes:</td><td>M02AA06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08984\">DB08984</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/35375\">35375</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:94731\">94731</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q414378\">Q414378</a></td></tr><tr><td>formula:</td><td>C18H18F3NO4</td></tr><tr><td>molar mass:</td><td>369.339 g/mol (PubChem CID 35375)</td></tr><tr><td>logP:</td><td>4.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
