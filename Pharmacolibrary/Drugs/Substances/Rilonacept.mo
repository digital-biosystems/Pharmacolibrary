  annotation (Documentation(info = "<html><body><p>Rilonacept is an anti-inflammatory interleukin inhibitor used for pericarditis and cryopyrin-associated periodic syndromes. It is approved and in use, mainly in the United States, but its marketing applications in the European Union were withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7334300&quot;>Wikidata Q7334300</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>rilonacept</td></tr><tr><td>ATC codes:</td><td>L04AC04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06372&quot;>DB06372</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7334300&quot;>Q7334300</a></td></tr><tr><td>molar mass:</td><td>251000 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Rilonacept;
