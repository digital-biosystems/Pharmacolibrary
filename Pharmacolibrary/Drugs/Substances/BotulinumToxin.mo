  annotation (Documentation(info = "<html><body><p>Botulinum toxin type B is a muscle-relaxing protein medication used to treat dystonia, including torticollis. It is an approved drug, though one product has been withdrawn in the European Union, and it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q15709005\">Wikidata Q15709005</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>botulinum toxin</td></tr><tr><td>ATC codes:</td><td>M03AX01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00042\">DB00042</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q15709005\">Q15709005</a></td></tr><tr><td>molar mass:</td><td>150804 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end BotulinumToxin;
