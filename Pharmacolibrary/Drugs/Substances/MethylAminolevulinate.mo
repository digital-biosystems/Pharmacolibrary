  annotation (Documentation(info = "<html><body><p>Methyl aminolevulinate is a photosensitizer used in photodynamic therapy, mainly for certain skin lesions. It is an approved medicine and is also being studied for further uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q619603&quot;>Wikidata Q619603</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>methyl aminolevulinate</td></tr><tr><td>ATC codes:</td><td>L01XD03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00992&quot;>DB00992</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/157922&quot;>157922</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:724125&quot;>724125</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q619603&quot;>Q619603</a></td></tr><tr><td>formula:</td><td>C6H11NO3</td></tr><tr><td>molar mass:</td><td>145.158 g/mol (PubChem)</td></tr></table></body></html>"));
