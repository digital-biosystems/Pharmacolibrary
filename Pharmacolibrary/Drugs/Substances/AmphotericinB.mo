within Pharmacolibrary.Drugs.Substances;
package AmphotericinB "amphotericin B"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "amphotericin B",
    atcCodes = {"A01AB04", "A07AA07", "G01AA03", "J02AA01"},
    drugbankId = "DB00681",
    pubchemCid = "5280965",
    chebiId = "2682",
    wikidataId = "Q412223",
    formula = "C47H73NO17",
    M = 0.924091);
  annotation (Documentation(info = "<html><body><p>Amphotericin B is an antifungal antibiotic used to treat serious fungal infections such as aspergillosis, candidiasis, cryptococcosis, histoplasmosis, and blastomycosis, as well as visceral leishmaniasis. It is widely used and appears on the WHO list of essential medicines, given systemically and also locally in oral, intestinal, and gynecological preparations.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q412223\">Wikidata Q412223</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>amphotericin B</td></tr><tr><td>ATC codes:</td><td>A01AB04, A07AA07, G01AA03, J02AA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00681\">DB00681</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5280965\">5280965</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:2682\">2682</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q412223\">Q412223</a></td></tr><tr><td>formula:</td><td>C47H73NO17</td></tr><tr><td>molar mass:</td><td>924.091 g/mol (PubChem CID 5280965)</td></tr></table></body></html>"));
end AmphotericinB;
