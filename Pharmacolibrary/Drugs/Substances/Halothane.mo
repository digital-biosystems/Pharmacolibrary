    logP = 2.3);
  annotation (Documentation(info = "<html><body><p>Halothane is a halogenated inhalational general anaesthetic that was also used for its bronchodilating effect in asthma, including status asthmaticus. It has been withdrawn from human use in many countries, largely because of liver toxicity, though it remains approved for veterinary anaesthesia.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q32921\">Wikidata Q32921</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>halothane</td></tr><tr><td>ATC codes:</td><td>N01AB01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01159\">DB01159</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3562\">3562</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:5615\">5615</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q32921\">Q32921</a></td></tr><tr><td>formula:</td><td>C2HBrClF3</td></tr><tr><td>molar mass:</td><td>197.378 g/mol (PubChem CID 3562)</td></tr><tr><td>logP:</td><td>2.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Halothane;
