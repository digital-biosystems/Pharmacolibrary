  annotation (Documentation(info = "<html><body><p>Plazomicin is an aminoglycoside antibacterial used to treat serious bacterial infections. It is an approved medicine, but it is not authorised in the European Union and carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q15426988\">Wikidata Q15426988</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>plazomicin</td></tr><tr><td>ATC codes:</td><td>J01GB14</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12615\">DB12615</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/42613186\">42613186</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q15426988\">Q15426988</a></td></tr><tr><td>formula:</td><td>C25H48N6O10</td></tr><tr><td>molar mass:</td><td>592.691 g/mol (PubChem CID 42613186)</td></tr><tr><td>logP:</td><td>-6.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
