  annotation (Documentation(info = "<html><body><p>Xenon, a noble gas, has been used as an inhalational general anaesthetic and as a diagnostic agent. It remains an investigational anaesthetic rather than an established marketed drug.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1106\">Wikidata Q1106</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>xenon</td></tr><tr><td>ATC codes:</td><td>N01AX15, V04CX12</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13453\">DB13453</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/23991\">23991</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:49957\">49957</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1106\">Q1106</a></td></tr><tr><td>formula:</td><td>Xe</td></tr><tr><td>molar mass:</td><td>131.29 g/mol (PubChem CID 23991)</td></tr></table></body></html>"));
