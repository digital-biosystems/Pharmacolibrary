    logP = 2.8);
  annotation (Documentation(info = "<html><body><p>Betaxolol is a selective beta blocker used to treat high blood pressure and to lower pressure in the eye in open-angle glaucoma and ocular hypertension. It is an approved medicine, available both as a cardiovascular drug and as an eye preparation for glaucoma.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q794162\">Wikidata Q794162</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>betaxolol</td></tr><tr><td>ATC codes:</td><td>C07AB05, S01ED02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00195\">DB00195</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2369\">2369</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3082\">3082</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q794162\">Q794162</a></td></tr><tr><td>formula:</td><td>C18H29NO3</td></tr><tr><td>molar mass:</td><td>307.434 g/mol (PubChem CID 2369)</td></tr><tr><td>logP:</td><td>2.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Betaxolol;
