  annotation (Documentation(info = "<html><body><p>Isoflurane is an inhalational general anaesthetic used to keep patients unconscious during surgery, and it has also been used for severe asthma attacks. It is widely used worldwide, appears on the WHO essential medicines list, and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q413918\">Wikidata Q413918</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>isoflurane</td></tr><tr><td>ATC codes:</td><td>N01AB06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00753\">DB00753</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3763\">3763</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6015\">6015</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q413918\">Q413918</a></td></tr><tr><td>formula:</td><td>C3H2ClF5O</td></tr><tr><td>molar mass:</td><td>184.488 g/mol (PubChem CID 3763)</td></tr><tr><td>logP:</td><td>2.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
