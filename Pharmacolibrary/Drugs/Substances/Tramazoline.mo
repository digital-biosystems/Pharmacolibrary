  annotation (Documentation(info = "<html><body><p>Tramazoline is a sympathomimetic drug classified as a nasal decongestant for topical use. It is not an approved medicine in the European Union and is considered investigational, so it does not appear to be in widespread clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q412102\">Wikidata Q412102</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tramazoline</td></tr><tr><td>ATC codes:</td><td>R01AA09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13064\">DB13064</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5524\">5524</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134893\">134893</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q412102\">Q412102</a></td></tr><tr><td>formula:</td><td>C13H17N3</td></tr><tr><td>molar mass:</td><td>215.3 g/mol (PubChem CID 5524)</td></tr><tr><td>logP:</td><td>2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
