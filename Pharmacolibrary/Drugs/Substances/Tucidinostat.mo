  annotation (Documentation(info = "<html><body><p>Tucidinostat (also called chidamide) is an investigational anticancer drug that works as a histone deacetylase inhibitor. It is not authorised in the European Union and remains under investigation rather than in routine clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q19903814&quot;>Wikidata Q19903814</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tucidinostat</td></tr><tr><td>ATC codes:</td><td>L01XH06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06334&quot;>DB06334</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/12136798&quot;>12136798</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135918&quot;>135918</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q19903814&quot;>Q19903814</a></td></tr><tr><td>formula:</td><td>C22H19FN4O2</td></tr><tr><td>molar mass:</td><td>390.418 g/mol (PubChem)</td></tr></table></body></html>"));
