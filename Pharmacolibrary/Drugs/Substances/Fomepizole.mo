  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "fomepizole",
    atcCodes = {"V03AB34"},
    drugbankId = "DB01213",
    pubchemCid = "3406",
    chebiId = "5141",
    wikidataId = "Q416410",
