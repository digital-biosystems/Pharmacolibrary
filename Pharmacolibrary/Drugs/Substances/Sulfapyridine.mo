within Pharmacolibrary.Drugs.Substances;
package Sulfapyridine "sulfapyridine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "sulfapyridine",
    atcCodes = {"J01EB04"},
    drugbankId = "DB00891",
    pubchemCid = "5336",
    chebiId = "132842",
    wikidataId = "Q3976827",
    formula = "C11H11N3O2S",
    M = 0.249288);
  annotation (Documentation(info = "<html><body><p>Sulfapyridine is a sulfonamide antibiotic that has been used to treat certain skin conditions, including dermatitis herpetiformis, bullous pemphigoid, pyoderma gangrenosum, and subcorneal pustular dermatosis. It is no longer in general use, as it has been withdrawn from the market.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3976827\">Wikidata Q3976827</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sulfapyridine</td></tr><tr><td>ATC codes:</td><td>J01EB04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00891\">DB00891</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5336\">5336</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:132842\">132842</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3976827\">Q3976827</a></td></tr><tr><td>formula:</td><td>C11H11N3O2S</td></tr><tr><td>molar mass:</td><td>249.288 g/mol (PubChem CID 5336)</td></tr></table></body></html>"));
end Sulfapyridine;
