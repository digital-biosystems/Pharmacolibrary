within Pharmacolibrary.Drugs.Substances;
package Minoxidil "minoxidil"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "minoxidil",
    atcCodes = {"C02DC01", "D11AX01"},
    drugbankId = "DB00350",
    pubchemCid = "4201",
    chebiId = "6942",
    wikidataId = "Q424165",
    formula = "C9H15N5O",
    M = 0.209253,
    logP = 1.2);
  annotation (Documentation(info = "<html><body><p>Minoxidil is a vasodilator used to treat high blood pressure, including severe hypertension, and applied to the skin to treat hair loss (alopecia). It remains in use: as an oral antihypertensive and as a topical dermatological preparation, and is approved though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q424165\">Wikidata Q424165</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>minoxidil</td></tr><tr><td>ATC codes:</td><td>C02DC01, D11AX01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00350\">DB00350</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4201\">4201</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6942\">6942</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q424165\">Q424165</a></td></tr><tr><td>formula:</td><td>C9H15N5O</td></tr><tr><td>molar mass:</td><td>209.253 g/mol (PubChem CID 4201)</td></tr><tr><td>logP:</td><td>1.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Minoxidil;
