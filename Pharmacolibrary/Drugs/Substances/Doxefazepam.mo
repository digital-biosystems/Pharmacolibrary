  annotation (Documentation(info = "<html><body><p>Doxefazepam is a benzodiazepine-class sedative-hypnotic drug, developed for the short-term treatment of insomnia. It is not an approved medicine today and is regarded as an experimental compound, so it is not in routine clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3714813\">Wikidata Q3714813</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>doxefazepam</td></tr><tr><td>ATC codes:</td><td>N05CD12</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13837\">DB13837</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/38668\">38668</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:82460\">82460</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3714813\">Q3714813</a></td></tr><tr><td>formula:</td><td>C17H14ClFN2O3</td></tr><tr><td>molar mass:</td><td>348.758 g/mol (PubChem CID 38668)</td></tr><tr><td>logP:</td><td>1.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
