  annotation (Documentation(info = "<html><body><p>Sincalide, a synthetic fragment of the hormone cholecystokinin, is used as a diagnostic agent in tests of bile duct patency. It is an approved diagnostic drug, but it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7521885\">Wikidata Q7521885</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sincalide</td></tr><tr><td>ATC codes:</td><td>V04CC03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09142\">DB09142</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9833444\">9833444</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135946\">135946</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7521885\">Q7521885</a></td></tr><tr><td>molar mass:</td><td>1143.3 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>-2.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
