package Metergoline "metergoline"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "metergoline",
    atcCodes = {"G02CB05"},
    drugbankId = "DB13520",
    pubchemCid = "28693",
    chebiId = "64216",
    wikidataId = "Q6823517",
    formula = "C25H29N3O2",
    M = 0.403526,
    logP = 3.8);
  annotation (Documentation(info = "<html><body><p>Metergoline is a prolactin-lowering medicine, acting as a dopamine agonist and serotonin antagonist, used to treat conditions with high prolactin levels. It has been approved as a medicine and is classified as a prolactin inhibitor, though it is not widely used today.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6823517&quot;>Wikidata Q6823517</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>metergoline</td></tr><tr><td>ATC codes:</td><td>G02CB05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13520&quot;>DB13520</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/28693&quot;>28693</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:64216&quot;>64216</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6823517&quot;>Q6823517</a></td></tr><tr><td>formula:</td><td>C25H29N3O2</td></tr><tr><td>molar mass:</td><td>403.526 g/mol (PubChem)</td></tr></table></body></html>"));
end Metergoline;
