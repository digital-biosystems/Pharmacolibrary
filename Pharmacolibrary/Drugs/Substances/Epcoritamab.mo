  annotation (Documentation(info = "<html><body><p>Epcoritamab, a monoclonal antibody anticancer drug, is used to treat diffuse large B-cell lymphoma. It is approved and authorised in the European Union, with one authorised product there, and remains under investigation for further uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q119025940\">Wikidata Q119025940</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>epcoritamab</td></tr><tr><td>ATC codes:</td><td>L01FX27</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB16672\">DB16672</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q119025940\">Q119025940</a></td></tr><tr><td>molar mass:</td><td>149000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
