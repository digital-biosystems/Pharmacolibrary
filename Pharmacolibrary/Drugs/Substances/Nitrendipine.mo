  annotation (Documentation(info = "<html><body><p>Nitrendipine is a dihydropyridine calcium channel blocker used to treat high blood pressure. It remains an approved medicine, used mainly for hypertension, and is also available in combination products with ACE inhibitors.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q416584&quot;>Wikidata Q416584</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nitrendipine</td></tr><tr><td>ATC codes:</td><td>C08CA08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01054&quot;>DB01054</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4507&quot;>4507</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7582&quot;>7582</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q416584&quot;>Q416584</a></td></tr><tr><td>formula:</td><td>C18H20N2O6</td></tr><tr><td>molar mass:</td><td>360.366 g/mol (PubChem)</td></tr></table></body></html>"));
