  annotation (Documentation(info = "<html><body><p>Chloroxylenol is an antiseptic and disinfectant used to treat or prevent local skin infections. It is widely used, including in household antiseptic products, and is included on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q426460&quot;>Wikidata Q426460</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>chloroxylenol</td></tr><tr><td>ATC codes:</td><td>D08AE05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11121&quot;>DB11121</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2723&quot;>2723</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:34393&quot;>34393</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q426460&quot;>Q426460</a></td></tr><tr><td>formula:</td><td>C8H9ClO</td></tr><tr><td>molar mass:</td><td>156.609 g/mol (PubChem)</td></tr></table></body></html>"));
