  annotation (Documentation(info = "<html><body><p>Zinc pyrithione is an antifungal agent used in skin preparations, notably against dandruff and seborrhoeic dermatitis. It is an approved dermatological ingredient, widely used in over-the-counter products such as anti-dandruff shampoos.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27116892&quot;>Wikidata Q27116892</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pyrithione zinc</td></tr><tr><td>ATC codes:</td><td>D11AX12</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06815&quot;>DB06815</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/26041&quot;>26041</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:36584&quot;>36584</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27116892&quot;>Q27116892</a></td></tr><tr><td>formula:</td><td>C10H8N2O2S2Zn</td></tr><tr><td>molar mass:</td><td>317.686 g/mol (PubChem)</td></tr></table></body></html>"));
