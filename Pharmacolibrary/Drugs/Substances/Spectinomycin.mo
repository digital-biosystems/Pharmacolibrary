  annotation (Documentation(info = "<html><body><p>Spectinomycin is an antibiotic used to treat gonorrhea. It is an approved antibacterial, including veterinary use, and appears on the WHO essential medicines list, though some formulations have been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q416154&quot;>Wikidata Q416154</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>spectinomycin</td></tr><tr><td>ATC codes:</td><td>J01XX04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00919&quot;>DB00919</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/15541&quot;>15541</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9215&quot;>9215</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q416154&quot;>Q416154</a></td></tr><tr><td>formula:</td><td>C14H24N2O7</td></tr><tr><td>molar mass:</td><td>332.353 g/mol (PubChem)</td></tr></table></body></html>"));
