    logP = 4.8);
  annotation (Documentation(info = "<html><body><p>Bempedoic acid is a lipid-lowering medicine used to treat high cholesterol and other dyslipidaemias. It is authorised in the European Union and is used, alone or in combination with other lipid-modifying agents, to lower blood cholesterol.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27075007\">Wikidata Q27075007</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>bempedoic acid</td></tr><tr><td>ATC codes:</td><td>C10AX15</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11936\">DB11936</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/10472693\">10472693</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:149601\">149601</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27075007\">Q27075007</a></td></tr><tr><td>formula:</td><td>C19H36O5</td></tr><tr><td>molar mass:</td><td>344.492 g/mol (PubChem CID 10472693)</td></tr><tr><td>logP:</td><td>4.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end BempedoicAcid;
