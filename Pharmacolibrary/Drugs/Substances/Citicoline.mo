  annotation (Documentation(info = "<html><body><p>Citicoline is a nootropic compound used as a psychostimulant/nootropic medicine for conditions of the nervous system. It is an approved drug, though it has also been investigated and withdrawn in some settings; it is not authorised centrally in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q28529682\">Wikidata Q28529682</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>citicoline</td></tr><tr><td>ATC codes:</td><td>N06BX06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12153\">DB12153</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/13804\">13804</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:16436\">16436</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q28529682\">Q28529682</a></td></tr><tr><td>formula:</td><td>C14H26N4O11P2</td></tr><tr><td>molar mass:</td><td>488.327 g/mol (PubChem CID 13804)</td></tr><tr><td>logP:</td><td>-4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
