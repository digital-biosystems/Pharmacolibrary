    logP = 3.1);
  annotation (Documentation(info = "<html><body><p>Feprazone is a non-steroidal anti-inflammatory drug that was intended for inflammatory and rheumatic conditions, including topical use for joint and muscle pain. It is currently listed only as an experimental compound and does not appear to be an approved medicine in the European Union or elsewhere.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q999936\">Wikidata Q999936</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>feprazone</td></tr><tr><td>ATC codes:</td><td>M01AX18, M02AA16</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13364\">DB13364</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/35455\">35455</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31603\">31603</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q999936\">Q999936</a></td></tr><tr><td>formula:</td><td>C20H20N2O2</td></tr><tr><td>molar mass:</td><td>320.392 g/mol (PubChem CID 35455)</td></tr><tr><td>logP:</td><td>3.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
