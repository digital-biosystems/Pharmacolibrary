  annotation (Documentation(info = "<html><body><p>Difetarsone is an arsenic-based antiprotozoal drug that was used to treat amoebiasis and other protozoal infections. It is no longer in routine clinical use and is considered an experimental compound.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5275254\">Wikidata Q5275254</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>difetarsone</td></tr><tr><td>ATC codes:</td><td>P01AR02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13599\">DB13599</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/68199\">68199</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135969\">135969</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5275254\">Q5275254</a></td></tr><tr><td>formula:</td><td>C14H18As2N2O6</td></tr><tr><td>molar mass:</td><td>460.15 g/mol (PubChem CID 68199)</td></tr></table></body></html>"));
