  annotation (Documentation(info = "<html><body><p>Exagamglogene autotemcel is a gene therapy used for sickle-cell disease and transfusion-dependent beta thalassemia. It is authorised in the European Union and is a recently approved, still partly investigational therapy.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q107400400\">Wikidata Q107400400</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>exagamglogene autotemcel</td></tr><tr><td>ATC codes:</td><td>B06AX05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB15572\">DB15572</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q107400400\">Q107400400</a></td></tr></table></body></html>"));
