  annotation (Documentation(info = "<html><body><p>Micronomicin is an antibiotic related to gentamicin, used to treat eye infections. It is classified as an approved antibiotic for ophthalmological use, though it does not appear to be authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6839784&quot;>Wikidata Q6839784</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>micronomicin</td></tr><tr><td>ATC codes:</td><td>S01AA22</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13274&quot;>DB13274</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3037206&quot;>3037206</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:81283&quot;>81283</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6839784&quot;>Q6839784</a></td></tr><tr><td>formula:</td><td>C20H41N5O7</td></tr><tr><td>molar mass:</td><td>463.576 g/mol (PubChem)</td></tr></table></body></html>"));
