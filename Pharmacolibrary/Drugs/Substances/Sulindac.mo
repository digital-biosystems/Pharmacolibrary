    logP = 3.4);
  annotation (Documentation(info = "<html><body><p>Sulindac is a non-steroidal anti-inflammatory drug used to treat painful inflammatory joint conditions such as osteoarthritis, rheumatoid arthritis, ankylosing spondylitis, gout attacks, and enthesopathy. It is an approved medicine and remains in use, though it is not authorised centrally in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q963093\">Wikidata Q963093</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sulindac</td></tr><tr><td>ATC codes:</td><td>M01AB02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00605\">DB00605</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/1548887\">1548887</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9352\">9352</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q963093\">Q963093</a></td></tr><tr><td>formula:</td><td>C20H17FO3S</td></tr><tr><td>molar mass:</td><td>356.411 g/mol (PubChem CID 1548887)</td></tr><tr><td>logP:</td><td>3.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Sulindac;
