  annotation (Documentation(info = "<html><body><p>Thonzylamine is an antihistamine used to relieve allergy symptoms, in topical skin, nasal, and systemic preparations. It is an approved drug, though it is not authorised in the European Union and appears to be little used today.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q617226\">Wikidata Q617226</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>thonzylamine</td></tr><tr><td>ATC codes:</td><td>D04AA01, R01AC06, R06AC06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11235\">DB11235</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5457\">5457</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:104017\">104017</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q617226\">Q617226</a></td></tr><tr><td>formula:</td><td>C16H22N4O</td></tr><tr><td>molar mass:</td><td>286.379 g/mol (PubChem CID 5457)</td></tr><tr><td>logP:</td><td>2.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
