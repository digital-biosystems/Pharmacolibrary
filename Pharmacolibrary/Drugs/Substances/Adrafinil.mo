    logP = 1.6);
  annotation (Documentation(info = "<html><body><p>Adrafinil is a eugeroic (wakefulness-promoting) nootropic that was used to treat excessive daytime sleepiness and narcolepsy. It is no longer in medical use; it was withdrawn because long-term treatment can harm the liver.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q366482&quot;>Wikidata Q366482</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>adrafinil</td></tr><tr><td>ATC codes:</td><td>N06BX17</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08925&quot;>DB08925</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3033226&quot;>3033226</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135200&quot;>135200</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q366482&quot;>Q366482</a></td></tr><tr><td>formula:</td><td>C15H15NO3S</td></tr><tr><td>molar mass:</td><td>289.349 g/mol (PubChem)</td></tr></table></body></html>"));
end Adrafinil;
