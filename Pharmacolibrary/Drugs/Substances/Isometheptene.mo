    logP = 2.5);
  annotation (Documentation(info = "<html><body><p>Isometheptene is an approved drug that has been used to treat migraine headaches, often in combination products, and is classified for functional gastrointestinal disorders. It remains in use, mainly in combination medicines for headache, though it is not authorised centrally in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q1098951&quot;>Wikidata Q1098951</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>isometheptene</td></tr><tr><td>ATC codes:</td><td>A03AX10</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06706&quot;>DB06706</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/22297&quot;>22297</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134765&quot;>134765</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q1098951&quot;>Q1098951</a></td></tr><tr><td>formula:</td><td>C9H19N</td></tr><tr><td>molar mass:</td><td>141.258 g/mol (PubChem)</td></tr></table></body></html>"));
