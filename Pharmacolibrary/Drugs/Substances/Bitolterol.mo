  annotation (Documentation(info = "<html><body><p>Bitolterol is an inhaled beta-2 agonist bronchodilator that was used to treat asthma. It has been withdrawn and is no longer available; it was never authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4918914&quot;>Wikidata Q4918914</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bitolterol</td></tr><tr><td>ATC codes:</td><td>R03AC17</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00901&quot;>DB00901</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/35330&quot;>35330</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3133&quot;>3133</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4918914&quot;>Q4918914</a></td></tr><tr><td>formula:</td><td>C28H31NO5</td></tr><tr><td>molar mass:</td><td>461.558 g/mol (PubChem)</td></tr></table></body></html>"));
