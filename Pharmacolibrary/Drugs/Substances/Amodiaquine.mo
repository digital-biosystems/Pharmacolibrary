  annotation (Documentation(info = "<html><body><p>Amodiaquine is an antimalarial medicine used to treat malaria. It is on the WHO list of essential medicines and is also available in combination with artemisinin derivatives; it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q239569&quot;>Wikidata Q239569</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>amodiaquine</td></tr><tr><td>ATC codes:</td><td>P01BA06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00613&quot;>DB00613</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2165&quot;>2165</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:2674&quot;>2674</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q239569&quot;>Q239569</a></td></tr><tr><td>formula:</td><td>C20H22ClN3O</td></tr><tr><td>molar mass:</td><td>355.866 g/mol (PubChem)</td></tr></table></body></html>"));
