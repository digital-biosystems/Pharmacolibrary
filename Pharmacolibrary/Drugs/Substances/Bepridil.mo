  annotation (Documentation(info = "<html><body><p>Bepridil is a calcium channel blocker that was used to treat angina pectoris and arterial hypertension. It has been withdrawn from the market, reportedly because of safety concerns, and is no longer in general clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4890934\">Wikidata Q4890934</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bepridil</td></tr><tr><td>ATC codes:</td><td>C08EA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01244\">DB01244</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2351\">2351</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3061\">3061</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4890934\">Q4890934</a></td></tr><tr><td>formula:</td><td>C24H34N2O</td></tr><tr><td>molar mass:</td><td>366.549 g/mol (PubChem CID 2351)</td></tr><tr><td>logP:</td><td>5.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
