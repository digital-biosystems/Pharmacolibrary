  annotation (Documentation(info = "<html><body><p>Beraprost is a vasodilator and platelet aggregation inhibitor, an antithrombotic agent investigated as a drug. It is not an approved medicine in major Western markets and remains investigational, though it has been used in some Asian countries for vascular disease such as pulmonary hypertension.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5977854&quot;>Wikidata Q5977854</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>beraprost</td></tr><tr><td>ATC codes:</td><td>B01AC19</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB05229&quot;>DB05229</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/23663404&quot;>23663404</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135633&quot;>135633</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5977854&quot;>Q5977854</a></td></tr><tr><td>formula:</td><td>C24H29NaO5</td></tr><tr><td>molar mass:</td><td>420.481 g/mol (PubChem)</td></tr></table></body></html>"));
