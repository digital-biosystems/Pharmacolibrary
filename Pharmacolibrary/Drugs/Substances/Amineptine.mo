  annotation (Documentation(info = "<html><body><p>Amineptine is a tricyclic antidepressant that was used to treat depression. It was never approved in the US and was withdrawn from the French market because of concerns over abuse, dependence and severe acne.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q44822059\">Wikidata Q44822059</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>amineptine</td></tr><tr><td>ATC codes:</td><td>N06AA19</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB04836\">DB04836</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/34869\">34869</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32499\">32499</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q44822059\">Q44822059</a></td></tr><tr><td>formula:</td><td>C22H28ClNO2</td></tr><tr><td>molar mass:</td><td>373.921 g/mol (PubChem CID 34869)</td></tr><tr><td>logP:</td><td>2.1 (Drugs.Common 25.09, not verified)</td></tr></table><p><small>Drugs.Common 25.09 gave 337.5 g/mol (-9.7 %); replaced by the value above</small></p></body></html>"));
end Amineptine;
