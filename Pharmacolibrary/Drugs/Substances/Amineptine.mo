    logP = 2.1);
  annotation (Documentation(info = "<html><body><p>Amineptine is a tricyclic antidepressant that was used to treat depression. It was never approved in the US and was withdrawn from the French market because of concerns over abuse, dependence and severe acne.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q44822059&quot;>Wikidata Q44822059</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>amineptine</td></tr><tr><td>ATC codes:</td><td>N06AA19</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB04836&quot;>DB04836</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/34869&quot;>34869</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32499&quot;>32499</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q44822059&quot;>Q44822059</a></td></tr><tr><td>formula:</td><td>C22H28ClNO2</td></tr><tr><td>molar mass:</td><td>373.921 g/mol (PubChem)</td></tr></table></body></html>"));
