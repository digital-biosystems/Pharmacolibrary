  annotation (Documentation(info = "<html><body><p>Oxycinchophen is a quinoline-type antirheumatic drug that was classified for the treatment of rheumatic conditions. It is currently considered only an experimental compound and does not appear to be an approved medicine in the European Union or elsewhere.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q1227218&quot;>Wikidata Q1227218</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>oxycinchophen</td></tr><tr><td>ATC codes:</td><td>M01CA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13596&quot;>DB13596</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/10239&quot;>10239</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135094&quot;>135094</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q1227218&quot;>Q1227218</a></td></tr><tr><td>formula:</td><td>C16H11NO3</td></tr><tr><td>molar mass:</td><td>265.268 g/mol (PubChem)</td></tr></table></body></html>"));
