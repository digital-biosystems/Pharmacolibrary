    logP = -1.1);
  annotation (Documentation(info = "<html><body><p>Carbetocin is an oxytocic drug, a synthetic peptide analogue of oxytocin used to stimulate uterine contractions. It is an approved medicine, though it does not appear to have a centralised authorisation in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5037853\">Wikidata Q5037853</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>carbetocin</td></tr><tr><td>ATC codes:</td><td>H01BB03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01282\">DB01282</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/16681432\">16681432</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:59204\">59204</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5037853\">Q5037853</a></td></tr><tr><td>formula:</td><td>C45H69N11O12S</td></tr><tr><td>molar mass:</td><td>988.172 g/mol (PubChem CID 16681432)</td></tr><tr><td>logP:</td><td>-1.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Carbetocin;
