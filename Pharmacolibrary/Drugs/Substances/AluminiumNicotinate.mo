  annotation (Documentation(info = "<html><body><p>Aluminium nicotinate is a nicotinic acid derivative classified as a lipid-modifying agent, suggesting use for lowering blood lipids. It appears only as an experimental drug, with no marketing authorisation found, so it is not in routine clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4737395&quot;>Wikidata Q4737395</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>aluminium nicotinate</td></tr><tr><td>ATC codes:</td><td>C10AD04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13576&quot;>DB13576</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4737395&quot;>Q4737395</a></td></tr><tr><td>formula:</td><td>C18H12AlN3O6</td></tr><tr><td>molar mass:</td><td>393.291 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
