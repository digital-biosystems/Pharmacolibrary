  annotation (Documentation(info = "<html><body><p>Ronifibrate is a fibrate, a type of lipid-modifying agent developed to lower blood lipid levels. It appears only as an experimental compound and is not an established marketed medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2071034&quot;>Wikidata Q2071034</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ronifibrate</td></tr><tr><td>ATC codes:</td><td>C10AB07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13460&quot;>DB13460</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/68671&quot;>68671</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135588&quot;>135588</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2071034&quot;>Q2071034</a></td></tr><tr><td>formula:</td><td>C19H20ClNO5</td></tr><tr><td>molar mass:</td><td>377.821 g/mol (PubChem)</td></tr></table></body></html>"));
