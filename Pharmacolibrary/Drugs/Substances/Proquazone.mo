  annotation (Documentation(info = "<html><body><p>Proquazone is a non-steroidal anti-inflammatory drug (NSAID) that acts as a cyclooxygenase inhibitor and was used as an analgesic and anti-inflammatory agent. It is listed as an experimental compound and appears to be little used today; no marketing authorisation in the European Union is recorded.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7250480\">Wikidata Q7250480</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>proquazone</td></tr><tr><td>ATC codes:</td><td>M01AX13</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13649\">DB13649</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/31508\">31508</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135151\">135151</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7250480\">Q7250480</a></td></tr><tr><td>formula:</td><td>C18H18N2O</td></tr><tr><td>molar mass:</td><td>278.355 g/mol (PubChem CID 31508)</td></tr><tr><td>logP:</td><td>3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Proquazone;
