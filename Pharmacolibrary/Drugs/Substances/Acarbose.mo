  annotation (Documentation(info = "<html><body><p>Acarbose is an oral blood glucose lowering drug (an alpha glucosidase inhibitor) used to treat diabetes. It is an approved medicine, available both on its own and in combinations with other oral glucose-lowering drugs.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q125699761\">Wikidata Q125699761</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>acarbose</td></tr><tr><td>ATC codes:</td><td>A10BF01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00284\">DB00284</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9811704\">9811704</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:2376\">2376</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q125699761\">Q125699761</a></td></tr><tr><td>formula:</td><td>C25H43NO18</td></tr><tr><td>molar mass:</td><td>645.608 g/mol (PubChem CID 9811704)</td></tr><tr><td>logP:</td><td>-8.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
