    logP = -8.8);
  annotation (Documentation(info = "<html><body><p>Acarbose is an oral blood glucose-lowering medicine, an alpha glucosidase inhibitor, used to treat diabetes. It is an approved drug used widely in the treatment of type 2 diabetes, mainly as a combination therapy with other oral glucose-lowering medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q338005&quot;>Wikidata Q338005</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>acarbose</td></tr><tr><td>ATC codes:</td><td>A10BF01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00284&quot;>DB00284</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/9811704&quot;>9811704</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:2376&quot;>2376</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q338005&quot;>Q338005</a></td></tr><tr><td>formula:</td><td>C25H43NO18</td></tr><tr><td>molar mass:</td><td>645.608 g/mol (PubChem)</td></tr></table></body></html>"));
