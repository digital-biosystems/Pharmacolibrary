within Pharmacolibrary.Drugs.Substances;
package Hypromellose "hypromellose"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "hypromellose",
    atcCodes = {"S01KA02"},
    drugbankId = "DB11075",
    wikidataId = "Q423846");
  annotation (Documentation(info = "<html><body><p>Hypromellose is a cellulose-derived polymer used in ophthalmology as a viscoelastic substance and tear substitute, and widely as a thickening or emulsifying agent in medicines. It remains in widespread use as an approved excipient and eye-drop ingredient.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q423846&quot;>Wikidata Q423846</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>hypromellose</td></tr><tr><td>ATC codes:</td><td>S01KA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11075&quot;>DB11075</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q423846&quot;>Q423846</a></td></tr></table></body></html>"));
end Hypromellose;
