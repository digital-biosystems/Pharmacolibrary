    logP = 2.4);
  annotation (Documentation(info = "<html><body><p>Fluoxymesterone is an androgenic anabolic steroid used for conditions such as breast cancer, hypogonadism, delayed puberty, and angioedema. It is an approved drug, though it is not authorised in the European Union and is also used illicitly.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q410663\">Wikidata Q410663</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>fluoxymesterone</td></tr><tr><td>ATC codes:</td><td>G03BA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01185\">DB01185</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6446\">6446</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:5120\">5120</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q410663\">Q410663</a></td></tr><tr><td>formula:</td><td>C20H29FO3</td></tr><tr><td>molar mass:</td><td>336.447 g/mol (PubChem CID 6446)</td></tr><tr><td>logP:</td><td>2.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
