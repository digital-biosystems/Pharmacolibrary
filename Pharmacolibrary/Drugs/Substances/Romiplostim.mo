  annotation (Documentation(info = "<html><body><p>Romiplostim is used to treat low platelet counts (thrombocytopenia), including immune thrombocytopenic purpura, and has been studied in myelodysplastic syndrome. It is an approved medicine, authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q1235195&quot;>Wikidata Q1235195</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>romiplostim</td></tr><tr><td>ATC codes:</td><td>B02BX04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB05332&quot;>DB05332</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q1235195&quot;>Q1235195</a></td></tr><tr><td>molar mass:</td><td>59000 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Romiplostim;
