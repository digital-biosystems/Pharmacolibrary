    logP = 6.4);
  annotation (Documentation(info = "<html><body><p>Butoconazole is an antifungal medicine used to treat vulvovaginal candidiasis, a yeast infection of the vagina. It is an approved gynecological antiinfective, applied locally as a vaginal cream, and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2928948\">Wikidata Q2928948</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>butoconazole</td></tr><tr><td>ATC codes:</td><td>G01AF15</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00639\">DB00639</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/47472\">47472</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3240\">3240</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2928948\">Q2928948</a></td></tr><tr><td>formula:</td><td>C19H17Cl3N2S</td></tr><tr><td>molar mass:</td><td>411.769 g/mol (PubChem CID 47472)</td></tr><tr><td>logP:</td><td>6.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Butoconazole;
