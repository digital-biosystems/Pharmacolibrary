  annotation (Documentation(info = "<html><body><p>Levothyroxine is a thyroid hormone used to treat hypothyroidism and other thyroid conditions such as goiter, thyroiditis, myxedema, and thyroid carcinoma. It is an approved medicine and is widely used as standard thyroid hormone therapy.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q773449\">Wikidata Q773449</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Levothyroxine</td></tr><tr><td>ATC codes:</td><td>H03AA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00451\">DB00451</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5819\">5819</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q773449\">Q773449</a></td></tr><tr><td>formula:</td><td>C15H11I4NO4</td></tr><tr><td>molar mass:</td><td>776.856 g/mol (PubChem CID 5819)</td></tr></table></body></html>"));
end Levothyroxine;
