  annotation (Documentation(info = "<html><body><p>Methylestrenolone (normethandrone) is a synthetic progestogen of the estren derivative group, a class of sex hormones used for conditions related to the genital system. It is considered investigational and is not an authorised medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6824007\">Wikidata Q6824007</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>methylestrenolone</td></tr><tr><td>ATC codes:</td><td>G03DC31</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13533\">DB13533</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5284597\">5284597</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:34896\">34896</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6824007\">Q6824007</a></td></tr><tr><td>formula:</td><td>C19H28O2</td></tr><tr><td>molar mass:</td><td>288.431 g/mol (PubChem CID 5284597)</td></tr><tr><td>logP:</td><td>2.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
