  annotation (Documentation(info = "<html><body><p>Tizanidine is a centrally acting muscle relaxant used to treat muscle spasticity, spasms, and related painful conditions such as lower back pain and muscle cramps. It is an approved medication that is widely used for these indications.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q423538&quot;>Wikidata Q423538</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tizanidine</td></tr><tr><td>ATC codes:</td><td>M03BX02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00697&quot;>DB00697</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5487&quot;>5487</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:63629&quot;>63629</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q423538&quot;>Q423538</a></td></tr><tr><td>formula:</td><td>C9H8ClN5S</td></tr><tr><td>molar mass:</td><td>253.708 g/mol (PubChem)</td></tr></table></body></html>"));
