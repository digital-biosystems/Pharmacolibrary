  annotation (Documentation(info = "<html><body><p>Prajmaline is a class Ia antiarrhythmic drug used to treat abnormal heart rhythms. It is not an approved medicine and has only been given experimentally, so its current use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7238143\">Wikidata Q7238143</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>prajmaline</td></tr><tr><td>ATC codes:</td><td>C01BA08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13555\">DB13555</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/76959818\">76959818</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135560\">135560</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7238143\">Q7238143</a></td></tr><tr><td>formula:</td><td>C23H33N2O2+</td></tr><tr><td>molar mass:</td><td>369.529 g/mol (PubChem CID 76959818)</td></tr><tr><td>logP:</td><td>2.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
