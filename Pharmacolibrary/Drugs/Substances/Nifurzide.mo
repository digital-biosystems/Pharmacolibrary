  annotation (Documentation(info = "<html><body><p>Nifurzide is an intestinal antiinfective drug that has been used to treat infectious diarrhoea. It is not an approved medicine today and is regarded as experimental, with no marketing authorisation in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q15409365\">Wikidata Q15409365</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nifurzide</td></tr><tr><td>ATC codes:</td><td>A07AX04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13325\">DB13325</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9571044\">9571044</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135428\">135428</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q15409365\">Q15409365</a></td></tr><tr><td>formula:</td><td>C12H8N4O6S</td></tr><tr><td>molar mass:</td><td>336.278 g/mol (PubChem CID 9571044)</td></tr><tr><td>logP:</td><td>2.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
