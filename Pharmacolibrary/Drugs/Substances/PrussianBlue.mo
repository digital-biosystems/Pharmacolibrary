  annotation (Documentation(info = "<html><body><p>Prussian blue is an antidote used to treat poisoning, acting as a chelating agent. It is an approved medicine and appears on the WHO list of essential medicines, so it is used worldwide.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q421894\">Wikidata Q421894</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>prussian blue</td></tr><tr><td>ATC codes:</td><td>V03AB31</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06783\">DB06783</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2724251\">2724251</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:30069\">30069</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q421894\">Q421894</a></td></tr><tr><td>formula:</td><td>C18Fe7N18</td></tr><tr><td>molar mass:</td><td>859.239 g/mol (PubChem CID 2724251)</td></tr></table></body></html>"));
