  annotation (Documentation(info = "<html><body><p>Tiropramide is a synthetic antispasmodic with parasympatholytic action, studied for functional gastrointestinal disorders. It is not an approved medicine and remains investigational, with no authorisation in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7809264\">Wikidata Q7809264</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tiropramide</td></tr><tr><td>ATC codes:</td><td>A03AC05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13091\">DB13091</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/42262\">42262</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135758\">135758</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7809264\">Q7809264</a></td></tr><tr><td>formula:</td><td>C28H41N3O3</td></tr><tr><td>molar mass:</td><td>467.654 g/mol (PubChem CID 42262)</td></tr><tr><td>logP:</td><td>5.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
