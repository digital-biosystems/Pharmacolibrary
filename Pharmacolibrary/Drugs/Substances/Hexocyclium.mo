  annotation (Documentation(info = "<html><body><p>Hexocyclium is a synthetic anticholinergic drug used to treat peptic ulcer disease. It is an approved medicine, but appears to be little used today and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5749037\">Wikidata Q5749037</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>hexocyclium</td></tr><tr><td>ATC codes:</td><td>A03AB10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06787\">DB06787</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/24199\">24199</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:5707\">5707</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5749037\">Q5749037</a></td></tr><tr><td>formula:</td><td>C20H33N2O+</td></tr><tr><td>molar mass:</td><td>317.497 g/mol (PubChem CID 24199)</td></tr><tr><td>logP:</td><td>3.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Hexocyclium;
