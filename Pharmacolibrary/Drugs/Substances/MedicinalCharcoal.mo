  annotation (Documentation(info = "<html><body><p>Medicinal charcoal is an intestinal adsorbent used to treat diarrhoea and, more broadly, to adsorb harmful substances in the gut. It is an approved, widely available non-prescription medicine used in many countries.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>medicinal charcoal</td></tr><tr><td>ATC codes:</td><td>A07BA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09278&quot;>DB09278</a></td></tr></table></body></html>"));
end MedicinalCharcoal;
