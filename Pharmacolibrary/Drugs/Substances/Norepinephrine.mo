    logP = -1.2);
  annotation (Documentation(info = "<html><body><p>Norepinephrine is a sympathomimetic, vasoconstricting drug used to treat neurogenic shock. It is an approved medicine, classified under cardiac therapy as an adrenergic agent, and is used mainly in hospital settings for acute cardiovascular support.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q186242\">Wikidata Q186242</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>norepinephrine</td></tr><tr><td>ATC codes:</td><td>C01CA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00368\">DB00368</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/439260\">439260</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:18357\">18357</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q186242\">Q186242</a></td></tr><tr><td>formula:</td><td>C8H11NO3</td></tr><tr><td>molar mass:</td><td>169.18 g/mol (PubChem CID 439260)</td></tr><tr><td>logP:</td><td>-1.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Norepinephrine;
