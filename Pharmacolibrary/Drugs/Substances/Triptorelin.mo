  annotation (Documentation(info = "<html><body><p>Triptorelin is a gonadotropin-releasing hormone analogue used as hormonal anticancer therapy, for example in prostate cancer. It is an approved medicine, also approved for veterinary use, and is used worldwide in oncology practice.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q1992452&quot;>Wikidata Q1992452</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>triptorelin</td></tr><tr><td>ATC codes:</td><td>L02AE04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06825&quot;>DB06825</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/25074470&quot;>25074470</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:63633&quot;>63633</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q1992452&quot;>Q1992452</a></td></tr><tr><td>formula:</td><td>C64H82N18O13</td></tr><tr><td>molar mass:</td><td>1311.47 g/mol (PubChem)</td></tr></table></body></html>"));
