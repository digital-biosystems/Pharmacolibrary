  annotation (Documentation(info = "<html><body><p>Secukinumab is a monoclonal antibody that blocks interleukin-17 and is used to treat psoriasis, psoriatic arthritis, and ankylosing spondylitis. It is an approved medicine authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7444755\">Wikidata Q7444755</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>secukinumab</td></tr><tr><td>ATC codes:</td><td>L04AC10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09029\">DB09029</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7444755\">Q7444755</a></td></tr><tr><td>molar mass:</td><td>151000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Secukinumab;
