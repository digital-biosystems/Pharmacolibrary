within Pharmacolibrary.Drugs.Substances;
package AceticAcid "acetic acid"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "acetic acid",
    atcCodes = {"G01AD02", "S02AA10"},
    drugbankId = "DB03166",
    pubchemCid = "176",
    chebiId = "15366",
    wikidataId = "Q47512",
    formula = "C2H4O2",
    M = 0.060052,
    logP = -0.2);
  annotation (Documentation(info = "<html><body><p>Acetic acid is used as an antiseptic to treat infections such as otitis externa and bacterial vaginosis. It is approved and appears on the WHO essential medicines list, with products for gynecological and ear use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q47512\">Wikidata Q47512</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>acetic acid</td></tr><tr><td>ATC codes:</td><td>G01AD02, S02AA10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB03166\">DB03166</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/176\">176</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:15366\">15366</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q47512\">Q47512</a></td></tr><tr><td>formula:</td><td>C2H4O2</td></tr><tr><td>molar mass:</td><td>60.052 g/mol (PubChem CID 176)</td></tr><tr><td>logP:</td><td>-0.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end AceticAcid;
