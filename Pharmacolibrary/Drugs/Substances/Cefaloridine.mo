  annotation (Documentation(info = "<html><body><p>Cefaloridine is a first-generation cephalosporin antibiotic used to treat bacterial infections. It has been withdrawn from use, mainly because it caused kidney damage.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5063323&quot;>Wikidata Q5063323</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cefaloridine</td></tr><tr><td>ATC codes:</td><td>J01DB02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09008&quot;>DB09008</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5773&quot;>5773</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3537&quot;>3537</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5063323&quot;>Q5063323</a></td></tr><tr><td>formula:</td><td>C19H17N3O4S2</td></tr><tr><td>molar mass:</td><td>415.482 g/mol (PubChem)</td></tr></table></body></html>"));
