    wikidataId = "Q21099046",
    formula = "C21H22N4O3",
    M = 0.378432,
    logP = 2.4);
  annotation (Documentation(info = "<html><body><p>Finerenone is a nonsteroidal aldosterone antagonist used to treat chronic kidney disease associated with type 2 diabetes, and has also been studied for chronic heart failure. It is approved and authorised in the European Union, and remains under investigation for additional uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q21099046\">Wikidata Q21099046</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>finerenone</td></tr><tr><td>ATC codes:</td><td>C03DA05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB16165\">DB16165</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/60150535\">60150535</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q21099046\">Q21099046</a></td></tr><tr><td>formula:</td><td>C21H22N4O3</td></tr><tr><td>molar mass:</td><td>378.432 g/mol (PubChem CID 60150535)</td></tr><tr><td>logP:</td><td>2.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Finerenone;
