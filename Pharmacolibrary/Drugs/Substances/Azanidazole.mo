  annotation (Documentation(info = "<html><body><p>Azanidazole is a nitroimidazole compound classified as a gynecological antiinfective and antiprotozoal agent against amoebiasis and other protozoal diseases. It appears only as an experimental drug, with no authorisation records, so its current use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q523771&quot;>Wikidata Q523771</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>azanidazole</td></tr><tr><td>ATC codes:</td><td>G01AF13, P01AB04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13350&quot;>DB13350</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6436171&quot;>6436171</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135001&quot;>135001</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q523771&quot;>Q523771</a></td></tr><tr><td>formula:</td><td>C10H10N6O2</td></tr><tr><td>molar mass:</td><td>246.23 g/mol (PubChem)</td></tr></table></body></html>"));
