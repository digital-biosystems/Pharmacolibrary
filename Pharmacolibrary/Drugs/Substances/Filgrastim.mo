within Pharmacolibrary.Drugs.Substances;
package Filgrastim "filgrastim"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "filgrastim",
    atcCodes = {"L03AA02"},
    drugbankId = "DB00099",
    wikidataId = "Q3151081",
    M = 18.8);
  annotation (Documentation(info = "<html><body><p>Filgrastim, a granulocyte colony-stimulating factor, is used to treat neutropenia and related blood disorders, and to support patients with cancers such as leukemia and lymphoma. It is widely used and appears on the WHO essential medicines list, with several products authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3151081\">Wikidata Q3151081</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>filgrastim</td></tr><tr><td>ATC codes:</td><td>L03AA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00099\">DB00099</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3151081\">Q3151081</a></td></tr><tr><td>molar mass:</td><td>18800 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Filgrastim;
