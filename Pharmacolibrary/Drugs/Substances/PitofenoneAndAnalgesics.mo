    logP = 4.15);
  annotation (Documentation(info = "<html><body><p>Pitofenone is an antispasmodic used in combination with analgesics to treat functional gastrointestinal disorders involving spasms. It is considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7199015&quot;>Wikidata Q7199015</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pitofenone and analgesics</td></tr><tr><td>ATC codes:</td><td>A03DA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB15947&quot;>DB15947</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135547&quot;>135547</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7199015&quot;>Q7199015</a></td></tr><tr><td>formula:</td><td>C22H25NO4</td></tr><tr><td>molar mass:</td><td>367.445 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
