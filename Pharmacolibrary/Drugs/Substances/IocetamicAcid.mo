package IocetamicAcid "iocetamic acid"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "iocetamic acid",
    atcCodes = {"V08AC07"},
    drugbankId = "DB09403",
    chebiId = "91662",
    wikidataId = "Q6062203",
    formula = "C12H13I3N2O3",
    M = 0.61396,
    logP = 2.6);
  annotation (Documentation(info = "<html><body><p>Iocetamic acid is an iodinated, water-soluble X-ray contrast agent that is taken up by the liver and used to visualise the gallbladder and biliary tract on imaging. It is an approved contrast medium, though such oral gallbladder agents are now only rarely used, having largely been replaced by modern imaging techniques.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6062203&quot;>Wikidata Q6062203</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>iocetamic acid</td></tr><tr><td>ATC codes:</td><td>V08AC07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09403&quot;>DB09403</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:91662&quot;>91662</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6062203&quot;>Q6062203</a></td></tr><tr><td>formula:</td><td>C12H13I3N2O3</td></tr><tr><td>molar mass:</td><td>613.96 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end IocetamicAcid;
