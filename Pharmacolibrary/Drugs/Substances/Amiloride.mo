  annotation (Documentation(info = "<html><body><p>Amiloride is a potassium-sparing diuretic used for conditions including high blood pressure, heart failure, low potassium levels, and related fluid-retention disorders. It remains an approved medicine and is included on the WHO list of essential medicines, so it is used widely in human healthcare.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q419995&quot;>Wikidata Q419995</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>amiloride</td></tr><tr><td>ATC codes:</td><td>C03DB01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00594&quot;>DB00594</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/16231&quot;>16231</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:2639&quot;>2639</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q419995&quot;>Q419995</a></td></tr><tr><td>formula:</td><td>C6H8ClN7O</td></tr><tr><td>molar mass:</td><td>229.628 g/mol (PubChem)</td></tr></table></body></html>"));
