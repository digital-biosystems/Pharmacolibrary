    logP = 0.5);
  annotation (Documentation(info = "<html><body><p>Guanethidine is a peripherally acting sympatholytic antihypertensive drug that was used to treat arterial hypertension and, in eye-drop form, glaucoma. It has been withdrawn and is no longer in clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q420673&quot;>Wikidata Q420673</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>guanethidine</td></tr><tr><td>ATC codes:</td><td>C02CC02, S01EX01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01170&quot;>DB01170</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3518&quot;>3518</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:5557&quot;>5557</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q420673&quot;>Q420673</a></td></tr><tr><td>formula:</td><td>C10H22N4</td></tr><tr><td>molar mass:</td><td>198.314 g/mol (PubChem)</td></tr></table></body></html>"));
end Guanethidine;
