  annotation (Documentation(info = "<html><body><p>Tildrakizumab, a monoclonal antibody that blocks an interleukin signal, is used to treat psoriasis. It is an approved medicine and is authorised in the European Union for this condition.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q15708331\">Wikidata Q15708331</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>tildrakizumab</td></tr><tr><td>ATC codes:</td><td>L04AC17</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB14004\">DB14004</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q15708331\">Q15708331</a></td></tr><tr><td>molar mass:</td><td>144400 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
