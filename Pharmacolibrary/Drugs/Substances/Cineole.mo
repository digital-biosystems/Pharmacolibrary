  annotation (Documentation(info = "<html><body><p>Cineole (eucalyptol) is used as an expectorant in cough and cold preparations. It is approved and also used as a nutraceutical, with some investigational uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q161572&quot;>Wikidata Q161572</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cineole</td></tr><tr><td>ATC codes:</td><td>R05CA13</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB03852&quot;>DB03852</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2758&quot;>2758</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q161572&quot;>Q161572</a></td></tr><tr><td>formula:</td><td>C10H18O</td></tr><tr><td>molar mass:</td><td>154.253 g/mol (PubChem)</td></tr></table></body></html>"));
