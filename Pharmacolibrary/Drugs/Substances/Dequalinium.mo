    logP = 7.3);
  annotation (Documentation(info = "<html><body><p>Dequalinium chloride is a local anti-infective agent used as an antiseptic, for example on the skin, in the throat, and for gynecological infections. It is an approved drug used in topical antiseptic preparations such as throat lozenges, skin antiseptics, and vaginal products.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5261117&quot;>Wikidata Q5261117</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dequalinium</td></tr><tr><td>ATC codes:</td><td>D08AH01, G01AC05, R02AA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB04209&quot;>DB04209</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2993&quot;>2993</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:41872&quot;>41872</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5261117&quot;>Q5261117</a></td></tr><tr><td>formula:</td><td>C30H40N4+2</td></tr><tr><td>molar mass:</td><td>456.678 g/mol (PubChem)</td></tr></table></body></html>"));
end Dequalinium;
