  annotation (Documentation(info = "<html><body><p>Dequalinium is an antiseptic used against infections of the skin, vagina, and throat. It is an approved antiseptic, used mainly in topical preparations for these areas.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q81984379\">Wikidata Q81984379</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dequalinium</td></tr><tr><td>ATC codes:</td><td>D08AH01, G01AC05, R02AA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB04209\">DB04209</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2993\">2993</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:41872\">41872</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q81984379\">Q81984379</a></td></tr><tr><td>formula:</td><td>C30H40N4+2</td></tr><tr><td>molar mass:</td><td>456.678 g/mol (PubChem CID 2993)</td></tr><tr><td>logP:</td><td>7.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
