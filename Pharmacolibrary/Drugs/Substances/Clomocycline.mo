    logP = -1.5);
  annotation (Documentation(info = "<html><body><p>Clomocycline is a tetracycline-class antibacterial agent, meaning it was developed to treat bacterial infections. It appears to be no longer in routine clinical use; it is listed only as an experimental compound and has no authorisation record with the European Medicines Agency.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4925524\">Wikidata Q4925524</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>clomocycline</td></tr><tr><td>ATC codes:</td><td>J01AA11</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00453\">DB00453</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/54680675\">54680675</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:59589\">59589</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4925524\">Q4925524</a></td></tr><tr><td>formula:</td><td>C23H25ClN2O9</td></tr><tr><td>molar mass:</td><td>508.908 g/mol (PubChem CID 54680675)</td></tr><tr><td>logP:</td><td>-1.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
