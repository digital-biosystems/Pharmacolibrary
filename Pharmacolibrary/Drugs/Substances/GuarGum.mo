within Pharmacolibrary.Drugs.Substances;
package GuarGum "guar gum"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "guar gum",
    atcCodes = {"A10BX01"},
    drugbankId = "DB13446",
    wikidataId = "Q422071");
  annotation (Documentation(info = "<html><body><p>Guar gum is a natural thickening and stabilising substance, classified as a blood glucose lowering drug used in diabetes. It is considered investigational as a medicine, while its main use is in food and industrial applications.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q422071\">Wikidata Q422071</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>guar gum</td></tr><tr><td>ATC codes:</td><td>A10BX01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13446\">DB13446</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q422071\">Q422071</a></td></tr></table></body></html>"));
end GuarGum;
