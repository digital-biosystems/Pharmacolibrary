    formula = "ClH",
    M = 0.036458,
    logP = 0.8);
  annotation (Documentation(info = "<html><body><p>Hydrochloric acid is a strong mineral acid used medicinally as a digestive acid preparation and as an additive to intravenous electrolyte solutions. It is listed as investigational in DrugBank and has no European Union marketing authorisation, so it is not an approved drug product.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2409&quot;>Wikidata Q2409</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>hydrochloric acid</td></tr><tr><td>ATC codes:</td><td>A09AB03, B05XA13</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13366&quot;>DB13366</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/313&quot;>313</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:17883&quot;>17883</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2409&quot;>Q2409</a></td></tr><tr><td>formula:</td><td>ClH</td></tr><tr><td>molar mass:</td><td>36.458 g/mol (PubChem)</td></tr></table></body></html>"));
end HydrochloricAcid;
