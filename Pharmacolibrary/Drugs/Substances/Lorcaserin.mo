  annotation (Documentation(info = "<html><body><p>Lorcaserin was a centrally acting antiobesity medicine used for weight management in obesity. It was approved but later withdrawn from the market after concerns about an increased risk of cancer, and it is no longer available.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q340139&quot;>Wikidata Q340139</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>lorcaserin</td></tr><tr><td>ATC codes:</td><td>A08AA11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB04871&quot;>DB04871</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/11658860&quot;>11658860</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:65353&quot;>65353</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q340139&quot;>Q340139</a></td></tr><tr><td>formula:</td><td>C11H14ClN</td></tr><tr><td>molar mass:</td><td>195.69 g/mol (PubChem)</td></tr></table></body></html>"));
