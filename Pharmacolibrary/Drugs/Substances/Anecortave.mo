  annotation (Documentation(info = "<html><body><p>Anecortave is an angiogenesis inhibitor studied as an eye medicine for ocular vascular disorders involving abnormal new blood vessel growth. It remains experimental and is not an approved treatment.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27287834&quot;>Wikidata Q27287834</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>anecortave</td></tr><tr><td>ATC codes:</td><td>S01LA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12081&quot;>DB12081</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/7074810&quot;>7074810</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:177649&quot;>177649</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27287834&quot;>Q27287834</a></td></tr><tr><td>formula:</td><td>C21H28O4</td></tr><tr><td>molar mass:</td><td>344.451 g/mol (PubChem)</td></tr></table></body></html>"));
