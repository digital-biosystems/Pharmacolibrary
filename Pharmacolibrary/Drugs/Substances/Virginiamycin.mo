within Pharmacolibrary.Drugs.Substances;
package Virginiamycin "virginiamycin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "virginiamycin",
    atcCodes = {"D06AX10"},
    drugbankId = "DB11476",
    pubchemCid = "127053480",
    wikidataId = "Q3560696",
    formula = "C71H84N10O17",
    M = 1.34951);
  annotation (Documentation(info = "<html><body><p>Virginiamycin is a group of antibiotics that act by inhibiting protein synthesis, and it has been used topically on the skin to treat bacterial infections. It is approved for veterinary use and remains only an experimental topical antibiotic in human medicine, so it is not widely used in people.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3560696\">Wikidata Q3560696</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>virginiamycin</td></tr><tr><td>ATC codes:</td><td>D06AX10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11476\">DB11476</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/127053480\">127053480</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3560696\">Q3560696</a></td></tr><tr><td>formula:</td><td>C71H84N10O17</td></tr><tr><td>molar mass:</td><td>1349.51 g/mol (PubChem CID 127053480)</td></tr></table></body></html>"));
end Virginiamycin;
