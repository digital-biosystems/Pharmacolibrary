  annotation (Documentation(info = "<html><body><p>Umeclidinium is an inhaled anticholinergic medicine used to treat chronic obstructive pulmonary disease, often in combination with other inhaled drugs. It is authorised in the European Union and widely used as a maintenance inhalation treatment for COPD.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q17125410\">Wikidata Q17125410</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>umeclidinium</td></tr><tr><td>ATC codes:</td><td>R03BB07</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09076\">DB09076</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/11519070\">11519070</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q17125410\">Q17125410</a></td></tr><tr><td>formula:</td><td>C29H34NO2+</td></tr><tr><td>molar mass:</td><td>428.596 g/mol (PubChem CID 11519070)</td></tr></table></body></html>"));
