  annotation (Documentation(info = "<html><body><p>Potassium gluconate is a potassium supplement used to treat or prevent low blood potassium (hypokalemia). It is an approved mineral supplement and is widely available, generally as an oral supplement.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1122870\">Wikidata Q1122870</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>potassium gluconate</td></tr><tr><td>ATC codes:</td><td>A12BA05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13620\">DB13620</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/16760467\">16760467</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32032\">32032</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1122870\">Q1122870</a></td></tr><tr><td>formula:</td><td>C6H11KO7</td></tr><tr><td>molar mass:</td><td>234.245 g/mol (PubChem CID 16760467)</td></tr></table></body></html>"));
