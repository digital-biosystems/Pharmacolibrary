  annotation (Documentation(info = "<html><body><p>Prifinium is a synthetic anticholinergic (quaternary ammonium) drug classified for functional gastrointestinal disorders. It appears to be only experimental, with no confirmed current marketing authorisation, so its present use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2109656&quot;>Wikidata Q2109656</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Prifinium</td></tr><tr><td>ATC codes:</td><td>A03AB18</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13254&quot;>DB13254</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4905&quot;>4905</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2109656&quot;>Q2109656</a></td></tr><tr><td>formula:</td><td>C22H28N+</td></tr><tr><td>molar mass:</td><td>306.473 g/mol (PubChem)</td></tr></table></body></html>"));
