within Pharmacolibrary.Drugs.Substances;
package EscherichiaColi "escherichia coli"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "escherichia coli",
    atcCodes = {"A07FA03"},
    drugbankId = "DB16539");
  annotation (Documentation(info = "<html><body><p>Escherichia coli is classified as an antidiarrheal microorganism, suggesting use for diarrhoea. It is listed as investigational and has no authorised marketing in the European Union.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>escherichia coli</td></tr><tr><td>ATC codes:</td><td>A07FA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB16539\">DB16539</a></td></tr></table></body></html>"));
end EscherichiaColi;
