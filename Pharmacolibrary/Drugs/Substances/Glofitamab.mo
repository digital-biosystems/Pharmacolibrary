  annotation (Documentation(info = "<html><body><p>Glofitamab is a monoclonal antibody used to treat diffuse large B-cell lymphoma. It is authorised in the European Union and is also being investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q117846135\">Wikidata Q117846135</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>glofitamab</td></tr><tr><td>ATC codes:</td><td>L01FX28</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB16371\">DB16371</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q117846135\">Q117846135</a></td></tr><tr><td>molar mass:</td><td>194000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
