  annotation (Documentation(info = "<html><body><p>Clopamide is a diuretic of the sulfonamide type, used to treat conditions such as high blood pressure and fluid retention. It is not an approved medicine in major markets and is considered investigational, with no authorisation recorded in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5135114&quot;>Wikidata Q5135114</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>clopamide</td></tr><tr><td>ATC codes:</td><td>C03BA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13792&quot;>DB13792</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/12492&quot;>12492</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:94521&quot;>94521</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5135114&quot;>Q5135114</a></td></tr><tr><td>formula:</td><td>C14H20ClN3O3S</td></tr><tr><td>molar mass:</td><td>345.842 g/mol (PubChem)</td></tr></table></body></html>"));
