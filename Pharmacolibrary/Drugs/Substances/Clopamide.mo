within Pharmacolibrary.Drugs.Substances;
package Clopamide "clopamide"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "clopamide",
    atcCodes = {"C03BA03"},
    drugbankId = "DB13792",
    pubchemCid = "12492",
    chebiId = "94521",
    wikidataId = "Q106029851",
    formula = "C14H20ClN3O3S",
    M = 0.345842,
    logP = 2.3);
  annotation (Documentation(info = "<html><body><p>Clopamide is a sulfonamide diuretic that has been used to treat high blood pressure and fluid retention (oedema). It is currently classed as investigational and is not authorised in the European Union; it has only limited availability in a few countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q106029851\">Wikidata Q106029851</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>clopamide</td></tr><tr><td>ATC codes:</td><td>C03BA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13792\">DB13792</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/12492\">12492</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:94521\">94521</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q106029851\">Q106029851</a></td></tr><tr><td>formula:</td><td>C14H20ClN3O3S</td></tr><tr><td>molar mass:</td><td>345.842 g/mol (PubChem CID 12492)</td></tr><tr><td>logP:</td><td>2.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Clopamide;
