  annotation (Documentation(info = "<html><body><p>Guanazodine is a guanidine-derivative antihypertensive that acts peripherally on the nervous system to lower blood pressure. It is not an established marketed medicine and appears only as an experimental compound, so its current availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5613575\">Wikidata Q5613575</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>guanazodine</td></tr><tr><td>ATC codes:</td><td>C02CC06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13604\">DB13604</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/36054\">36054</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134828\">134828</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5613575\">Q5613575</a></td></tr><tr><td>formula:</td><td>C9H20N4</td></tr><tr><td>molar mass:</td><td>184.287 g/mol (PubChem CID 36054)</td></tr><tr><td>logP:</td><td>0.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
