  annotation (Documentation(info = "<html><body><p>Vinorelbine, a Vinca alkaloid, is an anticancer medicine used to treat breast cancer, ovarian cancer, non-small-cell lung carcinoma, and mixed-cellularity Hodgkin's lymphoma. It is an approved medicine and is included on the WHO list of essential medicines, indicating broad international use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q420532\">Wikidata Q420532</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>vinorelbine</td></tr><tr><td>ATC codes:</td><td>L01CA04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00361\">DB00361</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/44424639\">44424639</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:480999\">480999</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q420532\">Q420532</a></td></tr><tr><td>formula:</td><td>C45H54N4O8</td></tr><tr><td>molar mass:</td><td>778.947 g/mol (PubChem CID 44424639)</td></tr><tr><td>logP:</td><td>3.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Vinorelbine;
