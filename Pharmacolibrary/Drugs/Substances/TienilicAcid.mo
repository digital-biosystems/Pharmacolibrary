    logP = 4.1);
  annotation (Documentation(info = "<html><body><p>Tienilic acid (ticrynafen) is a diuretic that was used to treat high blood pressure and fluid retention, and also promotes uric acid excretion. It was withdrawn from the market after approval because of safety concerns, so it is no longer used.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7801054\">Wikidata Q7801054</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tienilic acid</td></tr><tr><td>ATC codes:</td><td>C03CC02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB04831\">DB04831</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/38409\">38409</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9590\">9590</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7801054\">Q7801054</a></td></tr><tr><td>formula:</td><td>C13H8Cl2O4S</td></tr><tr><td>molar mass:</td><td>331.163 g/mol (PubChem CID 38409)</td></tr><tr><td>logP:</td><td>4.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end TienilicAcid;
