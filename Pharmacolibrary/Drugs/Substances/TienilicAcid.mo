  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "tienilic acid",
    atcCodes = {"C03CC02"},
    drugbankId = "DB04831",
    pubchemCid = "38409",
    chebiId = "9590",
    wikidataId = "Q7801054",
    formula = "C13H8Cl2O4S",
