  annotation (Documentation(info = "<html><body><p>Natalizumab is a monoclonal antibody used to treat multiple sclerosis, including relapsing-remitting forms, and Crohn's disease. It is authorised in the European Union and prescribed under medical supervision, carrying a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q386119\">Wikidata Q386119</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>natalizumab</td></tr><tr><td>ATC codes:</td><td>L03AD, L04AG03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00108\">DB00108</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q386119\">Q386119</a></td></tr><tr><td>molar mass:</td><td>149000 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
