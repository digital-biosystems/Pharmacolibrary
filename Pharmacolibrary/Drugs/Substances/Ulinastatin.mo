  annotation (Documentation(info = "<html><body><p>Ulinastatin, a protease inhibitor classified as an antifibrinolytic, has been investigated for conditions such as severe inflammation, including pancreatitis and sepsis. It is considered investigational and is not an approved medicine in the European Union.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ulinastatin</td></tr><tr><td>ATC codes:</td><td>B02AB05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12038&quot;>DB12038</a></td></tr></table></body></html>"));
