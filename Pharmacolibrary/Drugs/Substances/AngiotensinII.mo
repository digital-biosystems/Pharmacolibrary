    logP = -1.7);
  annotation (Documentation(info = "<html><body><p>Angiotensin II, a peptide hormone, is used as a cardiac stimulant to raise blood pressure in hypotension and shock. It is authorised in the European Union, but its use is limited to a single approved product, mainly in hospital settings for severe low blood pressure.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q412999&quot;>Wikidata Q412999</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>angiotensin II</td></tr><tr><td>ATC codes:</td><td>C01CX09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11842&quot;>DB11842</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/172198&quot;>172198</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:2719&quot;>2719</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q412999&quot;>Q412999</a></td></tr><tr><td>formula:</td><td>C50H71N13O12</td></tr><tr><td>molar mass:</td><td>1046.2 g/mol (PubChem)</td></tr></table></body></html>"));
end AngiotensinII;
