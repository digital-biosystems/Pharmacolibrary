  annotation (Documentation(info = "<html><body><p>Oxyphencyclimine is an anticholinergic drug used to treat functional gastrointestinal disorders, such as spasms. It is an approved medicine, but appears to be little used today and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1227228\">Wikidata Q1227228</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>oxyphencyclimine</td></tr><tr><td>ATC codes:</td><td>A03AA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00383\">DB00383</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4642\">4642</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7868\">7868</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1227228\">Q1227228</a></td></tr><tr><td>formula:</td><td>C20H28N2O3</td></tr><tr><td>molar mass:</td><td>344.455 g/mol (PubChem CID 4642)</td></tr><tr><td>logP:</td><td>2.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
