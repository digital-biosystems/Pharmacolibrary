    logP = 2.3);
  annotation (Documentation(info = "<html><body><p>Desoximetasone is a potent topical corticosteroid used to treat inflammatory skin conditions such as psoriasis and various dermatoses of the face, scalp, legs, and hands. It is an approved medicine, applied to the skin as a dermatological preparation, and is available alone or in combination products.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q385370&quot;>Wikidata Q385370</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>desoximetasone</td></tr><tr><td>ATC codes:</td><td>D07AC03, D07XC02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00547&quot;>DB00547</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5311067&quot;>5311067</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:691037&quot;>691037</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q385370&quot;>Q385370</a></td></tr><tr><td>formula:</td><td>C22H29FO4</td></tr><tr><td>molar mass:</td><td>376.468 g/mol (PubChem)</td></tr></table></body></html>"));
end Desoximetasone;
