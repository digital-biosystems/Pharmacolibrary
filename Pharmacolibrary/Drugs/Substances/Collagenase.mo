within Pharmacolibrary.Drugs.Substances;
package Collagenase "collagenase"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "collagenase",
    atcCodes = {"D03BA02", "M09AB02"},
    drugbankId = "DB00048",
    pubchemCid = "75007581",
    wikidataId = "Q5145911",
    formula = "C60H100N2",
    M = 0.849474,
    logP = 21.9);
  annotation (Documentation(info = "<html><body><p>Collagenase clostridium histolyticum is an enzyme medicine used to treat Dupuytren's contracture, and collagenase preparations are also used on wounds and ulcers. It is an approved medicine, though one European Union product has been withdrawn, and it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5145911&quot;>Wikidata Q5145911</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>collagenase</td></tr><tr><td>ATC codes:</td><td>D03BA02, M09AB02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00048&quot;>DB00048</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/75007581&quot;>75007581</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5145911&quot;>Q5145911</a></td></tr><tr><td>formula:</td><td>C60H100N2</td></tr><tr><td>molar mass:</td><td>849.474 g/mol (PubChem)</td></tr></table></body></html>"));
end Collagenase;
