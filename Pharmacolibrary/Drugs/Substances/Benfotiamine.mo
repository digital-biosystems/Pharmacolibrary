    logP = 0.5);
  annotation (Documentation(info = "<html><body><p>Benfotiamine is a vitamin B1 analogue used as a thiamine supplement, for example in vitamin B1 deficiency. It is available as a vitamin product in the ATC vitamins group, though it has also been investigated for other uses and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q409953\">Wikidata Q409953</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>benfotiamine</td></tr><tr><td>ATC codes:</td><td>A11DA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11748\">DB11748</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3032771\">3032771</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:41039\">41039</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q409953\">Q409953</a></td></tr><tr><td>formula:</td><td>C19H23N4O6PS</td></tr><tr><td>molar mass:</td><td>466.449 g/mol (PubChem CID 3032771)</td></tr><tr><td>logP:</td><td>0.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
