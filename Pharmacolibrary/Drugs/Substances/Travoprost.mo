within Pharmacolibrary.Drugs.Substances;
package Travoprost "travoprost"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "travoprost",
    atcCodes = {"S01EE04"},
    drugbankId = "DB00287",
    pubchemCid = "5282226",
    chebiId = "746859",
    wikidataId = "Q2193376",
    formula = "C26H35F3O6",
    M = 0.500554,
    logP = 4.1);
  annotation (Documentation(info = "<html><body><p>Travoprost is a prostaglandin analogue eye medicine used to lower pressure in the eye in glaucoma, especially open-angle glaucoma, and ocular hypertension. It is approved and widely used, with products authorised in the European Union for these eye conditions.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2193376\">Wikidata Q2193376</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>travoprost</td></tr><tr><td>ATC codes:</td><td>S01EE04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00287\">DB00287</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5282226\">5282226</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:746859\">746859</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2193376\">Q2193376</a></td></tr><tr><td>formula:</td><td>C26H35F3O6</td></tr><tr><td>molar mass:</td><td>500.554 g/mol (PubChem CID 5282226)</td></tr><tr><td>logP:</td><td>4.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Travoprost;
