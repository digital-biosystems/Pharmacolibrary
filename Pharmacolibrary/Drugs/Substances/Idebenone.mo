    logP = 4.3);
  annotation (Documentation(info = "<html><body><p>Idebenone, an antioxidant drug, is used to treat Leber hereditary optic atrophy and has also been studied for Friedreich ataxia. It is authorised in the European Union for this eye condition, though other marketing applications there were withdrawn or refused.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4197874\">Wikidata Q4197874</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>idebenone</td></tr><tr><td>ATC codes:</td><td>N06BX13</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09081\">DB09081</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/12881464\">12881464</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31687\">31687</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4197874\">Q4197874</a></td></tr><tr><td>formula:</td><td>C21H34O5</td></tr><tr><td>molar mass:</td><td>366.498 g/mol (PubChem CID 12881464)</td></tr><tr><td>logP:</td><td>4.3 (Drugs.Common 25.09, not verified)</td></tr></table><p><small>Drugs.Common 25.09 gave 338.4 g/mol (-7.7 %); replaced by the value above</small></p></body></html>"));
end Idebenone;
