  annotation (Documentation(info = "<html><body><p>Ifenprodil is a vasodilator and alpha blocker that was used as a peripheral vasodilator for circulatory disorders. It has been withdrawn and is no longer in clinical use, though it remains of research interest.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5991156&quot;>Wikidata Q5991156</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ifenprodil</td></tr><tr><td>ATC codes:</td><td>C04AX28</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08954&quot;>DB08954</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3689&quot;>3689</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:93829&quot;>93829</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5991156&quot;>Q5991156</a></td></tr><tr><td>formula:</td><td>C21H27NO2</td></tr><tr><td>molar mass:</td><td>325.452 g/mol (PubChem)</td></tr></table></body></html>"));
