    logP = -2.4);
  annotation (Documentation(info = "<html><body><p>Gonadorelin, a gonadotropin-releasing hormone, is used to treat amenorrhea and as a diagnostic test for fertility disturbances. It is approved for human and veterinary use, though it remains investigational for some purposes.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q20817116&quot;>Wikidata Q20817116</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>gonadorelin</td></tr><tr><td>ATC codes:</td><td>H01CA01, V04CM01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00644&quot;>DB00644</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/36523&quot;>36523</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q20817116&quot;>Q20817116</a></td></tr><tr><td>formula:</td><td>C55H75N17O13</td></tr><tr><td>molar mass:</td><td>1182.31 g/mol (PubChem)</td></tr></table></body></html>"));
end Gonadorelin;
