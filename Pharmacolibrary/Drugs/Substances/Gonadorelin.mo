  annotation (Documentation(info = "<html><body><p>Gonadorelin, a gonadotropin-releasing hormone, is used to treat amenorrhea and as a diagnostic test for fertility disturbances. It is approved for human and veterinary use, though it remains investigational for some purposes.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q20817116\">Wikidata Q20817116</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>gonadorelin</td></tr><tr><td>ATC codes:</td><td>H01CA01, V04CM01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00644\">DB00644</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/36523\">36523</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q20817116\">Q20817116</a></td></tr><tr><td>molar mass:</td><td>1182.3 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>-2.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Gonadorelin;
