  annotation (Documentation(info = "<html><body><p>Basiliximab is an immunosuppressive monoclonal antibody used to prevent graft rejection in kidney transplantation. It is authorised in the European Union and used in transplant medicine, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q418702&quot;>Wikidata Q418702</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>basiliximab</td></tr><tr><td>ATC codes:</td><td>L04AC02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00074&quot;>DB00074</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q418702&quot;>Q418702</a></td></tr><tr><td>molar mass:</td><td>143801 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Basiliximab;
