  annotation (Documentation(info = "<html><body><p>Tazarotene is a topical retinoid used to treat skin conditions such as psoriasis and acne. It is an approved dermatological medicine, applied topically mainly for psoriasis and related skin disorders.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3981685&quot;>Wikidata Q3981685</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tazarotene</td></tr><tr><td>ATC codes:</td><td>D05AX05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00799&quot;>DB00799</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5381&quot;>5381</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32184&quot;>32184</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3981685&quot;>Q3981685</a></td></tr><tr><td>formula:</td><td>C21H21NO2S</td></tr><tr><td>molar mass:</td><td>351.464 g/mol (PubChem)</td></tr></table></body></html>"));
