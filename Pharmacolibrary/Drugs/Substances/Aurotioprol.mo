  annotation (Documentation(info = "<html><body><p>Aurotioprol is a gold preparation that was used as a disease-modifying antirheumatic drug for rheumatic conditions. It is no longer in routine use and is regarded today as an experimental compound.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3629883&quot;>Wikidata Q3629883</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>aurotioprol</td></tr><tr><td>ATC codes:</td><td>M01CB05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13763&quot;>DB13763</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/10452965&quot;>10452965</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3629883&quot;>Q3629883</a></td></tr><tr><td>formula:</td><td>C3H6AuNaO4S2</td></tr><tr><td>molar mass:</td><td>390.157 g/mol (PubChem)</td></tr></table></body></html>"));
