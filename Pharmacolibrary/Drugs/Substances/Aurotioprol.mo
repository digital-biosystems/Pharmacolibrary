  annotation (Documentation(info = "<html><body><p>Aurotioprol is a gold preparation classified as a specific antirheumatic agent, historically used to treat rheumatic disease. It is currently listed only as an experimental compound and does not appear to be an approved medicine today.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q126676507\">Wikidata Q126676507</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>aurotioprol</td></tr><tr><td>ATC codes:</td><td>M01CB05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13763\">DB13763</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/10452965\">10452965</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q126676507\">Q126676507</a></td></tr><tr><td>formula:</td><td>C3H6AuNaO4S2</td></tr><tr><td>molar mass:</td><td>390.157 g/mol (PubChem CID 10452965)</td></tr></table></body></html>"));
