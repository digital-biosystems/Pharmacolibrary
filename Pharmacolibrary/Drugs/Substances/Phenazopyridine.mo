  annotation (Documentation(info = "<html><body><p>Phenazopyridine is a urinary tract analgesic used to relieve pain and urological symptoms. It is an approved drug, used mainly for urinary tract discomfort; it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3114549\">Wikidata Q3114549</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>phenazopyridine</td></tr><tr><td>ATC codes:</td><td>G04BX06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01438\">DB01438</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4756\">4756</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:71416\">71416</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3114549\">Q3114549</a></td></tr><tr><td>formula:</td><td>C11H11N5</td></tr><tr><td>molar mass:</td><td>213.244 g/mol (PubChem CID 4756)</td></tr><tr><td>logP:</td><td>1.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
