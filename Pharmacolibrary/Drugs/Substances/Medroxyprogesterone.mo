  annotation (Documentation(info = "<html><body><p>Medroxyprogesterone is a synthetic progestin used for hormonal contraception, in combination preparations, and to treat endometriosis, and also as endocrine cancer therapy. It is widely used and approved, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q416667\">Wikidata Q416667</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>medroxyprogesterone</td></tr><tr><td>ATC codes:</td><td>G03AC06, G03DA02, L02AB02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00603\">DB00603</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6279\">6279</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6716\">6716</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q416667\">Q416667</a></td></tr><tr><td>formula:</td><td>C24H34O4</td></tr><tr><td>molar mass:</td><td>386.532 g/mol (PubChem CID 6279)</td></tr><tr><td>logP:</td><td>3.5 (Drugs.Common 25.09, not verified)</td></tr></table><p><small>Drugs.Common 25.09 gave 344.5 g/mol (-10.9 %); replaced by the value above</small></p></body></html>"));
