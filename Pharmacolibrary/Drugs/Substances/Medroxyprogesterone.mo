  annotation (Documentation(info = "<html><body><p>Medroxyprogesterone acetate is a progestogen used as an injectable hormonal contraceptive and in endocrine therapy for cancer. It is widely used worldwide and is included on the WHO list of essential medicines, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2823834&quot;>Wikidata Q2823834</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>medroxyprogesterone</td></tr><tr><td>ATC codes:</td><td>G03AC06, G03DA02, L02AB02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00603&quot;>DB00603</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6279&quot;>6279</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6716&quot;>6716</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2823834&quot;>Q2823834</a></td></tr><tr><td>formula:</td><td>C24H34O4</td></tr><tr><td>molar mass:</td><td>386.532 g/mol (PubChem)</td></tr></table></body></html>"));
