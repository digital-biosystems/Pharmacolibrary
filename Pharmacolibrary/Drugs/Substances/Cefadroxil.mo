  annotation (Documentation(info = "<html><body><p>Cefadroxil is a first-generation cephalosporin antibiotic used to treat bacterial infections such as impetigo, pharyngitis, and urinary tract infections. It is an approved antibacterial used in human medicine and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2319020&quot;>Wikidata Q2319020</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cefadroxil</td></tr><tr><td>ATC codes:</td><td>J01DB05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01140&quot;>DB01140</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/47965&quot;>47965</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3479&quot;>3479</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2319020&quot;>Q2319020</a></td></tr><tr><td>formula:</td><td>C16H17N3O5S</td></tr><tr><td>molar mass:</td><td>363.388 g/mol (PubChem)</td></tr></table></body></html>"));
