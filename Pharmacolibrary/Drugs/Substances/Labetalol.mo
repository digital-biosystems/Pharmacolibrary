within Pharmacolibrary.Drugs.Substances;
package Labetalol "labetalol"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "labetalol",
    atcCodes = {"C07AG01"},
    drugbankId = "DB00598",
    pubchemCid = "3869",
    chebiId = "167638",
    wikidataId = "Q958087",
    formula = "C19H24N2O3",
    M = 0.328412,
    logP = 3.1);
  annotation (Documentation(info = "<html><body><p>Labetalol is a beta blocker with alpha-blocking activity used to treat high blood pressure, including severe forms, as well as heart-related conditions such as angina, heart attack, and heart failure. It is an approved medicine and remains in general clinical use, often in hospital settings for hypertensive emergencies.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q958087&quot;>Wikidata Q958087</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>labetalol</td></tr><tr><td>ATC codes:</td><td>C07AG01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00598&quot;>DB00598</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3869&quot;>3869</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:167638&quot;>167638</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q958087&quot;>Q958087</a></td></tr><tr><td>formula:</td><td>C19H24N2O3</td></tr><tr><td>molar mass:</td><td>328.412 g/mol (PubChem)</td></tr></table></body></html>"));
end Labetalol;
