  annotation (Documentation(info = "<html><body><p>Pentamycin is an antibiotic classified for gynecological antiinfective use, treating vaginal infections. It appears only as an experimental drug, with no confirmed marketing authorisation, so its current availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7165030&quot;>Wikidata Q7165030</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pentamycin</td></tr><tr><td>ATC codes:</td><td>G01AA11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13571&quot;>DB13571</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5282200&quot;>5282200</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31639&quot;>31639</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7165030&quot;>Q7165030</a></td></tr><tr><td>formula:</td><td>C35H58O12</td></tr><tr><td>molar mass:</td><td>670.837 g/mol (PubChem)</td></tr></table></body></html>"));
