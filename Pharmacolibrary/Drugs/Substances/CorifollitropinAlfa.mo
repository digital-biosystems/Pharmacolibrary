  annotation (Documentation(info = "<html><body><p>Corifollitropin alfa is a gonadotropin used to stimulate ovulation in assisted reproduction techniques. It is authorised in the European Union and used in fertility treatment.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q28852241&quot;>Wikidata Q28852241</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>corifollitropin alfa</td></tr><tr><td>ATC codes:</td><td>G03GA09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09066&quot;>DB09066</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q28852241&quot;>Q28852241</a></td></tr><tr><td>molar mass:</td><td>25398 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
