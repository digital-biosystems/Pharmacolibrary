    logP = 3.3);
  annotation (Documentation(info = "<html><body><p>Bromfenac is a non-steroidal anti-inflammatory drug used to treat pain and inflammation after eye surgery. It is authorised in the European Union as an eye drop for postoperative ocular pain, and is also approved elsewhere.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2487682&quot;>Wikidata Q2487682</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>bromfenac</td></tr><tr><td>ATC codes:</td><td>S01BC11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00963&quot;>DB00963</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/60726&quot;>60726</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:240107&quot;>240107</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2487682&quot;>Q2487682</a></td></tr><tr><td>formula:</td><td>C15H12BrNO3</td></tr><tr><td>molar mass:</td><td>334.169 g/mol (PubChem)</td></tr></table></body></html>"));
end Bromfenac;
