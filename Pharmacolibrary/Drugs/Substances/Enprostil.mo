  annotation (Documentation(info = "<html><body><p>Enprostil is a prostaglandin that was developed as an anti-ulcer drug for acid-related disorders such as peptic ulcer. It is not an established marketed medicine today; it appears only as an experimental compound and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5379483\">Wikidata Q5379483</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>enprostil</td></tr><tr><td>ATC codes:</td><td>A02BB02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13824\">DB13824</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9978336\">9978336</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31538\">31538</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5379483\">Q5379483</a></td></tr><tr><td>formula:</td><td>C23H28O6</td></tr><tr><td>molar mass:</td><td>400.471 g/mol (PubChem CID 9978336)</td></tr><tr><td>logP:</td><td>1.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
