    logP = 0.6);
  annotation (Documentation(info = "<html><body><p>Suxamethonium (succinylcholine) is a depolarizing neuromuscular blocking agent used as a muscle relaxant, for example to relax muscles during medical procedures. It remains an approved medicine and is included on the WHO list of essential medicines, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q424378\">Wikidata Q424378</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>suxamethonium</td></tr><tr><td>ATC codes:</td><td>M03AB01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00202\">DB00202</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5314\">5314</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:45652\">45652</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q424378\">Q424378</a></td></tr><tr><td>formula:</td><td>C14H30N2O4+2</td></tr><tr><td>molar mass:</td><td>290.404 g/mol (PubChem CID 5314)</td></tr><tr><td>logP:</td><td>0.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
