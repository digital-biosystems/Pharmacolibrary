  annotation (Documentation(info = "<html><body><p>Etofibrate is a fibrate that was developed as a lipid-lowering (hypolipidemic) agent to reduce cholesterol levels. It is not an approved medicine and is regarded as experimental, with no authorisation in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4116990&quot;>Wikidata Q4116990</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>etofibrate</td></tr><tr><td>ATC codes:</td><td>C10AB09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08983&quot;>DB08983</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/65777&quot;>65777</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135535&quot;>135535</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4116990&quot;>Q4116990</a></td></tr><tr><td>formula:</td><td>C18H18ClNO5</td></tr><tr><td>molar mass:</td><td>363.794 g/mol (PubChem)</td></tr></table></body></html>"));
