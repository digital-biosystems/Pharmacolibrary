  annotation (Documentation(info = "<html><body><p>Reteplase is a fibrinolytic (plasminogen-activating) drug that was used to treat myocardial infarction. Its products have been withdrawn from the European Union market, so it is no longer authorised there.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3933703&quot;>Wikidata Q3933703</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>reteplase</td></tr><tr><td>ATC codes:</td><td>B01AD07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00015&quot;>DB00015</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3933703&quot;>Q3933703</a></td></tr><tr><td>molar mass:</td><td>39589.6 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
