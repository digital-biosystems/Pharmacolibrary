    logP = 3.3);
  annotation (Documentation(info = "<html><body><p>Fencamfamin is a central nervous system stimulant that was used as a psychostimulant, in the class of agents used for ADHD and nootropics. It has been withdrawn in many countries and is also encountered as an illicit stimulant, though it remains approved in a limited number of places.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3742409\">Wikidata Q3742409</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>fencamfamin</td></tr><tr><td>ATC codes:</td><td>N06BA06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01463\">DB01463</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/14584\">14584</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134895\">134895</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3742409\">Q3742409</a></td></tr><tr><td>formula:</td><td>C15H21N</td></tr><tr><td>molar mass:</td><td>215.34 g/mol (PubChem CID 14584)</td></tr><tr><td>logP:</td><td>3.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Fencamfamin;
