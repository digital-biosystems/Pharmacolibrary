  annotation (Documentation(info = "<html><body><p>Epinastine is an antihistamine used to treat allergic conditions, including allergic rhinitis and allergic eye disease. It is an approved medicine, available both as an oral antihistamine and as an eye drop for antiallergic use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q632405\">Wikidata Q632405</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>epinastine</td></tr><tr><td>ATC codes:</td><td>R06AX24, S01GX10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00751\">DB00751</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3241\">3241</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:51032\">51032</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q632405\">Q632405</a></td></tr><tr><td>formula:</td><td>C16H15N3</td></tr><tr><td>molar mass:</td><td>249.317 g/mol (PubChem CID 3241)</td></tr><tr><td>logP:</td><td>3.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
