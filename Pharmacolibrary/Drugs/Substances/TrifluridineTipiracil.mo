  annotation (Documentation(info = "<html><body><p>Trifluridine with tipiracil is an antimetabolite combination used to treat colorectal, rectosigmoid, rectal and appendix cancers, and trifluridine alone is used against herpes simplex keratitis. It is an approved medicine, though its exact marketing regions are not specified in the available facts.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2359590\">Wikidata Q2359590</a>; not checked by a person.</small></p><table><tr><td>name:</td><td>trifluridine;tipiracil</td></tr><tr><td>ATC codes:</td><td>—</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00432\">DB00432</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6256\">6256</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:75179\">75179</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2359590\">Q2359590</a></td></tr><tr><td>formula:</td><td>C10H11F3N2O5</td></tr><tr><td>molar mass:</td><td>296.201 g/mol (PubChem CID 6256)</td></tr></table></body></html>"));
