  annotation (Documentation(info = "<html><body><p>Mephenesin is a centrally acting muscle relaxant that was used to relieve muscle spasm and stiffness. It has been withdrawn and is no longer in clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3333250\">Wikidata Q3333250</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mephenesin</td></tr><tr><td>ATC codes:</td><td>M03BX06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13583\">DB13583</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4059\">4059</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:94398\">94398</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3333250\">Q3333250</a></td></tr><tr><td>formula:</td><td>C10H14O3</td></tr><tr><td>molar mass:</td><td>182.219 g/mol (PubChem CID 4059)</td></tr><tr><td>logP:</td><td>1.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
