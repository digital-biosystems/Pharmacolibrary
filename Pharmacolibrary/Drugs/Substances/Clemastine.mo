  annotation (Documentation(info = "<html><body><p>Clemastine is an antihistamine (H1 antagonist) used to treat allergic conditions such as urticaria and itching. It is an approved drug, available both as a systemic antihistamine and as a topical antipruritic for skin use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q418145&quot;>Wikidata Q418145</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>clemastine</td></tr><tr><td>ATC codes:</td><td>D04AA14, R06AA04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00283&quot;>DB00283</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/26987&quot;>26987</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3738&quot;>3738</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q418145&quot;>Q418145</a></td></tr><tr><td>formula:</td><td>C21H26ClNO</td></tr><tr><td>molar mass:</td><td>343.895 g/mol (PubChem)</td></tr></table></body></html>"));
end Clemastine;
