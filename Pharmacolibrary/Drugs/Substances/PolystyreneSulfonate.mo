    M = 0.228306);
  annotation (Documentation(info = "<html><body><p>Polystyrene sulfonate is a potassium-binding polymer used to treat high potassium levels in the blood (hyperkalemia). It is an approved medicine, classified under drugs for treating hyperkalemia and hyperphosphatemia.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3395465&quot;>Wikidata Q3395465</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>polystyrene sulfonate</td></tr><tr><td>ATC codes:</td><td>V03AE01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01344&quot;>DB01344</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/58817179&quot;>58817179</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3395465&quot;>Q3395465</a></td></tr><tr><td>formula:</td><td>C11H16O3S</td></tr><tr><td>molar mass:</td><td>228.306 g/mol (PubChem)</td></tr></table></body></html>"));
end PolystyreneSulfonate;
