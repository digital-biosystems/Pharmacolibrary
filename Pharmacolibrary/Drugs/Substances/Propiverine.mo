  annotation (Documentation(info = "<html><body><p>Propiverine is a muscarinic antagonist used to treat urinary frequency and incontinence (overactive bladder). It is an approved drug, used mainly in urology, though it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q904321\">Wikidata Q904321</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>propiverine</td></tr><tr><td>ATC codes:</td><td>G04BD06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12278\">DB12278</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4942\">4942</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8493\">8493</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q904321\">Q904321</a></td></tr><tr><td>formula:</td><td>C23H29NO3</td></tr><tr><td>molar mass:</td><td>367.489 g/mol (PubChem CID 4942)</td></tr><tr><td>logP:</td><td>4.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
