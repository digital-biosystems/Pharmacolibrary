  annotation (Documentation(info = "<html><body><p>Thymopentin, a pentapeptide fragment of thymopoietin, is an immunostimulant that has been investigated as an immune-boosting therapy. It remains an investigational drug and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7799637\">Wikidata Q7799637</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>thymopentin</td></tr><tr><td>ATC codes:</td><td>L03AX09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11996\">DB11996</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/451417\">451417</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135870\">135870</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7799637\">Q7799637</a></td></tr><tr><td>formula:</td><td>C30H49N9O9</td></tr><tr><td>molar mass:</td><td>679.776 g/mol (PubChem CID 451417)</td></tr><tr><td>logP:</td><td>-6.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
