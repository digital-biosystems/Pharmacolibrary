    M = 0.275092);
  annotation (Documentation(info = "<html><body><p>Acetarsol is an arsenic-based anti-infective that was used as an intestinal antiinfective, a gynecological antiseptic, and an antiprotozoal agent. It is no longer in use, having been withdrawn, largely because of concerns over arsenic toxicity.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q584079\">Wikidata Q584079</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>acetarsol</td></tr><tr><td>ATC codes:</td><td>A07AX02, G01AB01, P01CD02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13268\">DB13268</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/1985\">1985</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135135\">135135</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q584079\">Q584079</a></td></tr><tr><td>formula:</td><td>C8H10AsNO5</td></tr><tr><td>molar mass:</td><td>275.092 g/mol (PubChem CID 1985)</td></tr></table></body></html>"));
end Acetarsol;
