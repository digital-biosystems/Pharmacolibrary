  annotation (Documentation(info = "<html><body><p>Fotemustine is a nitrosourea alkylating agent with antineoplastic activity, investigated for the treatment of cancer. It is not approved by the European Medicines Agency and remains investigational in major databases, so its use is limited.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1439555\">Wikidata Q1439555</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>fotemustine</td></tr><tr><td>ATC codes:</td><td>L01AD05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB04106\">DB04106</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/46936889\">46936889</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:131852\">131852</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1439555\">Q1439555</a></td></tr><tr><td>formula:</td><td>C9H19ClN3O5P</td></tr><tr><td>molar mass:</td><td>315.691 g/mol (PubChem CID 46936889)</td></tr><tr><td>logP:</td><td>0.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
