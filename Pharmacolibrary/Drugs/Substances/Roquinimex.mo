    logP = 2.7);
  annotation (Documentation(info = "<html><body><p>Roquinimex (Linomide) is an immunostimulant that was investigated as an immunologic adjuvant and angiogenesis inhibitor for immune-related conditions such as multiple sclerosis. It remains experimental and is not an approved medicine; trials were halted after serious cardiovascular side effects.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q964482&quot;>Wikidata Q964482</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>roquinimex</td></tr><tr><td>ATC codes:</td><td>L03AX02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11366&quot;>DB11366</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/54676478&quot;>54676478</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:92056&quot;>92056</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q964482&quot;>Q964482</a></td></tr><tr><td>formula:</td><td>C18H16N2O3</td></tr><tr><td>molar mass:</td><td>308.337 g/mol (PubChem)</td></tr></table></body></html>"));
end Roquinimex;
