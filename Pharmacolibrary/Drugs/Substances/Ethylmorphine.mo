  annotation (Documentation(info = "<html><body><p>Ethylmorphine is an opioid of the morphinan alkaloid family that has been used as a cough suppressant and in eye preparations. It is classified as investigational and illicit, so it does not appear to be in routine medical use today.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q554881\">Wikidata Q554881</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ethylmorphine</td></tr><tr><td>ATC codes:</td><td>R05DA01, S01XA06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01466\">DB01466</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5359271\">5359271</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4902\">4902</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q554881\">Q554881</a></td></tr><tr><td>formula:</td><td>C19H23NO3</td></tr><tr><td>molar mass:</td><td>313.397 g/mol (PubChem CID 5359271)</td></tr><tr><td>logP:</td><td>1.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
