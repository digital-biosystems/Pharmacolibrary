    logP = 2.3);
  annotation (Documentation(info = "<html><body><p>Methysergide is an ergot alkaloid that was used to prevent migraine headaches. It has been withdrawn from the market, largely because of serious side effects such as fibrotic complications with long-term use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q424442&quot;>Wikidata Q424442</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>methysergide</td></tr><tr><td>ATC codes:</td><td>N02CA04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00247&quot;>DB00247</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6540428&quot;>6540428</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:584020&quot;>584020</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q424442&quot;>Q424442</a></td></tr><tr><td>formula:</td><td>C21H27N3O2</td></tr><tr><td>molar mass:</td><td>353.466 g/mol (PubChem)</td></tr></table></body></html>"));
