    logP = 0.2);
  annotation (Documentation(info = "<html><body><p>Guanoxan is a guanidine-derivative medicine used to lower high blood pressure. It is classed as a peripherally acting antiadrenergic antihypertensive and is listed as an approved drug, though it does not appear to have a current authorisation from the European Medicines Agency.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3778223&quot;>Wikidata Q3778223</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>guanoxan</td></tr><tr><td>ATC codes:</td><td>C02CC03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13211&quot;>DB13211</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/16564&quot;>16564</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134871&quot;>134871</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3778223&quot;>Q3778223</a></td></tr><tr><td>formula:</td><td>C10H13N3O2</td></tr><tr><td>molar mass:</td><td>207.233 g/mol (PubChem)</td></tr></table></body></html>"));
end Guanoxan;
