within Pharmacolibrary.Drugs.Substances;
package Glucarpidase "glucarpidase"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "glucarpidase",
    atcCodes = {"V03AF09"},
    drugbankId = "DB08898",
    wikidataId = "Q5572303",
    M = 0.2615);
  annotation (Documentation(info = "<html><body><p>Glucarpidase is a detoxifying agent used to treat toxicity caused by antineoplastic (cancer) treatment, specifically high levels of methotrexate in the blood. It is an approved medicine, with one product authorised in the European Union, though it remains a specialised rescue therapy used mainly in hospital settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5572303\">Wikidata Q5572303</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>glucarpidase</td></tr><tr><td>ATC codes:</td><td>V03AF09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08898\">DB08898</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5572303\">Q5572303</a></td></tr><tr><td>molar mass:</td><td>261.5 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Glucarpidase;
