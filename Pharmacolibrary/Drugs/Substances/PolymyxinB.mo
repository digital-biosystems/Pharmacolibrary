within Pharmacolibrary.Drugs.Substances;
package PolymyxinB "polymyxin B"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "polymyxin B",
    atcCodes = {"A07AA05", "J01XB02", "S01AA18", "S02AA11", "S03AA03"},
    drugbankId = "DB00781",
    wikidataId = "Q1088175");
  annotation (Documentation(info = "<html><body><p>Polymyxin B is an antibiotic used to treat infections caused by susceptible bacteria such as Escherichia coli and Bacteroides, and is also applied as an intestinal antiinfective and in eye and ear preparations. It remains in use, with approved and veterinary-approved status, though it is not an EU-authorised product according to the available data.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q1088175&quot;>Wikidata Q1088175</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>polymyxin B</td></tr><tr><td>ATC codes:</td><td>A07AA05, J01XB02, S01AA18, S02AA11, S03AA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00781&quot;>DB00781</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q1088175&quot;>Q1088175</a></td></tr></table></body></html>"));
end PolymyxinB;
