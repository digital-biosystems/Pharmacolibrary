  annotation (Documentation(info = "<html><body><p>Pidotimod is an immunostimulant drug investigated as an immune-boosting agent, acting as an immunologic adjuvant. It is not approved by the European Medicines Agency and remains investigational rather than in widespread clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3902720&quot;>Wikidata Q3902720</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pidotimod</td></tr><tr><td>ATC codes:</td><td>L03AX05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11364&quot;>DB11364</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/65944&quot;>65944</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:94618&quot;>94618</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3902720&quot;>Q3902720</a></td></tr><tr><td>formula:</td><td>C9H12N2O4S</td></tr><tr><td>molar mass:</td><td>244.265 g/mol (PubChem)</td></tr></table></body></html>"));
