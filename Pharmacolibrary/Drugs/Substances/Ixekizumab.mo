  annotation (Documentation(info = "<html><body><p>Ixekizumab is a monoclonal antibody used to treat psoriasis, psoriatic arthritis, axial spondyloarthritis, and juvenile arthritis. It is an approved interleukin inhibitor authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q13574436&quot;>Wikidata Q13574436</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>ixekizumab</td></tr><tr><td>ATC codes:</td><td>L04AC13</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11569&quot;>DB11569</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q13574436&quot;>Q13574436</a></td></tr><tr><td>molar mass:</td><td>146158 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Ixekizumab;
