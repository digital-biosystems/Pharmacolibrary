within Pharmacolibrary.Drugs.Substances;
package Pegfilgrastim "pegfilgrastim"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "pegfilgrastim",
    atcCodes = {"L03AA13"},
    drugbankId = "DB00019",
    wikidataId = "Q1592932",
    M = 39);
  annotation (Documentation(info = "<html><body><p>Pegfilgrastim is a long-acting granulocyte colony-stimulating factor used to prevent or treat neutropenia, including chemotherapy-induced febrile neutropenia, in cancer patients such as those with lymphoma. It is an approved medicine with several products authorised in the European Union, and it is widely used in oncology care.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q1592932&quot;>Wikidata Q1592932</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>pegfilgrastim</td></tr><tr><td>ATC codes:</td><td>L03AA13</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00019&quot;>DB00019</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q1592932&quot;>Q1592932</a></td></tr><tr><td>molar mass:</td><td>39000 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Pegfilgrastim;
