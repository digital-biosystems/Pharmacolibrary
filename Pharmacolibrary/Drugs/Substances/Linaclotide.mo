  annotation (Documentation(info = "<html><body><p>Linaclotide is a peptide drug used to treat constipation and irritable bowel syndrome. It is an approved medicine, authorised in the European Union for irritable bowel syndrome, and is also under investigation for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3832559&quot;>Wikidata Q3832559</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>linaclotide</td></tr><tr><td>ATC codes:</td><td>A06AX04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08890&quot;>DB08890</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/16158208&quot;>16158208</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:68551&quot;>68551</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3832559&quot;>Q3832559</a></td></tr><tr><td>formula:</td><td>C59H79N15O21S6</td></tr><tr><td>molar mass:</td><td>1526.72 g/mol (PubChem)</td></tr></table></body></html>"));
