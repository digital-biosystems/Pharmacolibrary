  annotation (Documentation(info = "<html><body><p>Abaloparatide is a parathyroid hormone analogue used to treat postmenopausal osteoporosis. It is an approved medicine, with one product authorised in the European Union, though another application there was refused.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4834481\">Wikidata Q4834481</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>abaloparatide</td></tr><tr><td>ATC codes:</td><td>H05AA04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB05084\">DB05084</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4834481\">Q4834481</a></td></tr><tr><td>molar mass:</td><td>3961 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>-20.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
