  annotation (Documentation(info = "<html><body><p>Iopydol is an iodinated X-ray contrast medium that was used to visualise body structures during radiographic imaging. It is no longer in use, having been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6063905&quot;>Wikidata Q6063905</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>iopydol</td></tr><tr><td>ATC codes:</td><td>V08AD02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13389&quot;>DB13389</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/21751&quot;>21751</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:136000&quot;>136000</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6063905&quot;>Q6063905</a></td></tr><tr><td>formula:</td><td>C8H9I2NO3</td></tr><tr><td>molar mass:</td><td>420.964 g/mol (PubChem)</td></tr></table></body></html>"));
