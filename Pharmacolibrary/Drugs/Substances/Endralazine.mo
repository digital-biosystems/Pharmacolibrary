  annotation (Documentation(info = "<html><body><p>Endralazine is a hydrazinophthalazine vasodilator that was developed as an antihypertensive drug to lower blood pressure. It is considered experimental and does not appear to be an approved medicine today, so its current availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5376588&quot;>Wikidata Q5376588</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>endralazine</td></tr><tr><td>ATC codes:</td><td>C02DB03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13435&quot;>DB13435</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/47608&quot;>47608</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135105&quot;>135105</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5376588&quot;>Q5376588</a></td></tr><tr><td>formula:</td><td>C14H15N5O</td></tr><tr><td>molar mass:</td><td>269.308 g/mol (PubChem)</td></tr></table></body></html>"));
