  annotation (Documentation(info = "<html><body><p>Rimonabant is an antiobesity drug, a cannabinoid receptor antagonist used to treat obesity. It was approved but later withdrawn, including from the European Union market, and is no longer used.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q412529\">Wikidata Q412529</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>rimonabant</td></tr><tr><td>ATC codes:</td><td>A08AX01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06155\">DB06155</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/104850\">104850</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:34967\">34967</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q412529\">Q412529</a></td></tr><tr><td>formula:</td><td>C22H21Cl3N4O</td></tr><tr><td>molar mass:</td><td>463.787 g/mol (PubChem CID 104850)</td></tr><tr><td>logP:</td><td>6.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
