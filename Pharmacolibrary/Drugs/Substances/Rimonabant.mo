  annotation (Documentation(info = "<html><body><p>Rimonabant is an antiobesity drug, a cannabinoid receptor antagonist used to treat obesity. It was approved but later withdrawn, including from the European Union market, and is no longer used.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q412529&quot;>Wikidata Q412529</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>rimonabant</td></tr><tr><td>ATC codes:</td><td>A08AX01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06155&quot;>DB06155</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/104850&quot;>104850</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:34967&quot;>34967</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q412529&quot;>Q412529</a></td></tr><tr><td>formula:</td><td>C22H21Cl3N4O</td></tr><tr><td>molar mass:</td><td>463.787 g/mol (PubChem)</td></tr></table></body></html>"));
