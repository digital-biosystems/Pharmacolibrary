  annotation (Documentation(info = "<html><body><p>Fenticonazole is an imidazole antifungal used topically for skin and vaginal fungal infections. It is not authorised in the European Union and is considered investigational in major drug databases, though it remains available in some countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3068413\">Wikidata Q3068413</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>fenticonazole</td></tr><tr><td>ATC codes:</td><td>D01AC12, G01AF12</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13434\">DB13434</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/51755\">51755</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:83602\">83602</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3068413\">Q3068413</a></td></tr><tr><td>formula:</td><td>C24H20Cl2N2OS</td></tr><tr><td>molar mass:</td><td>455.397 g/mol (PubChem CID 51755)</td></tr><tr><td>logP:</td><td>6.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
