  annotation (Documentation(info = "<html><body><p>Dotinurad is a drug that increases uric acid excretion and is used as an antigout preparation. It is considered investigational and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q97376167&quot;>Wikidata Q97376167</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dotinurad</td></tr><tr><td>ATC codes:</td><td>M04AB06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB16145&quot;>DB16145</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/51349053&quot;>51349053</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q97376167&quot;>Q97376167</a></td></tr><tr><td>formula:</td><td>C14H9Cl2NO4S</td></tr><tr><td>molar mass:</td><td>358.189 g/mol (PubChem)</td></tr></table></body></html>"));
