  annotation (Documentation(info = "<html><body><p>Darvadstrocel was an immunosuppressant used to treat rectal fistula. Its product was withdrawn from the European Union, so it is no longer available there.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>darvadstrocel</td></tr><tr><td>ATC codes:</td><td>L04AX08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB16581&quot;>DB16581</a></td></tr></table></body></html>"));
end Darvadstrocel;
