  annotation (Documentation(info = "<html><body><p>Narcobarbital (enibomal) is a barbiturate that has been used as a general anesthetic. It is currently classed as experimental and does not appear to be an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q906241\">Wikidata Q906241</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>narcobarbital</td></tr><tr><td>ATC codes:</td><td>N01AG01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13229\">DB13229</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/18735\">18735</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:81294\">81294</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q906241\">Q906241</a></td></tr><tr><td>formula:</td><td>C11H15BrN2O3</td></tr><tr><td>molar mass:</td><td>303.156 g/mol (PubChem CID 18735)</td></tr><tr><td>logP:</td><td>2.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
