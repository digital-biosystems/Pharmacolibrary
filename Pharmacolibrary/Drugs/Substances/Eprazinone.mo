  annotation (Documentation(info = "<html><body><p>Eprazinone is a mucolytic (mucokinetic) cough medicine that was used to help loosen mucus in respiratory conditions. It has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q389207\">Wikidata Q389207</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>eprazinone</td></tr><tr><td>ATC codes:</td><td>R05CB04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08990\">DB08990</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3245\">3245</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:82716\">82716</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q389207\">Q389207</a></td></tr><tr><td>formula:</td><td>C24H32N2O2</td></tr><tr><td>molar mass:</td><td>380.532 g/mol (PubChem CID 3245)</td></tr><tr><td>logP:</td><td>3.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
