  annotation (Documentation(info = "<html><body><p>Pabinafusp alfa is an investigational enzyme replacement therapy being studied for Hunter syndrome (mucopolysaccharidosis type II). It is not yet approved; it remains in clinical development, mainly in Japan.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q107327238\">Wikidata Q107327238</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pabinafusp alfa</td></tr><tr><td>ATC codes:</td><td>A16AB27</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB15633\">DB15633</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q107327238\">Q107327238</a></td></tr></table></body></html>"));
end PabinafuspAlfa;
