    logP = 1.1);
  annotation (Documentation(info = "<html><body><p>Hexoprenaline is a selective beta-2 adrenergic agonist that was used as a bronchodilator for obstructive airway diseases and as a tocolytic to relax the uterus. It has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4134964&quot;>Wikidata Q4134964</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>hexoprenaline</td></tr><tr><td>ATC codes:</td><td>R03AC06, R03CC05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08957&quot;>DB08957</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3609&quot;>3609</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4134964&quot;>Q4134964</a></td></tr><tr><td>formula:</td><td>C22H32N2O6</td></tr><tr><td>molar mass:</td><td>420.506 g/mol (PubChem)</td></tr></table></body></html>"));
end Hexoprenaline;
