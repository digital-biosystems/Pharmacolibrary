  annotation (Documentation(info = "<html><body><p>Bornaprine is an anticholinergic (muscarinic antagonist) drug that was developed for the treatment of Parkinson's disease. It is considered investigational and does not appear to be an approved medicine in major markets such as the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4946040\">Wikidata Q4946040</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bornaprine</td></tr><tr><td>ATC codes:</td><td>N04AA11</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13619\">DB13619</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/70687267\">70687267</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4946040\">Q4946040</a></td></tr><tr><td>formula:</td><td>C21H31NO2</td></tr><tr><td>molar mass:</td><td>329.484 g/mol (PubChem CID 70687267)</td></tr><tr><td>logP:</td><td>4.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
