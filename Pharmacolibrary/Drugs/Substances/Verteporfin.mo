    M = 0.718807);
  annotation (Documentation(info = "<html><body><p>Verteporfin is a photosensitizer used in photodynamic therapy for eye conditions involving abnormal blood vessel growth, such as macular degeneration and degenerative myopia. It is authorised in the European Union and is used mainly in specialist ophthalmic care.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q782318\">Wikidata Q782318</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>verteporfin</td></tr><tr><td>ATC codes:</td><td>S01LA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00460\">DB00460</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5362420\">5362420</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q782318\">Q782318</a></td></tr><tr><td>formula:</td><td>C41H42N4O8</td></tr><tr><td>molar mass:</td><td>718.807 g/mol (PubChem CID 5362420)</td></tr></table></body></html>"));
end Verteporfin;
