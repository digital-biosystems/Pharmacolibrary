within Pharmacolibrary.Drugs.Substances;
package Verteporfin "verteporfin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "verteporfin",
    atcCodes = {"S01LA01"},
    drugbankId = "DB00460",
    pubchemCid = "5362420",
