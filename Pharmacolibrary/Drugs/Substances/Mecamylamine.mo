within Pharmacolibrary.Drugs.Substances;
package Mecamylamine "mecamylamine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "mecamylamine",
    atcCodes = {"C02BB01"},
    drugbankId = "DB00657",
    pubchemCid = "4032",
    chebiId = "6706",
    wikidataId = "Q3332124",
    formula = "C11H21N",
    M = 0.167296,
    logP = 2.6);
  annotation (Documentation(info = "<html><body><p>Mecamylamine is a ganglion-blocking antihypertensive drug that has been used to treat arterial and malignant hypertension, and has also been studied for Tourette syndrome. It is an approved drug, though it is no longer widely used as an antihypertensive; it is also listed as investigational.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3332124\">Wikidata Q3332124</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mecamylamine</td></tr><tr><td>ATC codes:</td><td>C02BB01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00657\">DB00657</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4032\">4032</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6706\">6706</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3332124\">Q3332124</a></td></tr><tr><td>formula:</td><td>C11H21N</td></tr><tr><td>molar mass:</td><td>167.296 g/mol (PubChem CID 4032)</td></tr><tr><td>logP:</td><td>2.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Mecamylamine;
