    logP = 6.7);
  annotation (Documentation(info = "<html><body><p>Benzethonium is a quaternary ammonium antiseptic used as a local anti-infective agent, for example on the skin and in throat preparations. It remains an approved drug and is used in topical and throat antiseptic products, though it is not an EMA-authorised medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27166518\">Wikidata Q27166518</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>benzethonium</td></tr><tr><td>ATC codes:</td><td>D08AJ08, R02AA09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11125\">DB11125</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2335\">2335</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:94725\">94725</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27166518\">Q27166518</a></td></tr><tr><td>formula:</td><td>C27H42NO2+</td></tr><tr><td>molar mass:</td><td>412.638 g/mol (PubChem CID 2335)</td></tr><tr><td>logP:</td><td>6.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Benzethonium;
