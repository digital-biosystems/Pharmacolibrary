within Pharmacolibrary.Drugs.Substances;
package Benzethonium "benzethonium"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "benzethonium",
    atcCodes = {"D08AJ08", "R02AA09"},
    drugbankId = "DB11125",
    pubchemCid = "2335",
    chebiId = "94725",
    wikidataId = "Q27166518",
