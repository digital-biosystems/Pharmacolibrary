    logP = 1.5);
  annotation (Documentation(info = "<html><body><p>Isocarboxazid is a non-selective monoamine oxidase inhibitor antidepressant used to treat depression and neurotic disorders. It remains an approved medicine but is rarely used, mainly when other antidepressants have failed, and carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q409595\">Wikidata Q409595</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>isocarboxazid</td></tr><tr><td>ATC codes:</td><td>N06AF01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01247\">DB01247</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3759\">3759</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:93635\">93635</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q409595\">Q409595</a></td></tr><tr><td>formula:</td><td>C12H13N3O2</td></tr><tr><td>molar mass:</td><td>231.255 g/mol (PubChem CID 3759)</td></tr><tr><td>logP:</td><td>1.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Isocarboxazid;
