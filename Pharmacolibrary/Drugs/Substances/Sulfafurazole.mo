within Pharmacolibrary.Drugs.Substances;
package Sulfafurazole "sulfafurazole"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "sulfafurazole",
    atcCodes = {"J01EB05", "S01AB02"},
    drugbankId = "DB00263",
    pubchemCid = "5344",
    wikidataId = "Q372598",
    formula = "C11H13N3O3S",
    M = 0.267303,
    logP = 1);
  annotation (Documentation(info = "<html><body><p>Sulfafurazole (sulfisoxazole) is a short-acting sulfonamide antibiotic used to treat bacterial infections such as urinary tract infections, otitis media, chlamydia infection, and nocardiosis. It is an approved antibacterial, also approved for veterinary use, and can be given systemically or as an ophthalmic anti-infective.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q372598\">Wikidata Q372598</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sulfafurazole</td></tr><tr><td>ATC codes:</td><td>J01EB05, S01AB02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00263\">DB00263</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5344\">5344</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q372598\">Q372598</a></td></tr><tr><td>formula:</td><td>C11H13N3O3S</td></tr><tr><td>molar mass:</td><td>267.303 g/mol (PubChem CID 5344)</td></tr><tr><td>logP:</td><td>1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Sulfafurazole;
