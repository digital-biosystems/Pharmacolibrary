    logP = 4.6);
  annotation (Documentation(info = "<html><body><p>Gliquidone is a sulfonylurea used to lower blood sugar in people with diabetes. It is an approved anti-diabetic medication, though it is not authorised in the European Union and is used only in some countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5569924\">Wikidata Q5569924</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>gliquidone</td></tr><tr><td>ATC codes:</td><td>A10BB08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01251\">DB01251</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/91610\">91610</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:93416\">93416</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5569924\">Q5569924</a></td></tr><tr><td>formula:</td><td>C27H33N3O6S</td></tr><tr><td>molar mass:</td><td>527.636 g/mol (PubChem CID 91610)</td></tr><tr><td>logP:</td><td>4.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Gliquidone;
