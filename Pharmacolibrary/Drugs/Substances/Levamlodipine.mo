  annotation (Documentation(info = "<html><body><p>Levamlodipine, the single active enantiomer of amlodipine, is a calcium channel blocker used to treat high blood pressure. It is an approved medicine and is used in some countries as an alternative to standard amlodipine, though it is not authorised across the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6534831&quot;>Wikidata Q6534831</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>levamlodipine</td></tr><tr><td>ATC codes:</td><td>C08CA17</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09237&quot;>DB09237</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/9822750&quot;>9822750</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:53796&quot;>53796</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6534831&quot;>Q6534831</a></td></tr><tr><td>formula:</td><td>C20H25ClN2O5</td></tr><tr><td>molar mass:</td><td>408.879 g/mol (PubChem)</td></tr></table></body></html>"));
