within Pharmacolibrary.Drugs.Substances;
package DigitalisAntitoxin "digitalis antitoxin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "digitalis antitoxin",
    atcCodes = {"V03AB24"},
    drugbankId = "DB00076",
    M = 47.3017);
  annotation (Documentation(info = "<html><body><p>Digitalis antitoxin (digoxin immune Fab) is an antidote used to treat poisoning by digitalis glycosides such as digoxin. It is an approved antidote and is used in clinical practice, mainly in hospitals, for treating life-threatening digitalis toxicity.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>digitalis antitoxin</td></tr><tr><td>ATC codes:</td><td>V03AB24</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00076&quot;>DB00076</a></td></tr><tr><td>molar mass:</td><td>47301.7 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end DigitalisAntitoxin;
