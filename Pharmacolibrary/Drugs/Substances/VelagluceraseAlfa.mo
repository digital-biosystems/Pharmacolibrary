  annotation (Documentation(info = "<html><body><p>Velaglucerase alfa is an enzyme replacement medicine used to treat Gaucher's disease. It is approved and authorised in the European Union, where it is used for this rare condition.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3492447&quot;>Wikidata Q3492447</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>velaglucerase alfa</td></tr><tr><td>ATC codes:</td><td>A16AB10</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06720&quot;>DB06720</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3492447&quot;>Q3492447</a></td></tr><tr><td>molar mass:</td><td>63000 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
