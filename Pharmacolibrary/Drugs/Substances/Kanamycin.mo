  annotation (Documentation(info = "<html><body><p>Kanamycin is an antibiotic used to treat bacterial infections, including gram-negative infections, upper respiratory tract infections, hepatic coma, and tuberculosis. It remains in use, with approved and veterinary-approved status, and is also being investigated for additional uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q421951\">Wikidata Q421951</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>kanamycin</td></tr><tr><td>ATC codes:</td><td>A07AA08, J01GB04, S01AA24</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01172\">DB01172</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6032\">6032</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:17630\">17630</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q421951\">Q421951</a></td></tr><tr><td>formula:</td><td>C18H36N4O11</td></tr><tr><td>molar mass:</td><td>484.503 g/mol (PubChem CID 6032)</td></tr><tr><td>logP:</td><td>-6.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
