    logP = -6.9);
  annotation (Documentation(info = "<html><body><p>Kanamycin is an aminoglycoside antibiotic used to treat serious bacterial infections, including tuberculosis, and also as an intestinal antiinfective and eye infection treatment. It remains in use in many countries and is included on the WHO essential medicines list, although it has been withdrawn from some markets.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27094615&quot;>Wikidata Q27094615</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>kanamycin</td></tr><tr><td>ATC codes:</td><td>A07AA08, J01GB04, S01AA24</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01172&quot;>DB01172</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6032&quot;>6032</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:17630&quot;>17630</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27094615&quot;>Q27094615</a></td></tr><tr><td>formula:</td><td>C18H36N4O11</td></tr><tr><td>molar mass:</td><td>484.503 g/mol (PubChem)</td></tr></table></body></html>"));
end Kanamycin;
