within Pharmacolibrary.Drugs.Substances;
package SodiumChloride "sodium chloride"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "sodium chloride",
    atcCodes = {"A12CA01", "B05CB01", "B05XA03"},
    drugbankId = "DB09153",
    pubchemCid = "5234",
    chebiId = "26710",
    wikidataId = "Q2314",
    formula = "ClNa",
    M = 0.05844);
  annotation (Documentation(info = "<html><body><p>Sodium chloride is used to treat dehydration and hemorrhagic shock, and in eye preparations for dry eye syndrome and corneal edema. It is widely used in human and veterinary medicine, given as salt solutions for infusion, irrigation, and as an electrolyte supplement.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2314\">Wikidata Q2314</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sodium chloride</td></tr><tr><td>ATC codes:</td><td>A12CA01, B05CB01, B05XA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09153\">DB09153</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5234\">5234</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:26710\">26710</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2314\">Q2314</a></td></tr><tr><td>formula:</td><td>ClNa</td></tr><tr><td>molar mass:</td><td>58.44 g/mol (PubChem CID 5234)</td></tr></table></body></html>"));
end SodiumChloride;
