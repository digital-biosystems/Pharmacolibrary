within Pharmacolibrary.Drugs.Substances;
package Empegfilgrastim "empegfilgrastim"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "empegfilgrastim",
    atcCodes = {"L03AA16"},
    drugbankId = "DB16155",
    wikidataId = "Q85057778");
  annotation (Documentation(info = "<html><body><p>Empegfilgrastim is a pegylated, long-acting form of the granulocyte colony-stimulating factor filgrastim, an immunostimulant intended to raise white blood cell counts, for example in patients receiving chemotherapy. It appears to be investigational only: it has no approved marketing authorisation and is not in routine clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q85057778\">Wikidata Q85057778</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>empegfilgrastim</td></tr><tr><td>ATC codes:</td><td>L03AA16</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB16155\">DB16155</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q85057778\">Q85057778</a></td></tr></table></body></html>"));
end Empegfilgrastim;
