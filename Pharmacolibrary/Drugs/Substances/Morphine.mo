  annotation (Documentation(info = "<html><body><p>Morphine is an opioid painkiller used to treat pain, and also dyspnea and fibromyalgia. It is widely used and appears on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q81225&quot;>Wikidata Q81225</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>morphine</td></tr><tr><td>ATC codes:</td><td>N02AA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00295&quot;>DB00295</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5288826&quot;>5288826</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:17303&quot;>17303</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q81225&quot;>Q81225</a></td></tr><tr><td>formula:</td><td>C17H19NO3</td></tr><tr><td>molar mass:</td><td>285.343 g/mol (PubChem)</td></tr></table></body></html>"));
