  annotation (Documentation(info = "<html><body><p>Pixantrone is a cytotoxic antibiotic related to the anthracyclines, used as an anticancer drug and acting as a topoisomerase II inhibitor. It has been approved but is recorded as withdrawn, so it is no longer in general use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7199690\">Wikidata Q7199690</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pixantrone</td></tr><tr><td>ATC codes:</td><td>L01DB11</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06193\">DB06193</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/134019\">134019</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135945\">135945</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7199690\">Q7199690</a></td></tr><tr><td>formula:</td><td>C17H19N5O2</td></tr><tr><td>molar mass:</td><td>325.372 g/mol (PubChem CID 134019)</td></tr><tr><td>logP:</td><td>1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
