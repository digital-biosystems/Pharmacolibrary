  annotation (Documentation(info = "<html><body><p>Dorzolamide is a carbonic anhydrase inhibitor eye drop used to treat glaucoma, especially open-angle glaucoma. It is an approved medicine, widely used as an antiglaucoma ophthalmological preparation, and is also available in combination products.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q415401&quot;>Wikidata Q415401</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dorzolamide</td></tr><tr><td>ATC codes:</td><td>S01EC03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00869&quot;>DB00869</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5284549&quot;>5284549</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4702&quot;>4702</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q415401&quot;>Q415401</a></td></tr><tr><td>formula:</td><td>C10H16N2O4S3</td></tr><tr><td>molar mass:</td><td>324.428 g/mol (PubChem)</td></tr></table></body></html>"));
