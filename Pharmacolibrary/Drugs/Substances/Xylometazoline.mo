  annotation (Documentation(info = "<html><body><p>Xylometazoline is a decongestant used topically in the nose and eye to relieve nasal congestion and related conditions. It is widely used, appears on the WHO essential medicines list, and is approved, with additional investigational uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q31030&quot;>Wikidata Q31030</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>xylometazoline</td></tr><tr><td>ATC codes:</td><td>R01AA07, R01AB06, S01GA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06694&quot;>DB06694</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5709&quot;>5709</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:10082&quot;>10082</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q31030&quot;>Q31030</a></td></tr><tr><td>formula:</td><td>C16H24N2</td></tr><tr><td>molar mass:</td><td>244.382 g/mol (PubChem)</td></tr></table></body></html>"));
