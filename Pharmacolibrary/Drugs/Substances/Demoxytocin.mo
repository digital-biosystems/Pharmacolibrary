  annotation (Documentation(info = "<html><body><p>Demoxytocin is an oxytocin analogue that acts as an oxytocic, meaning it has been used to stimulate uterine contractions, for example in labour. It is considered an experimental drug and is not an established, widely used medicine today.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5256388&quot;>Wikidata Q5256388</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>demoxytocin</td></tr><tr><td>ATC codes:</td><td>H01BB01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13798&quot;>DB13798</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/449224&quot;>449224</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5256388&quot;>Q5256388</a></td></tr><tr><td>formula:</td><td>C43H65N11O12S2</td></tr><tr><td>molar mass:</td><td>992.178 g/mol (PubChem)</td></tr></table></body></html>"));
