within Pharmacolibrary.Drugs.Substances;
package Nizatidine "nizatidine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "nizatidine",
    atcCodes = {"A02BA04"},
    drugbankId = "DB00585",
    pubchemCid = "3033637",
    chebiId = "7601",
    wikidataId = "Q1188290",
    formula = "C12H21N5O2S2",
    M = 0.331453,
    logP = 1.6);
  annotation (Documentation(info = "<html><body><p>Nizatidine is an H2-receptor antagonist used to treat acid-related conditions such as gastroesophageal reflux disease, stomach and duodenal ulcers, heartburn, indigestion, and Zollinger–Ellison syndrome. It is an approved medicine and remains in use for these acid-related disorders.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1188290\">Wikidata Q1188290</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nizatidine</td></tr><tr><td>ATC codes:</td><td>A02BA04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00585\">DB00585</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3033637\">3033637</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7601\">7601</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1188290\">Q1188290</a></td></tr><tr><td>formula:</td><td>C12H21N5O2S2</td></tr><tr><td>molar mass:</td><td>331.453 g/mol (PubChem CID 3033637)</td></tr><tr><td>logP:</td><td>1.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Nizatidine;
