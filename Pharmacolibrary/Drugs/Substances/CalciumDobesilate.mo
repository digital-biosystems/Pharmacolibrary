  annotation (Documentation(info = "<html><body><p>Calcium dobesilate is a vasoprotective drug that has been used to treat chronic venous disorders such as varicose veins and haemorrhoids. It remains an investigational agent in major drug databases and is not authorised in the European Union, though it continues to be marketed in some other countries.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27139347&quot;>Wikidata Q27139347</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>calcium dobesilate</td></tr><tr><td>ATC codes:</td><td>C05BX01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13529&quot;>DB13529</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/17507&quot;>17507</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27139347&quot;>Q27139347</a></td></tr><tr><td>formula:</td><td>C6H6O5S</td></tr><tr><td>molar mass:</td><td>190.169 g/mol (PubChem)</td></tr></table></body></html>"));
end CalciumDobesilate;
