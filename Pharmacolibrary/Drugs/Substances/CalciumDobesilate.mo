  annotation (Documentation(info = "<html><body><p>Calcium dobesilate is a vasoprotective drug that has been used to treat vein problems such as varicose veins and related circulatory disorders. It is considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5018825\">Wikidata Q5018825</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>calcium dobesilate</td></tr><tr><td>ATC codes:</td><td>C05BX01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13529\">DB13529</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/17507\">17507</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5018825\">Q5018825</a></td></tr><tr><td>formula:</td><td>C6H6O5S</td></tr><tr><td>molar mass:</td><td>190.169 g/mol (PubChem CID 17507)</td></tr></table><p><small>Drugs.Common 25.09 gave 418.4 g/mol (+120.0 %); replaced by the value above</small></p></body></html>"));
