  annotation (Documentation(info = "<html><body><p>Nandrolone is an anabolic steroid that has been used to treat anemia and breast cancer. It is considered investigational and is not an authorised medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q421709&quot;>Wikidata Q421709</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nandrolone</td></tr><tr><td>ATC codes:</td><td>A14AB01, S01XA11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13169&quot;>DB13169</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/9904&quot;>9904</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7466&quot;>7466</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q421709&quot;>Q421709</a></td></tr><tr><td>formula:</td><td>C18H26O2</td></tr><tr><td>molar mass:</td><td>274.404 g/mol (PubChem)</td></tr></table></body></html>"));
