  annotation (Documentation(info = "<html><body><p>Tazobactam is a beta-lactamase inhibitor used in combination with penicillin antibiotics to treat bacterial infections. It is an approved medicine and is widely used, mainly in combination products rather than alone.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q423376&quot;>Wikidata Q423376</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tazobactam</td></tr><tr><td>ATC codes:</td><td>J01CG02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01606&quot;>DB01606</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/123630&quot;>123630</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9421&quot;>9421</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q423376&quot;>Q423376</a></td></tr><tr><td>formula:</td><td>C10H12N4O5S</td></tr><tr><td>molar mass:</td><td>300.289 g/mol (PubChem)</td></tr></table></body></html>"));
