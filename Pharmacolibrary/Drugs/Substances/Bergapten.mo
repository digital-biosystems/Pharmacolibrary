  annotation (Documentation(info = "<html><body><p>Bergapten, a psoralen, has been used as a photosensitizing antipsoriatic agent for skin conditions such as psoriasis. It is currently considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q414779&quot;>Wikidata Q414779</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bergapten</td></tr><tr><td>ATC codes:</td><td>D05BA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12216&quot;>DB12216</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2355&quot;>2355</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:18293&quot;>18293</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q414779&quot;>Q414779</a></td></tr><tr><td>formula:</td><td>C12H8O4</td></tr><tr><td>molar mass:</td><td>216.192 g/mol (PubChem)</td></tr></table></body></html>"));
