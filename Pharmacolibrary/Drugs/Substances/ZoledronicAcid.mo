  annotation (Documentation(info = "<html><body><p>Zoledronic acid is a bisphosphonate used for bone conditions such as osteoporosis, high blood calcium, and bone problems linked to cancer. It is widely used and appears on the WHO essential medicines list, with an authorised product in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q218507&quot;>Wikidata Q218507</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>zoledronic acid</td></tr><tr><td>ATC codes:</td><td>M05BA08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00399&quot;>DB00399</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/68740&quot;>68740</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:46557&quot;>46557</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q218507&quot;>Q218507</a></td></tr><tr><td>formula:</td><td>C5H10N2O7P2</td></tr><tr><td>molar mass:</td><td>272.09 g/mol (PubChem)</td></tr></table></body></html>"));
