  annotation (Documentation(info = "<html><body><p>Haloprogin is a topical antifungal that was used to treat fungal skin infections such as tinea and athlete's foot. It has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5643439\">Wikidata Q5643439</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>haloprogin</td></tr><tr><td>ATC codes:</td><td>D01AE11</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00793\">DB00793</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3561\">3561</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:5614\">5614</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5643439\">Q5643439</a></td></tr><tr><td>formula:</td><td>C9H4Cl3IO</td></tr><tr><td>molar mass:</td><td>361.38 g/mol (PubChem CID 3561)</td></tr><tr><td>logP:</td><td>4.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
