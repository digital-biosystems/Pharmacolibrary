within Pharmacolibrary.Drugs.Substances;
package Gelatin "Gelatin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "Gelatin",
    atcCodes = {"B05AA06"},
    drugbankId = "DB11242",
    wikidataId = "Q179254");
  annotation (Documentation(info = "<html><body><p>Gelatin, a mixture of peptides and proteins from animal connective tissue, is used as a blood substitute and plasma protein fraction, mainly as a plasma volume expander. It is an approved medicine and also approved for veterinary use, though some gelatin-based products have been withdrawn in certain settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q179254\">Wikidata Q179254</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Gelatin</td></tr><tr><td>ATC codes:</td><td>B05AA06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11242\">DB11242</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q179254\">Q179254</a></td></tr></table></body></html>"));
end Gelatin;
