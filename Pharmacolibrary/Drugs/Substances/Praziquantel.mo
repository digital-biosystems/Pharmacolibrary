  annotation (Documentation(info = "<html><body><p>Praziquantel is an anthelmintic used to treat parasitic worm infections such as schistosomiasis, cysticercosis, opisthorchiasis, and clonorchiasis. It is widely used in human medicine and is included on the WHO essential medicines list; it is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q424145\">Wikidata Q424145</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>praziquantel</td></tr><tr><td>ATC codes:</td><td>P02BA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01058\">DB01058</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4891\">4891</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:91583\">91583</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q424145\">Q424145</a></td></tr><tr><td>formula:</td><td>C19H24N2O2</td></tr><tr><td>molar mass:</td><td>312.413 g/mol (PubChem CID 4891)</td></tr><tr><td>logP:</td><td>2.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
