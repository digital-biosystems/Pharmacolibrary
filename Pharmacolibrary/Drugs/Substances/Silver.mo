  annotation (Documentation(info = "<html><body><p>Silver is used as an antiseptic, mainly in topical preparations for the skin such as wound and burn care. It remains in use as a dermatological antiseptic and disinfectant, though it is not an authorised EU medicine under EMA records.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q1090&quot;>Wikidata Q1090</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>silver</td></tr><tr><td>ATC codes:</td><td>D08AL30</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12965&quot;>DB12965</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/23954&quot;>23954</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9141&quot;>9141</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q1090&quot;>Q1090</a></td></tr><tr><td>formula:</td><td>Ag</td></tr><tr><td>molar mass:</td><td>107.87 g/mol (PubChem)</td></tr></table></body></html>"));
end Silver;
