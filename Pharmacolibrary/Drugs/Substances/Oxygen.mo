  annotation (Documentation(info = "<html><body><p>Oxygen is a medical gas used to treat conditions where the body needs extra oxygen, such as breathing problems. It is widely used in hospitals and other care settings, and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5203615&quot;>Wikidata Q5203615</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>oxygen</td></tr><tr><td>ATC codes:</td><td>V03AN01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09140&quot;>DB09140</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/977&quot;>977</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:27140&quot;>27140</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5203615&quot;>Q5203615</a></td></tr><tr><td>formula:</td><td>O2</td></tr><tr><td>molar mass:</td><td>31.998 g/mol (PubChem)</td></tr></table></body></html>"));
