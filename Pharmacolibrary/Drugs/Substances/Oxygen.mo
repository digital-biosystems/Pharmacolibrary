  annotation (Documentation(info = "<html><body><p>Oxygen is a medical gas used to treat conditions involving low blood oxygen, such as breathing difficulties and respiratory illness. It is widely used in hospitals and other healthcare settings, and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q629\">Wikidata Q629</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>oxygen</td></tr><tr><td>ATC codes:</td><td>V03AN01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09140\">DB09140</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/977\">977</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:27140\">27140</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q629\">Q629</a></td></tr><tr><td>formula:</td><td>O2</td></tr><tr><td>molar mass:</td><td>31.998 g/mol (PubChem CID 977)</td></tr><tr><td>logP:</td><td>-1.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
