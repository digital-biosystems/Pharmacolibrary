within Pharmacolibrary.Drugs.Substances;
package Imiquimod "imiquimod"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "imiquimod",
    atcCodes = {"D06BB10"},
    drugbankId = "DB00724",
    pubchemCid = "57469",
    chebiId = "36704",
    wikidataId = "Q423417",
