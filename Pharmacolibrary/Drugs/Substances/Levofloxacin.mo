    logP = -0.4);
  annotation (Documentation(info = "<html><body><p>Levofloxacin is a fluoroquinolone antibiotic used to treat a range of bacterial infections, including pneumonia, sinusitis, urinary tract infections, and tuberculosis, and it is also used to help eradicate Helicobacter pylori. It is widely used and appears on the WHO essential medicines list; in the European Union an authorised product exists mainly for respiratory tract infections and cystic fibrosis, and it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q424193&quot;>Wikidata Q424193</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>levofloxacin</td></tr><tr><td>ATC codes:</td><td>J01MA12, S01AE05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01137&quot;>DB01137</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/149096&quot;>149096</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:63598&quot;>63598</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q424193&quot;>Q424193</a></td></tr><tr><td>formula:</td><td>C18H20FN3O4</td></tr><tr><td>molar mass:</td><td>361.373 g/mol (PubChem)</td></tr></table></body></html>"));
end Levofloxacin;
