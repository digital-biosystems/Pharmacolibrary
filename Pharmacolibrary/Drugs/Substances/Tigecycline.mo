  annotation (Documentation(info = "<html><body><p>Tigecycline is a tetracycline antibiotic used to treat bacterial infections, including pneumonia and complicated skin, soft tissue, and intra-abdominal infections. It is authorised in the European Union and used mainly in hospital settings for serious bacterial infections.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q420595&quot;>Wikidata Q420595</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>tigecycline</td></tr><tr><td>ATC codes:</td><td>J01AA12</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00560&quot;>DB00560</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/54686904&quot;>54686904</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:149836&quot;>149836</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q420595&quot;>Q420595</a></td></tr><tr><td>formula:</td><td>C29H39N5O8</td></tr><tr><td>molar mass:</td><td>585.658 g/mol (PubChem)</td></tr></table></body></html>"));
