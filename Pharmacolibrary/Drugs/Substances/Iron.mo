  annotation (Documentation(info = "<html><body><p>Iron is used to treat iron deficiency anemia and hypochromic anemia. It is an approved medication, available in multivitamin-mineral combinations and other iron preparations, and is widely used as a supplement.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q677&quot;>Wikidata Q677</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Iron</td></tr><tr><td>ATC codes:</td><td>A11AA01, B03AE03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01592&quot;>DB01592</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/23925&quot;>23925</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:18248&quot;>18248</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q677&quot;>Q677</a></td></tr><tr><td>formula:</td><td>Fe</td></tr><tr><td>molar mass:</td><td>55.845 g/mol (PubChem)</td></tr></table></body></html>"));
