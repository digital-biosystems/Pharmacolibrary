    logP = 1.1);
  annotation (Documentation(info = "<html><body><p>Aprobarbital is a barbiturate that was used as a sedative-hypnotic to treat anxiety and insomnia. It is no longer in normal medical use; DrugBank lists it only as experimental and illicit, so it is essentially unavailable in routine care.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q411940&quot;>Wikidata Q411940</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>aprobarbital</td></tr><tr><td>ATC codes:</td><td>N05CA05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01352&quot;>DB01352</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6464&quot;>6464</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:2791&quot;>2791</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q411940&quot;>Q411940</a></td></tr><tr><td>formula:</td><td>C10H14N2O3</td></tr><tr><td>molar mass:</td><td>210.233 g/mol (PubChem)</td></tr></table></body></html>"));
end Aprobarbital;
