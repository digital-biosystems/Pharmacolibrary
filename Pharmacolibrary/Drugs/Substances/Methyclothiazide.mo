    logP = 1.4);
  annotation (Documentation(info = "<html><body><p>Methyclothiazide is a thiazide diuretic that was used to treat high blood pressure, congestive heart failure, nephrotic syndrome, and fluid buildup such as anasarca. It is no longer in use, as it has been withdrawn from the market.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6823919\">Wikidata Q6823919</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>methyclothiazide</td></tr><tr><td>ATC codes:</td><td>C03AA08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00232\">DB00232</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4121\">4121</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6847\">6847</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6823919\">Q6823919</a></td></tr><tr><td>formula:</td><td>C9H11Cl2N3O4S2</td></tr><tr><td>molar mass:</td><td>360.224 g/mol (PubChem CID 4121)</td></tr><tr><td>logP:</td><td>1.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Methyclothiazide;
