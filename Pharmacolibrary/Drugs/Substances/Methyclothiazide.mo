within Pharmacolibrary.Drugs.Substances;
package Methyclothiazide "methyclothiazide"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "methyclothiazide",
    atcCodes = {"C03AA08"},
    drugbankId = "DB00232",
    pubchemCid = "4121",
    chebiId = "6847",
    wikidataId = "Q6823919",
