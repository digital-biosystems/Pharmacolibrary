  annotation (Documentation(info = "<html><body><p>Evocalcet is an anti-parathyroid agent, a drug affecting calcium homeostasis that acts against parathyroid hormone activity. It remains investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27077250\">Wikidata Q27077250</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>evocalcet</td></tr><tr><td>ATC codes:</td><td>H05BX06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12388\">DB12388</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/71242808\">71242808</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27077250\">Q27077250</a></td></tr><tr><td>formula:</td><td>C24H26N2O2</td></tr><tr><td>molar mass:</td><td>374.484 g/mol (PubChem CID 71242808)</td></tr><tr><td>logP:</td><td>2.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
