within Pharmacolibrary.Drugs.Substances;
package Palivizumab "palivizumab"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "palivizumab",
    atcCodes = {"J06BD01"},
    drugbankId = "DB00110",
    wikidataId = "Q412765");
  annotation (Documentation(info = "<html><body><p>Palivizumab is a monoclonal antibody used to help prevent serious respiratory syncytial virus infection, particularly in children at high risk such as those with heart or lung disease. It is an approved medicine and is authorised in the European Union, where it is used widely as a preventive treatment during the RSV season.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q412765\">Wikidata Q412765</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>palivizumab</td></tr><tr><td>ATC codes:</td><td>J06BD01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00110\">DB00110</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q412765\">Q412765</a></td></tr></table></body></html>"));
end Palivizumab;
