  annotation (Documentation(info = "<html><body><p>Mequitazine is an H1 antihistamine of the phenothiazine type, used for allergic conditions such as allergy symptoms treated with systemic antihistamines. It is not an approved medicine in major markets today; DrugBank lists it as investigational, so it appears to be little used or experimental.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3333256&quot;>Wikidata Q3333256</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mequitazine</td></tr><tr><td>ATC codes:</td><td>R06AD07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01071&quot;>DB01071</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4066&quot;>4066</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31821&quot;>31821</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3333256&quot;>Q3333256</a></td></tr><tr><td>formula:</td><td>C20H22N2S</td></tr><tr><td>molar mass:</td><td>322.47 g/mol (PubChem)</td></tr></table></body></html>"));
