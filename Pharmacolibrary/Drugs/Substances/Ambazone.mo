  annotation (Documentation(info = "<html><body><p>Ambazone is an antiseptic used as a throat preparation for throat conditions. It is currently considered experimental, so it does not appear to be in widespread clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q414317&quot;>Wikidata Q414317</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ambazone</td></tr><tr><td>ATC codes:</td><td>R02AA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13697&quot;>DB13697</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/1549158&quot;>1549158</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134962&quot;>134962</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q414317&quot;>Q414317</a></td></tr><tr><td>formula:</td><td>C8H11N7S</td></tr><tr><td>molar mass:</td><td>237.285 g/mol (PubChem)</td></tr></table></body></html>"));
