    logP = 1.4);
  annotation (Documentation(info = "<html><body><p>Eplerenone is a steroidal antimineralocorticoid used as an adjunct in managing chronic heart failure and to treat arterial hypertension. It is an approved medicine, available as an aldosterone antagonist diuretic, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q423804&quot;>Wikidata Q423804</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>eplerenone</td></tr><tr><td>ATC codes:</td><td>C03DA04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00700&quot;>DB00700</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/443872&quot;>443872</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31547&quot;>31547</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q423804&quot;>Q423804</a></td></tr><tr><td>formula:</td><td>C24H30O6</td></tr><tr><td>molar mass:</td><td>414.498 g/mol (PubChem)</td></tr></table></body></html>"));
