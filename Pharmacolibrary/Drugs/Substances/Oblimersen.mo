within Pharmacolibrary.Drugs.Substances;
package Oblimersen "oblimersen"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "oblimersen",
    atcCodes = {"L01XX36"},
    drugbankId = "DB13811",
    wikidataId = "Q7075165");
  annotation (Documentation(info = "<html><body><p>Oblimersen is an investigational antisense oligonucleotide drug that was studied as a treatment for melanoma. It has never been approved; a marketing application in the European Union was refused, so it remains experimental.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7075165&quot;>Wikidata Q7075165</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>oblimersen</td></tr><tr><td>ATC codes:</td><td>L01XX36</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13811&quot;>DB13811</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7075165&quot;>Q7075165</a></td></tr></table></body></html>"));
end Oblimersen;
