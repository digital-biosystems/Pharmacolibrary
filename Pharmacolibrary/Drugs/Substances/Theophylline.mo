  annotation (Documentation(info = "<html><body><p>Theophylline is a bronchodilator used to treat breathing problems such as asthma, pulmonary emphysema, and acute bronchitis. It remains an approved medicine and is still used for obstructive airway diseases, though generally less often than newer inhaled treatments.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q407308\">Wikidata Q407308</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>theophylline</td></tr><tr><td>ATC codes:</td><td>R03DA04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00277\">DB00277</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2153\">2153</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:28177\">28177</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q407308\">Q407308</a></td></tr><tr><td>formula:</td><td>C7H8N4O2</td></tr><tr><td>molar mass:</td><td>180.167 g/mol (PubChem CID 2153)</td></tr></table></body></html>"));
end Theophylline;
