    logP = 2.8);
  annotation (Documentation(info = "<html><body><p>Iloprost is a vasodilator and platelet aggregation inhibitor used to treat pulmonary hypertension and chronic pulmonary heart disease. It is approved and authorised in the European Union for pulmonary hypertension, though its use remains limited to this specialised indication.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q20817139&quot;>Wikidata Q20817139</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>iloprost</td></tr><tr><td>ATC codes:</td><td>B01AC11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01088&quot;>DB01088</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5311181&quot;>5311181</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:63916&quot;>63916</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q20817139&quot;>Q20817139</a></td></tr><tr><td>formula:</td><td>C22H32O4</td></tr><tr><td>molar mass:</td><td>360.494 g/mol (PubChem)</td></tr></table></body></html>"));
end Iloprost;
