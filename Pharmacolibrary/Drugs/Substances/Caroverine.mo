  annotation (Documentation(info = "<html><body><p>Caroverine is a calcium channel blocker and excitatory amino acid antagonist classified as a drug for functional gastrointestinal disorders. It is considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5045575&quot;>Wikidata Q5045575</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>caroverine</td></tr><tr><td>ATC codes:</td><td>A03AX11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13835&quot;>DB13835</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/65709&quot;>65709</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135541&quot;>135541</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5045575&quot;>Q5045575</a></td></tr><tr><td>formula:</td><td>C22H27N3O2</td></tr><tr><td>molar mass:</td><td>365.477 g/mol (PubChem)</td></tr></table></body></html>"));
