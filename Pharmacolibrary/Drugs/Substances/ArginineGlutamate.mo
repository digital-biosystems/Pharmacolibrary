  annotation (Documentation(info = "<html><body><p>Arginine glutamate, a mixture of the amino acids arginine and glutamate, has been used in liver therapy as a lipotropic agent. It is considered investigational and does not appear to have an authorised marketing status in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q288119\">Wikidata Q288119</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>arginine glutamate</td></tr><tr><td>ATC codes:</td><td>A05BA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13207\">DB13207</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31234\">31234</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q288119\">Q288119</a></td></tr><tr><td>formula:</td><td>C11H23N5O6</td></tr><tr><td>molar mass:</td><td>321.334 g/mol (knowledgebase (DrugBank calculated))</td></tr></table></body></html>"));
