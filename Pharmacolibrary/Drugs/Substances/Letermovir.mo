  annotation (Documentation(info = "<html><body><p>Letermovir is an antiviral medicine used against cytomegalovirus infections. It is authorised in the European Union and is an approved drug, though it is not among the most widely used antivirals.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q15409407\">Wikidata Q15409407</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>letermovir</td></tr><tr><td>ATC codes:</td><td>J05AX18</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12070\">DB12070</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/45138674\">45138674</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q15409407\">Q15409407</a></td></tr><tr><td>formula:</td><td>C29H28F4N4O4</td></tr><tr><td>molar mass:</td><td>572.559 g/mol (PubChem CID 45138674)</td></tr><tr><td>logP:</td><td>4.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
