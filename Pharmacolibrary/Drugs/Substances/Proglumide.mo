  annotation (Documentation(info = "<html><body><p>Proglumide is an anti-ulcer drug that was used to treat peptic ulcer and other acid-related stomach disorders. It is now considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7248362\">Wikidata Q7248362</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>proglumide</td></tr><tr><td>ATC codes:</td><td>A02BX06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13431\">DB13431</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4922\">4922</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32058\">32058</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7248362\">Q7248362</a></td></tr><tr><td>formula:</td><td>C18H26N2O4</td></tr><tr><td>molar mass:</td><td>334.416 g/mol (PubChem CID 4922)</td></tr><tr><td>logP:</td><td>2.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
