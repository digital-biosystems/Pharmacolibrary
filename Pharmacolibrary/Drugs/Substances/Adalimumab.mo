within Pharmacolibrary.Drugs.Substances;
package Adalimumab "adalimumab"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "adalimumab",
    atcCodes = {"L04AA17", "L04AB04"},
    drugbankId = "DB00051",
    wikidataId = "Q348260",
    M = 144.19);
  annotation (Documentation(info = "<html><body><p>Adalimumab is a monoclonal antibody that blocks tumour necrosis factor alpha and is used to treat inflammatory conditions such as rheumatoid and other arthritis, psoriasis, ankylosing spondylitis, uveitis, ulcerative colitis, Crohn's disease, and hidradenitis suppurativa. It is widely used and authorised in the European Union, where several products are approved, though some have been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q348260&quot;>Wikidata Q348260</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>adalimumab</td></tr><tr><td>ATC codes:</td><td>L04AA17, L04AB04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00051&quot;>DB00051</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q348260&quot;>Q348260</a></td></tr><tr><td>molar mass:</td><td>144190 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Adalimumab;
