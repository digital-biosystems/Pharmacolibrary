    logP = 0.1);
  annotation (Documentation(info = "<html><body><p>Sparfloxacin is a fluoroquinolone antibiotic that was used to treat bacterial infections such as pneumonia, bronchitis, and other respiratory, staphylococcal, and gram-negative infections. It has been withdrawn from the market because of serious safety concerns, including heart rhythm problems and severe skin reactions to sunlight.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q976559\">Wikidata Q976559</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sparfloxacin</td></tr><tr><td>ATC codes:</td><td>J01MA09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01208\">DB01208</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/60464\">60464</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9212\">9212</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q976559\">Q976559</a></td></tr><tr><td>formula:</td><td>C19H22F2N4O3</td></tr><tr><td>molar mass:</td><td>392.406 g/mol (PubChem CID 60464)</td></tr><tr><td>logP:</td><td>0.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Sparfloxacin;
