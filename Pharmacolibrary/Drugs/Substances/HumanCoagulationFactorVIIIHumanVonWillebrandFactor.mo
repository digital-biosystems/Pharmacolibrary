within Pharmacolibrary.Drugs.Substances;
package HumanCoagulationFactorVIIIHumanVonWillebrandFactor "human coagulation factor VIII / human von willebrand factor"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "human coagulation factor VIII / human von willebrand factor",
    atcCodes = fill("", 0),
    drugbankId = "DB13133");
  annotation (Documentation(info = "<html><body><p>This combination product supplies human coagulation factor VIII together with human von Willebrand factor and is used to treat bleeding disorders caused by missing or faulty clotting factors, such as haemophilia A and von Willebrand disease. It is an approved medicine, though details of where it is authorised are not given in the available facts.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found); not checked by a person.</small></p><table><tr><td>name:</td><td>human coagulation factor VIII / human von willebrand factor</td></tr><tr><td>ATC codes:</td><td>—</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13133&quot;>DB13133</a></td></tr></table></body></html>"));
end HumanCoagulationFactorVIIIHumanVonWillebrandFactor;
