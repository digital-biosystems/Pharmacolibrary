within Pharmacolibrary.Drugs.Substances;
package OxidizedCellulose "oxidized cellulose"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "oxidized cellulose",
    atcCodes = {"B02BC02"},
    drugbankId = "DB13570",
    wikidataId = "Q7115645");
  annotation (Documentation(info = "<html><body><p>Oxidized cellulose is a polysaccharide classified as a local hemostatic, used to help stop bleeding. It is listed as investigational, so it is not an established approved medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7115645\">Wikidata Q7115645</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>oxidized cellulose</td></tr><tr><td>ATC codes:</td><td>B02BC02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13570\">DB13570</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7115645\">Q7115645</a></td></tr></table></body></html>"));
end OxidizedCellulose;
