  annotation (Documentation(info = "<html><body><p>Magnesium lactate is a magnesium salt used as a mineral supplement to provide magnesium. It is classified as a nutraceutical and is available as a dietary supplement, though it also has investigational uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q594836\">Wikidata Q594836</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>magnesium lactate</td></tr><tr><td>ATC codes:</td><td>A12CC06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB14515\">DB14515</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q594836\">Q594836</a></td></tr><tr><td>formula:</td><td>C6H10MgO6</td></tr><tr><td>molar mass:</td><td>202.445 g/mol (knowledgebase (DrugBank calculated))</td></tr></table></body></html>"));
end MagnesiumLactate;
