    logP = 5.4);
  annotation (Documentation(info = "<html><body><p>Ganirelix is a hormone antagonist used to prevent premature ovulation in women undergoing assisted reproduction and fertility treatment, such as controlled ovarian stimulation. It is an approved medicine, authorised in the European Union, and is used in specialist fertility care rather than broadly in routine practice.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5521314\">Wikidata Q5521314</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>ganirelix</td></tr><tr><td>ATC codes:</td><td>H01CC01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06785\">DB06785</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/16130957\">16130957</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135910\">135910</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5521314\">Q5521314</a></td></tr><tr><td>formula:</td><td>C80H113ClN18O13</td></tr><tr><td>molar mass:</td><td>1570.35 g/mol (PubChem CID 16130957)</td></tr><tr><td>logP:</td><td>5.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Ganirelix;
