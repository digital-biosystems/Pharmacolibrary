  annotation (Documentation(info = "<html><body><p>Domiodol is a mucolytic drug, meaning it was intended to thin mucus in cough and cold preparations. It appears to be investigational and is not an authorised medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3713378&quot;>Wikidata Q3713378</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>domiodol</td></tr><tr><td>ATC codes:</td><td>R05CB08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13768&quot;>DB13768</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/43814&quot;>43814</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134992&quot;>134992</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3713378&quot;>Q3713378</a></td></tr><tr><td>formula:</td><td>C5H9IO3</td></tr><tr><td>molar mass:</td><td>244.024 g/mol (PubChem)</td></tr></table></body></html>"));
