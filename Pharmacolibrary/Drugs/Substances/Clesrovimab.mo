  annotation (Documentation(info = "<html><body><p>Clesrovimab is an antiviral monoclonal antibody used to protect against respiratory syncytial virus (RSV) infection. It is approved and authorised in the European Union as an RSV medicine.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>clesrovimab</td></tr><tr><td>ATC codes:</td><td>J06BD10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB18877\">DB18877</a></td></tr></table></body></html>"));
