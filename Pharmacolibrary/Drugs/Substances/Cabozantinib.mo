  annotation (Documentation(info = "<html><body><p>Cabozantinib is a protein kinase inhibitor used to treat cancers such as renal cell carcinoma and medullary thyroid cancer. It is authorised in the European Union for thyroid, kidney, and liver cancers and is used in cancer care.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q795057&quot;>Wikidata Q795057</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>cabozantinib</td></tr><tr><td>ATC codes:</td><td>L01EX07, L01XE</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08875&quot;>DB08875</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/25102847&quot;>25102847</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:72317&quot;>72317</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q795057&quot;>Q795057</a></td></tr><tr><td>formula:</td><td>C28H24FN3O5</td></tr><tr><td>molar mass:</td><td>501.514 g/mol (PubChem)</td></tr></table></body></html>"));
