    wikidataId = "Q5861101");
  annotation (Documentation(info = "<html><body><p>Tetanus toxoid is a vaccine used to prevent tetanus, an infection caused by Clostridium tetani. It is widely used worldwide and is included on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5861101&quot;>Wikidata Q5861101</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tetanus toxoid</td></tr><tr><td>ATC codes:</td><td>J07AM01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB10583&quot;>DB10583</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5861101&quot;>Q5861101</a></td></tr></table></body></html>"));
end TetanusToxoid;
