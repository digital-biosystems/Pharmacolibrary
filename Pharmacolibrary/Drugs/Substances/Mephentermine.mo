  annotation (Documentation(info = "<html><body><p>Mephentermine is a sympathomimetic, alpha-adrenergic vasoconstrictor that was used as a cardiac stimulant to raise blood pressure. It has been withdrawn and is no longer in clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6817800&quot;>Wikidata Q6817800</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mephentermine</td></tr><tr><td>ATC codes:</td><td>C01CA11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01365&quot;>DB01365</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3677&quot;>3677</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6755&quot;>6755</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6817800&quot;>Q6817800</a></td></tr><tr><td>formula:</td><td>C11H17N</td></tr><tr><td>molar mass:</td><td>163.264 g/mol (PubChem)</td></tr></table></body></html>"));
