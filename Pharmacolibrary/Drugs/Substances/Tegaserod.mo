  annotation (Documentation(info = "<html><body><p>Tegaserod, a serotonin receptor agonist, was used to treat constipation and functional gastrointestinal disorders such as irritable bowel syndrome. It has been withdrawn from the market, and a marketing application for the drug was refused in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q44944&quot;>Wikidata Q44944</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>tegaserod</td></tr><tr><td>ATC codes:</td><td>A03AE02, A06AX06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01079&quot;>DB01079</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5362436&quot;>5362436</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:51043&quot;>51043</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q44944&quot;>Q44944</a></td></tr><tr><td>formula:</td><td>C16H23N5O</td></tr><tr><td>molar mass:</td><td>301.394 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
