  annotation (Documentation(info = "<html><body><p>Merbromin, also known as Mercurochrome, is an organomercury antiseptic used to disinfect the skin and wounds. It is currently classed as investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q419070&quot;>Wikidata Q419070</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>merbromin</td></tr><tr><td>ATC codes:</td><td>D08AK04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13392&quot;>DB13392</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2724062&quot;>2724062</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6763&quot;>6763</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q419070&quot;>Q419070</a></td></tr><tr><td>formula:</td><td>C20H9Br2HgNa2O6</td></tr><tr><td>molar mass:</td><td>751.664 g/mol (PubChem)</td></tr></table></body></html>"));
