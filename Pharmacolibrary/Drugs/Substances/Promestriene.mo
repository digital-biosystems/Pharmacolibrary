  annotation (Documentation(info = "<html><body><p>Promestriene is an estrogen, a sex hormone belonging to the natural and semisynthetic estrogens class. It is considered investigational and does not appear to be an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7249713\">Wikidata Q7249713</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>promestriene</td></tr><tr><td>ATC codes:</td><td>G03CA09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12487\">DB12487</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9883915\">9883915</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135402\">135402</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7249713\">Q7249713</a></td></tr><tr><td>formula:</td><td>C22H32O2</td></tr><tr><td>molar mass:</td><td>328.496 g/mol (PubChem CID 9883915)</td></tr><tr><td>logP:</td><td>4.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
