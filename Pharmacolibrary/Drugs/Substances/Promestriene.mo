  annotation (Documentation(info = "<html><body><p>Promestriene is a semisynthetic estrogen, a sex hormone modulator of the genital system. It is classed as investigational and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q76414696&quot;>Wikidata Q76414696</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>promestriene</td></tr><tr><td>ATC codes:</td><td>G03CA09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12487&quot;>DB12487</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/9883915&quot;>9883915</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135402&quot;>135402</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q76414696&quot;>Q76414696</a></td></tr><tr><td>formula:</td><td>C22H32O2</td></tr><tr><td>molar mass:</td><td>328.496 g/mol (PubChem)</td></tr></table></body></html>"));
