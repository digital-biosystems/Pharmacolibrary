  annotation (Documentation(info = "<html><body><p>Bietaserpine is a Rauwolfia alkaloid that was used as an antihypertensive drug to lower high blood pressure. It is now considered experimental and does not appear to be an approved medicine today.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4904688&quot;>Wikidata Q4904688</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bietaserpine</td></tr><tr><td>ATC codes:</td><td>C02AA07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13575&quot;>DB13575</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/20054848&quot;>20054848</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:125518&quot;>125518</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4904688&quot;>Q4904688</a></td></tr><tr><td>formula:</td><td>C39H53N3O9</td></tr><tr><td>molar mass:</td><td>707.865 g/mol (PubChem)</td></tr></table></body></html>"));
