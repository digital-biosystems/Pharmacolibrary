  annotation (Documentation(info = "<html><body><p>Bromazepam is a benzodiazepine used as a sedative and anxiolytic to treat anxiety. It is an approved medicine, used in many countries for anxiety, though not authorised centrally in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q422435\">Wikidata Q422435</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bromazepam</td></tr><tr><td>ATC codes:</td><td>N05BA08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01558\">DB01558</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2441\">2441</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31302\">31302</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q422435\">Q422435</a></td></tr><tr><td>formula:</td><td>C14H10BrN3O</td></tr><tr><td>molar mass:</td><td>316.158 g/mol (PubChem CID 2441)</td></tr><tr><td>logP:</td><td>1.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
