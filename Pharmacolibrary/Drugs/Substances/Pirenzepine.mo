  annotation (Documentation(info = "<html><body><p>Pirenzepine is a muscarinic antagonist that was used as an anti-ulcer drug to treat peptic ulcer and other acid-related stomach disorders. It has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q419550&quot;>Wikidata Q419550</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pirenzepine</td></tr><tr><td>ATC codes:</td><td>A02BX03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00670&quot;>DB00670</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4848&quot;>4848</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8247&quot;>8247</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q419550&quot;>Q419550</a></td></tr><tr><td>formula:</td><td>C19H21N5O2</td></tr><tr><td>molar mass:</td><td>351.41 g/mol (PubChem)</td></tr></table></body></html>"));
