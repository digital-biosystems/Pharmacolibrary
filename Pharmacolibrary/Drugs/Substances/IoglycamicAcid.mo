  annotation (Documentation(info = "<html><body><p>Ioglycamic acid is an iodinated, water-soluble, liver-directed X-ray contrast agent used to image the hepatobiliary area. It is currently classed as experimental, and no authorised marketing is recorded, so it does not appear to be in routine clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6062359&quot;>Wikidata Q6062359</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ioglycamic acid</td></tr><tr><td>ATC codes:</td><td>V08AC03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13741&quot;>DB13741</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135902&quot;>135902</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6062359&quot;>Q6062359</a></td></tr><tr><td>formula:</td><td>C18H10I6N2O7</td></tr><tr><td>molar mass:</td><td>1127.71 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end IoglycamicAcid;
