  annotation (Documentation(info = "<html><body><p>Gadodiamide is a paramagnetic contrast agent used to improve visibility of images in magnetic resonance imaging scans. It is an approved contrast medium, though it carries a boxed warning, indicating use requires caution.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2031078&quot;>Wikidata Q2031078</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>gadodiamide</td></tr><tr><td>ATC codes:</td><td>V08CA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00225&quot;>DB00225</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/24847884&quot;>24847884</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:37333&quot;>37333</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2031078&quot;>Q2031078</a></td></tr><tr><td>formula:</td><td>C16H26GdN5O8</td></tr><tr><td>molar mass:</td><td>573.661 g/mol (PubChem)</td></tr></table></body></html>"));
