    M = 0.573661);
  annotation (Documentation(info = "<html><body><p>Gadodiamide is a gadolinium-based contrast agent used to improve the visibility of tissues during magnetic resonance imaging scans. It is an approved medicine and remains in clinical use as an MRI contrast medium.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q72479907\">Wikidata Q72479907</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>gadodiamide</td></tr><tr><td>ATC codes:</td><td>V08CA03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00225\">DB00225</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/24847884\">24847884</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:37333\">37333</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q72479907\">Q72479907</a></td></tr><tr><td>formula:</td><td>C16H26GdN5O8</td></tr><tr><td>molar mass:</td><td>573.661 g/mol (PubChem CID 24847884)</td></tr></table></body></html>"));
end Gadodiamide;
