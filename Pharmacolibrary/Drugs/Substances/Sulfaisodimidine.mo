  annotation (Documentation(info = "<html><body><p>Sulfaisodimidine is a short-acting sulfonamide antibiotic used as an anti-infective agent against bacterial infections. It is no longer in routine clinical use and is considered experimental, with no current authorisation in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6577315\">Wikidata Q6577315</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sulfaisodimidine</td></tr><tr><td>ATC codes:</td><td>J01EB01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13283\">DB13283</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5343\">5343</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32166\">32166</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6577315\">Q6577315</a></td></tr><tr><td>formula:</td><td>C12H14N4O2S</td></tr><tr><td>molar mass:</td><td>278.33 g/mol (PubChem CID 5343)</td></tr><tr><td>logP:</td><td>1.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
