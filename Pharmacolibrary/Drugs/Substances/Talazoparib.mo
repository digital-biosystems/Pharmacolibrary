  annotation (Documentation(info = "<html><body><p>Talazoparib is a PARP inhibitor anticancer drug used to treat breast cancer. It is approved and authorised in the European Union for breast cancer, though it remains a specialised oncology medicine rather than a widely used drug.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q25100990\">Wikidata Q25100990</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>talazoparib</td></tr><tr><td>ATC codes:</td><td>L01XK04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11760\">DB11760</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/44819241\">44819241</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q25100990\">Q25100990</a></td></tr><tr><td>formula:</td><td>C19H14F2N6O</td></tr><tr><td>molar mass:</td><td>380.359 g/mol (knowledgebase (DrugBank calculated))</td></tr><tr><td>logP:</td><td>2.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
