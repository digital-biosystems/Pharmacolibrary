  annotation (Documentation(info = "<html><body><p>Treprostinil is a prostaglandin medicine used to treat pulmonary hypertension and chronic pulmonary heart disease. It is an approved drug and one product is authorised in the European Union for pulmonary hypertension.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3495231\">Wikidata Q3495231</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>treprostinil</td></tr><tr><td>ATC codes:</td><td>B01AC21</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00374\">DB00374</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6918140\">6918140</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:50861\">50861</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3495231\">Q3495231</a></td></tr><tr><td>formula:</td><td>C23H34O5</td></tr><tr><td>molar mass:</td><td>390.52 g/mol (PubChem CID 6918140)</td></tr><tr><td>logP:</td><td>4.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
