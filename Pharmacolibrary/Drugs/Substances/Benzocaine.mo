    logP = 1.9);
  annotation (Documentation(info = "<html><body><p>Benzocaine is a topical local anesthetic used to relieve pain and itching in conditions such as hemorrhoids, burns, mouth ulcers, ear infections, and sore throat. It remains widely used in over-the-counter topical products such as skin, throat, and hemorrhoid preparations.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q422745&quot;>Wikidata Q422745</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>benzocaine</td></tr><tr><td>ATC codes:</td><td>C05AD03, D04AB04, N01BA05, R02AD01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01086&quot;>DB01086</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/2337&quot;>2337</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:116735&quot;>116735</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q422745&quot;>Q422745</a></td></tr><tr><td>formula:</td><td>C9H11NO2</td></tr><tr><td>molar mass:</td><td>165.192 g/mol (PubChem)</td></tr></table></body></html>"));
