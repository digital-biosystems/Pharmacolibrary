  annotation (Documentation(info = "<html><body><p>Pentaerithrityl tetranitrate is an organic nitrate vasodilator that was used to treat angina pectoris. It has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q189334\">Wikidata Q189334</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pentaerithrityl tetranitrate</td></tr><tr><td>ATC codes:</td><td>C01DA05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06154\">DB06154</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6518\">6518</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q189334\">Q189334</a></td></tr><tr><td>formula:</td><td>C5H8N4O12</td></tr><tr><td>molar mass:</td><td>316.135 g/mol (PubChem CID 6518)</td></tr><tr><td>logP:</td><td>1.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
