    logP = 3.9);
  annotation (Documentation(info = "<html><body><p>Salmeterol is a long-acting inhaled beta-2 agonist used to treat obstructive airway diseases such as asthma and COPD, often in combination with corticosteroids. It is an approved medicine, widely used in inhalers both alone and in fixed combinations with corticosteroids.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q28859605&quot;>Wikidata Q28859605</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>salmeterol</td></tr><tr><td>ATC codes:</td><td>R03AC12</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00938&quot;>DB00938</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5152&quot;>5152</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q28859605&quot;>Q28859605</a></td></tr><tr><td>formula:</td><td>C25H37NO4</td></tr><tr><td>molar mass:</td><td>415.574 g/mol (PubChem)</td></tr></table></body></html>"));
end Salmeterol;
