within Pharmacolibrary.Drugs.Substances;
package Salmeterol "salmeterol"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "salmeterol",
    atcCodes = {"R03AC12"},
    drugbankId = "DB00938",
    pubchemCid = "5152",
    wikidataId = "Q28859605",
    formula = "C25H37NO4",
