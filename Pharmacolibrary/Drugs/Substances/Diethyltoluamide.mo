  annotation (Documentation(info = "<html><body><p>Diethyltoluamide (DEET) is an insect repellent applied to the skin to keep biting insects away and so help prevent insect-borne diseases. It is an approved and widely used repellent, available to consumers in many countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q408389\">Wikidata Q408389</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>diethyltoluamide</td></tr><tr><td>ATC codes:</td><td>P03BX01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11282\">DB11282</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4284\">4284</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:7071\">7071</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q408389\">Q408389</a></td></tr><tr><td>formula:</td><td>C12H17NO</td></tr><tr><td>molar mass:</td><td>191.274 g/mol (PubChem CID 4284)</td></tr><tr><td>logP:</td><td>2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
