    logP = 1.5);
  annotation (Documentation(info = "<html><body><p>Fluprednidene is a moderately potent corticosteroid used topically on the skin, alone or combined with antibiotics, to treat inflammatory skin conditions. It is not an approved medicine in major databases, where it is listed only as experimental, so its current availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q33150707\">Wikidata Q33150707</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>fluprednidene</td></tr><tr><td>ATC codes:</td><td>D07AB07, D07XB03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB08970\">DB08970</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/11794741\">11794741</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135989\">135989</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q33150707\">Q33150707</a></td></tr><tr><td>formula:</td><td>C22H27FO5</td></tr><tr><td>molar mass:</td><td>390.451 g/mol (PubChem CID 11794741)</td></tr><tr><td>logP:</td><td>1.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Fluprednidene;
