    M = 0.28333);
  annotation (Documentation(info = "<html><body><p>Choline theophyllinate (oxtriphylline) is a xanthine bronchodilator used to treat breathing problems such as asthma, pulmonary emphysema, acute bronchitis, and bradycardia. It is an approved medicine, though not authorised in the European Union, and is used only to a limited extent today.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5104342\">Wikidata Q5104342</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>choline theophyllinate</td></tr><tr><td>ATC codes:</td><td>R03DA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01303\">DB01303</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5104342\">Q5104342</a></td></tr><tr><td>molar mass:</td><td>283.33 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end CholineTheophyllinate;
