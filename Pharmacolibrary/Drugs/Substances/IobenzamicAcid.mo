    logP = 3.7);
  annotation (Documentation(info = "<html><body><p>Iobenzamic acid is an iodinated, water-soluble X-ray contrast agent designed to be taken up by the liver for imaging of the biliary tract. It is no longer in routine clinical use and is regarded as an experimental agent; it has no current marketing authorisation in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6062189&quot;>Wikidata Q6062189</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>iobenzamic acid</td></tr><tr><td>ATC codes:</td><td>V08AC05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13428&quot;>DB13428</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31700&quot;>31700</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6062189&quot;>Q6062189</a></td></tr><tr><td>formula:</td><td>C16H13I3N2O3</td></tr><tr><td>molar mass:</td><td>662.004 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end IobenzamicAcid;
