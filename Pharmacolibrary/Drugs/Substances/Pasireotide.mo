    logP = 4.7);
  annotation (Documentation(info = "<html><body><p>Pasireotide, a somatostatin analogue, is used to treat Cushing's disease caused by excess pituitary ACTH secretion and acromegaly. It is an approved medicine authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3896970&quot;>Wikidata Q3896970</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>pasireotide</td></tr><tr><td>ATC codes:</td><td>H01CB05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06663&quot;>DB06663</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/9941444&quot;>9941444</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:72312&quot;>72312</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3896970&quot;>Q3896970</a></td></tr><tr><td>formula:</td><td>C58H66N10O9</td></tr><tr><td>molar mass:</td><td>1047.23 g/mol (PubChem)</td></tr></table></body></html>"));
end Pasireotide;
