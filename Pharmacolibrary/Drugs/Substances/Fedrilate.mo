  annotation (Documentation(info = "<html><body><p>Fedrilate is a cough suppressant, classified among other antitussive drugs used to relieve cough. It appears only as an experimental compound, with no authorised marketing identified, so its current availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5441137\">Wikidata Q5441137</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>fedrilate</td></tr><tr><td>ATC codes:</td><td>R05DB14</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13825\">DB13825</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/31796\">31796</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135468\">135468</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5441137\">Q5441137</a></td></tr><tr><td>formula:</td><td>C20H29NO4</td></tr><tr><td>molar mass:</td><td>347.455 g/mol (PubChem CID 31796)</td></tr><tr><td>logP:</td><td>2.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Fedrilate;
