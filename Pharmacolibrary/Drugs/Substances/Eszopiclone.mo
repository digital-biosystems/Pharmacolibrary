    logP = 0.5);
  annotation (Documentation(info = "<html><body><p>Eszopiclone is a sedative-hypnotic related to zopiclone used to treat insomnia. It is approved and used in some countries for insomnia, but a marketing application in the European Union was withdrawn, so it is not authorised there.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q413184&quot;>Wikidata Q413184</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>eszopiclone</td></tr><tr><td>ATC codes:</td><td>N05CF04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00402&quot;>DB00402</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/969472&quot;>969472</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:53760&quot;>53760</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q413184&quot;>Q413184</a></td></tr><tr><td>formula:</td><td>C17H17ClN6O3</td></tr><tr><td>molar mass:</td><td>388.812 g/mol (PubChem)</td></tr></table></body></html>"));
end Eszopiclone;
