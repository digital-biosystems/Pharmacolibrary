  annotation (Documentation(info = "<html><body><p>Vigabatrin is an antiepileptic drug used to treat epilepsy, including infantile spasms and partial seizures. It is authorised in the European Union, where its use is limited to these specific seizure types.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q421663\">Wikidata Q421663</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>vigabatrin</td></tr><tr><td>ATC codes:</td><td>N03AG04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01080\">DB01080</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5665\">5665</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:63638\">63638</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q421663\">Q421663</a></td></tr><tr><td>formula:</td><td>C6H11NO2</td></tr><tr><td>molar mass:</td><td>129.159 g/mol (PubChem CID 5665)</td></tr><tr><td>logP:</td><td>-2.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
