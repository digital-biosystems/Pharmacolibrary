within Pharmacolibrary.Drugs.Substances;
package AlginicAcid "alginic acid"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "alginic acid",
    atcCodes = {"A02BX13"},
    drugbankId = "DB13518",
    pubchemCid = "131704328",
    chebiId = "17548",
    wikidataId = "Q422092",
    formula = "C12H20O12P2",
    M = 0.418228);
  annotation (Documentation(info = "<html><body><p>Alginic acid, a polysaccharide from brown algae, is used for acid-related disorders such as peptic ulcer and gastro-oesophageal reflux disease. It is an approved medicine, though some products have been withdrawn, and it is also being studied for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q422092\">Wikidata Q422092</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>alginic acid</td></tr><tr><td>ATC codes:</td><td>A02BX13</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13518\">DB13518</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/131704328\">131704328</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:17548\">17548</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q422092\">Q422092</a></td></tr><tr><td>formula:</td><td>C12H20O12P2</td></tr><tr><td>molar mass:</td><td>418.228 g/mol (PubChem CID 131704328)</td></tr></table></body></html>"));
end AlginicAcid;
