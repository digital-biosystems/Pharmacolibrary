    logP = 3.1);
  annotation (Documentation(info = "<html><body><p>Quinagolide is a dopamine agonist that acts as a prolactin inhibitor, used to lower prolactin levels in conditions such as hyperprolactinaemia. It is an approved medicine, but it is not authorised in the European Union and its availability appears limited to certain countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4860568\">Wikidata Q4860568</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>quinagolide</td></tr><tr><td>ATC codes:</td><td>G02CB04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09097\">DB09097</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3086401\">3086401</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135627\">135627</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4860568\">Q4860568</a></td></tr><tr><td>formula:</td><td>C20H33N3O3S</td></tr><tr><td>molar mass:</td><td>395.562 g/mol (PubChem CID 3086401)</td></tr><tr><td>logP:</td><td>3.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Quinagolide;
