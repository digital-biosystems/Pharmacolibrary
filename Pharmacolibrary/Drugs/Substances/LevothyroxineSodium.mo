  annotation (Documentation(info = "<html><body><p>Levothyroxine sodium is a thyroid hormone used to treat hypothyroidism and other thyroid conditions such as goiter, myxedema, and thyroid carcinoma. It is an approved medicine, widely used as a standard thyroid hormone preparation.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q773449&quot;>Wikidata Q773449</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>levothyroxine sodium</td></tr><tr><td>ATC codes:</td><td>H03AA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00451&quot;>DB00451</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5819&quot;>5819</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:58448&quot;>58448</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q773449&quot;>Q773449</a></td></tr><tr><td>formula:</td><td>C15H11I4NO4</td></tr><tr><td>molar mass:</td><td>776.856 g/mol (PubChem)</td></tr></table></body></html>"));
