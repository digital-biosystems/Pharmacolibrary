  annotation (Documentation(info = "<html><body><p>Teprenone is an anti-ulcer agent classified among other drugs for peptic ulcer and acid-related disorders. It is considered investigational in major Western databases and is not authorised in the European Union; it has been used mainly in Japan for gastric complaints.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q72509552\">Wikidata Q72509552</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>teprenone</td></tr><tr><td>ATC codes:</td><td>A02BX15</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB15955\">DB15955</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5282199\">5282199</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q72509552\">Q72509552</a></td></tr><tr><td>formula:</td><td>C23H38O</td></tr><tr><td>molar mass:</td><td>330.556 g/mol (PubChem CID 5282199)</td></tr><tr><td>logP:</td><td>7.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Teprenone;
