    logP = 7.4);
  annotation (Documentation(info = "<html><body><p>Teprenone (geranylgeranylacetone) is an anti-ulcer medicine used to treat peptic ulcers and other acid-related stomach disorders. It is not approved in the European Union or the United States and is used mainly in Japan and some other Asian countries.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7701388&quot;>Wikidata Q7701388</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>teprenone</td></tr><tr><td>ATC codes:</td><td>A02BX15</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB15955&quot;>DB15955</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5282199&quot;>5282199</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7701388&quot;>Q7701388</a></td></tr><tr><td>formula:</td><td>C23H38O</td></tr><tr><td>molar mass:</td><td>330.556 g/mol (PubChem)</td></tr></table></body></html>"));
end Teprenone;
