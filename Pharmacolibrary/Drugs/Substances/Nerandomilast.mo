  annotation (Documentation(info = "<html><body><p>Nerandomilast is an immunosuppressant being developed for idiopathic pulmonary fibrosis. It is not yet fully established in routine care; it has received a positive opinion in the European Union and remains under investigation.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>nerandomilast</td></tr><tr><td>ATC codes:</td><td>L04AA61</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB18237\">DB18237</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/166177189\">166177189</a></td></tr><tr><td>formula:</td><td>C20H25ClN6O2S</td></tr><tr><td>molar mass:</td><td>448.97 g/mol (PubChem CID 166177189)</td></tr></table></body></html>"));
end Nerandomilast;
