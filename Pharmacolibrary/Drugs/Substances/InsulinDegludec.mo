    logP = -4.9);
  annotation (Documentation(info = "<html><body><p>Insulin degludec is an ultralong-acting basal insulin analogue used to treat diabetes mellitus. It is approved and authorised in the European Union, and is used in diabetes care alongside fast-acting insulins in some combination products.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q16252338\">Wikidata Q16252338</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>insulin degludec</td></tr><tr><td>ATC codes:</td><td>A10AE06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09564\">DB09564</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q16252338\">Q16252338</a></td></tr><tr><td>molar mass:</td><td>6104 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>-4.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end InsulinDegludec;
