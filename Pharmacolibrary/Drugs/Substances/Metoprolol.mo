  annotation (Documentation(info = "<html><body><p>Metoprolol is a selective beta blocker used for heart conditions such as high blood pressure, angina, arrhythmias, heart failure, and after myocardial infarction. It is widely used worldwide and appears on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q409468\">Wikidata Q409468</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>metoprolol</td></tr><tr><td>ATC codes:</td><td>C07AB02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00264\">DB00264</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4171\">4171</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6904\">6904</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q409468\">Q409468</a></td></tr><tr><td>formula:</td><td>C15H25NO3</td></tr><tr><td>molar mass:</td><td>267.369 g/mol (PubChem CID 4171)</td></tr><tr><td>logP:</td><td>1.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
