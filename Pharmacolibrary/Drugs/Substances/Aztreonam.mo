    pubchemCid = "9568617",
    chebiId = "161680",
    wikidataId = "Q418546",
    formula = "C13H17N5O8S2",
    M = 0.435433,
    logP = 0.3);
  annotation (Documentation(info = "<html><body><p>Aztreonam is a monobactam antibiotic used to treat infections caused by gram-negative bacteria, including Pseudomonas infections, urinary tract, skin, and respiratory infections, and it is inhaled for cystic fibrosis. It is an approved medicine included on the WHO essential medicines list, and a product for cystic fibrosis and respiratory tract infections is authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q418546\">Wikidata Q418546</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>aztreonam</td></tr><tr><td>ATC codes:</td><td>J01DF01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00355\">DB00355</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/9568617\">9568617</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:161680\">161680</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q418546\">Q418546</a></td></tr><tr><td>formula:</td><td>C13H17N5O8S2</td></tr><tr><td>molar mass:</td><td>435.433 g/mol (knowledgebase (DrugBank calculated))</td></tr><tr><td>logP:</td><td>0.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Aztreonam;
