  annotation (Documentation(info = "<html><body><p>Eptinezumab is a monoclonal antibody used to prevent migraine attacks. It is an authorised medicine in the European Union and is also approved elsewhere, given as an infusion by healthcare professionals.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q28208949&quot;>Wikidata Q28208949</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>eptinezumab</td></tr><tr><td>ATC codes:</td><td>N02CD05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB14040&quot;>DB14040</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q28208949&quot;>Q28208949</a></td></tr><tr><td>molar mass:</td><td>143000 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
