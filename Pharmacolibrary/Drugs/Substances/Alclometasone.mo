    logP = 2.2);
  annotation (Documentation(info = "<html><body><p>Alclometasone is a moderately potent topical corticosteroid used to treat inflammatory skin conditions such as dermatitis, including on the face, scalp, legs, and hands. It is an approved medicine, applied to the skin, and is also listed for ophthalmic anti-inflammatory use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4713192\">Wikidata Q4713192</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>alclometasone</td></tr><tr><td>ATC codes:</td><td>D07AB10, S01BA10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00240\">DB00240</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5311000\">5311000</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:53776\">53776</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4713192\">Q4713192</a></td></tr><tr><td>formula:</td><td>C22H29ClO5</td></tr><tr><td>molar mass:</td><td>408.919 g/mol (PubChem CID 5311000)</td></tr><tr><td>logP:</td><td>2.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Alclometasone;
