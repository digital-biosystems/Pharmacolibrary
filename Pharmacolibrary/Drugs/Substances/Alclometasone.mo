  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "alclometasone",
    atcCodes = {"D07AB10", "S01BA10"},
    drugbankId = "DB00240",
    pubchemCid = "5311000",
    chebiId = "53776",
    wikidataId = "Q4713192",
