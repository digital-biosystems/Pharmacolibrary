  annotation (Documentation(info = "<html><body><p>Insulin detemir is a long-acting insulin used to treat diabetes, including type-1 diabetes and maturity-onset diabetes of the young type 2. It is an approved anti-diabetic medicine authorised in the European Union for diabetes mellitus.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q410965\">Wikidata Q410965</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>insulin detemir</td></tr><tr><td>ATC codes:</td><td>A10AE05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01307\">DB01307</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q410965\">Q410965</a></td></tr><tr><td>molar mass:</td><td>5917 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>-3.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
