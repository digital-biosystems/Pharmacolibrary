  annotation (Documentation(info = "<html><body><p>Insulin detemir is a long-acting insulin used to treat diabetes, including type-1 diabetes and maturity-onset diabetes of the young type 2. It is an approved anti-diabetic medicine authorised in the European Union for diabetes mellitus.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q410965&quot;>Wikidata Q410965</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>insulin detemir</td></tr><tr><td>ATC codes:</td><td>A10AE05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01307&quot;>DB01307</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/16137271&quot;>16137271</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q410965&quot;>Q410965</a></td></tr><tr><td>formula:</td><td>C267H402N64O76S6</td></tr><tr><td>molar mass:</td><td>5916.89 g/mol (PubChem)</td></tr></table></body></html>"));
