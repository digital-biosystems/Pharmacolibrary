  annotation (Documentation(info = "<html><body><p>Vonoprazan is an acid-suppressing drug used for acid-related disorders such as peptic ulcer and gastro-oesophageal reflux disease, and in combination regimens to eradicate Helicobacter pylori. It is an approved medicine, though it appears not to be authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27887191&quot;>Wikidata Q27887191</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>vonoprazan</td></tr><tr><td>ATC codes:</td><td>A02BC08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11739&quot;>DB11739</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/15981397&quot;>15981397</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:136048&quot;>136048</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27887191&quot;>Q27887191</a></td></tr><tr><td>formula:</td><td>C17H16FN3O2S</td></tr><tr><td>molar mass:</td><td>345.392 g/mol (PubChem)</td></tr></table></body></html>"));
end Vonoprazan;
