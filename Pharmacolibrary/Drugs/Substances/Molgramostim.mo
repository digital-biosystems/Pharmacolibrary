  annotation (Documentation(info = "<html><body><p>Molgramostim is a colony stimulating factor (a protein immunostimulant) that has been investigated as an antineoplastic agent. It remains investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6896158&quot;>Wikidata Q6896158</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>molgramostim</td></tr><tr><td>ATC codes:</td><td>L03AA03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12525&quot;>DB12525</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6896158&quot;>Q6896158</a></td></tr></table></body></html>"));
