  annotation (Documentation(info = "<html><body><p>Hemoglobin raffimer is a hemoglobin-based blood substitute developed as an oxygen-carrying alternative to transfusion. It remains investigational and has not reached routine clinical use.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>hemoglobin raffimer</td></tr><tr><td>ATC codes:</td><td>B05AA09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13658&quot;>DB13658</a></td></tr></table></body></html>"));
end HemoglobinRaffimer;
