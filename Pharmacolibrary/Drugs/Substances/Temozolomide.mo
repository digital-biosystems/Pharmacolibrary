    logP = -1.1);
  annotation (Documentation(info = "<html><body><p>Temozolomide is an alkylating anticancer drug used to treat brain cancers such as glioblastoma, anaplastic astrocytoma and other gliomas, as well as melanoma. It is an approved medicine with several authorised products in the European Union, where it is used for glioma and neuroblastoma, and it is also being investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q425088\">Wikidata Q425088</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>temozolomide</td></tr><tr><td>ATC codes:</td><td>L01AX03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00853\">DB00853</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5394\">5394</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:72564\">72564</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q425088\">Q425088</a></td></tr><tr><td>formula:</td><td>C6H6N6O2</td></tr><tr><td>molar mass:</td><td>194.154 g/mol (PubChem CID 5394)</td></tr><tr><td>logP:</td><td>-1.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Temozolomide;
