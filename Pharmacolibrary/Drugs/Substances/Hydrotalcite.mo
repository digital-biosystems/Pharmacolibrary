  annotation (Documentation(info = "<html><body><p>Hydrotalcite is an antacid used to treat acid-related disorders of the digestive tract, such as excess stomach acid. It is an approved medicine, available in antacid preparations, though it does not appear to be authorised centrally in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q9003473&quot;>Wikidata Q9003473</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>hydrotalcite</td></tr><tr><td>ATC codes:</td><td>A02AD04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13322&quot;>DB13322</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/73415812&quot;>73415812</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q9003473&quot;>Q9003473</a></td></tr><tr><td>formula:</td><td>CH24Al2Mg6O24-2</td></tr><tr><td>molar mass:</td><td>619.973 g/mol (PubChem)</td></tr></table></body></html>"));
