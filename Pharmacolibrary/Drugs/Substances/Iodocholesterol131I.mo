  annotation (Documentation(info = "<html><body><p>Iodocholesterol labelled with iodine-131 is a diagnostic radiopharmaceutical used for imaging of the adrenal glands. It is classed as investigational and is not an authorised medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27275223&quot;>Wikidata Q27275223</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>iodocholesterol (131I)</td></tr><tr><td>ATC codes:</td><td>V09XA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13797&quot;>DB13797</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135998&quot;>135998</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27275223&quot;>Q27275223</a></td></tr><tr><td>formula:</td><td>C27H45IO</td></tr><tr><td>molar mass:</td><td>516.562 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
