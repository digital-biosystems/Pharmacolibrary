  annotation (Documentation(info = "<html><body><p>Pramipexole is a dopamine agonist used to treat Parkinson's disease and restless legs syndrome. It is an approved medicine with several authorised products in the European Union, and is also being studied for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q421304\">Wikidata Q421304</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>pramipexole</td></tr><tr><td>ATC codes:</td><td>N04BC05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00413\">DB00413</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/119570\">119570</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8356\">8356</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q421304\">Q421304</a></td></tr><tr><td>formula:</td><td>C10H17N3S</td></tr><tr><td>molar mass:</td><td>211.327 g/mol (PubChem CID 119570)</td></tr><tr><td>logP:</td><td>1.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
