  annotation (Documentation(info = "<html><body><p>Zipeprol is a cough suppressant that was used to relieve cough. It is not an approved medicine today and is regarded as an experimental compound, so it is no longer in routine medical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4024559&quot;>Wikidata Q4024559</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>zipeprol</td></tr><tr><td>ATC codes:</td><td>R05DB15</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13564&quot;>DB13564</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/36910&quot;>36910</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135602&quot;>135602</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4024559&quot;>Q4024559</a></td></tr><tr><td>formula:</td><td>C23H32N2O3</td></tr><tr><td>molar mass:</td><td>384.52 g/mol (PubChem)</td></tr></table></body></html>"));
