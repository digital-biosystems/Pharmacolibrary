    M = 1.02928);
  annotation (Documentation(info = "<html><body><p>Mivacurium is a short-acting non-depolarising neuromuscular blocking agent used to relax muscles during surgical procedures under general anaesthesia. It has been withdrawn from the market in some countries and is no longer widely available.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q413877\">Wikidata Q413877</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Mivacurium</td></tr><tr><td>ATC codes:</td><td>M03AC10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01226\">DB01226</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5281042\">5281042</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q413877\">Q413877</a></td></tr><tr><td>formula:</td><td>C58H80N2O14+2</td></tr><tr><td>molar mass:</td><td>1029.28 g/mol (PubChem CID 5281042)</td></tr></table></body></html>"));
end Mivacurium;
