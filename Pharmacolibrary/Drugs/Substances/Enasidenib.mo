  annotation (Documentation(info = "<html><body><p>Enasidenib is an anticancer medicine, an IDH inhibitor, used to treat acute myeloid leukemia. It is an approved drug, though it has no European Union authorisation recorded, and remains investigational for some uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27077182\">Wikidata Q27077182</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>enasidenib</td></tr><tr><td>ATC codes:</td><td>L01XM01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13874\">DB13874</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/89683805\">89683805</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:145374\">145374</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27077182\">Q27077182</a></td></tr><tr><td>formula:</td><td>C19H17F6N7O</td></tr><tr><td>molar mass:</td><td>473.381 g/mol (PubChem CID 89683805)</td></tr></table></body></html>"));
