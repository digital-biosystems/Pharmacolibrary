  annotation (Documentation(info = "<html><body><p>Umifenovir is an antiviral drug that has been used to treat influenza infections. It is not approved in the European Union or the United States and is considered investigational there, though it has been used mainly in Russia and some other countries.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q27271599&quot;>Wikidata Q27271599</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>umifenovir</td></tr><tr><td>ATC codes:</td><td>J05AX13</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13609&quot;>DB13609</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/131411&quot;>131411</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134730&quot;>134730</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q27271599&quot;>Q27271599</a></td></tr><tr><td>formula:</td><td>C22H25BrN2O3S</td></tr><tr><td>molar mass:</td><td>477.417 g/mol (PubChem)</td></tr></table></body></html>"));
end Umifenovir;
