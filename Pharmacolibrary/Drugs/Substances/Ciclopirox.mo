within Pharmacolibrary.Drugs.Substances;
package Ciclopirox "ciclopirox"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "ciclopirox",
    atcCodes = {"D01AE14", "G01AX12"},
    drugbankId = "DB01188",
    pubchemCid = "2749",
    chebiId = "453011",
    wikidataId = "Q419468",
    formula = "C12H17NO2",
    M = 0.207273,
    logP = 2);
  annotation (Documentation(info = "<html><body><p>Ciclopirox is a topical antifungal used to treat fungal skin and nail infections such as tinea, seborrhoeic dermatitis, pityriasis versicolor, cutaneous candidiasis, and onychomycosis. It is an approved medicine, applied topically to the skin or nails, and is used fairly widely for these infections.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q419468\">Wikidata Q419468</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ciclopirox</td></tr><tr><td>ATC codes:</td><td>D01AE14, G01AX12</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01188\">DB01188</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2749\">2749</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:453011\">453011</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q419468\">Q419468</a></td></tr><tr><td>formula:</td><td>C12H17NO2</td></tr><tr><td>molar mass:</td><td>207.273 g/mol (PubChem CID 2749)</td></tr><tr><td>logP:</td><td>2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Ciclopirox;
