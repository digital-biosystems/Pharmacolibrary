    logP = 3.6);
  annotation (Documentation(info = "<html><body><p>Bevonium is a synthetic anticholinergic (quaternary ammonium) antispasmodic that has been used for functional gastrointestinal disorders, alone or in combination with psycholeptics or analgesics. It is currently considered experimental, with no established marketing authorisation, so its present availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4899696\">Wikidata Q4899696</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bevonium</td></tr><tr><td>ATC codes:</td><td>A03AB13</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13542\">DB13542</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/31800\">31800</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135495\">135495</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4899696\">Q4899696</a></td></tr><tr><td>formula:</td><td>C22H28NO3+</td></tr><tr><td>molar mass:</td><td>354.47 g/mol (PubChem CID 31800)</td></tr><tr><td>logP:</td><td>3.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Bevonium;
