  annotation (Documentation(info = "<html><body><p>Pemafibrate is a fibrate lipid-modifying agent developed to treat dyslipidemia (high blood fat levels). It is not authorised in the European Union and is considered investigational in major drug databases, though it has been approved for use in Japan.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27251943\">Wikidata Q27251943</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>pemafibrate</td></tr><tr><td>ATC codes:</td><td>C10AB12</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB15212\">DB15212</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/11526038\">11526038</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27251943\">Q27251943</a></td></tr><tr><td>formula:</td><td>C28H30N2O6</td></tr><tr><td>molar mass:</td><td>490.556 g/mol (PubChem CID 11526038)</td></tr><tr><td>logP:</td><td>6.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Pemafibrate;
