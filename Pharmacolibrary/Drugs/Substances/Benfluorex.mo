    logP = 4.6);
  annotation (Documentation(info = "<html><body><p>Benfluorex was a blood glucose lowering drug used to treat diabetes, and also acted as an anorectic and hypolipidemic agent. It was approved at one time but has since been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q421695\">Wikidata Q421695</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>benfluorex</td></tr><tr><td>ATC codes:</td><td>A10BX06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09022\">DB09022</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/2318\">2318</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:93826\">93826</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q421695\">Q421695</a></td></tr><tr><td>formula:</td><td>C19H20F3NO2</td></tr><tr><td>molar mass:</td><td>351.368 g/mol (PubChem CID 2318)</td></tr><tr><td>logP:</td><td>4.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Benfluorex;
