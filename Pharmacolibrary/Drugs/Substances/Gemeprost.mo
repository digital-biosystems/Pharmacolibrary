  annotation (Documentation(info = "<html><body><p>Gemeprost is a prostaglandin uterotonic that was used as an abortifacient to terminate pregnancy. It has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q2760221&quot;>Wikidata Q2760221</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>gemeprost</td></tr><tr><td>ATC codes:</td><td>G02AD03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08964&quot;>DB08964</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5282237&quot;>5282237</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135626&quot;>135626</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q2760221&quot;>Q2760221</a></td></tr><tr><td>formula:</td><td>C23H38O5</td></tr><tr><td>molar mass:</td><td>394.552 g/mol (PubChem)</td></tr></table></body></html>"));
