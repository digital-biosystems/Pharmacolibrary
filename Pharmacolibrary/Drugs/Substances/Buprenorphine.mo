  annotation (Documentation(info = "<html><body><p>Buprenorphine is an opioid used to treat pain and opioid dependence, including heroin dependence. It is widely used and authorised in the European Union, mainly for opioid-related disorders, and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q407721\">Wikidata Q407721</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>buprenorphine</td></tr><tr><td>ATC codes:</td><td>N02AE01, N07BC01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00921\">DB00921</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/644073\">644073</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3216\">3216</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q407721\">Q407721</a></td></tr><tr><td>formula:</td><td>C29H41NO4</td></tr><tr><td>molar mass:</td><td>467.65 g/mol (PubChem CID 644073)</td></tr><tr><td>logP:</td><td>5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
