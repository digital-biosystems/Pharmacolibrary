  end HippuricAcid;
  annotation (Documentation(info = "<html><body><p>Sodium benzoate is a benzoic acid salt used as a medicine for various metabolic conditions and as a diagnostic agent in tests for gastric secretion. It is an approved drug, and it also acts as an antifungal agent.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q423971\">Wikidata Q423971</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>sodium benzoate</td></tr><tr><td>ATC codes:</td><td>A16AX11</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB03793\">DB03793</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/243\">243</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:30746\">30746</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q423971\">Q423971</a></td></tr><tr><td>formula:</td><td>C7H6O2</td></tr><tr><td>molar mass:</td><td>122.123 g/mol (PubChem CID 243)</td></tr></table><p><small>Drugs.Common 25.09 gave 144.1 g/mol (+18.0 %); replaced by the value above</small></p><h4>Metabolites</h4><table><tr><td><code>HippuricAcid</code></td><td>hippuric acid</td><td>molar mass unknown</td></tr></table></body></html>"));
end SodiumBenzoate;
