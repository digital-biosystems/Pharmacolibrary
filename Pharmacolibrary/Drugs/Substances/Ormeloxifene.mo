  annotation (Documentation(info = "<html><body><p>Ormeloxifene is a selective estrogen receptor modulator that has been investigated as a non-hormonal contraceptive. It is not an approved medicine in major markets such as the European Union and remains experimental.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7103387\">Wikidata Q7103387</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ormeloxifene</td></tr><tr><td>ATC codes:</td><td>G03XC04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13310\">DB13310</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/35805\">35805</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7103387\">Q7103387</a></td></tr><tr><td>formula:</td><td>C30H35NO3</td></tr><tr><td>molar mass:</td><td>457.614 g/mol (PubChem CID 35805)</td></tr><tr><td>logP:</td><td>6.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
