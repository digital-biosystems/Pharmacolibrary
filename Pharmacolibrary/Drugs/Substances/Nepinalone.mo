  annotation (Documentation(info = "<html><body><p>Nepinalone is a cough suppressant, classified among other antitussive medicines used to relieve cough. It is considered investigational and does not appear to be an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6687842\">Wikidata Q6687842</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nepinalone</td></tr><tr><td>ATC codes:</td><td>R05DB26</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13445\">DB13445</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3047788\">3047788</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135121\">135121</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6687842\">Q6687842</a></td></tr><tr><td>formula:</td><td>C18H25NO</td></tr><tr><td>molar mass:</td><td>271.404 g/mol (PubChem CID 3047788)</td></tr><tr><td>logP:</td><td>3.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
