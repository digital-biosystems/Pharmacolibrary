within Pharmacolibrary.Drugs.Substances;
package Tanezumab "tanezumab"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "tanezumab",
    atcCodes = {"N02BG12"},
    drugbankId = "DB12335",
    wikidataId = "Q3980782");
  annotation (Documentation(info = "<html><body><p>Tanezumab is an investigational monoclonal antibody analgesic studied for osteoarthritis and chronic pain. It has not been approved; the European Medicines Agency refused a marketing application, so it remains investigational.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3980782\">Wikidata Q3980782</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>tanezumab</td></tr><tr><td>ATC codes:</td><td>N02BG12</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12335\">DB12335</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3980782\">Q3980782</a></td></tr></table></body></html>"));
end Tanezumab;
