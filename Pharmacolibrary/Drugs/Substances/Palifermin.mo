  annotation (Documentation(info = "<html><body><p>Palifermin is a detoxifying agent for antineoplastic treatment, used to treat mucositis. It is an approved drug, though one European Union product has been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7127523\">Wikidata Q7127523</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>palifermin</td></tr><tr><td>ATC codes:</td><td>V03AF08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00039\">DB00039</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7127523\">Q7127523</a></td></tr><tr><td>molar mass:</td><td>16192.7 g/mol (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
