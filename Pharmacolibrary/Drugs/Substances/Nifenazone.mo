  annotation (Documentation(info = "<html><body><p>Nifenazone is a pyrazolone non-steroidal anti-inflammatory drug used for joint and muscular pain and as an analgesic and antipyretic. It is classified as experimental and appears to be little used today, with no marketing authorisation recorded in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q646567&quot;>Wikidata Q646567</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nifenazone</td></tr><tr><td>ATC codes:</td><td>M02AA24, N02BB05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13407&quot;>DB13407</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/4487&quot;>4487</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31910&quot;>31910</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q646567&quot;>Q646567</a></td></tr><tr><td>formula:</td><td>C17H16N4O2</td></tr><tr><td>molar mass:</td><td>308.341 g/mol (PubChem)</td></tr></table></body></html>"));
