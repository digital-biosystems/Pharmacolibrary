  annotation (Documentation(info = "<html><body><p>Dolutegravir is an integrase inhibitor used to treat HIV infection. It is an approved medicine, authorised in the European Union for HIV infections, and is included on the WHO list of essential medicines, so it is widely used.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q937224&quot;>Wikidata Q937224</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>dolutegravir</td></tr><tr><td>ATC codes:</td><td>J05AJ03, J05AX12</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08930&quot;>DB08930</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/54726191&quot;>54726191</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:76010&quot;>76010</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q937224&quot;>Q937224</a></td></tr><tr><td>formula:</td><td>C20H19F2N3O5</td></tr><tr><td>molar mass:</td><td>419.384 g/mol (PubChem)</td></tr></table></body></html>"));
