  annotation (Documentation(info = "<html><body><p>Labuvirtide is an investigational antiviral drug studied for the treatment of HIV infection. It is still under development and is not yet approved for routine clinical use.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>labuvirtide</td></tr><tr><td>ATC codes:</td><td>J05AX33</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB15166&quot;>DB15166</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/134694278&quot;>134694278</a></td></tr><tr><td>formula:</td><td>C204H306N54O72</td></tr><tr><td>molar mass:</td><td>4667 g/mol (PubChem)</td></tr></table></body></html>"));
