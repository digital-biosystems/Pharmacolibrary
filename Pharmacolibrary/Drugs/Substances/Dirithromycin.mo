  annotation (Documentation(info = "<html><body><p>Dirithromycin is a macrolide antibiotic that was intended to treat bacterial infections such as tonsillitis, pharyngitis, acute bronchitis, pneumonia, and staphylococcal infections. It is not an approved medicine today and is regarded as investigational, with no authorisation in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1989071\">Wikidata Q1989071</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dirithromycin</td></tr><tr><td>ATC codes:</td><td>J01FA13</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00954\">DB00954</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6473883\">6473883</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:474014\">474014</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1989071\">Q1989071</a></td></tr><tr><td>formula:</td><td>C42H78N2O14</td></tr><tr><td>molar mass:</td><td>835.086 g/mol (PubChem CID 6473883)</td></tr><tr><td>logP:</td><td>4.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Dirithromycin;
