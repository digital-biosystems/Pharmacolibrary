  annotation (Documentation(info = "<html><body><p>Cefmetazole is a second-generation cephalosporin antibiotic used to treat bacterial infections. It is not authorised in the European Union and is used only in a limited number of countries, mainly Japan.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5057238\">Wikidata Q5057238</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>cefmetazole</td></tr><tr><td>ATC codes:</td><td>J01DC09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00274\">DB00274</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/42008\">42008</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3489\">3489</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5057238\">Q5057238</a></td></tr><tr><td>formula:</td><td>C15H17N7O5S3</td></tr><tr><td>molar mass:</td><td>471.525 g/mol (PubChem CID 42008)</td></tr><tr><td>logP:</td><td>-0.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
