    M = 43.5);
  annotation (Documentation(info = "<html><body><p>Pegcetacoplan is a complement inhibitor used to treat paroxysmal nocturnal hemoglobinuria. It is authorised in the European Union and also has ophthalmological uses, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q106863504&quot;>Wikidata Q106863504</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>pegcetacoplan</td></tr><tr><td>ATC codes:</td><td>L04AJ03, S01XA31</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB16694&quot;>DB16694</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q106863504&quot;>Q106863504</a></td></tr><tr><td>molar mass:</td><td>43500 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end Pegcetacoplan;
