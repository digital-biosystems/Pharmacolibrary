  annotation (Documentation(info = "<html><body><p>Bexagliflozin is a blood glucose lowering medicine of the gliflozin class, used to treat diabetes. It is an approved drug, though the available sources do not specify how widely it is used.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27277423\">Wikidata Q27277423</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bexagliflozin</td></tr><tr><td>ATC codes:</td><td>A10BK08</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB12236\">DB12236</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/25195624\">25195624</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27277423\">Q27277423</a></td></tr><tr><td>formula:</td><td>C24H29ClO7</td></tr><tr><td>molar mass:</td><td>464.939 g/mol (PubChem CID 25195624)</td></tr><tr><td>logP:</td><td>2.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
