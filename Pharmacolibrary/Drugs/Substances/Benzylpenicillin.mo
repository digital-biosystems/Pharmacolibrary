  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "benzylpenicillin",
    atcCodes = {"J01CE01", "J01CE08", "S01AA14"},
    drugbankId = "DB01053",
    pubchemCid = "5904",
    chebiId = "18208",
    wikidataId = "Q258450",
    formula = "C16H18N2O4S",
