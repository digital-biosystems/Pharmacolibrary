    logP = 1.8);
  annotation (Documentation(info = "<html><body><p>Benzylpenicillin is a penicillin antibiotic used to treat bacterial infections such as gonorrhea, diphtheria, botulism, actinomycosis, and septicemia caused by anthrax or staphylococci. It remains an approved medicine, is on the WHO essential medicines list, and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q258450\">Wikidata Q258450</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>benzylpenicillin</td></tr><tr><td>ATC codes:</td><td>J01CE01, J01CE08, S01AA14</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01053\">DB01053</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5904\">5904</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:18208\">18208</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q258450\">Q258450</a></td></tr><tr><td>formula:</td><td>C16H18N2O4S</td></tr><tr><td>molar mass:</td><td>334.39 g/mol (PubChem CID 5904)</td></tr><tr><td>logP:</td><td>1.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Benzylpenicillin;
