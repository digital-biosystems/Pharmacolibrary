  annotation (Documentation(info = "<html><body><p>Deuruxolitinib is a JAK inhibitor used to treat alopecia areata. It is an approved drug, but no European Union authorisation is recorded in the facts, so its use appears mainly in the United States.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q123485858\">Wikidata Q123485858</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>deuruxolitinib</td></tr><tr><td>ATC codes:</td><td>L04AF09</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB18847\">DB18847</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/72704611\">72704611</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q123485858\">Q123485858</a></td></tr><tr><td>formula:</td><td>C17H18N6</td></tr><tr><td>molar mass:</td><td>306.373 g/mol (PubChem CID 72704611)</td></tr></table></body></html>"));
