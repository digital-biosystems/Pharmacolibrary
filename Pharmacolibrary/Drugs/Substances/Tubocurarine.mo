within Pharmacolibrary.Drugs.Substances;
package Tubocurarine "tubocurarine"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "tubocurarine",
    atcCodes = {"M03AA02"},
    drugbankId = "DB01199",
    pubchemCid = "6000",
    chebiId = "9774",
    wikidataId = "Q421268",
    formula = "C37H41N2O6+",
    M = 0.609743,
    logP = 6);
  annotation (Documentation(info = "<html><body><p>Tubocurarine, a curare alkaloid, is a non-depolarising muscle relaxant that was used to cause muscle relaxation during anaesthesia and surgery. It has been withdrawn from use, having been replaced by newer muscle relaxants with fewer side effects.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q421268&quot;>Wikidata Q421268</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tubocurarine</td></tr><tr><td>ATC codes:</td><td>M03AA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01199&quot;>DB01199</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/6000&quot;>6000</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9774&quot;>9774</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q421268&quot;>Q421268</a></td></tr><tr><td>formula:</td><td>C37H41N2O6+</td></tr><tr><td>molar mass:</td><td>609.743 g/mol (PubChem)</td></tr></table></body></html>"));
end Tubocurarine;
