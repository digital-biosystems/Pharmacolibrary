  annotation (Documentation(info = "<html><body><p>Ferumoxsil is a superparamagnetic contrast agent used as a contrast medium for magnetic resonance imaging. It was approved but has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q84955192&quot;>Wikidata Q84955192</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ferumoxsil</td></tr><tr><td>ATC codes:</td><td>V08CB01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09507&quot;>DB09507</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q84955192&quot;>Q84955192</a></td></tr></table></body></html>"));
