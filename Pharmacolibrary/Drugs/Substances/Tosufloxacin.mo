  annotation (Documentation(info = "<html><body><p>Tosufloxacin is a fluoroquinolone antibacterial used against infections such as pneumonia, cystitis, prostatitis, and intestinal infections. It is not authorised in the European Union and appears mainly as an experimental agent in drug databases, so its current availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3995932&quot;>Wikidata Q3995932</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tosufloxacin</td></tr><tr><td>ATC codes:</td><td>J01MA22, S01AE09</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB16850&quot;>DB16850</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5517&quot;>5517</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:77581&quot;>77581</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3995932&quot;>Q3995932</a></td></tr><tr><td>formula:</td><td>C19H15F3N4O3</td></tr><tr><td>molar mass:</td><td>404.348 g/mol (PubChem)</td></tr></table></body></html>"));
