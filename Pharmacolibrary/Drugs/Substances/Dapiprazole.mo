within Pharmacolibrary.Drugs.Substances;
package Dapiprazole "dapiprazole"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "dapiprazole",
    atcCodes = {"S01EX02"},
    drugbankId = "DB00298",
    pubchemCid = "3033538",
    chebiId = "51066",
    wikidataId = "Q901963",
    formula = "C19H27N5",
    M = 0.32546,
    logP = 2.4);
  annotation (Documentation(info = "<html><body><p>Dapiprazole is an alpha-blocking eye drop used to constrict the pupil, mainly to reverse dilation of the pupil after eye examinations. It has been approved as an ophthalmological medicine and is used only in eye care settings rather than widely.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q901963&quot;>Wikidata Q901963</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dapiprazole</td></tr><tr><td>ATC codes:</td><td>S01EX02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00298&quot;>DB00298</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3033538&quot;>3033538</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:51066&quot;>51066</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q901963&quot;>Q901963</a></td></tr><tr><td>formula:</td><td>C19H27N5</td></tr><tr><td>molar mass:</td><td>325.46 g/mol (PubChem)</td></tr></table></body></html>"));
end Dapiprazole;
