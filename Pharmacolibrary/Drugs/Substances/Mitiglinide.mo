  annotation (Documentation(info = "<html><body><p>Mitiglinide is an anti-diabetic medication intended to lower blood sugar in people with diabetes. It is considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q266321&quot;>Wikidata Q266321</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>mitiglinide</td></tr><tr><td>ATC codes:</td><td>A10BX08</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01252&quot;>DB01252</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/121891&quot;>121891</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135349&quot;>135349</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q266321&quot;>Q266321</a></td></tr><tr><td>formula:</td><td>C19H25NO3</td></tr><tr><td>molar mass:</td><td>315.413 g/mol (PubChem)</td></tr></table></body></html>"));
