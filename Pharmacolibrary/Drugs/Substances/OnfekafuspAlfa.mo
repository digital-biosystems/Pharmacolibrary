  annotation (Documentation(info = "<html><body><p>Onfekafusp alfa is an investigational anticancer agent, an antibody fragment fused to tumor necrosis factor alpha that targets a fibronectin domain found in tumors. It is not yet approved and remains in clinical development.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>onfekafusp alfa</td></tr><tr><td>ATC codes:</td><td>L01XY04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB16269&quot;>DB16269</a></td></tr></table></body></html>"));
end OnfekafuspAlfa;
