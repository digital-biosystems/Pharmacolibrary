  annotation (Documentation(info = "<html><body><p>Alfacalcidol is a vitamin D analogue used as a bone density conservation agent, for example in conditions with disturbed bone mineralisation. It is an approved medicine, used mainly in Europe and Japan for metabolic bone disease.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q155883\">Wikidata Q155883</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>alfacalcidol</td></tr><tr><td>ATC codes:</td><td>A11CC03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01436\">DB01436</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5282181\">5282181</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31186\">31186</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q155883\">Q155883</a></td></tr><tr><td>formula:</td><td>C27H44O2</td></tr><tr><td>molar mass:</td><td>400.647 g/mol (PubChem CID 5282181)</td></tr><tr><td>logP:</td><td>6.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
