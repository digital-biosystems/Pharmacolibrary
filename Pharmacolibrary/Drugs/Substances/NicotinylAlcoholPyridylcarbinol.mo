within Pharmacolibrary.Drugs.Substances;
package NicotinylAlcoholPyridylcarbinol "nicotinyl alcohol (pyridylcarbinol)"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "nicotinyl alcohol (pyridylcarbinol)",
    atcCodes = {"C04AC02", "C10AD05"},
    drugbankId = "DB04145",
    pubchemCid = "7510",
    chebiId = "45213",
    wikidataId = "Q411732",
    formula = "C6H7NO",
    M = 0.109128,
    logP = 0);
  annotation (Documentation(info = "<html><body><p>Nicotinyl alcohol is a nicotinic acid derivative that acts as a vasodilator and has been classified for use as a peripheral vasodilator and lipid-modifying agent. It is currently regarded as experimental, with no authorisation by the European Medicines Agency, so it does not appear to be in routine clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q411732&quot;>Wikidata Q411732</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>nicotinyl alcohol (pyridylcarbinol)</td></tr><tr><td>ATC codes:</td><td>C04AC02, C10AD05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB04145&quot;>DB04145</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/7510&quot;>7510</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:45213&quot;>45213</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q411732&quot;>Q411732</a></td></tr><tr><td>formula:</td><td>C6H7NO</td></tr><tr><td>molar mass:</td><td>109.128 g/mol (PubChem)</td></tr></table></body></html>"));
end NicotinylAlcoholPyridylcarbinol;
