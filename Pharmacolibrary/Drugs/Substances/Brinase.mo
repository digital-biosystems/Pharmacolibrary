    wikidataId = "Q4968176");
  annotation (Documentation(info = "<html><body><p>Brinase is an enzyme that was studied as an antithrombotic (blood-clot-dissolving) agent. It is considered experimental and is not an established, approved treatment.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4968176\">Wikidata Q4968176</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>brinase</td></tr><tr><td>ATC codes:</td><td>B01AD06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13199\">DB13199</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q4968176\">Q4968176</a></td></tr></table></body></html>"));
end Brinase;
