    logP = 2.8);
  annotation (Documentation(info = "<html><body><p>Ioxaglic acid is an iodinated, low-osmolar X-ray contrast agent used to visualise body structures during imaging procedures. It was approved but has since been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q6064817\">Wikidata Q6064817</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ioxaglic acid</td></tr><tr><td>ATC codes:</td><td>V08AB03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09313\">DB09313</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3742\">3742</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31718\">31718</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q6064817\">Q6064817</a></td></tr><tr><td>formula:</td><td>C24H21I6N5O8</td></tr><tr><td>molar mass:</td><td>1268.86 g/mol (PubChem CID 3742)</td></tr><tr><td>logP:</td><td>2.8 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end IoxaglicAcid;
