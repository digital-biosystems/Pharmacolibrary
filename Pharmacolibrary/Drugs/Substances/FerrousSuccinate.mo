within Pharmacolibrary.Drugs.Substances;
package FerrousSuccinate "ferrous succinate"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "ferrous succinate",
    atcCodes = {"B03AA06"},
    drugbankId = "DB14489",
    pubchemCid = "159252",
    wikidataId = "Q27269230",
    formula = "C4H6FeO4+2",
    M = 0.173933);
  annotation (Documentation(info = "<html><body><p>Ferrous succinate is an oral iron preparation (a hematinic) used to treat iron deficiency anemia. It is an approved oral bivalent iron medicine, though not widely used compared with other iron salts.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27269230\">Wikidata Q27269230</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ferrous succinate</td></tr><tr><td>ATC codes:</td><td>B03AA06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB14489\">DB14489</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/159252\">159252</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27269230\">Q27269230</a></td></tr><tr><td>formula:</td><td>C4H6FeO4+2</td></tr><tr><td>molar mass:</td><td>173.933 g/mol (PubChem CID 159252)</td></tr></table><p><small>Drugs.Common 25.09 gave 171.92 g/mol (-1.2 %); replaced by the value above</small></p></body></html>"));
end FerrousSuccinate;
