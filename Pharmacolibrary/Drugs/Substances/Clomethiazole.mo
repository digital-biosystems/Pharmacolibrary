  annotation (Documentation(info = "<html><body><p>Clomethiazole is a sedative and hypnotic medication, also described as an anticonvulsant and neuroprotective agent. It is classified among other hypnotics and sedatives, but its current availability is unclear; DrugBank lists it as investigational and no EU marketing authorisation is recorded.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q417178&quot;>Wikidata Q417178</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>clomethiazole</td></tr><tr><td>ATC codes:</td><td>N05CM02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06470&quot;>DB06470</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/10783&quot;>10783</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:92875&quot;>92875</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q417178&quot;>Q417178</a></td></tr><tr><td>formula:</td><td>C6H8ClNS</td></tr><tr><td>molar mass:</td><td>161.647 g/mol (PubChem)</td></tr></table></body></html>"));
