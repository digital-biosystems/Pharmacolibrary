    logP = 7.4);
  annotation (Documentation(info = "<html><body><p>Benzododecinium is a quaternary ammonium compound with disinfectant and local anti-infective properties, and has been classified for use in medicated dressings with anti-infectives for skin conditions. It is considered investigational and is not an authorised medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27284345\">Wikidata Q27284345</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>benzododecinium</td></tr><tr><td>ATC codes:</td><td>D09AA05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13282\">DB13282</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/8754\">8754</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135611\">135611</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27284345\">Q27284345</a></td></tr><tr><td>formula:</td><td>C21H38N+</td></tr><tr><td>molar mass:</td><td>304.542 g/mol (PubChem CID 8754)</td></tr><tr><td>logP:</td><td>7.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Benzododecinium;
