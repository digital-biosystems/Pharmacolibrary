    logP = 2.6);
  annotation (Documentation(info = "<html><body><p>Flucloxacillin is a penicillin antibiotic that resists breakdown by bacterial beta-lactamase enzymes and has been used to treat infections such as meningitis. It remains an approved antibacterial for systemic use, though some approved products have been withdrawn in certain markets.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1994556\">Wikidata Q1994556</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>flucloxacillin</td></tr><tr><td>ATC codes:</td><td>J01CF05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00301\">DB00301</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/21319\">21319</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:5098\">5098</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1994556\">Q1994556</a></td></tr><tr><td>formula:</td><td>C19H17ClFN3O5S</td></tr><tr><td>molar mass:</td><td>453.869 g/mol (PubChem CID 21319)</td></tr><tr><td>logP:</td><td>2.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Flucloxacillin;
