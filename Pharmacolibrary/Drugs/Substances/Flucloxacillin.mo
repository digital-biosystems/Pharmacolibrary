  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "flucloxacillin",
    atcCodes = {"J01CF05"},
    drugbankId = "DB00301",
    pubchemCid = "21319",
    chebiId = "5098",
    wikidataId = "Q1994556",
