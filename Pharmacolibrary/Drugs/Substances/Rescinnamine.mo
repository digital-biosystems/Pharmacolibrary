    logP = 4.5);
  annotation (Documentation(info = "<html><body><p>Rescinnamine is a Rauwolfia alkaloid used to treat high blood pressure, alone or combined with a diuretic. It is an approved antihypertensive, though Rauwolfia alkaloids are now only rarely used in practice.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q409978&quot;>Wikidata Q409978</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>rescinnamine</td></tr><tr><td>ATC codes:</td><td>C02AA01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01180&quot;>DB01180</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/32681&quot;>32681</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:28572&quot;>28572</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q409978&quot;>Q409978</a></td></tr><tr><td>formula:</td><td>C35H42N2O9</td></tr><tr><td>molar mass:</td><td>634.726 g/mol (PubChem)</td></tr></table></body></html>"));
end Rescinnamine;
