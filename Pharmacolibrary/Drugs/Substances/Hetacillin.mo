  annotation (Documentation(info = "<html><body><p>Hetacillin is a penicillin antibiotic with an extended spectrum, used as a bactericide against bacterial infections. It has been withdrawn from human use but remains an approved veterinary medicine, used in animals.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5746710&quot;>Wikidata Q5746710</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>hetacillin</td></tr><tr><td>ATC codes:</td><td>J01CA18</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00739&quot;>DB00739</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/443387&quot;>443387</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:5683&quot;>5683</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5746710&quot;>Q5746710</a></td></tr><tr><td>formula:</td><td>C19H23N3O4S</td></tr><tr><td>molar mass:</td><td>389.47 g/mol (PubChem)</td></tr></table></body></html>"));
