  annotation (Documentation(info = "<html><body><p>Hetacillin is a penicillin antibiotic with an extended spectrum, used as a bactericide against bacterial infections. It has been withdrawn from human use but remains an approved veterinary medicine, used in animals.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5746710\">Wikidata Q5746710</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>hetacillin</td></tr><tr><td>ATC codes:</td><td>J01CA18</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00739\">DB00739</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/443387\">443387</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:5683\">5683</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5746710\">Q5746710</a></td></tr><tr><td>formula:</td><td>C19H23N3O4S</td></tr><tr><td>molar mass:</td><td>389.47 g/mol (PubChem CID 443387)</td></tr><tr><td>logP:</td><td>-0.6 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
