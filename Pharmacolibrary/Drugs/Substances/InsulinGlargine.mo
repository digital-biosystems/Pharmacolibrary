  annotation (Documentation(info = "<html><body><p>Insulin glargine is a long-acting insulin used to treat diabetes, including type-1 diabetes and high blood sugar. It is widely used and authorised in the European Union for diabetes mellitus.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q417317&quot;>Wikidata Q417317</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>insulin glargine</td></tr><tr><td>ATC codes:</td><td>A10AE04</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00047&quot;>DB00047</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q417317&quot;>Q417317</a></td></tr><tr><td>molar mass:</td><td>6063 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
end InsulinGlargine;
