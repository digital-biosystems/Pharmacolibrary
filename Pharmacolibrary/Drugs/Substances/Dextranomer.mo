    wikidataId = "Q640763");
  annotation (Documentation(info = "<html><body><p>Dextranomer is a dextran-based preparation classified as a cicatrizant, intended to help wounds and ulcers heal. It is currently considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q640763&quot;>Wikidata Q640763</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dextranomer</td></tr><tr><td>ATC codes:</td><td>D03AX02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13560&quot;>DB13560</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q640763&quot;>Q640763</a></td></tr></table></body></html>"));
end Dextranomer;
