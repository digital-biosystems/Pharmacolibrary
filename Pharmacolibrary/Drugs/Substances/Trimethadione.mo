    logP = 0.3);
  annotation (Documentation(info = "<html><body><p>Trimethadione is an anticonvulsant that was used to treat childhood absence epilepsy. It has been withdrawn from use, largely because it is a developmental toxicant with serious safety concerns, and safer antiepileptics are now available.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q827916&quot;>Wikidata Q827916</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>trimethadione</td></tr><tr><td>ATC codes:</td><td>N03AC02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00347&quot;>DB00347</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5576&quot;>5576</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9727&quot;>9727</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q827916&quot;>Q827916</a></td></tr><tr><td>formula:</td><td>C6H9NO3</td></tr><tr><td>molar mass:</td><td>143.142 g/mol (PubChem)</td></tr></table></body></html>"));
