    logP = -1.4);
  annotation (Documentation(info = "<html><body><p>Carbamide (urea) is used as a skin moisturiser for dry or rough skin and, in solution form, to promote osmotic diuresis. It remains in use, mainly in topical emollient preparations, and is also approved for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q56440222\">Wikidata Q56440222</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>carbamide</td></tr><tr><td>ATC codes:</td><td>B05BC02, D02AE01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB03904\">DB03904</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/1176\">1176</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q56440222\">Q56440222</a></td></tr><tr><td>formula:</td><td>CH4N2O</td></tr><tr><td>molar mass:</td><td>60.056 g/mol (PubChem CID 1176)</td></tr><tr><td>logP:</td><td>-1.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Carbamide;
