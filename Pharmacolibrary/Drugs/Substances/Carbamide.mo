    logP = -1.4);
  annotation (Documentation(info = "<html><body><p>Carbamide (urea) is used as an emollient for skin conditions such as epidermolytic hyperkeratosis, and as an intravenous solution to lower raised pressure inside the skull or eye. It is an approved medicine, used mainly in topical skin preparations and in hospital settings for osmotic diuresis.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q48318&quot;>Wikidata Q48318</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>carbamide</td></tr><tr><td>ATC codes:</td><td>B05BC02, D02AE01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB03904&quot;>DB03904</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/1176&quot;>1176</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q48318&quot;>Q48318</a></td></tr><tr><td>formula:</td><td>CH4N2O</td></tr><tr><td>molar mass:</td><td>60.056 g/mol (PubChem)</td></tr></table></body></html>"));
end Carbamide;
