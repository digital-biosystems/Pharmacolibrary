within Pharmacolibrary.Drugs.Substances;
package FusidicAcid "fusidic acid"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "fusidic acid",
    atcCodes = {"D06AX01", "D09AA02", "J01XC01", "S01AA13"},
    drugbankId = "DB02703",
    pubchemCid = "3000226",
    chebiId = "29013",
    wikidataId = "Q259930",
    formula = "C31H48O6",
    M = 0.516719,
    logP = 5.5);
  annotation (Documentation(info = "<html><body><p>Fusidic acid is an antibiotic that inhibits bacterial protein synthesis and is used to treat bacterial skin, eye, and other infections. It is an approved medicine, available in topical skin preparations, medicated dressings, eye drops, and systemic formulations, and is used widely in many countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q259930\">Wikidata Q259930</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>fusidic acid</td></tr><tr><td>ATC codes:</td><td>D06AX01, D09AA02, J01XC01, S01AA13</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB02703\">DB02703</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/3000226\">3000226</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:29013\">29013</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q259930\">Q259930</a></td></tr><tr><td>formula:</td><td>C31H48O6</td></tr><tr><td>molar mass:</td><td>516.719 g/mol (PubChem CID 3000226)</td></tr><tr><td>logP:</td><td>5.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end FusidicAcid;
