  annotation (Documentation(info = "<html><body><p>Levamisole is an antinematodal drug used to treat worm infections and has also been used for benign colonic tumours. It is a WHO essential medicine and is also approved for veterinary use, though some uses have been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q417097&quot;>Wikidata Q417097</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>levamisole</td></tr><tr><td>ATC codes:</td><td>P02CE01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00848&quot;>DB00848</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/26879&quot;>26879</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6432&quot;>6432</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q417097&quot;>Q417097</a></td></tr><tr><td>formula:</td><td>C11H12N2S</td></tr><tr><td>molar mass:</td><td>204.291 g/mol (PubChem)</td></tr></table></body></html>"));
end Levamisole;
