within Pharmacolibrary.Drugs.Substances;
package Serplulimab "serplulimab"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "serplulimab",
    atcCodes = {"L01FF12"},
    drugbankId = "DB17451",
    wikidataId = "Q130351954");
  annotation (Documentation(info = "<html><body><p>Serplulimab is a monoclonal antibody that blocks PD-1 and is used to treat lung cancers, including small cell and non-small cell lung carcinoma, and esophageal squamous cell carcinoma. It is an approved anticancer medicine with one product authorised in the European Union, and remains under investigation for further uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q130351954\">Wikidata Q130351954</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>serplulimab</td></tr><tr><td>ATC codes:</td><td>L01FF12</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB17451\">DB17451</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q130351954\">Q130351954</a></td></tr></table></body></html>"));
end Serplulimab;
