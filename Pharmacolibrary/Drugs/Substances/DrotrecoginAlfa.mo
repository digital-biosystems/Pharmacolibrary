within Pharmacolibrary.Drugs.Substances;
package DrotrecoginAlfa "Drotrecogin alfa"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "Drotrecogin alfa",
    atcCodes = {"B01AD10"},
    drugbankId = "DB00055",
    wikidataId = "Q412888");
  annotation (Documentation(info = "<html><body><p>Drotrecogin alfa, a form of activated protein C, was used to treat severe sepsis. It was later withdrawn from the market, including in the European Union, after it failed to demonstrate sufficient benefit for patients.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q412888\">Wikidata Q412888</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>Drotrecogin alfa</td></tr><tr><td>ATC codes:</td><td>B01AD10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00055\">DB00055</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q412888\">Q412888</a></td></tr></table></body></html>"));
end DrotrecoginAlfa;
