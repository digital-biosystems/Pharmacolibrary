  annotation (Documentation(info = "<html><body><p>Atosiban is a tocolytic drug used to treat premature labour by relaxing the uterus. It is authorised in the European Union and used in obstetric care for threatened preterm birth.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q421322\">Wikidata Q421322</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>atosiban</td></tr><tr><td>ATC codes:</td><td>G02CX01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09059\">DB09059</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/5311010\">5311010</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135899\">135899</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q421322\">Q421322</a></td></tr><tr><td>formula:</td><td>C43H67N11O12S2</td></tr><tr><td>molar mass:</td><td>994.194 g/mol (PubChem CID 5311010)</td></tr><tr><td>logP:</td><td>-1.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Atosiban;
