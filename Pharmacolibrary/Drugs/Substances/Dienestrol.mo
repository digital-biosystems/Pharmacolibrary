  annotation (Documentation(info = "<html><body><p>Dienestrol is a synthetic non-steroidal estrogen that was used, typically as a topical cream, to treat menopausal symptoms such as vaginal atrophy. It is no longer in use and has been withdrawn from the market.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5274949&quot;>Wikidata Q5274949</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>dienestrol</td></tr><tr><td>ATC codes:</td><td>G03CB01, G03CC02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00890&quot;>DB00890</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/667476&quot;>667476</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:4518&quot;>4518</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5274949&quot;>Q5274949</a></td></tr><tr><td>formula:</td><td>C18H18O2</td></tr><tr><td>molar mass:</td><td>266.34 g/mol (PubChem)</td></tr></table></body></html>"));
