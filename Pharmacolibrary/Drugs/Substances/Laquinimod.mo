  annotation (Documentation(info = "<html><body><p>Laquinimod is an investigational drug that was studied for the treatment of multiple sclerosis. It has not been approved; a marketing application in the European Union was refused, so it remains unavailable to patients.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3487584\">Wikidata Q3487584</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>laquinimod</td></tr><tr><td>ATC codes:</td><td>N07XX10</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB06685\">DB06685</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/54677946\">54677946</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:134738\">134738</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q3487584\">Q3487584</a></td></tr><tr><td>formula:</td><td>C19H17ClN2O3</td></tr><tr><td>molar mass:</td><td>356.806 g/mol (PubChem CID 54677946)</td></tr><tr><td>logP:</td><td>3.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
