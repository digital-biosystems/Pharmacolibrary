within Pharmacolibrary.Drugs.Substances;
package Octreotide "octreotide"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "octreotide",
    atcCodes = {"H01CB02"},
    drugbankId = "DB00104",
    pubchemCid = "448601",
