    logP = 1);
  annotation (Documentation(info = "<html><body><p>Octreotide, a somatostatin analogue, is used to treat acromegaly and various neuroendocrine conditions such as carcinoid syndrome and pancreatic cancer. It is an approved medicine, authorised in the European Union for acromegaly, and is also being investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q419935\">Wikidata Q419935</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>octreotide</td></tr><tr><td>ATC codes:</td><td>H01CB02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00104\">DB00104</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/448601\">448601</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q419935\">Q419935</a></td></tr><tr><td>molar mass:</td><td>1019.2 g/mol (Drugs.Common 25.09, not verified)</td></tr><tr><td>logP:</td><td>1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Octreotide;
