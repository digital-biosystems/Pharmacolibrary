  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "metoclopramide",
    atcCodes = {"A03FA01"},
    drugbankId = "DB01233",
    pubchemCid = "4168",
    chebiId = "107736",
    wikidataId = "Q421095",
