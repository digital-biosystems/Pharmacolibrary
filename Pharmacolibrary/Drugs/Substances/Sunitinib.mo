  annotation (Documentation(info = "<html><body><p>Sunitinib is a protein kinase inhibitor used to treat several cancers, including kidney cancer, gastrointestinal stromal tumors, and neuroendocrine tumors. It is an approved medicine, authorised in the European Union, and widely used in cancer care.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q417542&quot;>Wikidata Q417542</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>sunitinib</td></tr><tr><td>ATC codes:</td><td>L01EX01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01268&quot;>DB01268</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5329102&quot;>5329102</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:38940&quot;>38940</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q417542&quot;>Q417542</a></td></tr><tr><td>formula:</td><td>C22H27FN4O2</td></tr><tr><td>molar mass:</td><td>398.482 g/mol (PubChem)</td></tr></table></body></html>"));
