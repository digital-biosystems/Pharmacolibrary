  annotation (Documentation(info = "<html><body><p>Betamipron is a component of the combination antibiotic panipenem/betamipron, which belongs to the carbapenem class of antibacterial drugs. It is considered experimental and has no authorisation from the European Medicines Agency.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q607051\">Wikidata Q607051</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Betamipron</td></tr><tr><td>ATC codes:</td><td>J01DH55</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB19858\">DB19858</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/71651\">71651</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q607051\">Q607051</a></td></tr><tr><td>formula:</td><td>C10H11NO3</td></tr><tr><td>molar mass:</td><td>193.202 g/mol (PubChem CID 71651)</td></tr></table></body></html>"));
