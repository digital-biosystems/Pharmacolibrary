  annotation (Documentation(info = "<html><body><p>Strontium ranelate is a bone-acting medicine that was used to treat osteoporosis, including postmenopausal osteoporosis. It is no longer used: its marketing authorisations in the European Union have been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q419215\">Wikidata Q419215</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>strontium ranelate</td></tr><tr><td>ATC codes:</td><td>M05BX03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09267\">DB09267</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/6918182\">6918182</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q419215\">Q419215</a></td></tr><tr><td>formula:</td><td>C12H6N2O8SSr2</td></tr><tr><td>molar mass:</td><td>513.486 g/mol (PubChem CID 6918182)</td></tr></table></body></html>"));
