    wikidataId = "Q798309");
  annotation (Documentation(info = "<html><body><p>BCG vaccine is a vaccine used primarily to protect against tuberculosis. It is widely used around the world, and it is also given as an immunostimulant treatment in some cancers.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q798309&quot;>Wikidata Q798309</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>BCG vaccine</td></tr><tr><td>ATC codes:</td><td>L03AX03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB12768&quot;>DB12768</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q798309&quot;>Q798309</a></td></tr></table></body></html>"));
end BCGVaccine;
