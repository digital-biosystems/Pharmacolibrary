    logP = 8.8);
  annotation (Documentation(info = "<html><body><p>Temoporfin is a photosensitizing antineoplastic agent used in photodynamic therapy for head and neck cancers, notably squamous cell carcinoma. It is authorised in the European Union, but its use remains limited to specialised treatment of these tumours.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7698204&quot;>Wikidata Q7698204</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>temoporfin</td></tr><tr><td>ATC codes:</td><td>L01XD05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11630&quot;>DB11630</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/60751&quot;>60751</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:9437&quot;>9437</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7698204&quot;>Q7698204</a></td></tr><tr><td>formula:</td><td>C44H32N4O4</td></tr><tr><td>molar mass:</td><td>680.764 g/mol (PubChem)</td></tr></table></body></html>"));
end Temoporfin;
