  annotation (Documentation(info = "<html><body><p>Afamelanotide is a dermatologic drug used to treat erythropoietic protoporphyria, offering systemic protection against UV radiation. It is authorised in the European Union and is also being investigated for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q410794&quot;>Wikidata Q410794</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>afamelanotide</td></tr><tr><td>ATC codes:</td><td>D02BB02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB04931&quot;>DB04931</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/16197727&quot;>16197727</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:136034&quot;>136034</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q410794&quot;>Q410794</a></td></tr><tr><td>formula:</td><td>C78H111N21O19</td></tr><tr><td>molar mass:</td><td>1646.87 g/mol (PubChem)</td></tr></table></body></html>"));
