  annotation (Documentation(info = "<html><body><p>Ciclonicate is a nicotinic acid derivative classified as a peripheral vasodilator, a class of drugs used for circulatory disorders of the blood vessels. It is currently considered experimental and does not appear to be an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q507326&quot;>Wikidata Q507326</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>ciclonicate</td></tr><tr><td>ATC codes:</td><td>C04AC07</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13709&quot;>DB13709</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/10444661&quot;>10444661</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135007&quot;>135007</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q507326&quot;>Q507326</a></td></tr><tr><td>formula:</td><td>C15H21NO2</td></tr><tr><td>molar mass:</td><td>247.338 g/mol (PubChem)</td></tr></table></body></html>"));
