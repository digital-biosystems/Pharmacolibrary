  annotation (Documentation(info = "<html><body><p>Imidazole salicylate is a salicylic acid derivative classified as a non-steroidal anti-inflammatory drug, used as an analgesic and antipyretic for pain relief. It is listed only as an experimental drug and does not appear to be an approved medicine today.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27259796\">Wikidata Q27259796</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>imidazole salicylate</td></tr><tr><td>ATC codes:</td><td>N02BA16</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13860\">DB13860</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/37425\">37425</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27259796\">Q27259796</a></td></tr><tr><td>formula:</td><td>C10H10N2O3</td></tr><tr><td>molar mass:</td><td>206.201 g/mol (PubChem CID 37425)</td></tr></table></body></html>"));
