  annotation (Documentation(info = "<html><body><p>Diloxanide is an antiprotozoal agent used against amoebiasis. It is not an approved medicine and is considered experimental, so it is not widely used.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q81983877&quot;>Wikidata Q81983877</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>diloxanide</td></tr><tr><td>ATC codes:</td><td>P01AC01</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08792&quot;>DB08792</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/11367&quot;>11367</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q81983877&quot;>Q81983877</a></td></tr><tr><td>formula:</td><td>C9H9Cl2NO2</td></tr><tr><td>molar mass:</td><td>234.076 g/mol (PubChem)</td></tr></table></body></html>"));
