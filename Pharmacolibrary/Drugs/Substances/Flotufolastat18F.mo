  annotation (Documentation(info = "<html><body><p>Flotufolastat F-18 is a diagnostic radiopharmaceutical used for detecting tumours, particularly in prostate cancer imaging. It is an approved imaging agent, used in specialised nuclear medicine settings rather than as a routine treatment.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q120497866&quot;>Wikidata Q120497866</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>flotufolastat (18F)</td></tr><tr><td>ATC codes:</td><td>V09IX18</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB17851&quot;>DB17851</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q120497866&quot;>Q120497866</a></td></tr></table></body></html>"));
