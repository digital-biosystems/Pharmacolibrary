  annotation (Documentation(info = "<html><body><p>Flotufolastat (18F) is a diagnostic radiopharmaceutical used for detecting tumours, particularly in prostate cancer imaging. It is an approved imaging agent, used mainly in specialised nuclear medicine settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q120693652\">Wikidata Q120693652</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>flotufolastat (18F)</td></tr><tr><td>ATC codes:</td><td>V09IX18</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB17851\">DB17851</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q120693652\">Q120693652</a></td></tr></table></body></html>"));
end Flotufolastat18F;
