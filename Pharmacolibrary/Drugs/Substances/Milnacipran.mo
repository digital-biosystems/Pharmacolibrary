  annotation (Documentation(info = "<html><body><p>Milnacipran is an antidepressant that has been used to treat fibromyalgia. It is approved and used for fibromyalgia, but marketing applications in the European Union were refused, so it is not authorised there.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q421058&quot;>Wikidata Q421058</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>milnacipran</td></tr><tr><td>ATC codes:</td><td>N06AX17</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB04896&quot;>DB04896</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/65833&quot;>65833</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135005&quot;>135005</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q421058&quot;>Q421058</a></td></tr><tr><td>formula:</td><td>C15H22N2O</td></tr><tr><td>molar mass:</td><td>246.354 g/mol (PubChem)</td></tr></table></body></html>"));
end Milnacipran;
