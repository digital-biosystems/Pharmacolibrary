  annotation (Documentation(info = "<html><body><p>Milnacipran is an antidepressant used to treat depression and, in some countries, fibromyalgia. It is approved and used in some countries, but marketing authorisation was refused in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27086377\">Wikidata Q27086377</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>milnacipran</td></tr><tr><td>ATC codes:</td><td>N06AX17</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB04896\">DB04896</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/65833\">65833</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135005\">135005</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27086377\">Q27086377</a></td></tr><tr><td>formula:</td><td>C15H22N2O</td></tr><tr><td>molar mass:</td><td>246.354 g/mol (PubChem CID 65833)</td></tr><tr><td>logP:</td><td>1.4 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
