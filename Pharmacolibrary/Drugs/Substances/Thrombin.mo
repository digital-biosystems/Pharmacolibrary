within Pharmacolibrary.Drugs.Substances;
package Thrombin "thrombin"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "thrombin",
    atcCodes = {"B02BC06", "B02BD30"},
    drugbankId = "DB11300",
    wikidataId = "Q409166");
  annotation (Documentation(info = "<html><body><p>Thrombin, a blood coagulation factor, is used as a local hemostatic to help stop bleeding. It is an approved medicine, applied locally to control bleeding, and is also being studied for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q409166\">Wikidata Q409166</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>thrombin</td></tr><tr><td>ATC codes:</td><td>B02BC06, B02BD30</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11300\">DB11300</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q409166\">Q409166</a></td></tr></table></body></html>"));
end Thrombin;
