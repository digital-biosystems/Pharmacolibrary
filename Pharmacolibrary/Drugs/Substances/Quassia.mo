  annotation (Documentation(info = "<html><body><p>Quassia, a plant-derived remedy, is classified as an ectoparasiticide used against parasites such as lice. It is not an established medicine; it is listed only as experimental, with no authorisation by the European Medicines Agency.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1947702\">Wikidata Q1947702</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>quassia</td></tr><tr><td>ATC codes:</td><td>P03AX04</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13263\">DB13263</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q1947702\">Q1947702</a></td></tr></table></body></html>"));
end Quassia;
