  annotation (Documentation(info = "<html><body><p>Voxelotor is a hematological drug developed for the treatment of sickle cell anemia. Its marketing in the European Union has been suspended, so it is no longer available there.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q60761545\">Wikidata Q60761545</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>voxelotor</td></tr><tr><td>ATC codes:</td><td>B06AX03</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB14975\">DB14975</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/71602803\">71602803</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q60761545\">Q60761545</a></td></tr><tr><td>formula:</td><td>C19H19N3O3</td></tr><tr><td>molar mass:</td><td>337.379 g/mol (PubChem CID 71602803)</td></tr><tr><td>logP:</td><td>2.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
