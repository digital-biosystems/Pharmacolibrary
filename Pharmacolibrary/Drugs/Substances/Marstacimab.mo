  annotation (Documentation(info = "<html><body><p>Marstacimab, a monoclonal antibody, is used to treat hemophilia A and hemophilia B. It is authorised in the European Union as a systemic hemostatic medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q130351881&quot;>Wikidata Q130351881</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>marstacimab</td></tr><tr><td>ATC codes:</td><td>B02BX11</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB17725&quot;>DB17725</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q130351881&quot;>Q130351881</a></td></tr></table></body></html>"));
