  annotation (Documentation(info = "<html><body><p>Tioxolone is a sulfur-containing topical anti-acne preparation with anti-seborrheic activity. It is currently regarded as experimental, with no authorised marketing identified, so its present availability is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7808755&quot;>Wikidata Q7808755</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tioxolone</td></tr><tr><td>ATC codes:</td><td>D10AB03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13343&quot;>DB13343</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/72139&quot;>72139</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:568021&quot;>568021</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7808755&quot;>Q7808755</a></td></tr><tr><td>formula:</td><td>C7H4O3S</td></tr><tr><td>molar mass:</td><td>168.166 g/mol (PubChem)</td></tr></table></body></html>"));
