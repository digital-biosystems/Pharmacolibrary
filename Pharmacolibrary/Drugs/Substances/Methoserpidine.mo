  annotation (Documentation(info = "<html><body><p>Methoserpidine is a Rauwolfia alkaloid that was classified as a centrally acting antihypertensive, used to treat high blood pressure, including in combination with diuretics. It is currently listed only as an experimental compound, and no marketing authorisation is recorded, so it does not appear to be in routine clinical use today.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q3333696&quot;>Wikidata Q3333696</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>methoserpidine</td></tr><tr><td>ATC codes:</td><td>C02AA06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13631&quot;>DB13631</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/71798&quot;>71798</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135848&quot;>135848</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q3333696&quot;>Q3333696</a></td></tr><tr><td>formula:</td><td>C33H40N2O9</td></tr><tr><td>molar mass:</td><td>608.688 g/mol (PubChem)</td></tr></table></body></html>"));
