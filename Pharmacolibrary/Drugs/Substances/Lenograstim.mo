within Pharmacolibrary.Drugs.Substances;
package Lenograstim "lenograstim"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "lenograstim",
    atcCodes = {"L03AA10"},
    drugbankId = "DB13144",
    wikidataId = "Q6523037");
  annotation (Documentation(info = "<html><body><p>Lenograstim is a granulocyte colony-stimulating factor used to stimulate white blood cell production, mainly to treat or prevent neutropenia in patients receiving cancer chemotherapy. It is an approved medicine, authorised in the European Union, and used in clinical practice for chemotherapy-induced neutropenia and related conditions.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q6523037&quot;>Wikidata Q6523037</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>lenograstim</td></tr><tr><td>ATC codes:</td><td>L03AA10</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13144&quot;>DB13144</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q6523037&quot;>Q6523037</a></td></tr></table></body></html>"));
end Lenograstim;
