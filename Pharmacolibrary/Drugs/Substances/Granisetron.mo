  annotation (Documentation(info = "<html><body><p>Granisetron is an antiemetic used to prevent nausea and vomiting, especially in people receiving cancer treatment. It is an approved medicine and remains authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q596708&quot;>Wikidata Q596708</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>granisetron</td></tr><tr><td>ATC codes:</td><td>A04AA02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00889&quot;>DB00889</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5284566&quot;>5284566</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:5537&quot;>5537</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q596708&quot;>Q596708</a></td></tr><tr><td>formula:</td><td>C18H24N4O</td></tr><tr><td>molar mass:</td><td>312.417 g/mol (PubChem)</td></tr></table></body></html>"));
