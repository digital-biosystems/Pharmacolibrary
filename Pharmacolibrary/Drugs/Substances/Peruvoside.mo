  annotation (Documentation(info = "<html><body><p>Peruvoside is a cardiac glycoside with cardiotonic activity, classified among other cardiac glycosides used in cardiac therapy. It appears to be only an experimental compound, with no authorised marketing identified.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7171218\">Wikidata Q7171218</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>peruvoside</td></tr><tr><td>ATC codes:</td><td>C01AX02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13756\">DB13756</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/12314120\">12314120</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135825\">135825</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7171218\">Q7171218</a></td></tr><tr><td>formula:</td><td>C30H44O9</td></tr><tr><td>molar mass:</td><td>548.673 g/mol (PubChem CID 12314120)</td></tr><tr><td>logP:</td><td>0.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Peruvoside;
