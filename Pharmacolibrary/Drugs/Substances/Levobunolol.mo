  annotation (Documentation(info = "<html><body><p>Levobunolol is a beta blocker eye drop used to treat open-angle glaucoma and ocular hypertension. It is an approved ophthalmological medicine, used as an antiglaucoma beta blocking agent.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q408556&quot;>Wikidata Q408556</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>levobunolol</td></tr><tr><td>ATC codes:</td><td>S01ED03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB01210&quot;>DB01210</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/39468&quot;>39468</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:6438&quot;>6438</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q408556&quot;>Q408556</a></td></tr><tr><td>formula:</td><td>C17H25NO3</td></tr><tr><td>molar mass:</td><td>291.391 g/mol (PubChem)</td></tr></table></body></html>"));
