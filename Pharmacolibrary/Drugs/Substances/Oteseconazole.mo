    logP = 4.2);
  annotation (Documentation(info = "<html><body><p>Oteseconazole is an antifungal medicine used to treat candidiasis, a yeast infection. It is approved and used in the United States, but marketing applications in the European Union were withdrawn or refused, so it is not authorised there.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27291837\">Wikidata Q27291837</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>oteseconazole</td></tr><tr><td>ATC codes:</td><td>J02AC06</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB13055\">DB13055</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/77050711\">77050711</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:188153\">188153</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q27291837\">Q27291837</a></td></tr><tr><td>formula:</td><td>C23H16F7N5O2</td></tr><tr><td>molar mass:</td><td>527.4 g/mol (PubChem CID 77050711)</td></tr><tr><td>logP:</td><td>4.2 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Oteseconazole;
