    M = 0.384243);
  annotation (Documentation(info = "<html><body><p>Bortezomib is an anticancer medicine (a proteasome inhibitor) used mainly to treat multiple myeloma and other blood cancers such as mantle cell lymphoma. It is approved and widely used, with several authorised products in the European Union, though it is typically given under specialist oncology care.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q419319\">Wikidata Q419319</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>bortezomib</td></tr><tr><td>ATC codes:</td><td>L01XG01, L01XX32</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00188\">DB00188</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/387447\">387447</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:52717\">52717</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q419319\">Q419319</a></td></tr><tr><td>formula:</td><td>C19H25BN4O4</td></tr><tr><td>molar mass:</td><td>384.243 g/mol (PubChem CID 387447)</td></tr></table></body></html>"));
end Bortezomib;
