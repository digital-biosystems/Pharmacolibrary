  annotation (Documentation(info = "<html><body><p>Abarelix is a hormone antagonist that was used as endocrine therapy for cancer, mainly advanced prostate cancer. It has been withdrawn from the market and is no longer in clinical use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q305555\">Wikidata Q305555</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>abarelix</td></tr><tr><td>ATC codes:</td><td>L02BX01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB00106\">DB00106</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/16131215\">16131215</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:337298\">337298</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q305555\">Q305555</a></td></tr><tr><td>formula:</td><td>C72H95ClN14O14</td></tr><tr><td>molar mass:</td><td>1416.09 g/mol (PubChem CID 16131215)</td></tr><tr><td>logP:</td><td>3.7 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
