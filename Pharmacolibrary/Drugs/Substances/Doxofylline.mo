    logP = -0.9);
  annotation (Documentation(info = "<html><body><p>Doxofylline is a xanthine bronchodilator used to treat obstructive airway diseases such as asthma and chronic obstructive pulmonary disease. It is not authorised in the European Union and is considered investigational in major drug databases, though it is used in some countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q425887\">Wikidata Q425887</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>doxofylline</td></tr><tr><td>ATC codes:</td><td>R03DA11</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09273\">DB09273</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/50942\">50942</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:94714\">94714</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q425887\">Q425887</a></td></tr><tr><td>formula:</td><td>C11H14N4O4</td></tr><tr><td>molar mass:</td><td>266.257 g/mol (PubChem CID 50942)</td></tr><tr><td>logP:</td><td>-0.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Doxofylline;
