  annotation (Documentation(info = "<html><body><p>Venetoclax is an anticancer medicine used to treat blood cancers such as chronic lymphocytic leukemia, acute myeloid leukemia, and certain B-cell lymphomas. It is an approved medicine and is authorised in the European Union for chronic lymphocytic leukemia.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q23671272&quot;>Wikidata Q23671272</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><table><tr><td>name:</td><td>venetoclax</td></tr><tr><td>ATC codes:</td><td>L01XX52</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB11581&quot;>DB11581</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/49846579&quot;>49846579</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:133021&quot;>133021</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q23671272&quot;>Q23671272</a></td></tr><tr><td>formula:</td><td>C45H50ClN7O7S</td></tr><tr><td>molar mass:</td><td>868.447 g/mol (PubChem)</td></tr></table></body></html>"));
