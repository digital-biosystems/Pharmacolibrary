  annotation (Documentation(info = "<html><body><p>Voglibose is an anti-diabetic medicine, an alpha glucosidase inhibitor used to treat diabetes. It is not authorised in the European Union and is considered investigational in major drug databases, though it is used in some Asian countries.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q7939403&quot;>Wikidata Q7939403</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>voglibose</td></tr><tr><td>ATC codes:</td><td>A10BF03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB04878&quot;>DB04878</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/444020&quot;>444020</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:32300&quot;>32300</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q7939403&quot;>Q7939403</a></td></tr><tr><td>formula:</td><td>C10H21NO7</td></tr><tr><td>molar mass:</td><td>267.278 g/mol (PubChem)</td></tr></table></body></html>"));
