  annotation (Documentation(info = "<html><body><p>Unoprostone is a prostaglandin analogue eye drop used to treat open-angle glaucoma and ocular hypertension. It was approved but has been withdrawn and is no longer on the market.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q4859684&quot;>Wikidata Q4859684</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>unoprostone</td></tr><tr><td>ATC codes:</td><td>S01EE02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB06826&quot;>DB06826</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/5311236&quot;>5311236</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:39455&quot;>39455</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q4859684&quot;>Q4859684</a></td></tr><tr><td>formula:</td><td>C22H38O5</td></tr><tr><td>molar mass:</td><td>382.541 g/mol (PubChem)</td></tr></table></body></html>"));
end Unoprostone;
