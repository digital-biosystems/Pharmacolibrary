  annotation (Documentation(info = "<html><body><p>Hydrocortisone butyrate is a moderately potent topical corticosteroid used to treat inflammatory skin conditions. It is an approved medicine, applied to the skin, and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q5954743&quot;>Wikidata Q5954743</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>hydrocortisone butyrate</td></tr><tr><td>ATC codes:</td><td>D07AB02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB14540&quot;>DB14540</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:31674&quot;>31674</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q5954743&quot;>Q5954743</a></td></tr><tr><td>formula:</td><td>C25H36O6</td></tr><tr><td>molar mass:</td><td>432.557 g/mol (Drugs.Common (25.09))</td></tr></table></body></html>"));
