  annotation (Documentation(info = "<html><body><p>Magaldrate is an antacid used for acid-related digestive problems such as heartburn, indigestion, and stomach or duodenal ulcers. It has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q419991&quot;>Wikidata Q419991</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>magaldrate</td></tr><tr><td>ATC codes:</td><td>A02AD02</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB08938&quot;>DB08938</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/3086011&quot;>3086011</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q419991&quot;>Q419991</a></td></tr><tr><td>formula:</td><td>AlHMgO5S+2</td></tr><tr><td>molar mass:</td><td>164.35 g/mol (PubChem)</td></tr></table></body></html>"));
