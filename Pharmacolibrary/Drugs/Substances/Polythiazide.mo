within Pharmacolibrary.Drugs.Substances;
package Polythiazide "polythiazide"
  extends Pharmacolibrary.Interfaces.PartialSubstance(
    name = "polythiazide",
    atcCodes = {"C03AA05"},
    drugbankId = "DB01324",
    pubchemCid = "4870",
    chebiId = "8327",
    wikidataId = "Q7227099",
    formula = "C11H13ClF3N3O4S3",
    M = 0.439866,
    logP = 1.1);
  annotation (Documentation(info = "<html><body><p>Polythiazide is a thiazide diuretic used to treat high blood pressure, congestive heart failure, nephrotic syndrome, and anasarka (fluid retention). It is an approved drug, though it appears to be little used today and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q7227099\">Wikidata Q7227099</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>polythiazide</td></tr><tr><td>ATC codes:</td><td>C03AA05</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01324\">DB01324</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/4870\">4870</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8327\">8327</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q7227099\">Q7227099</a></td></tr><tr><td>formula:</td><td>C11H13ClF3N3O4S3</td></tr><tr><td>molar mass:</td><td>439.866 g/mol (PubChem CID 4870)</td></tr><tr><td>logP:</td><td>1.1 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
end Polythiazide;
