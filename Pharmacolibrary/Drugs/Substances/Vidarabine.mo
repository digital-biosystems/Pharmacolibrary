  annotation (Documentation(info = "<html><body><p>Vidarabine is an antiviral drug that was used to treat herpes simplex infections, including herpes simplex keratitis of the eye. It has been withdrawn from use, having been largely replaced by newer antiviral medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q415107&quot;>Wikidata Q415107</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>vidarabine</td></tr><tr><td>ATC codes:</td><td>J05AB03, S01AD06</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB00194&quot;>DB00194</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/21704&quot;>21704</a></td></tr><tr><td>ChEBI:</td><td><a href=&quot;https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:45327&quot;>45327</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q415107&quot;>Q415107</a></td></tr><tr><td>formula:</td><td>C10H13N5O4</td></tr><tr><td>molar mass:</td><td>267.245 g/mol (PubChem)</td></tr></table></body></html>"));
