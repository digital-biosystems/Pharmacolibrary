  annotation (Documentation(info = "<html><body><p>Methallenestril is a synthetic estrogen that was intended for treating menopausal and postmenopausal disorders. It is not an approved medicine and remains only an experimental compound, with no marketing authorisation in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q10843651&quot;>Wikidata Q10843651</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>methallenestril</td></tr><tr><td>ATC codes:</td><td>G03CB03, G03CC03</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB13143&quot;>DB13143</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/59084697&quot;>59084697</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q10843651&quot;>Q10843651</a></td></tr><tr><td>formula:</td><td>C18H22O3</td></tr><tr><td>molar mass:</td><td>286.371 g/mol (PubChem)</td></tr></table></body></html>"));
