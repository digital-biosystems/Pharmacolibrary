    logP = -7.9);
  annotation (Documentation(info = "<html><body><p>Tetracosactide (cosyntropin) is a synthetic fragment of the pituitary hormone ACTH used to test how well the adrenal glands work, helping diagnose adrenal insufficiency. It is an approved medicine, used mainly in diagnostic testing, typically in hospital or specialist settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q560542\">Wikidata Q560542</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>tetracosactide</td></tr><tr><td>ATC codes:</td><td>H01AA02</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB01284\">DB01284</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/16133751\">16133751</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3901\">3901</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q560542\">Q560542</a></td></tr><tr><td>formula:</td><td>C136H210N40O31S</td></tr><tr><td>molar mass:</td><td>2933.49 g/mol (PubChem CID 16133751)</td></tr><tr><td>logP:</td><td>-7.9 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
