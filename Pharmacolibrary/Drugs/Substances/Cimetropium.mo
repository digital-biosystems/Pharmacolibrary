  annotation (Documentation(info = "<html><body><p>Cimetropium is a semisynthetic belladonna alkaloid studied for treating functional gastrointestinal disorders, acting as an antispasmodic. It is considered investigational and is not an approved medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=&quot;https://www.wikidata.org/wiki/Q963406&quot;>Wikidata Q963406</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>Cimetropium</td></tr><tr><td>ATC codes:</td><td>A03BB05</td></tr><tr><td>DrugBank:</td><td><a href=&quot;https://go.drugbank.com/drugs/DB09271&quot;>DB09271</a></td></tr><tr><td>PubChem CID:</td><td><a href=&quot;https://pubchem.ncbi.nlm.nih.gov/compound/20054871&quot;>20054871</a></td></tr><tr><td>Wikidata:</td><td><a href=&quot;https://www.wikidata.org/wiki/Q963406&quot;>Q963406</a></td></tr><tr><td>formula:</td><td>C21H28NO4+</td></tr><tr><td>molar mass:</td><td>358.458 g/mol (PubChem)</td></tr></table></body></html>"));
