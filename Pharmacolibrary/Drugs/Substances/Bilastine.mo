  annotation (Documentation(info = "<html><body><p>Bilastine is an antihistamine used to treat allergic conditions such as allergic rhinitis and urticaria. It is an approved medicine and is widely used, including as eye drops for allergic eye symptoms.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2902977\">Wikidata Q2902977</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>bilastine</td></tr><tr><td>ATC codes:</td><td>R06AX29, S01GX13</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB11591\">DB11591</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/185460\">185460</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:135954\">135954</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q2902977\">Q2902977</a></td></tr><tr><td>formula:</td><td>C28H37N3O3</td></tr><tr><td>molar mass:</td><td>463.622 g/mol (PubChem CID 185460)</td></tr><tr><td>logP:</td><td>2.3 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
