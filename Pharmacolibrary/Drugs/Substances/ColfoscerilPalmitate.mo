  annotation (Documentation(info = "<html><body><p>Colfosceril palmitate is a lung surfactant that was used as a pulmonary surfactant, for example in respiratory conditions treated with such agents. It has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5144764\">Wikidata Q5144764</a> and the WHO ATC classification; not checked by a person.</small></p><table><tr><td>name:</td><td>colfosceril palmitate</td></tr><tr><td>ATC codes:</td><td>R07AA01</td></tr><tr><td>DrugBank:</td><td><a href=\"https://go.drugbank.com/drugs/DB09114\">DB09114</a></td></tr><tr><td>PubChem CID:</td><td><a href=\"https://pubchem.ncbi.nlm.nih.gov/compound/452110\">452110</a></td></tr><tr><td>ChEBI:</td><td><a href=\"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:72999\">72999</a></td></tr><tr><td>Wikidata:</td><td><a href=\"https://www.wikidata.org/wiki/Q5144764\">Q5144764</a></td></tr><tr><td>formula:</td><td>C40H80NO8P</td></tr><tr><td>molar mass:</td><td>734.053 g/mol (PubChem CID 452110)</td></tr><tr><td>logP:</td><td>13.5 (Drugs.Common 25.09, not verified)</td></tr></table></body></html>"));
