within Pharmacolibrary.Drugs.D_Dermatologicals.D11A_OtherDermatologicalPreparations.D11AH12_Nemolizumab;
model Nemolizumab_Fauchet2026_reference
  parameter Real Cl_ref = 3.0439814814814813e-09 "Cl [m3/s]";
  parameter Real cov_albumin_0 = 0 "albumin covariate";
  parameter Real cov_crcl_1 = 0 "crcl covariate";
  parameter Real cov_ethnicity_2 = 0 "ethnicity covariate";
  parameter Real cov_race_3 = 0 "race covariate";
  parameter Real cov_sex_4 = 0 "sex covariate";
  parameter Real Vd_ref = 0.00767 "Vd [m3]";
  parameter Real cov_bodyweight_1 = 0 "bodyweight covariate";
  extends Pharmacolibrary.Pharmacokinetic.Models.PK_1C_enteral(
    weight = 70.0,
    F = 1,
    Cl = Cl_ref*(1 + (-1.35)*cov_albumin_0)*(1 + (0.168)*cov_crcl_1)*(1 + (0.226)*cov_ethnicity_2)*(1 + (0.186)*cov_race_3)*(1 + (0.1)*cov_sex_4),
    Vd = Vd_ref*(1 + (-0.535)*cov_albumin_0)*(1 + (0.802)*cov_bodyweight_1),
    adminDuration = 600,
    adminCount = 1,
    adminMass = 3e-05,
    ka = 5.509259259259259e-06,
    Tlag = 3715.2
  );

  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>nemolizumab</td></tr><tr><td>ATC code:</td><td>D11AH12</td></tr><tr><td>model:</td><td>one compartment, oral dosing <small>(PK_1C_enteral)</small></td></tr><tr><td>source:</td><td>Fauchet F et al. 2026</td></tr><tr><td>population:</td><td>adults and adolescents with moderate to severe atopic dermatitis</td></tr><tr><td>measured compound:</td><td>nemolizumab</td></tr><tr><td>review:</td><td>accepted with caveats</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_nemolizumab/Nemolizumab_Fauchet2026_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>CL/F (L/day)</td><td>0.263</td><td>L/day</td><td><small>CL/F</small></td></tr><tr><td>V/F (L)</td><td>7.670</td><td>L</td><td><small>V/F</small></td></tr><tr><td>K_a (1/day)</td><td>0.476</td><td>1/day</td><td><small>kabs</small></td></tr><tr><td>ALAG (day)</td><td>0.043</td><td>day</td><td><small>tlag</small></td></tr><tr><td>theta_cl_f_albumin</td><td>-1.350</td><td></td><td><small>equation variable</small></td></tr><tr><td>theta_cl_f_crcl</td><td>0.168</td><td></td><td><small>equation variable</small></td></tr><tr><td>theta_cl_f_ethnicity</td><td>0.226</td><td></td><td><small>equation variable</small></td></tr><tr><td>theta_cl_f_race</td><td>0.186</td><td></td><td><small>equation variable</small></td></tr><tr><td>theta_cl_f_sex</td><td>0.100</td><td></td><td><small>equation variable</small></td></tr><tr><td>theta_q319_bodyweight</td><td>0.662</td><td></td><td><small>equation variable</small></td></tr><tr><td>theta_v_f_albumin</td><td>-0.535</td><td></td><td><small>equation variable</small></td></tr><tr><td>theta_v_f_bodyweight</td><td>0.802</td><td></td><td><small>equation variable</small></td></tr></table><h4>About nemolizumab</h4><p>Nemolizumab is a monoclonal antibody used to treat atopic dermatitis and prurigo. It is authorised in the European Union and is also being investigated for further uses.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Nemolizumab\">Nemolizumab</a>.</p><h4>References</h4><ol><li><p>Fauchet F et al. (2026). Model-informed drug development to support nemolizumab clinical development in adults and adolescents with moderate to severe atopic dermatitis. <i>British journal of clinical pharmacology 92(6):1744–1759</i>. DOI:<a href=\"https://doi.org/10.1002/bcp.70435\">10.1002/bcp.70435</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/41539329\">41539329</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Fauchet_2026: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: accepted with caveats</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 9676800, Tolerance = 1e-9, Interval = 1));
end Nemolizumab_Fauchet2026_reference;
