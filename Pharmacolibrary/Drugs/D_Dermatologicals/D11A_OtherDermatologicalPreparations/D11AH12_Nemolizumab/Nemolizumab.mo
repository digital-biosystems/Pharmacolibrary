  extends Nemolizumab_Fauchet2026_reference;
  annotation (Documentation(info = "<html><body><p>The default model of nemolizumab: <a href=\"modelica://Pharmacolibrary.Drugs.D_Dermatologicals.D11A_OtherDermatologicalPreparations.D11AH12_Nemolizumab.Nemolizumab_Fauchet2026_reference\">Nemolizumab_Fauchet2026_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of nemolizumab in this package:</p><ul><li><code>Nemolizumab_Fauchet2026_reference</code></li></ul><h4>About nemolizumab</h4><p>Nemolizumab is a monoclonal antibody used to treat atopic dermatitis and prurigo. It is authorised in the European Union and is also being investigated for further uses.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Nemolizumab\">Nemolizumab</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 9676800, Tolerance = 1e-9, Interval = 1));
end Nemolizumab;
