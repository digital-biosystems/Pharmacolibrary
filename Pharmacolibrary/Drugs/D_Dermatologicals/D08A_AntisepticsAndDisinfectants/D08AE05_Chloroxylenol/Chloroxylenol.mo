within Pharmacolibrary.Drugs.D_Dermatologicals.D08A_AntisepticsAndDisinfectants.D08AE05_Chloroxylenol;
model Chloroxylenol "Chloroxylenol — default model: Chloroxylenol_Dorantes1992_reference"
  extends Chloroxylenol_Dorantes1992_reference;
  annotation (Documentation(info = "<html><body><p>The default model of chloroxylenol: <a href=\"modelica://Pharmacolibrary.Drugs.D_Dermatologicals.D08A_AntisepticsAndDisinfectants.D08AE05_Chloroxylenol.Chloroxylenol_Dorantes1992_reference\">Chloroxylenol_Dorantes1992_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of chloroxylenol in this package:</p><ul><li><code>Chloroxylenol_Dorantes1992_reference</code></li></ul><h4>About chloroxylenol</h4><p>Chloroxylenol is an antiseptic and disinfectant used to treat or prevent local skin infections. It is widely used, including in household antiseptic products, and is included on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q426460\">Wikidata Q426460</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Chloroxylenol\">Chloroxylenol</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Chloroxylenol;
