within Pharmacolibrary.Drugs.P_AntiparasiticProductsInsecticidesAndRepellents.P01B_Antimalarials.P01BC01_Quinine;
model Quinine "Quinine — default model: Quinine_Hendriksen2013_reference"
  extends Quinine_Hendriksen2013_reference;
  annotation (Documentation(info = "<html><body><p>The default model of quinine: <a href=\"modelica://Pharmacolibrary.Drugs.P_AntiparasiticProductsInsecticidesAndRepellents.P01B_Antimalarials.P01BC01_Quinine.Quinine_Hendriksen2013_reference\">Quinine_Hendriksen2013_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of quinine in this package:</p><ul><li><code>Quinine_Hendriksen2013_reference</code></li><li><code>Quinine_Phillips1986_reference</code></li></ul><h4>About quinine</h4><p>Quinine is an antimalarial drug used to treat malaria, including falciparum malaria, and has also been used for babesiosis and muscle cramps. It remains an approved medicine, is listed among WHO essential medicines, and is used worldwide mainly for malaria, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q189522\">Wikidata Q189522</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Quinine\">Quinine</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 259200, Tolerance = 1e-9, Interval = 1));
end Quinine;
