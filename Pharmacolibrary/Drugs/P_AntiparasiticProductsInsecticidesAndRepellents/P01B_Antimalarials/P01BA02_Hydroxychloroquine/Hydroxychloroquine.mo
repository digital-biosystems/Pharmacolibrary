within Pharmacolibrary.Drugs.P_AntiparasiticProductsInsecticidesAndRepellents.P01B_Antimalarials.P01BA02_Hydroxychloroquine;
model Hydroxychloroquine "Hydroxychloroquine — default model: Hydroxychloroquine_Thmans2020_reference"
  extends Hydroxychloroquine_Thmans2020_reference;
  annotation (Documentation(info = "<html><body><p>The default model of hydroxychloroquine: <a href=\"modelica://Pharmacolibrary.Drugs.P_AntiparasiticProductsInsecticidesAndRepellents.P01B_Antimalarials.P01BA02_Hydroxychloroquine.Hydroxychloroquine_Thmans2020_reference\">Hydroxychloroquine_Thmans2020_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of hydroxychloroquine in this package:</p><ul><li><code>Hydroxychloroquine_Thmans2020_reference</code></li></ul><h4>About hydroxychloroquine</h4><p>Hydroxychloroquine is used to treat and prevent malaria and to manage autoimmune conditions such as systemic lupus erythematosus, rheumatoid arthritis, Sjögren's syndrome, and certain skin diseases. It is widely used and is included on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q421094\">Wikidata Q421094</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Hydroxychloroquine\">Hydroxychloroquine</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 777600, Tolerance = 1e-9, Interval = 1));
end Hydroxychloroquine;
