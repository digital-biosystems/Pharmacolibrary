  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>hydroxychloroquine</td></tr><tr><td>ATC code:</td><td>P01BA02</td></tr><tr><td>model:</td><td>one compartment, oral dosing <small>(PK_1C_enteral)</small></td></tr><tr><td>source:</td><td>Balevic SJ et al. 2019</td></tr><tr><td>population:</td><td>pregnant women with rheumatic disease</td></tr><tr><td>measured compound:</td><td>hydroxychloroquine</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_hydroxychloroquine/Hydroxychloroquine_Balevic2019_prenatal\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>75%</td><td>5236.5</td><td></td><td><small>AUC%ext</small></td></tr><tr><td>Mean</td><td>4753.7</td><td></td><td><small>equation variable</small></td></tr><tr><td>V/F (model B)</td><td>2000</td><td>L/70 kg</td><td><small>V/F</small></td></tr><tr><td>CL/F (model B)</td><td>47</td><td>L/hr</td><td><small>CL/F</small></td></tr><tr><td>KA (fixed)</td><td>1.15</td><td>1/h</td><td><small>kabs</small></td></tr><tr><td>Lag (fixed)</td><td>0.389</td><td>h</td><td><small>tlag</small></td></tr></table><h4>About hydroxychloroquine</h4><p>Hydroxychloroquine is used to treat and prevent malaria and to manage autoimmune conditions such as systemic lupus erythematosus, rheumatoid arthritis, Sjögren's syndrome, and certain skin diseases. It is widely used and is included on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q421094\">Wikidata Q421094</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Hydroxychloroquine\">Hydroxychloroquine</a>.</p><h4>References</h4><ol><li><p>Balevic SJ et al. (2019). Pharmacokinetics of Hydroxychloroquine in Pregnancies with Rheumatic Diseases. <i>Clinical pharmacokinetics 58(4):525–533</i>. DOI:<a href=\"https://doi.org/10.1007/s40262-018-0712-z\">10.1007/s40262-018-0712-z</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/30255310\">30255310</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Balevic_2019: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
