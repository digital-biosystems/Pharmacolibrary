within Pharmacolibrary.Drugs.P_AntiparasiticProductsInsecticidesAndRepellents.P01B_Antimalarials.P01BF09_ArtesunateSulfadoxineAnd;
model ArtesunateSulfadoxineAnd "ArtesunateSulfadoxineAnd — default model: Sulfadoxine_Trenque2004_reference"
  extends Sulfadoxine_Trenque2004_reference;
  annotation (Documentation(info = "<html><body><p>The default model of Sulfadoxine: <a href=\"modelica://Pharmacolibrary.Drugs.P_AntiparasiticProductsInsecticidesAndRepellents.P01B_Antimalarials.P01BF09_ArtesunateSulfadoxineAnd.Sulfadoxine_Trenque2004_reference\">Sulfadoxine_Trenque2004_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of Sulfadoxine in this package:</p><ul><li><code>Sulfadoxine_Trenque2004_reference</code></li></ul><h4>About Sulfadoxine</h4><p>Sulfadoxine is a sulfonamide antibiotic used as an antimalarial against Plasmodium falciparum malaria and also to treat pneumocystosis. It is used in combination with artemisinin derivatives for malaria, though some products have been withdrawn in certain markets.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q411557\">Wikidata Q411557</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Sulfadoxine\">Sulfadoxine</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 2419200, Tolerance = 1e-9, Interval = 1));
end ArtesunateSulfadoxineAnd;
