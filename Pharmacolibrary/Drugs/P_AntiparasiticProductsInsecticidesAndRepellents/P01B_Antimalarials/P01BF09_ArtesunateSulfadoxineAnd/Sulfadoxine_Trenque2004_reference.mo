  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>sulfadoxine</td></tr><tr><td>ATC code:</td><td>P01BF09</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Trenque T et al. 2004</td></tr><tr><td>population:</td><td>children with congenital toxoplasmosis</td></tr><tr><td>measured compound:</td><td>sulfadoxine</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_sulfadoxine/Sulfadoxine_Trenque2004_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>CL (PYR)</td><td>5.5</td><td>l day(-1)</td><td><small>CL</small></td></tr><tr><td>V (PYR)</td><td>36</td><td>l</td><td><small>V</small></td></tr></table><h4>About sulfadoxine</h4><p>Sulfadoxine is a sulfonamide antibiotic used as an antimalarial against Plasmodium falciparum malaria and also to treat pneumocystosis. It is used in combination with artemisinin derivatives for malaria, though some products have been withdrawn in certain markets.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q411557\">Wikidata Q411557</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Sulfadoxine\">Sulfadoxine</a>.</p><h4>References</h4><ol><li><p>Trenque T et al. (2004). Population pharmacokinetics of pyrimethamine and sulfadoxine in children with congenital toxoplasmosis. <i>British journal of clinical pharmacology 57(6):735–741</i>. DOI:<a href=\"https://doi.org/10.1111/j.1365-2125.2004.02077.x\">10.1111/j.1365-2125.2004.02077.x</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/15151519\">15151519</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Trenque_2004: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
