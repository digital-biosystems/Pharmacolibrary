within Pharmacolibrary.Drugs.P_AntiparasiticProductsInsecticidesAndRepellents.P02C_AntinematodalAgents.P02CF01_Ivermectin;
model Ivermectin_Alshehri2023_reference
  parameter Real Cl_ref = 1.95e-06 "Cl [m3/s]";
  parameter Real cov_sex_0 = 0 "sex covariate";
  parameter Real Vd_ref = 0.138 "Vd [m3]";
  extends Pharmacolibrary.Pharmacokinetic.Models.PK_2C_enteral(
    weight = 70.0,
    F = 1,
    Cl = Cl_ref*(1 + (-0.74)*cov_sex_0),
    Vd = Vd_ref,
    adminDuration = 600,
    adminCount = 1,
    MM = Pharmacolibrary.Drugs.Substances.Ivermectin.M,
    adminMass = 1.4e-05,
    ka = 0.00019722222222222222,
    Tlag = 2700.0,
    k12 = 1.8337359098228662e-05,
    k21 = 5.963649884654763e-06
  );

  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>ivermectin</td></tr><tr><td>ATC code:</td><td>P02CF01</td></tr><tr><td>model:</td><td>two compartments, oral dosing <small>(PK_2C_enteral)</small></td></tr><tr><td>source:</td><td>Alshehri A et al. 2023</td></tr><tr><td>population:</td><td>Wuchereria bancrofti-infected and uninfected adults in Côte d’Ivoire</td></tr><tr><td>measured compound:</td><td>ivermectin</td></tr><tr><td>review:</td><td>accepted with caveats</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_ivermectin/Ivermectin_Alshehri2023_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>CL/F (L/h)</td><td>7.02</td><td>L/h</td><td><small>CL/F</small></td></tr><tr><td>Q/F (L/h)</td><td>9.11</td><td>L/h</td><td><small>Q/F</small></td></tr><tr><td>Vc/F (L)</td><td>138</td><td>L</td><td><small>V1/F</small></td></tr><tr><td>Vp /F(L)</td><td>424.33</td><td>L</td><td><small>V2/F</small></td></tr><tr><td>Tlag (h)</td><td>0.75</td><td>h</td><td><small>tlag</small></td></tr><tr><td>Ka (1/h)</td><td>0.71</td><td>1/h</td><td><small>kabs</small></td></tr><tr><td>sex_male_on_vp_f</td><td>-0.74</td><td></td><td><small>equation variable</small></td></tr></table><h4>About ivermectin</h4><p>Ivermectin is an antiparasitic medicine used against infections such as scabies, lice infestation, onchocerciasis, strongyloidiasis, ascariasis, filariasis and rosacea. It is widely used in humans and also approved for veterinary use, and is included on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q415178\">Wikidata Q415178</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Ivermectin\">Ivermectin</a>.</p><h4>References</h4><ol><li><p>Alshehri A et al. (2023). Population pharmacokinetic model of ivermectin in mass drug administration against lymphatic filariasis. <i>PLoS neglected tropical diseases 17(6):e0011319</i>. DOI:<a href=\"https://doi.org/10.1371/journal.pntd.0011319\">10.1371/journal.pntd.0011319</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/37262040\">37262040</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Alshehri_2023: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: accepted with caveats</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 345600, Tolerance = 1e-9, Interval = 1));
end Ivermectin_Alshehri2023_reference;
