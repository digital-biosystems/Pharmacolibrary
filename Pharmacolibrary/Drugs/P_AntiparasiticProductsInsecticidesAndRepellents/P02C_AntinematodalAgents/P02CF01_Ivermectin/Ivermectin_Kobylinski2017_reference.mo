  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>ivermectin</td></tr><tr><td>ATC code:</td><td>P02CF01</td></tr><tr><td>model:</td><td>two compartments, oral dosing <small>(PK_2C_enteral)</small></td></tr><tr><td>source:</td><td>Kobylinski KC et al. 2017</td></tr><tr><td>population:</td><td>healthy Thai volunteers</td></tr><tr><td>measured compound:</td><td>ivermectin</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_ivermectin/Ivermectin_Kobylinski2017_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>F</td><td>1</td><td></td><td><small>Fab</small></td></tr><tr><td>ka (h−1)</td><td>0.317</td><td>h−1</td><td><small>kabs</small></td></tr><tr><td>MTT (h)</td><td>0.496</td><td>h</td><td><small>MTT</small></td></tr><tr><td>CL/F (l/h)</td><td>9.02</td><td>l/h</td><td><small>CL/F</small></td></tr><tr><td>VC/F (l)</td><td>115</td><td>l</td><td><small>V1/F</small></td></tr><tr><td>Q/F (l/h)</td><td>16.2</td><td>l/h</td><td><small>Q/F</small></td></tr><tr><td>VP/F (l)</td><td>157</td><td>l</td><td><small>V2/F</small></td></tr></table><h4>About ivermectin</h4><p>Ivermectin is an antiparasitic medicine used against infections such as scabies, lice infestation, onchocerciasis, strongyloidiasis, ascariasis, filariasis and rosacea. It is widely used in humans and also approved for veterinary use, and is included on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q415178\">Wikidata Q415178</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Ivermectin\">Ivermectin</a>.</p><h4>References</h4><ol><li><p>Kobylinski KC et al. (2017). Ivermectin susceptibility and sporontocidal effect in Greater Mekong Subregion Anopheles. <i>Malaria journal 16(1):280</i>. DOI:<a href=\"https://doi.org/10.1186/s12936-017-1923-8\">10.1186/s12936-017-1923-8</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/28687086\">28687086</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Kobylinski_2017: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
