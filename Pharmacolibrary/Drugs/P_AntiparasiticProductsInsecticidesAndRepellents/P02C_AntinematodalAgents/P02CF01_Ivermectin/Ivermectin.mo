within Pharmacolibrary.Drugs.P_AntiparasiticProductsInsecticidesAndRepellents.P02C_AntinematodalAgents.P02CF01_Ivermectin;
model Ivermectin "Ivermectin — default model: Ivermectin_Kobylinski2017_reference"
  extends Ivermectin_Kobylinski2017_reference;
  annotation (Documentation(info = "<html><body><p>The default model of ivermectin: <a href=\"modelica://Pharmacolibrary.Drugs.P_AntiparasiticProductsInsecticidesAndRepellents.P02C_AntinematodalAgents.P02CF01_Ivermectin.Ivermectin_Kobylinski2017_reference\">Ivermectin_Kobylinski2017_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of ivermectin in this package:</p><ul><li><code>Ivermectin_Alshehri2023_reference</code></li><li><code>Ivermectin_Kobylinski2017_reference</code></li></ul><h4>About ivermectin</h4><p>Ivermectin is an antiparasitic medicine used against infections such as scabies, lice infestation, onchocerciasis, strongyloidiasis, ascariasis, filariasis and rosacea. It is widely used in humans and also approved for veterinary use, and is included on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q415178\">Wikidata Q415178</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Ivermectin\">Ivermectin</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 259200, Tolerance = 1e-9, Interval = 1));
end Ivermectin;
