within Pharmacolibrary.Drugs.P_AntiparasiticProductsInsecticidesAndRepellents.P01C_AgentsAgainstLeishmaniasisAndTrypanosomiasis.P01CD01_Melarsoprol;
model Melarsoprol "Melarsoprol — default model: Melarsoprol_Burri1994_reference"
  extends Melarsoprol_Burri1994_reference;
  annotation (Documentation(info = "<html><body><p>The default model of melarsoprol: <a href=\"modelica://Pharmacolibrary.Drugs.P_AntiparasiticProductsInsecticidesAndRepellents.P01C_AgentsAgainstLeishmaniasisAndTrypanosomiasis.P01CD01_Melarsoprol.Melarsoprol_Burri1994_reference\">Melarsoprol_Burri1994_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of melarsoprol in this package:</p><ul><li><code>Melarsoprol_Burri1994_reference</code></li></ul><h4>About melarsoprol</h4><p>Melarsoprol is an arsenic-based antiparasitic drug used to treat sleeping sickness (African trypanosomiasis). It has been listed among WHO essential medicines as a trypanocidal agent, but DrugBank currently classifies it as investigational, so its availability today appears limited.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q419753\">Wikidata Q419753</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Melarsoprol\">Melarsoprol</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 259200, Tolerance = 1e-9, Interval = 1));
end Melarsoprol;
