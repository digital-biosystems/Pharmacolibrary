  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>miltefosine</td></tr><tr><td>ATC code:</td><td>P01CX04</td></tr><tr><td>model:</td><td>two compartments, oral dosing <small>(PK_2C_enteral)</small></td></tr><tr><td>source:</td><td>Palić S et al. 2020</td></tr><tr><td>population:</td><td>paediatric visceral leishmaniasis patients from Eastern Africa</td></tr><tr><td>measured compound:</td><td>miltefosine</td></tr><tr><td>review:</td><td>accepted with caveats</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_miltefosine/Miltefosine_Pali2020_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>CL/F (L/day)</td><td>2.44</td><td>L/day</td><td><small>CL/F</small></td></tr><tr><td>Vc/F (L)</td><td>22.9</td><td>L</td><td><small>V1/F</small></td></tr><tr><td>ka (day−1)</td><td>1.61</td><td>day−1</td><td><small>kabs</small></td></tr><tr><td>Q/F (L/day)</td><td>0.0233</td><td>L/day</td><td><small>Q/F</small></td></tr><tr><td>Vp/F (L)</td><td>2.27</td><td>L</td><td><small>V2/F</small></td></tr><tr><td>F</td><td>1</td><td></td><td><small>Fab</small></td></tr><tr><td>relative decrease F first week</td><td>-0.69</td><td></td><td><small>Frel</small></td></tr><tr><td>theta_q319_weight_power</td><td>-1.72</td><td></td><td><small>equation variable</small></td></tr></table><h4>About miltefosine</h4><p>Miltefosine is a phospholipid drug used as an antiprotozoal agent against leishmaniasis and trypanosomiasis, and it also has antifungal, antibacterial and anticancer activity. It is an approved medicine, included on the WHO essential medicines list, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q411787\">Wikidata Q411787</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Miltefosine\">Miltefosine</a>.</p><h4>References</h4><ol><li><p>Palić S et al. (2020). Characterizing the non-linear pharmacokinetics of miltefosine in paediatric visceral leishmaniasis patients from Eastern Africa. <i>The Journal of antimicrobial chemotherapy 75(11):3260–3268</i>. DOI:<a href=\"https://doi.org/10.1093/jac/dkaa314\">10.1093/jac/dkaa314</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/32780098\">32780098</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Palić_2020: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: accepted with caveats</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 3024000, Tolerance = 1e-9, Interval = 1));
end Miltefosine_Pali2020_reference;
