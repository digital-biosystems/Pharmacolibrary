within Pharmacolibrary.Drugs.P_AntiparasiticProductsInsecticidesAndRepellents.P01C_AgentsAgainstLeishmaniasisAndTrypanosomiasis.P01CA02_Benznidazole;
model Benznidazole "Benznidazole — default model: Benznidazole_Soy2015_reference"
  extends Benznidazole_Soy2015_reference;
  annotation (Documentation(info = "<html><body><p>The default model of benznidazole: <a href=\"modelica://Pharmacolibrary.Drugs.P_AntiparasiticProductsInsecticidesAndRepellents.P01C_AgentsAgainstLeishmaniasisAndTrypanosomiasis.P01CA02_Benznidazole.Benznidazole_Soy2015_reference\">Benznidazole_Soy2015_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of benznidazole in this package:</p><ul><li><code>Benznidazole_Soy2015_reference</code></li></ul><h4>About benznidazole</h4><p>Benznidazole is an antiparasitic medicine used to treat trypanosomiasis (Chagas disease). It is on the WHO list of essential medicines and is used mainly in regions where Chagas disease occurs.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q425300\">Wikidata Q425300</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Benznidazole\">Benznidazole</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 691200, Tolerance = 1e-9, Interval = 1));
end Benznidazole;
