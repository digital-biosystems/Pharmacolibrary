  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>suramin</td></tr><tr><td>ATC code:</td><td>P01CX02</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Naviaux RK et al. 2017</td></tr><tr><td>population:</td><td>children with autism spectrum disorder</td></tr><tr><td>measured compound:</td><td>suramin</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_suramin/Suramin_Naviaux2017_language\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>steady‐state volume of distribution</td><td>0.83</td><td>L/kg</td><td><small>V</small></td></tr><tr><td>clearance</td><td>1.95</td><td>mL/h/kg</td><td><small>CL</small></td></tr></table><h4>About suramin</h4><p>Suramin is an antiprotozoal drug developed against trypanosomiasis and related parasitic infections. It is currently classed as investigational and is not an approved medicine in the European Union.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Suramin\">Suramin</a>.</p><h4>References</h4><ol><li><p>Naviaux RK et al. (2017). Low-dose suramin in autism spectrum disorder: a small, phase I/II, randomized clinical trial. <i>Annals of clinical and translational neurology 4(7):491-505</i>. DOI:<a href=\"https://doi.org/10.1002/acn3.424\">10.1002/acn3.424</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/28695149\">28695149</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Naviaux_2017: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 5443200, Tolerance = 1e-9, Interval = 1));
