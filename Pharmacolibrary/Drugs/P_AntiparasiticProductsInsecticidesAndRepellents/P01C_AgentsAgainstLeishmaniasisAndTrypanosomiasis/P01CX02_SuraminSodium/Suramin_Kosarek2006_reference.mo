  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>suramin</td></tr><tr><td>ATC code:</td><td>P01CX02</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Kosarek CE et al. 2006</td></tr><tr><td>population:</td><td>dogs with naturally occurring cancers</td></tr><tr><td>measured compound:</td><td>suramin</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_suramin/Suramin_Kosarek2006_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>distribution volume</td><td>0.34</td><td>L/kg</td><td><small>V</small></td></tr><tr><td>clearance</td><td>1.86</td><td>mL/kg/h</td><td><small>CL</small></td></tr></table><h4>About suramin</h4><p>Suramin is an antiprotozoal drug developed against trypanosomiasis and related parasitic infections. It is currently classed as investigational and is not an approved medicine in the European Union.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Suramin\">Suramin</a>.</p><h4>References</h4><ol><li><p>Kosarek CE et al. (2006). Phase I evaluation of low-dose suramin as chemosensitizer of doxorubicin in dogs with naturally occurring cancers. <i>Journal of veterinary internal medicine 20(5):1172–1177</i>. DOI:<a href=\"https://doi.org/10.1892/0891-6640(2006)20[1172:pieols]2.0.co;2\">10.1892/0891-6640(2006)20[1172:pieols]2.0.co;2</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/17063712\">17063712</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Kosarek_2006: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
