within Pharmacolibrary.Drugs.P_AntiparasiticProductsInsecticidesAndRepellents.P01C_AgentsAgainstLeishmaniasisAndTrypanosomiasis.P01CX02_SuraminSodium;
model SuraminSodium "SuraminSodium — default model: Suramin_Kosarek2006_reference"
  extends Suramin_Kosarek2006_reference;
  annotation (Documentation(info = "<html><body><p>The default model of Suramin: <a href=\"modelica://Pharmacolibrary.Drugs.P_AntiparasiticProductsInsecticidesAndRepellents.P01C_AgentsAgainstLeishmaniasisAndTrypanosomiasis.P01CX02_SuraminSodium.Suramin_Kosarek2006_reference\">Suramin_Kosarek2006_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of Suramin in this package:</p><ul><li><code>Suramin_Kosarek2006_reference</code></li><li><code>Suramin_Naviaux2017_abc</code></li><li><code>Suramin_Naviaux2017_ados_2</code></li><li><code>Suramin_Naviaux2017_atec</code></li><li><code>Suramin_Naviaux2017_cgi</code></li><li><code>Suramin_Naviaux2017_e_language</code></li><li><code>Suramin_Naviaux2017_eowpvt</code></li><li><code>Suramin_Naviaux2017_language</code></li><li><code>Suramin_Naviaux2017_rbq</code></li><li><code>Suramin_Naviaux2017_restr_rep</code></li><li><code>Suramin_Naviaux2017_sociability</code></li><li><code>Suramin_Naviaux2017_social</code></li><li><code>Suramin_Naviaux2017_social_inter</code></li><li><code>Suramin_Naviaux2017_stereotypy</code></li></ul><h4>About Suramin</h4><p>Suramin is an antiprotozoal drug developed against trypanosomiasis and related parasitic infections. It is currently classed as investigational and is not an approved medicine in the European Union.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Suramin\">Suramin</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 2419200, Tolerance = 1e-9, Interval = 1));
end SuraminSodium;
