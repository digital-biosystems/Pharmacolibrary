within Pharmacolibrary.Drugs.C_CardiovascularSystem.C10A_LipidModifyingAgentsPlain.C10AA07_Rosuvastatin;
model Rosuvastatin_Macpherson2016_final_final_model
  parameter Real Cl_ref = 3.5833333333333335e-05 "Cl [m3/s]";
  parameter Real cov_weight = 42.0 "weight covariate (reference 42.0)";
  parameter Real Vd_ref = 0.303 "Vd [m3]";
  extends Pharmacolibrary.Pharmacokinetic.Models.PK_2C_enteral(
