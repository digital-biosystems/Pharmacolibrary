within Pharmacolibrary.Drugs.C_CardiovascularSystem.C02K_OtherAntihypertensives.C02KX02_Ambrisentan;
model Ambrisentan "Ambrisentan — default model: Ambrisentan_Hill2020_reference"
  extends Ambrisentan_Hill2020_reference;
  annotation (Documentation(info = "<html><body><p>The default model of ambrisentan: <a href=\"modelica://Pharmacolibrary.Drugs.C_CardiovascularSystem.C02K_OtherAntihypertensives.C02KX02_Ambrisentan.Ambrisentan_Hill2020_reference\">Ambrisentan_Hill2020_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of ambrisentan in this package:</p><ul><li><code>Ambrisentan_Hill2020_reference</code></li><li><code>Ambrisentan_Okour2023_reference</code></li></ul><h4>About ambrisentan</h4><p>Ambrisentan is an antihypertensive drug used to treat pulmonary arterial hypertension. It is authorised in the European Union and is also used for related conditions such as portal and chronic pulmonary hypertension.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q410789\">Wikidata Q410789</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Ambrisentan\">Ambrisentan</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 172800, Tolerance = 1e-9, Interval = 1));
end Ambrisentan;
