within Pharmacolibrary.Drugs.C_CardiovascularSystem.C01C_CardiacStimulantsExclCardiacGlycosides.C01CA07_Dobutamine;
model Dobutamine "Dobutamine — default model: Dobutamine_Hallik2020_reference"
  extends Dobutamine_Hallik2020_reference;
  annotation (Documentation(info = "<html><body><p>The default model of dobutamine: <a href=\"modelica://Pharmacolibrary.Drugs.C_CardiovascularSystem.C01C_CardiacStimulantsExclCardiacGlycosides.C01CA07_Dobutamine.Dobutamine_Hallik2020_reference\">Dobutamine_Hallik2020_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of dobutamine in this package:</p><ul><li><code>Dobutamine_Hallik2020_reference</code></li></ul><h4>About dobutamine</h4><p>Dobutamine is a cardiotonic sympathomimetic drug used to treat heart disease. It is an approved medication given as a cardiac stimulant, typically in hospital settings for acute heart conditions.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q422782\">Wikidata Q422782</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Dobutamine\">Dobutamine</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Dobutamine;
