within Pharmacolibrary.Drugs.C_CardiovascularSystem.C01C_CardiacStimulantsExclCardiacGlycosides.C01CX08_Levosimendan;
model Levosimendan "Levosimendan — default model: Levosimendan_Jonsson2003_reference"
  extends Levosimendan_Jonsson2003_reference;
  annotation (Documentation(info = "<html><body><p>The default model of levosimendan: <a href=\"modelica://Pharmacolibrary.Drugs.C_CardiovascularSystem.C01C_CardiacStimulantsExclCardiacGlycosides.C01CX08_Levosimendan.Levosimendan_Jonsson2003_reference\">Levosimendan_Jonsson2003_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of levosimendan in this package:</p><ul><li><code>Levosimendan_Jonsson2003_reference</code></li></ul><h4>About levosimendan</h4><p>Levosimendan is a calcium sensitiser used to treat acutely decompensated congestive heart failure. It is an approved cardiac stimulant, though its use appears limited and it has also been investigated and withdrawn in some settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q162541\">Wikidata Q162541</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Levosimendan\">Levosimendan</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Levosimendan;
