  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>milrinone</td></tr><tr><td>ATC code:</td><td>C01CE02</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>O'Hanlon CJ et al. 2024</td></tr><tr><td>population:</td><td>paediatric patients (premature neonates to adolescents) after cardiac surgery</td></tr><tr><td>measured compound:</td><td>milrinone</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_milrinone/Milrinone_OHanlon2024_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>CL</td><td>17.8</td><td>L/h/70 kg</td><td><small>CL</small></td></tr><tr><td>V</td><td>20.4</td><td>L/70 kg</td><td><small>V</small></td></tr></table><h4>About milrinone</h4><p>Milrinone is a phosphodiesterase inhibitor used as a cardiotonic and vasodilator for congestive heart failure. It is an approved drug, used mainly in hospital settings for acute cardiac support.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q847399\">Wikidata Q847399</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Milrinone\">Milrinone</a>.</p><h4>References</h4><ol><li><p>O'Hanlon CJ et al. (2024). Time-Varying Clearance in Milrinone Pharmacokinetics from Premature Neonates to Adolescents. <i>Clinical pharmacokinetics 63(5):695–706</i>. DOI:<a href=\"https://doi.org/10.1007/s40262-024-01372-5\">10.1007/s40262-024-01372-5</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/38613610\">38613610</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from OHanlon_2024: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
