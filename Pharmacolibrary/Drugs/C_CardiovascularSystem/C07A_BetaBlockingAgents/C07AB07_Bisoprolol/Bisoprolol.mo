within Pharmacolibrary.Drugs.C_CardiovascularSystem.C07A_BetaBlockingAgents.C07AB07_Bisoprolol;
model Bisoprolol "Bisoprolol — default model: Bisoprolol_Cvan2016_reference"
  extends Bisoprolol_Cvan2016_reference;
  annotation (Documentation(info = "<html><body><p>The default model of bisoprolol: <a href=\"modelica://Pharmacolibrary.Drugs.C_CardiovascularSystem.C07A_BetaBlockingAgents.C07AB07_Bisoprolol.Bisoprolol_Cvan2016_reference\">Bisoprolol_Cvan2016_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of bisoprolol in this package:</p><ul><li><code>Bisoprolol_Cvan2016_reference</code></li></ul><h4>About bisoprolol</h4><p>Bisoprolol is a selective beta blocker used for conditions such as high blood pressure, angina, heart failure, and after a heart attack. It is widely used and appears on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q412515\">Wikidata Q412515</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Bisoprolol\">Bisoprolol</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Bisoprolol;
