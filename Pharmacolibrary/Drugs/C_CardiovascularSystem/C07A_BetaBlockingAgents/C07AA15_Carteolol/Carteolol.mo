within Pharmacolibrary.Drugs.C_CardiovascularSystem.C07A_BetaBlockingAgents.C07AA15_Carteolol;
model Carteolol "Carteolol — default model: Carteolol_Ishizaki1983_reference"
  extends Carteolol_Ishizaki1983_reference;
  annotation (Documentation(info = "<html><body><p>The default model of carteolol: <a href=\"modelica://Pharmacolibrary.Drugs.C_CardiovascularSystem.C07A_BetaBlockingAgents.C07AA15_Carteolol.Carteolol_Ishizaki1983_reference\">Carteolol_Ishizaki1983_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of carteolol in this package:</p><ul><li><code>Carteolol_Ishizaki1983_reference</code></li></ul><h4>About carteolol</h4><p>Carteolol is a non-selective beta blocker used to treat arterial hypertension and to lower pressure in the eye in open-angle glaucoma and ocular hypertension. It is an approved medicine, available both as a cardiovascular beta blocker and as an eye drop for glaucoma.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q546434\">Wikidata Q546434</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Carteolol\">Carteolol</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Carteolol;
