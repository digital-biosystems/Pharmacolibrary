within Pharmacolibrary.Drugs.C_CardiovascularSystem.C07A_BetaBlockingAgents.C07AB11_SAtenolol;
model SAtenolol "SAtenolol — default model: SAtenolol_Buck1989_reference"
  extends SAtenolol_Buck1989_reference;
  annotation (Documentation(info = "<html><body><p>The default model of s-atenolol: <a href=\"modelica://Pharmacolibrary.Drugs.C_CardiovascularSystem.C07A_BetaBlockingAgents.C07AB11_SAtenolol.SAtenolol_Buck1989_reference\">SAtenolol_Buck1989_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of s-atenolol in this package:</p><ul><li><code>SAtenolol_Buck1989_reference</code></li></ul><h4>About s-atenolol</h4><p>Esatenolol, the S-enantiomer of atenolol, is a selective beta blocker studied for treating myocardial infarction and arterial hypertension. It remains an experimental compound and is not an established marketed medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q24255323\">Wikidata Q24255323</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.SAtenolol\">SAtenolol</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end SAtenolol;
