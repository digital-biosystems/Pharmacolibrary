within Pharmacolibrary.Drugs.C_CardiovascularSystem.C07A_BetaBlockingAgents.C07AA07_Sotalol;
model Sotalol "Sotalol — default model: Sotalol_Yellepeddi2025_reference"
  extends Sotalol_Yellepeddi2025_reference;
  annotation (Documentation(info = "<html><body><p>The default model of sotalol: <a href=\"modelica://Pharmacolibrary.Drugs.C_CardiovascularSystem.C07A_BetaBlockingAgents.C07AA07_Sotalol.Sotalol_Yellepeddi2025_reference\">Sotalol_Yellepeddi2025_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of sotalol in this package:</p><ul><li><code>Sotalol_Yellepeddi2025_reference</code></li></ul><h4>About sotalol</h4><p>Sotalol is a non-selective beta blocker with additional antiarrhythmic activity, used to treat heart rhythm problems such as atrial fibrillation, ventricular fibrillation, and supraventricular tachycardia. It is an approved medicine that remains in use, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q413591\">Wikidata Q413591</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Sotalol\">Sotalol</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 104400, Tolerance = 1e-9, Interval = 1));
end Sotalol;
