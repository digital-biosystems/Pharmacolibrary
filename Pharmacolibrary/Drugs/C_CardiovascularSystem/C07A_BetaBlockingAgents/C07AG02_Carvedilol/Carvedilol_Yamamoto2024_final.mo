  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>carvedilol</td></tr><tr><td>ATC code:</td><td>C07AG02</td></tr><tr><td>model:</td><td>two compartments, oral dosing <small>(PK_2C_enteral)</small></td></tr><tr><td>source:</td><td>Yamamoto PA et al. 2024</td></tr><tr><td>population:</td><td>nonobese, obese, and post-RYGB patients</td></tr><tr><td>measured compound:</td><td>(S)-carvedilol</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_carvedilol/Carvedilol_Yamamoto2024_final\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>ka1pop</td><td>0.095</td><td>1/h</td><td><small>kabs</small></td></tr><tr><td>F1pop</td><td>0.28</td><td></td><td><small>Fab</small></td></tr><tr><td>Clpop</td><td>18.21</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>V1pop</td><td>5.81</td><td>L</td><td><small>V1</small></td></tr><tr><td>Qpop</td><td>1.54</td><td>L/h</td><td><small>Q</small></td></tr><tr><td>V2pop</td><td>23.21</td><td>L</td><td><small>V2</small></td></tr><tr><td>BIO1</td><td>0.17</td><td></td><td><small>Frel</small></td></tr></table><h4>About carvedilol</h4><p>Carvedilol is a beta blocker with additional alpha-blocking activity used to treat high blood pressure, angina, heart failure, and other heart conditions such as after a myocardial infarction. It is an approved medicine and is widely used in cardiovascular care.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q412534\">Wikidata Q412534</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Carvedilol\">Carvedilol</a>.</p><h4>References</h4><ol><li><p>Yamamoto PA et al. (2024). Rerouting cardiovascular management following gastric bypass surgery: Dose optimization of carvedilol using population-based analysis. <i>British journal of clinical pharmacology 90(9):2223–2235</i>. DOI:<a href=\"https://doi.org/10.1111/bcp.16129\">10.1111/bcp.16129</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/38852609\">38852609</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Yamamoto_2024: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
