  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>carvedilol</td></tr><tr><td>ATC code:</td><td>C07AG02</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Nikolic VN et al. 2013</td></tr><tr><td>population:</td><td>adult patients with chronic heart failure</td></tr><tr><td>measured compound:</td><td>carvedilol</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_carvedilol/Carvedilol_Nikolic2013_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>Clearance (L/h)-θ 1</td><td>10</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>Volume of distribution</td><td>832</td><td>L</td><td><small>V</small></td></tr></table><h4>About carvedilol</h4><p>Carvedilol is a beta blocker with additional alpha-blocking activity used to treat high blood pressure, angina, heart failure, and other heart conditions such as after a myocardial infarction. It is an approved medicine and is widely used in cardiovascular care.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q412534\">Wikidata Q412534</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Carvedilol\">Carvedilol</a>.</p><h4>References</h4><ol><li><p>Nikolic VN et al. (2013). Population pharmacokinetics of carvedilol in patients with congestive heart failure. <i>Journal of pharmaceutical sciences 102(8):2851–2858</i>. DOI:<a href=\"https://doi.org/10.1002/jps.23626\">10.1002/jps.23626</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/23728853\">23728853</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Nikolic_2013: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 1123200, Tolerance = 1e-9, Interval = 1));
end Carvedilol_Nikolic2013_reference;
