within Pharmacolibrary.Drugs.C_CardiovascularSystem.C02A_AntiadrenergicAgentsCentrallyActing.C02AC05_Moxonidine;
model Moxonidine "Moxonidine — default model: Moxonidine_Hempel1998_reference"
  extends Moxonidine_Hempel1998_reference;
  annotation (Documentation(info = "<html><body><p>The default model of moxonidine: <a href=\"modelica://Pharmacolibrary.Drugs.C_CardiovascularSystem.C02A_AntiadrenergicAgentsCentrallyActing.C02AC05_Moxonidine.Moxonidine_Hempel1998_reference\">Moxonidine_Hempel1998_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of moxonidine in this package:</p><ul><li><code>Moxonidine_Hempel1998_reference</code></li></ul><h4>About moxonidine</h4><p>Moxonidine is an antihypertensive drug used to treat high blood pressure. It is an approved medicine, used mainly in Europe, and is also available in combination with a diuretic.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q419944\">Wikidata Q419944</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Moxonidine\">Moxonidine</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Moxonidine;
