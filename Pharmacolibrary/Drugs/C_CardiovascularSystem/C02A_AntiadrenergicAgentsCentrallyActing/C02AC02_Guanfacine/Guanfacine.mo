within Pharmacolibrary.Drugs.C_CardiovascularSystem.C02A_AntiadrenergicAgentsCentrallyActing.C02AC02_Guanfacine;
model Guanfacine "Guanfacine — default model: Guanfacine_Knebel2015_reference"
  extends Guanfacine_Knebel2015_reference;
  annotation (Documentation(info = "<html><body><p>The default model of guanfacine: <a href=\"modelica://Pharmacolibrary.Drugs.C_CardiovascularSystem.C02A_AntiadrenergicAgentsCentrallyActing.C02AC02_Guanfacine.Guanfacine_Knebel2015_reference\">Guanfacine_Knebel2015_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of guanfacine in this package:</p><ul><li><code>Guanfacine_Knebel2015_reference</code></li></ul><h4>About guanfacine</h4><p>Guanfacine is used to treat high blood pressure and attention deficit hyperactivity disorder. It is an approved medicine, with products authorised in the European Union for ADHD, and it is also being studied for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5613599\">Wikidata Q5613599</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Guanfacine\">Guanfacine</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 345600, Tolerance = 1e-9, Interval = 1));
end Guanfacine;
