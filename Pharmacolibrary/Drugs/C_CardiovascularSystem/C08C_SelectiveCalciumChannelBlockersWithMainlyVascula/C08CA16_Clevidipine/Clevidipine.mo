within Pharmacolibrary.Drugs.C_CardiovascularSystem.C08C_SelectiveCalciumChannelBlockersWithMainlyVascula.C08CA16_Clevidipine;
model Clevidipine "Clevidipine — default model: Clevidipine_Bailey2002_reference"
  extends Clevidipine_Bailey2002_reference;
  annotation (Documentation(info = "<html><body><p>The default model of clevidipine: <a href=\"modelica://Pharmacolibrary.Drugs.C_CardiovascularSystem.C08C_SelectiveCalciumChannelBlockersWithMainlyVascula.C08CA16_Clevidipine.Clevidipine_Bailey2002_reference\">Clevidipine_Bailey2002_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of clevidipine in this package:</p><ul><li><code>Clevidipine_Bailey2002_reference</code></li><li><code>Clevidipine_Ericsson2001_reference</code></li><li><code>Clevidipine_Vuylsteke2000_reference</code></li></ul><h4>About clevidipine</h4><p>Clevidipine is a dihydropyridine calcium channel blocker used to treat arterial hypertension. It is an approved drug, though it does not appear to be authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5132338\">Wikidata Q5132338</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Clevidipine\">Clevidipine</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Clevidipine;
