within Pharmacolibrary.Drugs.C_CardiovascularSystem.C08C_SelectiveCalciumChannelBlockersWithMainlyVascula.C08CA06_Nimodipine;
model Nimodipine "Nimodipine — default model: Nimodipine_Foucher2025_reference"
  extends Nimodipine_Foucher2025_reference;
  annotation (Documentation(info = "<html><body><p>The default model of nimodipine: <a href=\"modelica://Pharmacolibrary.Drugs.C_CardiovascularSystem.C08C_SelectiveCalciumChannelBlockersWithMainlyVascula.C08CA06_Nimodipine.Nimodipine_Foucher2025_reference\">Nimodipine_Foucher2025_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of nimodipine in this package:</p><ul><li><code>Nimodipine_Foucher2025_reference</code></li></ul><h4>About nimodipine</h4><p>Nimodipine is a calcium channel blocker used to treat subarachnoid hemorrhage. It is an approved drug that remains in use, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q421429\">Wikidata Q421429</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Nimodipine\">Nimodipine</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Nimodipine;
