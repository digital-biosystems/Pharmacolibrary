within Pharmacolibrary.Drugs.C_CardiovascularSystem.C08D_SelectiveCalciumChannelBlockersWithDirectCardiac.C08DB01_Diltiazem;
model Diltiazem "Diltiazem — default model: Diltiazem_Guan2018_reference"
  extends Diltiazem_Guan2018_reference;
  annotation (Documentation(info = "<html><body><p>The default model of diltiazem: <a href=\"modelica://Pharmacolibrary.Drugs.C_CardiovascularSystem.C08D_SelectiveCalciumChannelBlockersWithDirectCardiac.C08DB01_Diltiazem.Diltiazem_Guan2018_reference\">Diltiazem_Guan2018_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of diltiazem in this package:</p><ul><li><code>Diltiazem_Guan2018_reference</code></li><li><code>Diltiazem_Klle1983_reference</code></li></ul><h4>About diltiazem</h4><p>Diltiazem is a calcium channel blocker used to treat high blood pressure, angina, and certain heart rhythm problems such as atrial fibrillation and supraventricular tachycardia. It is an approved medicine and is widely used for these cardiovascular conditions.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q422229\">Wikidata Q422229</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Diltiazem\">Diltiazem</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 518400, Tolerance = 1e-9, Interval = 1));
end Diltiazem;
