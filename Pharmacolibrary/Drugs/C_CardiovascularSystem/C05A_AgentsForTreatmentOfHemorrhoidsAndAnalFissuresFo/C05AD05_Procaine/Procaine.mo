within Pharmacolibrary.Drugs.C_CardiovascularSystem.C05A_AgentsForTreatmentOfHemorrhoidsAndAnalFissuresFo.C05AD05_Procaine;
model Procaine "Procaine — default model: Procaine_Seifen1979_reference"
  extends Procaine_Seifen1979_reference;
  annotation (Documentation(info = "<html><body><p>The default model of procaine: <a href=\"modelica://Pharmacolibrary.Drugs.C_CardiovascularSystem.C05A_AgentsForTreatmentOfHemorrhoidsAndAnalFissuresFo.C05AD05_Procaine.Procaine_Seifen1979_reference\">Procaine_Seifen1979_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of procaine in this package:</p><ul><li><code>Procaine_Seifen1979_reference</code></li></ul><h4>About procaine</h4><p>Procaine is a local anesthetic used to relieve pain, for example in procedures involving the skin, eye, or hemorrhoids. It is an approved drug, also approved for veterinary use, and remains in use mainly as a local anesthetic.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q423741\">Wikidata Q423741</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Procaine\">Procaine</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Procaine;
