    adminDuration = 600,
    adminCount = 1,
    MM = Pharmacolibrary.Drugs.Substances.Vericiguat.M,
    adminMass = 1.25e-06,
    ka = 0.00041666666666666664,
    Tlag = 0.0
  );

  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>vericiguat</td></tr><tr><td>ATC code:</td><td>C01DX22</td></tr><tr><td>model:</td><td>one compartment, oral dosing <small>(PK_1C_enteral)</small></td></tr><tr><td>source:</td><td>Ruehs H et al. 2021</td></tr><tr><td>population:</td><td>adults with heart failure and reduced ejection fraction</td></tr><tr><td>measured compound:</td><td>vericiguat</td></tr><tr><td>review:</td><td>accepted with caveats</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_vericiguat/Vericiguat_Ruehs2021_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>CL/F (L/h)</td><td>1.3</td><td>L/h</td><td><small>CL/F</small></td></tr><tr><td>V/F (L)</td><td>38.9</td><td>L</td><td><small>V/F</small></td></tr><tr><td>ka (1/h)</td><td>1.5</td><td>1/h</td><td><small>kabs</small></td></tr><tr><td>v_sex</td><td>0.850</td><td></td><td><small>equation variable</small></td></tr><tr><td>theta_q22_creatinine_power</td><td>0.164</td><td></td><td><small>equation variable</small></td></tr><tr><td>theta_kabs_bodyweight_ka</td><td>1.28</td><td></td><td><small>equation variable</small></td></tr><tr><td>theta_kabs_albumin_power</td><td>2.37</td><td></td><td><small>equation variable</small></td></tr></table><h4>About vericiguat</h4><p>Vericiguat is a vasodilator used to treat heart failure. It is approved and authorised in the European Union, though it also remains investigational for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27283201\">Wikidata Q27283201</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Vericiguat\">Vericiguat</a>.</p><h4>References</h4><ol><li><p>Ruehs H et al. (2021). Population Pharmacokinetics and Pharmacodynamics of Vericiguat in Patients with Heart Failure and Reduced Ejection Fraction. <i>Clinical pharmacokinetics 60(11):1407–1421</i>. DOI:<a href=\"https://doi.org/10.1007/s40262-021-01024-y\">10.1007/s40262-021-01024-y</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/34086190\">34086190</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Ruehs_2021: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: accepted with caveats</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 432000, Tolerance = 1e-9, Interval = 1));
end Vericiguat_Ruehs2021_reference;
