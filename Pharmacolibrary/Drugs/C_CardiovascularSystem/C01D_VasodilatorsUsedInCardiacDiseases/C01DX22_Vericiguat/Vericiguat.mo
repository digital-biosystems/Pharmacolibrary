within Pharmacolibrary.Drugs.C_CardiovascularSystem.C01D_VasodilatorsUsedInCardiacDiseases.C01DX22_Vericiguat;
model Vericiguat "Vericiguat — default model: Vericiguat_Ruehs2021_reference"
  extends Vericiguat_Ruehs2021_reference;
  annotation (Documentation(info = "<html><body><p>The default model of vericiguat: <a href=\"modelica://Pharmacolibrary.Drugs.C_CardiovascularSystem.C01D_VasodilatorsUsedInCardiacDiseases.C01DX22_Vericiguat.Vericiguat_Ruehs2021_reference\">Vericiguat_Ruehs2021_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of vericiguat in this package:</p><ul><li><code>Vericiguat_Ruehs2021_reference</code></li></ul><h4>About vericiguat</h4><p>Vericiguat is a vasodilator used to treat heart failure. It is approved and authorised in the European Union, though it also remains investigational for other uses.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q27283201\">Wikidata Q27283201</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Vericiguat\">Vericiguat</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 432000, Tolerance = 1e-9, Interval = 1));
end Vericiguat;
