within Pharmacolibrary.Drugs.C_CardiovascularSystem.C03A_LowCeilingDiureticsThiazides.C03AA03_Hydrochlorothiazide;
model Hydrochlorothiazide "Hydrochlorothiazide — default model: Hydrochlorothiazide_Hao2014_tel_8_mg_kg_and_hctz_30_mg_kg_me"
  extends Hydrochlorothiazide_Hao2014_tel_8_mg_kg_and_hctz_30_mg_kg_me;
  annotation (Documentation(info = "<html><body><p>The default model of hydrochlorothiazide: <a href=\"modelica://Pharmacolibrary.Drugs.C_CardiovascularSystem.C03A_LowCeilingDiureticsThiazides.C03AA03_Hydrochlorothiazide.Hydrochlorothiazide_Hao2014_tel_8_mg_kg_and_hctz_30_mg_kg_me\">Hydrochlorothiazide_Hao2014_tel_8_mg_kg_and_hctz_30_mg_kg_me</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of hydrochlorothiazide in this package:</p><ul><li><code>Hydrochlorothiazide_Hao2014_tel_8_mg_kg_and_hctz_30_mg_kg_me</code></li></ul><h4>About hydrochlorothiazide</h4><p>Hydrochlorothiazide is a thiazide diuretic used to treat high blood pressure, heart failure, and fluid retention conditions such as nephrotic syndrome and nephrogenic diabetes insipidus. It is widely used, appears on the WHO list of essential medicines, and is available alone and in many fixed combinations with blood pressure drugs.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q423930\">Wikidata Q423930</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Hydrochlorothiazide\">Hydrochlorothiazide</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Hydrochlorothiazide;
