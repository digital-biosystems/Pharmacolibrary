within Pharmacolibrary.Drugs.C_CardiovascularSystem.C03X_OtherDiuretics.C03XA01_Tolvaptan;
model Tolvaptan "Tolvaptan — default model: Tolvaptan_Lanke2019_reference"
  extends Tolvaptan_Lanke2019_reference;
  annotation (Documentation(info = "<html><body><p>The default model of tolvaptan: <a href=\"modelica://Pharmacolibrary.Drugs.C_CardiovascularSystem.C03X_OtherDiuretics.C03XA01_Tolvaptan.Tolvaptan_Lanke2019_reference\">Tolvaptan_Lanke2019_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of tolvaptan in this package:</p><ul><li><code>Tolvaptan_Lanke2019_reference</code></li></ul><h4>About tolvaptan</h4><p>Tolvaptan is a vasopressin receptor antagonist used to treat low blood sodium (hyponatremia) linked to heart failure, cirrhosis, or inappropriate antidiuretic hormone secretion, and is also authorised for autosomal dominant polycystic kidney disease. It remains in use, with authorised products in the European Union, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q426132\">Wikidata Q426132</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Tolvaptan\">Tolvaptan</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 122400, Tolerance = 1e-9, Interval = 1));
end Tolvaptan;
