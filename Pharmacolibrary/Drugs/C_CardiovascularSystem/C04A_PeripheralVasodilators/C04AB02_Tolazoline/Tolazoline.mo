within Pharmacolibrary.Drugs.C_CardiovascularSystem.C04A_PeripheralVasodilators.C04AB02_Tolazoline;
model Tolazoline "Tolazoline — default model: Tolazoline_Casbeer2013_reference"
  extends Tolazoline_Casbeer2013_reference;
  annotation (Documentation(info = "<html><body><p>The default model of tolazoline: <a href=\"modelica://Pharmacolibrary.Drugs.C_CardiovascularSystem.C04A_PeripheralVasodilators.C04AB02_Tolazoline.Tolazoline_Casbeer2013_reference\">Tolazoline_Casbeer2013_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of tolazoline in this package:</p><ul><li><code>Tolazoline_Casbeer2013_reference</code></li></ul><h4>About tolazoline</h4><p>Tolazoline is a vasodilator that was used for circulatory disorders such as Raynaud disease, thrombophlebitis, thromboangiitis obliterans, arteriosclerosis obliterans, systemic scleroderma, causalgia, and persistent fetal circulation syndrome. It has been withdrawn for human use but remains an approved veterinary drug.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q413772\">Wikidata Q413772</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Tolazoline\">Tolazoline</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Tolazoline;
