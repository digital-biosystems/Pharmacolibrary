within Pharmacolibrary.Drugs.C_CardiovascularSystem.C04A_PeripheralVasodilators.C04AE04_Dihydroergocristine;
model Dihydroergocristine "Dihydroergocristine — default model: Dihydroergocristine_Grognet1992_reference"
  extends Dihydroergocristine_Grognet1992_reference;
  annotation (Documentation(info = "<html><body><p>The default model of dihydroergocristine: <a href=\"modelica://Pharmacolibrary.Drugs.C_CardiovascularSystem.C04A_PeripheralVasodilators.C04AE04_Dihydroergocristine.Dihydroergocristine_Grognet1992_reference\">Dihydroergocristine_Grognet1992_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of dihydroergocristine in this package:</p><ul><li><code>Dihydroergocristine_Grognet1992_reference</code></li></ul><h4>About dihydroergocristine</h4><p>Dihydroergocristine is a vasodilator ergot alkaloid used in the treatment of dementia. It is an approved drug, classified as a peripheral vasodilator, but does not appear to have centralised European Union authorisation.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5276428\">Wikidata Q5276428</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Dihydroergocristine\">Dihydroergocristine</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 259200, Tolerance = 1e-9, Interval = 1));
end Dihydroergocristine;
