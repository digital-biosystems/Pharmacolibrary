within Pharmacolibrary.Drugs.C_CardiovascularSystem.C04A_PeripheralVasodilators.C04AD04_EtofyllineNicotinate;
model EtofyllineNicotinate "EtofyllineNicotinate — default model: EtofyllineNicotinate_Zuidema1981_reference"
  extends EtofyllineNicotinate_Zuidema1981_reference;
  annotation (Documentation(info = "<html><body><p>The default model of etofylline nicotinate: <a href=\"modelica://Pharmacolibrary.Drugs.C_CardiovascularSystem.C04A_PeripheralVasodilators.C04AD04_EtofyllineNicotinate.EtofyllineNicotinate_Zuidema1981_reference\">EtofyllineNicotinate_Zuidema1981_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of etofylline nicotinate in this package:</p><ul><li><code>EtofyllineNicotinate_Zuidema1981_reference</code></li></ul><h4>About etofylline nicotinate</h4><p>Etofylline nicotinate is a purine-derivative compound classified as a peripheral vasodilator, indicating use for circulatory problems in the limbs. It appears only as an experimental drug and is not an approved medicine in the European Union, so its current use is unclear.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q15408405\">Wikidata Q15408405</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.EtofyllineNicotinate\">EtofyllineNicotinate</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end EtofyllineNicotinate;
