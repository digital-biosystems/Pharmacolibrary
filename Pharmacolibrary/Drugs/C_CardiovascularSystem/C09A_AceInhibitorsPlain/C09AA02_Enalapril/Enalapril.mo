within Pharmacolibrary.Drugs.C_CardiovascularSystem.C09A_AceInhibitorsPlain.C09AA02_Enalapril;
model Enalapril "Enalapril — default model: Enalapril_Steichert2025v2_reference"
  extends Enalapril_Steichert2025v2_reference;
  annotation (Documentation(info = "<html><body><p>The default model of enalapril: <a href=\"modelica://Pharmacolibrary.Drugs.C_CardiovascularSystem.C09A_AceInhibitorsPlain.C09AA02_Enalapril.Enalapril_Steichert2025v2_reference\">Enalapril_Steichert2025v2_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of enalapril in this package:</p><ul><li><code>Enalapril_Steichert2025v2_reference</code></li><li><code>Enalapril_Arafat2005_PD_dbp</code></li><li><code>Enalapril_Arafat2005_PD_dbp_2</code></li></ul><h4>About enalapril</h4><p>Enalapril is an ACE inhibitor used to treat high blood pressure, heart failure, and related cardiovascular conditions. It is widely used worldwide, appears on the WHO essential medicines list, and is authorised in the European Union; it is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q422185\">Wikidata Q422185</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Enalapril\">Enalapril</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Enalapril;
