  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>enalapril</td></tr><tr><td>ATC code:</td><td>C09AA02</td></tr><tr><td>model:</td><td>two compartments, oral dosing <small>(PK_2C_enteral)</small></td></tr><tr><td>source:</td><td>Steichert M et al. 2025</td></tr><tr><td>population:</td><td>healthy adults and children with heart failure</td></tr><tr><td>measured compound:</td><td>enalaprilat</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_enalapril/Enalapril_Steichert2025v2_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>ktr</td><td>5.31</td><td>1/h</td><td><small>ktr</small></td></tr><tr><td>Mtt</td><td>1.46</td><td></td><td><small>MTT</small></td></tr><tr><td>ka</td><td>1.19</td><td>1/h</td><td><small>kabs</small></td></tr><tr><td>CL/F</td><td>36.39</td><td>L/h</td><td><small>CL/F</small></td></tr><tr><td>V1/F</td><td>223.71</td><td>L</td><td><small>V1/F</small></td></tr><tr><td>Q/F</td><td>6.38</td><td>L/h</td><td><small>Q/F</small></td></tr><tr><td>V2/F</td><td>108.26</td><td>L</td><td><small>V2/F</small></td></tr></table><h4>About enalapril</h4><p>Enalapril is an ACE inhibitor used to treat high blood pressure, heart failure, and related cardiovascular conditions. It is widely used worldwide, appears on the WHO essential medicines list, and is authorised in the European Union; it is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q422185\">Wikidata Q422185</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Enalapril\">Enalapril</a>.</p><h4>References</h4><ol><li><p>Steichert M et al. (2025). Angiotensin II/Angiotensin I Ratio as a New Pharmacodynamic Parameter for Population Modelling in Healthy Adults and Children with Heart Failure Treated with Enalapril. <i>Pharmaceutics 17(10)</i>. DOI:<a href=\"https://doi.org/10.3390/pharmaceutics17101345\">10.3390/pharmaceutics17101345</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/41155980\">41155980</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Steichert_2025_2: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
