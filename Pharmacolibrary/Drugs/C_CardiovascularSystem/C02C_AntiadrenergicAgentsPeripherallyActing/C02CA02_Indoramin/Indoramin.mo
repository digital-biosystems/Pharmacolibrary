within Pharmacolibrary.Drugs.C_CardiovascularSystem.C02C_AntiadrenergicAgentsPeripherallyActing.C02CA02_Indoramin;
model Indoramin "Indoramin — default model: Indoramin_Norbury1983_reference"
  extends Indoramin_Norbury1983_reference;
  annotation (Documentation(info = "<html><body><p>The default model of indoramin: <a href=\"modelica://Pharmacolibrary.Drugs.C_CardiovascularSystem.C02C_AntiadrenergicAgentsPeripherallyActing.C02CA02_Indoramin.Indoramin_Norbury1983_reference\">Indoramin_Norbury1983_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of indoramin in this package:</p><ul><li><code>Indoramin_Norbury1983_reference</code></li></ul><h4>About indoramin</h4><p>Indoramin is an alpha-1 adrenergic blocker that was used to treat high blood pressure and enlarged prostate. It has been withdrawn and is no longer in use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q408963\">Wikidata Q408963</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Indoramin\">Indoramin</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Indoramin;
