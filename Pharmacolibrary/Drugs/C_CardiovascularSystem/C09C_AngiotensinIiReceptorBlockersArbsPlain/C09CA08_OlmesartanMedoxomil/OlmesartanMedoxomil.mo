  extends Olmesartan_Kodati2017_reference;
  annotation (Documentation(info = "<html><body><p>The default model of Olmesartan: <a href=\"modelica://Pharmacolibrary.Drugs.C_CardiovascularSystem.C09C_AngiotensinIiReceptorBlockersArbsPlain.C09CA08_OlmesartanMedoxomil.Olmesartan_Kodati2017_reference\">Olmesartan_Kodati2017_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of Olmesartan in this package:</p><ul><li><code>Olmesartan_Kodati2017_reference</code></li></ul><h4>About Olmesartan</h4><p>Olmesartan is an angiotensin II receptor blocker used to treat high blood pressure (arterial hypertension) and congestive heart failure. It is an approved medicine, available alone and in combination products with diuretics or calcium channel blockers.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q421156\">Wikidata Q421156</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.OlmesartanMedoxomil\">OlmesartanMedoxomil</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 1814400, Tolerance = 1e-9, Interval = 1));
end OlmesartanMedoxomil;
