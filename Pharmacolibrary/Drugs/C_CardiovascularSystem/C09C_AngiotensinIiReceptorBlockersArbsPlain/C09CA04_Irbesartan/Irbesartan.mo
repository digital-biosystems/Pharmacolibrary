within Pharmacolibrary.Drugs.C_CardiovascularSystem.C09C_AngiotensinIiReceptorBlockersArbsPlain.C09CA04_Irbesartan;
model Irbesartan "Irbesartan — default model: Irbesartan_Karatza2020_reference"
  extends Irbesartan_Karatza2020_reference;
  annotation (Documentation(info = "<html><body><p>The default model of irbesartan: <a href=\"modelica://Pharmacolibrary.Drugs.C_CardiovascularSystem.C09C_AngiotensinIiReceptorBlockersArbsPlain.C09CA04_Irbesartan.Irbesartan_Karatza2020_reference\">Irbesartan_Karatza2020_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of irbesartan in this package:</p><ul><li><code>Irbesartan_Karatza2020_reference</code></li></ul><h4>About irbesartan</h4><p>Irbesartan is an angiotensin II receptor blocker used to treat high blood pressure (arterial hypertension). It is an approved medicine, authorised in the European Union, and is available both alone and in combination products with diuretics or calcium channel blockers.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q947266\">Wikidata Q947266</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Irbesartan\">Irbesartan</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Irbesartan;
