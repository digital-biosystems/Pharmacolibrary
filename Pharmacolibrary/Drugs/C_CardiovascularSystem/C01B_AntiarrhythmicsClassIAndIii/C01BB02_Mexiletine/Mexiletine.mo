within Pharmacolibrary.Drugs.C_CardiovascularSystem.C01B_AntiarrhythmicsClassIAndIii.C01BB02_Mexiletine;
model Mexiletine "Mexiletine — default model: Mexiletine_Vozeh1982_reference"
  extends Mexiletine_Vozeh1982_reference;
  annotation (Documentation(info = "<html><body><p>The default model of mexiletine: <a href=\"modelica://Pharmacolibrary.Drugs.C_CardiovascularSystem.C01B_AntiarrhythmicsClassIAndIii.C01BB02_Mexiletine.Mexiletine_Vozeh1982_reference\">Mexiletine_Vozeh1982_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of mexiletine in this package:</p><ul><li><code>Mexiletine_Vozeh1982_reference</code></li></ul><h4>About mexiletine</h4><p>Mexiletine is an antiarrhythmic (class Ib) drug used for heart rhythm problems such as ventricular fibrillation, and also for diabetic nerve pain and myotonic disorders. It remains in use, with one product authorised in the European Union, where it is indicated for myotonic disorders.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q420377\">Wikidata Q420377</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Mexiletine\">Mexiletine</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 259200, Tolerance = 1e-9, Interval = 1));
end Mexiletine;
