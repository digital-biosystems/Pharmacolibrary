within Pharmacolibrary.Drugs.C_CardiovascularSystem.C01B_AntiarrhythmicsClassIAndIii.C01BD02_BretyliumTosilate;
model BretyliumTosilate "BretyliumTosilate — default model: Bretylium_Kamath1981_reference"
  extends Bretylium_Kamath1981_reference;
  annotation (Documentation(info = "<html><body><p>The default model of Bretylium: <a href=\"modelica://Pharmacolibrary.Drugs.C_CardiovascularSystem.C01B_AntiarrhythmicsClassIAndIii.C01BD02_BretyliumTosilate.Bretylium_Kamath1981_reference\">Bretylium_Kamath1981_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of Bretylium in this package:</p><ul><li><code>Bretylium_Kamath1981_reference</code></li></ul><h4>About Bretylium</h4><p>Bretylium is a class III antiarrhythmic agent used to treat ventricular fibrillation and heart conduction disease. It is an approved drug, though it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q420026\">Wikidata Q420026</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Bretylium\">Bretylium</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 122400, Tolerance = 1e-9, Interval = 1));
end BretyliumTosilate;
