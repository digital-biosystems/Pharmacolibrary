within Pharmacolibrary.Drugs.C_CardiovascularSystem.C01B_AntiarrhythmicsClassIAndIii.C01BA02_Procainamide;
model Procainamide "Procainamide — default model: Procainamide_Grasela1984_reference"
  extends Procainamide_Grasela1984_reference;
  annotation (Documentation(info = "<html><body><p>The default model of procainamide: <a href=\"modelica://Pharmacolibrary.Drugs.C_CardiovascularSystem.C01B_AntiarrhythmicsClassIAndIii.C01BA02_Procainamide.Procainamide_Grasela1984_reference\">Procainamide_Grasela1984_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of procainamide in this package:</p><ul><li><code>Procainamide_Grasela1984_reference</code></li></ul><h4>About procainamide</h4><p>Procainamide is a class Ia antiarrhythmic used to treat heart rhythm problems such as atrial fibrillation and supraventricular tachycardia. It is an approved medicine, though it is not authorised in the European Union and is used mainly in other regions.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q417597\">Wikidata Q417597</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Procainamide\">Procainamide</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 1468800, Tolerance = 1e-9, Interval = 1));
end Procainamide;
