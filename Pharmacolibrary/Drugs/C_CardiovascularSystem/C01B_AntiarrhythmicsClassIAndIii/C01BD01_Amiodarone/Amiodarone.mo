within Pharmacolibrary.Drugs.C_CardiovascularSystem.C01B_AntiarrhythmicsClassIAndIii.C01BD01_Amiodarone;
model Amiodarone "Amiodarone — default model: Amiodarone_Gaete1995_reference"
  extends Amiodarone_Gaete1995_reference;
  annotation (Documentation(info = "<html><body><p>The default model of amiodarone: <a href=\"modelica://Pharmacolibrary.Drugs.C_CardiovascularSystem.C01B_AntiarrhythmicsClassIAndIii.C01BD01_Amiodarone.Amiodarone_Gaete1995_reference\">Amiodarone_Gaete1995_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of amiodarone in this package:</p><ul><li><code>Amiodarone_Gaete1995_reference</code></li></ul><h4>About amiodarone</h4><p>Amiodarone is an antiarrhythmic medicine used to treat and prevent various types of irregular heartbeat, including ventricular tachycardia, atrial fibrillation, and other arrhythmias. It is widely used, is included on the WHO list of essential medicines, and is an approved drug.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q410061\">Wikidata Q410061</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Amiodarone\">Amiodarone</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 151200, Tolerance = 1e-9, Interval = 1));
end Amiodarone;
