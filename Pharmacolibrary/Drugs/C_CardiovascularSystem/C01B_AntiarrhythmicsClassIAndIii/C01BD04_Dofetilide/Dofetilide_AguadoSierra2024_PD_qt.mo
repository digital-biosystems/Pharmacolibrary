within Pharmacolibrary.Drugs.C_CardiovascularSystem.C01B_AntiarrhythmicsClassIAndIii.C01BD04_Dofetilide;
model Dofetilide_AguadoSierra2024_PD_qt
  "linear exposure-response sweep — Aguado-Sierra_2024 :: QT (QT interval)"
  extends Pharmacolibrary.Interfaces.PartialExposureResponseSweep(
    E0 = 0.00067,      // [s; ms × 0.001]
    Emax = 0, EC50 = 1,      // unused by a line
    exposure_per_s = 1e-06);
  parameter Real slope = 24.82   "[1]";
equation
  response = E0 + slope*exposure;
  annotation(experiment(StartTime = 0, StopTime = 1000, Interval = 2),
    Documentation(info = "<html><body><h4>Dofetilide_AguadoSierra2024_PD_qt</h4><p>The steady-state exposure-response curve of Aguado-Sierra J et al., <i>Journal of pharmacological and toxicological methods 126:107498</i> 2024 (<a href=\"https://doi.org/10.1016/j.vascn.2024.107498\">doi:10.1016/j.vascn.2024.107498</a>) — QT interval [ms] against dofetilide ng/mL — obtained by sweeping the driver instead of simulating a dose. Model family: linear.</p><h4>The parameters, in the paper's terms</h4><pre>  E0    =       0.67 ms       drug-free response (baseline) (Intercept, Q324)
  slope =      24.82          change in response per unit of exposure (Slope, Q335)</pre><p>The algebra is <code>response = E0 + slope*exposure</code>; this model only supplies the numbers. The x axis is one ng/mL of dofetilide per second of simulated time (exposure is in kg/m3): there is no state, no dose and no kinetics — plot <code>response</code> against <code>exposure</code> (or <code>time</code>).</p><h4>What it reproduces</h4><pre>  exposure = 0         response 0.00067   (drug-free)</pre></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Aguado-Sierra_2024: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"));
end Dofetilide_AguadoSierra2024_PD_qt;
