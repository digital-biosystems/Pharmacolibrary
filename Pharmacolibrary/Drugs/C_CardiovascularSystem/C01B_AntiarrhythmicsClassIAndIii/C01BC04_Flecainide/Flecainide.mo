within Pharmacolibrary.Drugs.C_CardiovascularSystem.C01B_AntiarrhythmicsClassIAndIii.C01BC04_Flecainide;
model Flecainide "Flecainide — default model: Flecainide_Horie2014_reference"
  extends Flecainide_Horie2014_reference;
  annotation (Documentation(info = "<html><body><p>The default model of flecainide: <a href=\"modelica://Pharmacolibrary.Drugs.C_CardiovascularSystem.C01B_AntiarrhythmicsClassIAndIii.C01BC04_Flecainide.Flecainide_Horie2014_reference\">Flecainide_Horie2014_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of flecainide in this package:</p><ul><li><code>Flecainide_Horie2014_reference</code></li><li><code>Flecainide_Sllstrm2014_PD_qrs</code></li></ul><h4>About flecainide</h4><p>Flecainide is a class Ic antiarrhythmic used to prevent and treat heart rhythm disorders such as atrial fibrillation. It remains an approved medicine, but it carries a boxed warning, so its use requires caution.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q421381\">Wikidata Q421381</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Flecainide\">Flecainide</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 432000, Tolerance = 1e-9, Interval = 1));
end Flecainide;
