within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01E_SulfonamidesAndTrimethoprim.J01EC01_Sulfamethoxazole;
model Sulfamethoxazole "Sulfamethoxazole — default model: Sulfamethoxazole_Hess1993_reference"
  extends Sulfamethoxazole_Hess1993_reference;
  annotation (Documentation(info = "<html><body><p>The default model of sulfamethoxazole: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01E_SulfonamidesAndTrimethoprim.J01EC01_Sulfamethoxazole.Sulfamethoxazole_Hess1993_reference\">Sulfamethoxazole_Hess1993_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of sulfamethoxazole in this package:</p><ul><li><code>Sulfamethoxazole_Hess1993_reference</code></li></ul><h4>About sulfamethoxazole</h4><p>Sulfamethoxazole is a sulfonamide antibiotic used to treat bacterial infections such as urinary tract infections, otitis media, acute bronchitis, toxoplasmosis, nocardiosis, and gram-negative infections. It remains in use, often combined with trimethoprim, and is also included in combination regimens for tuberculosis treatment.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q415843\">Wikidata Q415843</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Sulfamethoxazole\">Sulfamethoxazole</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 259200, Tolerance = 1e-9, Interval = 1));
end Sulfamethoxazole;
