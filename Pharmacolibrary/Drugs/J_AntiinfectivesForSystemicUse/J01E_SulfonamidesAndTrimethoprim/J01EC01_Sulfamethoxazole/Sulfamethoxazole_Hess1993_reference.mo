  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>sulfamethoxazole</td></tr><tr><td>ATC code:</td><td>J01EC01</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Hess MM et al. 1993</td></tr><tr><td>population:</td><td>adult trauma patients</td></tr><tr><td>measured compound:</td><td>sulfamethoxazole</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_sulfamethoxazole/Sulfamethoxazole_Hess1993_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>volume</td><td>2.1</td><td>L/kg</td><td><small>V</small></td></tr><tr><td>half-life</td><td>9.7</td><td>hours</td><td><small>t1/2z</small></td></tr><tr><td>clearance</td><td>2.6</td><td>ml/min/kg</td><td><small>CL</small></td></tr></table><h4>About sulfamethoxazole</h4><p>Sulfamethoxazole is a sulfonamide antibiotic used to treat bacterial infections such as urinary tract infections, otitis media, acute bronchitis, toxoplasmosis, nocardiosis, and gram-negative infections. It remains in use, often combined with trimethoprim, and is also included in combination regimens for tuberculosis treatment.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q415843\">Wikidata Q415843</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Sulfamethoxazole\">Sulfamethoxazole</a>.</p><h4>References</h4><ol><li><p>Hess MM et al. (1993). Trimethoprim-sulfamethoxazole pharmacokinetics in trauma patients. <i>Pharmacotherapy 13(6):602–606</i>. PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/8302685\">8302685</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Hess_1993: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 259200, Tolerance = 1e-9, Interval = 1));
end Sulfamethoxazole_Hess1993_reference;
