model CeftarolineFosamil "CeftarolineFosamil — default model: CeftarolineFosamil_Adamiszak2025_reference"
  extends CeftarolineFosamil_Adamiszak2025_reference;
  annotation (Documentation(info = "<html><body><p>The default model of ceftaroline fosamil: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01D_OtherBetaLactamAntibacterials.J01DI02_CeftarolineFosamil.CeftarolineFosamil_Adamiszak2025_reference\">CeftarolineFosamil_Adamiszak2025_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of ceftaroline fosamil in this package:</p><ul><li><code>CeftarolineFosamil_Adamiszak2025_reference</code></li></ul><h4>About ceftaroline fosamil</h4><p>Ceftaroline fosamil is a cephalosporin antibiotic used to treat bacterial infections such as community-acquired pneumonia, skin infections, and staphylococcal infections. It is approved and authorised in the European Union, where it is used for these infections.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q409712\">Wikidata Q409712</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.CeftarolineFosamil\">CeftarolineFosamil</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end CeftarolineFosamil;
