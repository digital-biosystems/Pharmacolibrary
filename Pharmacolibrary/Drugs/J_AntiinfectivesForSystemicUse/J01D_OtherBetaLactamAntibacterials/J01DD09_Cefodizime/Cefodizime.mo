  extends Cefodizime_SchferKorting1986_reference;
  annotation (Documentation(info = "<html><body><p>The default model of cefodizime: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01D_OtherBetaLactamAntibacterials.J01DD09_Cefodizime.Cefodizime_SchferKorting1986_reference\">Cefodizime_SchferKorting1986_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of cefodizime in this package:</p><ul><li><code>Cefodizime_SchferKorting1986_reference</code></li></ul><h4>About cefodizime</h4><p>Cefodizime is a third-generation cephalosporin antibiotic used against bacterial infections. It is classed as investigational and is not an authorised medicine in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5057292\">Wikidata Q5057292</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Cefodizime\">Cefodizime</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Cefodizime;
