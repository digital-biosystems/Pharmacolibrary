  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>cefoperazone</td></tr><tr><td>ATC code:</td><td>J01DD12</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Soback S et al. 1989</td></tr><tr><td>population:</td><td>unweaned calves</td></tr><tr><td>measured compound:</td><td>cefoperazone</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_cefoperazone/Cefoperazone_Soback1989_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>The terminal halflife of cefoperazone</td><td>127.9</td><td>min</td><td><small>t1/2z</small></td></tr><tr><td>The total body clearance</td><td>8.16</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>the volume of distribution at steady state</td><td>0.713</td><td>litre kg-1</td><td><small>Vss</small></td></tr><tr><td>The estimated mean absorption time</td><td>53.1</td><td>min</td><td><small>MAT</small></td></tr><tr><td>the estimated bioavailability after intramuscular administration</td><td>76.3</td><td>per cent</td><td><small>Fab</small></td></tr><tr><td>Vd</td><td>20.9</td><td>L</td><td><small>V</small></td></tr></table><h4>About cefoperazone</h4><p>Cefoperazone is a third-generation cephalosporin antibiotic used to treat bacterial infections, including urinary, respiratory, and Pseudomonas infections. It has been withdrawn from the market in many places and is no longer widely available.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2325775\">Wikidata Q2325775</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Cefoperazone\">Cefoperazone</a>.</p><h4>References</h4><ol><li><p>Soback S et al. (1989). Pharmacokinetics of single doses of cefoperazone given by the intravenous and intramuscular routes to unweaned calves. <i>Research in veterinary science 47(2):158–163</i>. PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/2799072\">2799072</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Soback_1989: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
