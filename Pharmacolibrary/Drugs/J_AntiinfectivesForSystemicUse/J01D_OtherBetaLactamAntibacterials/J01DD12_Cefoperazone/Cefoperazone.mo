within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01D_OtherBetaLactamAntibacterials.J01DD12_Cefoperazone;
model Cefoperazone "Cefoperazone — default model: Cefoperazone_Soback1989_reference"
  extends Cefoperazone_Soback1989_reference;
  annotation (Documentation(info = "<html><body><p>The default model of cefoperazone: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01D_OtherBetaLactamAntibacterials.J01DD12_Cefoperazone.Cefoperazone_Soback1989_reference\">Cefoperazone_Soback1989_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of cefoperazone in this package:</p><ul><li><code>Cefoperazone_Soback1989_reference</code></li></ul><h4>About cefoperazone</h4><p>Cefoperazone is a third-generation cephalosporin antibiotic used to treat bacterial infections, including urinary, respiratory, and Pseudomonas infections. It has been withdrawn from the market in many places and is no longer widely available.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2325775\">Wikidata Q2325775</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Cefoperazone\">Cefoperazone</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Cefoperazone;
