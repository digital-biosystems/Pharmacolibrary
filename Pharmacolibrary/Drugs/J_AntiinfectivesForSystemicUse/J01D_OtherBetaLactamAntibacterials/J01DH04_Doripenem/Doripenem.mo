within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01D_OtherBetaLactamAntibacterials.J01DH04_Doripenem;
model Doripenem "Doripenem — default model: Doripenem_Nonoshita2020_base_model"
  extends Doripenem_Nonoshita2020_base_model;
  annotation (Documentation(info = "<html><body><p>The default model of doripenem: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01D_OtherBetaLactamAntibacterials.J01DH04_Doripenem.Doripenem_Nonoshita2020_base_model\">Doripenem_Nonoshita2020_base_model</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of doripenem in this package:</p><ul><li><code>Doripenem_Nonoshita2020_base_model</code></li><li><code>Doripenem_Nonoshita2020_population_mean</code></li><li><code>Doripenem_Tanaka2017_based_on_ppk_model</code></li><li><code>Doripenem_Tanaka2017_bayesian_estimated</code></li></ul><h4>About doripenem</h4><p>Doripenem is a carbapenem antibiotic that was used to treat bacterial infections, including pneumonia, urinary tract infections, and hospital-acquired infections. It is no longer marketed in the European Union, where its product has been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q411552\">Wikidata Q411552</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Doripenem\">Doripenem</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Doripenem;
