  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>doripenem</td></tr><tr><td>ATC code:</td><td>J01DH04</td></tr><tr><td>model:</td><td>two compartments, IV dosing <small>(PK_2C)</small></td></tr><tr><td>source:</td><td>Nonoshita K et al. 2020</td></tr><tr><td>population:</td><td>Japanese ICU patients</td></tr><tr><td>measured compound:</td><td>doripenem</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_doripenem/Doripenem_Nonoshita2020_population_mean\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>CLbody(non-CRRT) (L h−1)</td><td>3.65</td><td>L h−1</td><td><small>CLb</small></td></tr><tr><td>CLbody(CRRT) ( L h−1)</td><td>2.49</td><td>L h−1</td><td><small>CL_CRRT</small></td></tr><tr><td>V1 (L)</td><td>10.04</td><td>L</td><td><small>V1</small></td></tr><tr><td>V2 (L)</td><td>8.13</td><td>L</td><td><small>V2</small></td></tr><tr><td>Q ( L h−1)</td><td>3.53</td><td>L h−1</td><td><small>Q</small></td></tr></table><h4>About doripenem</h4><p>Doripenem is a carbapenem antibiotic that was used to treat bacterial infections, including pneumonia, urinary tract infections, and hospital-acquired infections. It is no longer marketed in the European Union, where its product has been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q411552\">Wikidata Q411552</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Doripenem\">Doripenem</a>.</p><h4>References</h4><ol><li><p>Nonoshita K et al. (2020). Population pharmacokinetic analysis of doripenem for Japanese patients in intensive care unit. <i>Scientific reports 10(1):22148</i>. DOI:<a href=\"https://doi.org/10.1038/s41598-020-79076-6\">10.1038/s41598-020-79076-6</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/33335198\">33335198</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Nonoshita_2020: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
