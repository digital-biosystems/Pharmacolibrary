within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01D_OtherBetaLactamAntibacterials.J01DB01_Cefalexin;
model Cefalexin "Cefalexin — default model: Cefalexin_Prados2014_base"
  extends Cefalexin_Prados2014_base;
  annotation (Documentation(info = "<html><body><p>The default model of cefalexin: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01D_OtherBetaLactamAntibacterials.J01DB01_Cefalexin.Cefalexin_Prados2014_base\">Cefalexin_Prados2014_base</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of cefalexin in this package:</p><ul><li><code>Cefalexin_Prados2014_base</code></li></ul><h4>About cefalexin</h4><p>Cefalexin is a first-generation cephalosporin antibiotic used to treat bacterial infections such as urinary tract infections, skin infections like cellulitis, pharyngitis, respiratory infections, and pneumonia. It is widely used in human medicine and is also approved for veterinary use, and it appears on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q411417\">Wikidata Q411417</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Cefalexin\">Cefalexin</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Cefalexin;
