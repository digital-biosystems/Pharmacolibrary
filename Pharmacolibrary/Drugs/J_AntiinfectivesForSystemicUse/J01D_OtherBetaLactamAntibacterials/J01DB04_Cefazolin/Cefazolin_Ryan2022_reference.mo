  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>cefazolin</td></tr><tr><td>ATC code:</td><td>J01DB04</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Ryan RL et al. 2022</td></tr><tr><td>population:</td><td>obese bariatric surgery patients</td></tr><tr><td>measured compound:</td><td>cefazolin</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_cefazolin/Cefazolin_Ryan2022_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>mean central volume of distribution</td><td>18.2</td><td>L</td><td><small>V</small></td></tr><tr><td>mean clearance</td><td>32.4</td><td>L · h-1</td><td><small>CL</small></td></tr></table><h4>About cefazolin</h4><p>Cefazolin is a first-generation cephalosporin antibiotic used to treat bacterial infections such as staphylococcal and urinary tract infections. It is an approved medicine and appears on the WHO list of essential medicines, so it is widely used around the world.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q415739\">Wikidata Q415739</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Cefazolin\">Cefazolin</a>.</p><h4>References</h4><ol><li><p>Ryan RL et al. (2022). Plasma and Interstitial Fluid Pharmacokinetics of Prophylactic Cefazolin in Elective Bariatric Surgery Patients. <i>Antimicrobial agents and chemotherapy 66(7):e0041922</i>. DOI:<a href=\"https://doi.org/10.1128/aac.00419-22\">10.1128/aac.00419-22</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/35762797\">35762797</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Ryan_2022: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Cefazolin_Ryan2022_reference;
