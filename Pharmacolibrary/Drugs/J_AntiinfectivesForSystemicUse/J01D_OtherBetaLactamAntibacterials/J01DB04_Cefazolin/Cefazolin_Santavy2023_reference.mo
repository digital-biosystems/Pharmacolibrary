  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>cefazolin</td></tr><tr><td>ATC code:</td><td>J01DB04</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Santavy P et al. 2023</td></tr><tr><td>population:</td><td>adults undergoing cardiac surgery</td></tr><tr><td>measured compound:</td><td>cefazolin</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_cefazolin/Cefazolin_Santavy2023_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>CL_pop (L/h)</td><td>0.089</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>V1_pop (L)</td><td>10.09</td><td>L</td><td><small>V</small></td></tr><tr><td>Q_pop (L/h)</td><td>0.17</td><td>L/h</td><td><small>Q</small></td></tr></table><h4>About cefazolin</h4><p>Cefazolin is a first-generation cephalosporin antibiotic used to treat bacterial infections such as staphylococcal and urinary tract infections. It is an approved medicine and appears on the WHO list of essential medicines, so it is widely used around the world.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q415739\">Wikidata Q415739</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Cefazolin\">Cefazolin</a>.</p><h4>References</h4><ol><li><p>Santavy P et al. (2023). Population pharmacokinetics of three alternative prophylactic antibiotics during cardiac surgery with extracorporeal circulation. <i>Biomedical papers of the Medical Faculty of the University Palacky, Olomouc, Czechoslovakia 167(2):208–211</i>. DOI:<a href=\"https://doi.org/10.5507/bp.2022.033\">10.5507/bp.2022.033</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/35775358\">35775358</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Santavy_2023: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
