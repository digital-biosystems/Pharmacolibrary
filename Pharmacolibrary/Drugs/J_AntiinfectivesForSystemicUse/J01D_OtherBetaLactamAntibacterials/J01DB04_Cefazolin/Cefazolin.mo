within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01D_OtherBetaLactamAntibacterials.J01DB04_Cefazolin;
model Cefazolin "Cefazolin — default model: Cefazolin_Santavy2023_reference"
  extends Cefazolin_Santavy2023_reference;
  annotation (Documentation(info = "<html><body><p>The default model of cefazolin: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01D_OtherBetaLactamAntibacterials.J01DB04_Cefazolin.Cefazolin_Santavy2023_reference\">Cefazolin_Santavy2023_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of cefazolin in this package:</p><ul><li><code>Cefazolin_Ryan2022_reference</code></li><li><code>Cefazolin_Santavy2023_reference</code></li></ul><h4>About cefazolin</h4><p>Cefazolin is a first-generation cephalosporin antibiotic used to treat bacterial infections such as staphylococcal and urinary tract infections. It is an approved medicine and appears on the WHO list of essential medicines, so it is widely used around the world.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q415739\">Wikidata Q415739</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Cefazolin\">Cefazolin</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 1468800, Tolerance = 1e-9, Interval = 1));
end Cefazolin;
