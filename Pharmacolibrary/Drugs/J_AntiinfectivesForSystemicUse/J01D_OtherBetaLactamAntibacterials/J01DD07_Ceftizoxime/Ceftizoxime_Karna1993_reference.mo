  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>ceftizoxime</td></tr><tr><td>ATC code:</td><td>J01DD07</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Karna P et al. 1993</td></tr><tr><td>population:</td><td>premature newborns</td></tr><tr><td>measured compound:</td><td>ceftizoxime</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_ceftizoxime/Ceftizoxime_Karna1993_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>clearance</td><td>27.1</td><td>ml/h/kg</td><td><small>CL</small></td></tr><tr><td>volume of distribution</td><td>333</td><td>ml/kg</td><td><small>V</small></td></tr><tr><td>half-life</td><td>8.5</td><td>h</td><td><small>t1/2z</small></td></tr></table><h4>About ceftizoxime</h4><p>Ceftizoxime is a third-generation cephalosporin antibiotic used to treat bacterial infections such as sepsis, gonorrhea, urinary tract infections, pneumonia, and other gram-negative infections. It has been withdrawn from use in some markets, though it remains approved elsewhere.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1082945\">Wikidata Q1082945</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Ceftizoxime\">Ceftizoxime</a>.</p><h4>References</h4><ol><li><p>Karna P et al. (1993). Population pharmacokinetics of ceftizoxime in premature newborns. <i>Developmental pharmacology and therapeutics 20(3-4):135–143</i>. DOI:<a href=\"https://doi.org/10.1159/000457554\">10.1159/000457554</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/7828445\">7828445</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Karna_1993: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
