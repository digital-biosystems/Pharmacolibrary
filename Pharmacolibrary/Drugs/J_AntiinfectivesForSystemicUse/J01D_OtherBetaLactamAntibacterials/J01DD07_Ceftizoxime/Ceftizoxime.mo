within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01D_OtherBetaLactamAntibacterials.J01DD07_Ceftizoxime;
model Ceftizoxime "Ceftizoxime — default model: Ceftizoxime_Karna1993_reference"
  extends Ceftizoxime_Karna1993_reference;
  annotation (Documentation(info = "<html><body><p>The default model of ceftizoxime: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01D_OtherBetaLactamAntibacterials.J01DD07_Ceftizoxime.Ceftizoxime_Karna1993_reference\">Ceftizoxime_Karna1993_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of ceftizoxime in this package:</p><ul><li><code>Ceftizoxime_Karna1993_reference</code></li></ul><h4>About ceftizoxime</h4><p>Ceftizoxime is a third-generation cephalosporin antibiotic used to treat bacterial infections such as sepsis, gonorrhea, urinary tract infections, pneumonia, and other gram-negative infections. It has been withdrawn from use in some markets, though it remains approved elsewhere.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q1082945\">Wikidata Q1082945</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Ceftizoxime\">Ceftizoxime</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 154800, Tolerance = 1e-9, Interval = 1));
end Ceftizoxime;
