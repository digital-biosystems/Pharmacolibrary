within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01D_OtherBetaLactamAntibacterials.J01DC07_Cefotiam;
model Cefotiam "Cefotiam — default model: Cefotiam_Shah2019_reference"
  extends Cefotiam_Shah2019_reference;
  annotation (Documentation(info = "<html><body><p>The default model of cefotiam: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01D_OtherBetaLactamAntibacterials.J01DC07_Cefotiam.Cefotiam_Shah2019_reference\">Cefotiam_Shah2019_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of cefotiam in this package:</p><ul><li><code>Cefotiam_Shah2019_reference</code></li></ul><h4>About cefotiam</h4><p>Cefotiam is a second-generation cephalosporin antibiotic used to treat bacterial infections. It is an approved antibacterial for systemic use, given by injection, mainly in hospital settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3009984\">Wikidata Q3009984</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Cefotiam\">Cefotiam</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Cefotiam;
