  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>cefotiam</td></tr><tr><td>ATC code:</td><td>J01DC07</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Shah NR et al. 2019</td></tr><tr><td>population:</td><td>patients with cystic fibrosis and healthy volunteers</td></tr><tr><td>measured compound:</td><td>cefotiam</td></tr><tr><td>review:</td><td>accepted with caveats</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_cefotiam/Cefotiam_Shah2019_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>Unbound total clearance</td><td>34.8</td><td>L/h</td><td><small>CLu</small></td></tr><tr><td>Unbound volume of distribution at steady-state</td><td>27.1</td><td>L</td><td><small>V</small></td></tr><tr><td>theta_q46_category</td><td>0.50</td><td></td><td><small>equation variable</small></td></tr></table><h4>About cefotiam</h4><p>Cefotiam is a second-generation cephalosporin antibiotic used to treat bacterial infections. It is an approved antibacterial for systemic use, given by injection, mainly in hospital settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3009984\">Wikidata Q3009984</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Cefotiam\">Cefotiam</a>.</p><h4>References</h4><ol><li><p>Shah NR et al. (2019). Novel Population Pharmacokinetic Approach to Explain the Differences between Cystic Fibrosis Patients and Healthy Volunteers via Protein Binding. <i>Pharmaceutics 11(6)</i>. DOI:<a href=\"https://doi.org/10.3390/pharmaceutics11060286\">10.3390/pharmaceutics11060286</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/31216743\">31216743</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Shah_2019: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: accepted with caveats</li></ul></body></html>"),
