model Cefbuperazone "Cefbuperazone — default model: Cefbuperazone_Watanabe1984_reference"
  extends Cefbuperazone_Watanabe1984_reference;
  annotation (Documentation(info = "<html><body><p>The default model of cefbuperazone: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01D_OtherBetaLactamAntibacterials.J01DC13_Cefbuperazone.Cefbuperazone_Watanabe1984_reference\">Cefbuperazone_Watanabe1984_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of cefbuperazone in this package:</p><ul><li><code>Cefbuperazone_Watanabe1984_reference</code></li></ul><h4>About cefbuperazone</h4><p>Cefbuperazone is a second-generation cephalosporin antibiotic used to treat bacterial infections. It is not an authorised medicine in the European Union and appears to be little used today.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5057221\">Wikidata Q5057221</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Cefbuperazone\">Cefbuperazone</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Cefbuperazone;
