  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>cefbuperazone</td></tr><tr><td>ATC code:</td><td>J01DC13</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Watanabe Y et al. 1984</td></tr><tr><td>population:</td><td>patients undergoing postoperative drainage</td></tr><tr><td>measured compound:</td><td>cefbuperazone</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_cefbuperazone/Cefbuperazone_Watanabe1984_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>T1/2</td><td>101</td><td>min.</td><td><small>t1/2z</small></td></tr><tr><td>Vd</td><td>4.06</td><td>L</td><td><small>V</small></td></tr><tr><td>Cl</td><td>76</td><td>ml/min</td><td><small>CL</small></td></tr></table><h4>About cefbuperazone</h4><p>Cefbuperazone is a second-generation cephalosporin antibiotic used to treat bacterial infections. It is not an authorised medicine in the European Union and appears to be little used today.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5057221\">Wikidata Q5057221</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Cefbuperazone\">Cefbuperazone</a>.</p><h4>References</h4><ol><li><p>Watanabe Y et al. (1984). [Penetration of cefbuperazone, a new cephamycin antibiotic, into human peritoneal exudate]. <i>The Japanese journal of antibiotics 37(2):261–266</i>. PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/6737691\">6737691</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Watanabe_1984: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
