within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01C_BetaLactamAntibacterialsPenicillins.J01CF04_Oxacillin;
model Oxacillin_Lee2026_reference
  parameter Real Cl_ref = 2.8055555555555556e-07 "Cl [m3/s]";
  parameter Real Vd_ref = 0.0018700000000000001 "Vd [m3]";
  extends Pharmacolibrary.Pharmacokinetic.Models.PK_1C(
