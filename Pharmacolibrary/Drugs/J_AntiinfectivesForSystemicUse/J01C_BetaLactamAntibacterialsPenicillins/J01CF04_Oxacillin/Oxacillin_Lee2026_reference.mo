  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>oxacillin</td></tr><tr><td>ATC code:</td><td>J01CF04</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Lee A et al. 2026</td></tr><tr><td>population:</td><td>preterm and term neonates and infants</td></tr><tr><td>measured compound:</td><td>oxacillin</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_oxacillin/Oxacillin_Lee2026_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>CL (Θ1)</td><td>1.01</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>V (Θ2)</td><td>1.87</td><td>L</td><td><small>V</small></td></tr></table><h4>About oxacillin</h4><p>Oxacillin is a penicillin antibiotic used to treat staphylococcal infections, including sepsis, urinary tract infections, cellulitis, osteomyelitis, infective endocarditis, and bacterial meningitis. It is an approved beta-lactamase–resistant penicillin, though it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q418725\">Wikidata Q418725</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Oxacillin\">Oxacillin</a>.</p><h4>References</h4><ol><li><p>Lee A et al. (2026). Population pharmacokinetics and safety of continuous oxacillin in preterm and term neonates and infants. <i>Antimicrobial agents and chemotherapy 70(6):e0177725</i>. DOI:<a href=\"https://doi.org/10.1128/aac.01777-25\">10.1128/aac.01777-25</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/42008655\">42008655</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Lee_2026: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Oxacillin_Lee2026_reference;
