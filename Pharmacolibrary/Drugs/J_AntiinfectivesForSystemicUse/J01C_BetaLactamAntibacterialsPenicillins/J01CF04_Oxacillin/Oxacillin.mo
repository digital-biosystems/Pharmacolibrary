within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01C_BetaLactamAntibacterialsPenicillins.J01CF04_Oxacillin;
model Oxacillin "Oxacillin — default model: Oxacillin_Lee2026_reference"
  extends Oxacillin_Lee2026_reference;
  annotation (Documentation(info = "<html><body><p>The default model of oxacillin: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01C_BetaLactamAntibacterialsPenicillins.J01CF04_Oxacillin.Oxacillin_Lee2026_reference\">Oxacillin_Lee2026_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of oxacillin in this package:</p><ul><li><code>Oxacillin_Lee2026_reference</code></li></ul><h4>About oxacillin</h4><p>Oxacillin is a penicillin antibiotic used to treat staphylococcal infections, including sepsis, urinary tract infections, cellulitis, osteomyelitis, infective endocarditis, and bacterial meningitis. It is an approved beta-lactamase–resistant penicillin, though it is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q418725\">Wikidata Q418725</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Oxacillin\">Oxacillin</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Oxacillin;
