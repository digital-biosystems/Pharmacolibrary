  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>amoxicillin</td></tr><tr><td>ATC code:</td><td>J01CA04</td></tr><tr><td>model:</td><td>one compartment, oral dosing <small>(PK_1C_enteral)</small></td></tr><tr><td>source:</td><td>van Dyk J et al. 2026</td></tr><tr><td>population:</td><td>children with severe community-acquired pneumonia</td></tr><tr><td>measured compound:</td><td>amoxicillin</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_amoxicillin/Amoxicillin_van2026_clavulanate\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>Clearance, CL/F (L/h) b</td><td>6.10</td><td>L/h</td><td><small>CL/F</small></td></tr><tr><td>Central volume, Vc/F (L) b</td><td>7.00</td><td>L</td><td><small>V/F</small></td></tr><tr><td>Lag time (h)</td><td>0.37</td><td>h</td><td><small>tlag</small></td></tr><tr><td>First-order absorption, ka (h⁻¹)</td><td>1.60</td><td>h⁻¹</td><td><small>kabs</small></td></tr><tr><td>Bioavailability, F</td><td>1</td><td>F</td><td><small>Fab</small></td></tr></table><h4>About amoxicillin</h4><p>Amoxicillin is a penicillin antibiotic used to treat many bacterial infections, including ear, sinus, respiratory and urinary tract infections, and it is also given in combination to eradicate Helicobacter pylori. It is widely used around the world, is included on the WHO list of essential medicines, and is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q201928\">Wikidata Q201928</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Amoxicillin\">Amoxicillin</a>.</p><h4>References</h4><ol><li><p>van Dyk J et al. (2026). Population pharmacokinetics of child-friendly dispersible amoxicillin/clavulanate tablets in African children with severe community acquired pneumonia. <i></i>. DOI:<a href=\"https://doi.org/10.64898/2026.09.18.26362138\">10.64898/2026.09.18.26362138</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from van_2026: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
