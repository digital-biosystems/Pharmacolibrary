  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>mezlocillin</td></tr><tr><td>ATC code:</td><td>J01CA10</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Jungbluth GL et al. 1989</td></tr><tr><td>population:</td><td>male Sprague-Dawley rats</td></tr><tr><td>measured compound:</td><td>mezlocillin</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_mezlocillin/Mezlocillin_Jungbluth1989_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>V3, ml/kg</td><td>86</td><td>ml/kg</td><td><small>V3</small></td></tr><tr><td>CL'</td><td>5.49</td><td>ml/min</td><td><small>CL</small></td></tr><tr><td>Vd</td><td>0.41</td><td>L/kg</td><td><small>V</small></td></tr></table><h4>About mezlocillin</h4><p>Mezlocillin is an extended-spectrum penicillin antibiotic used to treat bacterial infections such as sepsis, urinary tract, skin, and respiratory infections, including Pseudomonas and other gram-negative infections. It is an approved antibacterial, though it is not authorised in the European Union and is now used only in a limited number of countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3307752\">Wikidata Q3307752</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Mezlocillin\">Mezlocillin</a>.</p><h4>References</h4><ol><li><p>Jungbluth GL et al. (1989). Dose-dependent pharmacokinetics of mezlocillin in rats. <i>Antimicrobial agents and chemotherapy 33(6):839–843</i>. DOI:<a href=\"https://doi.org/10.1128/AAC.33.6.839\">10.1128/AAC.33.6.839</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/2764534\">2764534</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Jungbluth_1989: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
