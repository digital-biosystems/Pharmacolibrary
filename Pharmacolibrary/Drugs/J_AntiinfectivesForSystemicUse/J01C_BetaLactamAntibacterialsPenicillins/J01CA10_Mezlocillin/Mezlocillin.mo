within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01C_BetaLactamAntibacterialsPenicillins.J01CA10_Mezlocillin;
model Mezlocillin "Mezlocillin — default model: Mezlocillin_Jungbluth1989_reference"
  extends Mezlocillin_Jungbluth1989_reference;
  annotation (Documentation(info = "<html><body><p>The default model of mezlocillin: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01C_BetaLactamAntibacterialsPenicillins.J01CA10_Mezlocillin.Mezlocillin_Jungbluth1989_reference\">Mezlocillin_Jungbluth1989_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of mezlocillin in this package:</p><ul><li><code>Mezlocillin_Jungbluth1989_reference</code></li><li><code>Mezlocillin_Modr1982_reference</code></li></ul><h4>About mezlocillin</h4><p>Mezlocillin is an extended-spectrum penicillin antibiotic used to treat bacterial infections such as sepsis, urinary tract, skin, and respiratory infections, including Pseudomonas and other gram-negative infections. It is an approved antibacterial, though it is not authorised in the European Union and is now used only in a limited number of countries.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3307752\">Wikidata Q3307752</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Mezlocillin\">Mezlocillin</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 1123200, Tolerance = 1e-9, Interval = 1));
end Mezlocillin;
