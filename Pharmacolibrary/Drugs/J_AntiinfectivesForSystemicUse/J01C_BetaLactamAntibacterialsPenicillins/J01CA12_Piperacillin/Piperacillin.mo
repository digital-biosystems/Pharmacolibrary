within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01C_BetaLactamAntibacterialsPenicillins.J01CA12_Piperacillin;
model Piperacillin "Piperacillin — default model: Piperacillin_Sulaiman2026_reference"
  extends Piperacillin_Sulaiman2026_reference;
  annotation (Documentation(info = "<html><body><p>The default model of piperacillin: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01C_BetaLactamAntibacterialsPenicillins.J01CA12_Piperacillin.Piperacillin_Sulaiman2026_reference\">Piperacillin_Sulaiman2026_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of piperacillin in this package:</p><ul><li><code>Piperacillin_Dohmann2025_reference</code></li><li><code>Piperacillin_Sulaiman2026_reference</code></li></ul><h4>About piperacillin</h4><p>Piperacillin is an extended-spectrum penicillin antibiotic used to treat bacterial infections such as sepsis, urinary tract, skin, and respiratory infections, including Pseudomonas and E. coli infections. It is an approved medicine, typically given by infusion, and is often combined with tazobactam in hospital settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q423787\">Wikidata Q423787</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Piperacillin\">Piperacillin</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Piperacillin;
