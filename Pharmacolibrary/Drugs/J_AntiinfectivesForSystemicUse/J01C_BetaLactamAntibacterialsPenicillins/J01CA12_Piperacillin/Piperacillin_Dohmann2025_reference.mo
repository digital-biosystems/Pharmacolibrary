  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>piperacillin</td></tr><tr><td>ATC code:</td><td>J01CA12</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Dohmann E et al. 2025</td></tr><tr><td>population:</td><td>patients with impaired renal function</td></tr><tr><td>measured compound:</td><td>piperacillin</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_piperacillin/Piperacillin_Dohmann2025_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>Vdpop (L)</td><td>15.42</td><td>L</td><td><small>V</small></td></tr><tr><td>βBSA</td><td>1.46</td><td></td><td><small>allometric_exponent</small></td></tr><tr><td>CLpop (L/h)</td><td>3.52</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>CLHD (L/h)</td><td>3.96</td><td>L/h</td><td><small>CL_HD</small></td></tr></table><h4>About piperacillin</h4><p>Piperacillin is an extended-spectrum penicillin antibiotic used to treat bacterial infections such as sepsis, urinary tract, skin, and respiratory infections, including Pseudomonas and E. coli infections. It is an approved medicine, typically given by infusion, and is often combined with tazobactam in hospital settings.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q423787\">Wikidata Q423787</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Piperacillin\">Piperacillin</a>.</p><h4>References</h4><ol><li><p>Dohmann E et al. (2025). Probability of pharmacokinetic/pharmacodynamic target attainment for different piperacillin/tazobactam dosing regimens in renally impaired patients in a non-intensive care unit setting. <i>British journal of clinical pharmacology 91(11):3070–3081</i>. DOI:<a href=\"https://doi.org/10.1002/bcp.70153\">10.1002/bcp.70153</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/40582359\">40582359</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Dohmann_2025: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
