  extends Sulbactam_Abouelhassan2024v2_100_mg_kg;
  annotation (Documentation(info = "<html><body><p>The default model of sulbactam: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01C_BetaLactamAntibacterialsPenicillins.J01CG01_Sulbactam.Sulbactam_Abouelhassan2024v2_100_mg_kg\">Sulbactam_Abouelhassan2024v2_100_mg_kg</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of sulbactam in this package:</p><ul><li><code>Sulbactam_Abouelhassan2024v2_100_mg_kg</code></li><li><code>Sulbactam_Yokoyama2014_PD_killing_effect_of_sulbactam_log_10</code></li><li><code>Sulbactam_Yokoyama2014_PD_killing_effect_of_sulbactam_log_2</code></li></ul><h4>About sulbactam</h4><p>Sulbactam is an antibiotic that works as a beta-lactamase inhibitor, used in combination with other antibacterials to treat bacterial infections. It is an approved medicine and is used in clinical practice, though it is not an authorised EU medicine via the EMA.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q423393\">Wikidata Q423393</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Sulbactam\">Sulbactam</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Sulbactam;
