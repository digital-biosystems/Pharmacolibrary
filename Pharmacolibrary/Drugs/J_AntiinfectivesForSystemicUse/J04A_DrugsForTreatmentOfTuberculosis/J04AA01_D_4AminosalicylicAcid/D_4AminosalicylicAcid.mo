within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J04A_DrugsForTreatmentOfTuberculosis.J04AA01_D_4AminosalicylicAcid;
model D_4AminosalicylicAcid "D 4AminosalicylicAcid — default model: D_4AminosalicylicAcid_de2014_reference"
  extends D_4AminosalicylicAcid_de2014_reference;
  annotation (Documentation(info = "<html><body><p>The default model of 4-aminosalicylic acid: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J04A_DrugsForTreatmentOfTuberculosis.J04AA01_D_4AminosalicylicAcid.D_4AminosalicylicAcid_de2014_reference\">D_4AminosalicylicAcid_de2014_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of 4-aminosalicylic acid in this package:</p><ul><li><code>D_4AminosalicylicAcid_de2014_reference</code></li></ul><h4>About 4-aminosalicylic acid</h4><p>4-Aminosalicylic acid is an antibiotic used to treat tuberculosis and has also been used for Crohn's colitis. It remains in clinical use and is included on the WHO list of essential medicines.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q229924\">Wikidata Q229924</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.AminosalicylicAcid4\">AminosalicylicAcid4</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end D_4AminosalicylicAcid;
