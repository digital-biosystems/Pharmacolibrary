within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01F_MacrolidesLincosamidesAndStreptogramins.J01FA02_Spiramycin;
model Spiramycin "Spiramycin — default model: Spiramycin_Elazab2021_iv"
  extends Spiramycin_Elazab2021_iv;
  annotation (Documentation(info = "<html><body><p>The default model of spiramycin: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01F_MacrolidesLincosamidesAndStreptogramins.J01FA02_Spiramycin.Spiramycin_Elazab2021_iv\">Spiramycin_Elazab2021_iv</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of spiramycin in this package:</p><ul><li><code>Spiramycin_Elazab2021_iv</code></li><li><code>Spiramycin_Elazab2021_oral</code></li></ul><h4>About spiramycin</h4><p>Spiramycin is a macrolide antibiotic used to treat bacterial infections and has also been used as a coccidiostat. It remains an approved antibacterial for systemic use, available alone and in combination with other antibiotics, though it has been withdrawn in some markets.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q422265\">Wikidata Q422265</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Spiramycin\">Spiramycin</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Spiramycin;
