within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01F_MacrolidesLincosamidesAndStreptogramins.J01FA09_Clarithromycin;
model Clarithromycin "Clarithromycin — default model: Clarithromycin_Shah2025_reference"
  extends Clarithromycin_Shah2025_reference;
  annotation (Documentation(info = "<html><body><p>The default model of clarithromycin: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01F_MacrolidesLincosamidesAndStreptogramins.J01FA09_Clarithromycin.Clarithromycin_Shah2025_reference\">Clarithromycin_Shah2025_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of clarithromycin in this package:</p><ul><li><code>Clarithromycin_Shah2025_reference</code></li><li><code>Clarithromycin_Singh2025_PD_rlu</code></li></ul><h4>About clarithromycin</h4><p>Clarithromycin is a macrolide antibiotic used to treat many bacterial infections, including respiratory, skin, ear, and throat infections, and to help eradicate Helicobacter pylori in peptic ulcer disease. It is widely used in human medicine and appears on the WHO list of essential medicines, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q118551\">Wikidata Q118551</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Clarithromycin\">Clarithromycin</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Clarithromycin;
