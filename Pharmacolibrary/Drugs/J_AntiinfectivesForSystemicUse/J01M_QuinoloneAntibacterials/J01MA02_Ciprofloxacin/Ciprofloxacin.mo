within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01M_QuinoloneAntibacterials.J01MA02_Ciprofloxacin;
model Ciprofloxacin "Ciprofloxacin — default model: Ciprofloxacin_Alihodzic2022_reference"
  extends Ciprofloxacin_Alihodzic2022_reference;
  annotation (Documentation(info = "<html><body><p>The default model of ciprofloxacin: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01M_QuinoloneAntibacterials.J01MA02_Ciprofloxacin.Ciprofloxacin_Alihodzic2022_reference\">Ciprofloxacin_Alihodzic2022_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of ciprofloxacin in this package:</p><ul><li><code>Ciprofloxacin_Abada1994_reference</code></li><li><code>Ciprofloxacin_Alihodzic2022_reference</code></li><li><code>Ciprofloxacin_Dowling1995_reference</code></li><li><code>Ciprofloxacin_Forrest1993_reference</code></li><li><code>Ciprofloxacin_Guo2022_reference</code></li><li><code>Ciprofloxacin_Santavy2023_reference</code></li><li><code>Ciprofloxacin_Campion2005_PD_viable_count_s_r</code></li><li><code>Ciprofloxacin_Zhu2026_PD_bis</code></li></ul><h4>About ciprofloxacin</h4><p>Ciprofloxacin is a fluoroquinolone antibiotic used to treat many bacterial infections, including urinary tract infections, pneumonia, typhoid fever, gonorrhea, and bone and joint infections. It is widely used worldwide and appears on the WHO list of essential medicines, available as tablets and also as eye and ear preparations.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q256602\">Wikidata Q256602</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Ciprofloxacin\">Ciprofloxacin</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Ciprofloxacin;
