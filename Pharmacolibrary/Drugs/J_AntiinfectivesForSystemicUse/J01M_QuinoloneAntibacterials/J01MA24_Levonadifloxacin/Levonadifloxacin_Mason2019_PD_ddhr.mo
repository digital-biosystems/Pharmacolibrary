within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01M_QuinoloneAntibacterials.J01MA24_Levonadifloxacin;
model Levonadifloxacin_Mason2019_PD_ddhr
  "linear exposure-response sweep — Mason_2019 :: ddHR (Heart Rate)"
  extends Pharmacolibrary.Interfaces.PartialExposureResponseSweep(
    E0 = 0.9456,      // [bpm]
    Emax = 0, EC50 = 1,      // unused by a line
    exposure_per_s = 0.001);
  parameter Real slope = 0.3937   "[bpm/(μg×mL−1)]";
equation
  response = E0 + slope*exposure;
  annotation(experiment(StartTime = 0, StopTime = 1000, Interval = 2),
    Documentation(info = "<html><body><h4>Levonadifloxacin_Mason2019_PD_ddhr</h4><p>The steady-state exposure-response curve of Mason JW et al., <i>Clinical and translational science 12(1):47–52</i> 2019 (<a href=\"https://doi.org/10.1111/cts.12594\">doi:10.1111/cts.12594</a>) — Heart Rate [bpm] against levonadifloxacin μg/mL — obtained by sweeping the driver instead of simulating a dose. Model family: linear.</p><h4>The parameters, in the paper's terms</h4><pre>  E0    =     0.9456 bpm      drug-free response (baseline) (intercept, Q324)
  slope =     0.3937 bpm/(μg×mL−1) change in response per unit of exposure (slope, Q335)</pre><p>The algebra is <code>response = E0 + slope*exposure</code>; this model only supplies the numbers. The x axis is one μg/mL of levonadifloxacin per second of simulated time (exposure is in kg/m3): there is no state, no dose and no kinetics — plot <code>response</code> against <code>exposure</code> (or <code>time</code>).</p><h4>What it reproduces</h4><pre>  exposure = 0         response 0.9456   (drug-free)</pre></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Mason_2019: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"));
end Levonadifloxacin_Mason2019_PD_ddhr;
