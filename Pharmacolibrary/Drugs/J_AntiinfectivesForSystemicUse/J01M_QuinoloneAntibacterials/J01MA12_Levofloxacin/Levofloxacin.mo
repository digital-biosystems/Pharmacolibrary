within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01M_QuinoloneAntibacterials.J01MA12_Levofloxacin;
model Levofloxacin "Levofloxacin — default model: Levofloxacin_Setiawan2022_mean"
  extends Levofloxacin_Setiawan2022_mean;
  annotation (Documentation(info = "<html><body><p>The default model of levofloxacin: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01M_QuinoloneAntibacterials.J01MA12_Levofloxacin.Levofloxacin_Setiawan2022_mean\">Levofloxacin_Setiawan2022_mean</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of levofloxacin in this package:</p><ul><li><code>Levofloxacin_Setiawan2022_mean</code></li><li><code>Levofloxacin_Setiawan2022_median</code></li></ul><h4>About levofloxacin</h4><p>Levofloxacin is a fluoroquinolone antibiotic used to treat a range of bacterial infections, including pneumonia, sinusitis, urinary tract infections, and tuberculosis, and it is also used to help eradicate Helicobacter pylori. It is widely used and appears on the WHO essential medicines list; in the European Union an authorised product exists mainly for respiratory tract infections and cystic fibrosis, and it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q424193\">Wikidata Q424193</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Levofloxacin\">Levofloxacin</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 345600, Tolerance = 1e-9, Interval = 1));
end Levofloxacin;
