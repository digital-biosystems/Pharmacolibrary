  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>moxifloxacin</td></tr><tr><td>ATC code:</td><td>J01MA14</td></tr><tr><td>model:</td><td>one compartment, oral dosing <small>(PK_1C_enteral)</small></td></tr><tr><td>source:</td><td>Greenberg RG et al. 2022</td></tr><tr><td>population:</td><td>children</td></tr><tr><td>measured compound:</td><td>moxifloxacin</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_moxifloxacin/Moxifloxacin_Greenberg2022_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>CL</td><td>18.2</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>V</td><td>167</td><td>L</td><td><small>V</small></td></tr><tr><td>F</td><td>0.76</td><td></td><td><small>Fab</small></td></tr><tr><td>ka</td><td>2.21</td><td>1/h</td><td><small>kabs</small></td></tr><tr><td>t1/2</td><td>6.36</td><td>h</td><td><small>t1/2z</small></td></tr></table><h4>About moxifloxacin</h4><p>Moxifloxacin is a fluoroquinolone antibiotic used to treat bacterial infections such as pneumonia, sinusitis, bronchitis, conjunctivitis, and urinary tract infections. It is an approved medicine, included on the WHO essential medicines list, and is used both systemically and as eye drops, though it carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q424940\">Wikidata Q424940</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Moxifloxacin\">Moxifloxacin</a>.</p><h4>References</h4><ol><li><p>Greenberg RG et al. (2022). Population Pharmacokinetics of Moxifloxacin in Children. <i>Paediatric drugs 24(2):163–173</i>. DOI:<a href=\"https://doi.org/10.1007/s40272-022-00493-3\">10.1007/s40272-022-00493-3</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/35284983\">35284983</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Greenberg_2022: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 122400, Tolerance = 1e-9, Interval = 1));
