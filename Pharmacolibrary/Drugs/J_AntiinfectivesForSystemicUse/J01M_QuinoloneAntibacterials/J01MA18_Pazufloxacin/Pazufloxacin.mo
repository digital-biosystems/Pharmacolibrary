  annotation (Documentation(info = "<html><body><p>The default model of pazufloxacin: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01M_QuinoloneAntibacterials.J01MA18_Pazufloxacin.Pazufloxacin_Umezaki2022_reference\">Pazufloxacin_Umezaki2022_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of pazufloxacin in this package:</p><ul><li><code>Pazufloxacin_Umezaki2022_reference</code></li></ul><h4>About pazufloxacin</h4><p>Pazufloxacin is a fluoroquinolone antibacterial that has been investigated as an antituberculous drug. It is not an approved medicine in major markets such as the European Union and remains investigational.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3898423\">Wikidata Q3898423</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Pazufloxacin\">Pazufloxacin</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 432000, Tolerance = 1e-9, Interval = 1));
end Pazufloxacin;
