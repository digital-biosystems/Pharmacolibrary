within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J02A_AntimycoticsForSystemicUse.J02AX04_Caspofungin;
model Caspofungin "Caspofungin — default model: Caspofungin_BorsukDe2020_reference"
  extends Caspofungin_BorsukDe2020_reference;
  annotation (Documentation(info = "<html><body><p>The default model of caspofungin: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J02A_AntimycoticsForSystemicUse.J02AX04_Caspofungin.Caspofungin_BorsukDe2020_reference\">Caspofungin_BorsukDe2020_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of caspofungin in this package:</p><ul><li><code>Caspofungin_AbdulAziz2025_reference</code></li><li><code>Caspofungin_BorsukDe2020_reference</code></li></ul><h4>About caspofungin</h4><p>Caspofungin is an antifungal used to treat candidiasis and aspergillosis. It is an approved, systemically used antifungal and is authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q420875\">Wikidata Q420875</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Caspofungin\">Caspofungin</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 136800, Tolerance = 1e-9, Interval = 1));
end Caspofungin;
