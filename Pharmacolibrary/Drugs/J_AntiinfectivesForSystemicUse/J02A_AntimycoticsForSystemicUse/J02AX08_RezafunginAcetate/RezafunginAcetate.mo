  extends RezafunginAcetate_Rubino2021_reference;
  annotation (Documentation(info = "<html><body><p>The default model of rezafungin acetate: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J02A_AntimycoticsForSystemicUse.J02AX08_RezafunginAcetate.RezafunginAcetate_Rubino2021_reference\">RezafunginAcetate_Rubino2021_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of rezafungin acetate in this package:</p><ul><li><code>RezafunginAcetate_Roepcke2023_reference</code></li><li><code>RezafunginAcetate_Rubino2021_reference</code></li></ul><h4>About rezafungin acetate</h4><p>Rezafungin acetate is an antifungal medicine used to treat invasive candida infections of the bloodstream. It is a newer antifungal that has been authorised in the United States but is not approved in the European Union.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 604800, Tolerance = 1e-9, Interval = 1));
end RezafunginAcetate;
