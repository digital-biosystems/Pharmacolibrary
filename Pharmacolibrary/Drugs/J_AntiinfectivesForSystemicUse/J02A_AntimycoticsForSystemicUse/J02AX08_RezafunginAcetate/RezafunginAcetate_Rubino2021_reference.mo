within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J02A_AntimycoticsForSystemicUse.J02AX08_RezafunginAcetate;
model RezafunginAcetate_Rubino2021_reference
  parameter Real Cl_ref = 7.055555555555556e-08 "Cl [m3/s]";
  parameter Real cov_albumin = 1.0 "albumin covariate (reference 1.0)";
  parameter Real Vd_ref = 0.0111 "Vd [m3]";
  extends Pharmacolibrary.Pharmacokinetic.Models.PK_2C(
    weight = 70.0,
    F = 1,
    Cl = Cl_ref*(cov_albumin/1.0)^(-0.844),
    Vd = Vd_ref,
    adminDuration = 600,
    adminCount = 1,
    MM = 1.226412,
    adminMass = 5e-05,
    k12 = 1.3538538538538538e-05,
    k21 = 1.0292998477929986e-05
  );

  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>rezafungin_acetate</td></tr><tr><td>ATC code:</td><td>J02AX08</td></tr><tr><td>model:</td><td>two compartments, IV dosing <small>(PK_2C)</small></td></tr><tr><td>source:</td><td>Rubino CM et al. 2021</td></tr><tr><td>population:</td><td>healthy volunteers and patients with fungal infections</td></tr><tr><td>measured compound:</td><td>rezafungin</td></tr><tr><td>review:</td><td>accepted with caveats</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_rezafungin_acetate/RezafunginAcetate_Rubino2021_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>CL, liter/h</td><td>0.254</td><td>liter/h</td><td><small>CL</small></td></tr><tr><td>theta_cl_albumin_power</td><td>-0.844</td><td></td><td><small>equation variable</small></td></tr><tr><td>Vc, liter</td><td>11.1</td><td>liter</td><td><small>V1</small></td></tr><tr><td>Vp1, liter</td><td>14.6</td><td>liter</td><td><small>V2</small></td></tr><tr><td>theta_v2_weight_power</td><td>1.14</td><td></td><td><small>equation variable</small></td></tr><tr><td>CLd2, liter/h</td><td>0.541</td><td>liter/h</td><td><small>Q</small></td></tr><tr><td>Vp2, liter</td><td>6.69</td><td>liter</td><td><small>V3</small></td></tr><tr><td>theta_v3_weight_power</td><td>2.47</td><td></td><td><small>equation variable</small></td></tr><tr><td>theta_v2_albumin_power</td><td>-0.829</td><td></td><td><small>equation variable</small></td></tr></table><h4>About rezafungin_acetate</h4><p>Rezafungin acetate is an antifungal medicine used to treat invasive candida infections of the bloodstream. It is a newer antifungal that has been authorised in the United States but is not approved in the European Union.</p><p><small><b>Unverified</b> — written by glm-5.3-flash from general knowledge (no Wikidata entry found) and the WHO ATC classification; not checked by a person.</small></p><h4>References</h4><ol><li><p>Rubino CM et al. (2021). Population Pharmacokinetics of Rezafungin in Patients with Fungal Infections. <i>Antimicrobial agents and chemotherapy 65(11):e0084221</i>. DOI:<a href=\"https://doi.org/10.1128/AAC.00842-21\">10.1128/AAC.00842-21</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/34398673\">34398673</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Rubino_2021: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: accepted with caveats</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 604800, Tolerance = 1e-9, Interval = 1));
end RezafunginAcetate_Rubino2021_reference;
