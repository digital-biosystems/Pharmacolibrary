  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>voriconazole</td></tr><tr><td>ATC code:</td><td>J02AC03</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Wang J et al. 2024</td></tr><tr><td>population:</td><td>elderly Chinese patients with invasive aspergillosis</td></tr><tr><td>measured compound:</td><td>voriconazole</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_voriconazole/Voriconazole_Wang2024_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>typical clearance rate of voriconazole</td><td>3.22</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>typical volume of distribution</td><td>194</td><td>L</td><td><small>V</small></td></tr></table><h4>About voriconazole</h4><p>Voriconazole is an antifungal medicine used to treat serious fungal infections such as aspergillosis, candidiasis, and other systemic mycoses. It is authorised in the European Union and is included on the WHO list of essential medicines, so it is widely used for systemic fungal infections.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q412236\">Wikidata Q412236</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Voriconazole\">Voriconazole</a>.</p><h4>References</h4><ol><li><p>Wang J et al. (2024). Population Pharmacokinetics of Voriconazole and Dose Optimization in Elderly Chinese Patients. <i>Journal of clinical pharmacology 64(2):253–263</i>. DOI:<a href=\"https://doi.org/10.1002/jcph.2357\">10.1002/jcph.2357</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/37766506\">37766506</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Wang_2024: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 777600, Tolerance = 1e-9, Interval = 1));
