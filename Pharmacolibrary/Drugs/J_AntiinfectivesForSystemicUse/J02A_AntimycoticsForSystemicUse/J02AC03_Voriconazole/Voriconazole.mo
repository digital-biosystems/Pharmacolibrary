within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J02A_AntimycoticsForSystemicUse.J02AC03_Voriconazole;
model Voriconazole "Voriconazole — default model: Voriconazole_Wang2024_reference"
  extends Voriconazole_Wang2024_reference;
  annotation (Documentation(info = "<html><body><p>The default model of voriconazole: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J02A_AntimycoticsForSystemicUse.J02AC03_Voriconazole.Voriconazole_Wang2024_reference\">Voriconazole_Wang2024_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of voriconazole in this package:</p><ul><li><code>Voriconazole_Wang2024_reference</code></li></ul><h4>About voriconazole</h4><p>Voriconazole is an antifungal medicine used to treat serious fungal infections such as aspergillosis, candidiasis, and other systemic mycoses. It is authorised in the European Union and is included on the WHO list of essential medicines, so it is widely used for systemic fungal infections.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q412236\">Wikidata Q412236</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Voriconazole\">Voriconazole</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 777600, Tolerance = 1e-9, Interval = 1));
end Voriconazole;
