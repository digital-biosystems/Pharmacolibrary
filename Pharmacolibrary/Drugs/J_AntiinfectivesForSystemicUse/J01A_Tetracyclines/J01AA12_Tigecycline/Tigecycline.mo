within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01A_Tetracyclines.J01AA12_Tigecycline;
model Tigecycline "Tigecycline — default model: Tigecycline_Bastida2022_reference"
  extends Tigecycline_Bastida2022_reference;
  annotation (Documentation(info = "<html><body><p>The default model of tigecycline: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01A_Tetracyclines.J01AA12_Tigecycline.Tigecycline_Bastida2022_reference\">Tigecycline_Bastida2022_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of tigecycline in this package:</p><ul><li><code>Tigecycline_Bastida2022_reference</code></li><li><code>Tigecycline_Song2024_crrt</code></li><li><code>Tigecycline_Song2024_non_crrt</code></li><li><code>Tigecycline_Deshpande2025_PD_bacterial_burden</code></li><li><code>Tigecycline_Deshpande2025_PD_bacterial_burden_2</code></li></ul><h4>About tigecycline</h4><p>Tigecycline is a tetracycline antibiotic used to treat bacterial infections, including pneumonia and complicated skin, soft tissue, and intra-abdominal infections. It is authorised in the European Union and used mainly in hospital settings for serious bacterial infections.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q420595\">Wikidata Q420595</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Tigecycline\">Tigecycline</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Tigecycline;
