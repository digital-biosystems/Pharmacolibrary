within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01A_Tetracyclines.J01AA13_Eravacycline;
model Eravacycline "Eravacycline — default model: Eravacycline_Ji2025_reference"
  extends Eravacycline_Ji2025_reference;
  annotation (Documentation(info = "<html><body><p>The default model of eravacycline: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01A_Tetracyclines.J01AA13_Eravacycline.Eravacycline_Ji2025_reference\">Eravacycline_Ji2025_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of eravacycline in this package:</p><ul><li><code>Eravacycline_Ji2025_reference</code></li><li><code>Eravacycline_Zhanel2016_reference</code></li><li><code>Eravacycline_Singh2026_PD_mab_burden</code></li><li><code>Eravacycline_Singh2026_PD_mab_burden_2</code></li><li><code>Eravacycline_Singh2026_PD_mab_burden_3</code></li><li><code>Eravacycline_Singh2026_PD_mab_burden_4</code></li><li><code>Eravacycline_Singh2026_PD_mab_burden_5</code></li><li><code>Eravacycline_Singh2026_PD_mab_burden_6</code></li><li><code>Eravacycline_Singh2026_PD_mab_burden_7</code></li><li><code>Eravacycline_Singh2026_PD_mab_burden_8</code></li></ul><h4>About eravacycline</h4><p>Eravacycline is a tetracycline antibacterial used to treat bacterial infections. It is an approved medicine, with one product authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q15410941\">Wikidata Q15410941</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Eravacycline\">Eravacycline</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Eravacycline;
