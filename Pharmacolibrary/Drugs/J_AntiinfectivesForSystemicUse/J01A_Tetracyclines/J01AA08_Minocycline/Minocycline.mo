within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01A_Tetracyclines.J01AA08_Minocycline;
model Minocycline "Minocycline — default model: Minocycline_Pardos2024_reference"
  extends Minocycline_Pardos2024_reference;
  annotation (Documentation(info = "<html><body><p>The default model of minocycline: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01A_Tetracyclines.J01AA08_Minocycline.Minocycline_Pardos2024_reference\">Minocycline_Pardos2024_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of minocycline in this package:</p><ul><li><code>Minocycline_Pardos2024_reference</code></li><li><code>Minocycline_Tynan2016_reference</code></li></ul><h4>About minocycline</h4><p>Minocycline is a tetracycline antibiotic used to treat bacterial infections such as acne, rosacea, meningitis, anthrax, brucellosis, and gum disease. It is an approved medicine, used both systemically for infections and topically for acne, as well as in oral preparations for dental infections.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q415336\">Wikidata Q415336</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Minocycline\">Minocycline</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Minocycline;
