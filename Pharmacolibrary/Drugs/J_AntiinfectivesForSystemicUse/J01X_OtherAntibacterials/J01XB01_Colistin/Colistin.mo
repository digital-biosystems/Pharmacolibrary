within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01X_OtherAntibacterials.J01XB01_Colistin;
model Colistin "Colistin — default model: Colistin_Ma2026_reference"
  extends Colistin_Ma2026_reference;
  annotation (Documentation(info = "<html><body><p>The default model of colistin: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01X_OtherAntibacterials.J01XB01_Colistin.Colistin_Ma2026_reference\">Colistin_Ma2026_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of colistin in this package:</p><ul><li><code>Colistin_Ma2026_reference</code></li></ul><h4>About colistin</h4><p>Colistin is a polymyxin antibiotic used to treat serious infections caused by resistant Gram-negative bacteria, and also as an intestinal antiinfective for gut decontamination. It remains in clinical use but is generally reserved for hospital treatment of multidrug-resistant infections when other antibiotics are not suitable.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q418946\">Wikidata Q418946</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Colistin\">Colistin</a>.</p></body></html>", revisions = "<html><body><ul><li>10/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Colistin;
