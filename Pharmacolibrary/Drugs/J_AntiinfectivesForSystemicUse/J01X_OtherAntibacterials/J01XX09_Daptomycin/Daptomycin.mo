within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01X_OtherAntibacterials.J01XX09_Daptomycin;
model Daptomycin "Daptomycin — default model: Daptomycin_Lou2021_reference"
  extends Daptomycin_Lou2021_reference;
  annotation (Documentation(info = "<html><body><p>The default model of daptomycin: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01X_OtherAntibacterials.J01XX09_Daptomycin.Daptomycin_Lou2021_reference\">Daptomycin_Lou2021_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of daptomycin in this package:</p><ul><li><code>Daptomycin_Lou2021_reference</code></li></ul><h4>About daptomycin</h4><p>Daptomycin is an antibiotic used to treat serious bacterial infections, mainly those caused by gram-positive bacteria such as staphylococci, including skin infections, bacteremia, and infective endocarditis. It is an approved medicine authorised in the European Union and is generally used in hospital settings for severe infections.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q418747\">Wikidata Q418747</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Daptomycin\">Daptomycin</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 259200, Tolerance = 1e-9, Interval = 1));
end Daptomycin;
