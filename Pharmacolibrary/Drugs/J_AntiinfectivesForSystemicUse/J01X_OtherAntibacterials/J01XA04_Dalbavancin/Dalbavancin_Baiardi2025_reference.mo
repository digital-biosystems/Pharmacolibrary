  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>dalbavancin</td></tr><tr><td>ATC code:</td><td>J01XA04</td></tr><tr><td>model:</td><td>two compartments, IV dosing <small>(PK_2C)</small></td></tr><tr><td>source:</td><td>Baiardi G et al. 2025</td></tr><tr><td>population:</td><td>adult patients with renal function CLcr &gt; 30 mL/min</td></tr><tr><td>measured compound:</td><td>dalbavancin</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_dalbavancin/Dalbavancin_Baiardi2025_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>CL (L/h)</td><td>0.0273</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>V1 (L)</td><td>3.6</td><td>L</td><td><small>V1</small></td></tr><tr><td>Q (L/h)</td><td>0.0225</td><td>L/h</td><td><small>Q</small></td></tr><tr><td>V2 (L)</td><td>6.4</td><td>L</td><td><small>V2</small></td></tr></table><h4>About dalbavancin</h4><p>Dalbavancin is a lipoglycopeptide antibiotic used to treat bacterial skin and soft tissue infections such as cellulitis, including infections caused by MRSA. It is approved and authorised in the European Union, where it is used for these infections.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5210237\">Wikidata Q5210237</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Dalbavancin\">Dalbavancin</a>.</p><h4>References</h4><ol><li><p>Baiardi G et al. (2025). Multidose Dalbavancin Population Pharmacokinetic Analysis for Prolonged Target Attainment in Patients Requiring Long-Term Treatment. <i>Antibiotics (Basel, Switzerland) 14(2)</i>. DOI:<a href=\"https://doi.org/10.3390/antibiotics14020190\">10.3390/antibiotics14020190</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/40001433\">40001433</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Baiardi_2025: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
