within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01X_OtherAntibacterials.J01XA04_Dalbavancin;
model Dalbavancin "Dalbavancin — default model: Dalbavancin_Baiardi2025_reference"
  extends Dalbavancin_Baiardi2025_reference;
  annotation (Documentation(info = "<html><body><p>The default model of dalbavancin: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01X_OtherAntibacterials.J01XA04_Dalbavancin.Dalbavancin_Baiardi2025_reference\">Dalbavancin_Baiardi2025_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of dalbavancin in this package:</p><ul><li><code>Dalbavancin_Baiardi2025_reference</code></li></ul><h4>About dalbavancin</h4><p>Dalbavancin is a lipoglycopeptide antibiotic used to treat bacterial skin and soft tissue infections such as cellulitis, including infections caused by MRSA. It is approved and authorised in the European Union, where it is used for these infections.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5210237\">Wikidata Q5210237</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Dalbavancin\">Dalbavancin</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 1728000, Tolerance = 1e-9, Interval = 1));
end Dalbavancin;
