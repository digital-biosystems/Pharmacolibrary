within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J05A_DirectActingAntivirals.J05AJ02_Elvitegravir;
model Elvitegravir "Elvitegravir — default model: Elvitegravir_Barcel2016_reference"
  extends Elvitegravir_Barcel2016_reference;
  annotation (Documentation(info = "<html><body><p>The default model of elvitegravir: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J05A_DirectActingAntivirals.J05AJ02_Elvitegravir.Elvitegravir_Barcel2016_reference\">Elvitegravir_Barcel2016_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of elvitegravir in this package:</p><ul><li><code>Elvitegravir_Barcel2016_reference</code></li></ul><h4>About elvitegravir</h4><p>Elvitegravir is an antiviral drug used to treat HIV infections, acting as an integrase inhibitor. It is an approved medicine used in fixed-dose combination antiviral products for HIV treatment, including in the European Union, although one EU product has been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2740966\">Wikidata Q2740966</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Elvitegravir\">Elvitegravir</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 100800, Tolerance = 1e-9, Interval = 1));
end Elvitegravir;
