  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>elvitegravir</td></tr><tr><td>ATC code:</td><td>J05AJ02</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Barceló C et al. 2016</td></tr><tr><td>population:</td><td>HIV-1-infected individuals</td></tr><tr><td>measured compound:</td><td>elvitegravir</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_elvitegravir/Elvitegravir_Barcel2016_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>Clearance</td><td>7.6</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>volume of distribution</td><td>61</td><td>L</td><td><small>V</small></td></tr></table><h4>About elvitegravir</h4><p>Elvitegravir is an antiviral drug used to treat HIV infections, acting as an integrase inhibitor. It is an approved medicine used in fixed-dose combination antiviral products for HIV treatment, including in the European Union, although one EU product has been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2740966\">Wikidata Q2740966</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Elvitegravir\">Elvitegravir</a>.</p><h4>References</h4><ol><li><p>Barceló C et al. (2016). Population pharmacokinetic analysis of elvitegravir and cobicistat in HIV-1-infected individuals. <i>The Journal of antimicrobial chemotherapy 71(7):1933–1942</i>. DOI:<a href=\"https://doi.org/10.1093/jac/dkw050\">10.1093/jac/dkw050</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/27029846\">27029846</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Barceló_2016: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 100800, Tolerance = 1e-9, Interval = 1));
