  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>abacavir</td></tr><tr><td>ATC code:</td><td>J05AF06</td></tr><tr><td>model:</td><td>two compartments, oral dosing <small>(PK_2C_enteral)</small></td></tr><tr><td>source:</td><td>Rabie H et al. 2020</td></tr><tr><td>population:</td><td>children with tuberculosis</td></tr><tr><td>measured compound:</td><td>abacavir</td></tr><tr><td>review:</td><td>accepted with caveats</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_abacavir/Abacavir_Rabie2020_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>Clearance (liters/h)c</td><td>9.67</td><td>liters/h</td><td><small>CL</small></td></tr><tr><td>Central vol of distribution (liters)c</td><td>8.76</td><td>liters</td><td><small>V1</small></td></tr><tr><td>Absorption rate constant ka; (1/h)</td><td>2.22</td><td>1/h</td><td><small>kabs</small></td></tr><tr><td>Bioavailability</td><td>1</td><td></td><td><small>Fab</small></td></tr><tr><td>Peripheral vol of distribution (liters)c</td><td>3.32</td><td>liters</td><td><small>V2/F</small></td></tr><tr><td>Intercompartmental clearance (liters/h)c</td><td>1.35</td><td>liters/h</td><td><small>Q</small></td></tr><tr><td>Absorption mean transit time (min)f</td><td>3.60</td><td>min</td><td><small>MTT</small></td></tr><tr><td>No. of transit compartments</td><td>1.03</td><td></td><td><small>n_transit</small></td></tr><tr><td>theta_q83_category</td><td>2.62</td><td></td><td><small>equation variable</small></td></tr></table><h4>About abacavir</h4><p>Abacavir is an antiviral medicine used to treat HIV infection and HIV/AIDS. It is widely used, appears on the WHO essential medicines list, and is authorised in the European Union, typically in combination products for HIV treatment.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q304330\">Wikidata Q304330</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Abacavir\">Abacavir</a>.</p><h4>References</h4><ol><li><p>Rabie H et al. (2020). Abacavir Exposure in Children Cotreated for Tuberculosis with Rifampin and Superboosted Lopinavir-Ritonavir. <i>Antimicrobial agents and chemotherapy 64(5)</i>. DOI:<a href=\"https://doi.org/10.1128/AAC.01923-19\">10.1128/AAC.01923-19</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/32071055\">32071055</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Rabie_2020: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: accepted with caveats</li></ul></body></html>"),
