within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J05A_DirectActingAntivirals.J05AB06_Ganciclovir;
model Ganciclovir "Ganciclovir — default model: Ganciclovir_Li2020v2_final_model"
  extends Ganciclovir_Li2020v2_final_model;
  annotation (Documentation(info = "<html><body><p>The default model of ganciclovir: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J05A_DirectActingAntivirals.J05AB06_Ganciclovir.Ganciclovir_Li2020v2_final_model\">Ganciclovir_Li2020v2_final_model</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of ganciclovir in this package:</p><ul><li><code>Ganciclovir_Li2020v2_final_model</code></li><li><code>Ganciclovir_Li2020v2_model_i_the_3_4_allometric_model</code></li><li><code>Ganciclovir_Li2020v2_model_ii_the_simplest_wt_based_exponent</code></li><li><code>Ganciclovir_Li2020v2_model_iii_the_simplest_bsa_based_expone</code></li><li><code>Ganciclovir_Li2020v2_model_iv_the_maturation_model</code></li></ul><h4>About ganciclovir</h4><p>Ganciclovir is an antiviral drug used to treat cytomegalovirus infections, especially cytomegalovirus retinitis in people with HIV, and also eye infections such as herpes simplex virus keratitis. It is an approved medicine used in hospital settings for serious infections, and it carries a boxed warning because it can be toxic.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q417640\">Wikidata Q417640</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Ganciclovir\">Ganciclovir</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Ganciclovir;
