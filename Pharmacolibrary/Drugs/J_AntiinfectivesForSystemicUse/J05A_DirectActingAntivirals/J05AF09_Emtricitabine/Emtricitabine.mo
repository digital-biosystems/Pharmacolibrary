within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J05A_DirectActingAntivirals.J05AF09_Emtricitabine;
model Emtricitabine "Emtricitabine — default model: Emtricitabine_Valade2014_reference"
  extends Emtricitabine_Valade2014_reference;
  annotation (Documentation(info = "<html><body><p>The default model of emtricitabine: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J05A_DirectActingAntivirals.J05AF09_Emtricitabine.Emtricitabine_Valade2014_reference\">Emtricitabine_Valade2014_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of emtricitabine in this package:</p><ul><li><code>Emtricitabine_Valade2014_reference</code></li></ul><h4>About emtricitabine</h4><p>Emtricitabine is an antiretroviral medicine used to treat HIV infection, working as a nucleoside reverse transcriptase inhibitor. It is widely used and is on the WHO list of essential medicines; it is authorised in the European Union for HIV infections and is also available in fixed-dose combination products.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q422604\">Wikidata Q422604</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Emtricitabine\">Emtricitabine</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Emtricitabine;
