within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J05A_DirectActingAntivirals.J05AB18_Molnupiravir;
model Molnupiravir_Bihorel2023_reference
  parameter Real Cl_ref = 5.472222222222222e-07 "Cl [m3/s]";
  parameter Real cov_body_weight = 1.0 "body weight covariate (reference 1.0)";
  parameter Boolean cov_category_1 = false "category level 1";
  parameter Real Vd_ref = 0.005070000000000001 "Vd [m3]";
  extends Pharmacolibrary.Pharmacokinetic.Models.PK_2C_enteral(
    weight = 70.0,
    F = 1,
    Cl = Cl_ref*(cov_body_weight/1.0)^(14.0) + (1.525e-06)*(if cov_category_1 then 1 else 0),
    Vd = Vd_ref,
    adminDuration = 600,
    adminCount = 1,
    MM = Pharmacolibrary.Drugs.Substances.Molnupiravir.M,
    adminMass = 0.0008,
    ka = 0.0007138888888888888,
    Tlag = 0.0,
    k12 = 0.0003122945430637738,
    k21 = 0.00010844748858447488
  );

  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>molnupiravir</td></tr><tr><td>ATC code:</td><td>J05AB18</td></tr><tr><td>model:</td><td>two compartments, oral dosing <small>(PK_2C_enteral)</small></td></tr><tr><td>source:</td><td>Bihorel S et al. 2023</td></tr><tr><td>population:</td><td>adults with COVID-19 and healthy participants</td></tr><tr><td>measured compound:</td><td>NHC</td></tr><tr><td>review:</td><td>accepted with caveats</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_molnupiravir/Molnupiravir_Bihorel2023_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>Apparent central clearance in 80 kg participants, L/h</td><td>1.97</td><td>L/h</td><td><small>CL/F</small></td></tr><tr><td>power_of_body_weight_effect</td><td>14.0</td><td></td><td><small>equation variable</small></td></tr><tr><td>Apparent central volume in 28 kg/m2 BMI male participants, L</td><td>5.07</td><td>L</td><td><small>V1/F</small></td></tr><tr><td>Apparent distribution clearance, L/h</td><td>5.70</td><td>L/h</td><td><small>Q</small></td></tr><tr><td>Apparent peripheral volume, L</td><td>14.6</td><td>L</td><td><small>V2/F</small></td></tr><tr><td>First‐order absorption rate constant, 1/h</td><td>2.57</td><td>1/h</td><td><small>kabs</small></td></tr><tr><td>Mean absorption transit time, h</td><td>5.39</td><td>h</td><td><small>MAT</small></td></tr><tr><td>proportional_shift_in_oral_solution</td><td>5.49</td><td></td><td><small>equation variable</small></td></tr><tr><td>Number of transit compartments</td><td>16.5</td><td></td><td><small>n_transit</small></td></tr><tr><td>Relative bioavailability</td><td>1.00</td><td></td><td><small>Frel</small></td></tr><tr><td>theta_q314_category</td><td>11.8</td><td></td><td><small>equation variable</small></td></tr><tr><td>theta_q314_bmi_power</td><td>13.1</td><td></td><td><small>equation variable</small></td></tr><tr><td>theta_frel_category</td><td>6.29</td><td></td><td><small>equation variable</small></td></tr></table><h4>About molnupiravir</h4><p>Molnupiravir is an antiviral drug that was developed for the treatment of COVID-19 infection. Its marketing authorisation application in the European Union was withdrawn, and it remains investigational rather than an approved medicine.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q96376832\">Wikidata Q96376832</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Molnupiravir\">Molnupiravir</a>.</p><h4>References</h4><ol><li><p>Bihorel S et al. (2023). Population pharmacokinetics of molnupiravir in adults with COVID-19: Lack of clinically important exposure variation across individuals. <i>CPT: pharmacometrics &amp; systems pharmacology 12(12):1859–1871</i>. DOI:<a href=\"https://doi.org/10.1002/psp4.13031\">10.1002/psp4.13031</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/37798914\">37798914</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Bihorel_2023: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: accepted with caveats</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Molnupiravir_Bihorel2023_reference;
