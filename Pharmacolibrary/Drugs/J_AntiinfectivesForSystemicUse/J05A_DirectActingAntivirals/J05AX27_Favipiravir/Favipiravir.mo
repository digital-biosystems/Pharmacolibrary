within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J05A_DirectActingAntivirals.J05AX27_Favipiravir;
model Favipiravir "Favipiravir — default model: Favipiravir_Agyeman2026_reference"
  extends Favipiravir_Agyeman2026_reference;
  annotation (Documentation(info = "<html><body><p>The default model of favipiravir: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J05A_DirectActingAntivirals.J05AX27_Favipiravir.Favipiravir_Agyeman2026_reference\">Favipiravir_Agyeman2026_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of favipiravir in this package:</p><ul><li><code>Favipiravir_Agyeman2026_reference</code></li></ul><h4>About favipiravir</h4><p>Favipiravir is an antiviral drug investigated for treating infections caused by RNA viruses. It is not authorised in the European Union and remains an investigational drug, though it has been approved in some places.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q16934561\">Wikidata Q16934561</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Favipiravir\">Favipiravir</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 169200, Tolerance = 1e-9, Interval = 1));
end Favipiravir;
