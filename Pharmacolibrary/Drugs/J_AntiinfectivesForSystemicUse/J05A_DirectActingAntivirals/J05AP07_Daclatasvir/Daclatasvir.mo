within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J05A_DirectActingAntivirals.J05AP07_Daclatasvir;
model Daclatasvir "Daclatasvir — default model: Daclatasvir_Osawa2018_reference"
  extends Daclatasvir_Osawa2018_reference;
  annotation (Documentation(info = "<html><body><p>The default model of daclatasvir: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J05A_DirectActingAntivirals.J05AP07_Daclatasvir.Daclatasvir_Osawa2018_reference\">Daclatasvir_Osawa2018_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of daclatasvir in this package:</p><ul><li><code>Daclatasvir_Osawa2018_reference</code></li></ul><h4>About daclatasvir</h4><p>Daclatasvir is an antiviral drug used to treat chronic hepatitis C, including in patients with liver cirrhosis. It was authorised in the European Union but that authorisation has expired, so it is no longer marketed there, though it has been included in the WHO essential medicines list.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q5207712\">Wikidata Q5207712</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Daclatasvir\">Daclatasvir</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 165600, Tolerance = 1e-9, Interval = 1));
end Daclatasvir;
