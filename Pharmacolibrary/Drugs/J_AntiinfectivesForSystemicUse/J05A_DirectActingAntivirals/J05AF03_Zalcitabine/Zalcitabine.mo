within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J05A_DirectActingAntivirals.J05AF03_Zalcitabine;
model Zalcitabine "Zalcitabine — default model: Zalcitabine_Adams1998_reference"
  extends Zalcitabine_Adams1998_reference;
  annotation (Documentation(info = "<html><body><p>The default model of zalcitabine: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J05A_DirectActingAntivirals.J05AF03_Zalcitabine.Zalcitabine_Adams1998_reference\">Zalcitabine_Adams1998_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of zalcitabine in this package:</p><ul><li><code>Zalcitabine_Adams1998_reference</code></li></ul><h4>About zalcitabine</h4><p>Zalcitabine is a nucleoside reverse transcriptase inhibitor that was used to treat HIV infection and AIDS. It has been withdrawn and is no longer used.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2344582\">Wikidata Q2344582</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Zalcitabine\">Zalcitabine</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Zalcitabine;
