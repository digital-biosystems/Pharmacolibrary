within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J05A_DirectActingAntivirals.J05AF04_Stavudine;
model Stavudine "Stavudine — default model: Stavudine_Jullien2007_reference"
  extends Stavudine_Jullien2007_reference;
  annotation (Documentation(info = "<html><body><p>The default model of stavudine: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J05A_DirectActingAntivirals.J05AF04_Stavudine.Stavudine_Jullien2007_reference\">Stavudine_Jullien2007_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of stavudine in this package:</p><ul><li><code>Stavudine_Jullien2007_reference</code></li></ul><h4>About stavudine</h4><p>Stavudine is a nucleoside reverse-transcriptase inhibitor that was used to treat HIV infection and AIDS.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q423984\">Wikidata Q423984</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Stavudine\">Stavudine</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Stavudine;
