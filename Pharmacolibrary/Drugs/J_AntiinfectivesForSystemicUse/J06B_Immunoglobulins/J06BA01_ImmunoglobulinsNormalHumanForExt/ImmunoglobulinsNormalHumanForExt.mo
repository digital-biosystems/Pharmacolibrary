  extends ImmunoglobulinsNormalHumanForExtravascularAdm_Zhang2020_refe;
  annotation (Documentation(info = "<html><body><p>The default model of immunoglobulins, normal human, for extravascular adm.: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J06B_Immunoglobulins.J06BA01_ImmunoglobulinsNormalHumanForExt.ImmunoglobulinsNormalHumanForExtravascularAdm_Zhang2020_refe\">ImmunoglobulinsNormalHumanForExtravascularAdm_Zhang2020_refe</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of immunoglobulins, normal human, for extravascular adm. in this package:</p><ul><li><code>ImmunoglobulinsNormalHumanForExtravascularAdm_Zhang2020_refe</code></li></ul><h4>About immunoglobulins, normal human, for extravascular adm.</h4><p>Hizentra is a pharmaceutical product containing normal human immunoglobulin, a class of medicines used for immune-related conditions. It is classified in the ATC system under normal human immunoglobulins for systemic antiinfective use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q57266522\">Wikidata Q57266522</a> and the WHO ATC classification; not checked by a person.</small></p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 9072000, Tolerance = 1e-9, Interval = 1));
end ImmunoglobulinsNormalHumanForExt;
