within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J06B_Immunoglobulins.J06BD05_Sotrovimab;
model Sotrovimab "Sotrovimab — default model: Sotrovimab_Sager2023_reference"
  extends Sotrovimab_Sager2023_reference;
  annotation (Documentation(info = "<html><body><p>The default model of sotrovimab: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J06B_Immunoglobulins.J06BD05_Sotrovimab.Sotrovimab_Sager2023_reference\">Sotrovimab_Sager2023_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of sotrovimab in this package:</p><ul><li><code>Sotrovimab_Sager2023_reference</code></li></ul><h4>About sotrovimab</h4><p>Sotrovimab is a monoclonal antibody used to treat COVID-19. It has been approved and used against COVID-19, though its marketing authorisation in the European Union has been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q106943333\">Wikidata Q106943333</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Sotrovimab\">Sotrovimab</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 518400, Tolerance = 1e-9, Interval = 1));
end Sotrovimab;
