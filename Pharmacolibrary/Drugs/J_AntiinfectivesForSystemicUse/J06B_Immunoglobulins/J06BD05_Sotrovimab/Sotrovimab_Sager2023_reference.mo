within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J06B_Immunoglobulins.J06BD05_Sotrovimab;
model Sotrovimab_Sager2023_reference
  parameter Real Cl_ref = 1.5393518518518518e-08 "Cl [m3/s]";
  parameter Real cov_bmi = 1.0 "bmi covariate (reference 1.0)";
  parameter Boolean cov_category_1 = false "category level 1";
  parameter Real Vd_ref = 0.0022 "Vd [m3]";
  extends Pharmacolibrary.Pharmacokinetic.Models.PK_2C(
    weight = 70.0,
    F = 1,
    Cl = Cl_ref*(cov_bmi/1.0)^(20.0) + (1.3773148148148148e-07)*(if cov_category_1 then 1 else 0),
    Vd = Vd_ref,
    adminDuration = 600,
    adminCount = 1,
    adminMass = 0.00025,
    k12 = 7.838804713804713e-06,
    k21 = 1.3064674523007855e-05
  );

  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>sotrovimab</td></tr><tr><td>ATC code:</td><td>J06BD05</td></tr><tr><td>model:</td><td>two compartments, IV dosing <small>(PK_2C)</small></td></tr><tr><td>source:</td><td>Sager JE et al. 2023</td></tr><tr><td>population:</td><td>patients with mild to moderate COVID-19</td></tr><tr><td>measured compound:</td><td>sotrovimab</td></tr><tr><td>review:</td><td>accepted with caveats</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_sotrovimab/Sotrovimab_Sager2023_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>Elimination clearance in participants of 83.6 kg (L/day)</td><td>1.33</td><td>L/day</td><td><small>CL</small></td></tr><tr><td>Central volume of distribution (L)</td><td>2.20</td><td>L</td><td><small>V1</small></td></tr><tr><td>Distribution clearance (L/day)</td><td>1.49</td><td>L/day</td><td><small>Q</small></td></tr><tr><td>Peripheral volume of distribution in participants of 83.6 kg (L)</td><td>1.32</td><td>L</td><td><small>V2</small></td></tr><tr><td>power_of_bmi_effect</td><td>20.0</td><td></td><td><small>equation variable</small></td></tr><tr><td>proportional_shift_in_female_participants</td><td>11.9</td><td></td><td><small>equation variable</small></td></tr><tr><td>i.m. bioavailability in male participants</td><td>2.64</td><td></td><td><small>Fab</small></td></tr><tr><td>theta_q319_body_weight_power</td><td>6.08</td><td></td><td><small>equation variable</small></td></tr><tr><td>theta_q49_bmi_absorption_rate_in_male_participants_with_of_30.41_kg_m2_l_h</td><td>4.67</td><td></td><td><small>equation variable</small></td></tr><tr><td>theta_q900_category</td><td>16.4</td><td></td><td><small>equation variable</small></td></tr></table><h4>About sotrovimab</h4><p>Sotrovimab is a monoclonal antibody used to treat COVID-19. It has been approved and used against COVID-19, though its marketing authorisation in the European Union has been withdrawn.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q106943333\">Wikidata Q106943333</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Sotrovimab\">Sotrovimab</a>.</p><h4>References</h4><ol><li><p>Sager JE et al. (2023). Population pharmacokinetics and exposure-response analysis of a single dose of sotrovimab in the early treatment of patients with mild to moderate COVID-19. <i>CPT: pharmacometrics &amp; systems pharmacology 12(6):853–864</i>. DOI:<a href=\"https://doi.org/10.1002/psp4.12958\">10.1002/psp4.12958</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/36922886\">36922886</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Sager_2023: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: accepted with caveats</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 518400, Tolerance = 1e-9, Interval = 1));
end Sotrovimab_Sager2023_reference;
