  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>arbekacin</td></tr><tr><td>ATC code:</td><td>J01GB12</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Suzuki K et al. 2003</td></tr><tr><td>population:</td><td>preterm and term newborn infants</td></tr><tr><td>measured compound:</td><td>arbekacin</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_arbekacin/Arbekacin_Suzuki2003_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>Vd</td><td>0.5</td><td>L/kg</td><td><small>V</small></td></tr><tr><td>CL</td><td>0.59</td><td>L/h</td><td><small>CL</small></td></tr></table><h4>About arbekacin</h4><p>Arbekacin is an aminoglycoside antibiotic that kills bacteria and is used as an anti-infective agent. It is considered investigational and is not authorised in the European Union.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q4784668\">Wikidata Q4784668</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Arbekacin\">Arbekacin</a>.</p><h4>References</h4><ol><li><p>Suzuki K et al. (2003). Pharmacokinetics and dosing of arbekacin in preterm and term newborn infants. <i>Pediatrics international : official journal of the Japan Pediatric Society 45(2):175–179</i>. DOI:<a href=\"https://doi.org/10.1046/j.1442-200x.2003.01679.x\">10.1046/j.1442-200x.2003.01679.x</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/12709144\">12709144</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Suzuki_2003: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 777600, Tolerance = 1e-9, Interval = 1));
end Arbekacin_Suzuki2003_reference;
