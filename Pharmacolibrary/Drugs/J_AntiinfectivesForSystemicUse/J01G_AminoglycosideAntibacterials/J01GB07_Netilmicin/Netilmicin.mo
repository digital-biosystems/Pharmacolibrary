within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01G_AminoglycosideAntibacterials.J01GB07_Netilmicin;
model Netilmicin "Netilmicin — default model: Netilmicin_Sherwin2008_reference"
  extends Netilmicin_Sherwin2008_reference;
  annotation (Documentation(info = "<html><body><p>The default model of netilmicin: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01G_AminoglycosideAntibacterials.J01GB07_Netilmicin.Netilmicin_Sherwin2008_reference\">Netilmicin_Sherwin2008_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of netilmicin in this package:</p><ul><li><code>Netilmicin_Sherwin2008_reference</code></li></ul><h4>About netilmicin</h4><p>Netilmicin is an aminoglycoside antibiotic used to treat serious bacterial infections, including eye infections. It is an approved medicine and is used mainly in hospital settings for severe infections, given by injection, with ophthalmic formulations also available.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q2553496\">Wikidata Q2553496</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Netilmicin\">Netilmicin</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 100800, Tolerance = 1e-9, Interval = 1));
end Netilmicin;
