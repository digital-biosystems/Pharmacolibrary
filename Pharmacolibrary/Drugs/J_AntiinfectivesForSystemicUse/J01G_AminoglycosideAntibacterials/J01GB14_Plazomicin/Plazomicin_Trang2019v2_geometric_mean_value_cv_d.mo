  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>plazomicin</td></tr><tr><td>ATC code:</td><td>J01GB14</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Trang M et al. 2019</td></tr><tr><td>population:</td><td>adult patients with cUTI/AP and serious infections caused by CRE</td></tr><tr><td>measured compound:</td><td>plazomicin</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_plazomicin/Plazomicin_Trang2019v2_geometric_mean_value_cv_d\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>AUC0–24 (mg·h/liter)a</td><td>248</td><td>mg·h/L</td><td><small>AUCt</small></td></tr><tr><td>CL (liters/h)</td><td>4.50</td><td>liters/h</td><td><small>CL</small></td></tr><tr><td>Cmax (mg/liter)b</td><td>84.6</td><td>mg/L</td><td><small>Cmax</small></td></tr><tr><td>Cmin (mg/liter)c</td><td>0.372</td><td>mg/L</td><td><small>Cmin</small></td></tr><tr><td>t1/2,α (h)</td><td>0.328</td><td>h</td><td><small>t1/2α</small></td></tr><tr><td>t1/2,β (h)</td><td>2.77</td><td>h</td><td><small>t1/2β</small></td></tr><tr><td>t1/2,γ (h)</td><td>25.8</td><td>h</td><td><small>t1/2γ</small></td></tr><tr><td>Vss (liters)</td><td>25.0</td><td>liters</td><td><small>Vss</small></td></tr><tr><td>Tigecycline 4 Vc (L)</td><td>100.2</td><td>L</td><td><small>V</small></td></tr></table><h4>About plazomicin</h4><p>Plazomicin is an aminoglycoside antibacterial used to treat serious bacterial infections. It is an approved medicine, but it is not authorised in the European Union and carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q15426988\">Wikidata Q15426988</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Plazomicin\">Plazomicin</a>.</p><h4>References</h4><ol><li><p>Trang M et al. (2019). Population Pharmacokinetic Analyses for Plazomicin Using Pooled Data from Phase 1, 2, and 3 Clinical Studies. <i>Antimicrobial agents and chemotherapy 63(4)</i>. DOI:<a href=\"https://doi.org/10.1128/AAC.02329-18\">10.1128/AAC.02329-18</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/30670433\">30670433</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Trang_2019_2: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
