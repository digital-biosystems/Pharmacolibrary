  extends Plazomicin_Trang2019v2_geometric_mean_value_cv_d;
  annotation (Documentation(info = "<html><body><p>The default model of plazomicin: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01G_AminoglycosideAntibacterials.J01GB14_Plazomicin.Plazomicin_Trang2019v2_geometric_mean_value_cv_d\">Plazomicin_Trang2019v2_geometric_mean_value_cv_d</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of plazomicin in this package:</p><ul><li><code>Plazomicin_Trang2019v2_geometric_mean_value_cv_d</code></li></ul><h4>About plazomicin</h4><p>Plazomicin is an aminoglycoside antibacterial used to treat serious bacterial infections. It is an approved medicine, but it is not authorised in the European Union and carries a boxed warning.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q15426988\">Wikidata Q15426988</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Plazomicin\">Plazomicin</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Plazomicin;
