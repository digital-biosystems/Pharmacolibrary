  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>dibekacin</td></tr><tr><td>ATC code:</td><td>J01GB09</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Arancibia A et al. 1995</td></tr><tr><td>population:</td><td>healthy volunteers and patients with renal failure</td></tr><tr><td>measured compound:</td><td>dibekacin</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_dibekacin/Dibekacin_Arancibia1995_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>t1/2 beta</td><td>2.12</td><td>h</td><td><small>t1/2β</small></td></tr><tr><td>k10</td><td>0.642</td><td>h-1</td><td><small>kel</small></td></tr><tr><td>Cl</td><td>0.882</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>Vd(area)</td><td>0.162</td><td>l/kg</td><td><small>V</small></td></tr><tr><td>r</td><td>0.982</td><td></td><td><small>equation variable</small></td></tr></table><h4>About dibekacin</h4><p>Dibekacin is an aminoglycoside antibiotic, related to kanamycin, used to treat bacterial infections. It is an approved medicine and is used mainly in Japan and some other Asian countries, given by injection or as eye drops.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3706873\">Wikidata Q3706873</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Dibekacin\">Dibekacin</a>.</p><h4>References</h4><ol><li><p>Arancibia A et al. (1995). Disposition kinetics of dibekacin in patients with renal failure and in patients undergoing hemodialysis. <i>International journal of clinical pharmacology and therapeutics 33(11):623–627</i>. PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/8688988\">8688988</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Arancibia_1995: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
