within Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01G_AminoglycosideAntibacterials.J01GB09_Dibekacin;
model Dibekacin "Dibekacin — default model: Dibekacin_Arancibia1995_reference"
  extends Dibekacin_Arancibia1995_reference;
  annotation (Documentation(info = "<html><body><p>The default model of dibekacin: <a href=\"modelica://Pharmacolibrary.Drugs.J_AntiinfectivesForSystemicUse.J01G_AminoglycosideAntibacterials.J01GB09_Dibekacin.Dibekacin_Arancibia1995_reference\">Dibekacin_Arancibia1995_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of dibekacin in this package:</p><ul><li><code>Dibekacin_Arancibia1995_reference</code></li></ul><h4>About dibekacin</h4><p>Dibekacin is an aminoglycoside antibiotic, related to kanamycin, used to treat bacterial infections. It is an approved medicine and is used mainly in Japan and some other Asian countries, given by injection or as eye drops.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q3706873\">Wikidata Q3706873</a> and the WHO ATC classification; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Dibekacin\">Dibekacin</a>.</p></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Dibekacin;
