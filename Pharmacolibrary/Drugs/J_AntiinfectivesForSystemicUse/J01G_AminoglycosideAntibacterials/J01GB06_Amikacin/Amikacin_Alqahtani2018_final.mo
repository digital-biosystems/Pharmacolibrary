  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>amikacin</td></tr><tr><td>ATC code:</td><td>J01GB06</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Alqahtani S et al. 2018</td></tr><tr><td>population:</td><td>non-critical pediatric patients with suspected or proven Gram-negative infection</td></tr><tr><td>measured compound:</td><td>amikacin</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/drug_amikacin/Amikacin_Alqahtani2018_final\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>CL (L/h)</td><td>1.2</td><td>L/h</td><td><small>CL</small></td></tr><tr><td>V (L)</td><td>6.5</td><td>L</td><td><small>V</small></td></tr></table><h4>About amikacin</h4><p>Amikacin is an aminoglycoside antibiotic used to treat serious bacterial infections, including gram-negative and Pseudomonas infections, sepsis, meningitis, endocarditis, and mycobacterial infections. It is widely used and appears on the WHO essential medicines list, with authorised products in the European Union; it is also approved for veterinary use.</p><p><small>Summary written by glm-5.3-flash from <a href=\"https://www.wikidata.org/wiki/Q408529\">Wikidata Q408529</a> and the WHO ATC classification and the EMA medicines list; not checked by a person.</small></p><p>Identity, molar mass and metabolites: <a href=\"modelica://Pharmacolibrary.Drugs.Substances.Amikacin\">Amikacin</a>.</p><h4>References</h4><ol><li><p>Alqahtani S et al. (2018). Optimizing Amikacin Dosage in Pediatrics Based on Population Pharmacokinetic/Pharmacodynamic Modeling. <i>Paediatric drugs 20(3):265–272</i>. DOI:<a href=\"https://doi.org/10.1007/s40272-018-0288-y\">10.1007/s40272-018-0288-y</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/29569124\">29569124</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Alqahtani_2018: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
