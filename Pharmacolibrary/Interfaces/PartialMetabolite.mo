within Pharmacolibrary.Interfaces;
partial package PartialMetabolite "Constants of a metabolite, nested in its parent's Drugs.Substances package"
  extends Modelica.Icons.MaterialPropertiesPackage;
  constant String name = "";
  constant String pubchemCid = "";
  constant String formula = "";
  constant Modelica.Units.SI.MolarMass M = 0 "molar mass; 0 = unknown";
end PartialMetabolite;
