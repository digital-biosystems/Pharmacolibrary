  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>4-Hydroxybutyric acid</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Cuypers C et al. 2025</td></tr><tr><td>population:</td><td>six stress-resistant Landrace pigs</td></tr><tr><td>measured compound:</td><td>gamma-hydroxybutyric acid</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/toxin_4_hydroxybutyric_acid/D_4HydroxybutyricAcid_Cuypers2025_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>Mean maximum blood concentration of GHB</td><td>1171.1</td><td>μg mL-1</td><td><small>Cmax</small></td></tr><tr><td>volume of distribution</td><td>335.3</td><td>mL kg-1</td><td><small>V</small></td></tr><tr><td>clearance</td><td>77.2</td><td>mL kg-1 hour-1</td><td><small>CL</small></td></tr><tr><td>elimination half-life</td><td>3.10</td><td>hours</td><td><small>t1/2z</small></td></tr></table><h4>References</h4><ol><li><p>Cuypers C et al. (2025). Cardiorespiratory effects of gamma-hydroxybutyric acid during isoflurane anaesthesia in pigs. <i>Veterinary anaesthesia and analgesia 52(1):25–34</i>. DOI:<a href=\"https://doi.org/10.1016/j.vaa.2024.10.135\">10.1016/j.vaa.2024.10.135</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/39638708\">39638708</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Cuypers_2025: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
