  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>Chromic acid</td></tr><tr><td>model:</td><td>retention function (body burden), no volume or clearance <small>(TK_Retention)</small></td></tr><tr><td>source:</td><td>Van Bruwaene R et al. 1984</td></tr><tr><td>population:</td><td>lactating dairy cows</td></tr><tr><td>measured compound:</td><td>Chromium (51Cr)</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/toxin_chromic_acid/ChromicAcid_Van1984_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>half-lives</td><td>0.88</td><td>days</td><td><small>t1/2z</small></td></tr><tr><td>of an oral cobalt dose is absorbed</td><td>1</td><td></td><td><small>fe</small></td></tr></table><h4>References</h4><ol><li><p>Van Bruwaene R et al. (1984). Metabolism of 51Cr, 54Mn, 59Fe and 60Co in lactating dairy cows. <i>Health physics 46(5):1069–1082</i>. DOI:<a href=\"https://doi.org/10.1097/00004032-198405000-00007\">10.1097/00004032-198405000-00007</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/6539319\">6539319</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Van_1984: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
