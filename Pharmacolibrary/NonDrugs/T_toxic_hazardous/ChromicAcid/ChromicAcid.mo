  annotation (Documentation(info = "<html><body><p>The default model of Chromic acid: <a href=\"modelica://Pharmacolibrary.NonDrugs.T_toxic_hazardous.ChromicAcid.ChromicAcid_Van1984_reference\">ChromicAcid_Van1984_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of Chromic acid in this package:</p><ul><li><code>ChromicAcid_Van1984_reference</code></li></ul><h4>About Chromic acid</h4></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 432000, Tolerance = 1e-9, Interval = 864.0));
