  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>Cadmium chloride</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Han M et al. 1994</td></tr><tr><td>population:</td><td>3 ewes</td></tr><tr><td>measured compound:</td><td>Cadmium</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/toxin_cadmium_chloride/CadmiumChloride_Han1994_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>half life of elimination</td><td>40</td><td>d</td><td><small>t1/2z</small></td></tr><tr><td>body clearance</td><td>0.3</td><td>L/kg/d</td><td><small>CLb</small></td></tr><tr><td>steady-state volume of distribution</td><td>6</td><td>L/kg</td><td><small>Vss</small></td></tr></table><h4>References</h4><ol><li><p>Han M et al. (1994). Pharmacokinetics of cadmium in ewes: a preliminary study. <i>Veterinary and human toxicology 36(3):185–188</i>. PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/8066960\">8066960</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Han_1994: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 15552000, Tolerance = 1e-9, Interval = 1));
end CadmiumChloride_Han1994_reference;
