  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>Cadmium chloride</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Houpert P et al. 1997</td></tr><tr><td>population:</td><td>lactating and nonlactating ewes</td></tr><tr><td>measured compound:</td><td>Cadmium</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/toxin_cadmium_chloride/CadmiumChloride_Houpert1997_ewe_7\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>k12/k21</td><td>1.30</td><td></td><td><small>equation variable</small></td></tr><tr><td>Vc (liter/kg)</td><td>0.03</td><td>liter/kg</td><td><small>V</small></td></tr><tr><td>Vss (liter/kg)</td><td>27.6</td><td>liter/kg</td><td><small>Vss</small></td></tr><tr><td>Cl (liter/kg/day)</td><td>0.35</td><td>liter/kg/day</td><td><small>CL</small></td></tr><tr><td>MRT (days)</td><td>78</td><td>days</td><td><small>MRT</small></td></tr><tr><td>F (%)</td><td>5</td><td>%</td><td><small>Fab</small></td></tr></table><h4>References</h4><ol><li><p>Houpert P et al. (1997). Toxicokinetics of cadmium in lactating and nonlactating ewes after oral and intravenous administration. <i>Environmental research 72(2):140–150</i>. DOI:<a href=\"https://doi.org/10.1006/enrs.1996.3690\">10.1006/enrs.1996.3690</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/9177656\">9177656</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Houpert_1997: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
