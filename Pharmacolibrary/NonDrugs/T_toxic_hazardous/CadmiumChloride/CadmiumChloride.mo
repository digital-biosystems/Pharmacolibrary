within Pharmacolibrary.NonDrugs.T_toxic_hazardous.CadmiumChloride;
model CadmiumChloride "CadmiumChloride — default model: CadmiumChloride_Han1994_reference"
  extends CadmiumChloride_Han1994_reference;
  annotation (Documentation(info = "<html><body><p>The default model of Cadmium chloride: <a href=\"modelica://Pharmacolibrary.NonDrugs.T_toxic_hazardous.CadmiumChloride.CadmiumChloride_Han1994_reference\">CadmiumChloride_Han1994_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of Cadmium chloride in this package:</p><ul><li><code>CadmiumChloride_Han1994_reference</code></li><li><code>CadmiumChloride_Houpert1997_ewe_7</code></li><li><code>CadmiumChloride_Houpert1997_lactating</code></li><li><code>CadmiumChloride_Matsuno1991_reference</code></li></ul><h4>About Cadmium chloride</h4></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 15552000, Tolerance = 1e-9, Interval = 1));
end CadmiumChloride;
