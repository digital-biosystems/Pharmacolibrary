within Pharmacolibrary.NonDrugs.T_toxic_hazardous.Cholesterol;
model Cholesterol "Cholesterol — default model: Cholesterol_Entringer2021_reference"
  extends Cholesterol_Entringer2021_reference;
  annotation (Documentation(info = "<html><body><p>The default model of Cholesterol: <a href=\"modelica://Pharmacolibrary.NonDrugs.T_toxic_hazardous.Cholesterol.Cholesterol_Entringer2021_reference\">Cholesterol_Entringer2021_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of Cholesterol in this package:</p><ul><li><code>Cholesterol_Entringer2021_reference</code></li></ul><h4>About Cholesterol</h4></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 100800, Tolerance = 1e-9, Interval = 201.6));
end Cholesterol;
