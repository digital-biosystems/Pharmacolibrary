  annotation (Documentation(info = "<html><body><p>The default model of Heparin: <a href=\"modelica://Pharmacolibrary.NonDrugs.T_toxic_hazardous.Heparin.Heparin_Palm1987_reference\">Heparin_Palm1987_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of Heparin in this package:</p><ul><li><code>Heparin_Palm1987_reference</code></li></ul><h4>About Heparin</h4></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 172.8));
end Heparin;
