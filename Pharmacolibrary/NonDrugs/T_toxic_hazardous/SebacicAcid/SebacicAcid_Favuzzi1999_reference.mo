within Pharmacolibrary.NonDrugs.T_toxic_hazardous.SebacicAcid;
model SebacicAcid_Favuzzi1999_reference
  parameter Real Cl_ref = 5.45279e-06 "Cl [m3/s]";
  parameter Real Vd_ref = 0.026817 "Vd [m3]";
  extends Pharmacolibrary.Pharmacokinetic.Models.PK_1C(
    weight = 70.0,
    F = 1,
    Cl = Cl_ref,
    Vd = Vd_ref,
    adminDuration = 600,
