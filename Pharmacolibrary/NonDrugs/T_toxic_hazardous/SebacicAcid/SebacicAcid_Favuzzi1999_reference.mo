    adminMass = 1e-05
  );

  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>Sebacic acid</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Favuzzi AM et al. 1999</td></tr><tr><td>population:</td><td>Wistar rats of both sexes</td></tr><tr><td>measured compound:</td><td>Sebacic acid (as disodium sebacate)</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/toxin_sebacic_acid/SebacicAcid_Favuzzi1999_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>Sb half-time</td><td>31.5</td><td>min</td><td><small>t1/2β</small></td></tr><tr><td>tissue elimination rate</td><td>0.0122</td><td>min-1</td><td><small>kel</small></td></tr><tr><td>overall volume of distribution</td><td>26.817</td><td>L</td><td><small>V</small></td></tr><tr><td>renal clearance</td><td>0.291</td><td>L/h</td><td><small>CLR</small></td></tr><tr><td>GFR</td><td>1</td><td>L/h</td><td><small>Q</small></td></tr></table><h4>References</h4><ol><li><p>Favuzzi AM et al. (1999). Pharmacokinetics of sebacic acid in rats. <i>European review for medical and pharmacological sciences 3(3):119–125</i>. PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/10827815\">10827815</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Favuzzi_1999: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end SebacicAcid_Favuzzi1999_reference;
