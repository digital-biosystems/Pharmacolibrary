  extends ProtoporphyrinIx_Ormrod2000_reference;
  annotation (Documentation(info = "<html><body><p>The default model of Protoporphyrin IX: <a href=\"modelica://Pharmacolibrary.NonDrugs.T_toxic_hazardous.ProtoporphyrinIx.ProtoporphyrinIx_Ormrod2000_reference\">ProtoporphyrinIx_Ormrod2000_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of Protoporphyrin IX in this package:</p><ul><li><code>ProtoporphyrinIx_Ormrod2000_reference</code></li><li><code>ProtoporphyrinIx_Webber1997_reference</code></li></ul><h4>About Protoporphyrin IX</h4></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 604800, Tolerance = 1e-9, Interval = 1209.6));
