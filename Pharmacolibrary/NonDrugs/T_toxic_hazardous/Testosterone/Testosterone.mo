within Pharmacolibrary.NonDrugs.T_toxic_hazardous.Testosterone;
model Testosterone "Testosterone — default model: Testosterone_Torne2007_reference"
  extends Testosterone_Torne2007_reference;
  annotation (Documentation(info = "<html><body><p>The default model of Testosterone: <a href=\"modelica://Pharmacolibrary.NonDrugs.T_toxic_hazardous.Testosterone.Testosterone_Torne2007_reference\">Testosterone_Torne2007_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of Testosterone in this package:</p><ul><li><code>Testosterone_Bi2018_bootstrapa_median</code></li><li><code>Testosterone_Bi2018_final_model_estimate</code></li><li><code>Testosterone_Torne2007_reference</code></li></ul><h4>About Testosterone</h4></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 144000, Tolerance = 1e-9, Interval = 288.0));
end Testosterone;
