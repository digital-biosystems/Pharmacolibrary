  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>Testosterone</td></tr><tr><td>model:</td><td>retention function (body burden), no volume or clearance <small>(TK_Retention)</small></td></tr><tr><td>source:</td><td>Tornøe CW et al. 2007</td></tr><tr><td>population:</td><td>healthy subjects, prostate cancer patients</td></tr><tr><td>measured compound:</td><td>LH, testosterone</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/toxin_testosterone/Testosterone_Torne2007_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>half-life of LH</td><td>1.3</td><td>h</td><td><small>t1/2z</small></td></tr><tr><td>Ka for SC TE</td><td>0.09</td><td>hour−1</td><td><small>kabs</small></td></tr></table><h4>References</h4><ol><li><p>Tornøe CW et al. (2007). Population pharmacokinetic/pharmacodynamic (PK/PD) modelling of the hypothalamic-pituitary-gonadal axis following treatment with GnRH analogues. <i>British journal of clinical pharmacology 63(6):648-664</i>. DOI:<a href=\"https://doi.org/10.1111/j.1365-2125.2006.02820.x\">10.1111/j.1365-2125.2006.02820.x</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/17096678\">17096678</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Tornøe_2007: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
