within Pharmacolibrary.NonDrugs.T_toxic_hazardous.Cesium137;
model Cesium137 "Cesium137 — default model: Cesium137_Pan2016_reference"
  extends Cesium137_Pan2016_reference;
  annotation (Documentation(info = "<html><body><p>The default model of Cesium-137: <a href=\"modelica://Pharmacolibrary.NonDrugs.T_toxic_hazardous.Cesium137.Cesium137_Pan2016_reference\">Cesium137_Pan2016_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of Cesium-137 in this package:</p><ul><li><code>Cesium137_HARRISON1963_reference</code></li><li><code>Cesium137_Kirchner1994_reference</code></li><li><code>Cesium137_Pan2016_reference</code></li><li><code>Cesium137_Talbot1993_reference</code></li><li><code>Cesium137_Thomas2018_reference</code></li></ul><h4>About Cesium-137</h4></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 1468800, Tolerance = 1e-9, Interval = 2937.6));
end Cesium137;
