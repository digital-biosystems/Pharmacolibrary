  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>Cesium-137</td></tr><tr><td>model:</td><td>retention function (body burden), no volume or clearance <small>(TK_Retention)</small></td></tr><tr><td>source:</td><td>Talbot RJ et al. 1993</td></tr><tr><td>population:</td><td>healthy male volunteers</td></tr><tr><td>measured compound:</td><td>Cesium-137</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/toxin_cesium_137/Cesium137_Talbot1993_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>Clearance of 137Cs between 1 and 15 wk showed a biological half-time of</td><td>102</td><td>d</td><td><small>t1/2z</small></td></tr></table><h4>References</h4><ol><li><p>Talbot RJ et al. (1993). Human uptake of 137Cs in mutton. <i>Health physics 64(6):600–604</i>. DOI:<a href=\"https://doi.org/10.1097/00004032-199306000-00004\">10.1097/00004032-199306000-00004</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/8491615\">8491615</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Talbot_1993: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
