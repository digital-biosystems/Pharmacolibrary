  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>Cesium-137</td></tr><tr><td>model:</td><td>retention function (body burden), no volume or clearance <small>(TK_Retention)</small></td></tr><tr><td>source:</td><td>Pan K et al. 2016</td></tr><tr><td>population:</td><td>marine bivalves (oysters, mussels, scallops)</td></tr><tr><td>measured compound:</td><td>Cesium-137</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/toxin_cesium_137/Cesium137_Pan2016_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>rate constant</td><td>0.207</td><td>d(-1)</td><td><small>kel</small></td></tr></table><h4>References</h4><ol><li><p>Pan K et al. (2016). Two-Compartment Kinetic Modeling of Radiocesium Accumulation in Marine Bivalves under Hypothetical Exposure Regimes. <i>Environmental science &amp; technology 50(5):2677–2684</i>. DOI:<a href=\"https://doi.org/10.1021/acs.est.5b05445\">10.1021/acs.est.5b05445</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/26824250\">26824250</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Pan_2016: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
