  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>Nickel sulfate</td></tr><tr><td>model:</td><td>retention function (body burden), no volume or clearance <small>(TK_Retention)</small></td></tr><tr><td>source:</td><td>Sunderman FW et al. 1989</td></tr><tr><td>population:</td><td>healthy human volunteers</td></tr><tr><td>measured compound:</td><td>Nickel</td></tr><tr><td>review:</td><td>accepted with caveats</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/toxin_nickel_sulfate/NickelSulfate_Sunderman1989_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>The elimination half-time (tl,J for absorbed nickel</td><td>28</td><td>hr</td><td><small>t1/2z</small></td></tr></table><h4>References</h4><ol><li><p>Sunderman FW et al. (1989). Nickel absorption and kinetics in human volunteers. <i>Proceedings of the Society for Experimental Biology and Medicine. Society for Experimental Biology and Medicine (New York, N.Y.) 191(1):5–11</i>. DOI:<a href=\"https://doi.org/10.3181/00379727-191-42881\">10.3181/00379727-191-42881</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/2717626\">2717626</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Sunderman_1989: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: accepted with caveats</li></ul></body></html>"),
