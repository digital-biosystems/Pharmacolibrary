  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>L-Arginine</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Wang J et al. 2018</td></tr><tr><td>population:</td><td>healthy Chinese volunteers</td></tr><tr><td>measured compound:</td><td>L-Arginine</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/toxin_l_arginine/LArginine_Wang2018_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>Vmax</td><td>18.8</td><td>mg/h</td><td><small>Vmax</small></td></tr><tr><td>Km</td><td>77.2</td><td>mg/L</td><td><small>Km</small></td></tr><tr><td>V</td><td>23.1</td><td>L</td><td><small>V</small></td></tr><tr><td>CL (liters/h) a</td><td>30.3</td><td>liters/h</td><td><small>CL</small></td></tr></table><h4>References</h4><ol><li><p>Wang J et al. (2018). Population pharmacokinetics of arginine glutamate in healthy Chinese volunteers. <i>Xenobiotica; the fate of foreign compounds in biological systems 48(8):809–817</i>. DOI:<a href=\"https://doi.org/10.1080/00498254.2017.1370745\">10.1080/00498254.2017.1370745</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/28925806\">28925806</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Wang_2018: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
