within Pharmacolibrary.NonDrugs.T_toxic_hazardous.LArginine;
model LArginine "LArginine — default model: LArginine_Wang2018_reference"
  extends LArginine_Wang2018_reference;
  annotation (Documentation(info = "<html><body><p>The default model of L-Arginine: <a href=\"modelica://Pharmacolibrary.NonDrugs.T_toxic_hazardous.LArginine.LArginine_Wang2018_reference\">LArginine_Wang2018_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of L-Arginine in this package:</p><ul><li><code>LArginine_Wang2018_reference</code></li><li><code>LArginine_Yeo2013_moderately_severemalaria_ref_15</code></li><li><code>LArginine_Yeo2013_severemalaria</code></li><li><code>LArginine_Brussee2016_PD_no</code></li></ul><h4>About L-Arginine</h4></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end LArginine;
