  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>Sodium selenite</td></tr><tr><td>model:</td><td>one compartment, oral dosing <small>(PK_1C_enteral)</small></td></tr><tr><td>source:</td><td>Jayachandran P et al. 2021</td></tr><tr><td>population:</td><td>patients with metastatic cancer</td></tr><tr><td>measured compound:</td><td>Selenium</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/toxin_sodium_selenite/SodiumSelenite_Jayachandran2021_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>ka, h−1</td><td>0.642</td><td>h−1</td><td><small>kabs</small></td></tr><tr><td>CL/F5.5, L/h</td><td>1.59</td><td>L/h</td><td><small>CL/F</small></td></tr><tr><td>V/F5.5, L</td><td>42.5</td><td>L</td><td><small>V/F</small></td></tr><tr><td>BASE, μg</td><td>5270</td><td>μg</td><td><small>equation variable</small></td></tr></table><h4>References</h4><ol><li><p>Jayachandran P et al. (2021). Clinical Pharmacokinetics of Oral Sodium Selenite and Dosing Implications in the Treatment of Patients with Metastatic Cancer. <i>Drugs in R&amp;D 21(2):169-178</i>. DOI:<a href=\"https://doi.org/10.1007/s40268-021-00340-9\">10.1007/s40268-021-00340-9</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/33866531\">33866531</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Jayachandran_2021: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
