within Pharmacolibrary.NonDrugs.T_toxic_hazardous.SodiumSelenite;
model SodiumSelenite "SodiumSelenite — default model: SodiumSelenite_Jayachandran2021_reference"
  extends SodiumSelenite_Jayachandran2021_reference;
  annotation (Documentation(info = "<html><body><p>The default model of Sodium selenite: <a href=\"modelica://Pharmacolibrary.NonDrugs.T_toxic_hazardous.SodiumSelenite.SodiumSelenite_Jayachandran2021_reference\">SodiumSelenite_Jayachandran2021_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of Sodium selenite in this package:</p><ul><li><code>SodiumSelenite_Brodin2015_reference</code></li><li><code>SodiumSelenite_Jayachandran2021_reference</code></li><li><code>SodiumSelenite_Patterson1992_reference</code></li></ul><h4>About Sodium selenite</h4></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 345600, Tolerance = 1e-9, Interval = 1));
end SodiumSelenite;
