  annotation (Documentation(info = "<html><body><p>The default model of Uranium-235: <a href=\"modelica://Pharmacolibrary.NonDrugs.T_toxic_hazardous.Uranium235.Uranium235_Kathren1986_reference\">Uranium235_Kathren1986_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of Uranium-235 in this package:</p><ul><li><code>Uranium235_Barber1995_class_q_intake_estimate_10_4_bq_in_vit</code></li><li><code>Uranium235_Barber1995_class_q_intake_estimate_10_4_bq_in_viv</code></li><li><code>Uranium235_Barber1995_class_q_intake_estimate_10_4_bq_ratio</code></li><li><code>Uranium235_Barber1995_class_y_intake_estimate_10_4_bq_in_viv</code></li><li><code>Uranium235_Kathren1986_reference</code></li><li><code>Uranium235_Morris1989_batchelor_priv_comm</code></li><li><code>Uranium235_Morris1989_james_et_al</code></li><li><code>Uranium235_Morris1989_morris_et_al_this_study</code></li><li><code>Uranium235_Morris1989_morris_et_al_unpubl</code></li><li><code>Uranium235_Morris1989_rhoads_et_al</code></li><li><code>Uranium235_Morris1989_sanders_et_al</code></li><li><code>Uranium235_Morris1989_stanley_et_al</code></li><li><code>Uranium235_Morris1990_batchelor</code></li><li><code>Uranium235_Yusuf2024_s01</code></li><li><code>Uranium235_Yusuf2024_s02</code></li></ul><h4>About Uranium-235</h4></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 2419200, Tolerance = 1e-9, Interval = 4838.4));
