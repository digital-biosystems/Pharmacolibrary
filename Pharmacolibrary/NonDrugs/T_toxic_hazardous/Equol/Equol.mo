within Pharmacolibrary.NonDrugs.T_toxic_hazardous.Equol;
model Equol "Equol — default model: Equol_Setchell2009_reference"
  extends Equol_Setchell2009_reference;
  annotation (Documentation(info = "<html><body><p>The default model of Equol: <a href=\"modelica://Pharmacolibrary.NonDrugs.T_toxic_hazardous.Equol.Equol_Setchell2009_reference\">Equol_Setchell2009_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of Equol in this package:</p><ul><li><code>Equol_Setchell2009_reference</code></li></ul><h4>About Equol</h4></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 144000, Tolerance = 1e-9, Interval = 288.0));
end Equol;
