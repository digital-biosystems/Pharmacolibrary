  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>Equol</td></tr><tr><td>model:</td><td>retention function (body burden), no volume or clearance <small>(TK_Retention)</small></td></tr><tr><td>source:</td><td>Setchell KD et al. 2009</td></tr><tr><td>population:</td><td>12 healthy postmenopausal women</td></tr><tr><td>measured compound:</td><td>S-(-)equol</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/toxin_equol/Equol_Setchell2009_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>plasma elimination half-life</td><td>8</td><td>h</td><td><small>t1/2z</small></td></tr></table><h4>References</h4><ol><li><p>Setchell KD et al. (2009). The pharmacokinetics of S-(-)equol administered as SE5-OH tablets to healthy postmenopausal women. <i>The Journal of nutrition 139(11):2037–2043</i>. DOI:<a href=\"https://doi.org/10.3945/jn.109.110874\">10.3945/jn.109.110874</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/19776178\">19776178</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Setchell_2009: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 144000, Tolerance = 1e-9, Interval = 288.0));
end Equol_Setchell2009_reference;
