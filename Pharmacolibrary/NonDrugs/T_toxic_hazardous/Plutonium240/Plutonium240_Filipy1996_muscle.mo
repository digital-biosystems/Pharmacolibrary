  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>Plutonium-240</td></tr><tr><td>model:</td><td>retention function (body burden), no volume or clearance <small>(TK_Retention)</small></td></tr><tr><td>source:</td><td>Filipy RE et al. 1996</td></tr><tr><td>population:</td><td>occupational exposure adults</td></tr><tr><td>measured compound:</td><td>239+240Pu</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/toxin_plutonium_240/Plutonium240_Filipy1996_muscle\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>For 239+240Pu in skeletal muscle, strict adherence to the outlier rejection criterion resulted in a not unreasonable estimated retention half-time of 9 y; however, the Y-intercept indicated an initial uptake fraction in skeletal muscle of 37% of the initial systemic burden.</td><td>9</td><td>year</td><td><small>t1/2α</small></td></tr><tr><td>ICRP 67 (1993) implied a retention half-time in the testes of approximately 55 y.</td><td>55</td><td>year</td><td><small>t1/2z</small></td></tr></table><h4>References</h4><ol><li><p>Filipy RE et al. (1996). Changes in soft tissue concentrations of plutonium and americium with time after human occupational exposure. <i>Health physics 70(2):153–159</i>. DOI:<a href=\"https://doi.org/10.1097/00004032-199602000-00001\">10.1097/00004032-199602000-00001</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/8567281\">8567281</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Filipy_1996: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
