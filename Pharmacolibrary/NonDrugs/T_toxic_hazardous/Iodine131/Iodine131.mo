  extends Iodine131_Kelly2017_reference;
  annotation (Documentation(info = "<html><body><p>The default model of Iodine-131: <a href=\"modelica://Pharmacolibrary.NonDrugs.T_toxic_hazardous.Iodine131.Iodine131_Kelly2017_reference\">Iodine131_Kelly2017_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of Iodine-131 in this package:</p><ul><li><code>Iodine131_Kelly2017_reference</code></li><li><code>Iodine131_Ravichandran2014_0_and_24_h</code></li><li><code>Iodine131_Ravichandran2014_0_and_48_h</code></li><li><code>Iodine131_Ravichandran2014_0_and_72_h</code></li></ul><h4>About Iodine-131</h4></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 172.8));
end Iodine131;
