  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>Mercuric chloride</td></tr><tr><td>model:</td><td>retention function (body burden), no volume or clearance <small>(TK_Retention)</small></td></tr><tr><td>source:</td><td>Sundberg J et al. 1998</td></tr><tr><td>population:</td><td>lactating and nonlactating mice</td></tr><tr><td>measured compound:</td><td>Mercury (total, inorganic, and methylmercury species)</td></tr><tr><td>review:</td><td>accepted with caveats</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/toxin_mercuric_chloride/MercuricChloride_Sundberg1998_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>terminal half-lives of methylmercury in plasma were similar, in lactating</td><td>170</td><td>h</td><td><small>t1/2z</small></td></tr></table><h4>References</h4><ol><li><p>Sundberg J et al. (1998). Kinetics of methylmercury and inorganic mercury in lactating and nonlactating mice. <i>Toxicology and applied pharmacology 151(2):319–329</i>. DOI:<a href=\"https://doi.org/10.1006/taap.1998.8456\">10.1006/taap.1998.8456</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/9707508\">9707508</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Sundberg_1998: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: accepted with caveats</li></ul></body></html>"),
