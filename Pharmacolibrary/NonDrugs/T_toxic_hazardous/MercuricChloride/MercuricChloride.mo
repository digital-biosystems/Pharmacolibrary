  annotation (Documentation(info = "<html><body><p>The default model of Mercuric chloride: <a href=\"modelica://Pharmacolibrary.NonDrugs.T_toxic_hazardous.MercuricChloride.MercuricChloride_KomstaSzumska1984_reference\">MercuricChloride_KomstaSzumska1984_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of Mercuric chloride in this package:</p><ul><li><code>MercuricChloride_KomstaSzumska1984_reference</code></li><li><code>MercuricChloride_Sundberg1998_reference</code></li></ul><h4>About Mercuric chloride</h4></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 10281600, Tolerance = 1e-9, Interval = 20563.2));
