within Pharmacolibrary.NonDrugs.T_toxic_hazardous.Crotoxin;
model Crotoxin "Crotoxin — default model: Crotoxin_Cura2002_reference"
  extends Crotoxin_Cura2002_reference;
  annotation (Documentation(info = "<html><body><p>The default model of Crotoxin: <a href=\"modelica://Pharmacolibrary.NonDrugs.T_toxic_hazardous.Crotoxin.Crotoxin_Cura2002_reference\">Crotoxin_Cura2002_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of Crotoxin in this package:</p><ul><li><code>Crotoxin_Cura2002_reference</code></li></ul><h4>About Crotoxin</h4></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Crotoxin;
