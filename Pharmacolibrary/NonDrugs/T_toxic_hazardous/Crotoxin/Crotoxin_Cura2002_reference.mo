within Pharmacolibrary.NonDrugs.T_toxic_hazardous.Crotoxin;
model Crotoxin_Cura2002_reference
  parameter Real Cl_ref = 4.383333333333333e-07 "Cl [m3/s]";
  parameter Real Vd_ref = 0.84 "Vd [m3]";
  extends Pharmacolibrary.Pharmacokinetic.Models.PK_1C(
    weight = 70.0,
    F = 1,
    Cl = Cl_ref,
    Vd = Vd_ref,
    adminDuration = 600,
    adminCount = 1,
    MM = 0.319248,
    adminMass = 1e-05
  );

  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>Crotoxin</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Cura JE et al. 2002</td></tr><tr><td>population:</td><td>patients with advanced cancer</td></tr><tr><td>measured compound:</td><td>Crotoxin</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/toxin_crotoxin/Crotoxin_Cura2002_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>t(1/2 A)</td><td>5.2</td><td>min</td><td><small>t1/2z</small></td></tr><tr><td>half-life of the distribution (alpha) phase</td><td>22</td><td>min</td><td><small>t1/2α</small></td></tr><tr><td>elimination (beta) phase with a half-life</td><td>5.2</td><td>h</td><td><small>t1/2β</small></td></tr><tr><td>C(L)</td><td>26.3</td><td>ml/min</td><td><small>CL</small></td></tr><tr><td>V(d)</td><td>12</td><td>liter/kg</td><td><small>V</small></td></tr></table><h4>References</h4><ol><li><p>Cura JE et al. (2002). Phase I and pharmacokinetics study of crotoxin (cytotoxic PLA(2), NSC-624244) in patients with advanced cancer. <i>Clinical cancer research : an official journal of the American Association for Cancer Research 8(4):1033–1041</i>. PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/11948110\">11948110</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Cura_2002: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end Crotoxin_Cura2002_reference;
