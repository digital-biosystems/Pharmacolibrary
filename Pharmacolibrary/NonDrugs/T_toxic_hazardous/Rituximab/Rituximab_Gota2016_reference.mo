    adminMass = 1e-05
  );

  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>Rituximab</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Gota V et al. 2016</td></tr><tr><td>population:</td><td>patients with diffuse large B-cell lymphoma on R-CHOP</td></tr><tr><td>measured compound:</td><td>Rituximab</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/toxin_rituximab/Rituximab_Gota2016_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>volume of distribution of central compartment</td><td>0.95</td><td>L</td><td><small>V</small></td></tr><tr><td>clearance</td><td>5.98</td><td>mL/h</td><td><small>CL</small></td></tr></table><h4>References</h4><ol><li><p>Gota V et al. (2016). Population pharmacokinetics of Reditux™, a biosimilar Rituximab, in diffuse large B-cell lymphoma. <i>Cancer chemotherapy and pharmacology 78(2):353-359</i>. DOI:<a href=\"https://doi.org/10.1007/s00280-016-3083-x\">10.1007/s00280-016-3083-x</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/27329361\">27329361</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Gota_2016: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 2419200, Tolerance = 1e-9, Interval = 1));
end Rituximab_Gota2016_reference;
