within Pharmacolibrary.NonDrugs.T_toxic_hazardous.Rituximab;
model Rituximab_Gota2016_reference
  parameter Real Cl_ref = 1.6611111111111112e-09 "Cl [m3/s]";
  parameter Real Vd_ref = 0.00095 "Vd [m3]";
  extends Pharmacolibrary.Pharmacokinetic.Models.PK_1C(
