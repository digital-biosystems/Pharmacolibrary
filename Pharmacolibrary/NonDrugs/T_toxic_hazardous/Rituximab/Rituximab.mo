within Pharmacolibrary.NonDrugs.T_toxic_hazardous.Rituximab;
model Rituximab "Rituximab — default model: Rituximab_Gota2016_reference"
  extends Rituximab_Gota2016_reference;
  annotation (Documentation(info = "<html><body><p>The default model of Rituximab: <a href=\"modelica://Pharmacolibrary.NonDrugs.T_toxic_hazardous.Rituximab.Rituximab_Gota2016_reference\">Rituximab_Gota2016_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of Rituximab in this package:</p><ul><li><code>Rituximab_Bensalem2019_reference</code></li><li><code>Rituximab_Gota2016_reference</code></li><li><code>Rituximab_Riva2023_reference</code></li><li><code>Rituximab_Zhou2026_final</code></li><li><code>Rituximab_Zhou2026_final_final_model_shr</code></li></ul><h4>About Rituximab</h4></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 2419200, Tolerance = 1e-9, Interval = 1));
end Rituximab;
