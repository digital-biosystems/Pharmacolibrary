  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>Sodium arsenite</td></tr><tr><td>model:</td><td>retention function (body burden), no volume or clearance <small>(TK_Retention)</small></td></tr><tr><td>source:</td><td>Hershberger KA et al. 2026</td></tr><tr><td>population:</td><td>Caenorhabditis elegans</td></tr><tr><td>measured compound:</td><td>Sodium arsenite</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/toxin_sodium_arsenite/SodiumArsenite_Hershberger2026_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>t1/2</td><td>3</td><td>hours</td><td><small>t1/2z</small></td></tr></table><h4>References</h4><ol><li><p>Hershberger KA et al. (2026). Persistent effects of early-life arsenic exposure in Caenorhabditis elegans. <i>Environmental science. Processes &amp; impacts 28(2):534–553</i>. DOI:<a href=\"https://doi.org/10.1039/d5em00655d\">10.1039/d5em00655d</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/41552942\">41552942</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Hershberger_2026: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
