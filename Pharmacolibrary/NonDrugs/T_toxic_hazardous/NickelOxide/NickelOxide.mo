model NickelOxide "NickelOxide — default model: NickelOxide_Tanaka1985_reference"
  extends NickelOxide_Tanaka1985_reference;
  annotation (Documentation(info = "<html><body><p>The default model of Nickel oxide: <a href=\"modelica://Pharmacolibrary.NonDrugs.T_toxic_hazardous.NickelOxide.NickelOxide_Tanaka1985_reference\">NickelOxide_Tanaka1985_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of Nickel oxide in this package:</p><ul><li><code>NickelOxide_Shinohara2017_nio_a</code></li><li><code>NickelOxide_Shinohara2017_nio_b</code></li><li><code>NickelOxide_Shinohara2017_nio_c</code></li><li><code>NickelOxide_Shinohara2017_nio_d</code></li><li><code>NickelOxide_Tanaka1985_reference</code></li></ul><h4>About Nickel oxide</h4></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 15552000, Tolerance = 1e-9, Interval = 31104.0));
end NickelOxide;
