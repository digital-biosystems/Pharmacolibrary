  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>Silver(I) selenide</td></tr><tr><td>model:</td><td>one compartment, IV dosing <small>(PK_1C)</small></td></tr><tr><td>source:</td><td>Tang H et al. 2016</td></tr><tr><td>population:</td><td>Male CD-1 (ICR) mice</td></tr><tr><td>measured compound:</td><td>Silver(I) selenide quantum dots (Ag2Se QDs-PEG)</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/toxin_silveri_selenide/SilveriSelenide_Tang2016_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>T1/2(h)</td><td>0.406</td><td>h</td><td><small>t1/2z</small></td></tr><tr><td>AUC(h·μg/L)</td><td>1881.66</td><td>h·μg/L</td><td><small>AUC</small></td></tr><tr><td>CL(L/h/kg)</td><td>0.459</td><td>L/h/kg</td><td><small>CL</small></td></tr><tr><td>Vd(L/kg)</td><td>0.269</td><td>L/kg</td><td><small>V</small></td></tr><tr><td>R²</td><td>0.99</td><td></td><td><small>equation variable</small></td></tr></table><h4>References</h4><ol><li><p>Tang H et al. (2016). Blood Clearance, Distribution, Transformation, Excretion, and Toxicity of Near-Infrared Quantum Dots Ag2Se in Mice. <i>ACS applied materials &amp; interfaces 8(28):17859–17869</i>. DOI:<a href=\"https://doi.org/10.1021/acsami.6b05057\">10.1021/acsami.6b05057</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/27351208\">27351208</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Tang_2016: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
    experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
