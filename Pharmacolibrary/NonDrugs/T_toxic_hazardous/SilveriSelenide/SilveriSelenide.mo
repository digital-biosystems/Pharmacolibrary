  annotation (Documentation(info = "<html><body><p>The default model of Silver(I) selenide: <a href=\"modelica://Pharmacolibrary.NonDrugs.T_toxic_hazardous.SilveriSelenide.SilveriSelenide_Tang2016_reference\">SilveriSelenide_Tang2016_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of Silver(I) selenide in this package:</p><ul><li><code>SilveriSelenide_Tang2016_reference</code></li></ul><h4>About Silver(I) selenide</h4></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 86400, Tolerance = 1e-9, Interval = 1));
end SilveriSelenide;
