  annotation (Documentation(info = "<html><body><table><tr><td>name:</td><td>Infliximab</td></tr><tr><td>model:</td><td>two compartments, oral dosing <small>(PK_2C_enteral)</small></td></tr><tr><td>source:</td><td>Song JH et al. 2025</td></tr><tr><td>population:</td><td>patients with inflammatory bowel disease</td></tr><tr><td>measured compound:</td><td>Infliximab</td></tr><tr><td>review:</td><td>curated candidate</td></tr><tr><td>record page:</td><td><a href=\"https://pharmacolibrary.github.io/#/drugs/toxin_infliximab/Infliximab_Song2025_reference\">pharmacolibrary-docs</a></td></tr></table><h4>Parameters as reported in the paper</h4><table border=1 cellspacing=0 cellpadding=2><tr><th>parameter</th><th>value</th><th>unit</th><th>meaning</th></tr><tr><td>CL (L/day)</td><td>0.248</td><td>L/day</td><td><small>CL</small></td></tr><tr><td>Vc (L)</td><td>1.87</td><td>L</td><td><small>V1</small></td></tr><tr><td>Vp (L)</td><td>1.96</td><td>L</td><td><small>V2</small></td></tr><tr><td>Q (L/day)</td><td>0.599</td><td>L/day</td><td><small>Q</small></td></tr><tr><td>F</td><td>0.667</td><td></td><td><small>Fab</small></td></tr><tr><td>ka (day-1)</td><td>0.083</td><td>day-1</td><td><small>kabs</small></td></tr></table><h4>References</h4><ol><li><p>Song JH et al. (2025). Population Pharmacokinetic Model for the Use of Intravenous or Subcutaneous Infliximab in Patients with Inflammatory Bowel Disease: Real-World Data from a Prospective Cohort Study. <i>Gut and liver 19(3):376-387</i>. DOI:<a href=\"https://doi.org/10.5009/gnl240503\">10.5009/gnl240503</a> PUBMED:<a href=\"https://pubmed.ncbi.nlm.nih.gov/40254990\">40254990</a></p></li></ol></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from Song_2025: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: curated candidate</li></ul></body></html>"),
