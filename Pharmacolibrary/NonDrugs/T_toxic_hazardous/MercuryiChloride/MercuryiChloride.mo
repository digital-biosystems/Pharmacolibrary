  extends MercuryiChloride_Sauder1988_reference;
  annotation (Documentation(info = "<html><body><p>The default model of Mercury(I) chloride: <a href=\"modelica://Pharmacolibrary.NonDrugs.T_toxic_hazardous.MercuryiChloride.MercuryiChloride_Sauder1988_reference\">MercuryiChloride_Sauder1988_reference</a>, chosen among the models extracted from papers (reviewer verdict, ground-truth agreement, completeness). All models of Mercury(I) chloride in this package:</p><ul><li><code>MercuryiChloride_KomstaSzumska1984_reference</code></li><li><code>MercuryiChloride_Sauder1988_reference</code></li></ul><h4>About Mercury(I) chloride</h4></body></html>", revisions = "<html><body><ul><li>11/2026 generated by pharmacolibrary-dev export.pharmacolibrary_models from default: parameters extracted from the paper by the pharmacolibrary-dev pipeline, model built by its engineer, reviewed: default</li></ul></body></html>"), experiment(StartTime = 0, StopTime = 4233600, Tolerance = 1e-9, Interval = 8467.2));
